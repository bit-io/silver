[package]
-> name        => ts_preact-template
-> version     => 0.2.0
-> description => Przykład Silver — TypeScript + Preact + esbuild
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[layout]
-> src => src

[build]
-> link => static

[dependencies]
-> silver => ^0.2

[default-build]
-> profile => release
-> target  => h#
-> emit    => bin
-> run     => true

[hooks]
-> pre-build => cd frontend && npm install --no-audit --no-fund && npm run build

[commands]
-> frontend
--> run => cd frontend && npm install --no-audit --no-fund && npm run build
--> description => Zbuduj frontend (TypeScript → frontend/dist/app.js)
-> watch
--> run => cd frontend && npm run watch
--> description => Buduj frontend przy każdej zmianie (uruchom razem z `bit run` — hot reload podchwyci dist/app.js)
