[package]
-> name        => todo_js-template
-> version     => 0.2.0
-> description => Przykład Silver — lista zadań napisana głównie w JS (DOM, async, timery, fetch, zapis w H#)
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[layout]
-> src => src

[build]
-> link => static

[dependencies]
-> silver => ^0.2

[default-build]
-> profile => release
-> target  => h#
-> emit    => bin
-> run     => true

[commands]
-> dev
--> run => bit run
--> description => Uruchom aplikację
