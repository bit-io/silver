use "bit -> silver" from "silver"

;; Handlery HTML dostają JSON: id, value, checked, name, data-*.
fn on_name(args: string) -> string is
    ;; ui::* — handler zmienia widok bez dostępu do App
    return ui::only(ui::set_text("hello", "Cześć, " + data::get_str(args, "value") + "!"))
end

fn on_agree(args: string) -> string is
    let on: bool = data::get_bool(args, "checked")
    return ui::only(ui::set_text("agree-state", if on then "zgoda: TAK" else "zgoda: NIE"))
end

fn on_color(args: string) -> string is
    return ui::only(ui::set_text("color-state", "kolor: " + data::get_str(args, "value")))
end

fn on_submit(args: string) -> string is
    return ui::only(ui::set_text("status", "Formularz wysłany"))
end

fn main() is
    let mut a = app::new("Silver — kitchen sink", 900, 700)
    a = app::load_html(a, "frontend/index.html")
    a = app::load_css(a, "frontend/style.css")
    a = app::command(a, "on_name", on_name)
    a = app::command(a, "on_agree", on_agree)
    a = app::command(a, "on_color", on_color)
    a = app::command(a, "on_submit", on_submit)
    a = app::enable_hot_reload(a)
    app::run(a)
end
