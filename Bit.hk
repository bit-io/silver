[package]
-> name        => silver
-> version     => 0.2.0
-> description => Tauri-podobny framework okienkowy z własnym silnikiem renderującym (bez WebView)
-> author      => Bytes Developers
-> license     => MIT

[build]
-> lang   => h#
-> entry  => src/lib.h#
-> output => build/silver
-> emit   => lib

[deps]
-> SDL2       => static
-> SDL2_image => static
-> quickjs    => static
