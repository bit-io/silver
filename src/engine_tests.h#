;; ====================== 0.4: druk — @page, page, break-*, print-color-adjust ======================
fn print_ix(bg: bool) -> css::InteractionState is
    let mut ix: css::InteractionState = css::no_interaction()
    ix.print = true
    ix.print_bg = bg
    return ix
end

fn within_px(a: int, b: int, t: int) -> bool is
    return a >= b - t && a <= b + t
end

fn page_list(html: string, css_text: string) -> [paged::Page] is
    let d: dom::Dom = dom::parse(html)
    let sheet: css::Stylesheet = css::parse(css_text)
    let first: [int] = paged::page_box(sheet, "", 0)
    let cw: int = first[0] - first[5] - first[3]
    let res: layout::LayoutResult = layout::layout_full_a(d, sheet, cw, first[1] - first[2] - first[4], -1, print_ix(true), [], anim::no_anim())
    return paged::paginate(res.boxes, d, sheet, res.height)
end

#[test]
fn t04_page_rule_sizes_margins_and_named_pages() is
    let sheet: css::Stylesheet = css::parse("@page { size: A5 landscape; margin: 10mm 20mm; } @page :first { margin-top: 0; } @page wide { size: 300mm 200mm; } @page wide:left { margin-left: 5mm; }")
    assert_eq(array_len(sheet.pages), 4)
    let p0: [int] = paged::page_box(sheet, "", 0)
    assert_eq(p0[0], 794)
    assert_eq(p0[1], 559)
    assert_eq(p0[2], 0)
    assert_true(within_px(p0[3], 76, 1) && within_px(p0[4], 38, 1) && within_px(p0[5], 76, 1))
    let p1: [int] = paged::page_box(sheet, "", 1)
    assert_true(within_px(p1[2], 38, 1))
    let w: [int] = paged::page_box(sheet, "wide", 0)
    assert_true(within_px(w[0], 1134, 2) && within_px(w[1], 756, 2))
    ;; :left (parzyste indeksy 1,3…) dodaje lewy margines tylko na stronach lewych
    assert_true(within_px(paged::page_box(sheet, "wide", 1)[5], 19, 1))
    assert_true(within_px(paged::page_box(sheet, "wide", 2)[5], 76, 1))
    ;; domyślnie A4
    let dflt: [int] = paged::page_box(css::parse(""), "", 0)
    assert_eq(dflt[0], 794)
    assert_eq(dflt[1], 1123)
    ;; size: jedna długość = kwadrat; portrait/landscape
    let sq: [int] = paged::page_box(css::parse("@page { size: 500px; }"), "", 0)
    assert_true(sq[0] == 500 && sq[1] == 500)
    let ls: [int] = paged::page_box(css::parse("@page { size: letter landscape; }"), "", 0)
    assert_true(ls[0] == 1056 && ls[1] == 816)
end

