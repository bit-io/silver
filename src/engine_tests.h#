fn h_echo(args: string) -> string is
    return jsonlite::set_str(jsonlite::object(), "echo", jsonlite::get_str(args, "v"))
end

fn h_ui(args: string) -> string is
    return ui::with(jsonlite::object(), ui::set_text("status", "ok"))
end

#[test]
fn test_ipc_binary_search_and_override() is
    let mut r: ipc::Router = ipc::new_router()
    r = ipc::register(r, "zeta", h_echo)
    r = ipc::register(r, "alpha", h_echo)
    r = ipc::register(r, "mid", h_echo)
    r = ipc::register(r, "alpha", h_ui)
    assert_eq(array_len(r.commands), 3)
    assert_eq(r.commands[0].name, "alpha")
    assert_eq(ipc::find_index(r, "zeta"), 2)
    assert_eq(ipc::find_index(r, "nope"), -1)
end

;; Uwaga: trzy testy ipc poniżej (origin/capability/required) wołają handlery przez pole
;; `fn` i dopasowują enum z innego modułu — wymagają skompilowanego H# (`h# test`).
#[test]
fn test_ipc_origin_and_capability() is
    let mut r: ipc::Router = ipc::new_router()
    r = ipc::register_scoped(r, "html_only", h_echo, ipc::Origin::HtmlOnly)
    r = ipc::register_cap(r, "fs_read", h_echo, ipc::Origin::Both, "fs")
    assert_true(ipc::is_error(ipc::dispatch_from(r, "html_only", "{{}}", "js")))
    assert_true(!ipc::is_error(ipc::dispatch_from(r, "html_only", "{{}}", "html")))
    assert_eq(jsonlite::get_str(ipc::dispatch_from(r, "fs_read", "{{}}", "js"), "code"), "forbidden")
    assert_true(!ipc::is_error(ipc::dispatch_from(r, "fs_read", "{{}}", "html")))
    r = ipc::grant(r, "js", "fs")
    assert_true(!ipc::is_error(ipc::dispatch_from(r, "fs_read", "{{}}", "js")))
    r = ipc::revoke(r, "js", "fs")
    assert_true(ipc::is_error(ipc::dispatch_from(r, "fs_read", "{{}}", "js")))
    assert_eq(jsonlite::get_str(ipc::dispatch(r, "missing", "{{}}"), "code"), "not_found")
end

#[test]
fn test_ipc_required_args() is
    let mut r: ipc::Router = ipc::new_router()
    r = ipc::register_full(r, "need_v", h_echo, ipc::Origin::Both, "", ["v"])
    assert_eq(jsonlite::get_str(ipc::dispatch(r, "need_v", "{{}}"), "code"), "invalid_args")
    assert_eq(jsonlite::get_str(ipc::dispatch(r, "need_v", "{{\"v\":\"x\"}}"), "echo"), "x")
end

