#[test]
fn test_css_strips_comment_before_selector() is
    ;; bez usuwania komentarzy ten komentarz wciągnąłby się do
    ;; selektora ".hint" i reguła po cichu przestałaby cokolwiek trafiać
    let sheet: css::Stylesheet = css::parse(
        "/* uwaga: to jest hint */\n.hint { color: red; }")
    assert_eq(array_len(sheet.rules), 1)
    assert_eq(sheet.rules[0].selector, ".hint")
end

#[test]
