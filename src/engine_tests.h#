fn xf_count(boxes: [layout::LayoutBox], id: int) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].xf_id == id is n += 1 end
        i += 1
    end
    return n
end

