fn t04_svg_text_becomes_text_boxes_with_anchor_and_fill() is
    let html: string = "<svg id=\"s\" width=\"200\" height=\"100\" viewBox=\"0 0 200 100\"><text id=\"a\" x=\"100\" y=\"50\">Hello</text><text id=\"b\" x=\"10\" y=\"90\">Z</text></svg>"
    let d: dom::Dom = dom::parse(html)
    let css_text: string = "#a { font-size: 20px; text-anchor: middle; fill: #ff0000; } #b { font-size: 10px; fill: none; }"
    let boxes: [layout::LayoutBox] = layout::layout(d, css::parse(css_text), 400, -1)
    let aid: int = dom::find_by_id(d, "a")
    let s: layout::LayoutBox = find_box(boxes, dom::find_by_id(d, "s"), "box")
    let mut found: int = 0
    let mut zfound: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].node_id == aid is
            found += 1
            let b: layout::LayoutBox = boxes[i]
            assert_eq(b.text, "Hello")
            assert_eq(b.st.color.r, 255)
            assert_eq(b.st.color.g, 0)
            ;; text-anchor: middle → środek pola na x = s.x + 100
            assert_true(near_i(b.x + b.w / 2, s.x + 100, 1))
            ;; linia bazowa y=50: góra pola = 50 − 0,8·20 = 34
            assert_eq(b.y, s.y + 34)
            assert_eq(b.st.font_size, 20)
        end
        if boxes[i].kind == "text" && boxes[i].text == "Z" is zfound += 1 end
        i += 1
    end
    assert_eq(found, 1)
    assert_eq(zfound, 0)
end

fn near_i(a: int, b: int, t: int) -> bool is
    let d: int = if a > b then a - b else b - a
    return d <= t
end

