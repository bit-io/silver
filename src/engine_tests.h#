fn first_text_x(boxes: [layout::LayoutBox]) -> int is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is return boxes[i].x end
        i += 1
    end
    return -1
end

fn last_text_end(boxes: [layout::LayoutBox]) -> int is
    let mut best: int = -1
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].x + boxes[i].w > best is best = boxes[i].x + boxes[i].w end
        i += 1
    end
    return best
end

