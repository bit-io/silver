end

#[test]
fn test_opacity_not_inherited() is
    ;; opacity NIE dziedziczy w CSS (inaczej niż color/text-align) —
    ;; każdy element domyślnie startuje od 100 (w pełni kryjące).
    let sheet: css::Stylesheet = css::parse("div { opacity: 0.5; }")
    let parent: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(parent.opacity, 50)
    let child: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "span", "", [], parent)
    assert_eq(child.opacity, 100)
end

#[test]
fn test_opacity_percent_syntax() is
    let sheet: css::Stylesheet = css::parse("div { opacity: 30%; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.opacity, 30)
end

;; ---------- layout::layout — rozbudowa: text-align w praktyce ----------

#[test]
fn test_layout_center_aligns_short_line() is
    ;; viewport szeroki (400px), krótki tekst wyśrodkowany w bloku na
    ;; całą szerokość -> x pudełka tekstu powinien być > 0 (przesunięty
    ;; od lewej krawędzi), nie stać przy inner_x jak przy "left".
    let dom: dom::Dom = dom::parse("<div><p>hi</p></div>")
    let sheet: css::Stylesheet = css::parse("div { width: 400px; } p { text-align: center; }")
    let boxes: [layout::LayoutBox] = layout::layout(dom, sheet, 400, -1)
    let mut found_x: int = -1
    let count: int = array_len(boxes)
    let mut i: int = 0
    while i < count is
        if boxes[i].text == "hi" is found_x = boxes[i].x end
        i += 1
    end
    assert_true(found_x > 0)
end

