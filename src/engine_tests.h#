fn lay(html: string, css_text: string, vw: int) -> [layout::LayoutBox] is
    return layout::layout(dom::parse(html), css::parse(css_text), vw, -1)
end

fn find_box(boxes: [layout::LayoutBox], id: int, kind: string) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == kind is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

