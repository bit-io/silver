;; ====================== 0.4: baseline-source ======================
fn bs_text_y(boxes: [layout::LayoutBox], first: bool) -> int is
    let mut best: int = -1
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].text == "a" || boxes[i].kind == "text" && boxes[i].text == "b" is
            if best < 0 is best = i
            elsif first && boxes[i].y < boxes[best].y is best = i
            elsif first == false && boxes[i].y > boxes[best].y is best = i end
        end
        i += 1
    end
    return boxes[best].y
end

