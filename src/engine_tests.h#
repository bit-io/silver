#[test]
fn t04_svg_markers_in_markup() is
    let html: string = "<svg viewBox=\"0 0 100 100\"><defs><marker id=\"m\" markerWidth=\"4\" markerHeight=\"4\" refX=\"0\" refY=\"0\" orient=\"auto\"><rect width=\"2\" height=\"2\"/></marker></defs><path id=\"p\" d=\"M0 0 L10 0 L10 10\"/><line id=\"l\" x1=\"0\" y1=\"50\" x2=\"20\" y2=\"50\"/></svg>"
    let m: string = svg_of(html, "#p { stroke: black; stroke-width: 2; marker-start: url(#m); marker-mid: url(#m); marker-end: url(#m); } #l { stroke: red; marker-end: url(#m); }", 100, 100)
    ;; ścieżka: 3 markery, linia: 1
    let first: int = string_find(m, "<g transform=\"matrix(")
    assert_true(first > 0)
    let mut count: int = 0
    let mut from: int = 0
    while from < string_len(m) is
        let q: int = string_find(string_slice(m, from, string_len(m)), "<g transform=\"matrix(")
        if q < 0 is break end
        count += 1
        from = from + q + 10
    end
    assert_eq(count, 4)
    ;; marker na końcu linii (20,50) w prawo, skala stroke-width domyślna 1: matrix(1 0 0 1 20 50)
    assert_true(string_find(m, "matrix(1.000 0.000 0.000 1.000 20.000 50.000)") >= 0)
    ;; marker początkowy ścieżki przy skali stroke-width 2
    assert_true(string_find(m, "matrix(2.000 0.000 0.000 2.000 0.000 0.000)") >= 0)
    ;; markery nie są rysowane samodzielnie z <defs>
    assert_eq(string_find(m, "<marker"), -1)
end

