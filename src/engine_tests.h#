    assert_eq(texts_boxes(nest, ti)[0].st.font_size, 50)
    ;; auto-add przy math-style: compact dodaje poziom, normal nie
    let compact: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #s { font-size: math; math-style: compact; math-depth: auto-add; }"), 600, -1)
    assert_eq(texts_boxes(compact, si)[0].st.font_size, 71)
    let normal: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #s { font-size: math; math-depth: auto-add; }"), 600, -1)
