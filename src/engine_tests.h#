#[test]
fn t04_overflow_anchor_keeps_visible_content_in_place() is
    let d: dom::Dom = dom::parse("<div id=\"top\"></div><div id=\"c\"></div><div id=\"bot\"></div>")
    let css_a: string = "div { margin: 0; } #top { height: 100px; } #c { height: 300px; } #bot { height: 500px; }"
    let css_b: string = "div { margin: 0; } #top { height: 200px; } #c { height: 300px; } #bot { height: 500px; }"
    let old: [layout::LayoutBox] = layout::layout(d, css::parse(css_a), 400, -1)
    let new_b: [layout::LayoutBox] = layout::layout(d, css::parse(css_b), 400, -1)
    ;; przewinięcie 50: kotwica = #c (y=100) → po powiększeniu #top o 100 przewiń o +100
    assert_eq(layout::scroll_anchor_delta(old, new_b, 50, 600), 100)
    ;; bez przewinięcia — brak kotwiczenia
    assert_eq(layout::scroll_anchor_delta(old, new_b, 0, 600), 0)
    ;; overflow-anchor: none na elemencie → kotwicą staje się następny (#bot, y=400)
    let none_c: [layout::LayoutBox] = layout::layout(d, css::parse(css_a + " #c { overflow-anchor: none; }"), 400, -1)
    let none_new: [layout::LayoutBox] = layout::layout(d, css::parse(css_b + " #c { overflow-anchor: none; }"), 400, -1)
    assert_eq(layout::scroll_anchor_delta(none_c, none_new, 50, 600), 100)
    ;; wyłączone na korzeniu (html/body = pierwszy box)
    let off: [layout::LayoutBox] = layout::layout(d, css::parse(css_a + " * { overflow-anchor: none; }"), 400, -1)
    assert_eq(layout::scroll_anchor_delta(off, new_b, 50, 600), 0)
    ;; zmiana pod oknem nie przesuwa
    let new_c: [layout::LayoutBox] = layout::layout(d, css::parse("div { margin: 0; } #top { height: 100px; } #c { height: 300px; } #bot { height: 900px; }"), 400, -1)
    assert_eq(layout::scroll_anchor_delta(old, new_c, 50, 600), 0)
end

