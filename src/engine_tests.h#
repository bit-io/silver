#[test]
fn t04_paginate_breaks_avoid_forced_and_named_pages() is
    let base: string = "body { margin: 0; } div { height: 250px; } @page { size: 300px 400px; margin: 0; } "
    let five: string = "<div></div><div></div><div></div><div></div><div></div>"
    ;; bez reguł: bloki są cięte na granicy strony: 1250 px / 400 px = 4 strony
    let n: [paged::Page] = page_list(five, base)
    assert_eq(array_len(n), 4)
    assert_eq(n[0].y0, 0)
    assert_eq(n[0].y1, 400)
    assert_eq(n[3].y1, 1250)
    ;; break-inside: avoid — blok nie jest przecinany, każda strona dostaje jeden blok
    let av: [paged::Page] = page_list(five, base + "div { break-inside: avoid; }")
    assert_eq(array_len(av), 5)
    assert_eq(av[0].y1, 250)
    assert_eq(av[1].y0, 250)
    assert_eq(av[1].y1, 500)
    assert_eq(av[4].y1, 1250)
    ;; wymuszony podział przed drugim blokiem
    let fb: [paged::Page] = page_list("<div></div><div class=\"b\"></div><div></div>", base + ".b { break-before: page; }")
    assert_eq(fb[0].y1, 250)
    assert_eq(fb[1].y0, 250)
    ;; break-after: always
    let fa: [paged::Page] = page_list("<div class=\"a\"></div><div></div>", base + ".a { break-after: always; }")
    assert_eq(array_len(fa), 2)
    assert_eq(fa[0].y1, 250)
    ;; właściwość page: zmiana nazwy między rodzeństwem wymusza podział, a nazwana strona ma własny rozmiar
    let np: [paged::Page] = page_list("<div></div><div class=\"w\"></div><div></div>", base + "@page wide { size: 500px 300px; } .w { page: wide; }")
    assert_eq(array_len(np), 3)
    assert_eq(np[0].name, "")
    assert_eq(np[1].name, "wide")
    assert_eq(np[1].w, 500)
    assert_eq(np[1].h, 300)
    assert_eq(np[2].name, "")
    assert_eq(np[2].w, 300)
end

