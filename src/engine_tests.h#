    assert_true(min_body_x_in_band(boxes, 44, 64) > 40)
    assert_eq(min_body_x_in_band(boxes, 66, 400), 0)
    ;; element inline z initial-letter też działa
    let sp: [layout::LayoutBox] = lay("<p><span class=\"d\">T</span>ext " + words + "</p>", "p { margin: 0; } .d { initial-letter: 2; }", 300)
    let sb: layout::LayoutBox = first_text_box(sp)
