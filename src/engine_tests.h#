#[test]
fn t04d_voice_stress_range_balance_markers_ssml_and_pan() is
    let d: dom::Dom = dom::parse("<p id=\"a\">raz <b>dwa</b> trzy</p>")
    let sh: css::Stylesheet = css::parse("b { voice-stress: strong; voice-range: x-high; voice-balance: left; }")
    let styles: [style::ComputedStyle] = layout::compute_styles(d, sh, css::no_interaction())
    let pid: int = css::query_first(d, "p")
    let t: string = speech::spoken_text(d, styles, pid)
    assert_eq(t, "raz \u0001Vstrong;x-high;left\u0001dwa\u0001v\u0001 trzy")
    ;; dziedziczone wartości nie dublują znaczników u potomków
    let d2: dom::Dom = dom::parse("<p id=\"a\"><b>dwa <i>trzy</i></b></p>")
    let st2: [style::ComputedStyle] = layout::compute_styles(d2, css::parse("b { voice-stress: moderate; }"), css::no_interaction())
    let t2: string = speech::spoken_text(d2, st2, css::query_first(d2, "p"))
    assert_eq(t2, "\u0001Vmoderate;;\u0001dwa trzy\u0001v\u0001")
    assert_eq(speech::ssml_wrap("strong;x-high;left", "a<b"), "<speak><emphasis level=\"strong\"><prosody range=\"x-high\">a&lt;b</prosody></emphasis></speak>")
    assert_eq(speech::ssml_wrap("", "abc"), "abc")
    assert_eq(speech::balance_pan("left"), -100)
    assert_eq(speech::balance_pan("rightwards"), 40)
    assert_eq(speech::balance_pan("-30"), -30)
    assert_eq(speech::balance_pan("500"), 100)
    assert_eq(speech::stack_pan("strong;;left\u0002;;right"), 100)
    assert_eq(speech::stack_pan("strong;;"), 0)
end

#[test]
fn t04d_line_grid_snaps_lines_and_boxes_to_baseline_grid() is
    ;; siatka 20px; h2 z line-height 30px zaczyna się na linii 0, więc bez snapu następny akapit zaczynałby się na 30 (niewspółosiowo)
    let css_base: string = "body { margin: 0; } div { line-grid: create; line-height: 20px; font-size: 10px; } p { margin: 0; } h2 { margin: 0; line-height: 30px; font-size: 10px; }"
    let html: string = "<div><h2>T</h2><p>a</p></div>"
    let plain: [layout::LayoutBox] = lay(html, css_base, 400)
    let snapped: [layout::LayoutBox] = lay(html, css_base + " div { line-snap: baseline; }", 400)
    let mut py0: int = -1
    let mut py1: int = -1
    let mut i: int = 0
    while i < array_len(plain) is
        if plain[i].kind == "text" && plain[i].text == "a" is py0 = plain[i].y end
        i += 1
    end
    i = 0
    while i < array_len(snapped) is
        if snapped[i].kind == "text" && snapped[i].text == "a" is py1 = snapped[i].y end
        i += 1
    end
    assert_true(py0 >= 0 && py1 > py0)
    assert_eq(layout::lg_down(31, 0, 20), 9)
    assert_eq(layout::lg_down(40, 0, 20), 0)
    assert_eq(layout::lg_down(5, 25, 20), 0)
    ;; box-snap: block-start dosuwa górę pudełka do linii siatki
    let b1: [layout::LayoutBox] = lay("<div><h2>T</h2><section>x</section></div>", css_base + " section { box-snap: block-start; display: block; }", 400)
    let mut sy: int = -1
    i = 0
    while i < array_len(b1) is
        if b1[i].kind == "box" && b1[i].node_id == 4 is sy = b1[i].y end
        i += 1
    end
    assert_eq(sy % 20, 0)
end

#[test]
fn t04d_float_offset_reference_and_defer() is
    let css_base: string = "body { margin: 0; } div { width: 300px; margin-left: 100px; } .f { float: left; width: 50px; height: 20px; } p { margin: 0; height: 30px; }"
    let plain: [layout::LayoutBox] = lay("<div><span class=\"f\"></span><p>a</p></div>", css_base, 800)
    let off: [layout::LayoutBox] = lay("<div><span class=\"f\"></span><p>a</p></div>", css_base + " .f { float-offset: 12px; }", 800)
    let pg: [layout::LayoutBox] = lay("<div><span class=\"f\"></span><p>a</p></div>", css_base + " .f { float-reference: page; }", 800)
    assert_eq(t04d_box_x(off, 2) - t04d_box_x(plain, 2), 12)
    assert_eq(t04d_box_x(pg, 2), 0)
    let dfr: [layout::LayoutBox] = lay("<div><span class=\"f\"></span><p>a</p><p>b</p></div>", css_base + " .f { float-defer: 1; }", 800)
    let nodef: [layout::LayoutBox] = lay("<div><span class=\"f\"></span><p>a</p><p>b</p></div>", css_base, 800)
    assert_eq(t04d_box_y(nodef, 2), 0)
    assert_eq(t04d_box_y(dfr, 2), 30)
end

fn t04d_box_x(bs: [layout::LayoutBox], id: int) -> int is
    let mut i: int = 0
    while i < array_len(bs) is
        if bs[i].node_id == id && bs[i].kind == "box" is return bs[i].x end
        i += 1
    end
    return -1
end

