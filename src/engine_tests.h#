#[test]
fn test_window_decode_events() is
    let d: window::InputEvent = window::decode(2, "10|20|1|2|3")
    assert_eq(d.kind, "mouse_down")
    assert_eq(d.x, 10)
    assert_eq(d.clicks, 2)
    assert_eq(d.mods, 3)
    let k: window::InputEvent = window::decode(5, "2|1|1073741904|80")
    assert_eq(k.kind, "key_down")
    assert_true(k.repeat)
    assert_eq(k.code, window::key_left())
    let t: window::InputEvent = window::decode(7, "0|0|za|żó")
    assert_eq(t.text, "za|żó")
    let w: window::InputEvent = window::decode(8, "0|-24|0|5|6")
    assert_eq(w.kind, "scroll")
    assert_eq(w.y, -24)
    assert_eq(window::decode(12, "0|0|/tmp/a b.png").text, "/tmp/a b.png")
    assert_eq(window::decode(6, "640|480|200").code, 200)
end
