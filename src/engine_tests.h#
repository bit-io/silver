#[test]
fn test_css_adjacent_sibling_matches_immediate_next() is
    ;; <div class="a"></div><p class="b">x</p><p class="c">y</p> —
    ;; ".a + p" powinno złapać TYLKO pierwsze <p> (bezpośrednio po .a).
    let dom: dom::Dom = dom::parse(
        "<div><div class=\"a\"></div><p class=\"b\">x</p><p class=\"c\">y</p></div>")
    let sheet: css::Stylesheet = css::parse(".a + p { color: red; }")
    let mut b_id: int = -1
    let mut c_id: int = -1
    let count: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < count is
        if dom.nodes[i].attr_class == "b" is b_id = i end
        if dom.nodes[i].attr_class == "c" is c_id = i end
        i += 1
    end
    let st_b: style::ComputedStyle = style::resolve_ctx(sheet, dom, b_id, style::root_style(), css::no_interaction())
    let st_c: style::ComputedStyle = style::resolve_ctx(sheet, dom, c_id, style::root_style(), css::no_interaction())
    assert_eq(st_b.color.r, 255)
    assert_true(st_c.color.r != 255)
end

#[test]
fn test_css_general_sibling_matches_any_later() is
    ;; ".a ~ p" powinno złapać OBA <p> po .a, nie tylko najbliższe.
    let dom: dom::Dom = dom::parse(
        "<div><div class=\"a\"></div><p class=\"b\">x</p><p class=\"c\">y</p></div>")
    let sheet: css::Stylesheet = css::parse(".a ~ p { color: red; }")
    let mut c_id: int = -1
    let count: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < count is
        if dom.nodes[i].attr_class == "c" is c_id = i end
        i += 1
    end
    let st_c: style::ComputedStyle = style::resolve_ctx(sheet, dom, c_id, style::root_style(), css::no_interaction())
    assert_eq(st_c.color.r, 255)
end

