fn line_ys(boxes: [layout::LayoutBox], id: int) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].node_id == id is out = array_push(out, boxes[i].y) end
        i += 1
    end
    return out
end

fn para_html(words: int) -> string is
    let mut t: string = ""
    let mut i: int = 0
    while i < words is
        t = t + "aaaa "
        i += 1
    end
    return "<div id=\"c\"><p id=\"p\">" + t + "</p></div>"
end

#[test]
fn t04_widows_pull_lines_to_next_column() is
    ;; 6 wierszy po jednym słowie (wąska kolumna), kolumna wysoka na 4 wiersze → 2 wiersze przechodzą dalej
    let d: dom::Dom = dom::parse(para_html(6))
    let base: string = "#c { column-count: 2; column-gap: 0px; width: 90px; height: 88px; column-fill: auto; } p { margin: 0; line-height: 22px; }"
    let w1: [int] = line_ys(layout::layout(d, css::parse(base + " p { widows: 1; orphans: 1; }"), 400, -1), dom::find_by_id(d, "p"))
    let w2: [int] = line_ys(layout::layout(d, css::parse(base + " p { widows: 3; orphans: 1; }"), 400, -1), dom::find_by_id(d, "p"))
    assert_eq(array_len(w1), array_len(w2))
    ;; z widows:1 w drugiej kolumnie ostatni wiersz = ok. 2 wiersze; z widows:3 — 3 wiersze (y=0 dla pierwszego wiersza kol. 2)
    let mut zeros1: int = 0
    let mut zeros2: int = 0
    let mut i: int = 0
    while i < array_len(w1) is
        if w1[i] == 0 is zeros1 += 1 end
        if w2[i] == 0 is zeros2 += 1 end
        i += 1
    end
    assert_true(zeros2 >= zeros1)
    assert_true(array_len(w2) >= 5)
end

