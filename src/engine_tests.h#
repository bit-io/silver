#[test]
fn t_jsonlite() is
    let mut o: string = jsonlite::object()
    o = jsonlite::set_str(o, "a", "x \"q\" \n")
    o = jsonlite::set_int(o, "n", 5)
    o = jsonlite::set_bool(o, "b", true)
    o = jsonlite::set_raw(o, "o", "{\"k\":[1,2]}")
    assert_eq(jsonlite::get_str(o, "a"), "x \"q\" \n")
    assert_eq(jsonlite::get_int(o, "n"), 5)
    assert_true(jsonlite::get_bool(o, "b"))
    assert_eq(jsonlite::get_raw(o, "o"), "{\"k\":[1,2]}")
    assert_eq(jsonlite::get_raw(jsonlite::get_raw(o, "o"), "k"), "[1,2]")
    o = jsonlite::set_str(o, "a", "z")
    assert_eq(jsonlite::get_str(o, "a"), "z")
    assert_eq(array_len(jsonlite::keys(o)), 4)
    o = jsonlite::remove_key(o, "n")
    assert_true(!jsonlite::has_key(o, "n"))
    assert_eq(jsonlite::get_str("{\"u\":\"\\u0105\"}", "u"), char_code_to_str(261))
end

