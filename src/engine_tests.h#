;; pomocnik: wyciąga fragment o danym id z listy (17 liczb na fragment) → 17 liczb albo []
fn piece_by_id(pieces: [int], id: int) -> [int] is
    let n: int = array_len(pieces) / 17
    let mut k: int = 0
    while k < n is
        if pieces[k * 17] == id is
            let mut out: [int] = []
            let mut i: int = 0
            while i < 17 is
                out = array_push(out, pieces[k * 17 + i])
                i += 1
            end
            return out
        end
        k += 1
    end
    return []
end

