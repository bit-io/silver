#[test]
fn t04_masonry_rows_places_items_in_shortest_column() is
    let src: string = "<div id=\"g\"><div id=\"a\"></div><div id=\"b\"></div><div id=\"c\"></div><div id=\"e\"></div></div>"
    let d: dom::Dom = dom::parse(src)
    let css0: string = "#g { display: grid; grid-template-columns: 100px 100px; grid-template-rows: masonry; } #a { height: 50px; } #b { height: 100px; } #c { height: 30px; } #e { height: 30px; }"
    let bs: [layout::LayoutBox] = layout::layout(d, css::parse(css0), 400, -1)
    assert_eq(layout::masonry_axis(box_at_id(bs, d, "g").st), 1)
    let a: layout::LayoutBox = box_at_id(bs, d, "a")
    let b: layout::LayoutBox = box_at_id(bs, d, "b")
    let c: layout::LayoutBox = box_at_id(bs, d, "c")
    let e: layout::LayoutBox = box_at_id(bs, d, "e")
    assert_eq(a.x, 0)
    assert_eq(b.x, 100)
    ;; c trafia do krótszej kolumny (a: 50 < b: 100), e też (80 < 100)
    assert_eq(c.x, 0)
    assert_eq(c.y, 50)
    assert_eq(e.x, 0)
    assert_eq(e.y, 80)
    assert_eq(box_at_id(bs, d, "g").h, 110)
    ;; masonry-auto-flow: next → kolejne kolumny po kolei
    let nx: [layout::LayoutBox] = layout::layout(d, css::parse(css0 + " #g { masonry-auto-flow: next; }"), 400, -1)
    assert_eq(box_at_id(nx, d, "c").x, 0)
    assert_eq(box_at_id(nx, d, "e").x, 100)
    assert_eq(box_at_id(nx, d, "e").y, 100)
    ;; gap
    let gp: [layout::LayoutBox] = layout::layout(d, css::parse(css0 + " #g { row-gap: 10px; }"), 400, -1)
    assert_eq(box_at_id(gp, d, "c").y, 60)
    assert_eq(layout::shortest_track([5, 3, 3, 9], 0, 4), 1)
end

