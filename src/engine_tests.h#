fn tl_sheet(extra: string) -> css::Stylesheet is
    return css::parse(string_replace("@keyframes k { from { opacity: 0; } to { opacity: 1; } } #a { animation: k 1000ms linear both; XTRA }", "XTRA", extra))
end

#[test]
fn t04_timeline_scroll_progress_page_and_container() is
    ;; strona: przewinięcie 300 z max 600 → 50%
    let d: dom::Dom = dom::parse("<div id=\"a\">x</div>")
    let boxes: [layout::LayoutBox] = layout::layout(d, tl_sheet("animation-timeline: scroll(root);"), 400, -1)
    let aid: int = dom::find_by_id(d, "a")
    let st: style::ComputedStyle = find_box(boxes, aid, "box").st
    assert_eq(layout::timeline_elapsed(boxes, d, aid, st, 300, 600, 400, 300), 500)
    assert_eq(layout::timeline_elapsed(boxes, d, aid, st, 0, 600, 400, 300), 0)
    assert_eq(layout::timeline_elapsed(boxes, d, aid, st, 900, 600, 400, 300), 1000)
    ;; animation-range 25% 75% na osi przewijania
    let b2: [layout::LayoutBox] = layout::layout(d, tl_sheet("animation-timeline: scroll(root); animation-range: 25% 75%;"), 400, -1)
    let st2: style::ComputedStyle = find_box(b2, aid, "box").st
    assert_eq(layout::timeline_elapsed(b2, d, aid, st2, 150, 600, 400, 300), 0)
    assert_eq(layout::timeline_elapsed(b2, d, aid, st2, 300, 600, 400, 300), 500)
    assert_eq(layout::timeline_elapsed(b2, d, aid, st2, 450, 600, 400, 300), 1000)
    ;; bez osi → -1 (czas zegarowy)
    let b3: [layout::LayoutBox] = layout::layout(d, tl_sheet(""), 400, -1)
    assert_eq(layout::timeline_elapsed(b3, d, aid, find_box(b3, aid, "box").st, 0, 600, 400, 300), -1)
end

#[test]
