#[test]
fn t04_transition_behavior_allow_discrete_flips_display_and_visibility_at_the_ends() is
    let a: style::ComputedStyle = emph_box("<p>a</p>", "p { margin: 0; }").st
    let mut b: style::ComputedStyle = style::copy_style(a)
    b.display = "none"
    b.visible = false
    b.xp = props::xset(b.xp, "transition-behavior", "allow-discrete")
    assert_true(anim::allow_discrete(b))
    assert_true(!anim::allow_discrete(a))
    ;; block → none: widoczny przez całe przejście, none dopiero na końcu
    let mid: style::ComputedStyle = anim::lerp_style(a, b, 500, false)
    assert_eq(mid.display, "block")
    assert_true(mid.visible)
    let end_st: style::ComputedStyle = anim::lerp_style(a, b, 1000, false)
    assert_eq(end_st.display, "none")
    assert_true(!end_st.visible)
    ;; none → block: widoczny od pierwszej klatki
    let mut a2: style::ComputedStyle = style::copy_style(a)
    a2.display = "none"
    a2.visible = false
    let mut b2: style::ComputedStyle = style::copy_style(a)
    b2.xp = props::xset(b2.xp, "transition-behavior", "allow-discrete")
    let m2: style::ComputedStyle = anim::lerp_style(a2, b2, 100, false)
    assert_eq(m2.display, "block")
    assert_true(m2.visible)
    ;; bez allow-discrete — wartość końcowa od razu
    let plain: style::ComputedStyle = anim::lerp_style(a, a2, 500, false)
    assert_eq(plain.display, "none")
    ;; przejście startuje także dla samej zmiany display/visibility
    assert_true(anim::geometry_differs(a, b))
    assert_true(!anim::geometry_differs(a, a2))
    let mut tp: style::ComputedStyle = style::copy_style(b)
    tp.trans_ms = 300
    tp.trans_prop = "opacity, display"
    assert_true(anim::trans_covers_geometry(tp))
    tp.trans_prop = "opacity"
    assert_true(!anim::trans_covers_geometry(tp))
end


