fn texts_of(boxes: [layout::LayoutBox], id: int) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == "text" is out = out + boxes[i].text end
        i += 1
    end
    return out
end

