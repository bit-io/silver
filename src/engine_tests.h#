;; ---------- dom::parse ----------

#[test]
fn test_dom_parses_nested_tags() is
    let d: dom::Dom = dom::parse("<div><p>Hej</p></div>")
    ;; nodes[0] = root, nodes[1] = div, nodes[2] = p, nodes[3] = text "Hej"
    assert_eq(d.nodes[1].tag, "div")
    assert_eq(d.nodes[2].tag, "p")
    assert_eq(d.nodes[3].tag, "text")
    assert_eq(d.nodes[3].text, "Hej")
end

#[test]
fn test_dom_parses_attributes() is
    let d: dom::Dom = dom::parse("<div id=\"card\" class=\"a b\" on-click=\"go\"></div>")
    assert_eq(d.nodes[1].attr_id, "card")
    assert_eq(d.nodes[1].attr_class, "a b")
    assert_eq(d.nodes[1].on_click, "go")
end

#[test]
fn test_dom_self_closing_img() is
    let d: dom::Dom = dom::parse("<div><img src=\"logo.png\" /></div>")
    assert_eq(d.nodes[2].tag, "img")
    assert_eq(d.nodes[2].attr_src, "logo.png")
end

#[test]
fn test_dom_sibling_children_order() is
    let d: dom::Dom = dom::parse("<div><span>a</span><span>b</span></div>")
    let div_children: [int] = d.nodes[1].children
    assert_eq(array_len(div_children), 2)
end

;; ---------- css::parse + kaskada ----------

#[test]
fn test_css_parses_rule() is
    let sheet: css::Stylesheet = css::parse(".button { background: blue; padding: 12px; }")
    assert_eq(array_len(sheet.rules), 1)
    assert_eq(sheet.rules[0].selector, ".button")
    assert_eq(array_len(sheet.rules[0].decls), 2)
end

#[test]
fn test_css_specificity_id_beats_class() is
    let sheet: css::Stylesheet = css::parse(
        ".x { color: red; } #y { color: blue; }")
    let decls: [css::CssDecl] = css::matching_decls(sheet, "div", "y", ["x"])
    ;; kaskada: ostatnia (najbardziej specyficzna) deklaracja wygrywa
    assert_eq(decls[array_len(decls) - 1].val, "blue")
end

;; ---------- css.h# — naprawa: wiele klas na jednym tokenie (.a.b) ----------

#[test]
fn test_css_multi_class_selector_matches_element_with_both() is
    ;; ".btn.primary" wymaga OBU klas na TYM SAMYM elemencie — dawniej
    ;; ten selektor po cichu nigdy nie dopasowywał (patrz komentarz
    ;; przy `css::selector_matches`).
    let ok: bool = css::selector_matches(".btn.primary", "div", "", ["btn", "primary"])
    assert_true(ok)
end

#[test]
fn test_css_multi_class_selector_rejects_partial_match() is
    ;; element ma tylko "btn", nie "primary" -> nie powinno dopasować
    let ok: bool = css::selector_matches(".btn.primary", "div", "", ["btn"])
    assert_true(!ok)
end

#[test]
fn test_css_tag_plus_class_selector() is
    ;; "div.btn" — tag I klasa naraz
    assert_true(css::selector_matches("div.btn", "div", "", ["btn"]))
    assert_true(!css::selector_matches("div.btn", "span", "", ["btn"]))
end

#[test]
fn test_css_id_plus_class_selector() is
    assert_true(css::selector_matches("#card.active", "div", "card", ["active"]))
    assert_true(!css::selector_matches("#card.active", "div", "other", ["active"]))
end

;; ---------- css::parse — rozbudowa: komentarze /* ... */ ----------

#[test]
fn test_css_strips_comment_before_selector() is
    ;; bez usuwania komentarzy ten komentarz wciągnąłby się do
    ;; selektora ".hint" i reguła po cichu przestałaby cokolwiek trafiać
    let sheet: css::Stylesheet = css::parse(
        "/* uwaga: to jest hint */\n.hint { color: red; }")
    assert_eq(array_len(sheet.rules), 1)
    assert_eq(sheet.rules[0].selector, ".hint")
end

#[test]
fn test_css_strips_comment_inside_block() is
    let sheet: css::Stylesheet = css::parse(
        ".x { /* to nie powinno się liczyć */ color: blue; }")
    assert_eq(array_len(sheet.rules[0].decls), 1)
    assert_eq(sheet.rules[0].decls[0].prop, "color")
end

#[test]
fn test_css_strips_multiple_comments() is
    let sheet: css::Stylesheet = css::parse(
        "/* a */ .x { color: red; } /* b */ .y { color: blue; }")
    assert_eq(array_len(sheet.rules), 2)
    assert_eq(sheet.rules[1].selector, ".y")
end

;; ---------- style::resolve — dziedziczenie ----------

#[test]
fn test_style_inherits_color() is
    let sheet: css::Stylesheet = css::parse("p { color: #ff0000; }")
    let parent: style::ComputedStyle = style::resolve(sheet, "p", "", [], style::root_style())
    ;; dziecko bez własnej reguły powinno odziedziczyć kolor rodzica
    let child: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "span", "", [], parent)
    assert_eq(child.color.r, 255)
    assert_eq(child.color.g, 0)
end

#[test]
fn test_style_heading_default_size() is
    let st: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "h1", "", [], style::root_style())
    assert_eq(st.font_size, 32)
end

;; ---------- style::resolve — rozbudowa: padding/margin per-strona ----------

#[test]
fn test_padding_shorthand_one_value() is
    let sheet: css::Stylesheet = css::parse("div { padding: 10px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.pad_top, 10)
    assert_eq(st.pad_right, 10)
    assert_eq(st.pad_bottom, 10)
    assert_eq(st.pad_left, 10)
end

#[test]
fn test_padding_shorthand_two_values() is
    ;; góra/dół = 10, lewo/prawo = 20 — dokładnie jak w CSS
    let sheet: css::Stylesheet = css::parse("div { padding: 10px 20px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.pad_top, 10)
    assert_eq(st.pad_bottom, 10)
    assert_eq(st.pad_right, 20)
    assert_eq(st.pad_left, 20)
end

#[test]
fn test_padding_shorthand_four_values() is
    ;; góra, prawo, dół, lewo — zgodnie z ruchem wskazówek zegara
    let sheet: css::Stylesheet = css::parse("div { padding: 1px 2px 3px 4px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.pad_top, 1)
    assert_eq(st.pad_right, 2)
    assert_eq(st.pad_bottom, 3)
    assert_eq(st.pad_left, 4)
end

#[test]
fn test_padding_longhand_overrides_shorthand() is
    ;; kolejność deklaracji w bloku decyduje — dokładnie jak w CSS,
    ;; więc padding-left po padding nadpisuje tylko lewy bok.
    let sheet: css::Stylesheet = css::parse("div { padding: 5px; padding-left: 40px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.pad_top, 5)
    assert_eq(st.pad_left, 40)
end

#[test]
fn test_margin_shorthand_three_values() is
    let sheet: css::Stylesheet = css::parse("div { margin: 1px 2px 3px; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.mar_top, 1)
    assert_eq(st.mar_right, 2)
    assert_eq(st.mar_left, 2)
    assert_eq(st.mar_bottom, 3)
end

