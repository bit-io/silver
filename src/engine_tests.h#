#[test]
fn test_hover_propagates_from_child_to_ancestor() is
    ;; najechanie na TEKST wewnątrz .btn (dziecko) musi dopasować regułę
    ;; ".btn:hover" na SAMYM .btn, nie tylko dosłowny węzeł tekstowy —
    ;; dokładnie jak w prawdziwej przeglądarce.
    let dom: dom::Dom = dom::parse("<div class=\"btn\"><span>Kliknij</span></div>")
    let sheet: css::Stylesheet = css::parse(".btn:hover { background: #ff0000; }")
    let mut btn_id: int = -1
    let mut span_id: int = -1
    let mut text_id: int = -1
    let count: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < count is
        if dom.nodes[i].attr_class == "btn" is btn_id = i end
        if dom.nodes[i].tag == "span" is span_id = i end
        if dom.nodes[i].tag == "text" is text_id = i end
        i += 1
    end
    assert_true(btn_id >= 0 && span_id >= 0 && text_id >= 0)

    ;; "trafiony" (hovered_id) to najgłębszy węzeł — tekst wewnątrz span
    let interaction: css::InteractionState = css::ix_legacy(text_id, "", -1)
    let btn_style: style::ComputedStyle = style::resolve_ctx(sheet, dom, btn_id, style::root_style(), interaction)
    assert_true(btn_style.has_bg)
end

#[test]
fn test_hover_does_not_propagate_to_unrelated_sibling() is
    let dom: dom::Dom = dom::parse(
        "<div><div class=\"a\"><span>x</span></div><div class=\"b\">y</div></div>")
    let sheet: css::Stylesheet = css::parse(".b:hover { background: #ff0000; }")
    let mut span_text_id: int = -1
    let mut b_id: int = -1
    let count: int = array_len(dom.nodes)
    let mut i: int = 0
    while i < count is
        if dom.nodes[i].attr_class == "b" is b_id = i end
        if dom.nodes[i].tag == "text" && dom.nodes[dom.nodes[i].parent].tag == "span" is span_text_id = i end
        i += 1
    end
    ;; hover jest w gałęzi .a, nie .b -> .b:hover NIE powinno dopasować
    let interaction: css::InteractionState = css::ix_legacy(span_text_id, "", -1)
    let b_style: style::ComputedStyle = style::resolve_ctx(sheet, dom, b_id, style::root_style(), interaction)
    assert_true(!b_style.has_bg)
end

