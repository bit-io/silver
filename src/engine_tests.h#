;; ---------- style::resolve — rozbudowa: jednostki em/rem ----------

#[test]
fn test_width_rem_multiplies_by_root_font_size() is
    ;; 1rem = 16px zawsze, niezależnie od odziedziczonego font-size
    let sheet: css::Stylesheet = css::parse("div { width: 2rem; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.width, 32)
end

#[test]
fn test_font_size_em_relative_to_inherited() is
    let mut parent: style::ComputedStyle = style::root_style()
    parent.font_size = 20
    let sheet: css::Stylesheet = css::parse("span { font-size: 1.5em; }")
    let st: style::ComputedStyle = style::resolve(sheet, "span", "", [], parent)
    assert_eq(st.font_size, 30)
end

#[test]
fn test_padding_em_uses_inherited_font_size() is
    let mut parent: style::ComputedStyle = style::root_style()
    parent.font_size = 10
    let sheet: css::Stylesheet = css::parse("div { padding: 1em 2em; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], parent)
    assert_eq(st.pad_top, 10)
    assert_eq(st.pad_right, 20)
end

#[test]
fn test_bare_number_without_unit_treated_as_px() is
    ;; leniency: "10" (bez jednostki) parsuje się tak samo jak "10px"
    let sheet: css::Stylesheet = css::parse("div { width: 10; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.width, 10)
end

#[test]
fn test_rem_independent_of_parent_font_size() is
    ;; w odróżnieniu od em, rem NIE zależy od odziedziczonego font-size
    let mut parent: style::ComputedStyle = style::root_style()
    parent.font_size = 40
    let sheet: css::Stylesheet = css::parse("div { width: 1rem; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], parent)
    assert_eq(st.width, 16)
end

#[test]
fn test_margin_auto_still_works_alongside_em() is
    ;; regresja: sentinel -1 (auto) nie powinien zderzyć się z nową
    ;; obsługą jednostek w tym samym skrócie.
    let sheet: css::Stylesheet = css::parse("div { margin: 1em auto; }")
    let mut parent: style::ComputedStyle = style::root_style()
    parent.font_size = 16
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], parent)
    assert_eq(st.mar_top, 16)
    assert_eq(st.mar_left, style::auto_val())
    assert_eq(st.mar_right, style::auto_val())
end

;; ---------- layout::layout — rozbudowa: margin: auto centruje blok ----------

#[test]
fn test_layout_margin_auto_centers_block() is
    ;; viewport 400px, blok o width:100px i margin:0 auto -> powinien
    ;; wylądować w x=150 (400-100=300 nadmiaru, po 150 na bok).
    let dom: dom::Dom = dom::parse("<div class=\"box\"></div>")
    let sheet: css::Stylesheet = css::parse(".box { width: 100px; height: 20px; margin: 0 auto; background: red; }")
    let boxes: [layout::LayoutBox] = layout::layout(dom, sheet, 400, -1)
    let mut found: layout::LayoutBox = boxes[0]
    let mut ok: bool = false
    let count: int = array_len(boxes)
    let mut i: int = 0
    while i < count is
        if boxes[i].w == 100 && boxes[i].h == 20 is
            found = boxes[i]
            ok = true
        end
        i += 1
    end
    assert_true(ok)
    assert_eq(found.x, 150)
end

#[test]
fn test_layout_margin_auto_no_explicit_width_is_noop() is
    ;; bez jawnej szerokości blok i tak wypełnia całą dostępną
    ;; przestrzeń -> margin:auto nie ma czego rozdzielać (x=0).
    let dom: dom::Dom = dom::parse("<div class=\"box\"></div>")
    let sheet: css::Stylesheet = css::parse(".box { height: 20px; margin: 0 auto; }")
    let boxes: [layout::LayoutBox] = layout::layout(dom, sheet, 400, -1)
    let mut found: layout::LayoutBox = boxes[0]
    let mut ok: bool = false
    let count: int = array_len(boxes)
    let mut i: int = 0
    while i < count is
        if boxes[i].h == 20 is
            found = boxes[i]
            ok = true
        end
        i += 1
    end
    assert_true(ok)
    assert_eq(found.x, 0)
end

;; ---------- layout::layout_i — rozbudowa: :hover przez pełny pipeline ----------

#[test]
fn test_layout_i_hover_changes_background() is
    let dom: dom::Dom = dom::parse("<div class=\"btn\">x</div>")
    let sheet: css::Stylesheet = css::parse(".btn:hover { background: red; }")
    let btn_id: int = 1  ;; nodes[0]=root, nodes[1]=div.btn

    let no_hover: [layout::LayoutBox] = layout::layout_i(dom, sheet, 400, -1, css::no_interaction())
    let mut bg_no_hover: bool = false
    let mut i: int = 0
    while i < array_len(no_hover) is
        if no_hover[i].node_id == btn_id && no_hover[i].st.has_bg is bg_no_hover = true end
        i += 1
    end
    assert_true(!bg_no_hover)

    let with_hover: [layout::LayoutBox] = layout::layout_i(
        dom, sheet, 400, -1, css::ix_legacy(btn_id, "", -1))
    let mut bg_hover: bool = false
    i = 0
    while i < array_len(with_hover) is
        if with_hover[i].node_id == btn_id && with_hover[i].st.has_bg is bg_hover = true end
        i += 1
    end
    assert_true(bg_hover)
end

;; ---------- style::resolve — rozbudowa: text-align, opacity ----------

#[test]
fn test_text_align_inherits_to_children() is
    let sheet: css::Stylesheet = css::parse("div { text-align: center; }")
    let parent: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(parent.text_align, "center")
    let child: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "span", "", [], parent)
    assert_eq(child.text_align, "center")
end

#[test]
fn test_opacity_not_inherited() is
    ;; opacity NIE dziedziczy w CSS (inaczej niż color/text-align) —
    ;; każdy element domyślnie startuje od 100 (w pełni kryjące).
    let sheet: css::Stylesheet = css::parse("div { opacity: 0.5; }")
    let parent: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(parent.opacity, 50)
    let child: style::ComputedStyle = style::resolve(css::Stylesheet { rules: [] }, "span", "", [], parent)
    assert_eq(child.opacity, 100)
end

#[test]
fn test_opacity_percent_syntax() is
    let sheet: css::Stylesheet = css::parse("div { opacity: 30%; }")
    let st: style::ComputedStyle = style::resolve(sheet, "div", "", [], style::root_style())
    assert_eq(st.opacity, 30)
end

;; ---------- layout::layout — rozbudowa: text-align w praktyce ----------

#[test]
fn test_layout_center_aligns_short_line() is
    ;; viewport szeroki (400px), krótki tekst wyśrodkowany w bloku na
    ;; całą szerokość -> x pudełka tekstu powinien być > 0 (przesunięty
    ;; od lewej krawędzi), nie stać przy inner_x jak przy "left".
    let dom: dom::Dom = dom::parse("<div><p>hi</p></div>")
    let sheet: css::Stylesheet = css::parse("div { width: 400px; } p { text-align: center; }")
    let boxes: [layout::LayoutBox] = layout::layout(dom, sheet, 400, -1)
    let mut found_x: int = -1
    let count: int = array_len(boxes)
    let mut i: int = 0
    while i < count is
        if boxes[i].text == "hi" is found_x = boxes[i].x end
        i += 1
    end
    assert_true(found_x > 0)
end

