;; ---------- 0.3: transformacje macierzowe (rotate, skew, matrix, rotate/scale/translate) ----------
fn m_of(st: style::ComputedStyle, i: int) -> int is
    return st.tr_m[i]
end

fn near(a: int, b: int, tol: int) -> bool is
    let d: int = a - b
    return d >= 0 - tol && d <= tol
end

#[test]
fn t03x_rotate_builds_matrix() is
    let st: style::ComputedStyle = st_for("<div class=\"a\">x</div>", ".a { transform: rotate(90deg); }", 1)
    assert_eq(array_len(st.tr_m), 6)
    assert_true(near(m_of(st, 0), 0, 2))
    assert_true(near(m_of(st, 1), 1000, 2))
    assert_true(near(m_of(st, 2), -1000, 2))
    assert_true(near(m_of(st, 3), 0, 2))
    assert_true(st.has_transform)
end

#[test]
fn t03x_rotate_45_and_units() is
    let st: style::ComputedStyle = st_for("<div class=\"a\">x</div>", ".a { transform: rotate(45deg); }", 1)
    assert_true(near(m_of(st, 0), 707, 3))
    assert_true(near(m_of(st, 1), 707, 3))
    let t: style::ComputedStyle = st_for("<div class=\"a\">x</div>", ".a { transform: rotate(0.25turn); }", 1)
    assert_true(near(m_of(t, 1), 1000, 3))
    let r: style::ComputedStyle = st_for("<div class=\"a\">x</div>", ".a { transform: rotate(-90deg); }", 1)
    assert_true(near(m_of(r, 1), -1000, 3))
end

#[test]
fn t03x_skew_and_matrix_functions() is
    let st: style::ComputedStyle = st_for("<div class=\"a\">x</div>", ".a { transform: skewX(45deg); }", 1)
    assert_true(near(m_of(st, 2), 1000, 5))
    assert_true(near(m_of(st, 1), 0, 1))
    let mx: style::ComputedStyle = st_for("<div class=\"a\">x</div>", ".a { transform: matrix(0, 1, -1, 0, 10, 20); }", 1)
    assert_eq(m_of(mx, 1), 1000)
    assert_eq(m_of(mx, 4), 10000)
    assert_eq(m_of(mx, 5), 20000)
end

#[test]
fn t03x_composition_order() is
    ;; translate(10px) rotate(90deg): obrót najpierw, potem przesunięcie → e = 10
    let st: style::ComputedStyle = st_for("<div class=\"a\">x</div>", ".a { transform: translate(10px, 0) rotate(90deg); }", 1)
    assert_eq(m_of(st, 4), 10000)
    ;; rotate(90deg) translate(10px,0): przesunięcie w obróconym układzie → f = 10
    let st2: style::ComputedStyle = st_for("<div class=\"a\">x</div>", ".a { transform: rotate(90deg) translate(10px, 0); }", 1)
    assert_true(near(m_of(st2, 5), 10000, 20))
    assert_true(near(m_of(st2, 4), 0, 20))
end

