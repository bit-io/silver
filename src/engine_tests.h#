#[test]
fn t04_tabular_nums_and_stretch_encode_into_text_flags() is
    let base: int = layout::style_flags(emph_box("<p>1</p>", "p { margin: 0; }").st)
    assert_true(!flag_bit(base, 256))
    let tn: int = layout::style_flags(emph_box("<p>1</p>", "p { margin: 0; font-variant-numeric: tabular-nums; }").st)
    assert_true(flag_bit(tn, 256))
    let tn2: int = layout::style_flags(emph_box("<p>1</p>", "p { margin: 0; font-feature-settings: \"tnum\"; }").st)
    assert_true(flag_bit(tn2, 256))
    ;; font-stretch: condensed = 75% → krok 15 w bitach 9..15
    let c: int = layout::style_flags(emph_box("<p>1</p>", "p { margin: 0; font-stretch: condensed; }").st)
    assert_eq((c / 512) % 64, 15)
    let e: int = layout::style_flags(emph_box("<p>1</p>", "p { margin: 0; font-stretch: 125%; }").st)
    assert_eq((e / 512) % 64, 25)
    let w: int = layout::style_flags(emph_box("<p>1</p>", "p { margin: 0; font-variation-settings: \"wdth\" 50; }").st)
    assert_eq((w / 512) % 64, 10)
    assert_eq((base / 512) % 64, 0)
    ;; stretch dziedziczy się
    let sp: int = layout::style_flags(emph_box("<div class=\"w\"><p>a</p></div>", ".w { font-stretch: ultra-expanded; } p { margin: 0; }").st)
    assert_eq((sp / 512) % 64, 40)
end

