fn t04_anchor_try_fallbacks_visibility_and_scope() is
    let src: string = "<div id=\"a\"></div><div id=\"t\"></div><div id=\"sp\"></div>"
    let d: dom::Dom = dom::parse(src)
    let ti: int = dom::find_by_id(d, "t")
    ;; kotwica przy y=5: tooltip 30px nie mieści się nad nią
    let base: string = "#a { anchor-name: --a; margin: 5px 0 0 100px; width: 60px; height: 20px; } #sp { height: 300px; } #t { position: absolute; width: 40px; height: 30px; position-anchor: --a; position-area: top; }"
    let no_fb: [layout::LayoutBox] = layout::layout(d, css::parse(base), 400, -1)
    assert_eq(find_box(no_fb, ti, "box").y, -25)
    let fb: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #t { position-try-fallbacks: flip-block; }"), 400, -1)
    assert_eq(find_box(fb, ti, "box").y, 25)
    ;; no-overflow ukrywa, gdy nic nie pasuje
    let hid: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #t { position-visibility: no-overflow; }"), 400, -1)
    assert_eq(count_boxes_of(hid, ti), 0)
    let ok: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #t { position-visibility: no-overflow; position-try-fallbacks: flip-block; }"), 400, -1)
    assert_true(count_boxes_of(ok, ti) > 0)
    ;; anchors-visible: brak kotwicy → ukryty
    let nov: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #t { position-anchor: --missing; position-visibility: anchors-visible; }"), 400, -1)
    assert_eq(count_boxes_of(nov, ti), 0)
    ;; anchor-scope: tooltip z drugiej sekcji (przed swoją kotwicą) bierze kotwicę z własnego zakresu
    let src2: string = "<div class=\"s\"><div id=\"a1\" class=\"a\"></div></div><div class=\"s\"><div id=\"t2\"></div><div id=\"a2\" class=\"a\"></div></div><div style=\"height:400px\"></div>"
    let d2: dom::Dom = dom::parse(src2)
    let css2: string = ".a { anchor-name: --k; width: 20px; height: 20px; } #a1 { margin-left: 10px; } #a2 { margin-left: 200px; } #t2 { position: absolute; width: 10px; height: 10px; top: anchor(--k bottom); left: anchor(--k left); }"
    let t2: int = dom::find_by_id(d2, "t2")
    let unscoped: [layout::LayoutBox] = layout::layout(d2, css::parse(css2), 400, -1)
    assert_eq(find_box(unscoped, t2, "box").x, 10)
    let scoped: [layout::LayoutBox] = layout::layout(d2, css::parse(css2 + " .s { anchor-scope: --k; }"), 400, -1)
    assert_eq(find_box(scoped, t2, "box").x, 200)
end



#[test]
fn t04_matrix4_math_and_projection() is
    let id: [int] = style::m4_id()
    let p0: [int] = style::m4_project(id, 10, 20)
    assert_eq(p0[0], 10)
    assert_eq(p0[1], 20)
    assert_eq(p0[2], 1000000)
    ;; perspektywa 500 + translateZ(100): skala 1/(1−100/500) = 1,25
    let m: [int] = style::m4_mul(style::m4_perspective(500), style::m4_translate(0, 0, 100))
    let p1: [int] = style::m4_project(m, 100, 0)
    assert_true(p1[0] >= 124 && p1[0] <= 126)
    ;; rotateX(60deg) bez perspektywy: y × cos60 = 0,5
    let rx: [int] = style::m4_rot_axis(1000, 0, 0, 600)
    let p2: [int] = style::m4_project(rx, 0, 100)
    assert_true(p2[1] >= 49 && p2[1] <= 51)
    ;; rotateY(90deg): x → 0
    let ry: [int] = style::m4_rot_axis(0, 1000, 0, 900)
    assert_true(style::m4_project(ry, 100, 0)[0] >= -1 && style::m4_project(ry, 100, 0)[0] <= 1)
    ;; punkt za kamerą (z > d) → w <= 0
    let behind: [int] = style::m4_mul(style::m4_perspective(100), style::m4_translate(0, 0, 200))
    assert_true(style::m4_project(behind, 5, 5)[2] <= 0)
    assert_eq(style::m4_parse(style::m4_str(id))[5], 1000000)
    assert_eq(array_len(style::m4_parse("1 2 3")), 0)
    let env: cssval::LenEnv = cssval::LenEnv { em: 16, rem: 16, vw: 400, vh: 300 }
    assert_eq(array_len(style::parse_transform4("rotate(10deg) scale(2)", env)), 0)
    assert_eq(array_len(style::parse_transform4("rotateY(45deg)", env)), 16)
    assert_eq(array_len(style::parse_transform4("translate3d(1px, 2px, 0)", env)), 0)
    assert_eq(array_len(style::parse_transform4("translate3d(1px, 2px, 5px)", env)), 16)
    assert_eq(array_len(style::parse_transform4("perspective(300px) rotateX(10deg)", env)), 16)
    let tz: [int] = style::parse_transform4("translateZ(30px)", env)
    assert_eq(tz[11], 30000000)
    let skew: [int] = style::parse_transform4("rotateX(0deg) skewX(45deg)", env)
    assert_eq(skew[1], 1000000)
end

#[test]
fn t04_transform_3d_group_gets_matrix_and_parent_perspective() is
    let src: string = "<div id=\"p\"><div id=\"c\"></div></div>"
    let d: dom::Dom = dom::parse(src)
    let ci: int = dom::find_by_id(d, "c")
    let css0: string = "#p { margin: 0; perspective: 400px; } #c { width: 100px; height: 100px; transform: rotateY(45deg); }"
    let bs: [layout::LayoutBox] = layout::layout(d, css::parse(css0), 400, -1)
    let cb: layout::LayoutBox = find_box(bs, ci, "box")
    assert_true(cb.m3d != "")
    assert_eq(array_len(cb.xf), 12)
    assert_true(string_ends_with(cb.m3d, "|0"))
    ;; rodzic z perspektywą nadaje macierzy składnik w (m[14] ≠ 0)
    let nums: [string] = string_split(string_slice(cb.m3d, 0, string_find(cb.m3d, "|")), " ")
    assert_true(str_to_int(nums[14]) != 0)
    ;; bez perspektywy rodzica — m[14] = 0
    let flat: [layout::LayoutBox] = layout::layout(d, css::parse("#c { width: 100px; height: 100px; transform: rotateY(45deg); }"), 400, -1)
    let fb: layout::LayoutBox = find_box(flat, ci, "box")
    assert_true(fb.m3d != "")
    assert_eq(str_to_int(string_split(string_slice(fb.m3d, 0, string_find(fb.m3d, "|")), " ")[14]), 0)
    ;; backface-visibility: hidden → znacznik |1
    let hid: [layout::LayoutBox] = layout::layout(d, css::parse(css0 + " #c { backface-visibility: hidden; }"), 400, -1)
    assert_true(string_ends_with(find_box(hid, ci, "box").m3d, "|1"))
    ;; zwykła transformacja 2D nie tworzy m3d
    let two: [layout::LayoutBox] = layout::layout(d, css::parse("#c { width: 10px; height: 10px; transform: rotate(10deg); }"), 400, -1)
    assert_eq(find_box(two, ci, "box").m3d, "")
    ;; perspective-origin przesuwa punkt zbiegu
    let o1: [layout::LayoutBox] = layout::layout(d, css::parse(css0 + " #p { perspective-origin: 0% 0%; }"), 400, -1)
    let o2: [layout::LayoutBox] = layout::layout(d, css::parse(css0), 400, -1)
    assert_true(find_box(o1, ci, "box").m3d != find_box(o2, ci, "box").m3d)
end


