fn emph_box(html: string, css_text: string) -> layout::LayoutBox is
    let boxes: [layout::LayoutBox] = lay(html, css_text, 400)
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

#[test]
fn t04_text_emphasis_glyph_styles() is
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: dot; }").st), "•")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: open dot; }").st), "◦")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: filled circle; }").st), "●")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: open circle; }").st), "○")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: double-circle; }").st), "◉")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: triangle; }").st), "▲")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: open triangle; }").st), "△")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: \"*\"; }").st), "*")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { text-emphasis-style: none; }").st), "")
    assert_eq(layout::emphasis_glyph(emph_box("<p>ab</p>", "p { margin: 0; }").st), "")
    ;; skrót text-emphasis: styl + kolor
    let b: layout::LayoutBox = emph_box("<p>ab</p>", "p { text-emphasis: open circle #ff0000; }")
    assert_eq(layout::emphasis_glyph(b.st), "○")
    assert_eq(props::xget(b.st.xp, "text-emphasis-color"), "#ff0000")
end

#[test]
fn t04_text_emphasis_marks_positions_skip_and_position() is
    ;; "ab c" → znaczniki nad a, b, c (spacja pominięta domyślnie), środki znaków (9 px/znak przy 16px)
    let b: layout::LayoutBox = emph_box("<p>ab c</p>", "p { margin: 0; text-emphasis-style: dot; }")
    let m: [int] = layout::emphasis_marks(b, -1)
    assert_eq(array_len(m), 6)
    assert_true(m[0] > b.x && m[0] < b.x + 9)
    assert_true(m[2] > m[0])
    ;; nad tekstem: y = góra − wysokość znacznika (8·1.2 → 9)
    assert_eq(m[1], b.y - 9)
    ;; pod tekstem
    let u: layout::LayoutBox = emph_box("<p>ab</p>", "p { margin: 0; text-emphasis-style: dot; text-emphasis-position: under right; }")
    assert_eq(layout::emphasis_marks(u, -1)[1], u.y + u.h)
    ;; interpunkcja domyślnie pomijana; skip: spaces oznacza pomijanie tylko spacji
    let p: layout::LayoutBox = emph_box("<p>a,b</p>", "p { margin: 0; text-emphasis-style: dot; }")
    assert_eq(array_len(layout::emphasis_marks(p, -1)), 4)
    let all: layout::LayoutBox = emph_box("<p>a,b</p>", "p { margin: 0; text-emphasis-style: dot; text-emphasis-skip: spaces; }")
    assert_eq(array_len(layout::emphasis_marks(all, -1)), 6)
end

;; ====================== 0.4: font-synthesis ======================
#[test]
fn t04_font_synthesis_flags_and_small_caps_gate() is
    let b: layout::LayoutBox = emph_box("<p>abc</p>", "p { font-weight: bold; font-style: italic; }")
    assert_true(synth_flag_ok(b.st, 0))
    let n: layout::LayoutBox = emph_box("<p>abc</p>", "p { font-weight: bold; font-style: italic; font-synthesis: none; }")
    assert_true(!layout::synth_allowed(n.st, "weight") && !layout::synth_allowed(n.st, "style") && !layout::synth_allowed(n.st, "small-caps"))
    let w: layout::LayoutBox = emph_box("<p>abc</p>", "p { font-synthesis: weight; }")
    assert_true(layout::synth_allowed(w.st, "weight") && !layout::synth_allowed(w.st, "style"))
    let l: layout::LayoutBox = emph_box("<p>abc</p>", "p { font-synthesis-weight: none; }")
    assert_true(!layout::synth_allowed(l.st, "weight") && layout::synth_allowed(l.st, "style"))
    ;; small-caps: syntezowane wersaliki tylko gdy wolno
    let sc: [layout::LayoutBox] = lay("<p>abc</p>", "p { margin: 0; font-variant: small-caps; }", 400)
    assert_eq(texts_flat(sc)[0], "ABC")
    let nosc: [layout::LayoutBox] = lay("<p>abc</p>", "p { margin: 0; font-variant: small-caps; font-synthesis-small-caps: none; }", 400)
    assert_eq(texts_flat(nosc)[0], "abc")
    let nosc2: [layout::LayoutBox] = lay("<p>abc</p>", "p { margin: 0; font-variant: small-caps; font-synthesis: none; }", 400)
    assert_eq(texts_flat(nosc2)[0], "abc")
    ;; dziedziczone przez potomków
    let inh: [layout::LayoutBox] = lay("<div><p>abc</p></div>", "div { font-variant-caps: all-small-caps; }", 400)
    assert_eq(texts_flat(inh)[0], "ABC")
end

fn synth_flag_ok(st: style::ComputedStyle, x: int) -> bool is
    return layout::synth_allowed(st, "weight") && layout::synth_allowed(st, "style")
end

