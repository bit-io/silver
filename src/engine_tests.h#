;; ---------- css2 (v0.2) ----------
#[test]
fn t_parse_media_important() is
    let sheet: css::Stylesheet = css::parse("p { color: red !important; } @media (max-width: 500px) { p { color: blue; } } @import 'x.css'; .a, .b { margin: 1px; }")
    assert_eq(array_len(sheet.rules), 4)
    assert_true(sheet.rules[0].decls[0].important)
    assert_eq(sheet.rules[1].media, "(max-width: 500px)")
    let mut ix: css::InteractionState = css::no_interaction()
    ix.viewport_w = 400
    assert_true(css::media_matches(sheet.rules[1].media, ix))
    ix.viewport_w = 600
    assert_true(!css::media_matches(sheet.rules[1].media, ix))
    ix.dark = true
    assert_true(css::media_matches("(prefers-color-scheme: dark)", ix))
end

