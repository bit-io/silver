    let css_text: string = "div { background: #ff0000; } .keep { print-color-adjust: exact; } p { opacity: 0.5; } @media print { p { opacity: 0.25; } } @media screen { p { opacity: 0.75; } }"
    let scr: [style::ComputedStyle] = layout::compute_styles(d, css::parse(css_text), css::no_interaction())
    assert_eq(scr[dom::find_by_id(d, "c")].opacity, 75)
