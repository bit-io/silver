fn rule_sels(sheet: css::Stylesheet) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(sheet.rules) is
        out = out + "[" + sheet.rules[i].selector + "]"
        i += 1
    end
    return out
end

