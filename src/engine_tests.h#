fn forced_styles(css_text: string, dark: bool) -> [style::ComputedStyle] is
    let d: dom::Dom = dom::parse("<p id=\"p\">t</p><a id=\"l\" href=\"x\">l</a><p id=\"k\" class=\"keep\">k</p><button id=\"b\">b</button><p id=\"m\">m</p><p id=\"q\" class=\"pp\">q</p>")
    let mut ix: css::InteractionState = css::no_interaction()
    ix.forced = true
    ix.dark = dark
    return layout::compute_styles(d, css::parse(css_text), ix)
end

fn fid(id: string) -> int is
    return dom::find_by_id(dom::parse("<p id=\"p\">t</p><a id=\"l\" href=\"x\">l</a><p id=\"k\" class=\"keep\">k</p><button id=\"b\">b</button><p id=\"m\">m</p><p id=\"q\" class=\"pp\">q</p>"), id)
end

