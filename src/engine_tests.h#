fn t04_empty_cells_hide_skips_empty_cell_box() is
    let html: string = "<table><tr><td id=\"e\"></td><td id=\"f\">x</td></tr></table>"
    let d: dom::Dom = dom::parse(html)
    let css_show: string = "table { display: table; border-collapse: separate; } td { border: 1px solid red; empty-cells: show; }"
    let css_hide: string = "table { display: table; border-collapse: separate; } td { border: 1px solid red; empty-cells: hide; }"
    let eid: int = dom::find_by_id(d, "e")
    assert_true(first_box_y(layout::layout(d, css::parse(css_show), 400, -1), eid) >= 0)
    assert_eq(first_box_y(layout::layout(d, css::parse(css_hide), 400, -1), eid), -1)
end

