    ;; raise: ten sam rozmiar, mniejsze zagłębienie
    let rs: [layout::LayoutBox] = lay("<p>Lorem " + words + "</p>", "p { margin: 0; } p::first-letter { initial-letter: 3 1; }", 300)
    assert_eq(first_text_box(rs).st.font_size, cap.st.font_size)
