#[test]
fn t04_hanging_punctuation_first_last_and_force_end() is
    let base: layout::LayoutBox = emph_box("<p>\u201cHello world\u201d</p>", "p { margin: 0; }")
    let hf: layout::LayoutBox = emph_box("<p>\u201cHello world\u201d</p>", "p { margin: 0; hanging-punctuation: first; }")
    assert_true(hf.x < base.x)
    assert_true(base.x - hf.x > 3 && base.x - hf.x <= 16)
    ;; nie-otwierający znak na początku — bez wysunięcia
    let nb: layout::LayoutBox = emph_box("<p>Hello</p>", "p { margin: 0; hanging-punctuation: first; }")
    assert_eq(nb.x, base.x)
    ;; last: zamykający cudzysłów wystaje za prawą krawędź przy text-align: right
    let r0: layout::LayoutBox = emph_box("<p>Hi\u201d</p>", "p { margin: 0; text-align: right; }")
    let r1: layout::LayoutBox = emph_box("<p>Hi\u201d</p>", "p { margin: 0; text-align: right; hanging-punctuation: last; }")
    assert_true(r1.x + r1.w > r0.x + r0.w)
    ;; force-end: kropka na końcu każdego wiersza
    let f0: layout::LayoutBox = emph_box("<p>Hi.</p>", "p { margin: 0; text-align: right; }")
    let f1: layout::LayoutBox = emph_box("<p>Hi.</p>", "p { margin: 0; text-align: right; hanging-punctuation: force-end; }")
    assert_true(f1.x + f1.w > f0.x + f0.w)
    ;; first nie wpływa na prawy brzeg
    let f2: layout::LayoutBox = emph_box("<p>Hi.</p>", "p { margin: 0; text-align: right; hanging-punctuation: first; }")
    assert_eq(f2.x + f2.w, f0.x + f0.w)
    assert_true(layout::hp_is_opening("("))
    assert_true(layout::hp_is_closing("\u201d"))
    assert_true(layout::hp_is_stop("\u3002"))
    assert_true(!layout::hp_is_opening("a"))
end

fn min_text_x_in_band(boxes: [layout::LayoutBox], y0: int, y1: int) -> int is
    let mut best: int = 1000000
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        if b.kind == "text" && b.y >= y0 && b.y < y1 && b.x < best is best = b.x end
        i += 1
    end
    return best
end

