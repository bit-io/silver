end

#[test]
fn t04_speak_as_transforms_text() is
    assert_eq(speech::transform("HTML5 ok", sa(true, false, "")), "H T M L 5 o k")
    assert_eq(speech::transform("Call 112 now", sa(false, true, "")), "Call 1 1 2 now")
    assert_eq(speech::transform("Hi, you!", sa(false, false, "literal")), "Hi comma you exclamation mark")
    assert_eq(speech::transform("Hi, you!", sa(false, false, "none")), "Hi you")
    assert_eq(speech::transform("a   b", sa(false, false, "")), "a b")
    assert_eq(speech::transform("Hi, you!", sa(false, false, "")), "Hi, you!")
    ;; kombinacje: spell-out + no-punctuation
    assert_eq(speech::transform("A-1.", sa(true, false, "none")), "A 1")
    let m: speech::SpeakAs = speech::parse_speak_as("spell-out digits literal-punctuation")
    assert_true(m.spell && m.digits && m.punct == "literal")
    let n: speech::SpeakAs = speech::parse_speak_as("normal")
    assert_true(!n.spell && !n.digits && n.punct == "")
end

