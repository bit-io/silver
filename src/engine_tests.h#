#[test]
fn t04_overflow_clip_margin_expands_clip_rect() is
    let d: dom::Dom = dom::parse("<div id=\"a\"><p>x</p></div>")
    let base: string = "#a { width: 100px; height: 50px; padding: 10px; border: 4px solid red; overflow: clip; } p { margin: 0; }"
    let get: [layout::LayoutBox] = layout::layout(d, css::parse(base), 400, -1)
    let g1: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #a { overflow-clip-margin: 6px; }"), 400, -1)
    let g2: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #a { overflow-clip-margin: content-box 3px; }"), 400, -1)
    let g3: [layout::LayoutBox] = layout::layout(d, css::parse(base + " #a { overflow: hidden; overflow-clip-margin: 6px; }"), 400, -1)
    let pid: int = dom::find_by_id(d, "a")
    let c0: layout::LayoutBox = first_clipped_child(get, pid)
    let c1: layout::LayoutBox = first_clipped_child(g1, pid)
    let c2: layout::LayoutBox = first_clipped_child(g2, pid)
    let c3: layout::LayoutBox = first_clipped_child(g3, pid)
    ;; padding-box (domyślnie) rozszerzony o 6 z każdej strony
    assert_eq(c1.cx, c0.cx - 6)
    assert_eq(c1.cw, c0.cw + 12)
    ;; content-box 3px: padding 10 odjęte, +3 margines
    assert_eq(c2.cx, c0.cx + 10 - 3)
    assert_eq(c2.cw, c0.cw - 20 + 6)
    ;; margines nie działa przy overflow: hidden
    assert_eq(c3.cx, c0.cx)
end

fn first_clipped_child(boxes: [layout::LayoutBox], parent_id: int) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].has_clip is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

#[test]
fn t04_clip_rect_on_absolute_elements() is
    let d: dom::Dom = dom::parse("<div id=\"a\"><p id=\"c\">tresc</p></div><div id=\"b\"><p>x</p></div>")
    let css_text: string = "#a { position: absolute; left: 10px; top: 20px; width: 100px; height: 60px; clip: rect(5px, 70px, 50px, 10px); } #b { width: 50px; height: 50px; clip: rect(0, 5px, 5px, 0); } p { margin: 0; }"
    let boxes: [layout::LayoutBox] = layout::layout(d, css::parse(css_text), 400, -1)
    let a: layout::LayoutBox = find_box(boxes, dom::find_by_id(d, "a"), "box")
    assert_true(a.has_clip)
    assert_eq(a.cx, a.x + 10)
    assert_eq(a.cy, a.y + 5)
    assert_eq(a.cw, 60)
    assert_eq(a.ch, 45)
    ;; potomkowie przycięci tym samym prostokątem
    let c: layout::LayoutBox = find_box(boxes, dom::find_by_id(d, "c"), "box")
    assert_true(c.has_clip && c.cx >= a.x + 10 && c.cw <= 60)
    ;; clip nie działa na elementach w przepływie
    let b: layout::LayoutBox = find_box(boxes, dom::find_by_id(d, "b"), "box")
    assert_true(!b.has_clip)
    ;; auto = krawędź pudełka
    let d2: dom::Dom = dom::parse("<div id=\"a\"></div>")
    let b2: layout::LayoutBox = find_box(layout::layout(d2, css::parse("#a { position: fixed; width: 80px; height: 40px; clip: rect(auto, 30px, auto, auto); }"), 400, -1), dom::find_by_id(d2, "a"), "box")
    assert_eq(b2.cw, 30)
    assert_eq(b2.ch, 40)
end

;; ====================== 0.4: color-scheme ======================
#[test]
fn t04_color_scheme_defaults_and_resolution() is
    let d: dom::Dom = dom::parse("<html><body><p id=\"a\">x</p><p id=\"b\" style=\"color:#123456\">y</p></body></html>")
    let mut dark: css::InteractionState = css::no_interaction()
    dark.dark = true
    let st: [style::ComputedStyle] = layout::compute_styles(d, css::parse("html { color-scheme: dark; }"), dark)
    let a: style::ComputedStyle = st[dom::find_by_id(d, "a")]
    ;; element dziedziczy jasny tekst od html
    assert_eq(a.color.r, 232)
    assert_eq(layout::used_scheme(a, false), "dark")
    ;; jawny kolor autora nie jest nadpisywany
    assert_eq(st[dom::find_by_id(d, "b")].color.r, 18)
    ;; `light dark` zależy od preferencji systemu; `light` zawsze jasny; normal → ""
    let both: [style::ComputedStyle] = layout::compute_styles(d, css::parse("html { color-scheme: light dark; }"), css::no_interaction())
    assert_eq(layout::used_scheme(both[dom::find_by_id(d, "a")], false), "light")
    assert_eq(layout::used_scheme(both[dom::find_by_id(d, "a")], true), "dark")
    assert_eq(both[dom::find_by_id(d, "a")].color.r, 20)
    let dk2: [style::ComputedStyle] = layout::compute_styles(d, css::parse("html { color-scheme: light dark; }"), dark)
    assert_eq(dk2[dom::find_by_id(d, "a")].color.r, 232)
    let norm: [style::ComputedStyle] = layout::compute_styles(d, css::parse("p { margin: 0; }"), dark)
    assert_eq(layout::used_scheme(norm[dom::find_by_id(d, "a")], true), "")
    assert_eq(norm[dom::find_by_id(d, "a")].color.r, 20)
end

