;; ====================== 0.4: typografia (typo.h#, font-size-adjust, font-stretch, …) ======================
fn joined_text(boxes: [layout::LayoutBox]) -> string is
    let t: [string] = texts_flat(boxes)
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(t) is
        out = out + t[i]
        i += 1
    end
    return out
end

fn flag_bit(flags: int, bit: int) -> bool is
    return (flags / bit) % 2 == 1
end

