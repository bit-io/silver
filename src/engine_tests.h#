#[test]
fn t04_timeline_view_progress_entry_exit() is
    ;; element 50 px na y=400; okno 300: cover D = 350; cur = (300 − (400 − scroll))
    let d: dom::Dom = dom::parse("<div style=\"height:400px\"></div><div id=\"a\" style=\"height:50px\">x</div>")
    let boxes: [layout::LayoutBox] = layout::layout(d, tl_sheet("animation-timeline: view();"), 400, -1)
    let aid: int = dom::find_by_id(d, "a")
    let st: style::ComputedStyle = find_box(boxes, aid, "box").st
    ;; scroll 100: obiekt na y=300 → dotyka dołu okna → 0
    assert_eq(layout::timeline_elapsed(boxes, d, aid, st, 100, 0, 400, 300), 0)
    ;; scroll 275: y=125, cur = 175 → 50% z 350
    assert_eq(layout::timeline_elapsed(boxes, d, aid, st, 275, 0, 400, 300), 500)
    ;; scroll 450: y=-50 (cały wyszedł górą) → 100%
    assert_eq(layout::timeline_elapsed(boxes, d, aid, st, 450, 0, 400, 300), 1000)
    ;; animation-range: entry — animacja kończy się, gdy obiekt w pełni wejdzie (cur = 50)
