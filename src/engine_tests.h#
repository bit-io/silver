    assert_true(cap.st.font_size >= 70 && cap.st.font_size <= 82)
    ;; trzy pierwsze wiersze omijają literę, czwarty wraca do lewej krawędzi
    assert_true(min_body_x_in_band(boxes, 0, 20) > 40)
