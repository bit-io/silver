#[test]
fn t_overflow_clip_and_scroll() is
    let html: string = "<div class=\"s\"><div class=\"c\">x</div></div>"
    let css_text: string = ".s { height: 50px; overflow: auto; width: 100px; } .c { height: 200px; }"
    let d: dom::Dom = dom::parse(html)
    let sheet: css::Stylesheet = css::parse(css_text)
    let r0: layout::LayoutResult = layout::layout_full(d, sheet, 400, 300, -1, css::no_interaction(), [])
    let c0: layout::LayoutBox = find_box(r0.boxes, 2, "box")
    assert_true(c0.has_clip)
    assert_eq(c0.ch, 50)
    assert_eq(find_box(r0.boxes, 1, "box").content_h, 200)
    let sc: [int] = [1, 80]
    let r1: layout::LayoutResult = layout::layout_full(d, sheet, 400, 300, -1, css::no_interaction(), sc)
    assert_eq(find_box(r1.boxes, 2, "box").y, -80)
    assert_eq(find_box(r1.boxes, 1, "box").scroll_y, 80)
end

