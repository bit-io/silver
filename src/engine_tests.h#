#[test]
fn t03_curl_output_parsing() is
    let raw: string = "HTTP/1.1 301 Moved\r\nLocation: /x\r\n\r\nHTTP/2 200 OK\r\nContent-Type: application/json\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\n\r\n{\"ok\":true}"
    let r: string = netutil::parse_curl_output(raw)
    assert_eq(jsonlite::get_int(r, "status"), 200)
    assert_eq(jsonlite::get_bool(r, "ok"), true)
    assert_eq(jsonlite::get_str(r, "body"), "{\"ok\":true}")
    assert_eq(jsonlite::get_str(r, "statusText"), "OK")
    let h: string = jsonlite::get_raw(r, "headers")
    assert_eq(jsonlite::get_str(h, "content-type"), "application/json")
    assert_eq(jsonlite::get_str(h, "set-cookie"), "a=1, b=2")
    let e: string = netutil::parse_curl_output("HTTP/1.1 404 Not Found\r\nX-A: b\r\n\r\nbrak")
    assert_eq(jsonlite::get_int(e, "status"), 404)
    assert_eq(jsonlite::get_bool(e, "ok"), false)
end

