#[test]
fn t04_text_justify_none_disables_justification_and_inter_character_spaces_letters() is
    let html: string = "<p id=\"p\">aaaa bbbb cccc dddd eeee ffff gggg hhhh</p>"
    let d: dom::Dom = dom::parse(html)
    let pid: int = dom::find_by_id(d, "p")
    let base: string = "p { margin: 0; width: 200px; text-align: justify; }"
    let j0: [layout::LayoutBox] = layout::layout(d, css::parse(base), 400, -1)
    let jn: [layout::LayoutBox] = layout::layout(d, css::parse(base + " p { text-justify: none; }"), 400, -1)
    let jc: [layout::LayoutBox] = layout::layout(d, css::parse(base + " p { text-justify: inter-character; }"), 400, -1)
    ;; pierwszy wiersz: justowany sięga do prawej krawędzi, z `none` kończy się wcześniej
    fn_right_of_first_line_is(j0, pid, 200, true)
    fn_right_of_first_line_is(jn, pid, 200, false)
    ;; inter-character: ten sam wiersz też wypełnia szerokość, a pola letter_spacing rosną
    fn_right_of_first_line_is(jc, pid, 200, true)
    let t: [layout::LayoutBox] = texts_boxes(jc, pid)
    assert_true(t[0].st.letter_spacing > 0)
    assert_eq(texts_boxes(j0, pid)[0].st.letter_spacing, 0)
end

fn texts_boxes(boxes: [layout::LayoutBox], id: int) -> [layout::LayoutBox] is
    let mut out: [layout::LayoutBox] = []
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].node_id == id is out = array_push(out, boxes[i]) end
        i += 1
    end
    return out
end

fn fn_right_of_first_line_is(boxes: [layout::LayoutBox], id: int, width: int, flush: bool) -> bool is
    let t: [layout::LayoutBox] = texts_boxes(boxes, id)
    let first_y: int = t[0].y
    let mut right: int = 0
    let mut i: int = 0
    while i < array_len(t) is
        if t[i].y == first_y && t[i].x + t[i].w > right is right = t[i].x + t[i].w end
        i += 1
    end
    let left: int = t[0].x
    let span: int = right - left
    if flush is
        assert_true(span >= width - 2)
    else is
        assert_true(span < width - 2)
    end
    return true
end

