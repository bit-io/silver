fn first_box_y(boxes: [layout::LayoutBox], node_id: int) -> int is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == node_id && boxes[i].kind == "box" is return boxes[i].y end
        i += 1
    end
    return -1
end

#[test]
fn t04_caption_side_bottom_moves_caption_below_rows() is
    let html: string = "<table><caption id=\"c\">Cap</caption><tr><td id=\"a\">x</td></tr></table>"
    let top: dom::Dom = dom::parse(html)
    let bt: [layout::LayoutBox] = layout::layout(top, css::parse("table { display: table; }"), 400, -1)
    let bb: [layout::LayoutBox] = layout::layout(top, css::parse("table { display: table; } caption { caption-side: bottom; }"), 400, -1)
    let cid: int = dom::find_by_id(top, "c")
    let aid: int = dom::find_by_id(top, "a")
    assert_true(first_box_y(bt, cid) <= first_box_y(bt, aid))
    assert_true(first_box_y(bb, cid) > first_box_y(bb, aid))
end

