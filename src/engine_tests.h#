    let boxes: [layout::LayoutBox] = lay("<p>Lorem " + words + "</p>", "p { margin: 0; } p::first-letter { initial-letter: 3; }", 300)
    let cap: layout::LayoutBox = first_text_box(boxes)
    assert_eq(cap.text, "L")
