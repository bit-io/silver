;; ---------- style2 (v0.2) ----------
fn st_for(html: string, css_text: string, idx: int) -> style::ComputedStyle is
    let d: dom::Dom = dom::parse(html)
    let sheet: css::Stylesheet = css::parse(css_text)
    return style::resolve_ctx(sheet, d, idx, style::root_style(), css::no_interaction())
end

