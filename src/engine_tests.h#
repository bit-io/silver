fn xf_count(boxes: [layout::LayoutBox], id: int) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].xf_id == id is n += 1 end
        i += 1
    end
    return n
end

#[test]
fn t03x_layout_marks_rotated_subtree() is
    let css_t: string = ".a { width: 100px; height: 40px; transform: rotate(90deg); } .k { height: 10px; }"
    let boxes: [layout::LayoutBox] = lay("<div class=\"a\"><div class=\"k\">q</div></div><div class=\"o\">z</div>", css_t, 400)
    let a: layout::LayoutBox = find_box(boxes, 1, "box")
    assert_eq(a.xf_id, 1)
    assert_eq(array_len(a.xf), 12)
    ;; punkt obrotu = środek (50,20)
    assert_eq(a.xf[6], 50)
    assert_eq(a.xf[7], 20)
    assert_true(xf_count(boxes, 1) >= 3)
    ;; geometria nie jest zmieniana (obrót robi warstwa natywna)
    assert_eq(a.w, 100)
    assert_eq(a.h, 40)
    assert_eq(find_box(boxes, 5, "box").xf_id, 0)
end

