#[test]
fn t_text_wraps() is
    let long: string = "aaaa bbbb cccc dddd eeee ffff gggg hhhh iiii jjjj kkkk llll mmmm nnnn oooo pppp"
    let boxes: [layout::LayoutBox] = lay("<p class=\"p\">" + long + "</p>", ".p { width: 200px; margin: 0; }", 400)
    let mut text_boxes: int = 0
    let mut max_right: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is
            text_boxes += 1
            if boxes[i].x + boxes[i].w > max_right is max_right = boxes[i].x + boxes[i].w end
        end
        i += 1
    end
    assert_true(text_boxes >= 3)
    assert_true(max_right <= 200)
    assert_true(find_box(boxes, 1, "box").h > 40)
end

