;; ====================== 0.4: touch-action i gesty dotykowe ======================
fn tdown(o: touch::TouchOut, id: int, x: int, y: int, bits: int) -> touch::TouchOut is
    return touch::touch_down(o.state, id, x, y, bits, o.state[12])
end

fn tmove(o: touch::TouchOut, id: int, x: int, y: int) -> touch::TouchOut is
    return touch::touch_move(o.state, id, x, y)
end

fn tstart() -> touch::TouchOut is
    return touch::TouchOut { state: touch::new_state(), scroll_dx: 0, scroll_dy: 0, mouse: [], zoom: -1 }
end

#[test]
fn t04_touch_action_values_and_ancestor_intersection() is
    assert_eq(touch::bits_of_value("auto"), 31)
    assert_eq(touch::bits_of_value("manipulation"), 31)
    assert_eq(touch::bits_of_value("none"), 0)
    assert_eq(touch::bits_of_value("pan-x"), 3)
    assert_eq(touch::bits_of_value("pan-y"), 12)
    assert_eq(touch::bits_of_value("pan-x pan-y"), 15)
    assert_eq(touch::bits_of_value("pan-left pan-down"), 9)
    assert_eq(touch::bits_of_value("pan-x pinch-zoom"), 19)
    assert_eq(touch::bits_of_value("pinch-zoom"), 16)
    ;; element i przodkowie: przecięcie
    assert_eq(touch::bits_chain(["auto", "pan-x"]), 3)
    assert_eq(touch::bits_chain(["pan-x", "pan-y"]), 0)
    assert_eq(touch::bits_chain(["pan-x pan-y", "pan-y"]), 12)
    assert_eq(touch::bits_chain(["", "none"]), 0)
end

#[test]
fn t04_touch_tap_pan_and_blocked_gestures() is
    ;; tap = klik
    let tap: touch::TouchOut = touch::touch_up(tdown(tstart(), 1, 10, 10, 31).state, 1, 10, 10)
    assert_eq(tap.mouse[0], "down:10,10")
    assert_eq(tap.mouse[1], "up:10,10")
    ;; pan w dół (palec w dół → zawartość przewija się w górę)
    let m1: touch::TouchOut = tmove(tdown(tstart(), 1, 100, 100, 31), 1, 100, 130)
    assert_eq(m1.scroll_dy, 0 - 30)
    assert_eq(m1.scroll_dx, 0)
    assert_eq(m1.mouse.len(), 0)
    let m2: touch::TouchOut = tmove(m1, 1, 100, 150)
    assert_eq(m2.scroll_dy, 0 - 20)
    ;; drobny ruch w granicach tolerancji nie jest gestem
    let jit: touch::TouchOut = tmove(tdown(tstart(), 1, 50, 50, 31), 1, 54, 53)
    assert_eq(jit.scroll_dy, 0)
    assert_eq(jit.mouse.len(), 0)
    ;; touch-action: none → palec jest „myszą” (przeciąganie), bez przewijania
    let n1: touch::TouchOut = tmove(tdown(tstart(), 1, 100, 100, 0), 1, 100, 130)
    assert_eq(n1.scroll_dy, 0)
    assert_eq(n1.mouse[0], "down:100,100")
    assert_eq(n1.mouse[1], "move:100,130")
    let n2: touch::TouchOut = tmove(n1, 1, 110, 140)
    assert_eq(n2.mouse[0], "move:110,140")
    let n3: touch::TouchOut = touch::touch_up(n2.state, 1, 110, 140)
    assert_eq(n3.mouse[0], "up:110,140")
    ;; pan-y: ruch poziomy jest zablokowany (mysz), pionowy przewija
    let py_h: touch::TouchOut = tmove(tdown(tstart(), 1, 100, 100, 12), 1, 140, 102)
    assert_eq(py_h.scroll_dx, 0)
    assert_eq(py_h.mouse[0], "down:100,100")
    let py_v: touch::TouchOut = tmove(tdown(tstart(), 1, 100, 100, 12), 1, 101, 140)
    assert_eq(py_v.scroll_dy, 0 - 40)
    assert_eq(py_v.scroll_dx, 0)
    ;; pan-x: ruch poziomy przewija w poziomie, bez przewijania w pionie
    let px: touch::TouchOut = tmove(tdown(tstart(), 1, 100, 100, 3), 1, 60, 103)
    assert_eq(px.scroll_dx, 40)
    assert_eq(px.scroll_dy, 0)
    ;; pan-down: tylko ruch palca w dół
    let pd_up: touch::TouchOut = tmove(tdown(tstart(), 1, 100, 100, 8), 1, 100, 60)
    assert_eq(pd_up.mouse[0], "down:100,100")
    let pd_dn: touch::TouchOut = tmove(tdown(tstart(), 1, 100, 100, 8), 1, 100, 140)
    assert_eq(pd_dn.scroll_dy, 0 - 40)
end

#[test]
fn t04_touch_pinch_zoom_respects_touch_action() is
    let two: touch::TouchOut = tdown(tdown(tstart(), 1, 100, 100, 31), 2, 200, 100, 31)
    assert_eq(two.state[5], 3)
    let z: touch::TouchOut = tmove(two, 2, 300, 100)
    assert_eq(z.zoom, 200)
    let zmax: touch::TouchOut = tmove(two, 2, 900, 100)
    assert_eq(zmax.zoom, 500)
    let zmin: touch::TouchOut = tmove(two, 2, 120, 100)
    assert_eq(zmin.zoom, 100 * 20 / 100 + 30)
    ;; po puszczeniu drugiego palca wracamy do przewijania
    let back: touch::TouchOut = touch::touch_up(z.state, 2, 300, 100)
    assert_eq(back.state[5], 1)
    assert_eq(back.state[12], 200)
    ;; bez pinch-zoom (pan-x pan-y) drugi palec jest ignorowany
    let no: touch::TouchOut = tdown(tdown(tstart(), 1, 100, 100, 15), 2, 200, 100, 15)
    assert_eq(no.state[5], 0)
    assert_eq(tmove(no, 2, 300, 100).zoom, 0 - 1)
end

