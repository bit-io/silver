    let sheet: css::Stylesheet = css::parse(
        ".x { /* to nie powinno się liczyć */ color: blue; }")
    assert_eq(array_len(sheet.rules[0].decls), 1)
    assert_eq(sheet.rules[0].decls[0].prop, "color")
end

#[test]
fn test_css_strips_multiple_comments() is
    let sheet: css::Stylesheet = css::parse(
        "/* a */ .x { color: red; } /* b */ .y { color: blue; }")
    assert_eq(array_len(sheet.rules), 2)
    assert_eq(sheet.rules[1].selector, ".y")
end

