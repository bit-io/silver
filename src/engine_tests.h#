fn t04_border_image_edge_repeat_round_space() is
    ;; źródło 90×90, przecięcia 30, grubość 15 → kafelek górnej krawędzi: 30 · 15/30 = 15 × 15
    let rep: [int] = gfx::border_image_pieces(0, 0, 200, 100, 90, 90, [30, 30, 30, 30], [15, 15, 15, 15], 1, 1)
    let t: [int] = piece_by_id(rep, 1)
