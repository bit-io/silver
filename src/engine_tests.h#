fn texts_flat(boxes: [layout::LayoutBox]) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is out = array_push(out, boxes[i].text) end
        i += 1
    end
    return out
end

