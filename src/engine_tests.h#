fn min_body_x_in_band(boxes: [layout::LayoutBox], y0: int, y1: int) -> int is
    let mut best: int = 1000000
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        if b.kind == "text" && b.st.font_size == 16 && b.y >= y0 && b.y < y1 && b.x < best is best = b.x end
        i += 1
    end
    return best
end

fn first_text_box(boxes: [layout::LayoutBox]) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

