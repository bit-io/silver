#[test]
fn t_mutation() is
    let mut d: dom::Dom = dom::parse("<div id=\"a\"><span>x</span></div>")
    d = dom::set_text(d, 1, "new")
    assert_eq(dom::text_content(d, 1), "new")
    d = dom::add_class(d, 1, "k")
    d = dom::add_class(d, 1, "m")
    d = dom::remove_class(d, 1, "k")
    assert_eq(d.nodes[1].attr_class, "m")
    d = dom::set_inner_html(d, 1, "<b>q</b><i>r</i>")
    assert_eq(array_len(d.nodes[1].children), 2)
    assert_eq(dom::text_content(d, 1), "qr")
    assert_eq(dom::inner_html(d, 1), "<b>q</b><i>r</i>")
    d = dom::set_attr(d, 1, "data-x", "5")
    assert_eq(dom::get_attr(d.nodes[1], "data-x"), "5")
    assert_eq(dom::dataset_json(d.nodes[1]), "{\"x\":\"5\"}")
    d = dom::remove_node(d, d.nodes[1].children[0])
    assert_eq(array_len(d.nodes[1].children), 1)
end

