    let boxes: [layout::LayoutBox] = layout::layout(dom, sheet, 400, -1)
    let mut found: layout::LayoutBox = boxes[0]
    let mut ok: bool = false
    let count: int = array_len(boxes)
    let mut i: int = 0
    while i < count is
        if boxes[i].h == 20 is
            found = boxes[i]
            ok = true
        end
        i += 1
    end
    assert_true(ok)
    assert_eq(found.x, 0)
end

;; ---------- layout::layout_i — rozbudowa: :hover przez pełny pipeline ----------

#[test]
fn test_layout_i_hover_changes_background() is
    let dom: dom::Dom = dom::parse("<div class=\"btn\">x</div>")
    let sheet: css::Stylesheet = css::parse(".btn:hover { background: red; }")
    let btn_id: int = 1  ;; nodes[0]=root, nodes[1]=div.btn

    let no_hover: [layout::LayoutBox] = layout::layout_i(dom, sheet, 400, -1, css::no_interaction())
    let mut bg_no_hover: bool = false
    let mut i: int = 0
    while i < array_len(no_hover) is
        if no_hover[i].node_id == btn_id && no_hover[i].st.has_bg is bg_no_hover = true end
        i += 1
    end
    assert_true(!bg_no_hover)

    let with_hover: [layout::LayoutBox] = layout::layout_i(
        dom, sheet, 400, -1, css::ix_legacy(btn_id, "", -1))
    let mut bg_hover: bool = false
    i = 0
    while i < array_len(with_hover) is
        if with_hover[i].node_id == btn_id && with_hover[i].st.has_bg is bg_hover = true end
        i += 1
    end
    assert_true(bg_hover)
end

