#[test]
fn t_cascade_order() is
    let d: dom::Dom = dom::parse("<div id=\"a\" class=\"x\" style=\"color: green\">t</div>")
    let sheet: css::Stylesheet = css::parse(".x { color: red; width: 5px } #a { width: 9px } .x { width: 7px }")
    let decls: [css::CssDecl] = css::matching_decls_ctx(sheet, d, 1, css::no_interaction())
    let last: css::CssDecl = decls[array_len(decls) - 1]
    assert_eq(last.val, "green")
    let mut w: string = ""
    let mut i: int = 0
    while i < array_len(decls) is
        if decls[i].prop == "width" is w = decls[i].val end
        i += 1
    end
    assert_eq(w, "9px")
end

