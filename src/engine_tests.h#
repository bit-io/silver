#[test]
fn t04_line_height_step_rounds_up() is
    let base: [layout::LayoutBox] = lay("<p>a</p><p>b</p>", "p { margin: 0; line-height: 17px; }", 400)
    let stp: [layout::LayoutBox] = lay("<p>a</p><p>b</p>", "p { margin: 0; line-height: 17px; line-height-step: 10px; }", 400)
    assert_eq(texts_flat_y(base)[1] - texts_flat_y(base)[0], 17)
    assert_eq(texts_flat_y(stp)[1] - texts_flat_y(stp)[0], 20)
    let st2: [layout::LayoutBox] = lay("<p>a</p><p>b</p>", "p { margin: 0; line-height: 20px; line-height-step: 10px; }", 400)
    assert_eq(texts_flat_y(st2)[1] - texts_flat_y(st2)[0], 20)
end

fn texts_flat_y(boxes: [layout::LayoutBox]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is out = array_push(out, boxes[i].y) end
        i += 1
    end
    return out
end

#[test]
fn t04_hyphenate_limit_chars_and_character() is
    ;; min. słowo 20 znaków → "programowanie" (13) nie dostaje punktów podziału
    assert_eq(layout::hyph_auto_lim("programowanie", 20, 3, 3), "programowanie")
    assert_true(string_find(layout::hyph_auto_lim("programowanie", 7, 3, 3), "\u00AD") > 0)
    ;; min. 6 znaków przed podziałem: pierwsza pozycja nie wcześniej niż po 6. znaku
    let h6: string = layout::hyph_auto_lim("programowanie", 7, 6, 3)
    assert_true(string_find(h6, "\u00AD") >= 6)
    let boxes: [layout::LayoutBox] = lay("<p>ab programowanie</p>", "p { margin: 0; hyphens: auto; hyphenate-character: \"~\"; }", 110)
    let t: [string] = texts_flat(boxes)
    assert_true(array_len(t) >= 2)
    assert_true(string_find(t[0], "~") >= 0)
    assert_eq(string_find(t[0], "-"), -1)
end

