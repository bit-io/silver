        i += 1
    end
    return out
end

fn count_in_col(boxes: [layout::LayoutBox], x_lo: int, x_hi: int) -> int is
    let mut c: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "box" && boxes[i].node_id >= 2 && boxes[i].x >= x_lo && boxes[i].x < x_hi is c += 1 end
        i += 1
    end
    return c
end

