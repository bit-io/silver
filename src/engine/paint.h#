;; 0.4: image-orientation → kod dla silver_image_xform: bity 0..1 obrót w ćwiartkach cw, bit 2 odbicie poziome, bit 3 ignoruj EXIF.
;; from-image (domyślnie) = EXIF; none = bez EXIF; `<kąt>` i/lub `flip` nadpisują EXIF (obrót, potem odbicie poziome).
pub fn image_xf_code(st: style::ComputedStyle) -> int is
    let v: string = string_lower(string_trim(props::xget(st.xp, "image-orientation")))
    if v == "" || v == "from-image" is return 0 end
    if v == "none" is return 8 end
    let toks: [string] = cssval::split_top(v)
    let mut quarters: int = 0
    let mut flip: int = 0
    let mut i: int = 0
    while i < array_len(toks) is
        if toks[i] == "flip" is
            flip = 1
        elsif toks[i] == "from-image" is
            return 0
        else is
            let deci: int = ((style::angle_deci(toks[i]) % 3600) + 3600) % 3600
            let q: int = (deci + 450) / 900
            quarters = (quarters + q) % 4
        end
        i += 1
    end
    return 8 + quarters + flip * 4
end

;; object-view-box: inset() | rect() | xywh() względem naturalnego rozmiaru obrazu (iw × ih) → [x, y, w, h] w promilach; [] gdy brak.
pub fn view_box_permille(v0: string, iw: int, ih: int, fs: int) -> [int] is
    let v: string = string_lower(string_trim(v0))
    if v == "" || v == "none" || iw <= 0 || ih <= 0 is return [] end
    let p: int = string_find(v, "(")
    if p < 0 is return [] end
    let name: string = string_trim(string_slice(v, 0, p))
    let inner: string = string_replace(string_slice(v, p + 1, if string_ends_with(v, ")") then string_len(v) - 1 else string_len(v)), ",", " ")
    let t: [string] = cssval::split_top(string_trim(inner))
    let n: int = array_len(t)
    if n == 0 is return [] end
    let mut x: int = 0
    let mut y: int = 0
    let mut w: int = iw
    let mut h: int = ih
    if name == "inset" is
        let top: int = shape::len_px(t[0], ih, fs)
        let right: int = if n >= 2 then shape::len_px(t[1], iw, fs) else top
        let bottom: int = if n >= 3 then shape::len_px(t[2], ih, fs) else top
        let left: int = if n >= 4 then shape::len_px(t[3], iw, fs) else right
        x = left
        y = top
        w = iw - left - right
        h = ih - top - bottom
    elsif name == "rect" && n >= 4 is
        let top: int = shape::len_px(t[0], ih, fs)
        let right: int = shape::len_px(t[1], iw, fs)
        let bottom: int = shape::len_px(t[2], ih, fs)
        let left: int = shape::len_px(t[3], iw, fs)
        x = left
        y = top
        w = right - left
        h = bottom - top
    elsif name == "xywh" && n >= 4 is
        x = shape::len_px(t[0], iw, fs)
        y = shape::len_px(t[1], ih, fs)
        w = shape::len_px(t[2], iw, fs)
        h = shape::len_px(t[3], ih, fs)
    else is
        return []
    end
    if w <= 0 || h <= 0 is return [] end
    return [x * 1000 / iw, y * 1000 / ih, w * 1000 / iw, h * 1000 / ih]
end

fn obj_pos_token(t: string, free: int) -> int is
    if t == "left" || t == "top" is return 0 end
    if t == "right" || t == "bottom" is return free end
    if t == "center" is return free / 2 end
    if string_ends_with(t, "%") is return free * str_to_int(string_slice(t, 0, string_len(t) - 1)) / 100 end
    if string_ends_with(t, "px") is return str_to_int(string_slice(t, 0, string_len(t) - 2)) end
    return free / 2
end

fn draw_fitted_pos(win: int, path: string, x: int, y: int, w: int, h: int, mode: string, alpha: int, rx: int, ry: int, rw: int, rh: int, pos: string) -> int is
    let iw: int = ffi_shim::silver_image_width(win, path)
    let ih: int = ffi_shim::silver_image_height(win, path)
    if iw <= 0 || ih <= 0 is return 0 end
    if mode == "fill" || mode == "100% 100%" is
        ffi_shim::silver_draw_image(win, path, x, y, w, h, alpha)
        return 0
    end
    let mut dw: int = w
    let mut dh: int = h
    if mode == "contain" || mode == "scale-down" is
        if iw * h > ih * w is
            dw = w
            dh = w * ih / iw
        else is
            dh = h
            dw = h * iw / ih
        end
    elsif mode == "cover" is
        if iw * h > ih * w is
            dh = h
            dw = h * iw / ih
        else is
            dw = w
            dh = w * ih / iw
        end
    elsif mode == "none" || mode == "auto" is
        dw = iw
        dh = ih
    end
    let pt: [string] = cssval::split_top(string_lower(pos))
    let mut ptx: string = if array_len(pt) >= 1 then pt[0] else "50%"
    let mut pty: string = if array_len(pt) >= 2 then pt[1] else "50%"
    if array_len(pt) == 1 && (pt[0] == "top" || pt[0] == "bottom") is
        pty = pt[0]
        ptx = "50%"
    end
    if (ptx == "top" || ptx == "bottom") && array_len(pt) >= 2 is
        let sw: string = ptx
        ptx = pty
        pty = sw
    end
    let dx: int = x + obj_pos_token(ptx, w - dw)
    let dy: int = y + obj_pos_token(pty, h - dh)
    ffi_shim::silver_clip_set(win, rx, ry, rw, rh)
    ffi_shim::silver_draw_image(win, path, dx, dy, dw, dh, alpha)
    return 0
end

