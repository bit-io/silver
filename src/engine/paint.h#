;; 0.4: caret-shape / skrót `caret: <kolor> || <kształt>` → bar | block | underscore
pub fn caret_shape_of(st: style::ComputedStyle) -> string is
    let v: string = string_lower(string_trim(props::xget(st.xp, "caret-shape")))
    if v == "block" || v == "underscore" || v == "bar" is return v end
    let toks: [string] = cssval::split_top(string_lower(props::xget(st.xp, "caret")))
    let mut i: int = 0
    while i < array_len(toks) is
        if toks[i] == "block" || toks[i] == "underscore" || toks[i] == "bar" is return toks[i] end
        i += 1
    end
    return "bar"
end

;; Prostokąt kursora [x, y, w, h] dla kształtu; `cw` = szerokość znaku pod kursorem.
pub fn caret_rect(shape: string, x: int, y: int, lh: int, cw: int) -> [int] is
    let w: int = if cw < 2 then 2 else cw
    if shape == "block" is return [x, y, w, lh] end
    if shape == "underscore" is return [x, y + lh - 2, w, 2] end
    return [x, y, 1, lh]
end

fn draw_caret(win: int, st: style::ComputedStyle, col: style::Color, x: int, y: int, lh: int, cw: int) -> int is
    let shape: string = caret_shape_of(st)
    let r: [int] = caret_rect(shape, x, y, lh, cw)
    fill(win, r[0], r[1], r[2], r[3], col, if shape == "block" then 55 else 100)
    return 0
end

fn text_width(win: int, s: string, st: style::ComputedStyle) -> int is
