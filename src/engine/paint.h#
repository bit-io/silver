fn bi_or(st: style::ComputedStyle, key: string, d: string) -> string is
    let v: string = props::xget(st.xp, key)
    if v == "" is return d end
    return v
end

fn draw_border_image(win: int, x: int, y: int, w: int, h: int, st: style::ComputedStyle) -> int is
