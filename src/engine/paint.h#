;; Stan potrzebny tylko do rysowania (budowany przez app.h# co klatkę).
pub struct RenderState is
    pub scroll_y:   int
    pub focused:    int     ;; id węzła z fokusem (-1 = brak)
    pub cursor:     int     ;; pozycja kursora (bajty) w polu z fokusem
    pub anchor:     int     ;; początek zaznaczenia (bajty); == cursor gdy brak
    pub caret_on:   bool    ;; faza migania kursora
    pub ime:        string  ;; tekst kompozycji IME
    pub hovered:    int
    pub viewport_h: int
    pub sel:        [int]   ;; 0.4: prostokąty zaznaczenia tekstu dokumentu [x,y,w,h,…] (współrzędne dokumentu)
end

pub fn plain_state(scroll_y: int) -> RenderState is
    return RenderState { scroll_y: scroll_y, focused: -1, cursor: 0, anchor: 0, caret_on: false, ime: "", hovered: -1, viewport_h: 100000, sel: [] }
end

pub fn scaled_alpha(a: int, opacity: int) -> int is
    return a * opacity / 100
end

fn flags_of(st: style::ComputedStyle) -> int is
    ;; 0.4: jedna definicja flag dla pomiaru (layout) i rysowania — wcześniej rysowanie pomijało kerning/syntezę
    return layout::style_flags(st)
end

fn fill(win: int, x: int, y: int, w: int, h: int, c: style::Color, opacity: int) -> int is
    if w <= 0 || h <= 0 || c.a <= 0 is return 0 end
    ffi_shim::silver_fill_rect(win, x, y, w, h, c.r, c.g, c.b, scaled_alpha(c.a, opacity))
    return 0
end

fn max_radius(st: style::ComputedStyle) -> int is
    let mut r: int = st.rad_tl
    if st.rad_tr > r is r = st.rad_tr end
    if st.rad_br > r is r = st.rad_br end
    if st.rad_bl > r is r = st.rad_bl end
    return r
end

;; ---------- 0.4: corner-shape ----------
;; kody: 1 round, 2 squircle, 3 bevel, 4 square, -1 scoop, -2 notch
fn shape_code(tok0: string) -> int is
    let tok: string = string_lower(string_trim(tok0))
    if tok == "squircle" is return 2 end
    if tok == "bevel" is return 3 end
    if tok == "square" is return 4 end
    if tok == "scoop" is return -1 end
    if tok == "notch" is return -2 end
    return 1
end

fn corner_tok(st: style::ComputedStyle, phys: string, logical: string, idx: int) -> string is
    let mut v: string = props::xget(st.xp, "corner-" + phys + "-shape")
    if v == "" is v = props::xget(st.xp, "corner-" + logical + "-shape") end
    if v != "" is return v end
    let sh: [string] = cssval::split_top(props::xget(st.xp, "corner-shape"))
    let n: int = array_len(sh)
    if n == 0 is return "" end
    ;; kolejność jak border-radius: tl tr br bl (1 wartość = wszystkie, 2 = tl/br, tr/bl, 3 = tl, tr/bl, br)
    if n == 1 is return sh[0] end
    if n == 2 is return sh[idx % 2] end
    if n == 3 is
        if idx == 0 is return sh[0] end
        if idx == 1 || idx == 3 is return sh[1] end
        return sh[2]
    end
    return sh[idx]
end

;; "" gdy wszystkie narożniki okrągłe (domyślnie) albo brak promienia; inaczej spec dla silver_fill_shape_rect
fn shape_spec(st: style::ComputedStyle, bw: int) -> string is
    if max_radius(st) <= 0 is return "" end
    let c0: int = shape_code(corner_tok(st, "top-left", "start-start", 0))
    let c1: int = shape_code(corner_tok(st, "top-right", "start-end", 1))
    let c2: int = shape_code(corner_tok(st, "bottom-right", "end-end", 2))
    let c3: int = shape_code(corner_tok(st, "bottom-left", "end-start", 3))
    if c0 == 1 && c1 == 1 && c2 == 1 && c3 == 1 is return "" end
    return to_string(st.rad_tl) + "," + to_string(st.rad_tr) + "," + to_string(st.rad_br) + "," + to_string(st.rad_bl) + "," +
           to_string(c0) + "," + to_string(c1) + "," + to_string(c2) + "," + to_string(c3) + "," + to_string(bw)
end

fn round_fill(win: int, x: int, y: int, w: int, h: int, rad: int, c: style::Color, opacity: int) -> int is
    if w <= 0 || h <= 0 || c.a <= 0 is return 0 end
    let a: int = scaled_alpha(c.a, opacity)
    if rad <= 0 is
        ffi_shim::silver_fill_rect(win, x, y, w, h, c.r, c.g, c.b, a)
    else is
        ffi_shim::silver_fill_round_rect(win, x, y, w, h, rad, c.r, c.g, c.b, a)
    end
    return 0
end

fn same_color(a: style::Color, b: style::Color) -> bool is
    return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a
end

;; ---------- cień ----------
fn draw_shadow(win: int, x: int, y: int, w: int, h: int, st: style::ComputedStyle) -> int is
    let blur: int = if st.sh_blur > 12 then 12 else st.sh_blur
    let layers: int = if blur < 1 then 1 else blur
    let rad: int = max_radius(st)
    let per: int = st.sh_color.a / (layers + 1)
    let mut i: int = 1
    while i <= layers is
        let grow: int = st.sh_spread + (layers - i + 1) * (if st.sh_blur > 0 then st.sh_blur else 0) / layers
        let c: style::Color = style::Color { r: st.sh_color.r, g: st.sh_color.g, b: st.sh_color.b, a: per + (if i == layers then per else 0) }
        round_fill(win, x + st.sh_x - grow, y + st.sh_y - grow, w + grow * 2, h + grow * 2, rad + grow, c, st.opacity)
        i += 1
    end
    return 0
end


;; ---------- 0.3: linie (ramki dashed/dotted/double, podkreślenia), tekst z odstępami ----------
;; Rysuje odcinek poziomy/pionowy o grubości `t` w stylu: solid | dashed | dotted | double | wavy.
fn draw_line_styled(win: int, x: int, y: int, len: int, t: int, vertical: bool, kind: string, c: style::Color, opacity: int) -> int is
    if len <= 0 || t <= 0 || c.a <= 0 is return 0 end
    if kind == "dashed" || kind == "dotted" is
        let on: int = if kind == "dotted" then t else t * 3
        let off: int = if kind == "dotted" then t else t * 2
        let mut pos: int = 0
        while pos < len is
            let seg: int = if pos + on > len then len - pos else on
            if vertical is
                fill(win, x, y + pos, t, seg, c, opacity)
            else is
                fill(win, x + pos, y, seg, t, c, opacity)
            end
            pos = pos + on + off
        end
        return 0
    end
    if kind == "double" && t >= 3 is
        let line: int = t / 3
        if vertical is
            fill(win, x, y, line, len, c, opacity)
            fill(win, x + t - line, y, line, len, c, opacity)
        else is
            fill(win, x, y, len, line, c, opacity)
            fill(win, x, y + t - line, len, line, c, opacity)
        end
        return 0
    end
    if kind == "wavy" && !vertical is
        let step: int = if t * 2 < 2 then 2 else t * 2
        let mut pos: int = 0
        let mut up: bool = true
        while pos < len is
            let seg: int = if pos + step > len then len - pos else step
            fill(win, x + pos, if up then y else y + t, seg, t, c, opacity)
            up = !up
            pos += step
        end
        return 0
    end
    if vertical is
        fill(win, x, y, t, len, c, opacity)
    else is
        fill(win, x, y, len, t, c, opacity)
    end
    return 0
end

fn side_is_plain(kind: string) -> bool is
    return kind == "solid" || kind == "" || kind == "groove" || kind == "ridge" || kind == "inset" || kind == "outset"
end

;; Tekst znak po znaku: letter-spacing / word-spacing.
fn draw_text_spaced(win: int, x: int, y: int, text: string, st: style::ComputedStyle, c: style::Color, flags: int) -> int is
    let n: int = string_len(text)
    let mut pos: int = 0
    let mut cx: int = x
    while pos < n is
        let nx: int = ffi_shim::silver_utf8_next(text, pos)
        let step: int = if nx <= pos then pos + 1 else nx
        let ch: string = string_slice(text, pos, if step > n then n else step)
        pos = step
        if ch != " " is
            ffi_shim::silver_draw_text_ex(win, cx, y, layout::shape_prefix(st) + ch, c.r, c.g, c.b, scaled_alpha(c.a, st.opacity), st.font_size, flags)
        end
        cx = cx + ffi_shim::silver_measure_text_ex(win, layout::shape_prefix(st) + ch, st.font_size, flags) + st.letter_spacing
        if ch == " " is cx = cx + st.word_spacing end
    end
    return 0
end

fn draw_text_raw(win: int, x: int, y: int, text: string, st: style::ComputedStyle, c: style::Color, flags: int) -> int is
    if st.letter_spacing != 0 || st.word_spacing != 0 is
        return draw_text_spaced(win, x, y, text, st, c, flags)
    end
    return ffi_shim::silver_draw_text_ex(win, x, y, layout::shape_prefix(st) + text, c.r, c.g, c.b, scaled_alpha(c.a, st.opacity), st.font_size, flags)
end

;; 0.4: CSS Fill & Stroke dla tekstu HTML — fill-image (+ -position/-size/-repeat/-origin), stroke (kolor), stroke-width, stroke-align,
;; stroke-image (+ …). Kolejność: fill-color, fill-image, stroke. Pominięte przy letter-spacing/word-spacing (rysowanie znak po znaku).
fn stroke_solid_color(st: style::ComputedStyle) -> [int] is
    let v: string = string_lower(string_trim(props::xget(st.xp, "stroke")))
    if v == "" || v == "none" || string_starts_with(v, "url(") || string_starts_with(v, "context-") is return [] end
    let c: style::Color = if v == "currentcolor" then st.color else style::parse_color(v)
    if c.a <= 0 is return [] end
    return [c.r, c.g, c.b, c.a]
end

fn text_stroke_width(st: style::ComputedStyle) -> int is
    let v: string = string_trim(props::xget(st.xp, "stroke-width"))
    if v == "" is return 1 end
    return gfx::len_px(v, 0, st.font_size)
end

fn text_has_fill_stroke(st: style::ComputedStyle) -> bool is
    if gfx::list_len(props::xget(st.xp, "fill-image")) > 0 is return true end
    if gfx::list_len(props::xget(st.xp, "stroke-image")) > 0 && text_stroke_width(st) > 0 is return true end
    return array_len(stroke_solid_color(st)) == 4 && text_stroke_width(st) > 0
end

;; 0.4: fill-break / stroke-break — prostokąt odniesienia obrazów: bounding-box (domyślnie: suma fragmentów tekstu w wierszach),
;; slice (fragmenty jako kolejne plasterki jednego pudełka), clone (każdy fragment osobno). Adnotacje "dx,dy,W,H" ustawia annotate_text_fragments.
fn frag_geom(st: style::ComputedStyle, key: string, x: int, y: int, tw: int, th: int) -> [int] is
    let v: string = props::xget(st.xp, key)
    if v == "" is return [x, y, tw, th] end
    let p: [string] = string_split(v, ",")
    if array_len(p) < 4 is return [x, y, tw, th] end
    return [x + str_to_int(p[0]), y + str_to_int(p[1]), str_to_int(p[2]), str_to_int(p[3])]
end

fn draw_text_fill_stroke(win: int, x: int, y: int, text: string, st: style::ComputedStyle, flags: int, th: int) -> int is
    let tw: int = ffi_shim::silver_measure_text_ex(win, layout::shape_prefix(st) + text, st.font_size, flags)
    if tw <= 0 || th <= 0 is return 0 end
    let fg: [int] = frag_geom(st, "\u0001fr", x, y, tw, th)
    let whole: [int] = fg
    let mut white: style::Color = st.color
    white.r = 255
    white.g = 255
    white.b = 255
    white.a = 255
    let nfi: int = gfx::list_len(props::xget(st.xp, "fill-image"))
    if nfi > 0 is
        ffi_shim::silver_layer_begin(win, x, y, tw, th)
        let mut i: int = nfi - 1
        while i >= 0 is
            draw_img_layer(win, st, "fill", i, fg[0], fg[1], fg[2], fg[3], 0, 0, 0, 0, 0, 0, whole)
            i -= 1
        end
        ffi_shim::silver_layer_begin(win, x, y, tw, th)
        draw_text_raw(win, x, y, text, st, white, flags)
        ffi_shim::silver_layer_capture_mask(win, 0, 0)
        ffi_shim::silver_layer_end_fx(win, 1000, 0, 0, 1000, 0, 0, 0, 0, 255, "mask")
    end
    let sw: int = text_stroke_width(st)
    if sw > 0 is
        let al: string = string_lower(string_trim(props::xget(st.xp, "stroke-align")))
        let align: int = if al == "inside" then 1 elsif al == "outside" then 2 else 0
        let pad: int = sw + 2
        let nsi: int = gfx::list_len(props::xget(st.xp, "stroke-image"))
        if nsi > 0 is
            let sx: int = x - pad
            let sy: int = y - pad
            let sww: int = tw + 2 * pad
            let shh: int = th + 2 * pad
            let sg: [int] = frag_geom(st, "\u0001sr", x, y, tw, th)
            let swhole: [int] = sg
            ffi_shim::silver_layer_begin(win, sx, sy, sww, shh)
            let mut k: int = nsi - 1
            while k >= 0 is
                draw_img_layer(win, st, "stroke", k, sg[0], sg[1], sg[2], sg[3], 0, 0, 0, 0, 0, 0, swhole)
                k -= 1
            end
            ffi_shim::silver_layer_begin(win, sx, sy, sww, shh)
            ffi_shim::silver_draw_text_stroke(win, x, y, layout::shape_prefix(st) + text, 255, 255, 255, 255, st.font_size, flags, sw, align)
            ffi_shim::silver_layer_capture_mask(win, 0, 0)
            ffi_shim::silver_layer_end_fx(win, 1000, 0, 0, 1000, 0, 0, 0, 0, 255, "mask")
        else is
            let sc: [int] = stroke_solid_color(st)
            if array_len(sc) == 4 is
                ffi_shim::silver_draw_text_stroke(win, x, y, layout::shape_prefix(st) + text, sc[0], sc[1], sc[2], scaled_alpha(sc[3], st.opacity), st.font_size, flags, sw, align)
            end
        end
    end
    return 0
end

fn draw_text_plain(win: int, x: int, y: int, text: string, st: style::ComputedStyle, c: style::Color, flags: int) -> int is
    let th: int = draw_text_raw(win, x, y, text, st, c, flags)
    if st.letter_spacing == 0 && st.word_spacing == 0 && text != "" && text_has_fill_stroke(st) is
        draw_text_fill_stroke(win, x, y, text, st, flags, th)
    end
    return th
end

;; Kolor z magazynu xp (caret-color, accent-color…) albo `dflt` dla auto/currentcolor/niepoprawnego.
fn xcolor(st: style::ComputedStyle, key: string, dflt: style::Color) -> style::Color is
    let toks: [string] = cssval::split_top(string_lower(props::xget(st.xp, key)))
    let v: string = if array_len(toks) >= 1 then toks[0] else ""
    if v == "" || v == "auto" || v == "currentcolor" is return dflt end
    if !cssval::is_color(v) is return dflt end
    return style::parse_color(v)
end

;; Długość z xp (px; em względem rozmiaru czcionki) albo `dflt`.
fn xpx(st: style::ComputedStyle, key: string, dflt: int) -> int is
    let v: string = props::xget(st.xp, key)
    if v == "" || v == "auto" || v == "from-font" is return dflt end
    let l: cssval::Len = cssval::parse_len(v, cssval::LenEnv { em: st.font_size, rem: 16, vw: 0, vh: 0 })
    if !l.ok || l.auto is return dflt end
    return cssval::px_of(l, st.font_size)
end

;; Promień rozmycia z `backdrop-filter: blur(Npx)` (0 = brak).
pub fn backdrop_blur_px(st: style::ComputedStyle) -> int is
    let v: string = string_lower(props::xget(st.xp, "backdrop-filter"))
    let at: int = string_find(v, "blur(")
    if at < 0 is return 0 end
    let close: int = string_find(string_slice(v, at, string_len(v)), ")")
    if close < 0 is return 0 end
    let arg: string = string_trim(string_slice(v, at + 5, at + close))
    let l: cssval::Len = cssval::parse_len(arg, cssval::LenEnv { em: st.font_size, rem: 16, vw: 0, vh: 0 })
    if !l.ok || l.auto is return 0 end
    return cssval::px_of(l, 0)
end

;; 0.4: text-emphasis — znaczniki nad/pod znakami tekstu
fn draw_emphasis(win: int, b: layout::LayoutBox, by: int) -> int is
    let g: string = layout::emphasis_glyph(b.st)
    if g == "" is return 0 end
    let marks: [int] = layout::emphasis_marks(b, win)
    if array_len(marks) == 0 is return 0 end
    let msize: int = if b.st.font_size / 2 < 4 then 4 else b.st.font_size / 2
    let col: style::Color = xcolor(b.st, "text-emphasis-color", b.st.color)
    let a: int = scaled_alpha(col.a, b.st.opacity)
    let gw: int = ffi_shim::silver_measure_text_ex(win, g, msize, 0)
    let dy: int = by - b.y
    let mut k: int = 0
    while k + 1 < array_len(marks) is
        ffi_shim::silver_draw_text_ex(win, marks[k] - gw / 2, marks[k + 1] + dy, g, col.r, col.g, col.b, a, msize, 0)
        k += 2
    end
    return 0
end

;; 0.4: text-decoration-skip-ink — przerwy w podkreśleniu przy literach z elementami podpisowymi.
;; Domyślne (natywne) podkreślenie pozostaje ciągłe; przerwy robi ścieżka własna, gdy skip-ink jest ustawione jawnie
;; na auto/all (none wyłącza). Glify nie są rasteryzowane osobno — rozpoznajemy litery z długimi dolnymi elementami.
pub fn has_descender(c: string) -> bool is
    return c == "g" || c == "j" || c == "p" || c == "q" || c == "y" || c == "," || c == ";" || c == "Q" || c == "\u00e7" || c == "\u0119" || c == "\u0105" || c == "\u0119"
end

;; `chars` — znaki, `xs` — pozycje x początków znaków (n+1 wartości). Zwraca pary [od, do) przerw.
pub fn ink_gaps(chars: [string], xs: [int], pad: int) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < array_len(chars) is
        if has_descender(chars[i]) is
            let a: int = xs[i] - pad
            let b: int = xs[i + 1] + pad
            let n: int = array_len(out)
            if n >= 2 && a <= out[n - 1] is
                out[n - 1] = b
            else is
                out = array_push(out, a)
                out = array_push(out, b)
            end
        end
        i += 1
    end
    return out
end

;; Odcinki ciągłe [x, szerokość, …] dla linii długości `len` z pominięciem przerw.
pub fn solid_segments(len: int, gaps: [int]) -> [int] is
    let mut out: [int] = []
    let mut cur: int = 0
    let mut i: int = 0
    while i + 1 < array_len(gaps) is
        let a: int = if gaps[i] < 0 then 0 else gaps[i]
        let b: int = if gaps[i + 1] > len then len else gaps[i + 1]
        if a > cur is
            out = array_push(out, cur)
            out = array_push(out, a - cur)
        end
        if b > cur is cur = b end
        i += 2
    end
    if cur < len is
        out = array_push(out, cur)
        out = array_push(out, len - cur)
    end
    return out
end

;; 0.4: text-decoration-trim: auto | <długość>{1,2} — [przycięcie z początku, z końca] linii dekoracji w px
fn deco_trim(st: style::ComputedStyle) -> [int] is
    let v: string = string_lower(string_trim(props::xget(st.xp, "text-decoration-trim")))
    if v == "" || v == "auto" is return [0, 0] end
    let t: [string] = cssval::split_top(v)
    let a: int = gfx::len_px(t[0], 0, st.font_size)
    let b: int = if array_len(t) >= 2 then gfx::len_px(t[1], 0, st.font_size) else a
    return [if a < 0 then 0 else a, if b < 0 then 0 else b]
end

pub fn skip_ink_on(st: style::ComputedStyle) -> bool is
    let v: string = string_lower(props::xget(st.xp, "text-decoration-skip-ink"))
    return v == "auto" || v == "all"
end

fn underline_gaps_for(win: int, b: layout::LayoutBox, st: style::ComputedStyle, t: int) -> [int] is
    let mut chars: [string] = []
    let mut xs: [int] = [0]
    let n: int = string_len(b.text)
    let mut pos: int = 0
    while pos < n && array_len(chars) < 240 is
        let nx: int = ffi_shim::silver_utf8_next(b.text, pos)
        let step: int = if nx <= pos then pos + 1 else nx
        let e: int = if step > n then n else step
        chars = array_push(chars, string_slice(b.text, pos, e))
        xs = array_push(xs, text_width(win, string_slice(b.text, 0, e), st))
        pos = step
    end
    return ink_gaps(chars, xs, if t > st.font_size / 10 then t else st.font_size / 10)
end

fn draw_text_full(win: int, b: layout::LayoutBox, by: int) -> int is
    let st: style::ComputedStyle = b.st
    let c: style::Color = st.color
    let ul_custom: bool = st.underline && (props::xhas(st.xp, "text-underline-offset") || props::xget(st.xp, "text-underline-position") == "under")
    let custom_deco: bool = (st.underline || st.strike) && (skip_ink_on(st) || st.has_deco_color || st.deco_style != "solid" || st.deco_thick > 0 || ul_custom || deco_trim(st)[0] > 0 || deco_trim(st)[1] > 0)
    let mut flags: int = flags_of(st)
    if custom_deco is flags = flags - (if st.underline then 4 else 0) - (if st.strike then 8 else 0) end
    if st.has_tshadow is
        let sc: style::Color = st.ts_color
        if st.ts_blur > 0 is
            let faint: style::Color = style::Color { r: sc.r, g: sc.g, b: sc.b, a: sc.a / 4 }
            draw_text_plain(win, b.x + st.ts_x - 1, by + st.ts_y, b.text, st, faint, flags)
            draw_text_plain(win, b.x + st.ts_x + 1, by + st.ts_y, b.text, st, faint, flags)
            draw_text_plain(win, b.x + st.ts_x, by + st.ts_y - 1, b.text, st, faint, flags)
            draw_text_plain(win, b.x + st.ts_x, by + st.ts_y + 1, b.text, st, faint, flags)
        end
        draw_text_plain(win, b.x + st.ts_x, by + st.ts_y, b.text, st, sc, flags)
    end
    draw_text_plain(win, b.x, by, b.text, st, c, flags)
    if custom_deco is
        let dc: style::Color = if st.has_deco_color then st.deco_color else c
        let t: int = if st.deco_thick > 0 then st.deco_thick else (if st.font_size / 14 < 1 then 1 else st.font_size / 14)
        if st.underline is
            let under: bool = props::xget(st.xp, "text-underline-position") == "under"
            let base_y: int = if under then by + b.h - t - 1 else by + (b.h + st.font_size) / 2 + 1
            let uy: int = base_y + xpx(st, "text-underline-offset", 0)
            let trim: [int] = deco_trim(st)
            let lo: int = trim[0]
            let hi: int = b.w - trim[1]
            let segs: [int] = if skip_ink_on(st) then solid_segments(b.w, underline_gaps_for(win, b, st, t)) else [0, b.w]
            let mut si: int = 0
            while si + 1 < array_len(segs) is
                let s0: int = if segs[si] > lo then segs[si] else lo
                let e0: int = if segs[si] + segs[si + 1] < hi then segs[si] + segs[si + 1] else hi
                if e0 > s0 is draw_line_styled(win, b.x + s0, uy, e0 - s0, t, false, st.deco_style, dc, st.opacity) end
                si += 2
            end
        end
        if st.strike is
            let tr2: [int] = deco_trim(st)
            if b.w - tr2[0] - tr2[1] > 0 is
                draw_line_styled(win, b.x + tr2[0], by + b.h / 2, b.w - tr2[0] - tr2[1], t, false, st.deco_style, dc, st.opacity)
            end
        end
    end
    return 0
end

;; Obraz tła w naturalnym rozmiarze z background-position / background-repeat.
fn pos_token(t: string, free: int) -> int is
    if t == "left" || t == "top" is return 0 end
    if t == "right" || t == "bottom" is return free end
    if t == "center" is return free / 2 end
    if string_ends_with(t, "%") is
        let pct: int = str_to_int(string_slice(t, 0, string_len(t) - 1))
        return free * pct / 100
    end
    if string_ends_with(t, "px") is return str_to_int(string_slice(t, 0, string_len(t) - 2)) end
    return 0
end

fn draw_bg_natural(win: int, path: string, x: int, y: int, w: int, h: int, pos: string, repeat: string, alpha: int) -> int is
    let iw: int = ffi_shim::silver_image_width(win, path)
    let ih: int = ffi_shim::silver_image_height(win, path)
    if iw <= 0 || ih <= 0 is return 0 end
    let toks: [string] = cssval::split_top(pos)
    let mut px_t: string = "0%"
    let mut py_t: string = "0%"
    if array_len(toks) >= 1 is px_t = toks[0] end
    if array_len(toks) >= 2 is py_t = toks[1] end
    if array_len(toks) == 1 && (toks[0] == "top" || toks[0] == "bottom") is
        py_t = toks[0]
        px_t = "center"
    end
    if (px_t == "top" || px_t == "bottom") && array_len(toks) >= 2 is
        let swap: string = px_t
        px_t = py_t
        py_t = swap
    end
    let ox: int = x + pos_token(px_t, w - iw)
    let oy: int = y + pos_token(py_t, h - ih)
    ffi_shim::silver_clip_set(win, x, y, w, h)
    let rep_x: bool = repeat == "repeat" || repeat == "repeat-x" || repeat == "space" || repeat == "round"
    let rep_y: bool = repeat == "repeat" || repeat == "repeat-y" || repeat == "space" || repeat == "round"
    let mut sx: int = ox
    if rep_x is
        while sx > x is sx -= iw end
    end
    let mut sy: int = oy
    if rep_y is
        while sy > y is sy -= ih end
    end
    let mut count: int = 0
    let mut ty: int = sy
    while ty < y + h && count < 600 is
        let mut tx: int = sx
        while tx < x + w && count < 600 is
            ffi_shim::silver_draw_image(win, path, tx, ty, iw, ih, alpha)
            count += 1
            if !rep_x is break end
            tx += iw
        end
        if !rep_y is break end
        ty += ih
    end
    return 0
end

