end

;; Tekst do pokazania w polu (hasło → kropki). Pozycje kursora przeliczane jest przez prefiks.
fn shown_prefix(value: string, pos: int, password: bool) -> string is
    let p: string = string_slice(value, 0, if pos > string_len(value) then string_len(value) else pos)
    if password is return mask_of(p) end
    return p
end

pub struct TaLines is
    pub lines:  [string]
    pub starts: [int]
end

;; Dzieli wartość textarea na wiersze (twarde \n + zawijanie do `inner_w`).
pub fn ta_lines(win: int, value: string, st: style::ComputedStyle, inner_w: int) -> TaLines is
    let mut lines: [string] = []
    let mut starts: [int] = []
    let hard: [string] = string_split(value, "\n")
    let mut base: int = 0
    let mut hi: int = 0
    while hi < array_len(hard) is
        let mut rest: string = hard[hi]
        let mut off: int = 0
        if rest == "" is
            lines = array_push(lines, "")
            starts = array_push(starts, base)
        end
        let mut guard: int = 0
        while rest != "" && guard < 2000 is
            guard += 1
            let mut cut: int = ffi_shim::silver_text_fit(win, rest, st.font_size, flags_of(st), inner_w)
            if cut >= string_len(rest) is
                cut = string_len(rest)
            else is
                ;; preferuj łamanie na spacji
                let head: string = string_slice(rest, 0, cut)
                let mut sp: int = -1
                let mut k: int = string_len(head) - 1
                while k > 0 is
                    if string_slice(head, k, k + 1) == " " is
                        sp = k
                        break
                    end
                    k -= 1
                end
                if sp > 0 is cut = sp + 1 end
                if cut <= 0 is cut = ffi_shim::silver_utf8_next(rest, 0) end
            end
            lines = array_push(lines, string_slice(rest, 0, cut))
            starts = array_push(starts, base + off)
            off = off + cut
            rest = string_slice(rest, cut, string_len(rest))
        end
        base = base + string_len(hard[hi]) + 1
        hi += 1
    end
    if array_len(lines) == 0 is
        lines = array_push(lines, "")
        starts = array_push(starts, 0)
    end
    return TaLines { lines: lines, starts: starts }
end

;; indeks wiersza zawierającego pozycję `pos`
pub fn ta_line_of(t: TaLines, pos: int) -> int is
    let mut best: int = 0
    let mut i: int = 0
    while i < array_len(t.starts) is
        if t.starts[i] <= pos is best = i end
        i += 1
    end
    return best
end

fn draw_input(win: int, d: dom::Dom, b: layout::LayoutBox, by: int, rs: RenderState) -> int is
    let n: dom::DomNode = d.nodes[b.node_id]
    let st: style::ComputedStyle = b.st
    let focused: bool = rs.focused == b.node_id
    let ix: int = b.x + st.bl + st.pad_left
    let iy: int = by + st.bt + st.pad_top
    let iw: int = b.w - st.bl - st.br - st.pad_left - st.pad_right
    let ih: int = b.h - st.bt - st.bb - st.pad_top - st.pad_bottom
    let lh: int = layout::normal_line_height(st.font_size)
    let fl: int = flags_of(st)
    let kind: string = string_lower(n.attr_type)
    let password: bool = kind == "password"
    let value: string = n.attr_value
    ffi_shim::silver_clip_set(win, ix, by + st.bt, iw, b.h - st.bt - st.bb)
    let tc: style::Color = st.color
    if n.tag == "textarea" is
        let t: TaLines = ta_lines(win, value, st, iw)
        let mut li: int = 0
        if focused && rs.anchor != rs.cursor is
            let lo: int = if rs.anchor < rs.cursor then rs.anchor else rs.cursor
            let hi: int = if rs.anchor < rs.cursor then rs.cursor else rs.anchor
            li = 0
            while li < array_len(t.lines) is
                let ls: int = t.starts[li]
                let le: int = ls + string_len(t.lines[li])
                let a0: int = if lo > ls then lo else ls
                let a1: int = if hi < le then hi else le
                if a1 > a0 is
                    let x0: int = text_width(win, string_slice(value, ls, a0), st)
                    let x1: int = text_width(win, string_slice(value, ls, a1), st)
                    fill(win, ix + x0, iy + li * lh, x1 - x0, lh, style::Color { r: 51, g: 144, b: 255, a: 110 }, 100)
                end
                li += 1
            end
        end
        if value == "" && n.attr_placeholder != "" && !focused is
            ffi_shim::silver_draw_text_ex(win, ix, iy, n.attr_placeholder, tc.r, tc.g, tc.b, 110, st.font_size, fl)
        end
        li = 0
        while li < array_len(t.lines) is
            let line: string = t.lines[li]
            let trimmed: string = if string_ends_with(line, " ") then string_slice(line, 0, string_len(line) - 1) else line
            if trimmed != "" is
                ffi_shim::silver_draw_text_ex(win, ix, iy + li * lh, trimmed, tc.r, tc.g, tc.b, scaled_alpha(tc.a, st.opacity), st.font_size, fl)
            end
            li += 1
        end
        if focused && rs.caret_on is
            let cl: int = ta_line_of(t, rs.cursor)
            let cx: int = text_width(win, string_slice(value, t.starts[cl], rs.cursor), st)
            let nch: int = if rs.cursor < string_len(value) then ffi_shim::silver_utf8_next(value, rs.cursor) else rs.cursor
            let cwid: int = if nch > rs.cursor then text_width(win, string_slice(value, rs.cursor, nch), st) else text_width(win, "0", st)
            draw_caret(win, st, xcolor(st, "caret-color", tc), ix + cx, iy + cl * lh, lh, cwid)
        end
        return 0
    end

    ;; jednowierszowe pole
    let shown: string = if password then mask_of(value) else value
    let caret_x: int = text_width(win, shown_prefix(value, rs.cursor, password), st)
    let mut scroll: int = 0
    if focused && caret_x > iw - 2 is scroll = caret_x - iw + 2 end
    let ty: int = iy + (ih - lh) / 2
    if focused && rs.anchor != rs.cursor is
        let lo: int = if rs.anchor < rs.cursor then rs.anchor else rs.cursor
        let hi: int = if rs.anchor < rs.cursor then rs.cursor else rs.anchor
        let x0: int = text_width(win, shown_prefix(value, lo, password), st)
        let x1: int = text_width(win, shown_prefix(value, hi, password), st)
        fill(win, ix + x0 - scroll, ty, x1 - x0, lh, style::Color { r: 51, g: 144, b: 255, a: 110 }, 100)
    end
    if value == "" && n.attr_placeholder != "" && rs.ime == "" is
        ffi_shim::silver_draw_text_ex(win, ix, ty, n.attr_placeholder, tc.r, tc.g, tc.b, 110, st.font_size, fl)
    end
    if shown != "" is
        ffi_shim::silver_draw_text_ex(win, ix - scroll, ty, shown, tc.r, tc.g, tc.b, scaled_alpha(tc.a, st.opacity), st.font_size, fl)
    end
    if focused && rs.ime != "" is
        let ime_x: int = ix - scroll + caret_x
        ffi_shim::silver_draw_text_ex(win, ime_x, ty, rs.ime, tc.r, tc.g, tc.b, 255, st.font_size, 4)
    end
    if focused && rs.caret_on is
        let ime_w: int = if rs.ime != "" then text_width(win, rs.ime, st) else 0
        let nch: int = if !password && rs.cursor < string_len(value) then ffi_shim::silver_utf8_next(value, rs.cursor) else rs.cursor
        let cwid: int = if nch > rs.cursor then text_width(win, string_slice(value, rs.cursor, nch), st) else text_width(win, "0", st)
        draw_caret(win, st, xcolor(st, "caret-color", tc), ix - scroll + caret_x + ime_w, ty, lh, cwid)
    end
    return 0
end

fn draw_check(win: int, b: layout::LayoutBox, by: int, d: dom::Dom, rs: RenderState, radio: bool) -> int is
    let n: dom::DomNode = d.nodes[b.node_id]
    let st: style::ComputedStyle = b.st
    if props::xget(st.xp, "appearance") == "none" is return 0 end   ;; wygląd natywny wyłączony — autor stylizuje sam
    let size: int = 16
    let x: int = b.x + (b.w - size) / 2
    let y: int = by + (b.h - size) / 2
    let accent: style::Color = (if st.has_accent then st.accent else style::Color { r: 11, g: 107, b: 203, a: 255 })
    let edge: style::Color = if n.checked then accent else style::Color { r: 118, g: 118, b: 118, a: 255 }
    let rad: int = if radio then 8 else 3
    round_fill(win, x, y, size, size, rad, if n.checked && !radio then accent else style::Color { r: 255, g: 255, b: 255, a: 255 }, st.opacity)
    ffi_shim::silver_stroke_round_rect(win, x, y, size, size, rad, 1, edge.r, edge.g, edge.b, scaled_alpha(255, st.opacity))
    if n.checked is
        if radio is
            round_fill(win, x + 4, y + 4, 8, 8, 4, accent, st.opacity)
        else is
            let w: style::Color = style::Color { r: 255, g: 255, b: 255, a: 255 }
            ;; ptaszek z odcinków 2 px
            let mut i: int = 0
            while i < 3 is
                fill(win, x + 3 + i, y + 8 + i, 2, 2, w, st.opacity)
                i += 1
            end
            i = 0
            while i < 6 is
                fill(win, x + 6 + i, y + 10 - i, 2, 2, w, st.opacity)
                i += 1
            end
        end
    end
    if rs.focused == b.node_id is
        ffi_shim::silver_stroke_round_rect(win, x - 2, y - 2, size + 4, size + 4, rad + 2, 1, 51, 144, 255, 200)
    end
    return 0
end

;; Tekst wybranej opcji <select>
pub fn select_label(d: dom::Dom, node_id: int) -> string is
    let n: dom::DomNode = d.nodes[node_id]
    let mut first: string = ""
    let mut i: int = 0
    while i < array_len(n.children) is
        let c: dom::DomNode = d.nodes[n.children[i]]
        i += 1
        if c.tag != "option" || c.removed is continue end
        let label: string = dom::text_content(d, c.id)
        let val: string = if c.attr_value != "" then c.attr_value else label
        if first == "" is first = label end
        if n.attr_value != "" && val == n.attr_value is return label end
        if n.attr_value == "" && dom::has_attr(c, "selected") is return label end
    end
    return first
end

fn draw_select(win: int, d: dom::Dom, b: layout::LayoutBox, by: int, rs: RenderState) -> int is
    let st: style::ComputedStyle = b.st
    let ix: int = b.x + st.bl + st.pad_left
    let lh: int = layout::normal_line_height(st.font_size)
    let ty: int = by + (b.h - lh) / 2
    let label: string = select_label(d, b.node_id)
    ffi_shim::silver_clip_set(win, ix, by, b.w - st.bl - st.br - st.pad_left - 22, b.h)
    ffi_shim::silver_draw_text_ex(win, ix, ty, label, st.color.r, st.color.g, st.color.b, scaled_alpha(st.color.a, st.opacity), st.font_size, flags_of(st))
    ffi_shim::silver_clip_clear(win)
    let ax: int = b.x + b.w - st.br - 16
    let ay: int = by + b.h / 2 - 2
    let mut i: int = 0
    while i < 4 is
        ffi_shim::silver_fill_rect(win, ax + i, ay + i, 8 - i * 2, 1, 90, 90, 90, 255)
        i += 1
    end
    return 0
end

fn draw_button_input(win: int, d: dom::Dom, b: layout::LayoutBox, by: int) -> int is
    let n: dom::DomNode = d.nodes[b.node_id]
    let st: style::ComputedStyle = b.st
    let label: string = if n.attr_value != "" then n.attr_value else "OK"
    let tw: int = text_width(win, label, st)
    let lh: int = layout::normal_line_height(st.font_size)
    ffi_shim::silver_draw_text_ex(win, b.x + (b.w - tw) / 2, by + (b.h - lh) / 2, label, st.color.r, st.color.g, st.color.b,
                                  scaled_alpha(st.color.a, st.opacity), st.font_size, flags_of(st))
    return 0
end

;; ---------- pasek przewijania ----------
fn draw_scrollbar(win: int, b: layout::LayoutBox, by: int) -> int is
    let st: style::ComputedStyle = b.st
    if st.overflow_y != "scroll" && st.overflow_y != "auto" is return 0 end
    let inner_h: int = b.h - st.bt - st.bb
    if b.content_h <= inner_h || inner_h <= 0 is return 0 end
    let sbw: string = props::xget(st.xp, "scrollbar-width")
    if sbw == "none" is return 0 end
    ffi_shim::silver_clip_clear(win)
    let tw: int = if sbw == "thin" then 3 else 5
    let track_x: int = b.x + b.w - st.br - tw - 2
    let mut thumb: int = inner_h * inner_h / b.content_h
    if thumb < 24 is thumb = 24 end
    let range: int = b.content_h - inner_h
    let travel: int = inner_h - thumb
    let ty: int = by + st.bt + (if range > 0 then b.scroll_y * travel / range else 0)
    let sbc: style::Color = xcolor(st, "scrollbar-color", style::Color { r: 90, g: 90, b: 90, a: 140 })
    ffi_shim::silver_fill_round_rect(win, track_x, ty, tw, thumb, 2, sbc.r, sbc.g, sbc.b, if props::xhas(st.xp, "scrollbar-color") then 220 else 140)
    return 0
end

;; 0.4: resize — dozwolone osie [poziomo, pionowo]; pusta lista gdy element nie jest zmieniany.
pub fn resize_axes(st: style::ComputedStyle) -> [bool] is
    if !style::is_scroll_container(st) is return [] end
    let r: string = st.resize
    if r == "both" is return [true, true] end
    if r == "horizontal" || r == "inline" is return [true, false] end
    if r == "vertical" || r == "block" is return [false, true] end
    return []
end

;; Uchwyt zmiany rozmiaru (prawy dolny róg ramki, 14×14) → [x, y, w, h]; [] gdy brak.
pub fn resize_handle(b: layout::LayoutBox, by: int) -> [int] is
    if b.kind != "box" || array_len(resize_axes(b.st)) == 0 is return [] end
    if b.w < 24 || b.h < 24 is return [] end
    return [b.x + b.w - 14, by + b.h - 14, 14, 14]
end

;; Węzeł, którego uchwyt resize jest pod punktem okna (najwyższy box); -1 gdy żaden.
pub fn resize_handle_at(boxes: [layout::LayoutBox], px: int, py: int, scroll_y: int) -> int is
    let mut i: int = array_len(boxes) - 1
    while i >= 0 is
        let b: layout::LayoutBox = boxes[i]
        i -= 1
        if b.kind != "box" || b.node_id <= 0 is continue end
        let by: int = if b.fixed then b.y else b.y - scroll_y
        let g: [int] = resize_handle(b, by)
        if array_len(g) == 4 && px >= g[0] && px < g[0] + g[2] && py >= g[1] && py < g[1] + g[3] is return b.node_id end
    end
    return -1
end

fn draw_resize_handle(win: int, b: layout::LayoutBox, by: int) -> int is
    let g: [int] = resize_handle(b, by)
    if array_len(g) < 4 is return 0 end
    ffi_shim::silver_clip_clear(win)
    let mut k: int = 0
    while k < 3 is
        ;; trzy ukośne „ząbki” w prawym dolnym rogu
        let off: int = 3 + k * 4
        ffi_shim::silver_fill_rect(win, g[0] + g[2] - off - 1, g[1] + g[3] - 3, 2, 2, 110, 110, 110, 200)
        ffi_shim::silver_fill_rect(win, g[0] + g[2] - 3, g[1] + g[3] - off - 1, 2, 2, 110, 110, 110, 200)
        k += 1
    end
    return 0
end

;; 0.4: poziomy pasek przewijania — geometria uchwytu [x, y, szerokość, wysokość]; [] gdy pasek niepotrzebny.
pub fn hbar_geometry(b: layout::LayoutBox, by: int) -> [int] is
    let st: style::ComputedStyle = b.st
    if st.overflow_x != "scroll" && st.overflow_x != "auto" is return [] end
    let inner_w: int = b.w - st.bl - st.br
    if b.content_w <= inner_w || inner_w <= 0 is return [] end
    let sbw: string = props::xget(st.xp, "scrollbar-width")
    if sbw == "none" is return [] end
    let tw: int = if sbw == "thin" then 3 else 5
    let mut thumb: int = inner_w * inner_w / b.content_w
    if thumb < 24 is thumb = 24 end
    let range: int = b.content_w - inner_w
    let travel: int = inner_w - thumb
    let tx: int = b.x + st.bl + (if range > 0 then b.scroll_x * travel / range else 0)
    let ty: int = by + b.h - st.bb - tw - 2
    return [tx, ty, thumb, tw]
end

fn draw_scrollbar_x(win: int, b: layout::LayoutBox, by: int) -> int is
    let g: [int] = hbar_geometry(b, by)
    if array_len(g) < 4 is return 0 end
    let st: style::ComputedStyle = b.st
    ffi_shim::silver_clip_clear(win)
    let sbc: style::Color = xcolor(st, "scrollbar-color", style::Color { r: 90, g: 90, b: 90, a: 140 })
    ffi_shim::silver_fill_round_rect(win, g[0], g[1], g[2], g[3], 2, sbc.r, sbc.g, sbc.b, if props::xhas(st.xp, "scrollbar-color") then 220 else 140)
    return 0
end

;; Kontener przewijany poziomo pod kursorem (najbliższy przodek z content_w > szerokość); -1 gdy brak.
pub fn scroll_container_x_at(boxes: [layout::LayoutBox], d: dom::Dom, px: int, py: int, scroll_y: int) -> int is
    let hit: int = hit_test_at(boxes, px, py, scroll_y)
    let mut cur: int = hit
    while cur >= 0 is
        let mut i: int = 0
        while i < array_len(boxes) is
            let b: layout::LayoutBox = boxes[i]
            i += 1
            if b.node_id == cur && b.kind == "box" && b.content_w > b.w - b.st.bl - b.st.br && style::is_scroll_container(b.st) is
                return cur
            end
        end
        cur = d.nodes[cur].parent
    end
    return -1
end

pub fn max_scroll_x_of(boxes: [layout::LayoutBox], node_id: int) -> int is
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        i += 1
        if b.node_id == node_id && b.kind == "box" is
            let inner: int = b.w - b.st.bl - b.st.br
            return if b.content_w > inner then b.content_w - inner else 0
        end
    end
    return 0
end

;; ---------- główne rysowanie ----------
;; Prostokąt [x,y,w,h] wg wartości background-clip/-origin: border-box | padding-box | content-box.
pub fn bg_box_rect(st: style::ComputedStyle, key: string, x: int, y: int, w: int, h: int) -> [int] is
    let v: string = props::xget(st.xp, key)
    if v == "padding-box" || v == "padding" is
        return [x + st.bl, y + st.bt, w - st.bl - st.br, h - st.bt - st.bb]
    end
    if v == "content-box" || v == "content" is
        return [x + st.bl + st.pad_left, y + st.bt + st.pad_top, w - st.bl - st.br - st.pad_left - st.pad_right, h - st.bt - st.bb - st.pad_top - st.pad_bottom]
    end
    return [x, y, w, h]
end

;; ---------- 0.4: warstwy tła (wiele obrazów/gradientów, size/position/repeat/origin/clip/attachment/blend-mode) ----------
fn box_rect_kw(st: style::ComputedStyle, kw: string, x: int, y: int, w: int, h: int) -> [int] is
    if kw == "padding-box" || kw == "padding" is
        return [x + st.bl, y + st.bt, w - st.bl - st.br, h - st.bt - st.bb]
    end
    if kw == "content-box" || kw == "content" is
        return [x + st.bl + st.pad_left, y + st.bt + st.pad_top, w - st.bl - st.br - st.pad_left - st.pad_right, h - st.bt - st.bb - st.pad_top - st.pad_bottom]
    end
    return [x, y, w, h]
end

fn bg_dflt(v: string, d: string) -> string is
    if v == "" is return d end
    return v
end

pub fn has_bg_layers(st: style::ComputedStyle) -> bool is
    let list: string = props::xget(st.xp, "background-image")
    if list == "" is return false end
    let n: int = gfx::list_len(list)
    let mut i: int = 0
    while i < n is
        if gfx::image_kind(gfx::list_at(list, i)) != 0 is return true end
        i += 1
    end
    return false
end

fn blend_of_layer(st: style::ComputedStyle, i: int) -> string is
    let l: string = props::xget(st.xp, "background-blend-mode")
    if l == "" is return "normal" end
    return string_lower(gfx::list_at(l, i))
end

fn any_layer_blend(st: style::ComputedStyle) -> bool is
    let l: string = string_lower(props::xget(st.xp, "background-blend-mode"))
    if l == "" is return false end
    let n: int = gfx::list_len(l)
    let mut i: int = 0
    while i < n is
        let m: string = gfx::list_at(l, i)
        if m != "normal" && m != "" is return true end
        i += 1
    end
    return false
end

fn layer_rect_kw(st: style::ComputedStyle, kw: string, x: int, y: int, w: int, h: int, whole: [int]) -> [int] is
    if kw == "no-clip" is return whole end
    return box_rect_kw(st, kw, x, y, w, h)
end

;; Jedna warstwa obrazu: pfx = "background" albo "mask". `whole` = prostokąt całej warstwy offscreen (dla no-clip).
fn draw_img_layer(win: int, st: style::ComputedStyle, pfx: string, i: int, x0: int, y0: int, w0: int, h0: int, scroll_x: int, scroll_y: int, cw_: int, ch_: int, vw: int, vh: int, whole: [int]) -> int is
    let images: string = props::xget(st.xp, pfx + "-image")
    let img: string = gfx::list_at(images, i)
    let kind: int = gfx::image_kind(img)
    if kind == 0 is return 0 end
    let org_dflt: string = if pfx == "background" then "padding-box" else "border-box"
    let org_kw: string = bg_dflt(gfx::list_at(props::xget(st.xp, pfx + "-origin"), i), org_dflt)
    let clp_kw: string = bg_dflt(gfx::list_at(props::xget(st.xp, pfx + "-clip"), i), "border-box")
    let att: string = if pfx == "background" then bg_dflt(gfx::list_at(props::xget(st.xp, "background-attachment"), i), "scroll") else "scroll"
    let mut org: [int] = layer_rect_kw(st, org_kw, x0, y0, w0, h0, whole)
    let clp: [int] = layer_rect_kw(st, clp_kw, x0, y0, w0, h0, whole)
    if att == "fixed" is
        org = [0, 0, vw, vh]
    elsif att == "local" is
        org = [org[0] - scroll_x, org[1] - scroll_y, if cw_ > org[2] then cw_ else org[2], if ch_ > org[3] then ch_ else org[3]]
    end
    let mut nw: int = 0
    let mut nh: int = 0
    let mut src: string = ""
    let mut nkind: int = 0
    if kind == 1 is
        src = gfx::url_of(img)
        if src == "" is return 0 end
        nw = ffi_shim::silver_image_width(win, src)
        nh = ffi_shim::silver_image_height(win, src)
        if nw <= 0 || nh <= 0 is return 0 end
    else is
        src = gfx::gradient_spec(img, cssval::Color { r: st.color.r, g: st.color.g, b: st.color.b, a: st.color.a }, st.font_size)
        if src == "" is return 0 end
        nkind = 1
    end
    let size: string = bg_dflt(gfx::list_at(props::xget(st.xp, pfx + "-size"), i), "auto")
    let pos: string = bg_dflt(gfx::list_at(props::xget(st.xp, pfx + "-position"), i), "0% 0%")
    let rep: string = bg_dflt(gfx::list_at(props::xget(st.xp, pfx + "-repeat"), i), "repeat")
    if org[2] <= 0 || org[3] <= 0 || clp[2] <= 0 || clp[3] <= 0 is return 0 end
    let g: [int] = gfx::layer_geometry(org[0], org[1], org[2], org[3], nw, nh, size, pos, rep, st.font_size)
    let alpha: int = if pfx == "background" then scaled_alpha(255, st.opacity) else 255
    let mode: string = if pfx == "background" then blend_of_layer(st, i) else "normal"
    if mode != "normal" && mode != "" is
        ffi_shim::silver_layer_begin(win, clp[0], clp[1], clp[2], clp[3])
        ffi_shim::silver_draw_tiled(win, nkind, src, clp[0], clp[1], clp[2], clp[3], g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7], 255)
        ffi_shim::silver_layer_end_fx(win, 1000, 0, 0, 1000, 0, 0, 0, 0, alpha, "blend:" + mode)
    else is
        ffi_shim::silver_draw_tiled(win, nkind, src, clp[0], clp[1], clp[2], clp[3], g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7], alpha)
    end
    return 0
end

fn draw_one_bg_layer(win: int, st: style::ComputedStyle, i: int, x0: int, y0: int, w0: int, h0: int, scroll_x: int, scroll_y: int, cw_: int, ch_: int, vw: int, vh: int) -> int is
    return draw_img_layer(win, st, "background", i, x0, y0, w0, h0, scroll_x, scroll_y, cw_, ch_, vw, vh, [x0, y0, w0, h0])
end

;; Rysuje maskę elementu (mask-image …) do natywnego bufora maski; prostokąt warstwy = (rx, ry, rw, rh) w oknie.
fn draw_mask_layers(win: int, first: layout::LayoutBox, dy: int, rx: int, ry: int, rw: int, rh: int) -> int is
    let st: style::ComputedStyle = first.st
    let n: int = gfx::list_len(props::xget(st.xp, "mask-image"))
    let by: int = first.y + dy
    let whole: [int] = [rx, ry, rw, rh]
    let mut i: int = n - 1
    while i >= 0 is
        ffi_shim::silver_layer_begin(win, rx, ry, rw, rh)
        draw_img_layer(win, st, "mask", i, first.x, by, first.w, first.h, first.scroll_x, first.scroll_y, first.content_w, first.content_h, 0, 0, whole)
        let mode: int = if string_lower(gfx::list_at(props::xget(st.xp, "mask-mode"), i)) == "luminance" then 1 else 0
        let op: int = if i == n - 1 then 0 else gfx::composite_code(string_lower(gfx::list_at(props::xget(st.xp, "mask-composite"), i)))
        ffi_shim::silver_layer_capture_mask(win, mode, op)
        i -= 1
    end
    ;; mask-border-*: dodatkowa warstwa maski z 9 fragmentów (dokładana przez add)
    if gfx::image_kind(props::xget(st.xp, "mask-border-source")) != 0 is
        ffi_shim::silver_layer_begin(win, rx, ry, rw, rh)
        draw_image_border_pfx(win, first.x, by, first.w, first.h, st, "mask-border", "auto")
        let bmode: int = if string_lower(props::xget(st.xp, "mask-border-mode")) == "luminance" then 1 else 0
        ffi_shim::silver_layer_capture_mask(win, bmode, if n > 0 then 1 else 0)
    end
    return 0
end

;; Tło z warstwami: kolor + obrazy od dołu do góry. Zaokrąglone rogi i blend-mode wymagają grupy (warstwy offscreen + maska).
fn draw_bg_with_layers(win: int, b: layout::LayoutBox, x0: int, y0: int, w0: int, h0: int, vw: int, vh: int) -> int is
    let st: style::ComputedStyle = b.st
    let rad: int = max_radius(st)
    let cr: [int] = bg_box_rect(st, "background-clip", x0, y0, w0, h0)
    let grouped: bool = rad > 0 || any_layer_blend(st)
    if grouped is ffi_shim::silver_layer_begin(win, x0, y0, w0, h0) end
    if st.has_bg is
        round_fill(win, cr[0], cr[1], cr[2], cr[3], if grouped then 0 else rad, st.background, st.opacity)
    end
    let n: int = gfx::list_len(props::xget(st.xp, "background-image"))
    let mut i: int = n - 1
    while i >= 0 is
        draw_one_bg_layer(win, st, i, x0, y0, w0, h0, b.scroll_x, b.scroll_y, b.content_w, b.content_h, vw, vh)
        i -= 1
    end
    if grouped is
        if rad > 0 is
            ffi_shim::silver_layer_begin(win, x0, y0, w0, h0)
            ffi_shim::silver_fill_round_rect(win, x0, y0, w0, h0, rad, 255, 255, 255, 255)
            ffi_shim::silver_layer_capture_mask(win, 0, 0)
            ffi_shim::silver_layer_end_fx(win, 1000, 0, 0, 1000, 0, 0, 0, 0, 255, "mask")
        else is
            ffi_shim::silver_layer_end_fx(win, 1000, 0, 0, 1000, 0, 0, 0, 0, 255, "")
        end
    end
    return 0
end

fn background_of(win: int, b: layout::LayoutBox, x0: int, y0: int, w0: int, h0: int) -> int is
    let st: style::ComputedStyle = b.st
    let rad: int = max_radius(st)
    if st.has_shadow is draw_shadow(win, x0, y0, w0, h0, st) end
    let cr: [int] = bg_box_rect(st, "background-clip", x0, y0, w0, h0)
    let x: int = cr[0]
    let y: int = cr[1]
    let w: int = cr[2]
    let h: int = cr[3]
    if w <= 0 || h <= 0 is return 0 end
    if has_bg_layers(st) is
        return draw_bg_with_layers(win, b, x0, y0, w0, h0, ffi_shim::silver_get_width(win), ffi_shim::silver_get_height(win))
    end
    if st.has_bg is
        let sps: string = shape_spec(st, 0)
        if sps != "" && st.background.a > 0 is
            ffi_shim::silver_fill_shape_rect(win, x, y, w, h, sps, st.background.r, st.background.g, st.background.b, scaled_alpha(st.background.a, st.opacity))
        else is
            round_fill(win, x, y, w, h, rad, st.background, st.opacity)
        end
    end
    if st.has_grad is
        let a1: int = scaled_alpha(st.grad_from.a, st.opacity)
        let a2: int = scaled_alpha(st.grad_to.a, st.opacity)
        ffi_shim::silver_fill_gradient(win, x, y, w, h, st.grad_from.r, st.grad_from.g, st.grad_from.b, a1,
                                       st.grad_to.r, st.grad_to.g, st.grad_to.b, a2, if st.grad_vertical then 1 else 0)
    end
    if st.bg_image != "" is
        let mode: string = if st.bg_size == "auto" then "none" else st.bg_size
        let orr: [int] = if props::xhas(st.xp, "background-origin") then bg_box_rect(st, "background-origin", x0, y0, w0, h0) else [x, y, w, h]
        if mode == "none" is
            draw_bg_natural(win, st.bg_image, orr[0], orr[1], orr[2], orr[3], st.bg_pos, st.bg_repeat, scaled_alpha(255, st.opacity))
        else is
            draw_fitted(win, st.bg_image, orr[0], orr[1], orr[2], orr[3], mode, scaled_alpha(255, st.opacity), x, y, w, h)
        end
    end
    return 0
end

fn set_box_clip(win: int, b: layout::LayoutBox, dy: int) -> int is
    if b.has_clip is
        let cy: int = if b.fixed then b.cy else b.cy + dy
        ffi_shim::silver_clip_set(win, b.cx, cy, b.cw, b.ch)
    else is
        ffi_shim::silver_clip_clear(win)
    end
    return 0
end

fn draw_one(win: int, b: layout::LayoutBox, d: dom::Dom, rs: RenderState) -> int is
        let dy: int = if b.fixed then 0 else 0 - rs.scroll_y + layout::sticky_dy(b, rs.scroll_y)
        let by: int = b.y + dy
        if by > rs.viewport_h || by + b.h < 0 && b.kind != "text" is return 0 end
        if by > rs.viewport_h is return 0 end
        set_box_clip(win, b, dy)
        let st: style::ComputedStyle = b.st
        if !st.visible is return 0 end
        if b.kind == "box" || b.kind == "inlinebg" is
            let n: dom::DomNode = d.nodes[b.node_id]
            if b.img_src != "" || st.bg_image != "" is
                let ir: string = props::xval(st.xp, "image-rendering")
                ffi_shim::silver_image_filter(win, if ir == "pixelated" || ir == "crisp-edges" || ir == "optimizespeed" then 1 elsif ir == "smooth" || ir == "high-quality" || ir == "optimizequality" then 2 else 0)
            end
            let bb: int = backdrop_blur_px(st)
            if bb > 0 && b.kind == "box" is ffi_shim::silver_backdrop_blur(win, b.x, by, b.w, b.h, bb) end
            background_of(win, b, b.x, by, b.w, b.h)
            if b.img_src != "" is
                let pad_x: int = b.x + st.bl + st.pad_left
                let pad_y: int = by + st.bt + st.pad_top
                let iw: int = b.w - st.bl - st.br - st.pad_left - st.pad_right
                let ih: int = b.h - st.bt - st.bb - st.pad_top - st.pad_bottom
                let vb: [int] = view_box_permille(props::xget(st.xp, "object-view-box"), ffi_shim::silver_image_width(win, b.img_src), ffi_shim::silver_image_height(win, b.img_src), st.font_size)
                let xfc: int = image_xf_code(st)
                if xfc != 0 || array_len(vb) == 4 is
                    let mut vx: int = 0
                    let mut vy: int = 0
                    let mut vw: int = 0
                    let mut vh: int = 0
                    if array_len(vb) == 4 is
                        vx = vb[0]
                        vy = vb[1]
                        vw = vb[2]
                        vh = vb[3]
                    end
                    ffi_shim::silver_image_xform(win, xfc, vx, vy, vw, vh)
                end
                draw_fitted_pos(win, b.img_src, pad_x, pad_y, iw, ih, st.object_fit, scaled_alpha(255, st.opacity), pad_x, pad_y, iw, ih, props::xval(st.xp, "object-position"))
                ffi_shim::silver_image_xform(win, 0, 0, 0, 0, 0)
                set_box_clip(win, b, dy)
            end
            if b.svg != "" is
                ;; 0.4: <svg> — NanoSVG
                let sx: int = b.x + st.bl + st.pad_left
                let sy: int = by + st.bt + st.pad_top
                let sw_: int = b.w - st.bl - st.br - st.pad_left - st.pad_right
                let sh_: int = b.h - st.bt - st.bb - st.pad_top - st.pad_bottom
                if sw_ > 0 && sh_ > 0 is ffi_shim::silver_draw_svg(win, b.svg, sx, sy, sw_, sh_, scaled_alpha(255, st.opacity)) end
                set_box_clip(win, b, dy)
            end
            draw_border(win, b.x, by, b.w, b.h, st)
            if b.kind == "box" is
                if n.tag == "input" is
                    let kind: string = string_lower(n.attr_type)
                    if kind == "checkbox" || kind == "radio" is
                        draw_check(win, b, by, d, rs, kind == "radio")
                    elsif kind == "button" || kind == "submit" || kind == "reset" is
                        draw_button_input(win, d, b, by)
                    elsif kind != "hidden" is
                        draw_input(win, d, b, by, rs)
                    end
                elsif n.tag == "textarea" is
                    draw_input(win, d, b, by, rs)
                elsif n.tag == "select" is
                    draw_select(win, d, b, by, rs)
                end
                if st.outline_w > 0 is
                    ffi_shim::silver_clip_clear(win)
                    draw_outline(win, b.x, by, b.w, b.h, st)
                    set_box_clip(win, b, dy)
                end
                if style::is_scroll_container(st) is
                    draw_scrollbar(win, b, by)
                    draw_scrollbar_x(win, b, by)
                    draw_resize_handle(win, b, by)
                end
            end
        elsif b.kind == "text" || b.kind == "marker" is
            if b.text != "" is
                draw_text_full(win, b, by)
                draw_emphasis(win, b, by)
            elsif b.kind == "marker" && b.img_src != "" is
                ;; 0.4: list-style-image
                draw_fitted_pos(win, b.img_src, b.x, by, b.w, b.h, "contain", scaled_alpha(255, st.opacity), b.x, by, b.w, b.h, "50% 50%")
            end
        end
    return 0
end

fn group_seen(seen: [int], id: int) -> bool is
    let mut k: int = 0
    while k < array_len(seen) is
        if seen[k] == id is return true end
        k += 1
    end
    return false
end

;; Poddrzewo z obrotem/pochyleniem: rysowane do warstwy i składane z macierzą (natywnie).
fn draw_group(win: int, boxes: [layout::LayoutBox], d: dom::Dom, rs: RenderState, id: int, first: layout::LayoutBox) -> int is
    let dy: int = if first.fixed then 0 else 0 - rs.scroll_y
    let xf: [int] = first.xf
    ;; 0.4: maska (mask-image …) rysowana przed zawartością — ta sama ramka warstwy
    let has_mask: bool = string_find(first.fx, "mask") >= 0
    if has_mask is draw_mask_layers(win, first, dy, xf[8], xf[9] + dy, xf[10], xf[11]) end
    let ok: bool = ffi_shim::silver_layer_begin(win, xf[8], xf[9] + dy, xf[10], xf[11])
    let mut k: int = 0
    while k < array_len(boxes) is
        if boxes[k].xf_id == id is draw_one(win, boxes[k], d, rs) end
        k += 1
    end
    ffi_shim::silver_clip_clear(win)
    if ok && first.m3d != "" is
        let bar: int = string_find(first.m3d, "|")
        let hide: int = if bar >= 0 && string_slice(first.m3d, bar + 1, string_len(first.m3d)) == "1" then 1 else 0
        ffi_shim::silver_layer_end_3d(win, if bar >= 0 then string_slice(first.m3d, 0, bar) else first.m3d, dy, 255, hide)
    elsif ok is
        ffi_shim::silver_layer_end_fx(win, xf[0], xf[1], xf[2], xf[3], xf[4] / 1000, xf[5] / 1000, xf[6], xf[7] + dy, 255, first.fx)
    elsif has_mask is
        ffi_shim::silver_mask_clear()
    end
    return 0
end

fn frag_annot(boxes: [layout::LayoutBox], i: int, mode: string) -> string is
    let b: layout::LayoutBox = boxes[i]
    if mode == "clone" is return "" end
    let mut minx: int = b.x
    let mut miny: int = b.y
    let mut maxx: int = b.x + b.w
    let mut maxy: int = b.y + b.h
    let mut off: int = 0
    let mut total: int = 0
    let mut j: int = 0
    while j < array_len(boxes) is
        let o: layout::LayoutBox = boxes[j]
        if o.kind == "text" && o.node_id == b.node_id && o.text != "" is
            if o.x < minx is minx = o.x end
            if o.y < miny is miny = o.y end
            if o.x + o.w > maxx is maxx = o.x + o.w end
            if o.y + o.h > maxy is maxy = o.y + o.h end
            if j < i is off = off + o.w end
            total = total + o.w
        end
        j += 1
    end
    if mode == "slice" is return to_string(0 - off) + ",0," + to_string(total) + "," + to_string(b.h) end
    return to_string(minx - b.x) + "," + to_string(miny - b.y) + "," + to_string(maxx - minx) + "," + to_string(maxy - miny)
end

;; 0.4: dla tekstu z fill-image/stroke-image dopisuje do xp prostokąt odniesienia wg fill-break / stroke-break
fn annotate_text_fragments(boxes: [layout::LayoutBox]) -> [layout::LayoutBox] is
    let mut need: bool = false
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        if b.kind == "text" && b.text != "" && (props::xget(b.st.xp, "fill-image") != "" || props::xget(b.st.xp, "stroke-image") != "") is need = true end
        i += 1
    end
    if !need is return boxes end
    let mut out: [layout::LayoutBox] = boxes
    i = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        if b.kind == "text" && b.text != "" is
            let mut xp: string = b.st.xp
            if props::xget(xp, "fill-image") != "" is
                let fb: string = string_lower(string_trim(props::xget(xp, "fill-break")))
                let a: string = frag_annot(boxes, i, if fb == "" then "bounding-box" else fb)
                if a != "" is xp = props::xset(xp, "\u0001fr", a) end
            end
            if props::xget(xp, "stroke-image") != "" is
                let sb: string = string_lower(string_trim(props::xget(xp, "stroke-break")))
                let a2: string = frag_annot(boxes, i, if sb == "" then "bounding-box" else sb)
                if a2 != "" is xp = props::xset(xp, "\u0001sr", a2) end
            end
            out[i].st.xp = xp
        end
        i += 1
    end
    return out
end

pub fn render(win: int, boxes0: [layout::LayoutBox], d: dom::Dom, rs: RenderState, bg: style::Color) -> int is
    ffi_shim::silver_clear(win, bg.r, bg.g, bg.b)
    return render_over(win, boxes0, d, rs)
end

;; Rysuje pudełka na istniejącej zawartości okna (bez czyszczenia tła) — np. pole przypisów u dołu strony.
pub fn render_over(win: int, boxes0: [layout::LayoutBox], d: dom::Dom, rs: RenderState) -> int is
    let boxes: [layout::LayoutBox] = annotate_text_fragments(boxes0)
    let count: int = array_len(boxes)
    let mut seen: [int] = []
    let mut i: int = 0
    while i < count is
        let b: layout::LayoutBox = boxes[i]
        i += 1
        if b.xf_id > 0 is
            if !group_seen(seen, b.xf_id) is
                seen = array_push(seen, b.xf_id)
                draw_group(win, boxes, d, rs, b.xf_id, b)
            end
        else is
            draw_one(win, b, d, rs)
        end
    end
    ffi_shim::silver_clip_clear(win)
    ;; 0.4: podświetlenie zaznaczenia tekstu dokumentu
    let mut k: int = 0
    while k + 3 < array_len(rs.sel) is
        ffi_shim::silver_fill_rect(win, rs.sel[k], rs.sel[k + 1] - rs.scroll_y, rs.sel[k + 2], rs.sel[k + 3], 51, 144, 255, 90)
        k += 4
    end
    return 0
end

;; ---------- hit-test ----------
;; Punkt (px, py) we współrzędnych OKNA; scroll_y dodajemy do boxów nie-fixed.
fn inside_clip(b: layout::LayoutBox, px: int, py_doc: int, py_view: int) -> bool is
    if !b.has_clip is return true end
    let py: int = if b.fixed then py_view else py_doc
    return px >= b.cx && px < b.cx + b.cw && py >= b.cy && py < b.cy + b.ch
end

;; Odwrotność macierzy xf (obrót/pochylenie wokół punktu obrotu) zastosowana do punktu okna.
pub fn inv_xf_point(xf: [int], x: int, y: int) -> [int] is
    let a: int = xf[0]
    let b: int = xf[1]
    let c: int = xf[2]
    let dd: int = xf[3]
    let det: int = (a * dd - b * c) / 1000
    if det == 0 is return [x, y] end
    let u: int = x - xf[6] - xf[4] / 1000
    let v: int = y - xf[7] - xf[5] / 1000
    let lx: int = (dd * u - c * v) / det
    let ly: int = (a * v - b * u) / det
    return [xf[6] + lx, xf[7] + ly]
end

;; id węzła na wierzchu w punkcie (dowolny element), -1 gdy nic.
pub fn hit_test_at(boxes: [layout::LayoutBox], px: int, py: int, scroll_y: int) -> int is
    let mut i: int = array_len(boxes) - 1
    while i >= 0 is
        let b: layout::LayoutBox = boxes[i]
        i -= 1
        let sd: int = layout::sticky_dy(b, scroll_y)
        let y_doc: int = py + scroll_y - sd
        let y: int = if b.fixed then py else y_doc
        let mut qx: int = px
        let mut qy: int = y
        if b.xf_id > 0 is
            let q: [int] = inv_xf_point(b.xf, px, y)
            qx = q[0]
            qy = q[1]
        end
        if qx >= b.x && qx < b.x + b.w && qy >= b.y && qy < b.y + b.h && inside_clip(b, qx, qy, qy) && b.st.visible && b.st.pointer_events is
            return b.node_id
        end
    end
    return -1
end

;; Zgodność wsteczna: punkt we współrzędnych dokumentu.
pub fn hit_test_any(boxes: [layout::LayoutBox], px: int, py: int) -> int is
    return hit_test_at(boxes, px, py, 0)
end

;; Najbliższy przodek-lub-ten-węzeł spełniający `pred`: "click" | "input" | "hover"
pub fn find_handler_node(d: dom::Dom, start: int, kind: string) -> int is
    let mut cur: int = start
    while cur >= 0 is
        let n: dom::DomNode = d.nodes[cur]
        if kind == "click" && (n.on_click != "" || n.tag == "button" || n.tag == "a" || n.tag == "label" || n.tag == "select" ||
                               (n.tag == "input" && (string_lower(n.attr_type) == "checkbox" || string_lower(n.attr_type) == "radio" ||
                                                     string_lower(n.attr_type) == "submit" || string_lower(n.attr_type) == "button")) ) is
            return cur
        end
        if kind == "input" && (n.tag == "textarea" || n.tag == "select" || (n.tag == "input" && string_lower(n.attr_type) != "hidden")) is return cur end
        if kind == "hover" && n.on_hover != "" is return cur end
        cur = n.parent
    end
    return -1
end

;; Zgodność wsteczna: węzeł z on-click pod kursorem albo -1.
pub fn hit_test(boxes: [layout::LayoutBox], d: dom::Dom, px: int, py: int) -> int is
    let hit: int = hit_test_at(boxes, px, py, 0)
    let mut cur: int = hit
    while cur >= 0 is
        if d.nodes[cur].on_click != "" is return cur end
        cur = d.nodes[cur].parent
    end
    return -1
end

;; Węzeł pola formularza pod kursorem albo -1.
pub fn hit_input_node(boxes: [layout::LayoutBox], d: dom::Dom, px: int, py: int, scroll_y: int) -> int is
    let hit: int = hit_test_at(boxes, px, py, scroll_y)
    return find_handler_node(d, hit, "input")
end

;; Zgodność wsteczna: attr_id pola formularza pod kursorem ("" gdy brak).
pub fn hit_test_input(boxes: [layout::LayoutBox], d: dom::Dom, px: int, py: int) -> string is
    let id: int = hit_input_node(boxes, d, px, py, 0)
    if id < 0 is return "" end
    return d.nodes[id].attr_id
end

;; Najwyższy kontener przewijany (overflow scroll/auto z nadmiarem) pod punktem.
pub fn scroll_container_at(boxes: [layout::LayoutBox], d: dom::Dom, px: int, py: int, scroll_y: int) -> int is
    let hit: int = hit_test_at(boxes, px, py, scroll_y)
    let mut cur: int = hit
    while cur >= 0 is
        let mut i: int = 0
        while i < array_len(boxes) is
            let b: layout::LayoutBox = boxes[i]
            i += 1
            if b.node_id == cur && b.kind == "box" && b.content_h > b.h - b.st.bt - b.st.bb && style::is_scroll_container(b.st) is
                return cur
            end
        end
        cur = d.nodes[cur].parent
    end
    return -1
end

;; Wysokość maksymalnego przewinięcia kontenera.
pub fn max_scroll_of(boxes: [layout::LayoutBox], node_id: int) -> int is
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        i += 1
        if b.node_id == node_id && b.kind == "box" is
            let inner: int = b.h - b.st.bt - b.st.bb
            return if b.content_h > inner then b.content_h - inner else 0
        end
    end
    return 0
end

;; Kursor CSS pod punktem (z dziedziczenia stylu boxa na wierzchu).
pub fn cursor_at(boxes: [layout::LayoutBox], px: int, py: int, scroll_y: int) -> string is
    let mut i: int = array_len(boxes) - 1
    while i >= 0 is
        let b: layout::LayoutBox = boxes[i]
        i -= 1
        let y_doc: int = py + scroll_y
        let y: int = if b.fixed then py else y_doc
        if px >= b.x && px < b.x + b.w && y >= b.y && y < b.y + b.h && inside_clip(b, px, y_doc, py) is
            return b.st.cursor
        end
    end
    return "default"
end
