fn concat_boxes(a: [LayoutBox], b: [LayoutBox]) -> [LayoutBox] is
    let mut out: [LayoutBox] = a
    let mut i: int = 0
    while i < array_len(b) is
        out = array_push(out, b[i])
        i += 1
    end
    return out
end

fn shift_boxes(boxes: [LayoutBox], dx: int, dy: int) -> [LayoutBox] is
    if dx == 0 && dy == 0 is return boxes end
    let mut out: [LayoutBox] = boxes
    let mut i: int = 0
    while i < array_len(out) is
        out[i].x = out[i].x + dx
        out[i].y = out[i].y + dy
        if out[i].has_clip is
            out[i].cx = out[i].cx + dx
            out[i].cy = out[i].cy + dy
        end
        i += 1
    end
    return out
end

;; Przycina KAŻDY box (od indeksu `from`) do prostokąta (część wspólna z istniejącym clipem).
fn apply_clip(boxes: [LayoutBox], from: int, rx: int, ry: int, rw: int, rh: int) -> [LayoutBox] is
    let mut out: [LayoutBox] = boxes
    let mut i: int = from
    while i < array_len(out) is
        if out[i].has_clip is
            let x0: int = if out[i].cx > rx then out[i].cx else rx
            let y0: int = if out[i].cy > ry then out[i].cy else ry
            let x1: int = if out[i].cx + out[i].cw < rx + rw then out[i].cx + out[i].cw else rx + rw
            let y1: int = if out[i].cy + out[i].ch < ry + rh then out[i].cy + out[i].ch else ry + rh
            out[i].cx = x0
            out[i].cy = y0
            out[i].cw = if x1 > x0 then x1 - x0 else 0
            out[i].ch = if y1 > y0 then y1 - y0 else 0
        else is
            out[i].has_clip = true
            out[i].cx = rx
            out[i].cy = ry
            out[i].cw = rw
            out[i].ch = rh
        end
        i += 1
    end
    return out
end

;; ---------- tekst ----------
pub fn normal_line_height(font_size: int) -> int is
    return font_size + font_size / 4 + 2
end

fn line_h_of(st: style::ComputedStyle) -> int is
    let mut lh: int = normal_line_height(st.font_size)
    if st.line_height > 0 is lh = st.line_height end
    ;; 0.4: line-height-step — wysokość wiersza zaokrąglana w górę do wielokrotności kroku
    let stp: string = props::xget(st.xp, "line-height-step")
    if stp != "" && stp != "0" && stp != "0px" is
        let step: int = gfx::len_px(stp, 0, st.font_size)
        if step > 0 is lh = ((lh + step - 1) / step) * step end
    end
    return lh
end

;; 0.4: font-synthesis — czy wolno syntetyzować (weight | style | small-caps). Skrót: none | [weight] [style] [small-caps] [position];
;; longhandy font-synthesis-weight/-style/-small-caps: auto | none.
pub fn synth_allowed(st: style::ComputedStyle, what: string) -> bool is
    let lh: string = string_lower(props::xget(st.xp, "font-synthesis-" + what))
    if lh == "none" is return false end
    let sh: string = string_lower(props::xget(st.xp, "font-synthesis"))
    if sh == "" is return true end
    if sh == "none" is return false end
    return trim_token(sh, what)
end

;; text-transform z uwzględnieniem kapitalików (font-variant-caps ≠ normal, gdy wolno syntetyzować)
pub fn eff_transform(st: style::ComputedStyle) -> string is
    let caps: string = string_lower(props::xget(st.xp, "font-variant-caps"))
    if caps != "" && caps != "normal" && synth_allowed(st, "small-caps") && st.text_transform == "none" is return "uppercase" end
    return st.text_transform
end


;; ============ 0.4: font-variant-alternates / font-palette / font-language-override ============
;; SDL_ttf nie kształtuje tekstu, więc te trzy właściwości działają przez ścieżkę HarfBuzz + FreeType w shimie
;; (native/silver_shape.h). Silnik rozwiązuje odwołania do @font-feature-values / @font-palette-values przy liczeniu
;; stylu (klucze wewnętrzne "-silver-falt" i "-silver-fpal" w xp), a `shape_prefix` buduje przedrostek tekstu
;; "\u0002 cechy|język|paleta|nadpisania \u0003", który dostają wszystkie wywołania pomiaru i rysowania.
fn fam_names(fam: string) -> [string] is
    let parts: [string] = string_split(fam, ",")
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(parts) is
        let t: string = string_lower(string_trim(string_replace(string_replace(parts[i], "\"", ""), "'", "")))
        if t != "" is out = array_push(out, t) end
        i += 1
    end
    return out
end

fn fam_match(entry_fams: string, st_family: string) -> bool is
    if string_trim(entry_fams) == "" is return true end
    let a: [string] = fam_names(entry_fams)
    let b: [string] = fam_names(st_family)
    let mut i: int = 0
    while i < array_len(a) is
        let mut j: int = 0
        while j < array_len(b) is
            if a[i] == b[j] is return true end
            j += 1
        end
        i += 1
    end
    return false
end

fn fv_ints(sheet: css::Stylesheet, st_family: string, kind: string, name: string) -> [int] is
    let mut found: [int] = []
    let mut i: int = 0
    while i < array_len(sheet.fvalues) is
        let p: [string] = string_split(sheet.fvalues[i], "\u0001")
        i += 1
        if array_len(p) < 4 || p[1] != kind || p[2] != name || !fam_match(p[0], st_family) is continue end
        let toks: [string] = string_split(string_trim(p[3]), " ")
        let mut nums: [int] = []
        let mut t: int = 0
        while t < array_len(toks) is
            if toks[t] != "" && props::is_num(toks[t]) is nums = array_push(nums, conv::str_to_int(toks[t])) end
            t += 1
        end
        found = nums
    end
    return found
end

fn arg_ints(arg: string, sheet: css::Stylesheet, fam: string, kind: string) -> [int] is
    let a: string = string_trim(arg)
    if a != "" && props::is_num(a) is return [conv::str_to_int(a)] end
    return fv_ints(sheet, fam, kind, a)
end

fn tag2(prefix: string, n: int) -> string is
    return prefix + (if n < 10 then "0" + to_string(n) else to_string(n))
end

fn feat_kv(tag: string, v: int) -> string is
    return "\"" + tag + "\" " + to_string(v)
end

fn join_comma(acc: string, add: string) -> string is
    if add == "" is return acc end
    if acc == "" is return add end
    return acc + ", " + add
end

pub fn alt_features(v: string, fam: string, sheet: css::Stylesheet) -> string is
    let toks: [string] = cssval::split_top(string_trim(v))
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(toks) is
        let tok: string = string_trim(toks[i])
        i += 1
        if string_lower(tok) == "historical-forms" is out = join_comma(out, feat_kv("hist", 1)) continue end
        let po: int = string_find(tok, "(")
        let pc: int = string_find(tok, ")")
        if po <= 0 || pc < po is continue end
        let fname: string = string_lower(string_slice(tok, 0, po))
        let args: [string] = cssval::split_commas(string_slice(tok, po + 1, pc))
        if fname == "stylistic" || fname == "swash" || fname == "ornaments" || fname == "annotation" is
            let mut ints: [int] = []
            if array_len(args) > 0 is ints = arg_ints(args[0], sheet, fam, fname) end
            if array_len(ints) > 0 is
                let tag: string = if fname == "stylistic" then "salt" elsif fname == "swash" then "swsh" elsif fname == "ornaments" then "ornm" else "nalt"
                out = join_comma(out, feat_kv(tag, ints[0]))
            end
        elsif fname == "styleset" is
            let mut a: int = 0
            while a < array_len(args) is
                let ints: [int] = arg_ints(args[a], sheet, fam, "styleset")
                let mut q: int = 0
                while q < array_len(ints) is
                    if ints[q] >= 1 && ints[q] <= 20 is out = join_comma(out, feat_kv(tag2("ss", ints[q]), 1)) end
                    q += 1
                end
                a += 1
            end
        elsif fname == "character-variant" is
            let mut a: int = 0
            while a < array_len(args) is
                let ints: [int] = arg_ints(args[a], sheet, fam, "character-variant")
                if array_len(ints) > 0 && ints[0] >= 1 && ints[0] <= 99 is
                    out = join_comma(out, feat_kv(tag2("cv", ints[0]), if array_len(ints) > 1 then ints[1] else 1))
                end
                a += 1
            end
        end
    end
    return out
end

;; "wybór|nadpisania": wybór = "" | light | dark | indeks; nadpisania = "i:r,g,b,a;…"
pub fn palette_spec(v0: string, fam: string, sheet: css::Stylesheet) -> string is
    let v: string = string_trim(v0)
    let lv: string = string_lower(v)
    if lv == "" || lv == "normal" is return "" end
    if lv == "light" || lv == "dark" is return lv + "|" end
    if !string_starts_with(v, "--") is return "" end
    let mut sel: string = ""
    let mut ovr: string = ""
    let mut found: bool = false
    let mut i: int = 0
    while i < array_len(sheet.palettes) is
        let p: [string] = string_split(sheet.palettes[i], "\u0001")
        i += 1
        if array_len(p) < 4 || p[0] != v || !fam_match(p[1], fam) is continue end
        found = true
        sel = ""
        ovr = ""
        if p[2] == "light" || p[2] == "dark" || props::is_num(p[2]) is sel = p[2] end
        let pairs: [string] = cssval::split_commas(p[3])
        let mut q: int = 0
        while q < array_len(pairs) is
            let t: string = string_trim(pairs[q])
            let sp: int = string_find(t, " ")
            q += 1
            if sp <= 0 is continue end
            let idx: string = string_slice(t, 0, sp)
            if !props::is_num(idx) is continue end
            let c: cssval::Color = cssval::parse_color(string_trim(string_slice(t, sp + 1, string_len(t))))
            ovr = ovr + (if ovr == "" then "" else ";") + idx + ":" + to_string(c.r) + "," + to_string(c.g) + "," + to_string(c.b) + "," + to_string(c.a)
        end
    end
    if found == false is return "" end
    return sel + "|" + ovr
end

pub fn apply_font_variants(st: style::ComputedStyle, sheet: css::Stylesheet) -> style::ComputedStyle is
    if string_find(st.xp, "font-variant-alternates") < 0 && string_find(st.xp, "font-palette") < 0 is return st end
    let alt: string = string_trim(props::xget(st.xp, "font-variant-alternates"))
    let pal: string = string_trim(props::xget(st.xp, "font-palette"))
    let falt: string = if alt == "" || string_lower(alt) == "normal" then "" else alt_features(alt, st.font_family, sheet)
    let fpal: string = palette_spec(pal, st.font_family, sheet)
    if falt == "" && fpal == "" is return st end
    let mut s2: style::ComputedStyle = style::copy_style(st)
    if falt != "" is s2.xp = props::xset(s2.xp, "-silver-falt", falt) end
    if fpal != "" is s2.xp = props::xset(s2.xp, "-silver-fpal", fpal) end
    return s2
end

;; Przedrostek tekstu dla shimu ("" gdy żadna z trzech właściwości nie ma tu efektu). Trzeba go dodać do KAŻDEGO
;; pomiaru i rysowania tego samego tekstu; shim odcina go, gdy nie ma biblioteki kształtowania.
pub fn shape_prefix(st: style::ComputedStyle) -> string is
    if st.xp == "" is return "" end
    if string_find(st.xp, "-silver-f") < 0 && string_find(st.xp, "font-language-override") < 0 && string_find(st.xp, "font-optical-sizing") < 0 is return "" end
    let mut lang: string = string_trim(string_replace(string_replace(props::xget(st.xp, "font-language-override"), "\"", ""), "'", ""))
    if string_lower(lang) == "normal" is lang = "" end
    let falt: string = props::xget(st.xp, "-silver-falt")
    let fpal: string = props::xget(st.xp, "-silver-fpal")
    let opt: string = if string_lower(string_trim(props::xget(st.xp, "font-optical-sizing"))) == "none" then "none" else ""
    if lang == "" && falt == "" && fpal == "" && opt == "" is return "" end
    let mut feats: string = falt
    let ffs: string = string_trim(props::xget(st.xp, "font-feature-settings"))
    if ffs != "" && string_lower(ffs) != "normal" is feats = join_comma(feats, ffs) end
    let pp: [string] = string_split(fpal, "|")
    let sel: string = if array_len(pp) > 0 then pp[0] else ""
    let ovr: string = if array_len(pp) > 1 then pp[1] else ""
    let payload: string = feats + "|" + lang + "|" + sel + "|" + ovr + "|" + opt
    return "\u0002" + string_replace(string_replace(string_replace(payload, "\u0002", " "), "\u0003", " "), "\n", " ") + "\u0003"
end

pub fn style_flags(st: style::ComputedStyle) -> int is
    let mut f: int = 0
    if st.bold is f += 1 end
    if st.italic is f += 2 end
    if st.underline is f += 4 end
    if st.strike is f += 8 end
    ;; 0.4: font-kerning: none / text-rendering: optimizeSpeed → bez kerningu (16); geometricPrecision → bez hintingu (32)
    let tr: string = string_lower(props::xget(st.xp, "text-rendering"))
    if string_lower(props::xget(st.xp, "font-kerning")) == "none" || tr == "optimizespeed" || typo::feat(st.xp, "kern") == 0 is f += 16 end
    if tr == "geometricprecision" is f += 32 end
    ;; font-synthesis: weight/style none → bez syntetycznego pogrubienia (64) / pochylenia (128)
    if !synth_allowed(st, "weight") is f += 64 end
    if !synth_allowed(st, "style") is f += 128 end
    ;; 0.4: cyfry tabelaryczne (256) i font-stretch / "wdth" jako skalowanie poziome w krokach 5% (bity 9..15)
    if typo::tabular(st.xp) is f += 256 end
    let sp: int = typo::stretch_pct(st.xp)
    if sp != 100 is f += (sp / 5) * 512 end
    ;; text-spacing-trim: normal (domyślnie) przycina odstępy między sąsiednią interpunkcją CJK (32768)
    let tst: string = string_lower(string_trim(props::xget(st.xp, "text-spacing-trim")))
    if tst == "" || tst == "normal" is f += 32768 end
    return f + st.font_key * 65536
end

;; Tekst do pomiaru i rysowania: text-transform (z kapitalikami), cechy typograficzne (typo.h#), bidi-override.
pub fn shaped_text(text: string, st: style::ComputedStyle) -> string is
    let t0: string = apply_transform(text, eff_transform(st))
    if st.xp == "" is return t0 end
    let t1: string = typo::shape(t0, st.xp)
    if typo::bidi_override_on(st.xp, st.direction) is return typo::reverse_words(t1) end
    if upright_mode(st.xp) is return stack_chars(t1, combine_limit(st.xp)) end
    return t1
end

pub fn est_text_width(text: string, font_size: int) -> int is
    return string_len(text) * font_size * 58 / 100
end

fn text_w(cx: LayoutCtx, text: string, st: style::ComputedStyle) -> int is
    let base: int = text_w0(cx, text, st)
    if st.letter_spacing == 0 || text == "" is return base end
    return base + st.letter_spacing * ffi_shim::silver_utf8_len(text)
end

fn text_w0(cx: LayoutCtx, text: string, st: style::ComputedStyle) -> int is
    if text == "" is return 0 end
    if cx.win < 0 is
        let chars: int = ffi_shim::silver_utf8_len(text)
        return (if st.bold then chars * st.font_size * 62 / 100 else chars * st.font_size * 58 / 100)
    end
    let w: int = ffi_shim::silver_measure_text_ex(cx.win, shape_prefix(st) + text, st.font_size, style_flags(st))
    if w <= 0 is return est_text_width(text, st.font_size) end
    return w
end

fn space_w(cx: LayoutCtx, st: style::ComputedStyle) -> int is
    return space_w0(cx, st) + st.word_spacing + st.letter_spacing
end

fn space_w0(cx: LayoutCtx, st: style::ComputedStyle) -> int is
    if cx.win < 0 is return st.font_size * 3 / 10 + 1 end
    let sp: string = shape_prefix(st)
    let w: int = ffi_shim::silver_measure_text_ex(cx.win, sp + "a a", st.font_size, style_flags(st)) -
                 ffi_shim::silver_measure_text_ex(cx.win, sp + "aa", st.font_size, style_flags(st))
    if w <= 0 is return st.font_size / 3 end
    return w
end

fn apply_transform(text: string, mode: string) -> string is
    if mode == "uppercase" is return string_upper(text) end
    if mode == "lowercase" is return string_lower(text) end
    if mode == "capitalize" is
        let words: [string] = string_split(text, " ")
        let mut out: string = ""
        let mut i: int = 0
        while i < array_len(words) is
            let w: string = words[i]
            let cap: string = if w == "" then "" else string_upper(string_slice(w, 0, 1)) + string_slice(w, 1, string_len(w))
            out = if i == 0 then cap else out + " " + cap
            i += 1
        end
        return out
    end
    return text
end

;; Dzieli zbyt długie słowo na kawałki mieszczące się w `max_w`.
fn break_word(cx: LayoutCtx, text: string, st: style::ComputedStyle, max_w: int) -> [string] is
    let mut parts: [string] = []
    let mut rest: string = text
    let mut guard: int = 0
    while string_len(rest) > 0 && guard < 400 is
        guard += 1
        let mut cut: int = 0
        if cx.win >= 0 is
            cut = ffi_shim::silver_text_fit(cx.win, shape_prefix(st) + rest, st.font_size, style_flags(st), max_w)
        else is
            let denom: int = if st.font_size * 58 > 0 then st.font_size * 58 else 1
            cut = ffi_shim::silver_utf8_offset(rest, max_w * 100 / denom)
        end
        if cut <= 0 is cut = ffi_shim::silver_utf8_next(rest, 0) end
        parts = array_push(parts, string_slice(rest, 0, cut))
        rest = string_slice(rest, cut, string_len(rest))
    end
    return parts
end


;; ---------- ruby-overhang ----------
;; szerokość tekstu elementu <ruby>: podstawy (want_rt = false) albo adnotacji <rt> (want_rt = true); przybliżenie przy braku okna
fn ruby_part_w(d: dom::Dom, styles: [style::ComputedStyle], id: int, win: int, want_rt: bool) -> int is
    let mut w: int = 0
    let kids: [int] = d.nodes[id].children
    let mut k: int = 0
    while k < array_len(kids) is
        let c: int = kids[k]
        k += 1
        if c < 0 || c >= array_len(d.nodes) || d.nodes[c].removed is continue end
        let tg: string = d.nodes[c].tag
        if tg == "rp" is continue end
        let is_rt: bool = tg == "rt"
        if tg == "text" && !want_rt is
            let st: style::ComputedStyle = styles[id]
            let t: string = string_trim(d.nodes[c].text)
            if win < 0 is w = w + ffi_shim::silver_utf8_len(t) * st.font_size * 58 / 100
            else is w = w + ffi_shim::silver_measure_text_ex(win, t, st.font_size, style_flags(st)) end
        elsif is_rt && want_rt is
            let sub: [int] = d.nodes[c].children
            let st2: style::ComputedStyle = styles[c]
            let mut j: int = 0
            while j < array_len(sub) is
                if sub[j] >= 0 && sub[j] < array_len(d.nodes) && d.nodes[sub[j]].tag == "text" is
                    let t2: string = string_trim(d.nodes[sub[j]].text)
                    if win < 0 is w = w + ffi_shim::silver_utf8_len(t2) * st2.font_size * 58 / 100
                    else is w = w + ffi_shim::silver_measure_text_ex(win, t2, st2.font_size, style_flags(st2)) end
                end
                j += 1
            end
        end
    end
    return w
end

;; ruby-overhang: auto | start | end | none — adnotacja szersza od podstawy może wystawać nad sąsiedni tekst
;; (ujemne marginesy elementu <ruby>, najwyżej pół rozmiaru pisma adnotacji z każdej strony). Wartość domyślna (brak deklaracji) = none.
fn ruby_overhang_margins(d: dom::Dom, styles: [style::ComputedStyle], id: int, win: int, mode: string) -> [int] is
    if mode != "auto" && mode != "start" && mode != "end" is return [0, 0] end
    let bw: int = ruby_part_w(d, styles, id, win, false)
    let rw: int = ruby_part_w(d, styles, id, win, true)
    if rw <= bw is return [0, 0] end
    let mut rt_fs: int = 8
    let kids: [int] = d.nodes[id].children
    let mut k: int = 0
    while k < array_len(kids) is
        if kids[k] >= 0 && kids[k] < array_len(d.nodes) && d.nodes[kids[k]].tag == "rt" is rt_fs = styles[kids[k]].font_size end
        k += 1
    end
    let mut o: int = (rw - bw) / 2
    if o > rt_fs / 2 is o = rt_fs / 2 end
    return [if mode == "end" then 0 else o, if mode == "start" then 0 else o]
end


;; ---------- ruby-merge / ruby z wieloma parami podstawa–adnotacja ----------
pub fn html_esc_text(t: string) -> string is
    let mut o: string = string_replace(t, "&", "&amp;")
    o = string_replace(o, "<", "&lt;")
    return string_replace(o, ">", "&gt;")
end

fn ruby_rt_count(d: dom::Dom, id: int) -> int is
    let mut n: int = 0
    let kids: [int] = d.nodes[id].children
    let mut k: int = 0
    while k < array_len(kids) is
        if kids[k] >= 0 && kids[k] < array_len(d.nodes) && !d.nodes[kids[k]].removed && d.nodes[kids[k]].tag == "rt" is n += 1 end
        k += 1
    end
    return n
end

;; <ruby>漢<rt>kan</rt>字<rt>ji</rt></ruby>: separate (domyślnie) — każda para w osobnej kolumnie ruby (zewnętrzny element staje się
;; zwykłym inline); collapse — adnotacje scalone w jedną nad połączonymi podstawami. Dotyczy tylko ruby z co najmniej dwiema <rt>.
fn ruby_pairs(d0: dom::Dom, sheet: css::Stylesheet, ix: css::InteractionState, act: anim::AnimCtx) -> dom::Dom is
    let mut cand: [int] = []
    let mut i: int = 1
    while i < array_len(d0.nodes) is
        if !d0.nodes[i].removed && d0.nodes[i].tag == "ruby" && ruby_rt_count(d0, i) >= 2 is cand = array_push(cand, i) end
        i += 1
    end
    if array_len(cand) == 0 is return d0 end
    let st0: [style::ComputedStyle] = compute_styles_a(d0, sheet, ix, act)
    let mut d: dom::Dom = dom::deep_copy(d0)
    let mut c: int = 0
    while c < array_len(cand) is
        let r: int = cand[c]
        c += 1
        let collapse: bool = string_lower(string_trim(props::xget(st0[r].xp, "ruby-merge"))) == "collapse"
        let mut bases: [string] = []
        let mut rts: [string] = []
        let mut cur: string = ""
        let kids: [int] = d0.nodes[r].children
        let mut k: int = 0
        while k < array_len(kids) is
            let kid: int = kids[k]
            k += 1
            if kid < 0 || kid >= array_len(d0.nodes) || d0.nodes[kid].removed is continue end
            let tg: string = d0.nodes[kid].tag
            if tg == "text" is cur = cur + d0.nodes[kid].text
            elsif tg == "rt" is
                bases = array_push(bases, cur)
                rts = array_push(rts, dom::text_content(d0, kid))
                cur = ""
            elsif tg != "rp" && tg != "rtc" is cur = cur + dom::text_content(d0, kid) end
        end
        if string_len(string_trim(cur)) > 0 is
            bases = array_push(bases, cur)
            rts = array_push(rts, "")
        end
        let mut html: string = ""
        if collapse is
            let mut bj: string = ""
            let mut rj: string = ""
            let mut g: int = 0
            while g < array_len(bases) is
                bj = bj + bases[g]
                rj = rj + rts[g]
                g += 1
            end
            html = html_esc_text(bj) + "<rt>" + html_esc_text(rj) + "</rt>"
        else is
            let mut g: int = 0
            while g < array_len(bases) is
                let mut part: string = "<ruby>" + html_esc_text(bases[g])
                if rts[g] != "" is part = part + "<rt>" + html_esc_text(rts[g]) + "</rt>" end
                html = html + part + "</ruby>"
                g += 1
            end
            d.nodes[r].tag = "span"
        end
        d = dom::set_inner_html(d, r, html)
    end
    return d
end

;; ---------- style (liczone raz) ----------
fn is_live(d: dom::Dom, id: int) -> bool is
    return id >= 0 && id < array_len(d.nodes) && !d.nodes[id].removed
end

;; Styl każdego węzła (indeks = id węzła), dziedziczenie od rodzica.
;; 0.4: animacje sterowane przewijaniem mają `animation-duration: auto` → czas wirtualny 1000 ms (postęp = pozycja na osi)
pub fn apply_timeline_defaults(st0: style::ComputedStyle) -> style::ComputedStyle is
    let mut st: style::ComputedStyle = style::copy_style(st0)
    if st.anim_name != "" && st.anim_ms <= 0 is
        let tv: string = string_lower(string_trim(props::xget(st.xp, "animation-timeline")))
        if tv != "" && tv != "auto" && tv != "none" is st.anim_ms = 1000 end
    end
    return st
end

;; 0.4: color-scheme — użyty schemat: "dark" | "light" | "" (normal). `light dark` wybiera wg preferencji systemu (dark_pref).
pub fn used_scheme(st: style::ComputedStyle, dark_pref: bool) -> string is
    let v: string = string_lower(props::xget(st.xp, "color-scheme"))
    if v == "" || v == "normal" is return "" end
    let has_dark: bool = trim_token(v, "dark")
    let has_light: bool = trim_token(v, "light")
    if has_dark && has_light is
        if dark_pref is return "dark" end
        return "light"
    end
    if has_dark is return "dark" end
    if has_light is return "light" end
    return ""
end

;; Tekst domyślny (CanvasText) w ciemnym schemacie: element, w którym zaczyna się `color-scheme: dark`, dostaje jasny kolor, jeśli odziedziczył czarny.
pub fn apply_scheme_defaults(st0: style::ComputedStyle, parent: style::ComputedStyle, dark_pref: bool) -> style::ComputedStyle is
    let mut st: style::ComputedStyle = style::copy_style(st0)
    if used_scheme(st, dark_pref) == "dark" && used_scheme(parent, dark_pref) != "dark" is
        let dflt: style::Color = style::root_style().color
        if st.color.r == dflt.r && st.color.g == dflt.g && st.color.b == dflt.b && st.color.a == dflt.a is
            st.color = style::Color { r: 232, g: 234, b: 237, a: 255 }
        end
    end
    return st
end

pub fn compute_styles(d: dom::Dom, sheet: css::Stylesheet, ix: css::InteractionState) -> [style::ComputedStyle] is
    return compute_styles_a(d, sheet, ix, anim::no_anim())
end

pub fn compute_styles_a(d: dom::Dom, sheet: css::Stylesheet, ix: css::InteractionState, act: anim::AnimCtx) -> [style::ComputedStyle] is
    let animating: bool = array_len(act.starts) > 0 || array_len(act.t_ids) > 0
    let n: int = array_len(d.nodes)
    let mut styles: [style::ComputedStyle] = []
    let mut i: int = 0
    while i < n is
        styles = array_push(styles, style::root_style())
        i += 1
    end
    if n == 0 is return styles end
    let mut stack: [int] = [0]
    while array_len(stack) > 0 is
        let id: int = stack[array_len(stack) - 1]
        let mut ns: [int] = []
        let mut k: int = 0
        while k < array_len(stack) - 1 is
            ns = array_push(ns, stack[k])
            k += 1
        end
        stack = ns
        let node: dom::DomNode = d.nodes[id]
        if node.removed is continue end
        let parent_st: style::ComputedStyle = if node.parent >= 0 then styles[node.parent] else style::root_style()
        if id == 0 is
            styles[0] = style::root_style()
        elsif node.tag == "text" is
            styles[id] = style::text_style(parent_st)
            styles[id] = apply_font_variants(styles[id], sheet)
        else is
            styles[id] = style::resolve_ctx(sheet, d, id, parent_st, ix)
            styles[id] = apply_scheme_defaults(styles[id], parent_st, ix.dark)
            styles[id] = apply_timeline_defaults(styles[id])
            styles[id] = apply_font_variants(styles[id], sheet)
            if animating is styles[id] = anim::animate_style(sheet, styles[id], parent_st, act, id) end
        end
        let mut c: int = array_len(node.children) - 1
        while c >= 0 is
            stack = array_push(stack, node.children[c])
            c -= 1
        end
    end
    styles = apply_text_size_adjust(styles)
    if ix.forced is styles = apply_forced_colors(d, styles, ix.dark) end
    if ix.print is styles = apply_print_adjust(styles, ix.print_bg) end
    return styles
end

;; ============ 0.4: print-color-adjust ============
;; W druku `economy` (domyślnie) pozwala agentowi użytkownika pominąć tła (oszczędność tuszu) — wyłączona opcja „grafika tła”
;; gubi tła kolorowe, obrazy i gradienty elementów; `exact` je zachowuje (właściwość jest dziedziczona).
pub fn apply_print_adjust(styles: [style::ComputedStyle], backgrounds: bool) -> [style::ComputedStyle] is
    if backgrounds is return styles end
    let mut out: [style::ComputedStyle] = styles
    let mut i: int = 0
    while i < array_len(out) is
        let st: style::ComputedStyle = out[i]
        i += 1
        if !st.has_bg && st.bg_image == "" && !st.has_grad is continue end
        let mut v: string = string_lower(string_trim(props::xget(st.xp, "print-color-adjust")))
        if v == "" is v = string_lower(string_trim(props::xget(st.xp, "-webkit-print-color-adjust"))) end
        if v == "exact" is continue end
        let mut s2: style::ComputedStyle = style::copy_style(st)
        s2.has_bg = false
        s2.background = style::Color { r: 0, g: 0, b: 0, a: 0 }
        s2.bg_image = ""
        s2.has_grad = false
        out[i - 1] = s2
    end
    return out
end

;; ============ 0.4: text-size-adjust ============
;; `<procent>` mnoży rozmiar fontu każdego elementu (jak autoskalowanie tekstu w przeglądarkach mobilnych); `none`/`auto` —
;; bez zmian. Przebieg po całej kaskadzie, więc rozmiary względne potomków nie liczą się podwójnie.
fn tsa_percent1000(v0: string) -> int is
    let v: string = string_trim(string_lower(v0))
    if !string_ends_with(v, "%") is return 100000 end
    let num: string = string_trim(string_slice(v, 0, string_len(v) - 1))
    if !props::is_num(num) is return 100000 end
    let p: int = gfx::parse_x1000(num)
    if p <= 0 is return 100000 end
    return p
end

pub fn apply_text_size_adjust(styles: [style::ComputedStyle]) -> [style::ComputedStyle] is
    let mut out: [style::ComputedStyle] = styles
    let mut i: int = 0
    while i < array_len(out) is
        let st: style::ComputedStyle = out[i]
        i += 1
        if string_find(st.xp, "text-size-adjust") < 0 is continue end
        let p: int = tsa_percent1000(props::xget(st.xp, "text-size-adjust"))
        if p == 100000 is continue end
        let mut s2: style::ComputedStyle = style::copy_style(st)
        let fs: int = st.font_size * p / 100000
        s2.font_size = if fs < 1 then 1 else fs
        out[i - 1] = s2
    end
    return out
end

;; ============ 0.4: tryb wymuszonych kolorów + forced-color-adjust ============
;; Kolory autora zastępuje paleta systemowa (cssval::system_color): color, tło, ramki, obrys, dekoracja tekstu, wypełnienie
;; i obrys SVG; znikają cienie i tła-gradienty (tła `url()` zostają). `forced-color-adjust: none` zostawia kolory autora,
;; `preserve-parent-color` — jak none, ale `color` bierze od rodzica. Elementy formularzy dostają kolory kontrolek.
fn fc_ctl_kind(d: dom::Dom, id: int) -> string is
    let t: string = d.nodes[id].tag
    if t == "button" is return "button" end
    if t == "input" is
        let ty: string = string_lower(dom::get_attr(d.nodes[id], "type"))
        if ty == "button" || ty == "submit" || ty == "reset" is return "button" end
        return "field"
    end
    if t == "select" || t == "textarea" is return "field" end
    return ""
end

fn rgb_text(c: style::Color) -> string is
    return "rgb(" + to_string(c.r) + "," + to_string(c.g) + "," + to_string(c.b) + ")"
end

pub fn apply_forced_colors(d: dom::Dom, styles: [style::ComputedStyle], dark: bool) -> [style::ComputedStyle] is
    let mut out: [style::ComputedStyle] = styles
    let canvas: style::Color = style::parse_color_sys("canvas", dark)
    let ctext: style::Color = style::parse_color_sys("canvastext", dark)
    let link: style::Color = style::parse_color_sys("linktext", dark)
    let bface: style::Color = style::parse_color_sys("buttonface", dark)
    let btext: style::Color = style::parse_color_sys("buttontext", dark)
    let bborder: style::Color = style::parse_color_sys("buttonborder", dark)
    let field: style::Color = style::parse_color_sys("field", dark)
    let ftext: style::Color = style::parse_color_sys("fieldtext", dark)
    let mut id: int = 0
    while id < array_len(out) is
        let st: style::ComputedStyle = out[id]
        let node: dom::DomNode = d.nodes[id]
        id += 1
        if node.removed is continue end
        let fca: string = string_lower(string_trim(props::xget(st.xp, "forced-color-adjust")))
        let is_text: bool = node.tag == "text"
        let par: int = node.parent
        if fca == "none" is continue end
        let mut s2: style::ComputedStyle = style::copy_style(st)
        if fca == "preserve-parent-color" is
            if par >= 0 is s2.color = style::copy_color(out[par].color) end
            out[id - 1] = s2
            continue
        end
        let kind: string = if is_text then "" else fc_ctl_kind(d, id - 1)
        let is_link: bool = node.tag == "a" && dom::get_attr(node, "href") != ""
        if is_text && par >= 0 is
            s2.color = style::copy_color(out[par].color)
        elsif kind == "button" is
            s2.color = style::copy_color(btext)
        elsif kind == "field" is
            s2.color = style::copy_color(ftext)
        elsif is_link is
            s2.color = style::copy_color(link)
        else is
            s2.color = style::copy_color(ctext)
        end
        let bg_col: style::Color = if kind == "button" then bface elsif kind == "field" then field else canvas
        let bd_col: style::Color = if kind == "" then ctext else bborder
        if st.background.a > 0 is s2.background = style::copy_color(bg_col) end
        if string_find(st.bg_image, "gradient") >= 0 is s2.bg_image = "" end
        s2.border_color = style::copy_color(bd_col)
        s2.bct = style::copy_color(bd_col)
        s2.bcr = style::copy_color(bd_col)
        s2.bcb = style::copy_color(bd_col)
        s2.bcl = style::copy_color(bd_col)
        s2.outline_color = style::copy_color(ctext)
        if st.has_deco_color is s2.deco_color = style::copy_color(s2.color) end
        s2.has_shadow = false
        s2.has_tshadow = false
        if st.has_accent is s2.accent = style::copy_color(link) end
        let fill: string = props::xget(st.xp, "fill")
        if fill != "" && string_lower(fill) != "none" is s2.xp = props::xset(s2.xp, "fill", rgb_text(ctext)) end
        let stroke: string = props::xget(st.xp, "stroke")
        if stroke != "" && string_lower(stroke) != "none" is s2.xp = props::xset(s2.xp, "stroke", rgb_text(ctext)) end
        out[id - 1] = s2
    end
    return out
end

fn style_of(cx: LayoutCtx, id: int) -> style::ComputedStyle is
    return cx.styles[id]
end

fn is_replaced(tag: string) -> bool is
    return tag == "img" || tag == "svg" || tag == "input" || tag == "textarea" || tag == "select"
end

fn is_out_of_flow(st: style::ComputedStyle) -> bool is
    return st.position == "absolute" || st.position == "fixed"
end

fn is_inline_level(cx: LayoutCtx, id: int) -> bool is
    let n: dom::DomNode = cx.dom.nodes[id]
    if n.removed is return false end
    if n.tag == "text" is return n.text != "" end
    let st: style::ComputedStyle = cx.styles[id]
    if st.display == "none" || is_out_of_flow(st) is return false end
    if st.float_side != "none" is return false end
    return st.display == "inline" || st.display == "inline-block" || st.display == "inline-flex"
end

fn is_rendered(cx: LayoutCtx, id: int) -> bool is
    let n: dom::DomNode = cx.dom.nodes[id]
    if n.removed is return false end
    if n.tag == "text" is return n.text != "" end
    return cx.styles[id].display != "none"
end

fn is_decorated(st: style::ComputedStyle) -> bool is
    return st.has_bg || st.has_grad || st.bt > 0 || st.br > 0 || st.bb > 0 || st.bl > 0 || st.bg_image != ""
end

fn collapse_margin(a: int, b: int) -> int is
    if a >= 0 && b >= 0 is
        if a > b is return a end
        return b
    end
    if a < 0 && b < 0 is
        if a < b is return a end
        return b
    end
    return a + b
end

fn m_or_zero(v: int) -> int is
    if v == auto_v() is return 0 end
    return v
end

fn clamp_int(v: int, lo: int, hi: int) -> int is
    if hi >= 0 && v > hi is return hi end
    if v < lo is return lo end
    return v
end

;; Domyślny rozmiar elementów zastępczych (obrazek bez wymiarów, pola formularza).
fn input_kind(n: dom::DomNode) -> string is
    let t: string = string_lower(n.attr_type)
    if t == "checkbox" || t == "radio" is return t end
    if t == "button" || t == "submit" || t == "reset" is return "button" end
    if t == "hidden" is return "hidden" end
    return "text"
end

fn replaced_natural(cx: LayoutCtx, id: int) -> style::BoxSides is
    ;; zwraca (w=right, h=bottom) naturalnego rozmiaru zawartości (bez padding/border)
    let n: dom::DomNode = cx.dom.nodes[id]
    let st: style::ComputedStyle = cx.styles[id]
    if n.tag == "svg" is
        let ns: [int] = svg::natural_size(n)
        return style::BoxSides { top: 0, right: ns[0], bottom: ns[1], left: 0 }
    end
    if n.tag == "img" is
        let mut nw: int = 0
        let mut nh: int = 0
        if cx.win >= 0 && n.attr_src != "" is
            nw = ffi_shim::silver_image_width(cx.win, n.attr_src)
            nh = ffi_shim::silver_image_height(cx.win, n.attr_src)
        end
        if nw <= 0 is nw = 100 end
        if nh <= 0 is nh = 100 end
        ;; 0.4: image-resolution — gęstość obrazka (np. 2x, 192dpi) zmniejsza rozmiar naturalny
        let res1000: int = image_resolution_x1000(st)
        if res1000 > 0 && res1000 != 1000 is
            nw = (nw * 1000 + res1000 / 2) / res1000
            nh = (nh * 1000 + res1000 / 2) / res1000
            if nw < 1 is nw = 1 end
            if nh < 1 is nh = 1 end
        end
        return style::BoxSides { top: 0, right: nw, bottom: nh, left: 0 }
    end
    let lh: int = line_h_of(st)
    ;; 0.4: field-sizing: content — pole rośnie z zawartością (wartość, a gdy pusta: placeholder)
    let fs_content: bool = string_lower(string_trim(props::xget(st.xp, "field-sizing"))) == "content"
    if fs_content && n.tag == "textarea" is
        let mut txt: string = dom::text_content(cx.dom, n.id)
        if txt == "" is txt = n.attr_placeholder end
        let lines: [string] = string_split(txt, "\n")
        let mut bw: int = 0
        let mut li: int = 0
        while li < array_len(lines) is
            let lw: int = text_w(cx, lines[li], st)
            if lw > bw is bw = lw end
            li += 1
        end
        let nl: int = if array_len(lines) < 1 then 1 else array_len(lines)
        return style::BoxSides { top: 0, right: bw + 2, bottom: lh * nl, left: 0 }
    end
    if fs_content && n.tag == "input" && input_kind(n) == "text" is
        let v: string = if n.attr_value != "" then n.attr_value else n.attr_placeholder
        return style::BoxSides { top: 0, right: text_w(cx, v, st) + 2, bottom: lh, left: 0 }
    end
    if n.tag == "textarea" is
        return style::BoxSides { top: 0, right: 220, bottom: lh * 4, left: 0 }
    end
    if n.tag == "select" is
        let mut best: int = 80
        let mut i: int = 0
        while i < array_len(n.children) is
            let c: dom::DomNode = cx.dom.nodes[n.children[i]]
            if c.tag == "option" is
                let t: string = dom::text_content(cx.dom, c.id)
                let w: int = text_w(cx, t, st) + 24
                if w > best is best = w end
            end
            i += 1
        end
        return style::BoxSides { top: 0, right: best, bottom: lh, left: 0 }
    end
    let kind: string = input_kind(n)
    if kind == "checkbox" || kind == "radio" is
        return style::BoxSides { top: 0, right: 16, bottom: 16, left: 0 }
    end
    if kind == "button" is
        let label: string = if n.attr_value != "" then n.attr_value else "OK"
        return style::BoxSides { top: 0, right: text_w(cx, label, st), bottom: lh, left: 0 }
    end
    return style::BoxSides { top: 0, right: 170, bottom: lh, left: 0 }
end

;; ---------- szerokość max-content (shrink-to-fit) ----------
fn text_max_width(cx: LayoutCtx, text: string, st: style::ComputedStyle) -> int is
    let t: string = shaped_text(text, st)
    if st.white_space == "pre" || st.white_space == "pre-wrap" is
        let lines: [string] = string_split(t, "\n")
        let mut best: int = 0
        let mut i: int = 0
        while i < array_len(lines) is
            let w: int = text_w(cx, lines[i], st)
            if w > best is best = w end
            i += 1
        end
        return best
    end
    return text_w(cx, t, st)
end

fn pad_border_h(st: style::ComputedStyle) -> int is
    return st.pad_left + st.pad_right + st.bl + st.br
end

fn pad_border_v(st: style::ComputedStyle) -> int is
    return st.pad_top + st.pad_bottom + st.bt + st.bb
end

;; Szerokość ramki (border-box) elementu przy nieskończonej dostępnej szerokości.
fn max_content(cx: LayoutCtx, id: int, depth: int) -> int is
    let n: dom::DomNode = cx.dom.nodes[id]
    if n.removed is return 0 end
    if n.tag == "text" is return text_max_width(cx, n.text, cx.styles[id]) end
    let st: style::ComputedStyle = cx.styles[id]
    if st.display == "none" || is_out_of_flow(st) is return 0 end
    if depth > 40 is return 0 end
    let own: int = pad_border_h(st)
    if st.width_mode == "px" is
        return if st.border_box then st.width else st.width + own
    end
    if st.display == "table" is return table_max_content(cx, id) end
    if is_replaced(n.tag) is
        let nat: style::BoxSides = replaced_natural(cx, id)
        let mut w: int = nat.right
        if (n.tag == "img" || n.tag == "svg") && st.height_mode == "px" && nat.bottom > 0 is w = st.height * nat.right / nat.bottom end
        return w + own
    end
    let kids: [int] = n.children
    let nk: int = array_len(kids)
    let is_flex: bool = st.display == "flex" || st.display == "inline-flex"
    let row: bool = st.flex_dir == "row" || st.flex_dir == "row-reverse"
    let mut best: int = 0
    let mut run: int = 0
    let mut count: int = 0
    let mut i: int = 0
    while i < nk is
        let cid: int = kids[i]
        i += 1
        if !is_rendered(cx, cid) is continue end
        let cst: style::ComputedStyle = cx.styles[cid]
        if cx.dom.nodes[cid].tag != "text" && is_out_of_flow(cst) is continue end
        let cw: int = max_content(cx, cid, depth + 1) + (if cx.dom.nodes[cid].tag == "text" then 0 else m_or_zero(cst.mar_left) + m_or_zero(cst.mar_right))
        count += 1
        if is_flex && row is
            run = run + cw
        elsif is_inline_level(cx, cid) && !is_flex is
            run = run + cw + (if run > 0 && !cx.dom.nodes[cid].glue then space_w(cx, st) else 0)
        else is
            if run > best is best = run end
            run = 0
            if cw > best is best = cw end
        end
    end
    if run > best is best = run end
    if is_flex && row && count > 1 is best = best + st.gap * (count - 1) end
    if st.display == "grid" && st.grid_cols != "" is
        let cols: int = array_len(cssval::split_top(st.grid_cols))
        if cols > 1 && count > 0 is best = best * (if cols < count then cols else count) end
    end
    return best + own
end

;; ---------- inline: atomy i łamanie wierszy ----------
fn new_atom(kind: string, owner: int) -> Atom is
    return Atom { kind: kind, text: "", w: 0, h: 0, owner: owner, deco: -1, sp: false, sw: 0, frag: [] }
end

fn nowrap_of(st: style::ComputedStyle) -> bool is
    return st.white_space == "nowrap" || st.white_space == "pre"
end

;; ---------- hyphens (0.4): miękki łącznik U+00AD, `hyphens: auto` (heurystyka sylab) ----------
;; hyphenate-limit-chars: "<min słowo> [<przed> [<po>]]" (auto = domyślne 7/3/3 — w CSS 5/2/2; Silver zachowuje 0.4: 7/3/3)
pub fn hyph_limits(st: style::ComputedStyle) -> [int] is
    let v: string = string_lower(props::xget(st.xp, "hyphenate-limit-chars"))
    let t: [string] = cssval::split_top(v)
    let mut w: int = 7
    let mut b: int = 3
    let mut a: int = 3
    if array_len(t) >= 1 && t[0] != "auto" is w = str_to_int(t[0]) end
    if array_len(t) >= 2 && t[1] != "auto" is b = str_to_int(t[1]) end
    if array_len(t) >= 3 && t[2] != "auto" is a = str_to_int(t[2]) elsif array_len(t) == 2 && t[1] != "auto" is a = b end
    if b < 1 is b = 1 end
    if a < 1 is a = 1 end
    return [w, b, a]
end

fn hyph_auto_for(st: style::ComputedStyle, word: string) -> string is
    let l: [int] = hyph_limits(st)
    return hyph_auto_lim(word, l[0], l[1], l[2])
end

;; hyphenate-character: znak doklejany na końcu wiersza ("auto" → "-")
pub fn hyph_char(st: style::ComputedStyle) -> string is
    let v: string = string_trim(props::xget(st.xp, "hyphenate-character"))
    if v == "" || string_lower(v) == "auto" is return "-" end
    if string_len(v) >= 2 && (string_starts_with(v, "\"") || string_starts_with(v, "'")) is return string_slice(v, 1, string_len(v) - 1) end
    return v
end

pub fn shy_strip(s: string) -> string is
    if string_find(s, "\u00AD") < 0 is return s end
    return string_replace(s, "\u00AD", "")
end

fn is_vowel_ch(c: string) -> bool is
    return string_find("aeiouyAEIOUYąęóĄĘÓ", c) >= 0
end

fn is_alpha_ch(c: string) -> bool is
    return (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || string_find("ąćęłńóśźżĄĆĘŁŃÓŚŹŻäöüßÄÖÜéèàçñ", c) >= 0
end

;; Wstawia U+00AD w miejscach dozwolonych dla `hyphens: auto` (V-CV oraz VC-CV, min. 3 znaki z każdej strony).
pub fn hyph_auto(word: string) -> string is
    return hyph_auto_lim(word, 7, 3, 3)
end

;; hyphenate-limit-chars: min. długość słowa, min. znaków przed i po myślniku
pub fn hyph_auto_lim(word: string, min_word: int, min_before: int, min_after: int) -> string is
    if string_find(word, "\u00AD") >= 0 is return word end
    let nch: int = ffi_shim::silver_utf8_len(word)
    if nch < min_word is return word end
    let mut chars: [string] = []
    let mut pos: int = 0
    while pos < string_len(word) is
        let nx: int = ffi_shim::silver_utf8_next(word, pos)
        chars = array_push(chars, string_slice(word, pos, nx))
        pos = nx
    end
    let mut i: int = 0
    while i < array_len(chars) is
        if !is_alpha_ch(chars[i]) is return word end
        i += 1
    end
    let mut out: string = ""
    i = 0
    while i < array_len(chars) is
        out = out + chars[i]
        let left: int = i + 1
        let right: int = array_len(chars) - left
        if left >= min_before && right >= min_after && i + 2 < array_len(chars) is
            let c0: bool = is_vowel_ch(chars[i])
            let c1: bool = is_vowel_ch(chars[i + 1])
            let c2: bool = is_vowel_ch(chars[i + 2])
            if c0 && !c1 && c2 is out = out + "\u00AD" end
            if !c0 && !c1 && i + 3 < array_len(chars) && is_vowel_ch(chars[i - 1]) && c2 is
                ;; samogłoska + spółgłoska | spółgłoska + samogłoska — dzielimy po pierwszej spółgłosce tylko gdy nie ma dwuznaku
                if !(chars[i] == "s" && chars[i + 1] == "z") && !(chars[i] == "c" && chars[i + 1] == "z") is out = out + "\u00AD" end
            end
        end
        i += 1
    end
    return out
end

;; Dzieli atom-słowo w ostatnim miękkim łączniku, który mieści się w `room` px (głowa dostaje "-"). "" gdy brak.
;; Zwraca "<głowa>\u0001<ogon>".
;; 0.4: hyphenate-limit-lines (maks. kolejnych wierszy zakończonych łącznikiem) i hyphenate-limit-zone (dzielenie tylko, gdy pusta przestrzeń
;; na końcu wiersza przekraczałaby strefę; długość lub % szerokości wiersza)
fn hyph_allowed(st: style::ComputedStyle, line_w: int, unfilled: int, run: int) -> bool is
    let ll: string = string_trim(props::xget(st.xp, "hyphenate-limit-lines"))
    if props::is_int(ll) && run >= str_to_int(ll) is return false end
    let zv: string = string_lower(string_trim(props::xget(st.xp, "hyphenate-limit-zone")))
    if zv != "" && zv != "0" && zv != "0px" is
        let mut zpx: int = 0
        if string_ends_with(zv, "%") && props::is_num(string_slice(zv, 0, string_len(zv) - 1)) is
            zpx = str_to_int(string_slice(zv, 0, string_len(zv) - 1)) * line_w / 100
        elsif props::is_len(zv) is
            zpx = len_px_of(zv, st)
        end
        if unfilled <= zpx is return false end
    end
    return true
end

fn hyph_split(cx: LayoutCtx, text: string, st: style::ComputedStyle, room: int) -> string is
    let mut best: string = ""
    let mut from: int = 0
    let n: int = string_len(text)
    while from < n is
        let q: int = string_find(string_slice(text, from, n), "\u00AD")
        if q < 0 is break end
        let at: int = from + q
        let head: string = string_slice(text, 0, at)
        let tail: string = string_slice(text, at + 2, n)
        if string_len(shy_strip(head)) > 0 && string_len(shy_strip(tail)) > 0 is
            let hc: string = hyph_char(st)
            let hw: int = text_w(cx, shy_strip(head) + hc, st)
            if hw <= room is best = head + hc + "\u0001" + tail end
        end
        from = at + 2
    end
    return best
end

;; tab-size: liczba kolumn (liczba całkowita) albo długość przeliczona na szerokość spacji.
fn tab_columns(st: style::ComputedStyle, space_px: int) -> int is
    let v: string = props::xget(st.xp, "tab-size")
    if v == "" is return (if st.tab_size < 1 then 8 else st.tab_size) end
    if props::is_len(v) && space_px > 0 is
        let px: int = len_px_of(v, st)
        let n: int = px / space_px
        return if n < 1 then 1 else n
    end
    return 8
end

;; Tabulatory → spacje do następnego znacznika tabulacji (liczone od początku wiersza).
pub fn expand_tabs(text: string, cols: int) -> string is
    let n: int = string_len(text)
    let mut out: string = ""
    let mut col: int = 0
    let mut i: int = 0
    while i < n is
        let c: string = string_at(text, i)
        i += 1
        if c == "\t" is
            let pad: int = cols - (col % cols)
            let mut k: int = 0
            while k < pad is
                out = out + " "
                k += 1
            end
            col += pad
        elsif c == "\n" is
            out = out + c
            col = 0
        else is
            out = out + c
            col += 1
        end
    end
    return out
end

;; Atomy z tekstu węzła tekstowego (słowa; "pre" → linie; nowrap → jeden atom).
fn text_atoms(cx: LayoutCtx, text_id: int, owner: int, deco: int, avail_w: int, out: [Atom]) -> [Atom] is
    let mut acc: [Atom] = out
    let n: dom::DomNode = cx.dom.nodes[text_id]
    let st: style::ComputedStyle = cx.styles[owner]
    let pre: bool = st.white_space == "pre" || st.white_space == "pre-wrap"
    let t0: string = shaped_text(n.text, st)
    let lh: int = line_h_of(st)
    let sw: int = space_w(cx, st)
    let t: string = if pre && string_find(t0, "\t") >= 0 then expand_tabs(t0, tab_columns(st, sw)) else t0
    if pre is
        let lines: [string] = string_split(t, "\n")
        let mut li: int = 0
        while li < array_len(lines) is
            if li > 0 is
                let mut br: Atom = new_atom("br", owner)
                br.h = lh
                acc = array_push(acc, br)
            end
            if lines[li] != "" is
                let mut a: Atom = new_atom("word", owner)
                a.text = lines[li]
                a.w = text_w(cx, lines[li], st)
                a.h = lh
                a.deco = deco
                acc = array_push(acc, a)
            end
            li += 1
        end
        return acc
    end
    if st.white_space == "nowrap" is
        let mut a: Atom = new_atom("word", owner)
        a.text = t
        a.w = text_w(cx, t, st)
        a.h = lh
        a.deco = deco
        a.sp = !n.glue && array_len(acc) > 0
        a.sw = sw
        acc = array_push(acc, a)
        return acc
    end
    let words: [string] = string_split(t, " ")
    let mut first: bool = true
    let mut wi: int = 0
    while wi < array_len(words) is
        let word0: string = words[wi]
        wi += 1
        if word0 == "" is continue end
        let word: string = if st.hyphens == "auto" then hyph_auto_for(st, word0) elsif st.hyphens == "none" then shy_strip(word0) else word0
        let ww: int = text_w(cx, shy_strip(word), st)
        let lead_sp: bool = if first then (!n.glue && array_len(acc) > 0) else true
        first = false
        let has_shy: bool = string_find(word, "\u00AD") >= 0
        ;; word-break: break-all — każdy znak to osobny atom (łamanie między dowolnymi literami); overflow-wrap: break-word | anywhere —
        ;; dzielenie dopiero gdy słowo nie mieści się w wierszu; domyślnie (normal) zbyt długie słowo wystaje poza pudełko
        if st.break_all && ww > 0 && !has_shy is
            let mut rest: string = shy_strip(word)
            let mut ci: int = 0
            while string_len(rest) > 0 is
                let nx: int = ffi_shim::silver_utf8_next(rest, 0)
                let ch: string = string_slice(rest, 0, if nx <= 0 then string_len(rest) else nx)
                rest = string_slice(rest, string_len(ch), string_len(rest))
                let mut a: Atom = new_atom("word", owner)
                a.text = ch
                a.w = text_w(cx, ch, st)
                a.h = lh
                a.deco = deco
                a.sp = if ci == 0 then lead_sp else false
                a.sw = sw
                acc = array_push(acc, a)
                ci += 1
            end
        elsif st.break_words && ww > avail_w && avail_w > 8 && !has_shy is
            let pieces: [string] = break_word(cx, shy_strip(word), st, avail_w)
            let mut pi: int = 0
            while pi < array_len(pieces) is
                let mut a: Atom = new_atom("word", owner)
                a.text = pieces[pi]
                a.w = text_w(cx, pieces[pi], st)
                a.h = lh
                a.deco = deco
                a.sp = if pi == 0 then lead_sp else false
                a.sw = sw
                acc = array_push(acc, a)
                pi += 1
            end
        else is
            let mut a: Atom = new_atom("word", owner)
            a.text = word
            a.w = ww
            a.h = lh
            a.deco = deco
            a.sp = lead_sp
            a.sw = sw
            acc = array_push(acc, a)
        end
    end
    return acc
end

;; Zbiera atomy z dzieci `ids` (rekurencyjnie dla elementów inline).
fn collect_atoms(cx: LayoutCtx, ids: [int], owner: int, deco: int, avail_w: int, out: [Atom], depth: int) -> [Atom] is
    let mut acc: [Atom] = out
    if depth > 60 is return acc end
    let mut i: int = 0
    let mut clear_mark: int = -1      ;; 0.4: white-space-trim: discard-after — spacja przed pierwszym atomem po elemencie znika
    while i < array_len(ids) is
        if clear_mark >= 0 && array_len(acc) > clear_mark is
            acc[clear_mark].sp = false
            clear_mark = -1
        end
        let id: int = ids[i]
        i += 1
        if !is_inline_level(cx, id) is continue end
        let n: dom::DomNode = cx.dom.nodes[id]
        if n.tag == "text" is
            acc = text_atoms(cx, id, owner, deco, avail_w, acc)
            continue
        end
        let st: style::ComputedStyle = cx.styles[id]
        if n.tag == "br" is
            let mut br: Atom = new_atom("br", owner)
            br.h = line_h_of(cx.styles[owner])
            acc = array_push(acc, br)
            continue
        end
        if st.display == "inline" && !is_replaced(n.tag) is
            let my_deco: int = if is_decorated(st) then id else deco
            let start_len: int = array_len(acc)
            let padl: int = st.pad_left + st.bl + m_or_zero(st.mar_left)
            let padr: int = st.pad_right + st.br + m_or_zero(st.mar_right)
            if padl > 0 is
                let mut o: Atom = new_atom("open", id)
                o.w = padl
                o.h = line_h_of(st)
                o.deco = my_deco
                o.sp = !n.glue && array_len(acc) > 0
                acc = array_push(acc, o)
            end
            let before: int = array_len(acc)
            acc = collect_atoms(cx, n.children, id, my_deco, avail_w, acc, depth + 1)
            if padl == 0 && array_len(acc) > before is
                acc[before].sp = acc[before].sp || (!n.glue && before > 0)
            end
            if padr > 0 is
                let mut c: Atom = new_atom("close", id)
                c.w = padr
                c.h = line_h_of(st)
                c.deco = my_deco
                acc = array_push(acc, c)
            end
            ;; 0.4: white-space-trim: discard-before | discard-after | discard-inner (zlane początkowe spacje wewnątrz i obie spacje zewnętrzne
            ;; nie są rozróżnialne przy padding-left = 0 — wtedy obie wartości czyszczą spację pierwszego atomu)
            let wst: string = string_lower(props::xget(st.xp, "white-space-trim"))
            if wst != "" && wst != "none" is
                if string_find(wst, "discard-before") >= 0 && array_len(acc) > start_len is acc[start_len].sp = false end
                if string_find(wst, "discard-inner") >= 0 is
                    let fi: int = if padl > 0 then start_len + 1 else start_len
                    if array_len(acc) > fi is acc[fi].sp = false end
                end
                if string_find(wst, "discard-after") >= 0 is clear_mark = array_len(acc) end
            end
            continue
        end
        ;; inline-block / element zastępczy / button: układamy jako blok „shrink-to-fit"
        let res: BlockRes = layout_block(cx, id, 0, 0, avail_w, -1, -1, true)
        let mut a: Atom = new_atom("box", id)
        a.w = res.w + res.ml + res.mr
        a.h = res.h + res.mt + res.mb
        a.deco = -1
        a.sp = !n.glue && array_len(acc) > 0
        a.sw = space_w(cx, cx.styles[owner])
        a.frag = res.boxes
        acc = array_push(acc, a)
    end
    if clear_mark >= 0 && array_len(acc) > clear_mark is acc[clear_mark].sp = false end
    return acc
end

;; Przesunięcie pionowe atomu wg vertical-align (względem wyśrodkowania w wierszu).
fn valign_y(st: style::ComputedStyle, line_h: int, atom_h: int) -> int is
    let centered: int = (line_h - atom_h) / 2
    if st.valign == "top" || st.valign == "text-top" is return 0 end
    if st.valign == "bottom" || st.valign == "text-bottom" is return line_h - atom_h end
    if st.valign == "super" is return centered - st.font_size / 3 end
    if st.valign == "sub" is return centered + st.font_size / 4 end
    if st.valign_px != 0 is return centered - st.valign_px end
    return centered
end

;; 0.4: `baseline-source: first|last` — linia bazowa elementu inline-level pochodzi z pierwszego albo ostatniego
;; wiersza tekstu w jego wnętrzu (środek tego wiersza trafia na środek wiersza zewnętrznego). `auto` i brak tekstu:
;; dotychczasowe wyśrodkowanie. Działa tylko przy `vertical-align: baseline`.
fn atom_y(st: style::ComputedStyle, frag: [LayoutBox], line_h: int, atom_h: int) -> int is
    let src: string = string_lower(props::xget(st.xp, "baseline-source"))
    if (src == "first" || src == "last") && st.valign == "baseline" && st.valign_px == 0 is
        let mut best: int = -1
        let mut i: int = 0
        while i < array_len(frag) is
            if frag[i].kind == "text" is
                if best < 0 is best = i
                elsif src == "first" && frag[i].y < frag[best].y is best = i
                elsif src == "last" && frag[i].y > frag[best].y is best = i end
            end
            i += 1
        end
        if best >= 0 is return line_h / 2 - (frag[best].y + frag[best].h / 2) end
    end
    return valign_y(st, line_h, atom_h)
end

;; Efektywne wyrównanie: "<akapit>|<ostatni wiersz>|<l|r>" (start/end zależne od `direction`).
fn resolve_align(a: string, rtl: bool) -> string is
    if a == "start" || a == "match-parent" || a == "" is
        if rtl is return "right" end
        return "left"
    end
    if a == "end" is
        if rtl is return "left" end
        return "right"
    end
    if a == "justify-all" is return "justify" end
    return a
end

pub fn align_spec(st: style::ComputedStyle) -> string is
    let rtl: bool = st.direction == "rtl"
    let base: string = resolve_align(st.text_align, rtl)
    let last_raw: string = props::xget(st.xp, "text-align-last")
    let mut last: string = base
    if last_raw == "" || last_raw == "auto" is
        if base == "justify" is last = resolve_align("start", rtl) end
    else is
        last = resolve_align(last_raw, rtl)
    end
    let tag: string = if rtl then "r" else "l"
    return base + "|" + last + "|" + tag
end

fn align_dx(text_align: string, inner_w: int, used_w: int) -> int is
    if text_align == "center" is return (inner_w - used_w) / 2 end
    if text_align == "right" || text_align == "end" is return inner_w - used_w end
    return 0
end

;; Kończy wiersz: emituje boksy tekstu / dekoracji / fragmenty inline-block.
fn emit_line(cx: LayoutCtx, atoms: [Atom], idxs: [int], xs0: [int], line_y: int, inner_x: int, inner_w: int,
             text_align0: string, last_line: bool, boxes: [LayoutBox]) -> InlineRes is
    let spec: [string] = string_split(text_align0, "|")
    let text_align: string = if last_line && array_len(spec) >= 2 then spec[1] else spec[0]
    let rtl: bool = array_len(spec) >= 3 && spec[2] == "r"
    let mut xs: [int] = xs0
    let mut acc: [LayoutBox] = boxes
    let n: int = array_len(idxs)
    if n == 0 is return InlineRes { boxes: acc, height: 0, used_w: 0 } end

    let mut line_h: int = 0
    let mut right: int = 0
    let mut i: int = 0
    while i < n is
        let a: Atom = atoms[idxs[i]]
        if a.h > line_h is line_h = a.h end
        let end_x: int = xs[i] + a.w
        if end_x > right is right = end_x end
        i += 1
    end
    let first_x: int = xs[0] + (if atoms[idxs[0]].sp then 0 else 0)
    let mut used: int = right - first_x
    ;; 0.4: text-justify — none wyłącza justowanie, inter-character/distribute rozkłada miejsce między znaki
    let tj: string = string_lower(props::xget(cx.styles[atoms[idxs[0]].owner].xp, "text-justify"))
    let mut ls_add: int = 0
    let mut wadd: [int] = []
    let mut wz: int = 0
    while wz < n is
        wadd = array_push(wadd, 0)
        wz += 1
    end
    if text_align == "justify" && used < inner_w && (tj == "inter-character" || tj == "distribute") is
        let mut sum_chars: int = 0
        let mut cz: int = 0
        let mut cfirst: [int] = []
        while cz < n is
            cfirst = array_push(cfirst, sum_chars)
            if atoms[idxs[cz]].kind == "word" is sum_chars += ffi_shim::silver_utf8_len(shy_strip(atoms[idxs[cz]].text)) end
            cz += 1
        end
        let slots: int = sum_chars - 1
        if slots > 0 is
            let extra_c: int = inner_w - used
            ls_add = extra_c / slots
            let left_over: int = extra_c - ls_add * slots
            let mut gaps2: int = 0
            let mut g2: int = 1
            while g2 < n is
                if atoms[idxs[g2]].sp is gaps2 += 1 end
                g2 += 1
            end
            let mut seen2: int = 0
            g2 = 0
            while g2 < n is
                if g2 > 0 && atoms[idxs[g2]].sp is seen2 += 1 end
                let nch: int = if atoms[idxs[g2]].kind == "word" then ffi_shim::silver_utf8_len(shy_strip(atoms[idxs[g2]].text)) else 0
                xs[g2] = xs[g2] + cfirst[g2] * ls_add + (if gaps2 > 0 then left_over * seen2 / gaps2 else 0)
                wadd[g2] = nch * ls_add
                g2 += 1
            end
            used = inner_w
        end
    end
    if text_align == "justify" && used < inner_w && tj != "none" && tj != "inter-character" && tj != "distribute" is
        let mut gaps: int = 0
        let mut g: int = 1
        while g < n is
            if atoms[idxs[g]].sp is gaps += 1 end
            g += 1
        end
        if gaps > 0 is
            let extra: int = inner_w - used
            let mut seen: int = 0
            g = 1
            while g < n is
                if atoms[idxs[g]].sp is seen += 1 end
                xs[g] = xs[g] + extra * seen / gaps
                g += 1
            end
            used = inner_w
        end
    end
    ;; RTL: odbicie kolejności słów w wierszu (bez kształtowania pisma i bez bidi mieszanych przebiegów)
    if rtl && n > 1 is
        let span_end: int = first_x + used
        let mut g: int = 0
        while g < n is
            xs[g] = first_x + (span_end - (xs[g] + atoms[idxs[g]].w))
            g += 1
        end
    end
    let dx: int = align_dx(if text_align == "justify" then "left" else text_align, inner_w, used)
    let base_x: int = inner_x + dx

    ;; tła elementów inline (po jednym na deco w wierszu)
    let mut done: [int] = []
    i = 0
    while i < n is
        let a: Atom = atoms[idxs[i]]
        i += 1
        if a.deco < 0 is continue end
        let mut seen: bool = false
        let mut d: int = 0
        while d < array_len(done) is
            if done[d] == a.deco is seen = true end
            d += 1
        end
        if seen is continue end
        done = array_push(done, a.deco)
        let mut x0: int = 1000000
        let mut x1: int = -1000000
        let mut hh: int = 0
        let mut j: int = 0
        while j < n is
            let b: Atom = atoms[idxs[j]]
            if b.deco == a.deco is
                if xs[j] < x0 is x0 = xs[j] end
                if xs[j] + b.w > x1 is x1 = xs[j] + b.w end
                if b.h > hh is hh = b.h end
            end
            j += 1
        end
        let dst: style::ComputedStyle = cx.styles[a.deco]
        ;; 0.4: inline-sizing: stretch — tło/obrys elementu inline na wysokość całego wiersza (line-height), nie samej zawartości
        let bg_hh: int = if string_lower(string_trim(props::xget(dst.xp, "inline-sizing"))) == "stretch" && line_h > hh then line_h else hh
        let bg_h: int = bg_hh + dst.pad_top + dst.pad_bottom
        let bgx: int = base_x + x0 - xs[0] + xs[0]
        acc = array_push(acc, no_clip_box(a.deco, bgx, line_y + (line_h - bg_hh) / 2 - dst.pad_top, x1 - x0, bg_h, dst, "inlinebg"))
    end

    ;; teksty i boksy
    i = 0
    while i < n is
        let a: Atom = atoms[idxs[i]]
        if a.kind == "word" is
            let ost: style::ComputedStyle = cx.styles[a.owner]
            let mut text: string = a.text
            let mut end_x: int = xs[i] + a.w + wadd[i]
            let mut j: int = i + 1
            while j < n && atoms[idxs[j]].kind == "word" && atoms[idxs[j]].owner == a.owner is
                let nxt: Atom = atoms[idxs[j]]
                if nxt.sp is text = text + " " end
                text = text + nxt.text
                end_x = xs[j] + nxt.w + wadd[j]
                j += 1
            end
            let mut b: LayoutBox = no_clip_box(a.owner, base_x + xs[i], line_y + valign_y(ost, line_h, a.h), end_x - xs[i], a.h, ost, "text")
            b.text = shy_strip(text)
            if ls_add > 0 is
                b.st = style::copy_style(b.st)
                b.st.letter_spacing = b.st.letter_spacing + ls_add
            end
            acc = array_push(acc, b)
            i = j
            continue
        end
        if a.kind == "box" is
            let by: int = line_y + atom_y(cx.styles[a.owner], a.frag, line_h, a.h)
            acc = concat_boxes(acc, shift_boxes(a.frag, base_x + xs[i], by))
        end
        i += 1
    end
    return InlineRes { boxes: acc, height: line_h, used_w: used }
end


;; ---------- 0.4: hanging-punctuation ----------
fn first_char_of(s: string) -> string is
    if s == "" is return "" end
    let nx: int = ffi_shim::silver_utf8_next(s, 0)
    return string_slice(s, 0, if nx <= 0 then 1 else nx)
end

fn last_char_of(s: string) -> string is
    let n: int = string_len(s)
    let mut pos: int = 0
    let mut last: int = 0
    while pos < n is
        last = pos
        let nx: int = ffi_shim::silver_utf8_next(s, pos)
        pos = if nx <= pos then pos + 1 else nx
    end
    return string_slice(s, last, n)
end

pub fn hp_is_opening(c: string) -> bool is
    return string_find("\"'([{\u201c\u2018\u00ab\u2039\u201e\u201a\u300c\u300e\uff08\u3008\u300a", c) >= 0 && c != ""
end

pub fn hp_is_closing(c: string) -> bool is
    return string_find("\"')]}\u201d\u2019\u00bb\u203a\u300d\u300f\uff09\u3009\u300b", c) >= 0 && c != ""
end

pub fn hp_is_stop(c: string) -> bool is
    return string_find(".,\u060c\u06d4\u3002\u3001\uff0e\uff0c", c) >= 0 && c != ""
end

;; Zwraca [wysunięcie z lewej, wysunięcie z prawej] w px dla wiersza złożonego z atomów `idxs`.
fn hang_widths(cx: LayoutCtx, atoms: [Atom], idxs: [int], first_line: bool, last_line: bool) -> [int] is
    let n: int = array_len(idxs)
    if n == 0 is return [0, 0] end
    let a0: Atom = atoms[idxs[0]]
    let hp: string = string_lower(props::xget(cx.styles[a0.owner].xp, "hanging-punctuation"))
    if hp == "" || hp == "none" is return [0, 0] end
    let mut dl: int = 0
    let mut dr: int = 0
    if first_line && a0.kind == "word" && string_find(hp, "first") >= 0 is
        let c: string = first_char_of(shy_strip(a0.text))
        if hp_is_opening(c) is dl = text_w(cx, c, cx.styles[a0.owner]) end
    end
    let a1: Atom = atoms[idxs[n - 1]]
    if a1.kind == "word" is
        let c2: string = last_char_of(shy_strip(a1.text))
        let st1: style::ComputedStyle = cx.styles[a1.owner]
        if last_line && string_find(hp, "last") >= 0 && hp_is_closing(c2) is dr = text_w(cx, c2, st1) end
        if dr == 0 && string_find(hp, "force-end") >= 0 && hp_is_stop(c2) is dr = text_w(cx, c2, st1) end
        if dr == 0 && last_line && string_find(hp, "allow-end") >= 0 && hp_is_stop(c2) is dr = text_w(cx, c2, st1) end
    end
    return [dl, dr]
end

fn emit_line_h(cx: LayoutCtx, atoms: [Atom], idxs: [int], xs: [int], line_y: int, lb: [int],
               text_align: string, last_line: bool, first_line: bool, boxes: [LayoutBox]) -> InlineRes is
    let h: [int] = hang_widths(cx, atoms, idxs, first_line, last_line)
    return emit_line(cx, atoms, idxs, xs, line_y, lb[0] - h[0], lb[1] + h[0] + h[1], text_align, last_line, boxes)
end

;; ---------- float / BFC / zwijanie marginesów ----------
fn is_float(st: style::ComputedStyle) -> bool is
    return st.float_side != "none" && !is_out_of_flow(st) && st.display != "none"
end

;; ---------- 0.4: shape-outside ----------
fn concat_ints(a: [int], b: [int]) -> [int] is
    let mut out: [int] = a
    let mut i: int = 0
    while i < array_len(b) is
        out = array_push(out, b[i])
        i += 1
    end
    return out
end

;; Wpisy floatu: prostokąt (domyślnie) albo pasy kształtu z `shape-outside` (+ `shape-margin`).
fn float_records(cx: LayoutCtx, cst: style::ComputedStyle, res: BlockRes, to_right: bool, fx: int, py: int, tw: int, th: int) -> [int] is
    let side: int = if to_right then 1 else 0
    let sov: string = props::xget(cst.xp, "shape-outside")
    if sov != "" && string_find(string_lower(sov), "url(") >= 0 && cx.win >= 0 is
        ;; kształt z kanału alfa obrazu; pole odniesienia = margin-box (domyślnie) rozciągnięte obrazem
        let path: string = gfx::url_of(sov)
        let thr_raw: string = props::xget(cst.xp, "shape-image-threshold")
        let mut thr: f64 = 0.0
        if props::is_num(thr_raw) is thr = conv::str_to_float(thr_raw) end
        let m0: int = shape::len_px(props::xget(cst.xp, "shape-margin"), tw, cst.font_size)
        let mut nb: int = th / shape::step()
        if nb < 1 is nb = 1 end
        if nb > 200 is nb = 200 end
        let thr_pm: int = conv::float_to_int(thr * 1000.0)
        let mut bands: string = ""
        let mut bi: int = 0
        while bi < nb is
            let v: int = ffi_shim::silver_image_alpha_band(cx.win, path, nb, bi, thr_pm)
            bands = (if bi == 0 then "" else bands + " ") + (if v < 0 then "-1 -1" else to_string(v / 2048) + " " + to_string(v % 2048))
            bi += 1
        end
        let di: [int] = shape::build_image(bands, fx, py, tw, th, m0)
        if array_len(di) > 0 is return shape::records(di, side, fx, py, tw, th) end
    end
    if sov != "" && string_lower(string_trim(sov)) != "none" && shape::supported(sov) is
        let kw: string = shape::ref_box_kw(sov)
        let mut rx: int = fx
        let mut ry: int = py
        let mut rw: int = tw
        let mut rh: int = th
        if kw != "margin-box" is
            rx = fx + res.ml
            ry = py + res.mt
            rw = res.w
            rh = res.h
        end
        if kw == "padding-box" || kw == "content-box" is
            rx += cst.bl
            ry += cst.bt
            rw = rw - cst.bl - cst.br
            rh = rh - cst.bt - cst.bb
        end
        if kw == "content-box" is
            rx += cst.pad_left
            ry += cst.pad_top
            rw = rw - cst.pad_left - cst.pad_right
            rh = rh - cst.pad_top - cst.pad_bottom
        end
        let m: int = shape::len_px(props::xget(cst.xp, "shape-margin"), rw, cst.font_size)
        let d: [int] = shape::build(sov, rx, ry, rw, rh, m, cst.font_size)
        if array_len(d) > 0 is return shape::records(d, side, fx, py, tw, th) end
    end
    return [side, py, py + th, fx, fx + tw]
end

fn is_bfc_root(st: style::ComputedStyle) -> bool is
    if style::is_scroll_container(st) is return true end
    if st.display == "flex" || st.display == "inline-flex" || st.display == "grid" || st.display == "inline-block" ||
       st.display == "table" || st.display == "table-cell" || st.display == "flow-root" is return true end
    if st.float_side != "none" || is_out_of_flow(st) is return true end
    if contains_any(st, " layout paint strict content ") is return true end
    return false
end

;; Czy `contain` zawiera któreś ze słów z listy (spacjami).
fn contains_any(st: style::ComputedStyle, words: string) -> bool is
    let v: string = props::xget(st.xp, "contain")
    if v == "" || v == "none" is return false end
    let toks: [string] = cssval::split_top(string_lower(v))
    let mut i: int = 0
    while i < array_len(toks) is
        if string_find(words, " " + toks[i] + " ") >= 0 is return true end
        i += 1
    end
    return false
end

fn with_floats(cx: LayoutCtx, fls: [int]) -> LayoutCtx is
    return LayoutCtx { dom: cx.dom, styles: cx.styles, win: cx.win, vw: cx.vw, vh: cx.vh, scrolls: cx.scrolls, floats: fls, excl: cx.excl }
end

;; Granice poziome w pasie [y0, y1): [lewa, prawa, czy_kolizja(0/1)] we współrzędnych bezwzględnych.
;; Usuwa wpisy wykluczeń (strona 2 = lewa, 3 = prawa) — dla kontenera z `wrap-through: none`.
fn strip_exclusions(fls: [int]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i + 4 < array_len(fls) is
        if fls[i] < 2 is
            out = array_push(array_push(array_push(array_push(array_push(out, fls[i]), fls[i + 1]), fls[i + 2]), fls[i + 3]), fls[i + 4])
        end
        i += 5
    end
    return out
end

fn float_bounds(fls: [int], y0: int, y1: int, left_edge: int, right_edge: int) -> [int] is
    let mut l: int = left_edge
    let mut r: int = right_edge
    let mut hit: int = 0
    let mut i: int = 0
    while i + 4 < array_len(fls) is
        let top: int = fls[i + 1]
        let bot: int = fls[i + 2]
        if bot > y0 && top < (if y1 > y0 then y1 else y0 + 1) is
            if fls[i] == 0 || fls[i] == 2 is
                if fls[i + 4] > l is l = fls[i + 4] end
            else is
                if fls[i + 3] < r is r = fls[i + 3] end
            end
            hit = 1
        end
        i += 5
    end
    return [l, r, hit]
end

;; Najniższy dół floatów danej strony (0 = lewe, 1 = prawe, 2 = oba); -1000000 gdy brak.
fn float_bottom(fls: [int], side: int) -> int is
    let mut best: int = -1000000
    let mut i: int = 0
    while i + 4 < array_len(fls) is
        if (side == 2 || fls[i] == side) && fls[i + 2] > best is best = fls[i + 2] end
        i += 5
    end
    return best
end

;; Najmniejszy dół floatu większy od y (-1 gdy brak).
fn float_next_bottom(fls: [int], y: int) -> int is
    let mut best: int = -1
    let mut i: int = 0
    while i + 4 < array_len(fls) is
        let b: int = fls[i + 2]
        if b > y && (best < 0 || b < best) is best = b end
        i += 5
    end
    return best
end

fn clear_side_code(st: style::ComputedStyle) -> int is
    if st.clear_side == "left" is return 0 end
    if st.clear_side == "right" is return 1 end
    if st.clear_side == "both" is return 2 end
    return -1
end

;; Element blokowy w normalnym przepływie (kandydat do zwijania marginesów z dziećmi).
fn is_block_flow(cx: LayoutCtx, id: int) -> bool is
    if id <= 0 is return false end
    let n: dom::DomNode = cx.dom.nodes[id]
    if n.tag == "text" || is_replaced(n.tag) is return false end
    let st: style::ComputedStyle = cx.styles[id]
    if st.display != "block" && st.display != "list-item" is return false end
    if is_bfc_root(st) is return false end
    if n.parent >= 0 is
        let pd: string = cx.styles[n.parent].display
        if pd == "flex" || pd == "inline-flex" || pd == "grid" is return false end
    end
    return true
end

fn is_block_level_child(cx: LayoutCtx, cid: int) -> bool is
    if !is_rendered(cx, cid) is return false end
    if cx.dom.nodes[cid].tag == "text" is return false end
    let cst: style::ComputedStyle = cx.styles[cid]
    if is_out_of_flow(cst) || is_float(cst) is return false end
    return !is_inline_level(cx, cid)
end

;; Pierwsze dziecko blokowe w przepływie; -1, gdy treść zaczyna się od tekstu/inline albo brak dzieci.
fn first_flow_child(cx: LayoutCtx, id: int, from_end: bool) -> int is
    let kids: [int] = cx.dom.nodes[id].children
    let nk: int = array_len(kids)
    let mut i: int = 0
    while i < nk is
        let cid: int = if from_end then kids[nk - 1 - i] else kids[i]
        i += 1
        if !is_rendered(cx, cid) is continue end
        if cx.dom.nodes[cid].tag != "text" is
            let cst: style::ComputedStyle = cx.styles[cid]
            if is_out_of_flow(cst) || is_float(cst) is continue end
        end
        if is_block_level_child(cx, cid) is return cid end
        return -1
    end
    return -1
end

;; Margines górny, który „przecieka" przez ten blok z jego pierwszego dziecka (0, gdy brak zwijania).
fn collapsed_child_margin(cx: LayoutCtx, id: int, bottom: bool, depth: int) -> int is
    if depth > 30 || !is_block_flow(cx, id) is return 0 end
    let st: style::ComputedStyle = cx.styles[id]
    if bottom is
        if st.pad_bottom > 0 || st.bb > 0 || st.height_mode != "auto" || st.min_height > 0 is return 0 end
    else is
        if st.pad_top > 0 || st.bt > 0 is return 0 end
    end
    let c: int = first_flow_child(cx, id, bottom)
    if c < 0 is return 0 end
    let cst: style::ComputedStyle = cx.styles[c]
    let own: int = m_or_zero(if bottom then cst.mar_bottom else cst.mar_top)
    let inner: int = collapsed_child_margin(cx, c, bottom, depth + 1)
    return collapse_margin(own, inner)
end

;; Granice linii w pasie [y, y+lh) wokół floatów: [x, szerokość].
fn line_bounds(fls: [int], y: int, lh: int, base_x: int, base_w: int) -> [int] is
    if array_len(fls) == 0 is return [base_x, base_w] end
    let b: [int] = float_bounds(fls, y, y + lh, base_x, base_x + base_w)
    return [b[0], b[1] - b[0]]
end

;; Układa ciąg węzłów inline w wierszach szerokości `inner_w`.
fn flow_inline(cx: LayoutCtx, ids: [int], owner: int, inner_x: int, start_y: int, inner_w: int,
               text_align: string, boxes: [LayoutBox]) -> InlineRes is
    return flow_inline_f(cx, ids, owner, inner_x, start_y, inner_w, text_align, boxes, [], 0)
end

;; Jak flow_inline, ale wiersze omijają floaty `fls`, a pierwszy wiersz ma wcięcie `indent`.
fn flow_inline_f(cx: LayoutCtx, ids: [int], owner: int, inner_x: int, start_y: int, inner_w: int,
                 text_align: string, boxes: [LayoutBox], fls: [int], indent: int) -> InlineRes is
    let ost0: style::ComputedStyle = cx.styles[owner]
    let bal: bool = props::xget(ost0.xp, "text-wrap") == "balance" || props::xget(ost0.xp, "text-wrap-style") == "balance"
    if !bal || array_len(fls) > 0 || inner_w < 40 is
        return flow_inline_f0(cx, ids, owner, inner_x, start_y, inner_w, text_align, boxes, fls, indent)
    end
    ;; text-wrap: balance — najwęższa szerokość dająca tę samą liczbę wierszy
    let r0: InlineRes = flow_inline_f0(cx, ids, owner, inner_x, start_y, inner_w, text_align, [], fls, indent)
    if r0.height <= line_h_of(ost0) is
        return flow_inline_f0(cx, ids, owner, inner_x, start_y, inner_w, text_align, boxes, fls, indent)
    end
    let mut lo: int = inner_w / 3
    let mut hi: int = inner_w
    let mut guard: int = 0
    while lo < hi && guard < 9 is
        let mid: int = (lo + hi) / 2
        let rm: InlineRes = flow_inline_f0(cx, ids, owner, inner_x, start_y, mid, text_align, [], fls, indent)
        if rm.height == r0.height is hi = mid else is lo = mid + 1 end
        guard += 1
    end
    let base: string = string_split(text_align, "|")[0]
    let off: int = if base == "center" then (inner_w - hi) / 2 elsif base == "right" then inner_w - hi else 0
    return flow_inline_f0(cx, ids, owner, inner_x + off, start_y, hi, text_align, boxes, fls, indent)
end


;; 0.4: wrap-before / wrap-after / wrap-inside (auto | avoid | avoid-line | avoid-flex | line | flex) — kontrola miejsc łamania wiersza
;; między atomami tekstu; element = bezpośredni właściciel atomu (zagnieżdżone elementy liczone osobno).
fn wrap_val(cx: LayoutCtx, owner: int, name: string) -> string is
    if owner < 0 || owner >= array_len(cx.styles) is return "" end
    return string_lower(string_trim(props::xget(cx.styles[owner].xp, name)))
end

fn wrap_is_avoid(v: string) -> bool is
    return v == "avoid" || v == "avoid-line" || v == "avoid-flex"
end

;; true, gdy łamanie przed atomem `i` jest zabronione
fn wrap_forbidden(cx: LayoutCtx, atoms: [Atom], i: int) -> bool is
    if i <= 0 is return false end
    let cur: int = atoms[i].owner
    let prv: int = atoms[i - 1].owner
    if cur == prv is return wrap_is_avoid(wrap_val(cx, cur, "wrap-inside")) end
    if wrap_is_avoid(wrap_val(cx, cur, "wrap-before")) is return true end
    return wrap_is_avoid(wrap_val(cx, prv, "wrap-after"))
end

;; true, gdy przed atomem `i` wymuszone jest złamanie (wrap-before/after: line)
fn wrap_forced(cx: LayoutCtx, atoms: [Atom], i: int) -> bool is
    if i <= 0 is return false end
    let cur: int = atoms[i].owner
    let prv: int = atoms[i - 1].owner
    if cur == prv is return false end
    if wrap_val(cx, cur, "wrap-before") == "line" is return true end
    return wrap_val(cx, prv, "wrap-after") == "line"
end

;; szerokość całej grupy atomów elementu z wrap-inside: avoid, gdy `i` jest jej początkiem; inaczej 0
fn wrap_group_w(cx: LayoutCtx, atoms: [Atom], i: int) -> int is
    let cur: int = atoms[i].owner
    if i > 0 && atoms[i - 1].owner == cur is return 0 end
    if !wrap_is_avoid(wrap_val(cx, cur, "wrap-inside")) is return 0 end
    let mut w: int = 0
    let mut k: int = i
    while k < array_len(atoms) && atoms[k].owner == cur && atoms[k].kind != "br" is
        w = w + (if k > i && atoms[k].sp then atoms[k].sw else 0) + atoms[k].w
        k += 1
    end
    return w
end

fn flow_inline_f0(cx: LayoutCtx, ids: [int], owner: int, inner_x: int, start_y: int, inner_w: int,
                  text_align: string, boxes: [LayoutBox], fls: [int], indent: int) -> InlineRes is
    let mut atoms: [Atom] = collect_atoms(cx, ids, owner, -1, inner_w, [], 0)
    let ost: style::ComputedStyle = cx.styles[owner]
    let nowrap: bool = nowrap_of(ost)
    let guess_lh: int = line_h_of(ost)
    let mut acc: [LayoutBox] = boxes
    let mut y: int = start_y
    let mut line_idx: [int] = []
    let mut line_x: [int] = []
    let mut x: int = indent
    let mut max_used: int = 0
    let mut lb: [int] = line_bounds(fls, y, guess_lh, inner_x, inner_w)
    let mut total: int = array_len(atoms)
    let mut i: int = 0
    let mut split_guard: int = 0
    let mut lines_out: int = 0
    let mut hyph_run: int = 0
    let mut pending_hyph: bool = false
    while i < total is
        let a: Atom = atoms[i]
        if a.kind == "br" is
            hyph_run = 0
            pending_hyph = false
            line_idx = array_push(line_idx, i)
            line_x = array_push(line_x, x)
            let r: InlineRes = emit_line_h(cx, atoms, line_idx, line_x, y, lb, text_align, true, lines_out == 0, acc)
            lines_out += 1
            acc = r.boxes
            y = y + r.height
            if r.used_w > max_used is max_used = r.used_w end
            line_idx = []
            line_x = []
            x = 0
            lb = line_bounds(fls, y, guess_lh, inner_x, inner_w)
            i += 1
            continue
        end
        ;; pusty wiersz, a atom nie mieści się obok floatu: zejdź poniżej floatu
        if array_len(line_idx) == 0 && array_len(fls) > 0 && a.w > lb[1] is
            let mut guard: int = 0
            while guard < 120 && a.w > lb[1] is
                let nb: int = float_next_bottom(fls, y)
                if nb < 0 is break end
                y = nb
                lb = line_bounds(fls, y, guess_lh, inner_x, inner_w)
                guard += 1
            end
        end
        let gap: int = if a.sp && array_len(line_idx) > 0 then a.sw else 0
        ;; hyphens: słowo z miękkim łącznikiem, które się nie mieści — dziel w ostatnim możliwym miejscu
        if !nowrap && a.kind == "word" && x + gap + a.w > lb[1] && split_guard < 4000 && string_find(a.text, "\u00AD") >= 0 && hyph_allowed(cx.styles[a.owner], lb[1], lb[1] - x, hyph_run) is
            let hs: string = hyph_split(cx, a.text, cx.styles[a.owner], lb[1] - x - gap)
            if hs != "" is
                pending_hyph = true
                let parts: [string] = string_split(hs, "\u0001")
                let mut head: Atom = copy_atom(a)
                head.text = parts[0]
                head.w = text_w(cx, parts[0], cx.styles[a.owner])
                let mut tail: Atom = copy_atom(a)
                tail.text = parts[1]
                tail.w = text_w(cx, shy_strip(parts[1]), cx.styles[a.owner])
                tail.sp = false
                let mut na: [Atom] = []
                let mut k: int = 0
                while k < total is
                    if k == i is
                        na = array_push(na, head)
                        na = array_push(na, tail)
                    else is
                        na = array_push(na, atoms[k])
                    end
                    k += 1
                end
                atoms = na
                total = array_len(atoms)
                split_guard += 1
                continue
            end
        end
        let gw: int = wrap_group_w(cx, atoms, i)
        let need_w: int = if gw > a.w then gw else a.w
        let fits_not: bool = x + gap + need_w > lb[1] && !wrap_forbidden(cx, atoms, i)
        if !nowrap && array_len(line_idx) > 0 && (fits_not || wrap_forced(cx, atoms, i)) && a.kind != "close" is
            let r: InlineRes = emit_line_h(cx, atoms, line_idx, line_x, y, lb, text_align, false, lines_out == 0, acc)
            if pending_hyph is
                hyph_run += 1
                pending_hyph = false
            else is
                hyph_run = 0
            end
            lines_out += 1
            acc = r.boxes
            y = y + r.height
            if r.used_w > max_used is max_used = r.used_w end
            line_idx = []
            line_x = []
            lb = line_bounds(fls, y, guess_lh, inner_x, inner_w)
            line_idx = array_push(line_idx, i)
            line_x = array_push(line_x, 0)
            x = a.w
            i += 1
            continue
        end
        line_idx = array_push(line_idx, i)
        line_x = array_push(line_x, x + gap)
        x = x + gap + a.w
        i += 1
    end
    if array_len(line_idx) > 0 is
        let r: InlineRes = emit_line_h(cx, atoms, line_idx, line_x, y, lb, text_align, true, lines_out == 0, acc)
        acc = r.boxes
        y = y + r.height
        if r.used_w > max_used is max_used = r.used_w end
    end
    ;; text-overflow: ellipsis dla pojedynczego, za szerokiego tekstu bez zawijania
    if ost.ellipsis && nowrap && max_used > inner_w && array_len(acc) > 0 is
        let mut k: int = array_len(acc) - 1
        while k >= 0 is
            if acc[k].kind == "text" && acc[k].x + acc[k].w > inner_x + inner_w is
                let room: int = inner_x + inner_w - acc[k].x - text_w(cx, "…", ost)
                let keep: int = if room > 0 then (if cx.win >= 0 then ffi_shim::silver_text_fit(cx.win, shape_prefix(ost) + acc[k].text, ost.font_size, style_flags(ost), room) else 0) else 0
                acc[k].text = string_slice(acc[k].text, 0, keep) + "…"
                acc[k].w = inner_x + inner_w - acc[k].x
            end
            k -= 1
        end
    end
    return InlineRes { boxes: acc, height: y - start_y, used_w: max_used }
end

;; ---------- blok ----------
fn roman_of(n0: int, upper: bool) -> string is
    let vals: [int] = [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    let syms: [string] = ["m", "cm", "d", "cd", "c", "xc", "l", "xl", "x", "ix", "v", "iv", "i"]
    let mut n: int = n0
    let mut out: string = ""
    if n <= 0 || n >= 4000 is return to_string(n0) end
    let mut i: int = 0
    while i < array_len(vals) is
        while n >= vals[i] is
            out = out + syms[i]
            n -= vals[i]
        end
        i += 1
    end
    return if upper then string_upper(out) else out
end

fn alpha_of(n0: int, upper: bool) -> string is
    if n0 <= 0 is return to_string(n0) end
    let letters: string = "abcdefghijklmnopqrstuvwxyz"
    let mut n: int = n0
    let mut out: string = ""
    while n > 0 is
        n -= 1
        out = string_slice(letters, n % 26, n % 26 + 1) + out
        n = n / 26
    end
    return if upper then string_upper(out) else out
end

fn greek_of(n0: int) -> string is
    let letters: [string] = ["α", "β", "γ", "δ", "ε", "ζ", "η", "θ", "ι", "κ", "λ", "μ", "ν", "ξ", "ο", "π", "ρ", "σ", "τ", "υ", "φ", "χ", "ψ", "ω"]
    if n0 <= 0 || n0 > 24 is return to_string(n0) end
    return letters[n0 - 1]
end

;; Numer elementu listy (od 1), z obsługą ol[start] i ol[reversed].
fn li_index(cx: LayoutCtx, id: int) -> int is
    let n: dom::DomNode = cx.dom.nodes[id]
    if n.parent < 0 is return 1 end
    let parent: dom::DomNode = cx.dom.nodes[n.parent]
    let mut idx: int = 0
    let mut count: int = 0
    let mut mine: int = 0
    let mut i: int = 0
    while i < array_len(parent.children) is
        let c: dom::DomNode = cx.dom.nodes[parent.children[i]]
        if c.tag == "li" && !c.removed is
            count += 1
            if parent.children[i] == id is mine = count end
        end
        i += 1
    end
    let start_attr: string = dom::get_attr(parent, "start")
    let reversed: bool = dom::has_attr(parent, "reversed")
    let first: int = if start_attr != "" then str_to_int(start_attr) elsif reversed then count else 1
    idx = if reversed then first - (mine - 1) else first + (mine - 1)
    let own: string = dom::get_attr(n, "value")
    if own != "" is idx = str_to_int(own) end
    return idx
end

fn li_marker(cx: LayoutCtx, id: int) -> string is
    let n: dom::DomNode = cx.dom.nodes[id]
    let st: style::ComputedStyle = cx.styles[id]
    let mut kind: string = st.list_style
    if kind == "" is
        kind = "disc"
        if n.parent >= 0 && cx.dom.nodes[n.parent].tag == "ol" is kind = "decimal" end
    end
    if kind == "none" is return "" end
    if kind == "disc" is return "•" end
    if kind == "circle" is return "◦" end
    if kind == "square" is return "▪" end
    let idx: int = li_index(cx, id)
    if kind == "decimal-leading-zero" is return (if idx >= 0 && idx < 10 then "0" else "") + to_string(idx) + "." end
    if kind == "lower-alpha" || kind == "lower-latin" is return alpha_of(idx, false) + "." end
    if kind == "upper-alpha" || kind == "upper-latin" is return alpha_of(idx, true) + "." end
    if kind == "lower-roman" is return roman_of(idx, false) + "." end
    if kind == "upper-roman" is return roman_of(idx, true) + "." end
    if kind == "lower-greek" is return greek_of(idx) + "." end
    return to_string(idx) + "."
end

pub fn scroll_key_x(id: int) -> int is return 0 - id - 1 end

;; 0.4: klucze nadpisań rozmiaru z `resize` (w tej samej liście par co przewinięcia)
pub fn resize_key_w(id: int) -> int is return 0 - 200000000 - id * 2 end
pub fn resize_key_h(id: int) -> int is return 0 - 200000000 - id * 2 - 1 end

;; 0.4: największa prawa krawędź (x+w) pudełek z listy — szerokość treści kontenera przewijanego poziomo.
fn max_right_edge(kids: [LayoutBox], floor_x: int) -> int is
    let mut m: int = floor_x
    let mut i: int = 0
    while i < array_len(kids) is
        let b: LayoutBox = kids[i]
        i += 1
        if (b.kind == "box" || b.kind == "text" || b.kind == "inlinebg") && b.x + b.w > m is m = b.x + b.w end
    end
    return m
end

fn has_scroll_entry(cx: LayoutCtx, id: int) -> bool is
    let mut i: int = 0
    while i + 1 < array_len(cx.scrolls) is
        if cx.scrolls[i] == id is return true end
        i += 2
    end
    return false
end

;; 0.4: scroll-start — pozycja początkowa kontenera przewijania (start | end | center | <długość> | <procent>), dopóki użytkownik nie przewinął.
fn scroll_start_tok(tok: string, max: int, st: style::ComputedStyle) -> int is
    let t: string = string_lower(string_trim(tok))
    if t == "end" || t == "bottom" || t == "right" is return max end
    if t == "center" is return max / 2 end
    if t == "" || t == "auto" || t == "start" || t == "top" || t == "left" || t == "none" || t == "normal" is return 0 end
    let v: int = gfx::len_px(t, max, st.font_size)
    if v < 0 is return 0 end
    if v > max is return max end
    return v
end

;; 0.4: scroll-start-target / scroll-initial-target — potomek, do którego kontener przewija się na starcie.
;; Zwraca przesunięcie (px od początku zawartości) albo -1, gdy brak celu na tej osi.
fn scroll_target_offset(kids: [LayoutBox], vertical: bool, origin: int) -> int is
    let mut i: int = 0
    while i < array_len(kids) is
        let b: LayoutBox = kids[i]
        i += 1
        if b.kind != "box" is continue end
        let mut v: string = ""
        if vertical is
            v = props::xget(b.st.xp, "scroll-start-target-y")
            if v == "" is v = props::xget(b.st.xp, "scroll-start-target-block") end
        else is
            v = props::xget(b.st.xp, "scroll-start-target-x")
            if v == "" is v = props::xget(b.st.xp, "scroll-start-target-inline") end
        end
        if v == "" is v = props::xget(b.st.xp, "scroll-start-target") end
        if v == "" is v = props::xget(b.st.xp, "scroll-initial-target") end
        let lv: string = string_lower(string_trim(v))
        if lv != "" && lv != "none" is
            let pos: int = if vertical then b.y - origin else b.x - origin
            if pos < 0 is return 0 end
            return pos
        end
    end
    return -1
end

fn scroll_start_value(st: style::ComputedStyle, vertical: bool, max: int) -> int is
    let longhand: string = props::xget(st.xp, if vertical then "scroll-start-y" else "scroll-start-x")
    if longhand != "" is return scroll_start_tok(longhand, max, st) end
    let logical: string = props::xget(st.xp, if vertical then "scroll-start-block" else "scroll-start-inline")
    if logical != "" is return scroll_start_tok(logical, max, st) end
    let sh: [string] = cssval::split_top(props::xget(st.xp, "scroll-start"))
    let idx: int = if vertical then 0 else 1
    if array_len(sh) > idx is return scroll_start_tok(sh[idx], max, st) end
    return 0
end

fn scroll_offset(cx: LayoutCtx, id: int) -> int is
    let mut i: int = 0
    while i + 1 < array_len(cx.scrolls) is
        if cx.scrolls[i] == id is return cx.scrolls[i + 1] end
        i += 2
    end
    return 0
end

;; Normalny przepływ bloku: bloki pionowo (zwijanie marginesów) + serie inline.
;; ---------- 0.4: float-offset / float-reference / float-defer ----------
struct FloatPlace is
    pub acc:  [LayoutBox]
    pub fls:  [int]
    pub maxw: int
    pub dpend: [int]
end

;; Układa jeden float w pasie od `fy`. float-reference: page → krawędzie strony (okna) zamiast kontenera; float-offset → przesunięcie do wnętrza.
fn place_float_box(cx: LayoutCtx, cxf: LayoutCtx, fls0: [int], acc0: [LayoutBox], cid: int, x: int, fy: int, w: int, inner_h: int) -> FloatPlace is
    let cst: style::ComputedStyle = cx.styles[cid]
    let mut fls: [int] = fls0
    let res: BlockRes = layout_block(cxf, cid, x, fy, w, inner_h, -1, true)
    let tw: int = res.w + res.ml + res.mr
    let th: int = res.h + res.mt + res.mb
    let mut py: int = fy
    let cc: int = clear_side_code(cst)
    if cc >= 0 is
        let fb: int = float_bottom(fls, cc)
        if fb > py is py = fb end
    end
    let to_right: bool = cst.float_side == "right"
    let fref: string = string_lower(string_trim(props::xget(cst.xp, "float-reference")))
    let ex: int = if fref == "page" then 0 else x
    let ew: int = if fref == "page" then cx.vw else w
    let mut fx: int = ex
    let mut tries: int = 0
    let mut placed_ok: bool = false
    while tries < 40 && !placed_ok is
        let band: [int] = float_bounds(fls, py, py + th, ex, ex + ew)
        if band[1] - band[0] >= tw || band[2] == 0 is
            fx = if to_right then band[1] - tw else band[0]
            placed_ok = true
        else is
            let nb: int = float_next_bottom(fls, py)
            if nb < 0 is
                fx = if to_right then band[1] - tw else band[0]
                placed_ok = true
            else is
                py = nb
            end
        end
        tries += 1
    end
    let off: int = shape::len_px(props::xget(cst.xp, "float-offset"), ew, cst.font_size)
    if off != 0 is
        if to_right is
            fx = fx - off
        else is
            fx = fx + off
        end
    end
    let acc: [LayoutBox] = concat_boxes(acc0, shift_boxes(res.boxes, fx - x, py - fy))
    fls = concat_ints(fls, float_records(cx, cst, res, to_right, fx, py, tw, th))
    return FloatPlace { acc: acc, fls: fls, maxw: tw, dpend: [] }
end

;; float-defer: <liczba> — float czeka, aż przejdzie tyle kolejnych bloków rodzeństwa; `last` — do końca kontenera.
fn float_defer_of(st: style::ComputedStyle) -> int is
    let v: string = string_lower(string_trim(props::xget(st.xp, "float-defer")))
    if v == "last" is return -1 end
    if props::is_int(v) && str_to_int(v) > 0 is return str_to_int(v) end
    return 0
end

;; Zwalnia odroczone floaty: tick = jeden blok minął; force = koniec kontenera.
fn release_deferred(cx: LayoutCtx, cxf0: LayoutCtx, fls0: [int], acc0: [LayoutBox], dpend0: [int], x: int, cursor: int, w: int, inner_h: int, tick: bool, force: bool) -> FloatPlace is
    let mut fls: [int] = fls0
    let mut acc: [LayoutBox] = acc0
    let mut keep: [int] = []
    let mut cxf: LayoutCtx = cxf0
    let mut maxw: int = 0
    let mut k: int = 0
    while k + 1 < array_len(dpend0) is
        let cid: int = dpend0[k]
        let mut rem: int = dpend0[k + 1]
        k += 2
        if tick && rem > 0 is rem = rem - 1 end
        if force || rem == 0 is
            let fp: FloatPlace = place_float_box(cx, cxf, fls, acc, cid, x, cursor, w, inner_h)
            acc = fp.acc
            fls = fp.fls
            cxf = with_floats(cx, fls)
            if fp.maxw > maxw is maxw = fp.maxw end
        else is
            keep = array_push(array_push(keep, cid), rem)
        end
    end
    return FloatPlace { acc: acc, fls: fls, maxw: maxw, dpend: keep }
end


;; ---------- 0.4: shape-inside / shape-padding ----------
;; Wiersze wewnątrz kontenera mają mieścić się w kształcie: poza kształtem (i jego `shape-padding`) wstawiamy wykluczenia
;; po lewej i prawej stronie każdego paska (ten sam format co wpisy floatów: [strona, y0, y1, xl, xr]).
fn shape_inside_records(cx: LayoutCtx, st: style::ComputedStyle, x: int, y: int, w: int, inner_h: int) -> [int] is
    let v: string = string_trim(props::xget(st.xp, "shape-inside"))
    let lv: string = string_lower(v)
    if v == "" || lv == "auto" || lv == "none" || w <= 0 || !shape::supported(v) is return [] end
    let rh: int = if inner_h > 0 then inner_h else w
    let pad: int = shape::len_px(props::xget(st.xp, "shape-padding"), w, st.font_size)
    let d: [int] = shape::build(v, x, y, w, rh, 0, st.font_size)
    if array_len(d) == 0 is return [] end
    let mut out: [int] = []
    let stp: int = shape::step()
    let mut yy: int = y
    let mut guard: int = 0
    while yy < y + rh && guard < 4000 is
        guard += 1
        let y1: int = if yy + stp > y + rh then y + rh else yy + stp
        let ex: [[int]] = [shape::extent(d, yy), shape::extent(d, yy + stp / 2), shape::extent(d, y1 - 1)]
        let mut lo: int = -1000000
        let mut hi: int = 1000000
        let mut empty: bool = false
        let mut k: int = 0
        while k < 3 is
            if array_len(ex[k]) != 2 is empty = true
            else is
                if ex[k][0] > lo is lo = ex[k][0] end
                if ex[k][1] < hi is hi = ex[k][1] end
            end
            k += 1
        end
        lo = lo + pad
        hi = hi - pad
        if empty || hi <= lo is
            out = array_push(array_push(array_push(array_push(array_push(out, 0), yy), y1), x), x + w)
        else is
            if lo > x is out = array_push(array_push(array_push(array_push(array_push(out, 0), yy), y1), x), lo) end
            if hi < x + w is out = array_push(array_push(array_push(array_push(array_push(out, 1), yy), y1), hi), x + w) end
        end
        yy = y1
    end
    return out
end

fn layout_flow(cx: LayoutCtx, id: int, x: int, y: int, w: int, inner_h: int, boxes: [LayoutBox]) -> InlineRes is
    let n: dom::DomNode = cx.dom.nodes[id]
    let st: style::ComputedStyle = cx.styles[id]
    let bfc: bool = id == 0 || is_bfc_root(st)
    let mut fls: [int] = []
    if bfc == false is fls = cx.floats end
    if id > 0 && string_lower(string_trim(props::xget(st.xp, "wrap-through"))) == "none" is fls = strip_exclusions(fls) end
    if id > 0 is fls = concat_ints(fls, shape_inside_records(cx, st, x, y, w, inner_h)) end
    if id > 0 is fls = concat_ints(fls, exclusion_records(cx, id, st, x, y, w)) end
    let mut cxf: LayoutCtx = if bfc && array_len(cx.floats) > 0 then with_floats(cx, []) else cx
    let mut acc: [LayoutBox] = boxes
    let mut dpend: [int] = []
    let mut cursor: int = y
    let mut pending_mb: int = 0
    let mut first_block: bool = true
    let mut first_run: bool = true
    let mut run: [int] = []
    let mut max_used: int = 0
    let mut i: int = 0
    let total: int = array_len(n.children)
    while i <= total is
        let at_end: bool = i == total
        let cid: int = if at_end then -1 else n.children[i]
        i += 1
        if !at_end && !is_rendered(cx, cid) is continue end
        if !at_end && cx.dom.nodes[cid].tag != "text" && is_out_of_flow(cx.styles[cid]) is continue end
        if !at_end && is_inline_level(cx, cid) is
            run = array_push(run, cid)
            continue
        end
        if array_len(run) > 0 is
            cursor = cursor + pending_mb
            pending_mb = 0
            let indent: int = if first_run then st.text_indent + marker_indent(cx, id) else 0
            let r: InlineRes = flow_inline_f(cxf, run, id, x, cursor, w, align_spec(st), acc, fls, indent)
            acc = r.boxes
            cursor = cursor + r.height
            if r.used_w > max_used is max_used = r.used_w end
            run = []
            first_block = false
            first_run = false
        end
        if at_end is
            if array_len(dpend) > 0 is
                let rd: FloatPlace = release_deferred(cx, cxf, fls, acc, dpend, x, cursor + pending_mb, w, inner_h, false, true)
                acc = rd.acc
                fls = rd.fls
                cxf = with_floats(cx, fls)
                dpend = rd.dpend
                if rd.maxw > max_used is max_used = rd.maxw end
            end
            break
        end
        let cst: style::ComputedStyle = cx.styles[cid]
        ;; ----- float -----
        if cx.dom.nodes[cid].tag != "text" && is_float(cst) is
            let dfr: int = float_defer_of(cst)
            if dfr != 0 is
                dpend = array_push(array_push(dpend, cid), dfr)
                continue
            end
            let fp: FloatPlace = place_float_box(cx, cxf, fls, acc, cid, x, cursor + pending_mb, w, inner_h)
            acc = fp.acc
            fls = fp.fls
            cxf = with_floats(cx, fls)
            if fp.maxw > max_used is max_used = fp.maxw end
            continue
        end
        ;; ----- clear -----
        let cc2: int = clear_side_code(cst)
        if cc2 >= 0 && array_len(fls) > 0 is
            let fb2: int = float_bottom(fls, cc2)
            if fb2 > cursor + pending_mb is
                cursor = fb2
                pending_mb = 0
            end
        end
        ;; ----- blok w przepływie (BFC omija floaty) -----
        let mut bx: int = x
        let mut bw: int = w
        if array_len(fls) > 0 && is_bfc_root(cst) is
            let band: [int] = float_bounds(fls, cursor + pending_mb, cursor + pending_mb + 1, x, x + w)
            bx = band[0]
            bw = band[1] - band[0]
        end
        let res: BlockRes = layout_block(cxf, cid, bx, cursor, bw, inner_h, -1, false)
        let want: int = collapse_margin(pending_mb, res.mt)
        let delta: int = want - res.mt
        let placed: [LayoutBox] = shift_boxes(res.boxes, 0, delta)
        acc = concat_boxes(acc, placed)
        cursor = cursor + want + res.h
        pending_mb = res.mb
        if res.w + res.ml + res.mr > max_used is max_used = res.w + res.ml + res.mr end
        first_block = false
        first_run = false
        if array_len(dpend) > 0 is
            let rd2: FloatPlace = release_deferred(cx, cxf, fls, acc, dpend, x, cursor + pending_mb, w, inner_h, true, false)
            acc = rd2.acc
            fls = rd2.fls
            cxf = with_floats(cx, fls)
            dpend = rd2.dpend
            if rd2.maxw > max_used is max_used = rd2.maxw end
        end
    end
    cursor = cursor + pending_mb
    if bfc && array_len(fls) > 0 is
        let fb3: int = float_bottom(fls, 2)
        if fb3 > cursor is cursor = fb3 end
    end
    return InlineRes { boxes: acc, height: cursor - y, used_w: max_used }
end

;; Dodatkowe wcięcie pierwszego wiersza dla `list-style-position: inside`.
;; 0.4: marker-side: match-self (domyślnie: kierunek elementu li) | match-parent (kierunek rodzica) — znacznik zewnętrzny po prawej przy rtl
fn marker_on_right(cx: LayoutCtx, id: int, st: style::ComputedStyle) -> bool is
    let side: string = string_lower(string_trim(props::xget(st.xp, "marker-side")))
    if side == "match-parent" is
        let par: int = cx.dom.nodes[id].parent
        if par >= 0 && par < array_len(cx.styles) is return cx.styles[par].direction == "rtl" end
    end
    return st.direction == "rtl"
end

fn marker_indent(cx: LayoutCtx, id: int) -> int is
    let st: style::ComputedStyle = cx.styles[id]
    if st.display != "list-item" || st.list_pos != "inside" is return 0 end
    let marker: string = li_marker(cx, id)
    if marker == "" is return 0 end
    return text_w(cx, marker, st) + 6
end

struct FItem is
    pub id:     int
    pub is_text: bool
    pub basis:  int
    pub ml:     int
    pub mr:     int
    pub mt:     int
    pub mb:     int
    pub auto_l: bool
    pub auto_r: bool
    pub grow:   int
    pub shrink: int
    pub main:   int
    pub min_w:  int
    pub max_w:  int
    pub align:  string
end

fn flex_items(cx: LayoutCtx, id: int, row: bool, container_align: string, inner_w: int) -> [FItem] is
    let n: dom::DomNode = cx.dom.nodes[id]
    let mut items: [FItem] = []
    let mut orders: [int] = []
    let mut i: int = 0
    while i < array_len(n.children) is
        let cid: int = n.children[i]
        i += 1
        if !is_rendered(cx, cid) is continue end
        let cn: dom::DomNode = cx.dom.nodes[cid]
        let cst: style::ComputedStyle = cx.styles[cid]
        if cn.tag != "text" && is_out_of_flow(cst) is continue end
        let is_text: bool = cn.tag == "text"
        let own_h: int = if is_text then 0 else pad_border_h(cst)
        let mut basis: int = 0
        if is_text is
            basis = text_max_width(cx, cn.text, cx.styles[id])
        else is
            let w_spec: int = style::size_of(cst.width, cst.width_pct, cst.width_mode, inner_w)
            if row && cst.flex_basis >= 0 is
                basis = if cst.border_box then cst.flex_basis else cst.flex_basis + own_h
            elsif row && w_spec >= 0 is
                basis = if cst.border_box then w_spec else w_spec + own_h
            elsif row is
                basis = max_content(cx, cid, 0)
            else is
                basis = 0
            end
        end
        let mut item: FItem = FItem {
            id: cid, is_text: is_text, basis: basis,
            ml: if is_text then 0 else m_or_zero(cst.mar_left), mr: if is_text then 0 else m_or_zero(cst.mar_right),
            mt: if is_text then 0 else m_or_zero(cst.mar_top), mb: if is_text then 0 else m_or_zero(cst.mar_bottom),
            auto_l: !is_text && cst.mar_left == auto_v(), auto_r: !is_text && cst.mar_right == auto_v(),
            grow: if is_text then 0 else cst.flex_grow, shrink: if is_text then 1000 else cst.flex_shrink,
            main: basis, min_w: if is_text then 0 else cst.min_width,
            max_w: if is_text || cst.max_width_mode == "auto" then -1 else style::size_of(cst.max_width, cst.max_width_pct, cst.max_width_mode, inner_w),
            align: if is_text || cst.align_self == "" then container_align else cst.align_self
        }
        if item.max_w >= 0 && item.basis > item.max_w is item.basis = item.max_w end
        if item.basis < item.min_w is item.basis = item.min_w end
        item.main = item.basis
        let ord: int = if is_text then 0 else cst.order
        ;; wstawianie stabilne wg `order`
        let mut pos: int = array_len(items)
        let mut k: int = array_len(items) - 1
        while k >= 0 is
            if orders[k] > ord is pos = k end
            k -= 1
        end
        let mut ni: [FItem] = []
        let mut no: [int] = []
        let mut q: int = 0
        while q < array_len(items) is
            if q == pos is
                ni = array_push(ni, item)
                no = array_push(no, ord)
            end
            ni = array_push(ni, items[q])
            no = array_push(no, orders[q])
            q += 1
        end
        if pos >= array_len(items) is
            ni = array_push(ni, item)
            no = array_push(no, ord)
        end
        items = ni
        orders = no
    end
    return items
end

fn reverse_items(items: [FItem]) -> [FItem] is
    let mut out: [FItem] = []
    let mut i: int = array_len(items) - 1
    while i >= 0 is
        out = array_push(out, items[i])
        i -= 1
    end
    return out
end

;; Układa element tekstowy będący bezpośrednim dzieckiem kontenera flex/grid.
fn layout_text_item(cx: LayoutCtx, tid: int, owner: int, w: int) -> BlockRes is
    let ost: style::ComputedStyle = cx.styles[owner]
    let r: InlineRes = flow_inline(cx, [tid], owner, 0, 0, w, align_spec(ost), [])
    return BlockRes { boxes: r.boxes, w: r.used_w, h: r.height, mt: 0, mb: 0, ml: 0, mr: 0 }
end

fn layout_item(cx: LayoutCtx, it: FItem, owner: int, force_w: int, avail_w: int, avail_h: int, fit: bool) -> BlockRes is
    if it.is_text is return layout_text_item(cx, it.id, owner, if force_w >= 0 then force_w else avail_w) end
    return layout_block(cx, it.id, 0, 0, avail_w, avail_h, force_w, fit)
end

fn layout_flex(cx: LayoutCtx, id: int, x: int, y: int, w: int, inner_h: int, boxes: [LayoutBox]) -> InlineRes is
    let st: style::ComputedStyle = cx.styles[id]
    let row: bool = st.flex_dir == "row" || st.flex_dir == "row-reverse"
    let reverse: bool = st.flex_dir == "row-reverse" || st.flex_dir == "column-reverse"
    let mut items: [FItem] = flex_items(cx, id, row, st.align, w)
    if reverse is items = reverse_items(items) end
    let count: int = array_len(items)
    if count == 0 is return InlineRes { boxes: boxes, height: 0, used_w: 0 } end
    let mut acc: [LayoutBox] = boxes
    let main_gap: int = if row then st.gap else st.row_gap
    let cross_gap: int = if row then st.row_gap else st.gap

    if row is
        ;; --- podział na linie ---
        let mut line_start: [int] = [0]
        if st.flex_wrap is
            let mut used: int = 0
            let mut i: int = 0
            while i < count is
                let outer: int = items[i].basis + items[i].ml + items[i].mr
                let is_first: bool = array_len(line_start) > 0 && line_start[array_len(line_start) - 1] == i
                if !is_first && used + main_gap + outer > w is
                    line_start = array_push(line_start, i)
                    used = outer
                else is
                    used = used + (if is_first then 0 else main_gap) + outer
                end
                i += 1
            end
        end
        let nlines: int = array_len(line_start)
        let mut cursor_y: int = y
        let mut line_acc: [int] = []
        let mut li: int = 0
        while li < nlines is
            line_acc = array_push(line_acc, array_len(acc))
            let from: int = line_start[li]
            let to: int = if li + 1 < nlines then line_start[li + 1] else count
            ;; rozmiary główne w linii
            let mut sum: int = 0
            let mut grow_sum: int = 0
            let mut shrink_sum: int = 0
            let mut auto_margins: int = 0
            let mut k: int = from
            while k < to is
                sum = sum + items[k].basis + items[k].ml + items[k].mr
                grow_sum = grow_sum + items[k].grow
                shrink_sum = shrink_sum + items[k].shrink * items[k].basis / 1000
                if items[k].auto_l is auto_margins += 1 end
                if items[k].auto_r is auto_margins += 1 end
                k += 1
            end
            let gaps: int = main_gap * (to - from - 1)
            let free: int = w - sum - gaps
            k = from
            while k < to is
                let mut m: int = items[k].basis
                if free > 0 && grow_sum > 0 is
                    m = m + free * items[k].grow / grow_sum
                elsif free < 0 && shrink_sum > 0 is
                    m = m + free * (items[k].shrink * items[k].basis / 1000) / shrink_sum
                end
                if items[k].max_w >= 0 && m > items[k].max_w is m = items[k].max_w end
                if m < items[k].min_w is m = items[k].min_w end
                if m < 0 is m = 0 end
                items[k].main = m
                k += 1
            end
            ;; wolne miejsce po wzroście → auto-marginesy / justify
            let mut used: int = gaps
            k = from
            while k < to is
                used = used + items[k].main + items[k].ml + items[k].mr
                k += 1
            end
            let left: int = w - used
            let mut offset: int = 0
            let mut extra_gap: int = 0
            let mut auto_each: int = 0
            if left > 0 && auto_margins > 0 is
                auto_each = left / auto_margins
            elsif left > 0 is
                let j: string = st.justify
                let nitems: int = to - from
                if j == "center" is
                    offset = left / 2
                elsif j == "flex-end" || j == "end" || j == "right" is
                    offset = left
                elsif j == "space-between" && nitems > 1 is
                    extra_gap = left / (nitems - 1)
                elsif j == "space-around" is
                    extra_gap = left / nitems
                    offset = extra_gap / 2
                elsif j == "space-evenly" is
                    extra_gap = left / (nitems + 1)
                    offset = extra_gap
                end
            end
            if reverse && left > 0 && auto_margins == 0 && offset == 0 && extra_gap == 0 is offset = 0 end
            ;; układ elementów (na początku (0,0)), pomiar wysokości
            let mut results: [BlockRes] = []
            let mut line_cross: int = 0
            k = from
            while k < to is
                let r: BlockRes = layout_item(cx, items[k], id, items[k].main, w, -1, false)
                results = array_push(results, r)
                let outer_h: int = r.h + items[k].mt + items[k].mb
                if outer_h > line_cross is line_cross = outer_h end
                k += 1
            end
            if !st.flex_wrap && inner_h >= 0 is line_cross = inner_h end
            ;; pozycje
            let mut px: int = x + offset
            k = from
            while k < to is
                let it: FItem = items[k]
                let r: BlockRes = results[k - from]
                let lx: int = px + (if it.auto_l then auto_each else 0)
                let outer_h: int = r.h + it.mt + it.mb
                let mut dy: int = 0
                let mut boxes_k: [LayoutBox] = r.boxes
                if it.align == "center" is
                    dy = (line_cross - outer_h) / 2
                elsif it.align == "flex-end" is
                    dy = line_cross - outer_h
                elsif it.align == "stretch" && !it.is_text && cx.styles[it.id].height_mode == "auto" && array_len(boxes_k) > 0 is
                    let want_h: int = line_cross - it.mt - it.mb
                    if want_h > boxes_k[0].h is boxes_k[0].h = want_h end
                end
                acc = concat_boxes(acc, shift_boxes(boxes_k, lx, cursor_y + dy))
                px = px + it.ml + it.main + it.mr + main_gap + extra_gap + (if it.auto_l then auto_each else 0) + (if it.auto_r then auto_each else 0)
                k += 1
            end
            cursor_y = cursor_y + line_cross + (if li + 1 < nlines then cross_gap else 0)
            li += 1
        end
        ;; align-content: rozdział wolnego miejsca w osi poprzecznej (tylko przy wysokości kontenera)
        let ac: string = st.align_content
        if st.flex_wrap && inner_h > 0 && inner_h > cursor_y - y && ac != "normal" && ac != "stretch" && ac != "flex-start" && ac != "start" is
            let spare: int = inner_h - (cursor_y - y)
            let mut shifted: [LayoutBox] = []
            let mut gi: int = 0
            while gi < array_len(acc) is
                let mut line_no: int = 0
                let mut q: int = 0
                while q < nlines is
                    if gi >= line_acc[q] is line_no = q end
                    q += 1
                end
                let mut off: int = 0
                if ac == "center" is
                    off = spare / 2
                elsif ac == "flex-end" || ac == "end" is
                    off = spare
                elsif ac == "space-between" && nlines > 1 is
                    off = spare * line_no / (nlines - 1)
                elsif ac == "space-around" is
                    off = spare / nlines / 2 + spare * line_no / nlines
                elsif ac == "space-evenly" is
                    off = spare * (line_no + 1) / (nlines + 1)
                end
                let mut moved: LayoutBox = copy_box(acc[gi])
                if gi >= line_acc[0] is
                    moved.y = moved.y + off
                    if moved.has_clip is moved.cy = moved.cy + off end
                end
                shifted = array_push(shifted, moved)
                gi += 1
            end
            acc = shifted
            cursor_y = y + inner_h
        end
        return InlineRes { boxes: acc, height: cursor_y - y, used_w: w }
    end

    ;; --- kolumna ---
    let mut results: [BlockRes] = []
    let mut heights: [int] = []
    let mut total: int = 0
    let mut grow_sum: int = 0
    let mut i: int = 0
    while i < count is
        let it: FItem = items[i]
        let mut r: BlockRes = BlockRes { boxes: [], w: 0, h: 0, mt: 0, mb: 0, ml: 0, mr: 0 }
        let avail: int = w - it.ml - it.mr
        if it.is_text is
            r = layout_text_item(cx, it.id, id, avail)
        else is
            let cst: style::ComputedStyle = cx.styles[it.id]
            let stretch: bool = it.align == "stretch" && cst.width_mode == "auto" && !is_replaced(cx.dom.nodes[it.id].tag)
            r = layout_block(cx, it.id, 0, 0, w, -1, if stretch then avail else -1, !stretch)
        end
        results = array_push(results, r)
        heights = array_push(heights, r.h)
        total = total + r.h + it.mt + it.mb
        grow_sum = grow_sum + it.grow
        i += 1
    end
    total = total + main_gap * (count - 1)
    let free: int = if inner_h >= 0 then inner_h - total else 0
    let mut cursor: int = y
    let mut offset: int = 0
    let mut extra_gap: int = 0
    if free > 0 && grow_sum == 0 is
        if st.justify == "center" is
            offset = free / 2
        elsif st.justify == "flex-end" is
            offset = free
        elsif st.justify == "space-between" && count > 1 is
            extra_gap = free / (count - 1)
        elsif st.justify == "space-around" is
            extra_gap = free / count
            offset = extra_gap / 2
        elsif st.justify == "space-evenly" is
            extra_gap = free / (count + 1)
            offset = extra_gap
        end
    end
    cursor = cursor + offset
    i = 0
    while i < count is
        let it: FItem = items[i]
        let r: BlockRes = results[i]
        let mut boxes_i: [LayoutBox] = r.boxes
        let mut h: int = r.h
        if free > 0 && grow_sum > 0 && it.grow > 0 is
            let add: int = free * it.grow / grow_sum
            h = h + add
            if array_len(boxes_i) > 0 is boxes_i[0].h = h end
        end
        let outer_w: int = r.w + r.ml + r.mr + it.ml + it.mr
        let mut dx: int = it.ml
        if it.align == "center" is
            dx = (w - outer_w) / 2 + it.ml
        elsif it.align == "flex-end" is
            dx = w - outer_w + it.ml
        end
        acc = concat_boxes(acc, shift_boxes(boxes_i, x + dx, cursor + it.mt))
        cursor = cursor + it.mt + h + it.mb + main_gap + extra_gap
        i += 1
    end
    cursor = cursor - main_gap - extra_gap
    return InlineRes { boxes: acc, height: cursor - y, used_w: w }
end

;; ---------- grid ----------
struct Track is
    pub kind: string   ;; px | fr | auto
    pub val:  int      ;; px lub fr*1000
end

fn parse_tracks(spec: string, avail: int, gap: int) -> [Track] is
    let toks: [string] = cssval::split_top(string_lower(spec))
    let mut out: [Track] = []
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if string_starts_with(t, "repeat(") is
            let inner: [string] = cssval::split_commas(string_slice(t, 7, string_len(t) - 1))
            if array_len(inner) >= 2 is
                let sub: [Track] = parse_tracks(inner[1], avail, gap)
                let mut times: int = 1
                if inner[0] == "auto-fill" || inner[0] == "auto-fit" is
                    let mut unit: int = 100
                    if array_len(sub) > 0 && sub[0].kind == "px" is unit = sub[0].val end
                    let ft: string = inner[1]
                    let mm: int = string_find(ft, "minmax(")
                    if mm >= 0 is
                        let args: [string] = cssval::split_commas(string_slice(ft, mm + 7, string_find(ft, ")")))
                        if array_len(args) >= 1 is
                            let env: cssval::LenEnv = cssval::default_env()
                            unit = cssval::px_of(cssval::parse_len(args[0], env), avail)
                        end
                    end
                    if unit < 1 is unit = 1 end
                    times = (avail + gap) / (unit + gap)
                    if times < 1 is times = 1 end
                else is
                    times = str_to_int(inner[0])
                end
                let mut r: int = 0
                while r < times is
                    let mut s: int = 0
                    while s < array_len(sub) is
                        out = array_push(out, sub[s])
                        s += 1
                    end
                    r += 1
                end
            end
        elsif string_starts_with(t, "minmax(") is
            let args: [string] = cssval::split_commas(string_slice(t, 7, string_len(t) - 1))
            let last: string = if array_len(args) >= 2 then args[1] else "auto"
            let sub: [Track] = parse_tracks(last, avail, gap)
            if array_len(sub) > 0 is out = array_push(out, sub[0]) end
        elsif string_ends_with(t, "fr") is
            let f: int = conv_milli(string_slice(t, 0, string_len(t) - 2))
            out = array_push(out, Track { kind: "fr", val: if f <= 0 then 1000 else f })
        elsif t == "auto" || t == "min-content" || t == "max-content" is
            out = array_push(out, Track { kind: "auto", val: 0 })
        else is
            let env: cssval::LenEnv = cssval::default_env()
            let l: cssval::Len = cssval::parse_len(t, env)
            if l.ok && !l.auto is out = array_push(out, Track { kind: "px", val: cssval::px_of(l, avail) }) end
        end
    end
    return out
end

fn conv_milli(s: string) -> int is
    let parts: [string] = string_split(string_trim(s), ".")
    let whole: int = str_to_int(parts[0]) * 1000
    if array_len(parts) < 2 is return whole end
    let frac_raw: string = parts[1] + "000"
    return whole + str_to_int(string_slice(frac_raw, 0, 3))
end

;; =====================================================================
;; 0.3: grid — obszary, linie, auto-placement, spany w obu osiach
;; =====================================================================
;; Prostokąt nazwanego obszaru: [wiersz0, kol0, wiersz1(wył.), kol1(wył.)]; [] gdy brak.
fn area_rect(areas: string, name: string) -> [int] is
    if areas == "" || name == "" is return [] end
    let rows: [string] = string_split(areas, "\u0001")
    let mut r0: int = 100000
    let mut c0: int = 100000
    let mut r1: int = -1
    let mut c1: int = -1
    let mut r: int = 0
    while r < array_len(rows) is
        let names: [string] = cssval::split_top(rows[r])
        let mut c: int = 0
        while c < array_len(names) is
            if names[c] == name is
                if r < r0 is r0 = r end
                if c < c0 is c0 = c end
                if r > r1 is r1 = r end
                if c > c1 is c1 = c end
            end
            c += 1
        end
        r += 1
    end
    if r1 < 0 is return [] end
    return [r0, c0, r1 + 1, c1 + 1]
end

fn area_cols(areas: string) -> int is
    if areas == "" is return 0 end
    let rows: [string] = string_split(areas, "\u0001")
    let mut best: int = 0
    let mut r: int = 0
    while r < array_len(rows) is
        let n: int = array_len(cssval::split_top(rows[r]))
        if n > best is best = n end
        r += 1
    end
    return best
end

fn count_area_rows(areas: string) -> int is
    let parts: [string] = string_split(areas, "\u0001")
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(parts) is
        if string_trim(parts[i]) != "" is n += 1 end
        i += 1
    end
    return if n < 1 then 1 else n
end

fn grid_free(occ: [bool], ncols: int, r: int, c: int, rs: int, cs: int) -> bool is
    let mut dr: int = 0
    while dr < rs is
        let mut dc: int = 0
        while dc < cs is
            if occ[(r + dr) * ncols + c + dc] is return false end
            dc += 1
        end
        dr += 1
    end
    return true
end

fn grid_mark(occ: [bool], ncols: int, r: int, c: int, rs: int, cs: int) -> [bool] is
    let mut out: [bool] = occ
    let mut dr: int = 0
    while dr < rs is
        let mut dc: int = 0
        while dc < cs is
            out[(r + dr) * ncols + c + dc] = true
            dc += 1
        end
        dr += 1
    end
    return out
end

fn justify_kw(st: style::ComputedStyle, container: style::ComputedStyle) -> string is
    if st.justify_self != "" is return st.justify_self end
    return container.justify_items
end

;; =====================================================================
;; 0.4: masonry — `grid-template-rows: masonry` (kolumny jawne, elementy układane w najkrótszej kolumnie)
;; i `grid-template-columns: masonry` (ta sama zasada w poprzek wierszy). `masonry-auto-flow`: pack | next, definite-first | ordered.
;; =====================================================================
pub fn masonry_axis(st: style::ComputedStyle) -> int is
    ;; 1 = oś masonry to wiersze (kolumny jawne), 2 = oś masonry to kolumny (wiersze jawne), 0 = brak
    if string_lower(string_trim(st.grid_rows)) == "masonry" is return 1 end
    if string_lower(string_trim(st.grid_cols)) == "masonry" is return 2 end
    return 0
end

;; Indeks kolumny o najmniejszej wysokości (remis → pierwsza); `from` = od której zaczynać przy `next`.
pub fn shortest_track(heights: [int], lo: int, hi: int) -> int is
    let mut best: int = lo
    let mut i: int = lo
    while i < hi is
        if heights[i] < heights[best] is best = i end
        i += 1
    end
    return best
end

fn track_weight(t: Track) -> int is
    if t.kind == "fr" is return t.val end
    return 1000
end

fn layout_masonry(cx: LayoutCtx, id: int, x: int, y: int, w: int, boxes: [LayoutBox], items: [FItem], axis: int) -> InlineRes is
    let st: style::ComputedStyle = cx.styles[id]
    let flow: string = string_lower(props::xget(st.xp, "masonry-auto-flow"))
    let next_mode: bool = string_find(flow, "next") >= 0
    let ordered: bool = string_find(flow, "ordered") >= 0
    let count: int = array_len(items)
    let mut acc: [LayoutBox] = boxes
    if axis == 1 is
        ;; ----- kolumny jawne, elementy spływają w dół -----
        let mut tracks: [Track] = parse_tracks(st.grid_cols, w, st.gap)
        if array_len(tracks) == 0 is tracks = [Track { kind: "fr", val: 1000 }] end
        let ncols: int = array_len(tracks)
        let mut fixed: int = st.gap * (ncols - 1)
        let mut fr_sum: int = 0
        let mut i: int = 0
        while i < ncols is
            if tracks[i].kind == "px" is
                fixed += tracks[i].val
            else is
                fr_sum += track_weight(tracks[i])
            end
            i += 1
        end
        let remaining: int = if w - fixed > 0 then w - fixed else 0
        let mut col_w: [int] = []
        let mut col_x: [int] = []
        let mut run_x: int = 0
        i = 0
        while i < ncols is
            let mut cw: int = tracks[i].val
            if tracks[i].kind != "px" is
                cw = if fr_sum > 0 then remaining * track_weight(tracks[i]) / fr_sum else 0
            end
            col_w = array_push(col_w, cw)
            col_x = array_push(col_x, run_x)
            run_x = run_x + cw + st.gap
            i += 1
        end
        let mut col_h: [int] = []
        i = 0
        while i < ncols is
            col_h = array_push(col_h, 0)
            i += 1
        end
        let mut used_col: [bool] = []
        i = 0
        while i < ncols is
            used_col = array_push(used_col, false)
            i += 1
        end
        let mut cursor: int = 0
        let mut pass: int = 0
        while pass < 2 is
            i = 0
            while i < count is
                let it: FItem = items[i]
                let ist: style::ComputedStyle = cx.styles[it.id]
                let definite: bool = !it.is_text && ist.grid_col_start > 0 && ist.grid_col_start <= ncols
                let mut mine: bool = false
                if ordered is
                    mine = pass == 0
                elsif definite is
                    mine = pass == 0
                else is
                    mine = pass == 1
                end
                if !mine is
                    i += 1
                    continue
                end
                let span: int = if it.is_text || ist.grid_col_span < 1 then 1 else ist.grid_col_span
                let mut c: int = 0
                if definite is
                    c = ist.grid_col_start - 1
                elsif next_mode is
                    c = cursor % ncols
                else is
                    c = shortest_track(col_h, 0, ncols)
                end
                let mut sp: int = if span > ncols - c then ncols - c else span
                if sp < 1 is sp = 1 end
                let mut cw2: int = st.gap * (sp - 1)
                let mut top: int = 0
                let mut k: int = 0
                while k < sp is
                    cw2 += col_w[c + k]
                    if col_h[c + k] > top is top = col_h[c + k] end
                    k += 1
                end
                let r: BlockRes = layout_item(cx, it, id, cw2 - it.ml - it.mr, w, -1, false)
                let yy: int = if used_col[c] || top > 0 then top + st.row_gap else 0
                acc = concat_boxes(acc, shift_boxes(r.boxes, x + col_x[c] + it.ml, y + yy + it.mt))
                k = 0
                while k < sp is
                    col_h[c + k] = yy + it.mt + r.h + it.mb
                    used_col[c + k] = true
                    k += 1
                end
                cursor = c + sp
                i += 1
            end
            pass += 1
        end
        let mut total: int = 0
        i = 0
        while i < ncols is
            if col_h[i] > total is total = col_h[i] end
            i += 1
        end
        return InlineRes { boxes: acc, height: total, used_w: w }
    end
    ;; ----- wiersze jawne, elementy spływają w prawo -----
    let mut rt: [Track] = parse_tracks(st.grid_rows, 100000, st.row_gap)
    if array_len(rt) == 0 is rt = [Track { kind: "auto", val: 0 }] end
    let nrows: int = array_len(rt)
    let mut row_w: [int] = []
    let mut row_h: [int] = []
    let mut row_it: [int] = []
    let mut results: [BlockRes] = []
    let mut which: [int] = []
    let mut xoff: [int] = []
    let mut i: int = 0
    while i < nrows is
        row_w = array_push(row_w, 0)
        row_h = array_push(row_h, if rt[i].kind == "px" then rt[i].val else 0)
        row_it = array_push(row_it, 0)
        i += 1
    end
    let mut cursor: int = 0
    i = 0
    while i < count is
        let it: FItem = items[i]
        let r: BlockRes = layout_item(cx, it, id, -1, w, -1, true)
        let ist: style::ComputedStyle = cx.styles[it.id]
        let definite: bool = !it.is_text && ist.grid_row_start > 0 && ist.grid_row_start <= nrows
        let mut rr: int = 0
        if definite is
            rr = ist.grid_row_start - 1
        elsif next_mode is
            rr = cursor % nrows
        else is
            rr = shortest_track(row_w, 0, nrows)
        end
        let ow: int = r.w + it.ml + it.mr
        let xx: int = if row_it[rr] > 0 then row_w[rr] + st.gap else 0
        results = array_push(results, r)
        which = array_push(which, rr)
        xoff = array_push(xoff, xx)
        row_w[rr] = xx + ow
        row_it[rr] = row_it[rr] + 1
        let oh: int = r.h + it.mt + it.mb
        if rt[rr].kind != "px" && oh > row_h[rr] is row_h[rr] = oh end
        cursor = rr + 1
        i += 1
    end
    let mut row_y: [int] = []
    let mut run_y: int = 0
    i = 0
    while i < nrows is
        row_y = array_push(row_y, run_y)
        run_y = run_y + row_h[i] + st.row_gap
        i += 1
    end
    i = 0
    while i < count is
        let it: FItem = items[i]
        acc = concat_boxes(acc, shift_boxes(results[i].boxes, x + xoff[i] + it.ml, y + row_y[which[i]] + it.mt))
        i += 1
    end
    let mut maxw: int = 0
    i = 0
    while i < nrows is
        if row_w[i] > maxw is maxw = row_w[i] end
        i += 1
    end
    return InlineRes { boxes: acc, height: if nrows > 0 then run_y - st.row_gap else 0, used_w: if maxw > w then maxw else w }
end

fn layout_grid(cx: LayoutCtx, id: int, x: int, y: int, w: int, boxes: [LayoutBox]) -> InlineRes is
    let st: style::ComputedStyle = cx.styles[id]
    let items: [FItem] = flex_items(cx, id, true, "stretch", w)
    let count: int = array_len(items)
    if count == 0 is return InlineRes { boxes: boxes, height: 0, used_w: 0 } end
    let mas: int = masonry_axis(st)
    if mas > 0 is return layout_masonry(cx, id, x, y, w, boxes, items, mas) end
    let mut tracks: [Track] = parse_tracks(st.grid_cols, w, st.gap)
    if array_len(tracks) == 0 && string_find(st.grid_auto_flow, "column") < 0 is
        let ac: int = area_cols(st.grid_areas)
        let mut k: int = 0
        while k < (if ac > 0 then ac else 1) is
            tracks = array_push(tracks, Track { kind: "fr", val: 1000 })
            k += 1
        end
    end
    let colflow: bool = string_find(st.grid_auto_flow, "column") >= 0
    let explicit_cols: int = array_len(tracks)
    let row_tpl: [Track] = parse_tracks(st.grid_rows, 100000, st.row_gap)
    let nr_exp: int = if array_len(row_tpl) > 0 then array_len(row_tpl) elsif area_cols(st.grid_areas) > 0 then count_area_rows(st.grid_areas) else 1
    let mut ncols: int = array_len(tracks)
    if colflow && count > ncols is ncols = count end
    ;; ----- umieszczanie elementów -----
    let max_rows: int = count * 4 + 64
    let mut occ: [bool] = []
    let mut oi: int = 0
    while oi < max_rows * ncols is
        occ = array_push(occ, false)
        oi += 1
    end
    let mut pr: [int] = []
    let mut pc: [int] = []
    let mut prs: [int] = []
    let mut pcs: [int] = []
    let mut placed: [bool] = []
    let mut i: int = 0
    while i < count is
        pr = array_push(pr, 0)
        pc = array_push(pc, 0)
        prs = array_push(prs, 1)
        pcs = array_push(pcs, 1)
        placed = array_push(placed, false)
        i += 1
    end
    ;; przebieg 1: obszary nazwane i jawne współrzędne
    i = 0
    while i < count is
        let it: FItem = items[i]
        if !it.is_text is
            let ist: style::ComputedStyle = cx.styles[it.id]
            let mut ar: [int] = []
            if ist.grid_area != "" is ar = area_rect(st.grid_areas, ist.grid_area) end
            if array_len(ar) == 4 && ar[1] < ncols is
                pr[i] = ar[0]
                pc[i] = ar[1]
                prs[i] = ar[2] - ar[0]
                pcs[i] = if ar[3] - ar[1] > ncols - ar[1] then ncols - ar[1] else ar[3] - ar[1]
                placed[i] = true
            elsif ist.grid_row_start > 0 && ist.grid_col_start > 0 && ist.grid_col_start <= ncols is
                pr[i] = ist.grid_row_start - 1
                pc[i] = ist.grid_col_start - 1
                prs[i] = if ist.grid_row_span < 1 then 1 else ist.grid_row_span
                pcs[i] = if ist.grid_col_span < 1 then 1 elsif ist.grid_col_span > ncols - pc[i] then ncols - pc[i] else ist.grid_col_span
                placed[i] = true
            end
            if placed[i] is
                if pr[i] + prs[i] > max_rows - 1 is prs[i] = max_rows - 1 - pr[i] end
                occ = grid_mark(occ, ncols, pr[i], pc[i], prs[i], pcs[i])
            end
        end
        i += 1
    end
    ;; przebieg 2: auto-placement
    let dense: bool = string_find(st.grid_auto_flow, "dense") >= 0
    if colflow is
        let mut cur_c2: int = 0
        let mut cur_r2: int = 0
        let mut ci: int = 0
        while ci < count is
            if placed[ci] is
                ci += 1
                continue
            end
            let cit: FItem = items[ci]
            let cst: style::ComputedStyle = cx.styles[cit.id]
            let mut ccs: int = if cit.is_text then 1 else cst.grid_col_span
            let mut crs: int = if cit.is_text then 1 else cst.grid_row_span
            if ccs < 1 is ccs = 1 end
            if crs < 1 is crs = 1 end
            if crs > nr_exp is crs = nr_exp end
            let mut c2: int = if dense then 0 else cur_c2
            let mut found2: bool = false
            while c2 + ccs <= ncols && !found2 is
                let mut r2: int = if c2 == cur_c2 && !dense then cur_r2 else 0
                while r2 + crs <= nr_exp && !found2 is
                    if grid_free(occ, ncols, r2, c2, crs, ccs) is
                        pr[ci] = r2
                        pc[ci] = c2
                        prs[ci] = crs
                        pcs[ci] = ccs
                        found2 = true
                    else is
                        r2 += 1
                    end
                end
                if !found2 is c2 += 1 end
            end
            if !found2 is
                pr[ci] = 0
                pc[ci] = ncols - ccs
                prs[ci] = crs
                pcs[ci] = ccs
            end
            occ = grid_mark(occ, ncols, pr[ci], pc[ci], prs[ci], pcs[ci])
            if !dense is
                cur_c2 = pc[ci]
                cur_r2 = pr[ci] + prs[ci]
                if cur_r2 >= nr_exp is
                    cur_r2 = 0
                    cur_c2 += 1
                end
            end
            ci += 1
        end
        ;; kolumny niejawne wg grid-auto-columns
        let mut used: int = explicit_cols
        let mut ui: int = 0
        while ui < count is
            if pc[ui] + pcs[ui] > used is used = pc[ui] + pcs[ui] end
            ui += 1
        end
        let mut auto_t: [Track] = []
        if st.grid_auto_cols != "" is auto_t = parse_tracks(st.grid_auto_cols, w, st.gap) end
        let tpl: Track = if array_len(auto_t) > 0 then auto_t[0] else Track { kind: "auto", val: 0 }
        while array_len(tracks) < used is
            tracks = array_push(tracks, tpl)
        end
        ncols = used
    else is
    let mut cur_r: int = 0
    let mut cur_c: int = 0
    i = 0
    while i < count is
        if placed[i] is
            i += 1
            continue
        end
        let it: FItem = items[i]
        let ist: style::ComputedStyle = cx.styles[it.id]
        let mut cs: int = if it.is_text then 1 else ist.grid_col_span
        let mut rs: int = if it.is_text then 1 else ist.grid_row_span
        if cs > ncols is cs = ncols end
        if cs < 1 is cs = 1 end
        if rs < 1 is rs = 1 end
        let fixed_col: int = if it.is_text then 0 else ist.grid_col_start
        let fixed_row: int = if it.is_text then 0 else ist.grid_row_start
        let mut r: int = if dense then 0 else cur_r
        let mut found: bool = false
        while r < max_rows - rs - 1 && !found is
            let mut c: int = 0
            if fixed_col > 0 is
                c = fixed_col - 1
            elsif r == cur_r && !dense is
                c = cur_c
            end
            if fixed_row > 0 && r != fixed_row - 1 is
                r = fixed_row - 1
                c = 0
                if fixed_col > 0 is c = fixed_col - 1 end
            end
            let c_end: int = if fixed_col > 0 then fixed_col else ncols - cs + 1
            while c < c_end && c + cs <= ncols && !found is
                if grid_free(occ, ncols, r, c, rs, cs) is
                    pr[i] = r
                    pc[i] = c
                    prs[i] = rs
                    pcs[i] = cs
                    found = true
                else is
                    c += 1
                end
            end
            if !found is
                if fixed_row > 0 is break end
                r += 1
            end
        end
        if !found is
            pr[i] = max_rows - rs - 2
            pc[i] = 0
            prs[i] = rs
            pcs[i] = cs
        end
        occ = grid_mark(occ, ncols, pr[i], pc[i], prs[i], pcs[i])
        if !dense is
            cur_r = pr[i]
            cur_c = pc[i] + pcs[i]
            if cur_c >= ncols is
                cur_c = 0
                cur_r += 1
            end
        end
        i += 1
    end
    end
    ;; ----- szerokości kolumn -----
    let mut fixed: int = st.gap * (ncols - 1)
    let mut fr_sum: int = 0
    i = 0
    while i < ncols is
        if tracks[i].kind == "px" is fixed = fixed + tracks[i].val end
        if tracks[i].kind == "fr" is fr_sum = fr_sum + tracks[i].val end
        i += 1
    end
    let mut col_w: [int] = []
    i = 0
    while i < ncols is
        let mut cw: int = 0
        if tracks[i].kind == "px" is
            cw = tracks[i].val
        elsif tracks[i].kind == "auto" is
            let mut j: int = 0
            while j < count is
                if pc[j] == i && pcs[j] == 1 is
                    let it: FItem = items[j]
                    let mc: int = if it.is_text then it.basis else max_content(cx, it.id, 0) + it.ml + it.mr
                    if mc > cw is cw = mc end
                end
                j += 1
            end
            fixed = fixed + cw
        end
        col_w = array_push(col_w, cw)
        i += 1
    end
    let remaining: int = w - fixed
    i = 0
    while i < ncols is
        if tracks[i].kind == "fr" is
            col_w[i] = if fr_sum > 0 && remaining > 0 then remaining * tracks[i].val / fr_sum else 0
        end
        i += 1
    end
    let mut col_x: [int] = []
    let mut run_x: int = 0
    i = 0
    while i < ncols is
        col_x = array_push(col_x, run_x)
        run_x = run_x + col_w[i] + st.gap
        i += 1
    end
    ;; 0.4: justify-content / place-content dla ścieżek gridu (gdy nie wypełniają kontenera)
    let free_x: int = w - (run_x - st.gap)
    if free_x > 0 && ncols > 0 is
        let jc: string = st.justify
        let mut base_off: int = 0
        let mut extra_gap: int = 0
        if jc == "center" is base_off = free_x / 2
        elsif jc == "flex-end" is base_off = free_x
        elsif jc == "space-between" && ncols > 1 is extra_gap = free_x / (ncols - 1)
        elsif jc == "space-around" is
            extra_gap = free_x / ncols
            base_off = extra_gap / 2
        elsif jc == "space-evenly" is
            extra_gap = free_x / (ncols + 1)
            base_off = extra_gap
        end
        if base_off > 0 || extra_gap > 0 is
            let mut q: int = 0
            while q < ncols is
                col_x[q] = col_x[q] + base_off + extra_gap * q
                q += 1
            end
        end
    end
    ;; ----- wysokości wierszy -----
    let mut nrows: int = 0
    i = 0
    while i < count is
        if pr[i] + prs[i] > nrows is nrows = pr[i] + prs[i] end
        i += 1
    end
    let row_tracks: [Track] = parse_tracks(st.grid_rows, 100000, st.row_gap)
    let mut auto_rows: [Track] = []
    if st.grid_auto_rows != "" is auto_rows = parse_tracks(st.grid_auto_rows, 100000, st.row_gap) end
    let mut row_h: [int] = []
    let mut row_fixed: [bool] = []
    i = 0
    while i < nrows is
        let mut tr: Track = Track { kind: "auto", val: 0 }
        if i < array_len(row_tracks) is
            tr = row_tracks[i]
        elsif array_len(auto_rows) > 0 is
            tr = auto_rows[0]
        end
        row_h = array_push(row_h, if tr.kind == "px" then tr.val else 0)
        row_fixed = array_push(row_fixed, tr.kind == "px")
        i += 1
    end
    let mut results: [BlockRes] = []
    let mut widths: [int] = []
    i = 0
    while i < count is
        let it: FItem = items[i]
        let mut cw: int = st.gap * (pcs[i] - 1)
        let mut d: int = 0
        while d < pcs[i] is
            cw += col_w[pc[i] + d]
            d += 1
        end
        widths = array_push(widths, cw)
        let jk: string = if it.is_text then "" else justify_kw(cx.styles[it.id], st)
        let stretch: bool = jk == "" || jk == "stretch"
        let mut r: BlockRes = layout_item(cx, it, id, cw - it.ml - it.mr, w, -1, false)
        if !stretch is r = layout_item(cx, it, id, -1, cw - it.ml - it.mr, -1, true) end
        results = array_push(results, r)
        let oh: int = r.h + it.mt + it.mb
        if prs[i] == 1 && !row_fixed[pr[i]] && oh > row_h[pr[i]] is row_h[pr[i]] = oh end
        i += 1
    end
    i = 0
    while i < count is
        if prs[i] > 1 is
            let it: FItem = items[i]
            let r: BlockRes = results[i]
            let mut have: int = st.row_gap * (prs[i] - 1)
            let mut d: int = 0
            while d < prs[i] is
                have += row_h[pr[i] + d]
                d += 1
            end
            let need: int = r.h + it.mt + it.mb
            let last: int = pr[i] + prs[i] - 1
            if need > have && !row_fixed[last] is row_h[last] = row_h[last] + (need - have) end
        end
        i += 1
    end
    let mut row_y: [int] = []
    let mut run_y: int = 0
    i = 0
    while i < nrows is
        row_y = array_push(row_y, run_y)
        run_y = run_y + row_h[i] + st.row_gap
        i += 1
    end
    let total_h: int = if nrows > 0 then run_y - st.row_gap else 0
    ;; ----- ustawienie elementów -----
    let mut acc: [LayoutBox] = boxes
    i = 0
    while i < count is
        let it: FItem = items[i]
        let r: BlockRes = results[i]
        let mut cell_h: int = st.row_gap * (prs[i] - 1)
        let mut d: int = 0
        while d < prs[i] is
            cell_h += row_h[pr[i] + d]
            d += 1
        end
        let mut bx: [LayoutBox] = r.boxes
        let oh: int = r.h + it.mt + it.mb
        let mut dy: int = 0
        let mut dx: int = 0
        if it.align == "center" is
            dy = (cell_h - oh) / 2
        elsif it.align == "flex-end" is
            dy = cell_h - oh
        elsif it.align == "stretch" && !it.is_text && cx.styles[it.id].height_mode == "auto" && array_len(bx) > 0 is
            bx[0].h = cell_h - it.mt - it.mb
        end
        if !it.is_text is
            let jk: string = justify_kw(cx.styles[it.id], st)
            let free: int = widths[i] - it.ml - it.mr - r.w
            if free > 0 is
                if jk == "center" is dx = free / 2 end
                if jk == "flex-end" is dx = free end
            end
        end
        acc = concat_boxes(acc, shift_boxes(bx, x + col_x[pc[i]] + it.ml + dx, y + row_y[pr[i]] + dy))
        i += 1
    end
    return InlineRes { boxes: acc, height: total_h, used_w: w }
end

;; ---------- główny układ bloku ----------

;; =====================================================================
;; 0.3: układ tabel (display: table / table-row / table-cell)
;; =====================================================================
struct TCell is
    pub id:  int
    pub row: int
    pub col: int
    pub cs:  int
    pub rs:  int
end

struct TGrid is
    pub cells: [TCell]
    pub rows:  [int]     ;; id węzłów wierszy (nagłówek, ciało, stopka)
    pub ncols: int
    pub caption: int
end

fn attr_span(cx: LayoutCtx, id: int, name: string) -> int is
    let v: string = dom::get_attr(cx.dom.nodes[id], name)
    if v == "" is return 1 end
    let n: int = str_to_int(v)
    if n < 1 is return 1 end
    if n > 64 is return 64 end
    return n
end

fn push_rows_of(cx: LayoutCtx, parent: int, rows: [int]) -> [int] is
    let mut out: [int] = rows
    let kids: [int] = cx.dom.nodes[parent].children
    let mut i: int = 0
    while i < array_len(kids) is
        let k: int = kids[i]
        i += 1
        if !is_rendered(cx, k) || cx.dom.nodes[k].tag == "text" is continue end
        if cx.styles[k].display == "table-row" is out = array_push(out, k) end
    end
    return out
end

fn table_grid(cx: LayoutCtx, id: int) -> TGrid is
    let kids: [int] = cx.dom.nodes[id].children
    let mut head: [int] = []
    let mut body: [int] = []
    let mut foot: [int] = []
    let mut caption: int = -1
    let mut i: int = 0
    while i < array_len(kids) is
        let k: int = kids[i]
        i += 1
        if !is_rendered(cx, k) || cx.dom.nodes[k].tag == "text" is continue end
        let d: string = cx.styles[k].display
        if d == "table-row" is
            body = array_push(body, k)
        elsif d == "table-header-group" is
            head = push_rows_of(cx, k, head)
        elsif d == "table-row-group" is
            body = push_rows_of(cx, k, body)
        elsif d == "table-footer-group" is
            foot = push_rows_of(cx, k, foot)
        elsif cx.dom.nodes[k].tag == "caption" && caption < 0 is
            caption = k
        end
    end
    let mut rows: [int] = head
    i = 0
    while i < array_len(body) is
        rows = array_push(rows, body[i])
        i += 1
    end
    i = 0
    while i < array_len(foot) is
        rows = array_push(rows, foot[i])
        i += 1
    end
    let nrows: int = array_len(rows)
    let maxc: int = 64
    let mut occ: [bool] = []
    i = 0
    while i < (nrows + 70) * maxc is
        occ = array_push(occ, false)
        i += 1
    end
    let mut cells: [TCell] = []
    let mut ncols: int = 0
    let mut r: int = 0
    while r < nrows is
        let rk: [int] = cx.dom.nodes[rows[r]].children
        let mut c: int = 0
        let mut j: int = 0
        while j < array_len(rk) is
            let cid: int = rk[j]
            j += 1
            if !is_rendered(cx, cid) || cx.dom.nodes[cid].tag == "text" is continue end
            if cx.styles[cid].display != "table-cell" is continue end
            while c < maxc - 1 && occ[r * maxc + c] is c += 1 end
            let cs: int = attr_span(cx, cid, "colspan")
            let mut rs: int = attr_span(cx, cid, "rowspan")
            if r + rs > nrows is rs = nrows - r end
            if c + cs > maxc is cs = maxc - c end
            let mut dr: int = 0
            while dr < rs is
                let mut dc: int = 0
                while dc < cs is
                    occ[(r + dr) * maxc + c + dc] = true
                    dc += 1
                end
                dr += 1
            end
            cells = array_push(cells, TCell { id: cid, row: r, col: c, cs: cs, rs: rs })
            if c + cs > ncols is ncols = c + cs end
            c += cs
        end
        r += 1
    end
    return TGrid { cells: cells, rows: rows, ncols: ncols, caption: caption }
end

;; Najdłuższe słowo w poddrzewie (min-content).
fn min_content(cx: LayoutCtx, id: int, depth: int) -> int is
    let n: dom::DomNode = cx.dom.nodes[id]
    if n.removed || depth > 40 is return 0 end
    if n.tag == "text" is
        let st: style::ComputedStyle = cx.styles[id]
        let words: [string] = string_split(shaped_text(n.text, st), " ")
        let mut best: int = 0
        let mut i: int = 0
        while i < array_len(words) is
            if words[i] != "" is
                let w: int = text_w(cx, words[i], st)
                if w > best is best = w end
            end
            i += 1
        end
        return best
    end
    let st: style::ComputedStyle = cx.styles[id]
    if st.display == "none" || is_out_of_flow(st) is return 0 end
    let own: int = pad_border_h(st)
    if st.width_mode == "px" is
        return if st.border_box then st.width else st.width + own
    end
    if is_replaced(n.tag) is return max_content(cx, id, depth + 1) end
    let mut best: int = 0
    let mut i: int = 0
    while i < array_len(n.children) is
        let c: int = n.children[i]
        i += 1
        if !is_rendered(cx, c) is continue end
        let w: int = min_content(cx, c, depth + 1)
        if w > best is best = w end
    end
    return best + own
end

;; Metryki kolumn: [max_0..max_{n-1}, min_0..min_{n-1}].
fn table_col_metrics(cx: LayoutCtx, g: TGrid, avail: int) -> [int] is
    let nc: int = g.ncols
    let mut mx: [int] = []
    let mut mn: [int] = []
    let mut i: int = 0
    while i < nc is
        mx = array_push(mx, 0)
        mn = array_push(mn, 0)
        i += 1
    end
    ;; najpierw komórki bez colspan
    let mut pass: int = 0
    while pass < 2 is
        let mut k: int = 0
        while k < array_len(g.cells) is
            let c: TCell = g.cells[k]
            k += 1
            if (pass == 0 && c.cs != 1) || (pass == 1 && c.cs == 1) is continue end
            let cst: style::ComputedStyle = cx.styles[c.id]
            let mut cmax: int = max_content(cx, c.id, 0)
            if cst.width_mode == "pct" is
                let want: int = avail * cst.width_pct / 10000 + (if cst.border_box then 0 else pad_border_h(cst))
                if want > cmax is cmax = want end
            end
            let cmin: int = min_content(cx, c.id, 0)
            if c.cs == 1 is
                if cmax > mx[c.col] is mx[c.col] = cmax end
                if cmin > mn[c.col] is mn[c.col] = cmin end
            else is
                let mut sum_mx: int = 0
                let mut sum_mn: int = 0
                let mut d: int = 0
                while d < c.cs is
                    sum_mx += mx[c.col + d]
                    sum_mn += mn[c.col + d]
                    d += 1
                end
                if cmax > sum_mx is
                    let extra: int = (cmax - sum_mx) / c.cs
                    d = 0
                    while d < c.cs is
                        mx[c.col + d] = mx[c.col + d] + extra
                        d += 1
                    end
                end
                if cmin > sum_mn is
                    let extra2: int = (cmin - sum_mn) / c.cs
                    d = 0
                    while d < c.cs is
                        mn[c.col + d] = mn[c.col + d] + extra2
                        d += 1
                    end
                end
            end
        end
        pass += 1
    end
    let mut out: [int] = mx
    i = 0
    while i < nc is
        out = array_push(out, mn[i])
        i += 1
    end
    return out
end

fn table_spacing(st: style::ComputedStyle) -> int is
    if st.border_collapse is return 0 end
    return st.border_spacing
end

fn table_max_content(cx: LayoutCtx, id: int) -> int is
    let st: style::ComputedStyle = cx.styles[id]
    let g: TGrid = table_grid(cx, id)
    if g.ncols == 0 is return pad_border_h(st) end
    let m: [int] = table_col_metrics(cx, g, 0)
    let mut sum: int = 0
    let mut i: int = 0
    while i < g.ncols is
        sum += m[i]
        i += 1
    end
    let sp: int = table_spacing(st)
    return sum + sp * (g.ncols + 1) + pad_border_h(st)
end

fn layout_table(cx: LayoutCtx, id: int, x: int, y: int, w: int, boxes: [LayoutBox]) -> InlineRes is
    let st: style::ComputedStyle = cx.styles[id]
    let g: TGrid = table_grid(cx, id)
    let mut acc: [LayoutBox] = boxes
    let mut cursor: int = y
    let cap_bottom: bool = g.caption >= 0 && string_lower(props::xget(cx.styles[g.caption].xp, "caption-side")) == "bottom"
    if g.caption >= 0 && !cap_bottom is
        let cr: BlockRes = layout_block(cx, g.caption, x, cursor, w, -1, -1, false)
        acc = concat_boxes(acc, cr.boxes)
        cursor = cursor + cr.mt + cr.h + cr.mb
    end
    if g.ncols == 0 is
        if cap_bottom is
            let cr0: BlockRes = layout_block(cx, g.caption, x, cursor, w, -1, -1, false)
            acc = concat_boxes(acc, cr0.boxes)
            cursor = cursor + cr0.mt + cr0.h + cr0.mb
        end
        return InlineRes { boxes: acc, height: cursor - y, used_w: 0 }
    end
    let sp: int = table_spacing(st)
    let nc: int = g.ncols
    let nr: int = array_len(g.rows)
    ;; nakładanie ramek w trybie collapse
    let mut ov: int = 0
    if st.border_collapse && array_len(g.cells) > 0 is ov = cx.styles[g.cells[0].id].bl end
    let avail: int = w - sp * (nc + 1) + (nc - 1) * ov
    let m: [int] = table_col_metrics(cx, g, avail)
    let mut colw: [int] = []
    let mut total_max: int = 0
    let mut total_min: int = 0
    let mut i: int = 0
    while i < nc is
        total_max += m[i]
        total_min += m[nc + i]
        i += 1
    end
    i = 0
    while i < nc is
        let cmax: int = m[i]
        let cmin: int = m[nc + i]
        let mut cw: int = 0
        if st.table_fixed is
            cw = avail / nc
        elsif total_max <= avail is
            cw = if total_max > 0 then cmax + (avail - total_max) * cmax / total_max else avail / nc
        elsif total_min >= avail is
            cw = cmin
        else is
            cw = cmin + (cmax - cmin) * (avail - total_min) / (total_max - total_min)
        end
        colw = array_push(colw, cw)
        i += 1
    end
    ;; reszta z zaokrągleń trafia do ostatniej kolumny (gdy tabela nie przepełnia)
    if total_min < avail || st.table_fixed is
        let mut sum_cols: int = 0
        i = 0
        while i < nc is
            sum_cols += colw[i]
            i += 1
        end
        if sum_cols < avail && (total_max >= avail || total_max > 0 || st.table_fixed) is
            colw[nc - 1] = colw[nc - 1] + (avail - sum_cols)
        end
    end
    ;; przebieg A: układ komórek w (0,0) i wysokości wierszy
    let mut rowh: [int] = []
    i = 0
    while i < nr is
        rowh = array_push(rowh, 0)
        i += 1
    end
    let mut results: [BlockRes] = []
    let mut k: int = 0
    while k < array_len(g.cells) is
        let c: TCell = g.cells[k]
        k += 1
        let mut cwid: int = sp * (c.cs - 1)
        let mut d: int = 0
        while d < c.cs is
            cwid += colw[c.col + d]
            d += 1
        end
        let res: BlockRes = layout_block(cx, c.id, 0, 0, cwid, -1, cwid, false)
        results = array_push(results, res)
        if c.rs == 1 is
            let hh: int = res.h + res.mt + res.mb
            if hh > rowh[c.row] is rowh[c.row] = hh end
        end
    end
    k = 0
    while k < array_len(g.cells) is
        let c: TCell = g.cells[k]
        let res: BlockRes = results[k]
        k += 1
        if c.rs > 1 is
            let mut have: int = sp * (c.rs - 1)
            let mut d: int = 0
            while d < c.rs is
                have += rowh[c.row + d]
                d += 1
            end
            let need: int = res.h + res.mt + res.mb
            if need > have is rowh[c.row + c.rs - 1] = rowh[c.row + c.rs - 1] + (need - have) end
        end
    end
    ;; pozycje kolumn i wierszy
    let mut colx: [int] = []
    let mut cxp: int = x + sp
    i = 0
    while i < nc is
        colx = array_push(colx, cxp)
        cxp = cxp + colw[i] + sp - ov
        i += 1
    end
    let mut rowy: [int] = []
    let mut ryp: int = cursor + sp
    i = 0
    while i < nr is
        rowy = array_push(rowy, ryp)
        ryp = ryp + rowh[i] + sp - ov
        i += 1
    end
    let table_end: int = ryp + ov
    ;; tła wierszy i grup wierszy (przed komórkami)
    let row_w: int = cxp - x - sp + ov + 2 * sp
    i = 0
    while i < nr is
        let rid: int = g.rows[i]
        let gp: int = cx.dom.nodes[rid].parent
        if gp >= 0 && gp != id && is_decorated(cx.styles[gp]) is
            let mut seen: bool = false
            let mut q: int = 0
            while q < array_len(acc) is
                if acc[q].node_id == gp && acc[q].kind == "box" is seen = true end
                q += 1
            end
            if !seen is acc = array_push(acc, no_clip_box(gp, x, rowy[i], row_w, rowh[i], cx.styles[gp], "box")) end
        end
        if is_decorated(cx.styles[rid]) is
            acc = array_push(acc, no_clip_box(rid, x, rowy[i], row_w, rowh[i], cx.styles[rid], "box"))
        end
        i += 1
    end
    ;; przebieg B: ustawienie komórek
    k = 0
    while k < array_len(g.cells) is
        let c: TCell = g.cells[k]
        let res: BlockRes = results[k]
        k += 1
        let mut cell_h: int = sp * (c.rs - 1)
        let mut d: int = 0
        while d < c.rs is
            cell_h += rowh[c.row + d]
            d += 1
        end
        let used: int = res.h + res.mt + res.mb
        let mut placed: [LayoutBox] = res.boxes
        let cst: style::ComputedStyle = cx.styles[c.id]
        ;; empty-cells: hide — pusta komórka bez ramek/tła (tylko przy border-collapse: separate)
        if !st.border_collapse && string_lower(props::xget(cst.xp, "empty-cells")) == "hide" && cell_is_empty(cx, c.id) is continue end
        ;; rozciągnięcie tła komórki do wysokości wiersza
        if array_len(placed) > 0 is placed[0].h = cell_h - res.mt - res.mb end
        let spare: int = cell_h - used
        if spare > 0 && array_len(placed) > 1 is
            let shift: int = if cst.valign == "middle" then spare / 2 elsif cst.valign == "bottom" then spare else 0
            if shift > 0 is
                let mut inner: [LayoutBox] = []
                let mut p: int = 1
                while p < array_len(placed) is
                    inner = array_push(inner, placed[p])
                    p += 1
                end
                inner = shift_boxes(inner, 0, shift)
                let mut rebuilt: [LayoutBox] = [placed[0]]
                rebuilt = concat_boxes(rebuilt, inner)
                placed = rebuilt
            end
        end
        acc = concat_boxes(acc, shift_boxes(placed, colx[c.col] - res.ml, rowy[c.row]))
    end
    let mut end_y: int = table_end
    if cap_bottom is
        let cr1: BlockRes = layout_block(cx, g.caption, x, table_end, w, -1, -1, false)
        acc = concat_boxes(acc, cr1.boxes)
        end_y = table_end + cr1.mt + cr1.h + cr1.mb
    end
    return InlineRes { boxes: acc, height: end_y - y, used_w: cxp - x }
end

;; Komórka bez treści (same białe znaki / brak dzieci) — dla `empty-cells`.
fn cell_is_empty(cx: LayoutCtx, id: int) -> bool is
    let n: dom::DomNode = cx.dom.nodes[id]
    let mut i: int = 0
    while i < array_len(n.children) is
        let c: dom::DomNode = cx.dom.nodes[n.children[i]]
        i += 1
        if c.removed is continue end
        if c.tag == "text" is
            if string_trim(c.text) != "" is return false end
        else is
            return false
        end
    end
    return true
end


;; ---------- układ wielokolumnowy (column-count / column-width / column-gap / column-rule / column-fill) ----------
fn xlen_px(cx: LayoutCtx, st: style::ComputedStyle, val: string, dflt: int) -> int is
    if val == "" is return dflt end
    let low: string = string_lower(val)
    if low == "thin" is return 1 end
    if low == "medium" is return 3 end
    if low == "thick" is return 5 end
    let l: cssval::Len = cssval::parse_len(val, cssval::LenEnv { em: st.font_size, rem: 16, vw: cx.vw, vh: cx.vh })
    if !l.ok || l.auto is return dflt end
    return cssval::px_of(l, 0)
end

;; [liczba kolumn, szerokość kolumny, odstęp]; liczba kolumn 1 = brak wielokolumnowości.
fn column_plan(cx: LayoutCtx, st: style::ComputedStyle, cw: int) -> [int] is
    let cnt_s: string = props::xget(st.xp, "column-count")
    let cnt: int = if props::is_int(cnt_s) then str_to_int(cnt_s) else 0
    let wpx: int = xlen_px(cx, st, props::xget(st.xp, "column-width"), 0)
    if (cnt <= 0 && wpx <= 0) || cw <= 0 is return [1, cw, 0] end
    let gap: int = if props::xhas(st.xp, "column-gap") then st.gap else st.font_size
    let mut n: int = cnt
    if wpx > 0 is
        let fit: int = (cw + gap) / (wpx + gap)
        let f2: int = if fit < 1 then 1 else fit
        n = if cnt > 0 && cnt < f2 then cnt else f2
    end
    if n < 1 is n = 1 end
    let colw: int = (cw - (n - 1) * gap) / n
    return [n, if colw < 1 then 1 else colw, gap]
end

fn break_avoid(st: style::ComputedStyle) -> bool is
    let a: string = props::xget(st.xp, "break-inside")
    let b: string = props::xget(st.xp, "page-break-inside")
    return a == "avoid" || a == "avoid-column" || b == "avoid"
end

fn wants_col_break(st: style::ComputedStyle, which: string) -> bool is
    let v: string = props::xget(st.xp, "break-" + which)
    if v == "column" || v == "always" || v == "all" is return true end
    let l: string = props::xget(st.xp, "page-break-" + which)
    return l == "always"
end

fn rule_box(cx: LayoutCtx, id: int, st: style::ComputedStyle, x: int, y: int, w: int, h: int, c: style::Color) -> LayoutBox is
    let mut s: style::ComputedStyle = style::copy_style(st)
    s.has_bg = true
    s.background = c
    s.has_grad = false
    s.bg_image = ""
    s.bt = 0
    s.br = 0
    s.bb = 0
    s.bl = 0
    s.pad_top = 0
    s.pad_right = 0
    s.pad_bottom = 0
    s.pad_left = 0
    s.rad_tl = 0
    s.rad_tr = 0
    s.rad_br = 0
    s.rad_bl = 0
    s.has_shadow = false
    s.outline_w = 0
    s.xp = ""
    return no_clip_box(id, x, y, w, h, s, "box")
end

;; Rozkłada gotowy przepływ (szerokość jednej kolumny) na `n` kolumn. Wiersze tekstu trafiają do kolumny wg y,
;; pudełka przecinające granicę są dzielone (box-decoration-break: slice lub clone).
fn split_columns(cx: LayoutCtx, id: int, st: style::ComputedStyle, flow: InlineRes, x0: int, y0: int, plan: [int], fixed_h: int) -> InlineRes is
    let n0: int = plan[0]
    let colw: int = plan[1]
    let gap: int = plan[2]
    let total: int = flow.height
    let lh: int = if line_h_of(st) > 0 then line_h_of(st) else 1
    ;; 0.4: column-height (stała wysokość kolumn) i column-wrap (wrap = nadmiar kolumn w nowych rzędach; nowrap/auto = kolumny w prawo)
    let colh_v: string = string_lower(string_trim(props::xget(st.xp, "column-height")))
    let colh: int = if colh_v == "" || colh_v == "auto" then 0 else xlen_px(cx, st, colh_v, 0)
    let wrap_cols: bool = string_lower(string_trim(props::xget(st.xp, "column-wrap"))) == "wrap"
    let mut n: int = n0
    let mut perrow: int = n0
    let mut rows: int = 1
    if colh > 0 is
        let mut needed: int = (total + colh - 1) / colh
        if needed < 1 is needed = 1 end
        if wrap_cols is
            rows = (needed + n0 - 1) / n0
            n = needed
            perrow = n0
        else is
            n = if needed > n0 then needed else n0
            perrow = n
        end
    end
    let fill_auto: bool = (props::xget(st.xp, "column-fill") == "auto" && fixed_h > 0) || colh > 0
    let mut th: int = if colh > 0 then colh elsif fill_auto then fixed_h else (total + n - 1) / n
    if th < 1 is th = 1 end
    if !fill_auto is
        ;; zaokrąglij do wielokrotności wysokości wiersza tylko, gdy bez tego jakiś wiersz tekstu przecinałby granicę kolumny
        let mut straddle: bool = false
        let mut q: int = 0
        while q < array_len(flow.boxes) is
            let tb: LayoutBox = flow.boxes[q]
            q += 1
            if tb.kind == "text" && tb.h > 0 is
                let r0: int = tb.y - y0
                if r0 / th != (r0 + tb.h - 1) / th is straddle = true end
            end
        end
        if straddle is th = ((th + lh - 1) / lh) * lh end
    end
    let clone: bool = props::xget(st.xp, "box-decoration-break") == "clone"
    let mut out: [LayoutBox] = []
    let mut push: int = 0
    let mut after_mark: int = -1
    ;; orphans/widows: akapit = tekstowe boxy jednego przodka blokowego
    let mut pk: [int] = []      ;; id bloku
    let mut pn: [int] = []      ;; liczba wierszy
    let mut ps: [int] = []      ;; ile już przetworzono
    let mut pm: [int] = []      ;; od którego wiersza przenieść do następnej kolumny (-1 = brak)
    let mut qq: int = 0
    while qq < array_len(flow.boxes) is
        let tb2: LayoutBox = flow.boxes[qq]
        qq += 1
        if tb2.kind == "text" && tb2.h > 0 && tb2.node_id > 0 is
            let blk0: int = block_ancestor(cx, tb2.node_id)
            let pi: int = int_pos(pk, blk0)
            if pi < 0 is
                pk = array_push(pk, blk0)
                pn = array_push(pn, 1)
                ps = array_push(ps, 0)
                pm = array_push(pm, -1)
            else is
                pn[pi] = pn[pi] + 1
            end
        end
    end
    let mut i: int = 0
    while i < array_len(flow.boxes) is
        let b: LayoutBox = flow.boxes[i]
        i += 1
        let mut rel: int = b.y - y0 + push
        let mut col: int = if rel <= 0 then 0 else rel / th
        if col > n - 1 is col = n - 1 end
        ;; orphans / widows: akapit przecinający granicę kolumny nie zostawia mniej niż N wierszy po żadnej stronie
        if b.kind == "text" && b.h > 0 && b.node_id > 0 && col < n - 1 is
            let blk: int = block_ancestor(cx, b.node_id)
            let pj: int = int_pos(pk, blk)
            if pj >= 0 is
                let li: int = ps[pj]
                ps[pj] = li + 1
                if li == 0 is
                    let ow: [int] = orphans_widows_of(cx, blk)
                    let into0: int = rel - col * th
                    let fit: int = (th - into0) / b.h
                    let total_lines: int = pn[pj]
                    if total_lines > fit is
                        let remaining: int = total_lines - fit
                        let mut mv: int = fit
                        if mv < ow[0] is
                            mv = 0
                        elsif remaining < ow[1] is
                            mv = total_lines - ow[1]
                            if mv < ow[0] is mv = 0 end
                        end
                        pm[pj] = mv
                    end
                end
                if pm[pj] >= 0 && li == pm[pj] is
                    let delta_ow: int = (col + 1) * th - rel
                    if delta_ow > 0 is
                        push += delta_ow
                        rel += delta_ow
                        col += 1
                    end
                    pm[pj] = -1
                end
            end
        end
        ;; wymuszony podział (break-before: column) i break-inside: avoid przesuwają treść do następnej kolumny
        if b.kind == "box" && b.node_id > 0 && b.node_id != id && col < n - 1 is
            let into: int = rel - col * th
            let forced: bool = wants_col_break(b.st, "before") && into > 0
            let straddle: bool = break_avoid(b.st) && b.h <= th && into + b.h > th
            if forced || straddle is
                let delta: int = (col + 1) * th - rel
                push += delta
                rel += delta
                col += 1
            end
        end
        if after_mark >= 0 && b.y >= after_mark && col < n - 1 && rel - col * th > 0 is
            let delta2: int = (col + 1) * th - rel
            push += delta2
            rel += delta2
            col += 1
            after_mark = -1
        end
        if b.kind == "box" && b.node_id > 0 && b.node_id != id && wants_col_break(b.st, "after") is after_mark = b.y + b.h end
        if b.kind == "box" && b.h > th / 2 is
            ;; pudełko, które może przekraczać granicę kolumny → podział
            let mut cur: int = rel
            let mut remaining: int = b.h
            let mut first: bool = true
            while remaining > 0 && col < n is
                let room: int = if col == n - 1 then remaining else (col + 1) * th - cur
                let ph: int = if remaining < room then remaining else room
                let mut pb: LayoutBox = copy_box(b)
                pb.x = b.x + (col % perrow) * (colw + gap)
                pb.y = y0 + (col / perrow) * (th + gap) + cur - col * th
                pb.h = ph
                if has_clip_dummy(b) is
                    pb.cx = b.cx + (col % perrow) * (colw + gap)
                    pb.cy = b.cy + push - col * th + (col / perrow) * (th + gap)
                end
                remaining = remaining - ph
                ;; box-decoration-break czytamy ze stylu dzielonego pudełka (nie tylko kontenera kolumn)
                if !(clone || string_lower(props::xget(b.st.xp, "box-decoration-break")) == "clone") is
                    if !first is
                        pb.st.bt = 0
                        pb.st.rad_tl = 0
                        pb.st.rad_tr = 0
                    end
                    if remaining > 0 is
                        pb.st.bb = 0
                        pb.st.rad_bl = 0
                        pb.st.rad_br = 0
                    end
                end
                out = array_push(out, pb)
                first = false
                cur = cur + ph
                col += 1
            end
        else is
            let mut pb: LayoutBox = copy_box(b)
            pb.x = b.x + (col % perrow) * (colw + gap)
            pb.y = y0 + (col / perrow) * (th + gap) + rel - col * th
            if b.has_clip is
                pb.cx = b.cx + (col % perrow) * (colw + gap)
                pb.cy = b.cy + push - col * th + (col / perrow) * (th + gap)
            end
            out = array_push(out, pb)
        end
    end
    ;; linie między kolumnami
    let rs: string = props::xget(st.xp, "column-rule-style")
    let rw: int = xlen_px(cx, st, props::xval(st.xp, "column-rule-width"), 3)
    if rs != "" && rs != "none" && rs != "hidden" && rw > 0 && n > 1 is
        let rc_s: string = props::xget(st.xp, "column-rule-color")
        let rc: style::Color = if rc_s == "" || string_lower(rc_s) == "currentcolor" then st.color else style::parse_color(rc_s)
        let mut k: int = 1
        while k < n is
            if k % perrow != 0 is
                let rx: int = x0 + (k % perrow) * (colw + gap) - gap / 2 - rw / 2
                let ry: int = y0 + (k / perrow) * (th + gap)
                out = array_push(out, rule_box(cx, id, st, rx, ry, rw, if rows == 1 && total < th then total else th, rc))
            end
            k += 1
        end
    end
    let res_h: int = if rows > 1 then rows * th + (rows - 1) * gap elsif total < th then total else th
    return InlineRes { boxes: out, height: res_h, used_w: perrow * colw + (perrow - 1) * gap }
end

;; 0.4: orphans / widows — najbliższy przodek blokowy węzła tekstowego i wartości (domyślnie 2).
fn block_ancestor(cx: LayoutCtx, node: int) -> int is
    let mut cur: int = node
    let mut guard: int = 0
    while cur > 0 && guard < 64 is
        let d: string = cx.styles[cur].display
        if d != "inline" && d != "contents" is return cur end
        cur = cx.dom.nodes[cur].parent
        guard += 1
    end
    return cur
end

fn orphans_widows_of(cx: LayoutCtx, blk: int) -> [int] is
    if blk < 0 is return [2, 2] end
    let xp: string = cx.styles[blk].xp
    let o: int = if props::xget(xp, "orphans") == "" then 2 else str_to_int(props::xget(xp, "orphans"))
    let w: int = if props::xget(xp, "widows") == "" then 2 else str_to_int(props::xget(xp, "widows"))
    return [if o < 1 then 1 else o, if w < 1 then 1 else w]
end

fn int_pos(xs: [int], v: int) -> int is
    let mut i: int = 0
    while i < array_len(xs) is
        if xs[i] == v is return i end
        i += 1
    end
    return -1
end

;; 0.4: scrollbar-gutter — [lewy, prawy] zarezerwowany pas na pasek przewijania (paski są nakładkowe, więc tylko `stable`).
pub fn scrollbar_gutter_px(st: style::ComputedStyle) -> [int] is
    let v: string = string_lower(props::xget(st.xp, "scrollbar-gutter"))
    if v == "" || v == "auto" is return [0, 0] end
    if props::xget(st.xp, "scrollbar-width") == "none" is return [0, 0] end
    if st.overflow_y == "visible" is return [0, 0] end
    if !trim_token(v, "stable") is return [0, 0] end
    let w: int = if props::xget(st.xp, "scrollbar-width") == "thin" then 6 else 8
    if trim_token(v, "both-edges") is return [w, w] end
    return [0, w]
end

;; 0.4: margin-trim — zerowanie marginesów dzieci przy krawędziach kontenera blokowego.
fn trim_token(v: string, tok: string) -> bool is
    let t: [string] = cssval::split_top(v)
    let mut i: int = 0
    while i < array_len(t) is
        if t[i] == tok is return true end
        i += 1
    end
    return false
end

fn apply_margin_trim(cx: LayoutCtx, id: int) -> LayoutCtx is
    let v: string = string_lower(props::xget(cx.styles[id].xp, "margin-trim"))
    if v == "" || v == "none" is return cx end
    let tb: bool = trim_token(v, "block") || trim_token(v, "block-start")
    let te: bool = trim_token(v, "block") || trim_token(v, "block-end")
    let il: bool = trim_token(v, "inline") || trim_token(v, "inline-start")
    let ir: bool = trim_token(v, "inline") || trim_token(v, "inline-end")
    let kids: [int] = cx.dom.nodes[id].children
    let mut live: [int] = []
    let mut i: int = 0
    while i < array_len(kids) is
        let k: int = kids[i]
        i += 1
        let n: dom::DomNode = cx.dom.nodes[k]
        if n.removed || n.tag == "text" is continue end
        let kst: style::ComputedStyle = cx.styles[k]
        if kst.display == "none" || kst.display == "inline" || is_out_of_flow(kst) is continue end
        live = array_push(live, k)
    end
    if array_len(live) == 0 is return cx end
    let mut cx2: LayoutCtx = cx
    if tb is cx2.styles[live[0]].mar_top = 0 end
    if te is cx2.styles[live[array_len(live) - 1]].mar_bottom = 0 end
    if il || ir is
        let mut j: int = 0
        while j < array_len(live) is
            if il is cx2.styles[live[j]].mar_left = 0 end
            if ir is cx2.styles[live[j]].mar_right = 0 end
            j += 1
        end
    end
    return cx2
end

;; 0.4: column-span: all — element blokowy w kontenerze wielokolumnowym rozciągnięty na wszystkie kolumny.
fn is_col_spanner(cx: LayoutCtx, kid: int) -> bool is
    let n: dom::DomNode = cx.dom.nodes[kid]
    if n.removed || n.tag == "text" || n.pseudo != "" is return false end
    let st: style::ComputedStyle = cx.styles[kid]
    if st.display == "none" || st.display == "inline" || is_out_of_flow(st) is return false end
    return string_lower(props::xget(st.xp, "column-span")) == "all"
end

fn has_col_spanner(cx: LayoutCtx, id: int) -> bool is
    let kids: [int] = cx.dom.nodes[id].children
    let mut i: int = 0
    while i < array_len(kids) is
        if is_col_spanner(cx, kids[i]) is return true end
        i += 1
    end
    return false
end

fn layout_col_segment(cx: LayoutCtx, id: int, st: style::ComputedStyle, seg: [int], x0: int, y: int, plan: [int], fixed_h: int) -> InlineRes is
    let mut cx2: LayoutCtx = cx
    cx2.dom.nodes[id].children = seg
    let r0: InlineRes = layout_flow(cx2, id, x0, y, plan[1], fixed_h, [])
    return split_columns(cx2, id, st, r0, x0, y, plan, fixed_h)
end

fn layout_spanned(cx: LayoutCtx, id: int, st: style::ComputedStyle, x0: int, y0: int, cw: int, plan: [int], fixed_h: int) -> InlineRes is
    let kids: [int] = cx.dom.nodes[id].children
    let mut acc: [LayoutBox] = []
    let mut y: int = y0
    let mut seg: [int] = []
    let mut i: int = 0
    while i < array_len(kids) is
        let k: int = kids[i]
        i += 1
        if is_col_spanner(cx, k) is
            if array_len(seg) > 0 is
                let r: InlineRes = layout_col_segment(cx, id, st, seg, x0, y, plan, -1)
                acc = concat_boxes(acc, r.boxes)
                y = y + r.height
                seg = []
            end
            let sr: BlockRes = layout_block(cx, k, x0, y, cw, -1, -1, false)
            acc = concat_boxes(acc, sr.boxes)
            y = y + sr.mt + sr.h + sr.mb
        else is
            seg = array_push(seg, k)
        end
    end
    if array_len(seg) > 0 is
        let r2: InlineRes = layout_col_segment(cx, id, st, seg, x0, y, plan, if y == y0 then fixed_h else -1)
        acc = concat_boxes(acc, r2.boxes)
        y = y + r2.height
    end
    return InlineRes { boxes: acc, height: y - y0, used_w: cw }
end

fn has_clip_dummy(b: LayoutBox) -> bool is
    return b.has_clip
end

;; 0.4: overflow-clip-margin (tylko przy overflow: clip) — prostokąt przycięcia [x, y, w, h]; (px,py,pw,ph) = pole paddingu.
;; Składnia: [content-box | padding-box | border-box] || <długość>
;; 0.4: overflow-clip-margin-{top,right,bottom,left,block,inline} — pierwsza token to długość (słowa kluczowe pola pomijane)
fn clip_side(st: style::ComputedStyle, side: string, logical: string) -> string is
    let mut v: string = string_trim(props::xget(st.xp, "overflow-clip-margin-" + side))
    if v == "" is v = string_trim(props::xget(st.xp, "overflow-clip-margin-" + logical)) end
    if v == "" is return "" end
    let t: [string] = cssval::split_top(string_lower(v))
    let mut i: int = 0
    while i < array_len(t) is
        if t[i] != "content-box" && t[i] != "padding-box" && t[i] != "border-box" is return t[i] end
        i += 1
    end
    return ""
end

pub fn clip_margin_rect(st: style::ComputedStyle, px: int, py: int, pw: int, ph: int) -> [int] is
    if st.overflow_x != "clip" && st.overflow_y != "clip" is return [px, py, pw, ph] end
    let v: string = string_lower(props::xget(st.xp, "overflow-clip-margin"))
    let cm_t: string = clip_side(st, "top", "block")
    let cm_r: string = clip_side(st, "right", "inline")
    let cm_b: string = clip_side(st, "bottom", "block")
    let cm_l: string = clip_side(st, "left", "inline")
    if v == "" && cm_t == "" && cm_r == "" && cm_b == "" && cm_l == "" is return [px, py, pw, ph] end
    let t: [string] = cssval::split_top(v)
    let mut x: int = px
    let mut y: int = py
    let mut w: int = pw
    let mut h: int = ph
    let mut m: int = 0
    let mut i: int = 0
    while i < array_len(t) is
        let tk: string = t[i]
        i += 1
        if tk == "content-box" is
            x = px + st.pad_left
            y = py + st.pad_top
            w = pw - st.pad_left - st.pad_right
            h = ph - st.pad_top - st.pad_bottom
        elsif tk == "border-box" is
            x = px - st.bl
            y = py - st.bt
            w = pw + st.bl + st.br
            h = ph + st.bt + st.bb
        elsif tk != "padding-box" is
            m = gfx::len_px(tk, 0, st.font_size)
        end
    end
    if m < 0 is m = 0 end
    let mut m_t: int = m
    let mut m_r: int = m
    let mut m_b: int = m
    let mut m_l: int = m
    if cm_t != "" is m_t = gfx::len_px(cm_t, 0, st.font_size) end
    if cm_r != "" is m_r = gfx::len_px(cm_r, 0, st.font_size) end
    if cm_b != "" is m_b = gfx::len_px(cm_b, 0, st.font_size) end
    if cm_l != "" is m_l = gfx::len_px(cm_l, 0, st.font_size) end
    if m_t < 0 is m_t = 0 end
    if m_r < 0 is m_r = 0 end
    if m_b < 0 is m_b = 0 end
    if m_l < 0 is m_l = 0 end
    return [x - m_l, y - m_t, w + m_l + m_r, h + m_t + m_b]
end

;; 0.4: contain-intrinsic-width / -inline-size / -size (pierwsza wartość) — rozmiar elementu z `contain: size`
fn intrinsic_w(cx: LayoutCtx, st: style::ComputedStyle) -> int is
    let mut v: string = props::xget(st.xp, "contain-intrinsic-width")
    if v == "" is v = props::xget(st.xp, "contain-intrinsic-inline-size") end
    if v == "" is
        let sz: [string] = cssval::split_top(props::xget(st.xp, "contain-intrinsic-size"))
        if array_len(sz) >= 1 is v = sz[0] end
    end
    if string_starts_with(string_lower(v), "auto ") is v = string_trim(string_slice(v, 5, string_len(v))) end
    return xlen_px(cx, st, v, 0)
end

;; `contain: size | strict` — zawartość nie wpływa na rozmiar elementu
fn size_contained(st: style::ComputedStyle) -> bool is
    let c: string = string_lower(props::xget(st.xp, "contain"))
    return trim_token(c, "size") || trim_token(c, "strict")
end

fn intrinsic_h(cx: LayoutCtx, st: style::ComputedStyle) -> int is
    let mut v: string = props::xget(st.xp, "contain-intrinsic-height")
    if v == "" is v = props::xget(st.xp, "contain-intrinsic-block-size") end
    if v == "" is
        let sz: [string] = cssval::split_top(props::xget(st.xp, "contain-intrinsic-size"))
        if array_len(sz) >= 2 is v = sz[1] elsif array_len(sz) == 1 is v = sz[0] end
    end
    if string_starts_with(string_lower(v), "auto ") is v = string_trim(string_slice(v, 5, string_len(v))) end
    return xlen_px(cx, st, v, 0)
end

;; Odcina boxy poniżej `limit` i dokleja „…” do ostatniego widocznego wiersza.
;; 0.4: CSS Gaps — linie w odstępach flex/grid (column-rule-*, row-rule-*, rule-*). Kolumny/wiersze wyznaczane z obwiedni dzieci.
;; rule-break: none (linia ciągła) | normal (przerywana tam, gdzie element obejmuje odstęp; łączy się przez skrzyżowania) | intersection (osobny odcinek w każdym pasie).
;; rule-edge-inset / rule-interior-inset (a rule-inset dla obu) skracają końce odcinków przy krawędzi kontenera / przy skrzyżowaniu.
fn rule_inset_px(st: style::ComputedStyle, which: string, kind: string) -> int is
    let mut v: string = props::xget(st.xp, which + "-rule-" + kind + "-inset")
    if v == "" is v = props::xget(st.xp, "rule-" + kind + "-inset") end
    if v == "" is v = props::xget(st.xp, which + "-rule-inset") end
    if v == "" is v = props::xget(st.xp, "rule-inset") end
    let it: [string] = cssval::split_top(v)
    if array_len(it) < 1 is return 0 end
    let px: int = gfx::len_px(it[0], 0, st.font_size)
    return if px < 0 then 0 else px
end

fn gap_rule_vals(cx: LayoutCtx, st: style::ComputedStyle, which: string) -> [string] is
    let rs: string = string_lower(props::xget(st.xp, which + "-rule-style"))
    let rwt: string = props::xget(st.xp, which + "-rule-width")
    let mut rw: int = 3
    if rwt != "" is rw = xlen_px(cx, st, rwt, 3) end
    let mut brk: string = string_lower(string_trim(props::xget(st.xp, which + "-rule-break")))
    if brk == "" is brk = string_lower(string_trim(props::xget(st.xp, "rule-break"))) end
    if brk == "" is brk = "normal" end
    return [rs, to_string(rw), props::xget(st.xp, which + "-rule-color"), to_string(rule_inset_px(st, which, "edge")), to_string(rule_inset_px(st, which, "interior")), brk]
end

fn order_by(keys: [int]) -> [int] is
    let mut idx: [int] = []
    let mut i: int = 0
    while i < array_len(keys) is
        let mut at: int = array_len(idx)
        while at > 0 && keys[idx[at - 1]] > keys[i] is at -= 1 end
        let mut nidx: [int] = []
        let mut q: int = 0
        while q <= array_len(idx) is
            if q == at is nidx = array_push(nidx, i) end
            if q < array_len(idx) is nidx = array_push(nidx, idx[q]) end
            q += 1
        end
        idx = nidx
        i += 1
    end
    return idx
end

fn gap_rules(cx: LayoutCtx, id: int, st: style::ComputedStyle, kids: [LayoutBox], cx0: int, cy0: int, cw: int, ch: int) -> [LayoutBox] is
    let mut out: [LayoutBox] = []
    let mut axis: int = 0
    while axis < 2 is
        let col: bool = axis == 0
        let which: string = if col then "column" else "row"
        let rv: [string] = gap_rule_vals(cx, st, which)
        let rw: int = str_to_int(rv[1])
        axis += 1
        if rv[0] == "" || rv[0] == "none" || rv[0] == "hidden" || rw <= 0 is continue end
        let mut rlo: [int] = []
        let mut rhi: [int] = []
        let mut rplo: [int] = []
        let mut rphi: [int] = []
        let mut i: int = 0
        while i < array_len(kids) is
            let b: LayoutBox = kids[i]
            i += 1
            if b.kind != "box" || b.node_id <= 0 || b.node_id >= array_len(cx.dom.nodes) is continue end
            if cx.dom.nodes[b.node_id].parent != id is continue end
            let pos: string = cx.styles[b.node_id].position
            if pos == "absolute" || pos == "fixed" is continue end
            rlo = array_push(rlo, if col then b.x else b.y)
            rhi = array_push(rhi, (if col then b.x else b.y) + (if col then b.w else b.h))
            rplo = array_push(rplo, if col then b.y else b.x)
            rphi = array_push(rphi, (if col then b.y else b.x) + (if col then b.h else b.w))
        end
        if array_len(rlo) < 2 is continue end
        let rc: style::Color = if rv[2] == "" || string_lower(rv[2]) == "currentcolor" then st.color else style::parse_color(rv[2])
        let edge_in: int = str_to_int(rv[3])
        let int_in: int = str_to_int(rv[4])
        let mode: string = rv[5]
        ;; odstępy między kolumnami (po osi reguły)
        let ord: [int] = order_by(rlo)
        let mut mids: [int] = []
        let mut cur_hi: int = rhi[ord[0]]
        let mut k: int = 1
        while k < array_len(ord) is
            let j: int = ord[k]
            if rlo[j] < cur_hi is
                if rhi[j] > cur_hi is cur_hi = rhi[j] end
            else is
                mids = array_push(mids, (cur_hi + rlo[j]) / 2)
                cur_hi = rhi[j]
            end
            k += 1
        end
        ;; pasy prostopadłe (scalone przedziały)
        let ordp: [int] = order_by(rplo)
        let mut blo: [int] = []
        let mut bhi: [int] = []
        k = 0
        while k < array_len(ordp) is
            let j: int = ordp[k]
            k += 1
            if array_len(blo) > 0 && rplo[j] < bhi[array_len(bhi) - 1] is
                if rphi[j] > bhi[array_len(bhi) - 1] is bhi[array_len(bhi) - 1] = rphi[j] end
            else is
                blo = array_push(blo, rplo[j])
                bhi = array_push(bhi, rphi[j])
            end
        end
        let nb: int = array_len(blo)
        let pstart: int = if col then cy0 else cx0
        let plen: int = if col then ch else cw
        let mut g: int = 0
        while g < array_len(mids) is
            let mid: int = mids[g]
            g += 1
            ;; odcinki: [start, koniec, początek przy krawędzi?, koniec przy krawędzi?]
            let mut seg_s: [int] = []
            let mut seg_e: [int] = []
            let mut seg_se: [bool] = []
            let mut seg_ee: [bool] = []
            if mode == "none" || nb <= 1 is
                seg_s = [pstart]
                seg_e = [pstart + plen]
                seg_se = [true]
                seg_ee = [true]
            else is
                let mut run_first: int = -1
                let mut bi: int = 0
                while bi <= nb is
                    let mut present: bool = false
                    if bi < nb is
                        present = true
                        if mode != "intersection" is
                            let mut q: int = 0
                            while q < array_len(rlo) is
                                if rlo[q] < mid && rhi[q] > mid && rplo[q] < bhi[bi] && rphi[q] > blo[bi] is present = false end
                                q += 1
                            end
                        end
                    end
                    if present && run_first < 0 is run_first = bi end
                    let do_close: bool = run_first >= 0 && (!present || mode == "intersection")
                    if do_close is
                        let last: int = if present then bi else bi - 1
                        seg_s = array_push(seg_s, blo[run_first])
                        seg_e = array_push(seg_e, bhi[last])
                        seg_se = array_push(seg_se, run_first == 0)
                        seg_ee = array_push(seg_ee, last == nb - 1)
                        run_first = -1
                    end
                    bi += 1
                end
            end
            let mut si: int = 0
            while si < array_len(seg_s) is
                let s0: int = seg_s[si] + (if seg_se[si] then edge_in else int_in)
                let e0: int = seg_e[si] - (if seg_ee[si] then edge_in else int_in)
                if e0 > s0 is
                    if col is out = array_push(out, rule_box(cx, id, st, mid - rw / 2, s0, rw, e0 - s0, rc))
                    else is out = array_push(out, rule_box(cx, id, st, s0, mid - rw / 2, e0 - s0, rw, rc)) end
                end
                si += 1
            end
        end
    end
    return out
end

;; 0.4: text-group-align — wiersze bloku (zestawione wg text-align w obrębie najszerszego wiersza) przesuwane jako grupa:
;; start | left | center | end | right (none = bez zmian). Dotyczy tekstu, którego najbliższym blokiem jest `id`.
fn group_align(cx: LayoutCtx, id: int, kids: [LayoutBox], cx0: int, cw: int, mode: string) -> [LayoutBox] is
    let mut minx: int = 1000000
    let mut maxx: int = -1000000
    let mut found: bool = false
    let mut i: int = 0
    while i < array_len(kids) is
        let b: LayoutBox = kids[i]
        i += 1
        if (b.kind == "text" || b.kind == "inlinebg") && b.node_id > 0 && block_ancestor(cx, b.node_id) == id is
            found = true
            if b.x < minx is minx = b.x end
            if b.x + b.w > maxx is maxx = b.x + b.w end
        end
    end
    if !found is return kids end
    let g: int = maxx - minx
    let mut target: int = minx
    if mode == "start" || mode == "left" is target = cx0
    elsif mode == "end" || mode == "right" is target = cx0 + cw - g
    elsif mode == "center" is target = cx0 + (cw - g) / 2
    else is return kids end
    let shift: int = target - minx
    if shift == 0 is return kids end
    let mut out: [LayoutBox] = kids
    i = 0
    while i < array_len(out) is
        if (out[i].kind == "text" || out[i].kind == "inlinebg") && out[i].node_id > 0 && block_ancestor(cx, out[i].node_id) == id is
            out[i].x = out[i].x + shift
        end
        i += 1
    end
    return out
end

fn has_text_kid(kids: [LayoutBox]) -> bool is
    let mut i: int = 0
    while i < array_len(kids) is
        if kids[i].kind == "text" is return true end
        i += 1
    end
    return false
end

;; Zwraca [przycięcie z góry, przycięcie z dołu] w px.
fn text_box_trim_px(st: style::ComputedStyle, kids: [LayoutBox]) -> [int] is
    let mut trim: string = string_lower(string_trim(props::xget(st.xp, "text-box-trim")))
    let mut edge: string = string_lower(string_trim(props::xget(st.xp, "text-box-edge")))
    let sh: string = string_lower(string_trim(props::xget(st.xp, "text-box")))
    if sh != "" && sh != "normal" is
        let tk: [string] = cssval::split_top(sh)
        let mut ed: string = ""
        let mut i: int = 0
        while i < array_len(tk) is
            let k: string = tk[i]
            i += 1
            if k == "trim-start" || k == "trim-end" || k == "trim-both" || k == "none" is
                if trim == "" is trim = k end
            else is
                ed = if ed == "" then k else ed + " " + k
            end
        end
        if edge == "" && ed != "" is edge = ed end
    end
    if sh == "normal" is trim = "none" end
    if trim == "" || trim == "none" || !has_text_kid(kids) is return [0, 0] end
    let fs: int = st.font_size
    let lh: int = line_h_of(st)
    let asc: int = fs * 9 / 10
    let desc: int = fs * 3 / 10
    let half: int = (lh - (asc + desc)) / 2
    let et: [string] = cssval::split_top(edge)
    let over: string = if array_len(et) >= 1 then et[0] else "leading"
    let mut under: string = "leading"
    if array_len(et) >= 2 is under = et[1]
    elsif array_len(et) == 1 && et[0] != "leading" is under = "alphabetic"
    end
    let mut top: int = half
    if over == "cap" is top = half + asc - fs * 7 / 10 end
    if over == "ex" is top = half + asc - fs / 2 end
    let mut bot: int = half
    if under == "alphabetic" is bot = half + desc end
    if under == "ideographic" || under == "ideographic-ink" is bot = half + fs / 10 end
    let ts: bool = trim == "trim-start" || trim == "trim-both"
    let te: bool = trim == "trim-end" || trim == "trim-both"
    return [if ts then top else 0, if te then bot else 0]
end

fn clamp_lines(kids: [LayoutBox], limit: int, lh: int, ell: string) -> [LayoutBox] is
    let mut out: [LayoutBox] = []
    let mut last_text: int = -1
    let mut i: int = 0
    while i < array_len(kids) is
        let b: LayoutBox = kids[i]
        i += 1
        if b.y >= limit is continue end
        let mut nb: LayoutBox = copy_box(b)
        if b.kind == "box" && b.y + b.h > limit is nb.h = limit - b.y end
        out = array_push(out, nb)
        if nb.kind == "text" && nb.y >= limit - lh is last_text = array_len(out) - 1 end
    end
    if last_text >= 0 && ell != "" is
        out[last_text].text = out[last_text].text + ell
        out[last_text].w = out[last_text].w + 8 * string_len(ell)
    end
    return out
end

;; 0.4: <text> w SVG jako zwykłe boksy tekstowe (NanoSVG nie rysuje tekstu). (ox,oy,cw,ch) = pole zawartości <svg> w px.
fn svg_text_boxes(cx: LayoutCtx, root: int, ox: int, oy: int, cw: int, ch: int) -> [LayoutBox] is
    let mut res: [LayoutBox] = []
    let els: [int] = svg::text_elements(cx.dom, cx.styles, root)
    if array_len(els) == 0 || cw < 1 || ch < 1 is return res end
    let n: dom::DomNode = cx.dom.nodes[root]
    let mut vb: [int] = svg::view_box(n)
    if array_len(vb) != 4 is
        let nat: [int] = svg::natural_size(n)
        vb = [0, 0, nat[0] * 1000, nat[1] * 1000]
    end
    let k1: int = cw * 1000000 / vb[2]
    let k2: int = ch * 1000000 / vb[3]
    let k: int = if k1 < k2 then k1 else k2
    let offx: int = (cw - vb[2] * k / 1000000) / 2
    let offy: int = (ch - vb[3] * k / 1000000) / 2
    let mut ti: int = 0
    while ti < array_len(els) is
        let tid: int = els[ti]
        ti += 1
        let runs: [string] = svg::text_runs(cx.dom, tid)
        let mut ri: int = 0
        while ri < array_len(runs) is
            let f: [string] = string_split(runs[ri], "\u0001")
            ri += 1
            if array_len(f) < 4 is continue end
            let rid: int = str_to_int(f[2])
            let txt: string = string_trim(f[3])
            if txt == "" is continue end
            let st0: style::ComputedStyle = cx.styles[rid]
            let fill: string = string_lower(string_trim(props::xget(st0.xp, "fill")))
            if fill == "none" is continue end
            let mut bs: style::ComputedStyle = style::copy_style(st0)
            let fpx: int = (st0.font_size * k + 500) / 1000
            bs.font_size = if fpx < 1 then 1 else fpx
            bs.letter_spacing = st0.letter_spacing * k / 1000
            if fill != "" && !string_starts_with(fill, "url(") is
                if fill == "currentcolor" is
                    bs.color = st0.color
                else is
                    let c: cssval::Color = cssval::parse_color(fill)
                    bs.color = style::Color { r: c.r, g: c.g, b: c.b, a: c.a }
                end
            else is
                bs.color = style::Color { r: 0, g: 0, b: 0, a: 255 }
            end
            let fo: string = props::xget(st0.xp, "fill-opacity")
            if fo != "" is bs.color.a = bs.color.a * gfx::parse_x1000(fo) / 1000 end
            let w: int = text_w(cx, txt, bs)
            let px: int = ox + offx + ((str_to_int(f[0]) - vb[0]) * k) / 1000000
            let py: int = oy + offy + ((str_to_int(f[1]) - vb[1]) * k) / 1000000
            let mut dom_b: string = props::xget(st0.xp, "alignment-baseline")
            if dom_b == "" || dom_b == "auto" || dom_b == "baseline" is dom_b = props::xget(st0.xp, "dominant-baseline") end
            let org: [int] = svg::text_origin(px, py, w, bs.font_size, props::xget(st0.xp, "text-anchor"), dom_b, props::xget(st0.xp, "baseline-shift"))
            let mut b: LayoutBox = no_clip_box(rid, org[0], org[1], w, bs.font_size * 12 / 10, bs, "text")
            b.text = txt
            res = array_push(res, b)
        end
    end
    return apply_clip(res, 0, ox, oy, cw, ch)
end

;; 0.4: list-style-image: url(...) → ścieżka obrazka ("" gdy none / brak).
pub fn list_image_url(st: style::ComputedStyle) -> string is
    let v: string = string_trim(props::xget(st.xp, "list-style-image"))
    if !string_starts_with(string_lower(v), "url(") || !string_ends_with(v, ")") is return "" end
    let mut inner: string = string_trim(string_slice(v, 4, string_len(v) - 1))
    if string_len(inner) >= 2 && (string_starts_with(inner, "\"") || string_starts_with(inner, "'")) is
        inner = string_slice(inner, 1, string_len(inner) - 1)
    end
    return inner
end

;; 0.4: zoom — współczynnik w procentach (100 = brak). Akceptuje liczbę (1.5), procent (150%) i `normal`.
pub fn zoom_pct(st: style::ComputedStyle) -> int is
    let v: string = string_lower(string_trim(props::xget(st.xp, "zoom")))
    if v == "" || v == "normal" || v == "1" || v == "100%" is return 100 end
    let mut pct: int = 100
    if string_ends_with(v, "%") is
        pct = str_to_int(string_slice(v, 0, string_len(v) - 1))
    else is
        let dot: int = string_find(v, ".")
        if dot < 0 is
            pct = str_to_int(v) * 100
        else is
            let frac0: string = string_slice(v, dot + 1, string_len(v)) + "00"
            pct = str_to_int(string_slice(v, 0, dot)) * 100 + str_to_int(string_slice(frac0, 0, 2))
        end
    end
    if pct <= 0 is return 100 end
    if pct > 1000 is return 1000 end
    return pct
end

fn zs(v: int, z: int) -> int is
    return (v * z + (if v >= 0 then 50 else -50)) / 100
end

;; Skaluje pudełka (współrzędne od punktu (0,0)) i pola stylu używane przy rysowaniu.
;; 0.4: powiększenie całej strony (pinch-zoom): pudełka (od punktu (0,0)) skalowane o z%
pub fn scale_all(boxes: [LayoutBox], z: int) -> [LayoutBox] is
    return scale_boxes(boxes, z)
end

fn scale_boxes(boxes: [LayoutBox], z: int) -> [LayoutBox] is
    let mut out: [LayoutBox] = []
    let mut ci: int = 0
    while ci < array_len(boxes) is
        out = array_push(out, copy_box(boxes[ci]))
        ci += 1
    end
    let mut i: int = 0
    while i < array_len(out) is
        let b: LayoutBox = out[i]
        out[i].x = zs(b.x, z)
        out[i].y = zs(b.y, z)
        out[i].w = zs(b.w, z)
        out[i].h = zs(b.h, z)
        if b.has_clip is
            out[i].cx = zs(b.cx, z)
            out[i].cy = zs(b.cy, z)
            out[i].cw = zs(b.cw, z)
            out[i].ch = zs(b.ch, z)
        end
        out[i].content_h = zs(b.content_h, z)
        out[i].content_w = zs(b.content_w, z)
        out[i].scroll_y = zs(b.scroll_y, z)
        out[i].scroll_x = zs(b.scroll_x, z)
        out[i].stk_y = zs(b.stk_y, z)
        out[i].stk_max = zs(b.stk_max, z)
        out[i].st.font_size = zs(b.st.font_size, z)
        if b.st.line_height > 0 is out[i].st.line_height = zs(b.st.line_height, z) end
        out[i].st.bl = zs(b.st.bl, z)
        out[i].st.br = zs(b.st.br, z)
        out[i].st.bt = zs(b.st.bt, z)
        out[i].st.bb = zs(b.st.bb, z)
        out[i].st.pad_top = zs(b.st.pad_top, z)
        out[i].st.pad_right = zs(b.st.pad_right, z)
        out[i].st.pad_bottom = zs(b.st.pad_bottom, z)
        out[i].st.pad_left = zs(b.st.pad_left, z)
        out[i].st.rad_tl = zs(b.st.rad_tl, z)
        out[i].st.rad_tr = zs(b.st.rad_tr, z)
        out[i].st.rad_br = zs(b.st.rad_br, z)
        out[i].st.rad_bl = zs(b.st.rad_bl, z)
        out[i].st.sh_x = zs(b.st.sh_x, z)
        out[i].st.sh_y = zs(b.st.sh_y, z)
        out[i].st.sh_blur = zs(b.st.sh_blur, z)
        out[i].st.sh_spread = zs(b.st.sh_spread, z)
        out[i].st.outline_w = zs(b.st.outline_w, z)
        out[i].st.letter_spacing = zs(b.st.letter_spacing, z)
        out[i].st.word_spacing = zs(b.st.word_spacing, z)
        out[i].st.text_indent = zs(b.st.text_indent, z)
        out[i].st.ts_x = zs(b.st.ts_x, z)
        out[i].st.ts_y = zs(b.st.ts_y, z)
        i += 1
    end
    return out
end

;; =====================================================================
;; 0.4: pisma pionowe (writing-mode: vertical-rl | vertical-lr | sideways-rl | sideways-lr)
;; Element jest składany poziomo z szerokością = jego wysokość (rozmiar liniowy), potem warstwa jest obracana o ±90° wokół lewego
;; górnego rogu; rodzic dostaje wymiary zamienione miejscami. Znaki łacińskie są obrócone (jak text-orientation: mixed/sideways);
;; text-orientation: upright i zwijanie do kolejnych kolumn poza zadaną wysokością nie są obsługiwane.
;; =====================================================================
;; 0.4: text-orientation: upright w pionowym trybie — znaki stoją jeden pod drugim (bez obrotu warstwy, jedna kolumna).
;; text-combine-upright: all | digits [2..4] zostawia dane znaki w jednym wierszu (poziomo w kolumnie).
pub fn upright_mode(xp: string) -> bool is
    return wm_kind(xp) != "" && string_lower(string_trim(props::xget(xp, "text-orientation"))) == "upright"
end

;; Maks. długość ciągu cyfr/znaków łączonych: -1 = łącz całość (all), 0 = nie łącz, n = serie cyfr do n znaków.
pub fn combine_limit(xp: string) -> int is
    let v: string = string_lower(string_trim(props::xget(xp, "text-combine-upright")))
    if v == "all" is return -1 end
    if string_starts_with(v, "digits") is
        let rest: string = string_trim(string_slice(v, 6, string_len(v)))
        if rest != "" && props::is_int(rest) is
            let n: int = str_to_int(rest)
            if n >= 2 && n <= 4 is return n end
        end
        return 2
    end
    return 0
end

pub fn stack_chars(text: string, limit: int) -> string is
    if limit == -1 is return text end
    let n: int = string_len(text)
    let mut out: string = ""
    let mut pos: int = 0
    let mut first: bool = true
    while pos < n is
        let c: string = string_at(text, pos)
        if limit > 0 && c >= "0" && c <= "9" is
            let mut e: int = pos
            while e < n && string_at(text, e) >= "0" && string_at(text, e) <= "9" is e += 1 end
            if e - pos <= limit is
                out = out + (if first then "" else "\n") + string_slice(text, pos, e)
                first = false
                pos = e
                continue
            end
            ;; za długa seria cyfr — każda cyfra osobno
            let mut q: int = pos
            while q < e is
                out = out + (if first then "" else "\n") + string_slice(text, q, q + 1)
                first = false
                q += 1
            end
            pos = e
            continue
        end
        let nx: int = ffi_shim::silver_utf8_next(text, pos)
        let step: int = if nx <= pos then pos + 1 else nx
        let e2: int = if step > n then n else step
        out = out + (if first then "" else "\n") + string_slice(text, pos, e2)
        first = false
        pos = step
    end
    return out
end

pub fn wm_kind(xp: string) -> string is
    let v: string = string_lower(string_trim(props::xget(xp, "writing-mode")))
    if v == "vertical-rl" || v == "sideways-rl" is return "rl" end
    if v == "vertical-lr" is return "lr" end
    if v == "sideways-lr" is return "slr" end
    return ""
end

;; "rl" | "lr" | "slr" dla korzenia pionowego pisma (rodzic nie ma tego samego trybu); "" w pozostałych przypadkach.
pub fn vert_kind(cx: LayoutCtx, id: int) -> string is
    if id <= 0 is return "" end
    let st: style::ComputedStyle = cx.styles[id]
    if props::xhas(st.xp, "x-vert-inner") is return "" end
    let k: string = wm_kind(st.xp)
    if k == "" || upright_mode(st.xp) is return "" end
    let par: int = cx.dom.nodes[id].parent
    if par >= 0 && par < array_len(cx.styles) && string_lower(props::xget(cx.styles[par].xp, "writing-mode")) == string_lower(props::xget(st.xp, "writing-mode")) is return "" end
    return k
end

;; Macierz 2D obrotu warstwy pionowej (a,b,c,d,e,f ×1000) dla ramki o wymiarach poziomego układu w × h.
pub fn vert_matrix(kind: string, w: int, h: int) -> [int] is
    if kind == "slr" is return [0, -1000, 1000, 0, 0, w * 1000] end
    return [0, 1000, -1000, 0, h * 1000, 0]
end

fn mirror_block_axis(boxes: [LayoutBox], size: int) -> [LayoutBox] is
    let mut out: [LayoutBox] = boxes
    let mut i: int = 1
    while i < array_len(out) is
        out[i].y = size - out[i].y - out[i].h
        if out[i].has_clip is out[i].cy = size - out[i].cy - out[i].ch end
        i += 1
    end
    return out
end

fn layout_vertical(cx: LayoutCtx, id: int, x: int, y: int, avail_w: int, avail_h: int, force_w: int, fit: bool, kind: string) -> BlockRes is
    let st: style::ComputedStyle = cx.styles[id]
    let own_v: int = pad_border_v(st)
    let mut inline_size: int = style::size_of(st.height, st.height_pct, st.height_mode, avail_h)
    if inline_size >= 0 is
        if !st.border_box is inline_size += own_v end
    else is
        inline_size = if cx.vh > 0 then cx.vh else 480
    end
    ;; osobna tablica stylów z kopią stylu korzenia — `let mut x = cx.styles` w skompilowanym H# współdzieli obiekt i znakowałby też oryginał
    let mut styles2: [style::ComputedStyle] = []
    let mut sk: int = 0
    while sk < array_len(cx.styles) is
        styles2 = array_push(styles2, if sk == id then style::copy_style(cx.styles[sk]) else cx.styles[sk])
        sk += 1
    end
    styles2[id].xp = props::xset(st.xp, "x-vert-inner", "1")
    styles2[id].height_mode = "auto"
    styles2[id].min_height = 0
    let cx2: LayoutCtx = LayoutCtx { dom: cx.dom, styles: styles2, win: cx.win, vw: cx.vw, vh: cx.vh, scrolls: cx.scrolls, floats: [], excl: cx.excl }
    let r: BlockRes = layout_block(cx2, id, 0, 0, inline_size + m_or_zero(st.mar_left) + m_or_zero(st.mar_right), -1, inline_size, false)
    let mut bx: [LayoutBox] = r.boxes
    if kind == "lr" is bx = mirror_block_axis(bx, r.h) end
    return BlockRes { boxes: shift_boxes(bx, x, y), w: r.h, h: r.w, mt: r.mt, mb: r.mb, ml: r.ml, mr: r.mr }
end

pub fn layout_block(cx: LayoutCtx, id: int, x: int, y: int, avail_w: int, avail_h: int, force_w: int, fit: bool) -> BlockRes is
    let vk: string = vert_kind(cx, id)
    if vk != "" is return layout_vertical(cx, id, x, y, avail_w, avail_h, force_w, fit, vk) end
    let z: int = zoom_pct(cx.styles[id])
    if z == 100 is return layout_block_inner(cx, id, x, y, avail_w, avail_h, force_w, fit) end
    ;; wnętrze liczone w jednostkach „bez zoomu”, potem skalowane i przesunięte na miejsce
    let aw: int = avail_w * 100 / z
    let ah: int = if avail_h >= 0 then avail_h * 100 / z else avail_h
    let fw: int = if force_w >= 0 then force_w * 100 / z else force_w
    let r: BlockRes = layout_block_inner(cx, id, 0, 0, aw, ah, fw, fit)
    let sb: [LayoutBox] = shift_boxes(scale_boxes(r.boxes, z), x, y)
    return BlockRes { boxes: sb, w: zs(r.w, z), h: zs(r.h, z), mt: zs(r.mt, z), mb: zs(r.mb, z), ml: zs(r.ml, z), mr: zs(r.mr, z) }
end

fn layout_block_inner(cx: LayoutCtx, id: int, x: int, y: int, avail_w: int, avail_h: int, force_w: int, fit: bool) -> BlockRes is
    let n: dom::DomNode = cx.dom.nodes[id]
    let st: style::ComputedStyle = cx.styles[id]
    let own_h: int = pad_border_h(st)
    let own_v: int = pad_border_v(st)
    let mlz: int = m_or_zero(st.mar_left)
    let mrz: int = m_or_zero(st.mar_right)
    let mt0: int = m_or_zero(st.mar_top)
    let mb0: int = m_or_zero(st.mar_bottom)
    let replaced: bool = is_replaced(n.tag)
    let mut w_spec: int = style::size_of(st.width, st.width_pct, st.width_mode, avail_w)
    let mut h_spec: int = style::size_of(st.height, st.height_pct, st.height_mode, avail_h)
    ;; 0.4: resize — rozmiar ustawiony przez użytkownika (ramka border-box) nadpisuje width/height
    let rz_w: int = scroll_offset(cx, resize_key_w(id))
    let rz_h: int = scroll_offset(cx, resize_key_h(id))
    if rz_w > 0 is
        w_spec = rz_w - own_h
        if st.border_box is w_spec = rz_w end
    end
    if rz_h > 0 is
        h_spec = rz_h - own_v
        if st.border_box is h_spec = rz_h end
    end

    ;; zwijanie marginesów rodzic <-> pierwsze/ostatnie dziecko
    let ctm: int = if st.pad_top == 0 && st.bt == 0 && array_len(n.children) > 0 then collapsed_child_margin(cx, id, false, 0) else 0
    let cmb: int = if st.pad_bottom == 0 && st.bb == 0 && array_len(n.children) > 0 && h_spec < 0 then collapsed_child_margin(cx, id, true, 0) else 0
    let mt: int = if ctm != 0 then collapse_margin(mt0, ctm) else mt0
    let mb: int = if cmb != 0 then collapse_margin(mb0, cmb) else mb0

    let mut border_w: int = 0
    let mut nat: style::BoxSides = style::BoxSides { top: 0, right: 0, bottom: 0, left: 0 }
    if replaced is nat = replaced_natural(cx, id) end
    if force_w >= 0 is
        border_w = force_w
    elsif w_spec >= 0 is
        border_w = if st.border_box then w_spec else w_spec + own_h
    elsif replaced is
        let mut cw: int = nat.right
        if (n.tag == "img" || n.tag == "svg") && h_spec >= 0 && nat.bottom > 0 is
            cw = (if st.border_box then h_spec - own_v else h_spec) * nat.right / nat.bottom
        end
        border_w = cw + own_h
    elsif fit || st.display == "table" is
        let mut mc: int = max_content(cx, id, 0)
        if size_contained(st) is mc = intrinsic_w(cx, st) + own_h end
        let room: int = avail_w - mlz - mrz
        border_w = if mc < room then mc else room
        if border_w < own_h is border_w = own_h end
    else is
        border_w = avail_w - mlz - mrz
    end
    if force_w < 0 is
        let mn: int = style::size_of(st.min_width, st.min_width_pct, "pct", avail_w)
        let mx: int = if st.max_width_mode == "auto" then -1 else style::size_of(st.max_width, st.max_width_pct, st.max_width_mode, avail_w)
        let mn_b: int = if st.border_box then mn else mn + own_h
        let mx_b: int = if mx < 0 then -1 elsif st.border_box then mx else mx + own_h
        border_w = clamp_int(border_w, mn_b, mx_b)
    end
    if border_w < own_h is border_w = own_h end

    ;; marginesy poziome auto
    let mut ml: int = mlz
    let mut mr: int = mrz
    if force_w < 0 is
        let free: int = avail_w - border_w - mlz - mrz
        if st.mar_left == auto_v() && st.mar_right == auto_v() is
            ml = if free > 0 then free / 2 else 0
            mr = if free > 0 then free - free / 2 else 0
        elsif st.mar_left == auto_v() is
            ml = if free > 0 then free else 0
        elsif st.mar_right == auto_v() is
            mr = if free > 0 then free else 0
        end
    end

    let gut: [int] = scrollbar_gutter_px(st)
    let cw: int = border_w - own_h - gut[0] - gut[1]
    let cx0: int = x + ml + st.bl + st.pad_left + gut[0]
    let cy0: int = y + mt + st.bt + st.pad_top
    ;; aspect-ratio: wysokość z szerokości, gdy wysokość jest auto
    if st.aspect_ratio > 0 && h_spec < 0 && !replaced is
        h_spec = if st.border_box then (border_w * 1000 + st.aspect_ratio / 2) / st.aspect_ratio else (cw * 1000 + st.aspect_ratio / 2) / st.aspect_ratio
    end
    let mut inner_h_spec: int = -1
    if h_spec >= 0 is
        inner_h_spec = h_spec
        if st.border_box is inner_h_spec = h_spec - own_v end
        if inner_h_spec < 0 is inner_h_spec = 0 end
    end

    let mut kids: [LayoutBox] = []
    let mut content_h: int = 0
    let cv_hidden: bool = props::xget(st.xp, "content-visibility") == "hidden"
    if cv_hidden || size_contained(st) is
        content_h = intrinsic_h(cx, st)
    elsif replaced is
        content_h = nat.bottom
        if (n.tag == "img" || n.tag == "svg") && nat.right > 0 && w_spec >= 0 && h_spec < 0 is
            content_h = cw * nat.bottom / nat.right
        end
    elsif st.display == "flex" || st.display == "inline-flex" is
        let r: InlineRes = layout_flex(cx, id, cx0, cy0, cw, inner_h_spec, [])
        kids = r.boxes
        content_h = r.height
        kids = concat_boxes(kids, gap_rules(cx, id, st, kids, cx0, cy0, cw, content_h))
    elsif st.display == "grid" is
        let r: InlineRes = layout_grid(cx, id, cx0, cy0, cw, [])
        kids = r.boxes
        content_h = r.height
        kids = concat_boxes(kids, gap_rules(cx, id, st, kids, cx0, cy0, cw, content_h))
    elsif st.display == "table" is
        let r: InlineRes = layout_table(cx, id, cx0, cy0, cw, [])
        kids = r.boxes
        content_h = r.height
    else is
        let plan: [int] = column_plan(cx, st, cw)
        if plan[0] > 1 && has_col_spanner(cx, id) is
            let r: InlineRes = layout_spanned(cx, id, st, cx0, cy0 - ctm, cw, plan, inner_h_spec)
            kids = r.boxes
            content_h = r.height - ctm - cmb
        elsif plan[0] > 1 is
            let r0: InlineRes = layout_flow(apply_margin_trim(cx, id), id, cx0, cy0 - ctm, plan[1], inner_h_spec, [])
            let r: InlineRes = split_columns(cx, id, st, r0, cx0, cy0 - ctm, plan, inner_h_spec)
            kids = r.boxes
            content_h = r.height - ctm - cmb
        else is
            let r: InlineRes = layout_flow(apply_margin_trim(cx, id), id, cx0, cy0 - ctm, cw, inner_h_spec, [])
            kids = r.boxes
            content_h = r.height - ctm - cmb
        end
    end

    let tga: string = string_lower(string_trim(props::xget(st.xp, "text-group-align")))
    if tga != "" && tga != "none" && !replaced && !cv_hidden && st.display != "flex" && st.display != "inline-flex" && st.display != "grid" && st.display != "table" is
        kids = group_align(cx, id, kids, cx0, cw, tga)
    end
    ;; 0.4: text-box-trim / text-box-edge / text-box — przycięcie półdodatku wiersza (przybliżone metryki: ascent 0,9em, descent 0,3em, cap 0,7em, x 0,5em)
    if !replaced && !cv_hidden && st.display != "flex" && st.display != "inline-flex" && st.display != "grid" && st.display != "table" is
        let tb: [int] = text_box_trim_px(st, kids)
        if tb[0] != 0 || tb[1] != 0 is
            kids = shift_boxes(kids, 0, 0 - tb[0])
            content_h = content_h - tb[0] - tb[1]
            if content_h < 0 is content_h = 0 end
        end
    end

    ;; line-clamp: tylko N pierwszych wierszy, ostatni z wielokropkiem
    let mut clamp_s: string = props::xget(st.xp, "line-clamp")
    ;; 0.4: CSS Overflow 4 — max-lines jest składnikiem skrótu line-clamp
    if clamp_s == "" || clamp_s == "none" is clamp_s = props::xget(st.xp, "max-lines") end
    if props::is_int(clamp_s) && !replaced && !cv_hidden is
        let cn: int = str_to_int(clamp_s)
        let lhc: int = line_h_of(st)
        if cn > 0 && content_h > cn * lhc is
            ;; 0.4: block-ellipsis — none | auto | <string>
            let be: string = string_trim(props::xget(st.xp, "block-ellipsis"))
            let mut ell: string = "…"
            if string_lower(be) == "none" is ell = "" end
            if string_len(be) >= 2 && (string_starts_with(be, "\"") || string_starts_with(be, "'")) is
                ell = string_slice(be, 1, string_len(be) - 1)
            end
            kids = clamp_lines(kids, cy0 + cn * lhc, lhc, ell)
            content_h = cn * lhc
        end
    end

    let mut border_h: int = 0
    if h_spec >= 0 is
        border_h = if st.border_box then h_spec else h_spec + own_v
    else is
        border_h = content_h + own_v
    end
    ;; interpolate-size: allow-keywords — trwające przejście wysokości z/do `auto` (znacznik z anim::lerp_style):
    ;; wysokość = interpolacja między liczbą a naturalną wysokością treści
    let ihs: string = props::xget(st.xp, "x-interp-h")
    if ihs != "" && !replaced is
        let ip: [string] = string_split(ihs, ",")
        if array_len(ip) == 3 is
            let ipx: int = str_to_int(ip[1])
            let it: int = str_to_int(ip[2])
            let nat_h: int = content_h + own_v
            if ip[0] == "to-auto" is
                let from_b: int = if st.border_box then ipx else ipx + own_v
                border_h = from_b + (nat_h - from_b) * it / 1000
            elsif ip[0] == "from-auto" is
                let to_b: int = if st.border_box then ipx else ipx + own_v
                border_h = nat_h + (to_b - nat_h) * it / 1000
            end
        end
    end
    let min_h: int = if st.border_box then st.min_height else st.min_height + own_v
    let max_h: int = if st.max_height_mode == "auto" then -1 elsif st.border_box then st.max_height else st.max_height + own_v
    border_h = clamp_int(border_h, min_h, max_h)

    let mut self_box: LayoutBox = no_clip_box(id, x + ml, y + mt, border_w, border_h, st, "box")
    ;; przewijanie / przycinanie
    if style::is_scroll_container(st) is
        let px: int = x + ml + st.bl
        let py: int = y + mt + st.bt
        let pw: int = border_w - st.bl - st.br
        let ph: int = border_h - st.bt - st.bb
        let extent: int = content_h + st.pad_top + st.pad_bottom
        let max_scroll: int = if extent > ph then extent - ph else 0
        let mut sy: int = scroll_offset(cx, id)
        if !has_scroll_entry(cx, id) is
            sy = scroll_start_value(st, true, max_scroll)
            let tgt_y: int = scroll_target_offset(kids, true, cy0)
            if tgt_y >= 0 is sy = tgt_y end
        end
        if sy > max_scroll is sy = max_scroll end
        if sy < 0 is sy = 0 end
        ;; 0.4: przewijanie poziome — szerokość treści z prawej krawędzi dzieci
        let extent_w: int = max_right_edge(kids, px + pw) - px + st.pad_right
        let max_scroll_x: int = if extent_w > pw then extent_w - pw else 0
        let mut sx: int = scroll_offset(cx, scroll_key_x(id))
        if !has_scroll_entry(cx, scroll_key_x(id)) is
            sx = scroll_start_value(st, false, max_scroll_x)
            let tgt_x: int = scroll_target_offset(kids, false, cx0)
            if tgt_x >= 0 is sx = tgt_x end
        end
        if sx > max_scroll_x is sx = max_scroll_x end
        if sx < 0 is sx = 0 end
        kids = shift_boxes(kids, 0 - sx, 0 - sy)
        let cr: [int] = clip_margin_rect(st, px, py, pw, ph)
        kids = apply_clip(kids, 0, cr[0], cr[1], cr[2], cr[3])
        self_box.content_h = extent
        self_box.scroll_y = sy
        self_box.content_w = if extent_w > pw then extent_w else pw
        self_box.scroll_x = sx
    end
    let mut out: [LayoutBox] = [self_box]
    out = concat_boxes(out, kids)

    ;; znacznik listy
    if st.display == "list-item" is
        let marker: string = li_marker(cx, id)
        let lsi: string = list_image_url(st)
        if lsi != "" is
            ;; 0.4: list-style-image — obrazek zamiast znacznika tekstowego
            let lhm: int = line_h_of(st)
            let mut iw: int = lhm
            let mut ih: int = lhm
            if cx.win >= 0 is
                let nw: int = ffi_shim::silver_image_width(cx.win, lsi)
                let nh: int = ffi_shim::silver_image_height(cx.win, lsi)
                if nw > 0 && nh > 0 is
                    iw = nw
                    ih = nh
                    if ih > lhm && lhm > 0 is
                        iw = nw * lhm / nh
                        ih = lhm
                    end
                end
            end
            let imx: int = if st.list_pos == "inside" then cx0 elsif marker_on_right(cx, id, st) then cx0 + cw + 8 else cx0 - iw - 8
            let mut mbi: LayoutBox = no_clip_box(id, imx, cy0 + (lhm - ih) / 2, iw, ih, st, "marker")
            mbi.img_src = lsi
            out = array_push(out, mbi)
        elsif marker != "" is
            let mw: int = text_w(cx, marker, st)
            let mx: int = if st.list_pos == "inside" then cx0 elsif marker_on_right(cx, id, st) then cx0 + cw + 8 else cx0 - mw - 8
            let mut mbx: LayoutBox = no_clip_box(id, mx, cy0, mw, line_h_of(st), st, "marker")
            mbx.text = marker
            out = array_push(out, mbx)
        end
    end
    if n.tag == "img" is
        out[0].img_src = n.attr_src
    end
    if n.tag == "svg" is
        out[0].svg = svg::markup(cx.dom, cx.styles, id, cw, content_h)
        out = concat_boxes(out, svg_text_boxes(cx, id, cx0, cy0, cw, content_h))
    end

    ;; position: relative
    if st.position == "relative" is
        let mut dx: int = 0
        let mut dy: int = 0
        if st.left != auto_v() is
            dx = st.left
        elsif st.right != auto_v() is
            dx = 0 - st.right
        end
        if st.top != auto_v() is
            dy = st.top
        elsif st.bottom != auto_v() is
            dy = 0 - st.bottom
        end
        out = shift_boxes(out, dx, dy)
    end
    return BlockRes { boxes: out, w: border_w, h: border_h, mt: mt, mb: mb, ml: ml, mr: mr }
end

;; ---------- elementy position: absolute / fixed ----------
fn box_rect_of(boxes: [LayoutBox], id: int) -> style::BoxSides is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == "box" is
            return style::BoxSides { top: boxes[i].y, right: boxes[i].w, bottom: boxes[i].h, left: boxes[i].x }
        end
        i += 1
    end
    return style::BoxSides { top: 0, right: 0, bottom: 0, left: 0 }
end

fn positioned_ancestor(cx: LayoutCtx, id: int) -> int is
    let mut p: int = cx.dom.nodes[id].parent
    while p > 0 is
        if cx.styles[p].position != "static" && !cx.dom.nodes[p].removed is return p end
        p = cx.dom.nodes[p].parent
    end
    return -1
end

;; =====================================================================
;; 0.4: CSS Anchor Positioning (anchor-name, position-anchor, anchor(), anchor-size(), position-area,
;; position-try-fallbacks, position-visibility, anchor-scope)
;; =====================================================================
struct AbsPlace is
    pub x:    int
    pub y:    int
    pub res:  BlockRes
    pub fits: bool
    pub found: bool
    pub rw:   int      ;; 0.4: wymiary obszaru (position-area / blok zawierający) — dla position-try-order
    pub rh:   int
end

fn name_in_list(list: string, name: string) -> bool is
    let toks: [string] = cssval::split_commas(string_lower(list))
    let want: string = string_lower(name)
    let mut i: int = 0
    while i < array_len(toks) is
        if string_trim(toks[i]) == want is return true end
        i += 1
    end
    return false
end

;; Prostokąt kotwicy [x, y, w, h] o danej nazwie dla elementu `id` ([] gdy brak). Kotwica nie może być elementem ani jego potomkiem;
;; `anchor-scope` ogranicza widoczność nazwy do poddrzewa; wybierana jest najbliższa poprzedzająca w kolejności dokumentu.
pub fn anchor_rect_for(cx: LayoutCtx, boxes: [LayoutBox], id: int, name: string) -> [int] is
    if name == "" is return [] end
    let n: int = array_len(cx.dom.nodes)
    let mut before: int = -1
    let mut after: int = -1
    let mut i: int = 1
    while i < n is
        if cx.dom.nodes[i].removed || cx.dom.nodes[i].tag == "text" || i == id || is_in_subtree(cx, i, id) is
            i += 1
            continue
        end
        let names: string = props::xget(cx.styles[i].xp, "anchor-name")
        if names != "" && name_in_list(names, name) is
            let mut ok: bool = true
            let mut p: int = i
            let mut guard: int = 0
            while p >= 0 && guard < 200 is
                let sc: string = string_lower(props::xget(cx.styles[p].xp, "anchor-scope"))
                if sc != "" && sc != "none" && (sc == "all" || name_in_list(sc, name)) is
                    if !is_in_subtree(cx, id, p) is ok = false end
                    break
                end
                p = cx.dom.nodes[p].parent
                guard += 1
            end
            if ok is
                if i < id is before = i
                elsif after < 0 is after = i end
            end
        end
        i += 1
    end
    let pick: int = if before >= 0 then before else after
    if pick < 0 is return [] end
    let r: style::BoxSides = box_rect_of(boxes, pick)
    if r.right <= 0 && r.bottom <= 0 is return [] end
    return [r.left, r.top, r.right, r.bottom]
end

;; Reszta wyrażenia po wywołaniu anchor(...) — "+ 8px" / "- 4px" (także wewnątrz calc()) → przesunięcie w px.
fn anchor_offset(raw: string, fs: int) -> int is
    let mut v: string = string_trim(raw)
    let low: string = string_lower(v)
    if string_starts_with(low, "calc(") && string_ends_with(v, ")") is v = string_trim(string_slice(v, 5, string_len(v) - 1)) end
    let p: int = string_find(string_lower(v), "anchor")
    if p < 0 is return 0 end
    let mut i: int = p
    let mut depth: int = 0
    let n: int = string_len(v)
    while i < n is
        let c: string = string_at(v, i)
        if c == "(" is depth += 1 end
        if c == ")" is
            depth -= 1
            if depth == 0 is
                i += 1
                break
            end
        end
        i += 1
    end
    let rest: string = string_trim(string_slice(v, i, n))
    if rest == "" is return 0 end
    let sign: int = if string_starts_with(rest, "-") then -1 else 1
    if !string_starts_with(rest, "+") && !string_starts_with(rest, "-") is return 0 end
    return sign * gfx::len_px(string_trim(string_slice(rest, 1, string_len(rest))), 0, fs)
end

;; Wstawka `target` (top/right/bottom/left) po ewentualnym odwróceniu; zwraca auto_v(), gdy brak.
fn anchored_inset(cx: LayoutCtx, boxes: [LayoutBox], id: int, st: style::ComputedStyle, target: string,
                  flip_b: bool, flip_i: bool, def_name: string, cbx: int, cby: int, cbw: int, cbh: int, def_rect: [int]) -> int is
    let src: string = anchor::flip_prop(target, flip_b, flip_i)
    let raw: string = props::xget(st.xp, "-ax-" + src)
    if raw == "" is
        if src == "top" is return st.top end
        if src == "right" is return st.right end
        if src == "bottom" is return st.bottom end
        return st.left
    end
    let args: string = anchor::fn_args(raw, "anchor")
    if args == "" is return auto_v() end
    let sp: [string] = anchor::split_args(args)
    let nm: string = if sp[0] != "" then sp[0] else def_name
    let rect: [int] = if sp[0] != "" then anchor_rect_for(cx, boxes, id, nm) else def_rect
    if array_len(rect) != 4 is
        if sp[2] == "" is return auto_v() end
        return gfx::len_px(sp[2], if target == "left" || target == "right" then cbw else cbh, st.font_size)
    end
    let horizontal: bool = target == "left" || target == "right"
    let word: string = anchor::flip_word(sp[1], flip_b, flip_i)
    let coord: int = anchor::side_coord(word, rect, horizontal)
    if coord == -1000000 is return auto_v() end
    let c2: int = coord + anchor_offset(raw, st.font_size)
    if target == "left" is return c2 - cbx end
    if target == "right" is return cbx + cbw - c2 end
    if target == "top" is return c2 - cby end
    return cby + cbh - c2
end

fn anchor_size_of(cx: LayoutCtx, boxes: [LayoutBox], id: int, st: style::ComputedStyle, prop: string, def_name: string, def_rect: [int]) -> int is
    let raw: string = props::xget(st.xp, "-ax-" + prop)
    if raw == "" is return -1 end
    let args: string = anchor::fn_args(raw, "anchor-size")
    if args == "" is return -1 end
    let sp: [string] = anchor::split_args(args)
    let rect: [int] = if sp[0] != "" then anchor_rect_for(cx, boxes, id, sp[0]) else def_rect
    if array_len(rect) != 4 is
        if sp[2] == "" is return -1 end
        return gfx::len_px(sp[2], 0, st.font_size)
    end
    let word: string = if sp[1] == "" then prop else sp[1]
    let v: int = anchor::size_val(word, rect)
    if v < 0 is return -1 end
    return v + anchor_offset(raw, st.font_size)
end

pub fn uses_anchor(st: style::ComputedStyle) -> bool is
    let area: string = string_lower(string_trim(props::xget(st.xp, "position-area")))
    if area != "" && area != "none" is return true end
    return props::xhas(st.xp, "-ax-top") || props::xhas(st.xp, "-ax-right") || props::xhas(st.xp, "-ax-bottom") || props::xhas(st.xp, "-ax-left") || props::xhas(st.xp, "-ax-width") || props::xhas(st.xp, "-ax-height")
end

fn anchored_place(cx: LayoutCtx, id: int, st: style::ComputedStyle, boxes: [LayoutBox], bx: int, by: int, bw: int, bh: int,
                  flip_b: bool, flip_i: bool) -> AbsPlace is
    let pa: string = string_trim(props::xget(st.xp, "position-anchor"))
    let def_name: string = if pa == "" || string_lower(pa) == "auto" || string_lower(pa) == "none" then "" else pa
    let def_rect: [int] = anchor_rect_for(cx, boxes, id, def_name)
    let area0: string = string_lower(string_trim(props::xget(st.xp, "position-area")))
    let mut cbx: int = bx
    let mut cby: int = by
    let mut cbw: int = bw
    let mut cbh: int = bh
    let mut ha: int = -1
    let mut va: int = -1
    if area0 != "" && area0 != "none" && array_len(def_rect) == 4 is
        let reg: [int] = anchor::area_region(anchor::flip_area(area0, flip_b, flip_i), def_rect, [bx, by, bw, bh])
        cbx = reg[0]
        cby = reg[1]
        cbw = reg[2] - reg[0]
        cbh = reg[3] - reg[1]
        if cbw < 0 is
            cbw = 0
        end
        if cbh < 0 is
            cbh = 0
        end
        ha = reg[4]
        va = reg[5]
    end
    let l: int = anchored_inset(cx, boxes, id, st, "left", flip_b, flip_i, def_name, cbx, cby, cbw, cbh, def_rect)
    let r: int = anchored_inset(cx, boxes, id, st, "right", flip_b, flip_i, def_name, cbx, cby, cbw, cbh, def_rect)
    let t: int = anchored_inset(cx, boxes, id, st, "top", flip_b, flip_i, def_name, cbx, cby, cbw, cbh, def_rect)
    let b: int = anchored_inset(cx, boxes, id, st, "bottom", flip_b, flip_i, def_name, cbx, cby, cbw, cbh, def_rect)
    let mlz: int = m_or_zero(st.mar_left)
    let mrz: int = m_or_zero(st.mar_right)
    let own_h: int = pad_border_h(st)
    let w_spec: int = style::size_of(st.width, st.width_pct, st.width_mode, cbw)
    let aw: int = anchor_size_of(cx, boxes, id, st, "width", def_name, def_rect)
    let ah: int = anchor_size_of(cx, boxes, id, st, "height", def_name, def_rect)
    let mut force: int = -1
    if aw >= 0 is
        force = aw
    elsif w_spec < 0 && l != auto_v() && r != auto_v() is
        force = cbw - l - r - mlz - mrz
        if force < own_h is force = own_h end
    end
    let mut res: BlockRes = layout_block(cx, id, 0, 0, cbw, cbh, force, true)
    if ah >= 0 is
        res.h = ah
        if array_len(res.boxes) > 0 is res.boxes[0].h = ah end
    end
    let have_rect: bool = array_len(def_rect) == 4
    let mut x: int = cbx + mlz
    if l != auto_v() is
        x = cbx + l + mlz
    elsif r != auto_v() is
        x = cbx + cbw - r - res.w - mrz
    elsif ha == 2 is
        x = cbx + cbw - res.w
    elsif ha == 1 && have_rect is
        x = def_rect[0] + def_rect[2] / 2 - res.w / 2
        if x + res.w > cbx + cbw is x = cbx + cbw - res.w end
        if x < cbx is x = cbx end
    end
    let mut y: int = cby + res.mt
    if t != auto_v() is
        y = cby + t + res.mt
    elsif b != auto_v() is
        y = cby + cbh - b - res.h - res.mb
    elsif va == 2 is
        y = cby + cbh - res.h
    elsif va == 1 && have_rect is
        y = def_rect[1] + def_rect[3] / 2 - res.h / 2
        if y + res.h > cby + cbh is y = cby + cbh - res.h end
        if y < cby is y = cby end
    end
    let fits: bool = x >= bx && y >= by && x + res.w <= bx + bw && y + res.h <= by + bh
    return AbsPlace { x: x, y: y, res: res, fits: fits, found: have_rect, rw: cbw, rh: cbh }
end

fn place_abs_anchored(cx: LayoutCtx, id: int, boxes: [LayoutBox], bx: int, by: int, bw: int, bh: int, fixed: bool) -> [LayoutBox] is
    let st: style::ComputedStyle = cx.styles[id]
    let spec: [string] = anchor::try_spec(st.xp)
    let tries: [[int]] = anchor::try_list(spec[1])
    let mut cands: [AbsPlace] = []
    let mut metrics: [int] = []
    let mut k: int = 0
    while k < array_len(tries) is
        let cand: AbsPlace = anchored_place(cx, id, st, boxes, bx, by, bw, bh, tries[k][0] == 1, tries[k][1] == 1)
        cands = array_push(cands, cand)
        metrics = array_push(metrics, anchor::order_metric(spec[0], cand.rw, cand.rh))
        k += 1
    end
    let order: [int] = anchor::sort_by_metric(metrics)
    let mut chosen: AbsPlace = cands[order[0]]
    k = 0
    while k < array_len(order) is
        if cands[order[k]].fits is
            chosen = cands[order[k]]
            break
        end
        k += 1
    end
    let pv: string = string_lower(string_trim(props::xget(st.xp, "position-visibility")))
    if string_find(pv, "no-overflow") >= 0 && !chosen.fits is return boxes end
    if string_find(pv, "anchors-visible") >= 0 && !chosen.found is return boxes end
    let mut placed: [LayoutBox] = shift_boxes(chosen.res.boxes, chosen.x - chosen.res.ml, chosen.y - chosen.res.mt)
    if fixed is
        let mut i: int = 0
        while i < array_len(placed) is
            placed[i].fixed = true
            i += 1
        end
    end
    return concat_boxes(boxes, placed)
end

fn place_abs(cx: LayoutCtx, id: int, boxes: [LayoutBox], doc_h: int) -> [LayoutBox] is
    let st: style::ComputedStyle = cx.styles[id]
    let fixed: bool = st.position == "fixed"
    let anc: int = if fixed then -1 else positioned_ancestor(cx, id)
    let mut bx: int = 0
    let mut by: int = 0
    let mut bw: int = cx.vw
    let mut bh: int = cx.vh
    if !fixed && doc_h > cx.vh is
        bh = doc_h
    end
    if anc >= 0 is
        let r: style::BoxSides = box_rect_of(boxes, anc)
        let a: style::ComputedStyle = cx.styles[anc]
        bx = r.left + a.bl
        by = r.top + a.bt
        bw = r.right - a.bl - a.br
        bh = r.bottom - a.bt - a.bb
    end
    if uses_anchor(st) is return place_abs_anchored(cx, id, boxes, bx, by, bw, bh, fixed) end
    let own_h: int = pad_border_h(st)
    let mlz: int = m_or_zero(st.mar_left)
    let mrz: int = m_or_zero(st.mar_right)
    let w_spec: int = style::size_of(st.width, st.width_pct, st.width_mode, bw)
    let mut force: int = -1
    if w_spec < 0 && st.left != auto_v() && st.right != auto_v() is
        force = bw - st.left - st.right - mlz - mrz
        if force < own_h is force = own_h end
    end
    let res: BlockRes = layout_block(cx, id, 0, 0, bw, bh, force, true)
    let mut x: int = bx + mlz
    if st.left != auto_v() is
        x = bx + st.left + mlz
    elsif st.right != auto_v() is
        x = bx + bw - st.right - res.w - mrz
    end
    let mut y: int = by + res.mt
    if st.top != auto_v() is
        y = by + st.top + res.mt
    elsif st.bottom != auto_v() is
        y = by + bh - st.bottom - res.h - res.mb
    end
    let mut placed: [LayoutBox] = shift_boxes(res.boxes, x - res.ml - 0, y - res.mt)
    if fixed is
        let mut i: int = 0
        while i < array_len(placed) is
            placed[i].fixed = true
            i += 1
        end
    end
    return concat_boxes(boxes, placed)
end


