fn is_in_subtree(cx: LayoutCtx, id: int, root: int) -> bool is
    let mut cur: int = id
    let mut guard: int = 0
    while cur >= 0 && guard < 200 is
        if cur == root is return true end
        cur = cx.dom.nodes[cur].parent
        guard += 1
    end
    return false
end

fn clamp255(v: int) -> int is
    if v < 0 is return 0 end
    if v > 255 is return 255 end
    return v
end

;; filter: brightness → contrast → grayscale → sepia → invert (alfa bez zmian).
fn filter_rgb(c: style::Color, f: style::ComputedStyle) -> style::Color is
    let mut r: int = c.r
    let mut g: int = c.g
    let mut b: int = c.b
    if f.f_bright != 100 is
        r = clamp255(r * f.f_bright / 100)
        g = clamp255(g * f.f_bright / 100)
        b = clamp255(b * f.f_bright / 100)
    end
    if f.f_contrast != 100 is
        r = clamp255((r - 128) * f.f_contrast / 100 + 128)
        g = clamp255((g - 128) * f.f_contrast / 100 + 128)
        b = clamp255((b - 128) * f.f_contrast / 100 + 128)
    end
    if f.f_gray > 0 is
        let lum: int = (r * 299 + g * 587 + b * 114) / 1000
        r = r + (lum - r) * f.f_gray / 100
        g = g + (lum - g) * f.f_gray / 100
        b = b + (lum - b) * f.f_gray / 100
    end
    if f.f_sepia > 0 is
        let sr: int = clamp255((r * 393 + g * 769 + b * 189) / 1000)
        let sg: int = clamp255((r * 349 + g * 686 + b * 168) / 1000)
        let sb: int = clamp255((r * 272 + g * 534 + b * 131) / 1000)
        r = r + (sr - r) * f.f_sepia / 100
        g = g + (sg - g) * f.f_sepia / 100
        b = b + (sb - b) * f.f_sepia / 100
    end
    if f.f_invert > 0 is
        r = r + (255 - 2 * r) * f.f_invert / 100
        g = g + (255 - 2 * g) * f.f_invert / 100
        b = b + (255 - 2 * b) * f.f_invert / 100
    end
    return style::Color { r: r, g: g, b: b, a: c.a }
end

fn filter_style(s0: style::ComputedStyle, f: style::ComputedStyle) -> style::ComputedStyle is
    let mut s: style::ComputedStyle = style::copy_style(s0)
    s.color = filter_rgb(s.color, f)
    s.background = filter_rgb(s.background, f)
    s.grad_from = filter_rgb(s.grad_from, f)
    s.grad_to = filter_rgb(s.grad_to, f)
    s.bct = filter_rgb(s.bct, f)
    s.bcr = filter_rgb(s.bcr, f)
    s.bcb = filter_rgb(s.bcb, f)
    s.bcl = filter_rgb(s.bcl, f)
    s.border_color = filter_rgb(s.border_color, f)
    s.sh_color = filter_rgb(s.sh_color, f)
    s.ts_color = filter_rgb(s.ts_color, f)
    s.outline_color = filter_rgb(s.outline_color, f)
    s.deco_color = filter_rgb(s.deco_color, f)
    if f.f_opacity < 100 is s.opacity = s.opacity * f.f_opacity / 100 end
    return s
end

fn clip_len(t: string, reference: int) -> int is
    let v: string = string_lower(string_trim(t))
    if string_ends_with(v, "%") is
        return conv::float_to_int(conv::str_to_float(string_slice(v, 0, string_len(v) - 1)) * conv::int_to_float(reference) / 100.0)
    end
    if string_ends_with(v, "px") is return conv::float_to_int(conv::str_to_float(string_slice(v, 0, string_len(v) - 2))) end
    return conv::float_to_int(conv::str_to_float(v))
end

;; clip-path → prostokąt [x, y, w, h] (przybliżenie bounding-box dla circle/ellipse/polygon); [] gdy brak.
fn clip_rect_of(cp: string, bx: int, by: int, bw: int, bh: int) -> [int] is
    if cp == "" is return [] end
    if string_starts_with(cp, "inset(") is
        let inner: string = string_slice(cp, 6, string_len(cp) - 1)
        let rd: int = string_find(inner, "round")
        let body: string = if rd >= 0 then string_slice(inner, 0, rd) else inner
        let t: [string] = cssval::split_top(body)
        if array_len(t) == 0 is return [] end
        let top: int = clip_len(t[0], bh)
        let right: int = if array_len(t) >= 2 then clip_len(t[1], bw) else clip_len(t[0], bw)
        let bottom: int = if array_len(t) >= 3 then clip_len(t[2], bh) else top
        let left: int = if array_len(t) >= 4 then clip_len(t[3], bw) else right
        let w: int = bw - left - right
        let h: int = bh - top - bottom
        return [bx + left, by + top, if w > 0 then w else 0, if h > 0 then h else 0]
    end
    if string_starts_with(cp, "circle(") || string_starts_with(cp, "ellipse(") is
        let is_circle: bool = string_starts_with(cp, "circle(")
        let inner: string = string_slice(cp, if is_circle then 7 else 8, string_len(cp) - 1)
        let at: int = string_find(inner, " at ")
        let shape: string = if at >= 0 then string_slice(inner, 0, at) else inner
        let pos: string = if at >= 0 then string_slice(inner, at + 4, string_len(inner)) else "50% 50%"
        let pt: [string] = cssval::split_top(pos)
        let mut ccx: int = bx + bw / 2
        let mut ccy: int = by + bh / 2
        if array_len(pt) >= 1 is ccx = bx + clip_len(pt[0], bw) end
        if array_len(pt) >= 2 is ccy = by + clip_len(pt[1], bh) end
        let st: [string] = cssval::split_top(string_trim(shape))
        let half_min: int = (if bw < bh then bw else bh) / 2
        let mut rx: int = half_min
        let mut ry: int = half_min
        if array_len(st) >= 1 && st[0] != "closest-side" && st[0] != "farthest-side" is
            rx = clip_len(st[0], if is_circle then half_min * 2 else bw)
            ry = if is_circle then rx else (if array_len(st) >= 2 then clip_len(st[1], bh) else rx)
        end
        return [ccx - rx, ccy - ry, rx * 2, ry * 2]
    end
    if string_starts_with(cp, "polygon(") is
        let inner: string = string_slice(cp, 8, string_len(cp) - 1)
        let pts: [string] = cssval::split_commas(inner)
        let mut x0: int = 1000000
        let mut y0: int = 1000000
        let mut x1: int = -1000000
        let mut y1: int = -1000000
        let mut i: int = 0
        while i < array_len(pts) is
            let xy: [string] = cssval::split_top(pts[i])
            i += 1
            if array_len(xy) >= 2 is
                if string_lower(xy[0]) == "nonzero" || string_lower(xy[0]) == "evenodd" is continue end
                let px: int = bx + clip_len(xy[0], bw)
                let py: int = by + clip_len(xy[1], bh)
                if px < x0 is x0 = px end
                if px > x1 is x1 = px end
                if py < y0 is y0 = py end
                if py > y1 is y1 = py end
            end
        end
        if x1 < x0 is return [] end
        return [x0, y0, x1 - x0, y1 - y0]
    end
    return []
end

fn clip_one(b0: LayoutBox, rx: int, ry: int, rw: int, rh: int) -> LayoutBox is
    let mut b: LayoutBox = copy_box(b0)
    if b.has_clip is
        let x0: int = if b.cx > rx then b.cx else rx
        let y0: int = if b.cy > ry then b.cy else ry
        let x1: int = if b.cx + b.cw < rx + rw then b.cx + b.cw else rx + rw
        let y1: int = if b.cy + b.ch < ry + rh then b.cy + b.ch else ry + rh
        b.cx = x0
        b.cy = y0
        b.cw = if x1 > x0 then x1 - x0 else 0
        b.ch = if y1 > y0 then y1 - y0 else 0
    else is
        b.has_clip = true
        b.cx = rx
        b.cy = ry
        b.cw = rw
        b.ch = rh
    end
    return b
end

fn scale_len(v: int, k: int) -> int is
    return v * k / 1000
end

;; Stosuje transform (translate + scale) do boxa względem początku (ox, oy).
fn transform_box(b0: LayoutBox, ox: int, oy: int, sx: int, sy: int, tx: int, ty: int) -> LayoutBox is
    let mut b: LayoutBox = copy_box(b0)
    b.x = ox + scale_len(b.x - ox, sx) + tx
    b.y = oy + scale_len(b.y - oy, sy) + ty
    b.w = scale_len(b.w, sx)
    b.h = scale_len(b.h, sy)
    if b.has_clip is
        b.cx = ox + scale_len(b.cx - ox, sx) + tx
        b.cy = oy + scale_len(b.cy - oy, sy) + ty
        b.cw = scale_len(b.cw, sx)
        b.ch = scale_len(b.ch, sy)
    end
    if sx != 1000 || sy != 1000 is
        let k: int = (sx + sy) / 2
        b.st.font_size = if scale_len(b.st.font_size, k) > 1 then scale_len(b.st.font_size, k) else 1
        if b.st.line_height > 0 is b.st.line_height = scale_len(b.st.line_height, k) end
        b.st.bt = scale_len(b.st.bt, sy)
        b.st.bb = scale_len(b.st.bb, sy)
        b.st.bl = scale_len(b.st.bl, sx)
        b.st.br = scale_len(b.st.br, sx)
        b.st.rad_tl = scale_len(b.st.rad_tl, k)
        b.st.rad_tr = scale_len(b.st.rad_tr, k)
        b.st.rad_br = scale_len(b.st.rad_br, k)
        b.st.rad_bl = scale_len(b.st.rad_bl, k)
        b.st.letter_spacing = scale_len(b.st.letter_spacing, k)
    end
    return b
end

fn has_mask_layers(st: style::ComputedStyle) -> bool is
    if gfx::image_kind(props::xget(st.xp, "mask-border-source")) != 0 is return true end
    let l: string = string_lower(props::xget(st.xp, "mask-image"))
    if l == "" || l == "none" is return false end
    let n: int = gfx::list_len(l)
    let mut i: int = 0
    while i < n is
        if gfx::image_kind(gfx::list_at(l, i)) != 0 is return true end
        i += 1
    end
    return false
end

;; 0.4: specyfikacja efektów warstwy: filtry na pikselach (blur/saturate/hue-rotate/drop-shadow), maska, mix-blend-mode.
pub fn fx_spec_of(st: style::ComputedStyle) -> string is
    let mut spec: string = gfx::filter_fx_spec(props::xget(st.xp, "filter"), cssval::Color { r: st.color.r, g: st.color.g, b: st.color.b, a: st.color.a }, st.font_size)
    if has_mask_layers(st) is
        if spec != "" is spec = spec + ";" end
        spec = spec + "mask"
    end
    let bm: string = string_lower(props::xget(st.xp, "mix-blend-mode"))
    if bm != "" && bm != "normal" is
        if spec != "" is spec = spec + ";" end
        spec = spec + "blend:" + bm
    end
    return spec
end

;; 0.4: `clip: rect(t, r, b, l)` — dotyczy elementów pozycjonowanych absolutnie/fixed
pub fn clip_active(st: style::ComputedStyle) -> bool is
    let v: string = string_lower(string_trim(props::xget(st.xp, "clip")))
    return string_starts_with(v, "rect(") && is_out_of_flow(st)
end

;; prostokąt przycięcia [x, y, w, h] względem pudełka b (auto = krawędź pudełka); [] gdy brak
pub fn css_clip_rect(st: style::ComputedStyle, b: LayoutBox) -> [int] is
    let v: string = string_trim(props::xget(st.xp, "clip"))
    let open: int = string_find(v, "(")
    if open < 0 || !string_ends_with(v, ")") is return [] end
    let args: [string] = cssval::split_top(string_replace(string_slice(v, open + 1, string_len(v) - 1), ",", " "))
    if array_len(args) != 4 is return [] end
    let t: int = if string_lower(args[0]) == "auto" then 0 else gfx::len_px(args[0], 0, st.font_size)
    let r: int = if string_lower(args[1]) == "auto" then b.w else gfx::len_px(args[1], 0, st.font_size)
    let bt: int = if string_lower(args[2]) == "auto" then b.h else gfx::len_px(args[2], 0, st.font_size)
    let l: int = if string_lower(args[3]) == "auto" then 0 else gfx::len_px(args[3], 0, st.font_size)
    return [b.x + l, b.y + t, if r > l then r - l else 0, if bt > t then bt - t else 0]
end

;; image-resolution: "<liczba>x|dppx|dpi|dpcm|from-image" (x1000 dppx; 1000 = 1x); 0 gdy domyślne
pub fn image_resolution_x1000(st: style::ComputedStyle) -> int is
    let v: string = string_lower(string_trim(props::xget(st.xp, "image-resolution")))
    if v == "" || v == "from-image" || v == "snap" is return 0 end
    let t: [string] = cssval::split_top(v)
    let mut i: int = 0
    while i < array_len(t) is
        let tk: string = t[i]
        i += 1
        if is_numeric_char(tk) is
            let nl: int = gfx::num_len_pub(tk)
            let n: int = gfx::parse_x1000(string_slice(tk, 0, nl))
            let u: string = string_slice(tk, nl, string_len(tk))
            if n <= 0 is return 0 end
            if u == "dpi" is return n / 96 end
            if u == "dpcm" is return n * 254 / 9600 end
            return n
        end
    end
    return 0
end

;; ====================== 0.4: ruch po ścieżce (offset-*) ======================
pub fn offset_active(st: style::ComputedStyle) -> bool is
    let v: string = string_lower(string_trim(props::xget(st.xp, "offset-path")))
    return v != "" && v != "none"
end

;; Pole zawierające (padding-box rodzica) [x, y, w, h] dla elementu o indeksie `idx` w `boxes`
fn motion_cb(cx: LayoutCtx, boxes: [LayoutBox], idx: int) -> [int] is
    let nid: int = boxes[idx].node_id
    let mut cur: int = cx.dom.nodes[nid].parent
    let mut guard: int = 0
    while cur > 0 && guard < 100 is
        let mut i: int = 0
        while i < array_len(boxes) is
            let b: LayoutBox = boxes[i]
            i += 1
            if b.node_id == cur && b.kind == "box" is
                return [b.x + b.st.bl, b.y + b.st.bt, b.w - b.st.bl - b.st.br, b.h - b.st.bt - b.st.bb]
            end
        end
        cur = cx.dom.nodes[cur].parent
        guard += 1
    end
    return [0, 0, cx.vw, cx.vh]
end

;; Parametry ruchu: [a, b, c, d (x1000), dx, dy (x1000 px), anchor_x, anchor_y (px)]; [] gdy brak ścieżki
pub fn motion_params(cx: LayoutCtx, boxes: [LayoutBox], idx: int, st: style::ComputedStyle) -> [int] is
    if !offset_active(st) is return [] end
    let b: LayoutBox = boxes[idx]
    let cb: [int] = motion_cb(cx, boxes, idx)
    let path: string = string_trim(props::xget(st.xp, "offset-path"))
    let pl: string = string_lower(path)
    let mut pts: [int] = []
    let mut ray: bool = false
    let mut ray_ang: int = 0
    if string_starts_with(pl, "path(") && string_ends_with(path, ")") is
        let mut inner: string = string_trim(string_slice(path, 5, string_len(path) - 1))
        if string_len(inner) >= 2 && (string_starts_with(inner, "\"") || string_starts_with(inner, "'")) is
            inner = string_slice(inner, 1, string_len(inner) - 1)
        end
        pts = svg::flatten_path(inner)
    elsif string_starts_with(pl, "ray(") is
        ray = true
        let args: [string] = cssval::split_top(string_slice(pl, 4, string_len(pl) - 1))
        let mut ai: int = 0
        while ai < array_len(args) is
            let ang: int = gfx::parse_x1000(string_replace(args[ai], "deg", ""))
            if is_numeric_char(args[ai]) is ray_ang = ang end
            ai += 1
        end
    else is
        pts = svg::shape_polyline(path, cb[2], cb[3], st.font_size)
    end
    if !ray && array_len(pts) < 4 is return [] end
    ;; odległość wzdłuż ścieżki
    let total: int = if ray then 0 else svg::poly_length(pts)
    let dv: string = string_lower(string_trim(props::xget(st.xp, "offset-distance")))
    let mut dist: int = 0
    if dv != "" is
        if string_ends_with(dv, "%") is
            dist = total * gfx::parse_x1000(string_slice(dv, 0, string_len(dv) - 1)) / 100000
        else is
            dist = gfx::len_px(dv, 0, st.font_size) * 1000
        end
    end
    let mut pos: [int] = [0, 0, 1000, 0]
    if ray is
        ;; promień z punktu odniesienia (środek pola) pod kątem (0° = w górę)
        let rdeci: int = ray_ang / 100
        let ux: int = style::sin_m(rdeci)
        let uy: int = 0 - style::cos_m(rdeci)
        let o: [int] = ray_origin(props::xget(st.xp, "offset-position"), b, cb, st.font_size)
        pos = [o[0] + dist * ux / 1000, o[1] + dist * uy / 1000, ux, uy]
    else is
        let closed: bool = pts[0] == pts[array_len(pts) - 2] && pts[1] == pts[array_len(pts) - 1]
        pos = svg::poly_sample(pts, dist, closed)
    end
    ;; obrót (offset-rotate): auto | reverse | <kąt> | auto <kąt>
    let rot: string = string_lower(string_trim(props::xget(st.xp, "offset-rotate")))
    let rt: [string] = cssval::split_top(if rot == "" then "auto" else rot)
    let mut use_dir: bool = false
    let mut extra_deci: int = 0
    let mut ri: int = 0
    while ri < array_len(rt) is
        if rt[ri] == "auto" is use_dir = true
        elsif rt[ri] == "reverse" is
            use_dir = true
            extra_deci = extra_deci + 1800
        else is
            extra_deci = extra_deci + gfx::parse_x1000(string_replace(rt[ri], "deg", "")) / 100
        end
        ri += 1
    end
    let mut m: [int] = style::mat_id()
    if use_dir is m = [pos[2], pos[3], 0 - pos[3], pos[2], 0, 0] end
    if extra_deci != 0 is m = style::mat_mul(m, style::mat_rotate(extra_deci)) end
    ;; punkt zakotwiczenia w pudełku elementu
    let av: [string] = cssval::split_top(string_lower(string_trim(props::xget(st.xp, "offset-anchor"))))
    let mut ax: int = b.x + b.w / 2
    let mut ay: int = b.y + b.h / 2
    if array_len(av) >= 1 && av[0] != "auto" is
        let xs: string = if av[0] == "left" then "0%" elsif av[0] == "right" then "100%" elsif av[0] == "center" then "50%" else av[0]
        ax = b.x + gfx::len_px(xs, b.w, st.font_size)
        if array_len(av) >= 2 is
            let ys: string = if av[1] == "top" then "0%" elsif av[1] == "bottom" then "100%" elsif av[1] == "center" then "50%" else av[1]
            ay = b.y + gfx::len_px(ys, b.h, st.font_size)
        end
    end
    let px: int = cb[0] * 1000 + pos[0]
    let py: int = cb[1] * 1000 + pos[1]
    return [m[0], m[1], m[2], m[3], px - ax * 1000, py - ay * 1000, ax, ay]
end

;; 0.4: offset-position — początek promienia ray() w polu zawierającym ([x, y] ×1000, względem pola).
;; normal → środek pola; auto → lewy górny róg pudełka elementu (pozycja statyczna); <pozycja> → x y (słowa kluczowe i %).
pub fn ray_origin(op0: string, b: LayoutBox, cb: [int], fs: int) -> [int] is
    let op: string = string_lower(string_trim(op0))
    if op == "" || op == "normal" is return [cb[2] * 500, cb[3] * 500] end
    if op == "auto" is return [(b.x - cb[0]) * 1000, (b.y - cb[1]) * 1000] end
    let t: [string] = cssval::split_top(op)
    let mut sx: string = t[0]
    let mut sy: string = if array_len(t) >= 2 then t[1] else "center"
    if t[0] == "top" || t[0] == "bottom" is
        sx = sy
        sy = t[0]
        if array_len(t) < 2 is sx = "center" end
    end
    return [shape::len_px(sx, cb[2], fs) * 1000, shape::len_px(sy, cb[3], fs) * 1000]
end

fn is_numeric_char(t: string) -> bool is
    if t == "" is return false end
    let c: string = string_at(t, 0)
    return (c >= "0" && c <= "9") || c == "-" || c == "+" || c == "."
end

;; Składa ruch z istniejącą macierzą grupy `grp` (pivot, e/f): wynik [a,b,c,d,e,f,pivotx,pivoty] o pivocie w punkcie zakotwiczenia
fn compose_motion(grp: [int], mo: [int]) -> [int] is
    let ao: [int] = [grp[0], grp[1], grp[2], grp[3]]
    let ax: int = mo[6]
    let ay: int = mo[7]
    ;; M_old względem pivotu zakotwiczenia: t' = (I − A)(pivot_old − anchor) + t_old
    let vx: int = (grp[6] - ax) * 1000
    let vy: int = (grp[7] - ay) * 1000
    let tx: int = vx - (ao[0] * vx + ao[2] * vy) / 1000 + grp[4]
    let ty: int = vy - (ao[1] * vx + ao[3] * vy) / 1000 + grp[5]
    ;; R · A_old oraz R · t' + d
    let a: int = (mo[0] * ao[0] + mo[2] * ao[1]) / 1000
    let b: int = (mo[1] * ao[0] + mo[3] * ao[1]) / 1000
    let c: int = (mo[0] * ao[2] + mo[2] * ao[3]) / 1000
    let d: int = (mo[1] * ao[2] + mo[3] * ao[3]) / 1000
    let e: int = (mo[0] * tx + mo[2] * ty) / 1000 + mo[4]
    let f: int = (mo[1] * tx + mo[3] * ty) / 1000 + mo[5]
    return [a, b, c, d, e, f, ax, ay]
end

fn has_effects(st: style::ComputedStyle) -> bool is
    return st.opacity < 100 || st.has_filter || st.clip_path != "" || st.has_transform || fx_spec_of(st) != "" || clip_active(st) || offset_active(st) || wm_kind(st.xp) != ""
end

;; ---------- 0.4: transformacje 3D (perspective, rotateX/Y, translateZ, matrix3d, backface-visibility) ----------
;; Macierz perspektywy rodzica: T(o) · P(d) · T(−o), o = perspective-origin w ramce rodzica. [] gdy rodzic nie ma `perspective`.
pub fn parent_perspective(cx: LayoutCtx, boxes: [LayoutBox], id: int) -> [int] is
    let par: int = cx.dom.nodes[id].parent
    if par < 0 is return [] end
    let pst: style::ComputedStyle = cx.styles[par]
    let pv: string = string_lower(string_trim(props::xget(pst.xp, "perspective")))
    if pv == "" || pv == "none" is return [] end
    let d: int = gfx::len_px(pv, 0, pst.font_size)
    if d <= 0 is return [] end
    let r: style::BoxSides = box_rect_of(boxes, par)
    let po: string = string_trim(props::xget(pst.xp, "perspective-origin"))
    let toks: [string] = cssval::split_top(if po == "" then "50% 50%" else po)
    let t0: string = toks[0]
    let t1: string = if array_len(toks) >= 2 then toks[1] else "50%"
    let mut sx: string = t0
    let mut sy: string = t1
    if t0 == "top" || t0 == "bottom" is
        sx = t1
        sy = t0
    end
    let ox: int = r.left + shape::len_px(sx, r.right, pst.font_size)
    let oy: int = r.top + shape::len_px(sy, r.bottom, pst.font_size)
    return style::m4_mul(style::m4_mul(style::m4_translate(ox, oy, 0), style::m4_perspective(d)), style::m4_translate(0 - ox, 0 - oy, 0))
end

;; Pełna macierz elementu w współrzędnych dokumentu jako napis ("" gdy brak transformacji 3D).
fn box_of_node(boxes: [LayoutBox], id: int) -> LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == "box" is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

;; Macierz 4×4 elementu w współrzędnych dokumentu ([] gdy element nie ma transformacji 3D).
;; Rodzic z `transform-style: preserve-3d` i własną macierzą 3D składa się z elementem (sceny zagnieżdżone);
;; inaczej działa tylko perspektywa rodzica. Bez sortowania głębi — kolejność rysowania jak w dokumencie.
pub fn m3d_matrix(cx: LayoutCtx, boxes: [LayoutBox], id: int, depth: int) -> [int] is
    let st: style::ComputedStyle = cx.styles[id]
    let local: [int] = style::m4_parse(props::xget(st.xp, "x-m3d"))
    if array_len(local) != 16 || depth > 16 is return [] end
    let b: LayoutBox = box_of_node(boxes, id)
    let ob: [int] = origin_box(b, st)
    let ox: int = ob[0] + ob[2] * st.origin_x / 10000
    let oy: int = ob[1] + ob[3] * st.origin_y / 10000
    let mut m: [int] = style::m4_mul(style::m4_mul(style::m4_translate(ox, oy, 0), local), style::m4_translate(0 - ox, 0 - oy, 0))
    let tp: [int] = parent_perspective(cx, boxes, id)
    if array_len(tp) == 16 is m = style::m4_mul(tp, m) end
    let par: int = cx.dom.nodes[id].parent
    if par > 0 && string_lower(string_trim(props::xget(cx.styles[par].xp, "transform-style"))) == "preserve-3d" is
        let pm: [int] = m3d_matrix(cx, boxes, par, depth + 1)
        if array_len(pm) == 16 is m = style::m4_mul(pm, m) end
    end
    return m
end

;; Pełna macierz elementu jako napis ("" gdy brak transformacji 3D); sufiks |1 = backface-visibility: hidden.
pub fn m3d_string(cx: LayoutCtx, boxes: [LayoutBox], b: LayoutBox, st: style::ComputedStyle) -> string is
    let m: [int] = m3d_matrix(cx, boxes, b.node_id, 0)
    if array_len(m) != 16 is return "" end
    let hide: bool = string_lower(string_trim(props::xget(st.xp, "backface-visibility"))) == "hidden"
    return style::m4_str(m) + (if hide then "|1" else "|0")
end

;; ---------- 0.4: overflow-anchor (kotwiczenie przewijania) ----------
;; Po zmianie układu: węzeł-kotwica = najwyżej położony widoczny element (górna krawędź ≥ przewinięciu i w oknie), bez `overflow-anchor: none`.
;; Zwraca przesunięcie przewijania (nowa pozycja kotwicy − stara); 0, gdy brak kotwicy, przewinięcie = 0 albo wyłączone na korzeniu.
pub fn scroll_anchor_delta(old_boxes: [LayoutBox], new_boxes: [LayoutBox], scroll_y: int, viewport_h: int) -> int is
    if scroll_y <= 0 || array_len(old_boxes) == 0 is return 0 end
    if string_lower(props::xget(old_boxes[0].st.xp, "overflow-anchor")) == "none" is return 0 end
    let mut best: int = -1
    let mut i: int = 1
    while i < array_len(old_boxes) is
        let b: LayoutBox = old_boxes[i]
        i += 1
        if b.kind != "box" || b.node_id <= 0 || b.h <= 0 || b.fixed is continue end
        if b.y < scroll_y || b.y >= scroll_y + viewport_h is continue end
        if string_lower(props::xget(b.st.xp, "overflow-anchor")) == "none" is continue end
        if best < 0 || b.y < old_boxes[best].y is best = i - 1 end
    end
    if best < 0 is return 0 end
    let ob: LayoutBox = old_boxes[best]
    let mut k: int = 0
    while k < array_len(new_boxes) is
        if new_boxes[k].node_id == ob.node_id && new_boxes[k].kind == "box" is return new_boxes[k].y - ob.y end
        k += 1
    end
    return 0
end

pub fn apply_effects(cx: LayoutCtx, boxes0: [LayoutBox]) -> [LayoutBox] is
    let mut out: [LayoutBox] = boxes0
    let total: int = array_len(out)
    let mut any_fx: bool = false
    let mut q: int = 0
    while q < total is
        if out[q].kind == "box" && out[q].node_id > 0 && has_effects(cx.styles[out[q].node_id]) is any_fx = true end
        q += 1
    end
    if !any_fx is return out end
    let mut i: int = 0
    while i < total is
        let b: LayoutBox = out[i]
        i += 1
        if b.kind != "box" || b.node_id <= 0 is continue end
        let st: style::ComputedStyle = cx.styles[b.node_id]
        if !has_effects(st) is continue end
        let id: int = b.node_id
        ;; indeksy poddrzewa (poza samym elementem)
        let mut sub: [int] = []
        let mut j: int = i
        while j < total is
            if is_in_subtree(cx, out[j].node_id, id) is sub = array_push(sub, j) end
            j += 1
        end
        ;; opacity grupowe: mnożymy przez potomków
        if st.opacity < 100 is
            let mut k: int = 0
            while k < array_len(sub) is
                ;; kopia stylu: obiekt bywa współdzielony z cx.styles i innymi ramkami (mnożenie zachodziłoby wielokrotnie)
                let mut cs: style::ComputedStyle = style::copy_style(out[sub[k]].st)
                cs.opacity = cs.opacity * st.opacity / 100
                out[sub[k]].st = cs
                k += 1
            end
        end
        if st.has_filter is
            out[i - 1].st = filter_style(out[i - 1].st, st)
            let mut k: int = 0
            while k < array_len(sub) is
                out[sub[k]].st = filter_style(out[sub[k]].st, st)
                k += 1
            end
        end
        if st.clip_path != "" is
            let r: [int] = clip_rect_of(st.clip_path, b.x, b.y, b.w, b.h)
            if array_len(r) == 4 is
                out[i - 1] = clip_one(out[i - 1], r[0], r[1], r[2], r[3])
                let mut k: int = 0
                while k < array_len(sub) is
                    out[sub[k]] = clip_one(out[sub[k]], r[0], r[1], r[2], r[3])
                    k += 1
                end
            end
        end
        let m3s: string = if st.has_transform then m3d_string(cx, out, b, st) else ""
        let vkd: string = vert_kind(cx, id)
        if (st.has_transform && (array_len(st.tr_m) == 6 || m3s != "")) || vkd != "" is
            ;; obrót / pochylenie: poddrzewo rysowane jako warstwa przekształcana przez natywną warstwę
            let ob: [int] = origin_box(b, st)
            let mut px: int = ob[0] + ob[2] * st.origin_x / 10000
            let mut py: int = ob[1] + ob[3] * st.origin_y / 10000
            if vkd != "" is
                px = b.x
                py = b.y
            end
            let mut x0: int = b.x
            let mut y0: int = b.y
            let mut x1: int = b.x + b.w
            let mut y1: int = b.y + b.h
            let mut k: int = 0
            while k < array_len(sub) is
                let sb: LayoutBox = out[sub[k]]
                let mut rx0: int = sb.x
                let mut ry0: int = sb.y
                let mut rx1: int = sb.x + sb.w
                let mut ry1: int = sb.y + sb.h
                if sb.has_clip is
                    if sb.cx > rx0 is rx0 = sb.cx end
                    if sb.cy > ry0 is ry0 = sb.cy end
                    if sb.cx + sb.cw < rx1 is rx1 = sb.cx + sb.cw end
                    if sb.cy + sb.ch < ry1 is ry1 = sb.cy + sb.ch end
                end
                if rx1 > rx0 && ry1 > ry0 is
                    if rx0 < x0 is x0 = rx0 end
                    if ry0 < y0 is y0 = ry0 end
                    if rx1 > x1 is x1 = rx1 end
                    if ry1 > y1 is y1 = ry1 end
                end
                k += 1
            end
            let fxs0: string = fx_spec_of(st)
            let pad0: int = 2 + gfx::filter_pad(fxs0)
            let mut tm6: [int] = if array_len(st.tr_m) == 6 && m3s == "" then st.tr_m else [1000, 0, 0, 1000, 0, 0]
            if vkd != "" is tm6 = vert_matrix(vkd, b.w, b.h) end
            let grp: [int] = [tm6[0], tm6[1], tm6[2], tm6[3], tm6[4], tm6[5], px, py, x0 - pad0, y0 - pad0, x1 - x0 + 2 * pad0, y1 - y0 + 2 * pad0]
            out[i - 1].xf_id = id
            out[i - 1].xf = grp
            out[i - 1].fx = fxs0
            out[i - 1].m3d = m3s
            k = 0
            while k < array_len(sub) is
                out[sub[k]].xf_id = id
                out[sub[k]].xf = grp
                out[sub[k]].fx = fxs0
                out[sub[k]].m3d = m3s
                k += 1
            end
        elsif st.has_transform is
            let ob: [int] = origin_box(b, st)
            let ox: int = ob[0] + ob[2] * st.origin_x / 10000
            let oy: int = ob[1] + ob[3] * st.origin_y / 10000
            let tx: int = st.tr_tx + b.w * st.tr_tx_pct / 10000
            let ty: int = st.tr_ty + b.h * st.tr_ty_pct / 10000
            out[i - 1] = transform_box(out[i - 1], ox, oy, st.tr_sx, st.tr_sy, tx, ty)
            let mut k: int = 0
            while k < array_len(sub) is
                out[sub[k]] = transform_box(out[sub[k]], ox, oy, st.tr_sx, st.tr_sy, tx, ty)
                k += 1
            end
        end
        ;; 0.4: ruch po ścieżce (offset-path): grupa z macierzą obrotu i przesunięciem; składana z istniejącą grupą (transform/filter)
        if offset_active(st) is
            let mo: [int] = motion_params(cx, out, i - 1, st)
            if array_len(mo) == 8 is
                let mut grp3: [int] = []
                if out[i - 1].xf_id == id && array_len(out[i - 1].xf) == 12 is
                    let g0: [int] = out[i - 1].xf
                    let comp: [int] = compose_motion(g0, mo)
                    grp3 = [comp[0], comp[1], comp[2], comp[3], comp[4], comp[5], comp[6], comp[7], g0[8], g0[9], g0[10], g0[11]]
                else is
                    let gb3: [int] = group_bounds(out, i - 1, sub)
                    grp3 = [mo[0], mo[1], mo[2], mo[3], mo[4], mo[5], mo[6], mo[7], gb3[0] - 2, gb3[1] - 2, gb3[2] - gb3[0] + 4, gb3[3] - gb3[1] + 4]
                end
                out[i - 1].xf_id = id
                out[i - 1].xf = grp3
                let mut km: int = 0
                while km < array_len(sub) is
                    if out[sub[km]].xf_id == 0 || out[sub[km]].xf_id == id is
                        out[sub[km]].xf_id = id
                        out[sub[km]].xf = grp3
                    end
                    km += 1
                end
            end
        end
        ;; 0.4: clip: rect(…) — przycięcie elementu i potomków
        if clip_active(st) is
            let cr: [int] = css_clip_rect(st, out[i - 1])
            if array_len(cr) == 4 is
                out[i - 1] = apply_clip([out[i - 1]], 0, cr[0], cr[1], cr[2], cr[3])[0]
                let mut kc: int = 0
                while kc < array_len(sub) is
                    out[sub[kc]] = apply_clip([out[sub[kc]]], 0, cr[0], cr[1], cr[2], cr[3])[0]
                    kc += 1
                end
            end
        end
        ;; 0.4: efekty pikselowe (filter blur/saturate/hue-rotate/drop-shadow, mask, mix-blend-mode) — grupa o macierzy tożsamościowej
        let fxs: string = fx_spec_of(st)
        if fxs != "" && !(st.has_transform && array_len(st.tr_m) == 6) is
            let gb: [int] = group_bounds(out, i - 1, sub)
            let pad: int = 2 + gfx::filter_pad(fxs)
            let gid: int = id
            let grp2: [int] = [1000, 0, 0, 1000, 0, 0, gb[0], gb[1], gb[0] - pad, gb[1] - pad, gb[2] - gb[0] + 2 * pad, gb[3] - gb[1] + 2 * pad]
            if out[i - 1].xf_id == 0 is
                out[i - 1].xf_id = gid
                out[i - 1].xf = grp2
                out[i - 1].fx = fxs
            end
            let mut k2: int = 0
            while k2 < array_len(sub) is
                if out[sub[k2]].xf_id == 0 is
                    out[sub[k2]].xf_id = gid
                    out[sub[k2]].xf = grp2
                    out[sub[k2]].fx = fxs
                end
                k2 += 1
            end
        end
    end
    return out
end

;; Prostokąt otaczający element `idx` i jego poddrzewo `sub` (z uwzględnieniem przycięcia) → [x0, y0, x1, y1].
fn group_bounds(out: [LayoutBox], idx: int, sub: [int]) -> [int] is
    let b: LayoutBox = out[idx]
    let mut x0: int = b.x
    let mut y0: int = b.y
    let mut x1: int = b.x + b.w
    let mut y1: int = b.y + b.h
    let mut k: int = 0
    while k < array_len(sub) is
        let sb: LayoutBox = out[sub[k]]
        let mut rx0: int = sb.x
        let mut ry0: int = sb.y
        let mut rx1: int = sb.x + sb.w
        let mut ry1: int = sb.y + sb.h
        if sb.has_clip is
            if sb.cx > rx0 is rx0 = sb.cx end
            if sb.cy > ry0 is ry0 = sb.cy end
            if sb.cx + sb.cw < rx1 is rx1 = sb.cx + sb.cw end
            if sb.cy + sb.ch < ry1 is ry1 = sb.cy + sb.ch end
        end
        if rx1 > rx0 && ry1 > ry0 is
            if rx0 < x0 is x0 = rx0 end
            if ry0 < y0 is y0 = ry0 end
            if rx1 > x1 is x1 = rx1 end
            if ry1 > y1 is y1 = ry1 end
        end
        k += 1
    end
    return [x0, y0, x1, y1]
end

;; position: sticky — oznacza boxy poddrzewa danymi do przesunięcia przy rysowaniu.
pub fn mark_sticky(cx: LayoutCtx, boxes0: [LayoutBox]) -> [LayoutBox] is
    let mut out: [LayoutBox] = boxes0
    let total: int = array_len(out)
    let mut i: int = 0
    while i < total is
        let b: LayoutBox = out[i]
        i += 1
        if b.kind != "box" || b.node_id <= 0 || cx.styles[b.node_id].position != "sticky" is continue end
        if cx.styles[b.node_id].top == auto_v() is continue end
        let par: int = cx.dom.nodes[b.node_id].parent
        let pr: style::BoxSides = box_rect_of(out, par)
        let pst: style::ComputedStyle = cx.styles[par]
        let parent_bottom: int = pr.top + pr.bottom - pst.pad_bottom - pst.bb
        let mut maxdy: int = parent_bottom - (b.y + b.h)
        if maxdy < 0 is maxdy = 0 end
        let mut j: int = i - 1
        while j < total is
            if is_in_subtree(cx, out[j].node_id, b.node_id) is
                out[j].sticky = true
                out[j].stk_top = cx.styles[b.node_id].top
                out[j].stk_y = b.y
                out[j].stk_max = maxdy
            end
            j += 1
        end
    end
    return out
end

;; Klucz kolejności rysowania wg z-index (do 3 poziomów zagnieżdżonych kontekstów).
pub fn makes_stacking_context(st: style::ComputedStyle) -> bool is
    if props::xget(st.xp, "isolation") == "isolate" is return true end
    let mb: string = props::xget(st.xp, "mix-blend-mode")
    if mb != "" && mb != "normal" is return true end
    let wc: string = props::xget(st.xp, "will-change")
    if string_find(wc, "transform") >= 0 || string_find(wc, "opacity") >= 0 || string_find(wc, "z-index") >= 0 is return true end
    if contains_any(st, " layout paint strict content ") is return true end
    return false
end

fn z_key(cx: LayoutCtx, id: int) -> int is
    let mut chain: [int] = []
    let mut cur: int = id
    let mut guard: int = 0
    while cur > 0 && guard < 200 is
        let st: style::ComputedStyle = cx.styles[cur]
        if st.position != "static" && st.z_index != 0 is
            chain = array_push(chain, st.z_index)
        elsif makes_stacking_context(st) is
            chain = array_push(chain, 0)
        end
        cur = cx.dom.nodes[cur].parent
        guard += 1
    end
    let n: int = array_len(chain)
    if n == 0 is return 0 end
    let weights: [int] = [1000000, 1000, 1]
    let mut key: int = 0
    let mut lvl: int = 0
    while lvl < 3 && lvl < n is
        let mut z: int = chain[n - 1 - lvl]
        if z > 999 is z = 999 end
        if z < -999 is z = -999 end
        key = key + z * weights[lvl]
        lvl += 1
    end
    return key
end

pub fn z_sort(cx: LayoutCtx, boxes: [LayoutBox]) -> [LayoutBox] is
    let total: int = array_len(boxes)
    let mut keys: [int] = []
    let mut any_z: bool = false
    let mut i: int = 0
    while i < total is
        let k: int = if boxes[i].node_id > 0 then z_key(cx, boxes[i].node_id) else 0
        if k != 0 is any_z = true end
        keys = array_push(keys, k)
        i += 1
    end
    if !any_z is return boxes end
    let mut distinct: [int] = []
    i = 0
    while i < total is
        let k: int = keys[i]
        i += 1
        let mut have: bool = false
        let mut j: int = 0
        while j < array_len(distinct) is
            if distinct[j] == k is have = true end
            j += 1
        end
        if !have is
            let mut pos: int = array_len(distinct)
            j = 0
            while j < array_len(distinct) is
                if distinct[j] > k && pos == array_len(distinct) is pos = j end
                j += 1
            end
            let mut nd: [int] = []
            j = 0
            while j < array_len(distinct) is
                if j == pos is nd = array_push(nd, k) end
                nd = array_push(nd, distinct[j])
                j += 1
            end
            if pos == array_len(distinct) is nd = array_push(nd, k) end
            distinct = nd
        end
    end
    let mut out: [LayoutBox] = []
    let mut d: int = 0
    while d < array_len(distinct) is
        i = 0
        while i < total is
            if keys[i] == distinct[d] is out = array_push(out, boxes[i]) end
            i += 1
        end
        d += 1
    end
    return out
end

;; Przesunięcie pionowe boxa `sticky` przy przewinięciu dokumentu o `scroll`.
pub fn sticky_dy(b: LayoutBox, scroll: int) -> int is
    if !b.sticky || b.fixed is return 0 end
    let want: int = scroll + b.stk_top - b.stk_y
    if want < 0 is return 0 end
    if want > b.stk_max is return b.stk_max end
    return want
end


;; =====================================================================
;; 0.3: generowanie treści ::before / ::after, attr(), counter(), cudzysłowy
;; =====================================================================
struct GenState is
    pub d:          dom::Dom
    pub cn:         [string]   ;; nazwy liczników (stos instancji)
    pub cv:         [int]
    pub co:         [int]      ;; właściciel zakresu: id węzła, po którego poddrzewie instancja znika
    pub has_before: bool
    pub has_after:  bool
    pub has_fl:     bool       ;; 0.4: arkusz ma reguły ::first-letter
    pub qv:         string     ;; 0.4: bieżąca wartość `quotes` ("" = auto)
    pub qd:         int        ;; 0.4: głębokość zagnieżdżenia cudzysłowów
    pub sn:         [string]   ;; string-set: nazwy napisów (najnowsze przypisanie wygrywa)
    pub sv:         [string]   ;; string-set: wartości napisów
end

pub fn unquote(v: string) -> string is
    let t: string = string_trim(v)
    if string_len(t) >= 2 && (string_starts_with(t, "\"") || string_starts_with(t, "'")) is
        return string_slice(t, 1, string_len(t) - 1)
    end
    return t
end

fn css_unescape(s: string) -> string is
    let n: int = string_len(s)
    let mut out: string = ""
    let mut i: int = 0
    while i < n is
        let c: string = string_at(s, i)
        if c == "\\" && i + 1 < n is
            let mut j: int = i + 1
            let mut hex: string = ""
            while j < n && j < i + 7 && dom::hex_val(string_at(s, j)) >= 0 is
                hex = hex + string_at(s, j)
                j += 1
            end
            if hex != "" is
                let cp: int = dom::hex_val(hex)
                if cp == 10 is out = out + "\n" else is out = out + dom::codepoint_to_str(cp) end
                if j < n && string_at(s, j) == " " is j += 1 end
                i = j
            else is
                out = out + string_at(s, i + 1)
                i += 2
            end
        else is
            out = out + c
            i += 1
        end
    end
    return out
end

fn counter_top(gs: GenState, name: string) -> int is
    let mut idx: int = -1
    let mut i: int = 0
    while i < array_len(gs.cn) is
        if gs.cn[i] == name is idx = i end
        i += 1
    end
    return idx
end

fn counter_format(n: int, kind: string) -> string is
    if kind == "none" is return "" end
    if kind == "disc" is return "•" end
    if kind == "circle" is return "◦" end
    if kind == "square" is return "▪" end
    if kind == "decimal-leading-zero" is return (if n >= 0 && n < 10 then "0" else "") + to_string(n) end
    if kind == "lower-alpha" || kind == "lower-latin" is return alpha_of(n, false) end
    if kind == "upper-alpha" || kind == "upper-latin" is return alpha_of(n, true) end
    if kind == "lower-roman" is return roman_of(n, false) end
    if kind == "upper-roman" is return roman_of(n, true) end
    if kind == "lower-greek" is return greek_of(n) end
    return to_string(n)
end

;; "name 2 other" -> pary (nazwa, liczba); domyślna liczba = dflt
fn counter_pairs(val: string, dflt: int) -> [string] is
    let toks: [string] = cssval::split_top(val)
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if t == "none" is continue end
        let mut num: int = dflt
        if i < array_len(toks) is
            let nx: string = toks[i]
            let c0: string = string_slice(nx, 0, 1)
            if (c0 >= "0" && c0 <= "9") || c0 == "-" is
                num = str_to_int(nx)
                i += 1
            end
        end
        out = array_push(out, t)
        out = array_push(out, to_string(num))
    end
    return out
end

fn apply_string_set(gs0: GenState, decls: [css::CssDecl], host: int) -> GenState is
    let mut gs: GenState = gs0
    let scope: int = host
    let mut di: int = 0
    while di < array_len(decls) is
        let dc: css::CssDecl = decls[di]
        di += 1
        if dc.prop == "string-set" is
            ;; string-set: <nazwa> <lista treści> [, <nazwa> <lista treści>]* ; none czyści
            let sv0: string = string_trim(dc.val)
            if string_lower(sv0) != "none" is
                let items: [string] = cssval::split_commas(sv0)
                let mut ii: int = 0
                while ii < array_len(items) is
                    let it: string = string_trim(items[ii])
                    ii += 1
                    let sp: int = string_find(it, " ")
                    if sp > 0 is
                        let nm: string = string_trim(string_slice(it, 0, sp))
                        let val: string = eval_content(gs, scope, string_trim(string_slice(it, sp + 1, string_len(it))))
                        gs.sn = array_push(gs.sn, nm)
                        gs.sv = array_push(gs.sv, val)
                    end
                end
            end
        end
    end
    return gs
end

fn apply_counter_decls(gs0: GenState, decls: [css::CssDecl], scope: int) -> GenState is
    let mut gs: GenState = gs0
    let mut di: int = 0
    while di < array_len(decls) is
        let dc: css::CssDecl = decls[di]
        di += 1
        if dc.prop == "counter-reset" || dc.prop == "counter-set" || dc.prop == "counter-increment" is
            let pairs: [string] = counter_pairs(dc.val, if dc.prop == "counter-increment" then 1 else 0)
            let mut pi: int = 0
            while pi + 1 < array_len(pairs) is
                let name: string = pairs[pi]
                let num: int = str_to_int(pairs[pi + 1])
                pi += 2
                let top: int = counter_top(gs, name)
                if dc.prop == "counter-reset" is
                    if top >= 0 && gs.co[top] == scope is
                        gs.cv[top] = num
                    else is
                        gs.cn = array_push(gs.cn, name)
                        gs.cv = array_push(gs.cv, num)
                        gs.co = array_push(gs.co, scope)
                    end
                elsif dc.prop == "counter-set" is
                    if top >= 0 is
                        gs.cv[top] = num
                    else is
                        gs.cn = array_push(gs.cn, name)
                        gs.cv = array_push(gs.cv, num)
                        gs.co = array_push(gs.co, scope)
                    end
                else is
                    if top >= 0 is
                        gs.cv[top] = gs.cv[top] + num
                    else is
                        gs.cn = array_push(gs.cn, name)
                        gs.cv = array_push(gs.cv, num)
                        gs.co = array_push(gs.co, scope)
                    end
                end
            end
        end
    end
    return gs
end

fn gen_pop(gs0: GenState, owner: int) -> GenState is
    let mut gs: GenState = gs0
    let mut cn: [string] = []
    let mut cv: [int] = []
    let mut co: [int] = []
    let mut i: int = 0
    while i < array_len(gs.cn) is
        if gs.co[i] != owner is
            cn = array_push(cn, gs.cn[i])
            cv = array_push(cv, gs.cv[i])
            co = array_push(co, gs.co[i])
        end
        i += 1
    end
    gs.cn = cn
    gs.cv = cv
    gs.co = co
    return gs
end

;; 0.4: `quotes` — pary cudzysłowów wg głębokości. qv: "" / "auto" → “ ” ‘ ’; "none" → brak.
pub fn quote_glyph(qv: string, depth: int, open: bool) -> string is
    let v: string = string_trim(qv)
    if v == "none" is return "" end
    let mut items: [string] = []
    if v != "" && v != "auto" is
        let toks: [string] = cssval::split_top(v)
        let mut i: int = 0
        while i < array_len(toks) is
            let raw_q: string = unquote(toks[i])
            items = array_push(items, if string_find(raw_q, "\\") >= 0 then css_unescape(raw_q) else raw_q)
            i += 1
        end
    end
    if array_len(items) < 2 is items = ["“", "”", "‘", "’"] end
    let pairs: int = array_len(items) / 2
    let lvl0: int = if open then depth else depth - 1
    let lvl: int = if lvl0 < 0 then 0 elsif lvl0 >= pairs then pairs - 1 else lvl0
    return items[lvl * 2 + (if open then 0 else 1)]
end

fn count_token(expr: string, tok: string) -> int is
    let mut n: int = 0
    let mut from: int = 0
    while from < string_len(expr) is
        let q: int = string_find(string_slice(expr, from, string_len(expr)), tok)
        if q < 0 is break end
        let at: int = from + q
        let before_ok: bool = at == 0 || string_at(expr, at - 1) == " "
        if before_ok is n += 1 end
        from = at + string_len(tok)
    end
    return n
end

;; Wartość `content` → tekst. host = element, do którego należy pseudo-element.
fn eval_content(gs: GenState, host: int, expr: string) -> string is
    let n: int = string_len(expr)
    let mut out: string = ""
    let mut qd: int = gs.qd
    let mut i: int = 0
    while i < n is
        let c: string = string_at(expr, i)
        if c == " " || c == "," || c == "\t" || c == "\n" is
            i += 1
        elsif c == "\"" || c == "'" is
            let mut j: int = i + 1
            while j < n && string_at(expr, j) != c is
                if string_at(expr, j) == "\\" is j += 1 end
                j += 1
            end
            out = out + css_unescape(string_slice(expr, i + 1, if j > n then n else j))
            i = j + 1
        else is
            let rest: string = string_lower(string_slice(expr, i, n))
            let close: int = string_find(rest, ")")
            if string_starts_with(rest, "content(") && close > 0 is
                ;; content() / content(text): tekst elementu; content(before|after|first-letter) — przybliżenie: pusty
                let carg: string = string_lower(string_trim(string_slice(expr, i + 8, i + close)))
                if carg == "" || carg == "text" is out = out + string_trim(dom::collapse_ws(dom::text_content(gs.d, host))) end
                i = i + close + 1
            elsif string_starts_with(rest, "string(") && close > 0 is
                ;; string(nazwa [, first|start|last|first-except]) — bez kontekstu strony wszystkie zasady dają bieżącą wartość
                let sargs: [string] = cssval::split_commas(string_slice(expr, i + 7, i + close))
                let sname: string = string_trim(sargs[0])
                let mut sk: int = array_len(gs.sn) - 1
                while sk >= 0 is
                    if gs.sn[sk] == sname is
                        out = out + gs.sv[sk]
                        sk = -1
                    else is sk -= 1 end
                end
                i = i + close + 1
            elsif string_starts_with(rest, "attr(") && close > 0 is
                let name: string = string_trim(string_slice(expr, i + 5, i + close))
                out = out + dom::get_attr(gs.d.nodes[host], name)
                i = i + close + 1
            elsif string_starts_with(rest, "counters(") && close > 0 is
                let args: [string] = cssval::split_commas(string_slice(expr, i + 9, i + close))
                let name: string = string_trim(args[0])
                let mut sep: string = ""
                if array_len(args) >= 2 is sep = css_unescape(unquote(string_trim(args[1]))) end
                let kind: string = if array_len(args) >= 3 then string_lower(string_trim(args[2])) else "decimal"
                let mut first: bool = true
                let mut k: int = 0
                while k < array_len(gs.cn) is
                    if gs.cn[k] == name is
                        out = out + (if first then "" else sep) + counter_format(gs.cv[k], kind)
                        first = false
                    end
                    k += 1
                end
                if first is out = out + "0" end
                i = i + close + 1
            elsif string_starts_with(rest, "counter(") && close > 0 is
                let args: [string] = cssval::split_commas(string_slice(expr, i + 8, i + close))
                let name: string = string_trim(args[0])
                let kind: string = if array_len(args) >= 2 then string_lower(string_trim(args[1])) else "decimal"
                let top: int = counter_top(gs, name)
                out = out + counter_format(if top >= 0 then gs.cv[top] else 0, kind)
                i = i + close + 1
            elsif string_starts_with(rest, "open-quote") is
                out = out + quote_glyph(gs.qv, qd, true)
                qd += 1
                i += 10
            elsif string_starts_with(rest, "close-quote") is
                out = out + quote_glyph(gs.qv, qd, false)
                if qd > 0 is qd -= 1 end
                i += 11
            elsif string_starts_with(rest, "no-open-quote") is
                qd += 1
                i += 13
            elsif string_starts_with(rest, "no-close-quote") is
                if qd > 0 is qd -= 1 end
                i += 14
            elsif string_starts_with(rest, "url(") && close > 0 is
                i = i + close + 1
            else is
                let mut j: int = i
                while j < n && string_at(expr, j) != " " is j += 1 end
                i = j
            end
        end
    end
    return out
end

;; ---------- string-set: napisy bieżące dla zakresu stron (nagłówki/stopki) ----------
;; Zwraca płaską listę trójek [id węzła, nazwa, wartość] przypisań string-set w kolejności dokumentu.
pub fn string_assignments(d: dom::Dom, sheet: css::Stylesheet, ix: css::InteractionState) -> [string] is
    let mut out: [string] = []
    let order: [int] = dom::document_order(d)
    let mut i: int = 0
    while i < array_len(order) is
        let id: int = order[i]
        i += 1
        if id <= 0 || d.nodes[id].removed || d.nodes[id].tag == "text" is continue end
        let decls: [css::CssDecl] = css::matching_decls_ctx(sheet, d, id, ix)
        let gs0: GenState = GenState { d: d, cn: [], cv: [], co: [], has_before: false, has_after: false, has_fl: false, qv: "", qd: 0, sn: [], sv: [] }
        let gs1: GenState = apply_string_set(gs0, decls, id)
        let mut k: int = 0
        while k < array_len(gs1.sn) is
            out = array_push(out, to_string(id))
            out = array_push(out, gs1.sn[k])
            out = array_push(out, gs1.sv[k])
            k += 1
        end
    end
    return out
end

fn doc_pos(order: [int], id: int) -> int is
    let mut i: int = 0
    while i < array_len(order) is
        if order[i] == id is return i end
        i += 1
    end
    return -1
end

;; Wartość napisu `name` na stronie obejmującej węzły od `first_id` do `last_id` (kolejność dokumentu) wg zasady:
;; first (pierwsze przypisanie na stronie, inaczej wartość z początku), start (wartość na początku strony: przypisanie pierwszego
;; elementu strony albo ostatnie przed stroną), last (ostatnie przypisanie na stronie, inaczej z początku), first-except
;; (pusty, gdy napis przypisano na stronie; inaczej wartość z początku).
pub fn page_string(d: dom::Dom, assign: [string], name: string, first_id: int, last_id: int, policy: string) -> string is
    let order: [int] = dom::document_order(d)
    let p0: int = doc_pos(order, first_id)
    let p1: int = doc_pos(order, last_id)
    let mut before: string = ""
    let mut at_start: string = ""
    let mut in_first: string = ""
    let mut in_last: string = ""
    let mut seen_in: bool = false
    let mut seen_start: bool = false
    let mut k: int = 0
    while k + 2 < array_len(assign) is
        let pos: int = doc_pos(order, str_to_int(assign[k]))
        if assign[k + 1] == name is
            if pos < p0 is before = assign[k + 2]
            elsif pos <= p1 is
                if !seen_in is in_first = assign[k + 2] end
                if pos == p0 && !seen_start is
                    at_start = assign[k + 2]
                    seen_start = true
                end
                in_last = assign[k + 2]
                seen_in = true
            end
        end
        k += 3
    end
    let start_v: string = if seen_start then at_start else before
    let pol: string = string_lower(string_trim(policy))
    if pol == "first" is return if seen_in then in_first else start_v end end
    if pol == "last" is return if seen_in then in_last else start_v end end
    if pol == "first-except" is return if seen_in then "" else start_v end end
    return start_v
end

fn content_decl_of(decls: [css::CssDecl]) -> string is
    let mut found: string = ""
    let mut i: int = 0
    while i < array_len(decls) is
        if decls[i].prop == "content" is found = string_trim(decls[i].val) end
        i += 1
    end
    return found
end

fn make_pseudo(gs0: GenState, sheet: css::Stylesheet, ix: css::InteractionState, host: int, pe: string) -> GenState is
    let mut gs: GenState = gs0
    let mut d2: dom::Dom = dom::new_node(gs.d, host, "span")
    let pid: int = array_len(d2.nodes) - 1
    d2.nodes[pid].pseudo = pe
    let decls: [css::CssDecl] = css::matching_decls_ctx(sheet, d2, pid, ix)
    let expr: string = content_decl_of(decls)
    let low: string = string_lower(expr)
    if expr == "" || low == "none" || low == "normal" is
        ;; brak treści: usuń tymczasowy węzeł
        d2.nodes[pid].removed = true
        let mut kids: [int] = []
        let mut k: int = 0
        while k < array_len(d2.nodes[host].children) is
            if d2.nodes[host].children[k] != pid is kids = array_push(kids, d2.nodes[host].children[k]) end
            k += 1
        end
        d2.nodes[host].children = kids
        gs.d = d2
        return gs
    end
    gs.d = d2
    gs = apply_counter_decls(gs, decls, host)
    let txt: string = eval_content(gs, host, expr)
    let qnet: int = count_token(expr, "open-quote") + count_token(expr, "no-open-quote") - count_token(expr, "close-quote") - count_token(expr, "no-close-quote")
    gs.qd = if gs.qd + qnet < 0 then 0 else gs.qd + qnet
    if txt != "" is
        let mut d3: dom::Dom = dom::new_node(gs.d, pid, "text")
        let tid: int = array_len(d3.nodes) - 1
        d3.nodes[tid].text = txt
        gs.d = d3
    end
    if pe == "before" is
        let mut kids: [int] = [pid]
        let mut k: int = 0
        while k < array_len(gs.d.nodes[host].children) is
            if gs.d.nodes[host].children[k] != pid is kids = array_push(kids, gs.d.nodes[host].children[k]) end
            k += 1
        end
        gs.d.nodes[host].children = kids
    end
    return gs
end

;; ---------- timeline-trigger / animation-trigger / trigger-scope ----------
;; Definicja triggera elementu: [nazwa, źródło, zakres, zakres wyjścia]. Skrót: `timeline-trigger: <nazwa> [<źródło>] [<zakres>] [/ <wyjście>]`;
;; longhandy timeline-trigger-name | -source | -range | -exit-range mają pierwszeństwo przed odpowiednimi częściami skrótu.
pub fn trigger_def(st: style::ComputedStyle) -> [string] is
    let mut name: string = ""
    let mut src: string = "auto"
    let mut rng: string = ""
    let mut ex: string = ""
    let sh: string = string_trim(props::xget(st.xp, "timeline-trigger"))
    if sh != "" && string_lower(sh) != "none" is
        let halves: [string] = string_split(sh, "/")
        let toks: [string] = cssval::split_top(halves[0])
        let mut i: int = 0
        let mut rest: [string] = []
        while i < array_len(toks) is
            let t: string = toks[i]
            let lt: string = string_lower(t)
            i += 1
            if name == "" && string_starts_with(t, "--") is name = t
            elsif src == "auto" && (string_starts_with(lt, "scroll(") || string_starts_with(lt, "view(") || (name != "" && string_starts_with(t, "--"))) is src = t
            elsif lt != "auto" is rest = array_push(rest, t) end
        end
        let mut ri: int = 0
        while ri < array_len(rest) is
            rng = if rng == "" then rest[ri] else rng + " " + rest[ri] end
            ri += 1
        end
        if array_len(halves) > 1 is ex = string_trim(halves[1]) end
    end
    let n2: string = string_trim(props::xget(st.xp, "timeline-trigger-name"))
    if n2 != "" && string_lower(n2) != "none" is name = n2 end
    let s2: string = string_trim(props::xget(st.xp, "timeline-trigger-source"))
    if s2 != "" is src = s2 end
    let r2: string = string_trim(props::xget(st.xp, "timeline-trigger-range"))
    if r2 != "" is rng = r2 end
    let e2: string = string_trim(props::xget(st.xp, "timeline-trigger-exit-range"))
    if e2 != "" is ex = e2 end
    return [name, src, rng, ex]
end

;; animation-trigger: <nazwa> <akcja przy wejściu> [<akcja przy wyjściu>] → [nazwa, wejście, wyjście]; brak = [].
pub fn animation_trigger_of(st: style::ComputedStyle) -> [string] is
    let v: string = string_trim(props::xget(st.xp, "animation-trigger"))
    if v == "" || string_lower(v) == "none" is return [] end
    let t: [string] = cssval::split_top(v)
    if array_len(t) < 2 is return [] end
    return [t[0], string_lower(t[1]), if array_len(t) >= 3 then string_lower(t[2]) else "none"]
end

;; Widoczność nazwy triggera dla elementu `nid`: deklarujący i jego potomkowie; `trigger-scope: --nazwa | all` na przodku
;; rozszerza zasięg na jego poddrzewo.
fn trigger_visible(boxes: [LayoutBox], d: dom::Dom, nid: int, tnode: int, name: string) -> bool is
    if is_ancestor_or_self(d, tnode, nid) is return true end
    let mut cur: int = nid
    let mut guard: int = 0
    while cur >= 0 && guard < 400 is
        if is_ancestor_or_self(d, cur, tnode) is
            let b: LayoutBox = box_of_node(boxes, cur)
            let sc: [string] = cssval::split_top(string_lower(props::xget(b.st.xp, "trigger-scope")))
            let mut k: int = 0
            while k < array_len(sc) is
                if sc[k] == string_lower(name) || sc[k] == "all" is return true end
                k += 1
            end
        end
        cur = d.nodes[cur].parent
        guard += 1
    end
    return false
end

pub fn find_trigger(boxes: [LayoutBox], d: dom::Dom, nid: int, name: string) -> int is
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        if b.kind != "box" || b.node_id <= 0 is continue end
        let def: [string] = trigger_def(b.st)
        if def[0] == name && trigger_visible(boxes, d, nid, b.node_id, name) is return b.node_id end
    end
    return -1
end

;; Postęp triggera na jego osi (promile 0..1000; -1 gdy brak osi): oś źródłowa (auto = view() elementu-triggera) i zakres.
fn trigger_progress(boxes: [LayoutBox], d: dom::Dom, tnode: int, src: string, range: string, sy: int, page_max: int, vw: int, vh: int) -> int is
    let tb: LayoutBox = box_of_node(boxes, tnode)
    let mut sst: style::ComputedStyle = style::copy_style(tb.st)
    sst.anim_ms = 1000
    let mut tl: string = if src == "" || string_lower(src) == "auto" then "view()" else src
    sst.xp = props::xset(sst.xp, "animation-timeline", tl)
    sst.xp = props::xset(sst.xp, "animation-range", if range == "" then "normal" else range)
    sst.xp = props::xset(sst.xp, "animation-range-start", "")
    sst.xp = props::xset(sst.xp, "animation-range-end", "")
    return timeline_elapsed(boxes, d, tnode, sst, sy, page_max, vw, vh)
end

;; Czy trigger `tnode` jest aktywny: wejście — postęp wewnątrz zakresu (0 < p < 1000); gdy był aktywny (`was_active`), pozostaje
;; aktywny dopóki postęp w zakresie wyjścia (domyślnie ten sam zakres) nie opuści jego granic.
pub fn trigger_active(boxes: [LayoutBox], d: dom::Dom, tnode: int, was_active: bool, sy: int, page_max: int, vw: int, vh: int) -> bool is
    let tb: LayoutBox = box_of_node(boxes, tnode)
    let def: [string] = trigger_def(tb.st)
    if def[0] == "" is return false end
    if was_active is
        let er: string = if def[3] != "" then def[3] else def[2]
        let pe: int = trigger_progress(boxes, d, tnode, def[1], er, sy, page_max, vw, vh)
        return pe > 0 && pe < 1000
    end
    let p: int = trigger_progress(boxes, d, tnode, def[1], def[2], sy, page_max, vw, vh)
    return p > 0 && p < 1000
end

;; ---------- scroll-target-group / :target-current ----------
fn scroller_ancestor_of(boxes: [LayoutBox], d: dom::Dom, id: int) -> int is
    let mut cur: int = d.nodes[id].parent
    let mut guard: int = 0
    while cur > 0 && guard < 200 is
        let b: LayoutBox = box_of_node(boxes, cur)
        if b.node_id == cur && b.kind == "box" is
            let ov: string = b.st.overflow_y
            if ov == "auto" || ov == "scroll" || ov == "hidden" is return cur end
        end
        cur = d.nodes[cur].parent
        guard += 1
    end
    return -1
end

fn scroll_offset_of(scrolls: [int], id: int) -> int is
    let mut i: int = 0
    while i + 1 < array_len(scrolls) is
        if scrolls[i] == id is return scrolls[i + 1] end
        i += 2
    end
    return 0
end

;; Kontener z `scroll-target-group: auto` grupuje swoje odnośniki #id. Aktualny jest ostatni odnośnik, którego cel został już
;; dosunięty do górnej krawędzi swojego obszaru przewijania (albo strony), a gdy żaden jeszcze nie — pierwszy z grupy.
;; `scrolls` = płaskie pary [id kontenera, przesunięcie]; `page_y` = przesunięcie strony. Zwraca id węzła odnośnika lub -1.
pub fn scroll_target_current(boxes: [LayoutBox], d: dom::Dom, group: int, scrolls: [int], page_y: int) -> int is
    let gb: LayoutBox = box_of_node(boxes, group)
    if gb.node_id != group || string_lower(string_trim(props::xget(gb.st.xp, "scroll-target-group"))) != "auto" is return -1 end
    let els: [int] = collect_elements(d, group, 0)
    let mut first: int = -1
    let mut cur: int = -1
    let mut i: int = 0
    while i < array_len(els) is
        let a: int = els[i]
        i += 1
        let href: string = d.nodes[a].attr_href
        if d.nodes[a].tag != "a" || string_len(href) < 2 || string_slice(href, 0, 1) != "#" is continue end
        let tid: int = dom::find_by_id(d, string_slice(href, 1, string_len(href)))
        if tid < 0 is continue end
        let tb: LayoutBox = box_of_node(boxes, tid)
        if tb.node_id != tid is continue end
        if first < 0 is first = a end
        let sc: int = scroller_ancestor_of(boxes, d, tid)
        let mut rel: int = tb.y
        let mut off: int = page_y
        if sc >= 0 is
            let sb: LayoutBox = box_of_node(boxes, sc)
            rel = tb.y - (sb.y + sb.st.bt + sb.st.pad_top)
            off = scroll_offset_of(scrolls, sc)
        end
        if rel <= off + 1 is cur = a end
    end
    return if cur >= 0 then cur else first
end

;; Aktualny odnośnik pierwszej znalezionej grupy scroll-target-group w dokumencie (dla InteractionState.tcur).
pub fn scroll_target_current_any(boxes: [LayoutBox], d: dom::Dom, scrolls: [int], page_y: int) -> int is
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        if b.kind == "box" && b.node_id > 0 && string_lower(string_trim(props::xget(b.st.xp, "scroll-target-group"))) == "auto" is
            let c: int = scroll_target_current(boxes, d, b.node_id, scrolls, page_y)
            if c >= 0 is return c end
        end
    end
    return -1
end

;; ---------- scroll-marker-group / ::scroll-marker ----------
fn drop_temp_node(d0: dom::Dom, parent: int, pid: int) -> dom::Dom is
    let mut d: dom::Dom = d0
    d.nodes[pid].removed = true
    let mut kids: [int] = []
    let mut k: int = 0
    while k < array_len(d.nodes[parent].children) is
        if d.nodes[parent].children[k] != pid is kids = array_push(kids, d.nodes[parent].children[k]) end
        k += 1
    end
    d.nodes[parent].children = kids
    return d
end

fn collect_elements(d: dom::Dom, id: int, depth: int) -> [int] is
    let mut out: [int] = []
    if depth > 60 is return out end
    let kids: [int] = d.nodes[id].children
    let mut k: int = 0
    while k < array_len(kids) is
        let c: int = kids[k]
        k += 1
        if c < 0 || c >= array_len(d.nodes) || d.nodes[c].removed || d.nodes[c].tag == "text" || d.nodes[c].pseudo != "" is continue end
        out = array_push(out, c)
        out = concat_ints(out, collect_elements(d, c, depth + 1))
    end
    return out
end

;; Kontener przewijania z `scroll-marker-group: before | after` dostaje pseudo-element ::scroll-marker-group, a w nim po jednym
;; znaczniku (<span class="scroll-marker">) dla każdego potomka, który ma regułę ::scroll-marker z `content`. Znacznik niesie
;; własności tej reguły jako styl wbudowany, `href="#id"` celu oraz id celu w `title`.
fn make_marker_group(gs0: GenState, sheet: css::Stylesheet, ix: css::InteractionState, host: int, at_start: bool) -> GenState is
    let mut gs: GenState = gs0
    let targets: [int] = collect_elements(gs.d, host, 0)
    let mut m_t: [int] = []
    let mut m_txt: [string] = []
    let mut m_sty: [string] = []
    let mut i: int = 0
    while i < array_len(targets) is
        let e: int = targets[i]
        i += 1
        let mut d2: dom::Dom = dom::new_node(gs.d, e, "span")
        let pid: int = array_len(d2.nodes) - 1
        d2.nodes[pid].pseudo = "scroll-marker"
        let decls: [css::CssDecl] = css::matching_decls_ctx(sheet, d2, pid, ix)
        let expr: string = content_decl_of(decls)
        let low: string = string_lower(expr)
        gs.d = drop_temp_node(d2, e, pid)
        if expr == "" || low == "none" || low == "normal" is continue end
        let txt: string = eval_content(gs, e, expr)
        let mut sty: string = "display: inline-block; "
        let mut di: int = 0
        while di < array_len(decls) is
            if decls[di].prop != "content" is sty = sty + decls[di].prop + ": " + decls[di].val + "; " end
            di += 1
        end
        m_t = array_push(m_t, e)
        m_txt = array_push(m_txt, txt)
        m_sty = array_push(m_sty, sty)
    end
    if array_len(m_t) == 0 is return gs end
    let mut d: dom::Dom = dom::new_node(gs.d, host, "span")
    let gid: int = array_len(d.nodes) - 1
    d.nodes[gid].pseudo = "scroll-marker-group"
    if at_start is
        let mut kids: [int] = [gid]
        let mut k: int = 0
        while k < array_len(d.nodes[host].children) is
            if d.nodes[host].children[k] != gid is kids = array_push(kids, d.nodes[host].children[k]) end
            k += 1
        end
        d.nodes[host].children = kids
    end
    let mut j: int = 0
    while j < array_len(m_t) is
        d = dom::new_node(d, gid, "span")
        let mid: int = array_len(d.nodes) - 1
        d.nodes[mid].attr_class = "scroll-marker"
        d.nodes[mid].attr_style = m_sty[j]
        d.nodes[mid].attr_href = "#" + d.nodes[m_t[j]].attr_id
        d.nodes[mid].attr_title = to_string(m_t[j])
        if m_txt[j] != "" is
            d = dom::new_node(d, mid, "text")
            d.nodes[array_len(d.nodes) - 1].text = m_txt[j]
        end
        j += 1
    end
    gs.d = d
    return gs
end

fn gen_walk(gs0: GenState, sheet: css::Stylesheet, ix: css::InteractionState, id: int, depth: int) -> GenState is
    let mut gs: GenState = gs0
    if depth > 80 is return gs end
    let node: dom::DomNode = gs.d.nodes[id]
    if node.tag == "text" || node.removed || node.pseudo != "" is return gs end
    let decls: [css::CssDecl] = css::matching_decls_ctx(sheet, gs.d, id, ix)
    gs = apply_counter_decls(gs, decls, node.parent)
    gs = apply_string_set(gs, decls, id)
    let saved_qv: string = gs.qv
    let mut qi: int = 0
    while qi < array_len(decls) is
        if decls[qi].prop == "quotes" is gs.qv = string_trim(decls[qi].val) end
        qi += 1
    end
    let orig: [int] = node.children
    let mut smg: string = ""
    let mut si: int = 0
    while si < array_len(decls) is
        if decls[si].prop == "scroll-marker-group" is smg = string_lower(string_trim(decls[si].val)) end
        si += 1
    end
    if smg == "before" is gs = make_marker_group(gs, sheet, ix, id, true) end
    if gs.has_before is gs = make_pseudo(gs, sheet, ix, id, "before") end
    if gs.has_fl is gs = make_first_letter(gs, sheet, ix, id) end
    let mut i: int = 0
    while i < array_len(orig) is
        gs = gen_walk(gs, sheet, ix, orig[i], depth + 1)
        i += 1
    end
    if gs.has_after is gs = make_pseudo(gs, sheet, ix, id, "after") end
    if smg == "after" is gs = make_marker_group(gs, sheet, ix, id, false) end
    gs.qv = saved_qv
    return gen_pop(gs, id)
end

fn sheet_pelem_flags(sheet: css::Stylesheet) -> [bool] is
    let mut b: bool = false
    let mut a: bool = false
    let mut counters: bool = false
    let mut i: int = 0
    while i < array_len(sheet.rules) is
        let r: css::CssRule = sheet.rules[i]
        if r.pelem == "before" is b = true end
        if r.pelem == "after" is a = true end
        let mut j: int = 0
        while j < array_len(r.decls) is
            let p: string = r.decls[j].prop
            if p == "counter-reset" || p == "counter-increment" || p == "counter-set" || p == "scroll-marker-group" is counters = true end
            j += 1
        end
        i += 1
    end
    return [b, a, counters]
end

;; Dodaje do DOM węzły ::before/::after (jako <span> z polem pseudo) według arkusza.
pub fn gen_pseudo(d0: dom::Dom, sheet: css::Stylesheet, ix: css::InteractionState) -> dom::Dom is
    let fl: [bool] = sheet_pelem_flags(sheet)
    if !fl[0] && !fl[1] && !fl[2] && !sheet_has_pelem(sheet, "first-letter") is return d0 end
    let d: dom::Dom = dom::deep_copy(d0)
    let gs: GenState = GenState { d: d, cn: [], cv: [], co: [], has_before: fl[0], has_after: fl[1], has_fl: sheet_has_pelem(sheet, "first-letter"), qv: "", qd: 0, sn: [], sv: [] }
    let out: GenState = gen_walk(gs, sheet, ix, 0, 0)
    return out.d
end

;; Boxy pseudo-elementów należą do elementu-gospodarza (reszta aplikacji nie zna węzłów pseudo).
pub fn remap_pseudo_ids(d: dom::Dom, boxes0: [LayoutBox]) -> [LayoutBox] is
    let mut out: [LayoutBox] = boxes0
    let mut i: int = 0
    while i < array_len(out) is
        let id: int = out[i].node_id
        if id > 0 && id < array_len(d.nodes) && d.nodes[id].pseudo != "" is out[i].node_id = d.nodes[id].parent end
        if id > 0 && id < array_len(d.nodes) && d.nodes[id].tag == "text" && d.nodes[id].parent >= 0 && d.nodes[d.nodes[id].parent].pseudo != "" is
            out[i].node_id = d.nodes[d.nodes[id].parent].parent
        end
        i += 1
    end
    return out
end

;; ---------- punkty wejścia ----------
;; Diagnostyka (SILVER_DEBUG=3): obliczone style wszystkich węzłów — to samo, co widzi layout_full.

;; ---------- display: contents ----------
;; Element z `display: contents` nie tworzy pudełka — jego dzieci trafiają do rodzica. Style (a więc i
;; dziedziczenie) zostały już policzone na pełnym drzewie, więc wystarczy spłaszczyć listy `children`.
fn is_contents_el(d: dom::Dom, styles: [style::ComputedStyle], id: int) -> bool is
    if id <= 0 || id >= array_len(d.nodes) is return false end
    let n: dom::DomNode = d.nodes[id]
    if n.removed || n.tag == "text" is return false end
    return styles[id].display == "contents"
end

;; Elementy zastępowane i `br` z `display: contents` zachowują się jak `display: none` (CSS Display 3).
;; 0.4: transform-box — odniesienie dla transform-origin: [x, y, w, h]. HTML nie ma obwiedni geometrii,
;; więc fill/stroke/view-box = border-box; content-box = obszar treści.
pub fn origin_box(b: LayoutBox, st: style::ComputedStyle) -> [int] is
    let tbx: string = string_lower(props::xget(st.xp, "transform-box"))
    if tbx == "content-box" is
        return [b.x + st.bl + st.pad_left, b.y + st.bt + st.pad_top, b.w - st.bl - st.br - st.pad_left - st.pad_right, b.h - st.bt - st.bb - st.pad_top - st.pad_bottom]
    end
    return [b.x, b.y, b.w, b.h]
end

;; ---------- 0.4: ::first-letter ----------
fn sheet_has_pelem(sheet: css::Stylesheet, name: string) -> bool is
    let mut i: int = 0
    while i < array_len(sheet.rules) is
        if sheet.rules[i].pelem == name is return true end
        i += 1
    end
    return false
end

fn is_ws_ch(c: string) -> bool is
    return c == " " || c == "\n" || c == "\t" || c == "\r"
end

;; Prefiks „pierwszej litery": opcjonalna interpunkcja otwierająca + jeden znak. Zwraca [liczba bajtów prefiksu, bajtów białych znaków przed].
pub fn first_letter_span(t: string) -> [int] is
    let n: int = string_len(t)
    let mut pos: int = 0
    while pos < n && is_ws_ch(string_slice(t, pos, pos + 1)) is pos += 1 end
    let ws: int = pos
    if pos >= n is return [0, ws] end
    let mut guard: int = 0
    while pos < n && guard < 4 is
        let nx: int = ffi_shim::silver_utf8_next(t, pos)
        let step: int = if nx <= pos then pos + 1 else nx
        let c: string = string_slice(t, pos, if step > n then n else step)
        if !hp_is_opening(c) is break end
        pos = step
        guard += 1
    end
    if pos >= n is return [0, ws] end
    let nx2: int = ffi_shim::silver_utf8_next(t, pos)
    let end_pos: int = if nx2 <= pos then pos + 1 else nx2
    return [(if end_pos > n then n else end_pos) - ws, ws]
end

fn make_first_letter(gs0: GenState, sheet: css::Stylesheet, ix: css::InteractionState, host: int) -> GenState is
    let mut gs: GenState = gs0
    let hn: dom::DomNode = gs.d.nodes[host]
    ;; pierwsze dziecko z treścią musi być tekstem (zagnieżdżone inline pomijamy)
    let mut tid: int = -1
    let mut k: int = 0
    while k < array_len(hn.children) is
        let cid: int = hn.children[k]
        k += 1
        let cn: dom::DomNode = gs.d.nodes[cid]
        if cn.removed || cn.pseudo != "" is continue end
        if cn.tag != "text" is break end
        if first_letter_span(cn.text)[0] > 0 is
            tid = cid
        end
        break
    end
    if tid < 0 is return gs end
    let t: string = gs.d.nodes[tid].text
    let sp: [int] = first_letter_span(t)
    let mut d2: dom::Dom = dom::new_node(gs.d, host, "span")
    let pid: int = array_len(d2.nodes) - 1
    d2.nodes[pid].pseudo = "first-letter"
    let decls: [css::CssDecl] = css::matching_decls_ctx(sheet, d2, pid, ix)
    let mut kids: [int] = []
    let mut j: int = 0
    while j < array_len(d2.nodes[host].children) is
        let c: int = d2.nodes[host].children[j]
        j += 1
        if c == pid is continue end
        if c == tid && array_len(decls) > 0 is kids = array_push(kids, pid) end
        kids = array_push(kids, c)
    end
    d2.nodes[host].children = kids
    if array_len(decls) == 0 is
        d2.nodes[pid].removed = true
        gs.d = d2
        return gs
    end
    d2 = dom::new_node(d2, pid, "text")
    let lid: int = array_len(d2.nodes) - 1
    d2.nodes[lid].text = string_slice(t, sp[1], sp[1] + sp[0])
    d2.nodes[tid].text = string_slice(t, sp[1] + sp[0], string_len(t))
    gs.d = d2
    return gs
end

;; ---------- 0.4: initial-letter ----------
;; `initial-letter: <rozmiar> [<zagłębienie> | drop | raise]` → pływająca (float: left) litera o wysokości wersalika obejmującej
;; `rozmiar` wierszy, wcięta o `zagłębienie` wierszy. Dotyczy ::first-letter i zwykłych elementów inline.
;; Rozmiar pisma i interlinia elementu z initial-letter przechodzą na potomków (ich style policzono przed korektą).
fn propagate_font(d: dom::Dom, styles0: [style::ComputedStyle], id: int, fs: int, lhp: int) -> [style::ComputedStyle] is
    let mut styles: [style::ComputedStyle] = styles0
    let mut stack: [int] = [id]
    let mut guard: int = 0
    while array_len(stack) > 0 && guard < 5000 is
        guard += 1
        let cur: int = stack[array_len(stack) - 1]
        let mut ns: [int] = []
        let mut k: int = 0
        while k < array_len(stack) - 1 is
            ns = array_push(ns, stack[k])
            k += 1
        end
        stack = ns
        let kids: [int] = d.nodes[cur].children
        let mut c: int = 0
        while c < array_len(kids) is
            let kid: int = kids[c]
            c += 1
            if kid < 0 || kid >= array_len(styles) is continue end
            styles[kid].font_size = fs
            styles[kid].line_height = lhp
            stack = array_push(stack, kid)
        end
    end
    return styles
end

fn apply_initial_letter(d: dom::Dom, styles0: [style::ComputedStyle], st0: style::ComputedStyle, id: int, win: int) -> style::ComputedStyle is
    let mut st: style::ComputedStyle = style::copy_style(st0)
    let v: string = string_lower(string_trim(props::xget(st.xp, "initial-letter")))
    if v == "" || v == "normal" || v == "none" is return st end
    let node: dom::DomNode = d.nodes[id]
    if node.parent < 0 || node.tag == "text" is return st end
    if node.pseudo != "first-letter" && (st.display != "inline" || st.float_side != "none") is return st end
    let toks: [string] = cssval::split_top(v)
    if !props::is_num(toks[0]) is return st end
    let size: f64 = conv::str_to_float(toks[0])
    if size < 1.0 is return st end
    let size_i: int = conv::float_to_int(size + 0.999)
    let mut sink: int = conv::float_to_int(size)
    if array_len(toks) >= 2 is
        if toks[1] == "raise" is
            sink = 1
        elsif props::is_int(toks[1]) is
            sink = str_to_int(toks[1])
        end
    end
    if sink < 1 is sink = 1 end
    let pst: style::ComputedStyle = styles0[node.parent]
    let lh: int = line_h_of(pst)
    let pcap: int = pst.font_size * font_ratio(win, pst, 1) / 1000
    let cap_h: int = conv::float_to_int((size - 1.0) * conv::int_to_float(lh)) + pcap
    let rat: int = font_ratio(win, st, 1)
    let fs: int = cap_h * 1000 / rat
    st.font_size = if fs < 1 then 1 else fs
    st.float_side = "left"
    st.display = "block"
    let mut ybase: int = (sink - 1) * lh + lh * 8 / 10
    ;; initial-letter-align: alphabetic (domyślnie) | ideographic | hanging | leading | border-box [+ jedno z poprzednich].
    ;; Metryki przybliżone (jak w text-box-edge): ideographic podnosi literę o 0,12 em, hanging obniża ją o 1/5 wysokości wersalika,
    ;; border-box liczy krawędź ramki (dopełnienie + ramka dolna) zamiast linii pisma.
    let al: string = string_lower(string_trim(props::xget(st.xp, "initial-letter-align")))
    if al != "" && al != "normal" && al != "alphabetic" is
        let atoks: [string] = cssval::split_top(al)
        let mut ai: int = 0
        while ai < array_len(atoks) is
            if atoks[ai] == "ideographic" is ybase = ybase - st.font_size * 120 / 1000
            elsif atoks[ai] == "hanging" is ybase = ybase + cap_h / 5
            elsif atoks[ai] == "border-box" is ybase = ybase + st.pad_bottom + st.bb end
            ai += 1
        end
    end
    let lhh: int = 2 * (ybase - st.font_size * 345 / 1000)
    st.line_height = if lhh < 1 then 1 else lhh
    st.height = sink * lh
    st.height_mode = "px"
    if st.mar_right == 0 is
        st.mar_right = if st.font_size / 12 < 3 then 3 else st.font_size / 12
    end
    ;; initial-letter-wrap: none (domyślnie: prostokąt litery) | first | all | grid — first/all dosuwają tekst do konturu litery:
    ;; bez konturu glifu zwężamy zarezerwowane miejsce o przybliżony prześwit boczny kroju (≈ 5 % rozmiaru z każdej strony);
    ;; grid zostawia prostokąt (tekst trzyma siatkę wierszy)
    let iw: string = string_lower(string_trim(props::xget(st.xp, "initial-letter-wrap")))
    if (iw == "first" || iw == "all") && st.mar_right > 0 is
        let tight: int = st.font_size * 50 / 1000
        st.mar_right = if st.mar_right - tight < 0 then 0 else st.mar_right - tight
    end
    if sink < size_i is
        st.mar_top = 0 - (size_i - sink) * lh
    end
    return st
end

;; ---------- 0.4: wartości użyte dla czcionki ----------
;; Wartości domyślne proporcji kroju (promile rozmiaru), gdy shim nie może ich zmierzyć (np. testy bez okna).
fn default_ratio(kind: int) -> int is
    if kind == 0 is return 520 end
    if kind == 1 is return 720 end
    if kind == 2 is return 600 end
    return 1000
end

fn font_ratio(win: int, st: style::ComputedStyle, kind: int) -> int is
    if win >= 0 is
        let r: int = ffi_shim::silver_font_ratio(win, st.font_size, style_flags(st), kind)
        if r > 0 is return r end
    end
    return default_ratio(kind)
end

;; font-size-adjust: `<liczba>` | ex-height N | cap-height N | ch-width N | ic-width N | ic-height N | from-font | none.
;; Zwraca [rodzaj, wartość×1000] albo [] (brak korekty; from-font = ten sam krój, więc bez zmiany).
fn size_adjust_spec(v: string) -> [int] is
    let low: string = string_lower(string_trim(v))
    if low == "" || low == "none" || low == "from-font" is return [] end
    let parts: [string] = string_split(low, " ")
    let mut kind: int = 0
    let mut numtok: string = parts[0]
    if array_len(parts) >= 2 is
        numtok = parts[1]
        if parts[0] == "cap-height" is kind = 1 end
        if parts[0] == "ch-width" is kind = 2 end
        if parts[0] == "ic-width" || parts[0] == "ic-height" is kind = 3 end
    end
    if !props::is_num(numtok) is return [] end
    let val: int = conv::float_to_int(conv::str_to_float(numtok) * 1000.0)
    if val <= 0 is return [] end
    return [kind, val]
end

pub fn used_font_fixups(d: dom::Dom, styles0: [style::ComputedStyle], win: int) -> [style::ComputedStyle] is
    let mut styles: [style::ComputedStyle] = styles0
    let mut i: int = 0
    while i < array_len(styles) && i < array_len(d.nodes) is
        let xp: string = styles[i].xp
        if xp != "" && !d.nodes[i].removed is
            ;; font-variation-settings: oś wght → pogrubienie, ital/slnt → kursywa (osie wdth obsługuje typo::stretch_pct)
            let vs: string = props::xget(xp, "font-variation-settings")
            if vs != "" is
                let wg: int = typo::axis(vs, "wght", -1)
                if wg >= 0 is
                    styles[i].bold = wg >= 600
                    styles[i].font_weight = wg
                end
                let it: int = typo::axis(vs, "ital", -1)
                let sl: int = typo::axis(vs, "slnt", 0)
                if it >= 0 is styles[i].italic = it > 0 end
                if sl != 0 is styles[i].italic = true end
            end
            ;; font-variant-position / "sups" / "subs": pomniejszone pismo; przesunięcie tylko na początku zasięgu (nie dubluje się w potomkach)
            let mut pos: string = string_lower(props::xget(xp, "font-variant-position"))
            if typo::feat(xp, "sups") > 0 is pos = "super" end
            if typo::feat(xp, "subs") > 0 is pos = "sub" end
            ;; 0.4: font-synthesis-position: none — nie syntezuj indeksów (Silver zawsze syntezuje przez skalowanie pisma)
            if (pos == "sub" || pos == "super") && string_lower(string_trim(props::xget(xp, "font-synthesis-position"))) != "none" is
                styles[i].font_size = if styles[i].font_size * 7 / 10 < 6 then 6 else styles[i].font_size * 7 / 10
                let par: int = d.nodes[i].parent
                let par_pos: string = if par >= 0 && par < array_len(styles0) then string_lower(props::xget(styles0[par].xp, "font-variant-position")) else ""
                if par_pos != pos && styles[i].valign == "baseline" && styles[i].valign_px == 0 && d.nodes[i].tag != "text" is styles[i].valign = pos end
            end
            ;; initial-letter (po ewentualnej korekcie rozmiaru)
            if props::xhas(xp, "initial-letter") is
                let before_fs: int = styles[i].font_size
                styles[i] = apply_initial_letter(d, styles0, styles[i], i, win)
                if styles[i].font_size != before_fs || styles[i].float_side == "left" is
                    styles = propagate_font(d, styles, i, styles[i].font_size, styles[i].line_height)
                end
            end
            ;; ruby-position / ruby-align: ustawienia elementu <ruby> i jego adnotacji <rt>
            if d.nodes[i].tag == "ruby" is
                let rp: string = string_lower(props::xget(xp, "ruby-position"))
                if string_starts_with(rp, "under") is styles[i].flex_dir = "column" end
                let ra: string = string_lower(props::xget(xp, "ruby-align"))
                if ra == "start" is styles[i].align = "flex-start" end
                let roh: [int] = ruby_overhang_margins(d, styles, i, win, string_lower(string_trim(props::xget(xp, "ruby-overhang"))))
                styles[i].mar_left = styles[i].mar_left - roh[0]
                styles[i].mar_right = styles[i].mar_right - roh[1]
            end
            if d.nodes[i].tag == "rt" && d.nodes[i].parent >= 0 is
                let prx: string = styles0[d.nodes[i].parent].xp
                let ra2: string = string_lower(props::xget(prx, "ruby-align"))
                if ra2 == "start" is
                    styles[i].text_align = "left"
                elsif ra2 == "space-between" is
                    styles[i].align_self = "stretch"
                    styles[i].xp = props::xset(styles[i].xp, "text-align-last", "justify")
                    styles[i].text_align = "justify"
                end
            end
            if wm_kind(xp) != "" is
                let wpar: int = d.nodes[i].parent
                let same_as_parent: bool = wpar >= 0 && wpar < array_len(styles0) && string_lower(props::xget(styles0[wpar].xp, "writing-mode")) == string_lower(props::xget(xp, "writing-mode"))
                if !same_as_parent && !upright_mode(xp) is styles[i].has_transform = true end
                if upright_mode(xp) is styles[i].white_space = "pre-wrap" end
            end
            ;; font-size-adjust
            let spec: [int] = size_adjust_spec(props::xget(xp, "font-size-adjust"))
            if array_len(spec) == 2 is
                let r: int = font_ratio(win, styles[i], spec[0])
                let ns: int = styles[i].font_size * spec[1] / r
                styles[i].font_size = if ns < 1 then 1 else ns
            end
        end
        i += 1
    end
    return styles
end

pub fn contents_fix_styles(d: dom::Dom, styles0: [style::ComputedStyle]) -> [style::ComputedStyle] is
    let mut styles: [style::ComputedStyle] = styles0
    let mut i: int = 1
    while i < array_len(d.nodes) is
        if is_contents_el(d, styles, i) && (is_replaced(d.nodes[i].tag) || d.nodes[i].tag == "br") is
            styles[i].display = "none"
        end
        i += 1
    end
    return styles
end

fn flatten_contents(d: dom::Dom, styles: [style::ComputedStyle], kids: [int], depth: int) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < array_len(kids) is
        let c: int = kids[i]
        i += 1
        if depth < 64 && is_contents_el(d, styles, c) is
            let inner: [int] = flatten_contents(d, styles, d.nodes[c].children, depth + 1)
            let mut k: int = 0
            while k < array_len(inner) is
                out = array_push(out, inner[k])
                k += 1
            end
        else is
            out = array_push(out, c)
        end
    end
    return out
end

pub fn has_contents(d: dom::Dom, styles: [style::ComputedStyle]) -> bool is
    let mut i: int = 1
    while i < array_len(d.nodes) is
        if is_contents_el(d, styles, i) is return true end
        i += 1
    end
    return false
end

pub fn hoist_contents(d0: dom::Dom, styles: [style::ComputedStyle]) -> dom::Dom is
    if !has_contents(d0, styles) is return d0 end
    let mut d: dom::Dom = d0
    let mut i: int = 0
    while i < array_len(d.nodes) is
        let n: dom::DomNode = d.nodes[i]
        if !n.removed && !is_contents_el(d0, styles, i) is
            let kids: [int] = flatten_contents(d0, styles, n.children, 0)
            if array_len(kids) != array_len(n.children) || has_contents_child(d0, styles, n.children) is
                d.nodes[i].children = kids
                let mut k: int = 0
                while k < array_len(kids) is
                    d.nodes[kids[k]].parent = i
                    k += 1
                end
            end
        end
        i += 1
    end
    ;; same elementy `contents` znikają z drzewa pudełek
    i = 1
    while i < array_len(d.nodes) is
        if is_contents_el(d0, styles, i) is d.nodes[i].children = [] end
        i += 1
    end
    return d
end

fn has_contents_child(d: dom::Dom, styles: [style::ComputedStyle], kids: [int]) -> bool is
    let mut i: int = 0
    while i < array_len(kids) is
        if is_contents_el(d, styles, kids[i]) is return true end
        i += 1
    end
    return false
end

pub fn debug_styles(d: dom::Dom, sheet: css::Stylesheet, ix: css::InteractionState) -> [style::ComputedStyle] is
    return compute_styles(d, sheet, ix)
end

pub fn layout_full(d0: dom::Dom, sheet: css::Stylesheet, viewport_w: int, viewport_h: int, win_handle: int,
                   ix: css::InteractionState, scrolls: [int]) -> LayoutResult is
    return layout_full_a(d0, sheet, viewport_w, viewport_h, win_handle, ix, scrolls, anim::no_anim())
end

;; Jak layout_full, z animacjami @keyframes i przejściami geometrii nałożonymi na style.
fn wrap_flow_code(v: string) -> int is
    let l: string = string_lower(string_trim(v))
    if l == "both" is return 1 end
    if l == "start" is return 2 end
    if l == "end" is return 3 end
    if l == "maximum" is return 4 end
    if l == "minimum" is return 5 end
    if l == "clear" is return 6 end
    return 0
end

;; Elementy wyłączające z opływania (CSS Exclusions): pozycjonowane (absolute/fixed) lub pływające z `wrap-flow` ≠ auto.
fn exclusion_rects(boxes: [LayoutBox]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        if b.kind != "box" || b.node_id <= 0 is continue end
        let code: int = wrap_flow_code(props::xget(b.st.xp, "wrap-flow"))
        if code == 0 is continue end
        if b.st.position != "absolute" && b.st.position != "fixed" && b.st.float_side == "" is continue end
        out = array_push(array_push(array_push(array_push(array_push(array_push(out, b.x), b.y), b.w), b.h), code), b.node_id)
    end
    return out
end

;; Wpisy floatów dla kontenera o treści [x, x+w] wynikające z wykluczeń: jedna strona zostaje dla tekstu, druga jest zablokowana.
;; both (tekst po obu stronach) — Silver ma jeden przedział na wiersz, więc zachowuje się jak maximum.
fn exclusion_records(cx: LayoutCtx, id: int, st: style::ComputedStyle, x: int, y: int, w: int) -> [int] is
    let n: int = array_len(cx.excl)
    if n == 0 || w <= 0 || string_lower(string_trim(props::xget(st.xp, "wrap-through"))) == "none" is return [] end
    let mut out: [int] = []
    let mut k: int = 0
    while k + 5 < n is
        let ex: int = cx.excl[k]
        let ey: int = cx.excl[k + 1]
        let ew: int = cx.excl[k + 2]
        let eh: int = cx.excl[k + 3]
        let code: int = cx.excl[k + 4]
        let en: int = cx.excl[k + 5]
        k += 6
        if en == id || is_ancestor_or_self(cx.dom, en, id) is continue end
        if ex + ew <= x || ex >= x + w || eh <= 0 is continue end
        let left_space: int = ex - x
        let right_space: int = x + w - (ex + ew)
        let mut mode: int = code
        if mode == 1 || mode == 4 is mode = if left_space >= right_space then 2 else 3 end
        elsif mode == 5 is mode = if left_space <= right_space then 2 else 3 end end
        if mode == 2 is
            out = array_push(array_push(array_push(array_push(array_push(out, 3), ey), ey + eh), if ex > x then ex else x), x + w)
        elsif mode == 3 is
            out = array_push(array_push(array_push(array_push(array_push(out, 2), ey), ey + eh), x), if ex + ew < x + w then ex + ew else x + w)
        else is
            out = array_push(array_push(array_push(array_push(array_push(out, 2), ey), ey + eh), x), x + w)
        end
    end
    return out
end

;; Dwa przebiegi: pierwszy ustala położenie elementów wyłączających, drugi układa treść z uwzględnieniem wykluczeń.
pub fn layout_full_a(d0: dom::Dom, sheet: css::Stylesheet, viewport_w: int, viewport_h: int, win_handle: int,
                     ix: css::InteractionState, scrolls: [int], act: anim::AnimCtx) -> LayoutResult is
    let r: LayoutResult = layout_full_b(d0, sheet, viewport_w, viewport_h, win_handle, ix, scrolls, act)
    let ex: [int] = exclusion_rects(r.boxes)
    if array_len(ex) == 0 is return r end
    let mut ix2: css::InteractionState = css::copy_interaction(ix)
    ix2.excl = ex
    return layout_full_b(d0, sheet, viewport_w, viewport_h, win_handle, ix2, scrolls, act)
end

fn layout_full_b(d0: dom::Dom, sheet: css::Stylesheet, viewport_w: int, viewport_h: int, win_handle: int,
                 ix: css::InteractionState, scrolls: [int], act: anim::AnimCtx) -> LayoutResult is
    if array_len(d0.nodes) == 0 || !css::sheet_has_cq(sheet) is
        return layout_core(d0, sheet, viewport_w, viewport_h, win_handle, ix, scrolls, act)
    end
    ;; @container: przebieg 1 mierzy kontenery, przebieg 2 ewaluuje zapytania względem ich rozmiarów
    let r1: LayoutResult = layout_core(d0, sheet, viewport_w, viewport_h, win_handle, ix, scrolls, act)
    let n: int = array_len(d0.nodes)
    let mut cw: [int] = []
    let mut ch: [int] = []
    let mut cn: [string] = []
    let mut i: int = 0
    while i < n is
        cw = array_push(cw, -1)
        ch = array_push(ch, -1)
        cn = array_push(cn, "")
        i += 1
    end
    let mut found_c: bool = false
    i = 0
    while i < array_len(r1.boxes) is
        let b: LayoutBox = r1.boxes[i]
        i += 1
        if b.kind != "box" || b.node_id <= 0 || b.node_id >= n is continue end
        let ty: string = props::xget(b.st.xp, "container-type")
        if ty == "" || ty == "normal" is continue end
        cw[b.node_id] = b.w - b.st.pad_left - b.st.pad_right - b.st.bl - b.st.br
        ch[b.node_id] = if ty == "size" then b.h - b.st.pad_top - b.st.pad_bottom - b.st.bt - b.st.bb else -1
        let nm: string = props::xget(b.st.xp, "container-name")
        cn[b.node_id] = if nm == "none" then "" else nm
        found_c = true
    end
    if !found_c is return r1 end
    let mut ix2: css::InteractionState = ix
    ix2.cq_w = cw
    ix2.cq_h = ch
    ix2.cq_names = cn
    return layout_core(d0, sheet, viewport_w, viewport_h, win_handle, ix2, scrolls, act)
end

;; ====================== 0.4: line-grid / line-snap / box-snap ======================
;; line-grid: create — element zakłada siatkę linii bazowych o skoku równym jego line-height; potomkowie z `line-snap: baseline|contain`
;; mają linie dosuwane w dół do najbliższej linii siatki, a pudełka z `box-snap` — krawędzią (block-start / block-end), środkiem (center)
;; albo linią bazową (first-baseline / last-baseline). Przesunięcie przesuwa całą treść poniżej, a pudełka-przodków powiększa.
fn lg_kw(st: style::ComputedStyle, name: string) -> string is
    return string_lower(string_trim(props::xget(st.xp, name)))
end

fn lg_is_root(cx: LayoutCtx, b: LayoutBox) -> bool is
    if b.kind != "box" || b.node_id <= 0 is return false end
    if lg_kw(b.st, "line-grid") != "create" is return false end
    let p: int = cx.dom.nodes[b.node_id].parent
    if p > 0 && p < array_len(cx.styles) && lg_kw(cx.styles[p], "line-grid") == "create" is return false end
    return true
end

fn lg_mod(v: int, m: int) -> int is
    return ((v % m) + m) % m
end

;; o ile przesunąć w dół wartość v, by trafiła w linię origin + k*pitch
pub fn lg_down(v: int, origin: int, pitch: int) -> int is
    if pitch <= 0 is return 0 end
    let r: int = lg_mod(v - origin, pitch)
    return if r == 0 then 0 else pitch - r
end

fn lg_text_baseline(b: LayoutBox) -> int is
    return b.y + b.h / 2 + 3 * b.st.font_size / 10
end

;; przesuwa o `delta` pudełko `ev` i wszystko od y >= thr; pudełka-przodków `ev` powiększa. grow_ev: `ev` rośnie zamiast się przesuwać.
fn lg_shift(cx: LayoutCtx, boxes: [LayoutBox], ev: int, thr: int, delta: int, grow_ev: bool) -> [LayoutBox] is
    if delta == 0 is return boxes end
    let evn: int = boxes[ev].node_id
    let mut out: [LayoutBox] = boxes
    let mut j: int = 0
    while j < array_len(out) is
        let b: LayoutBox = out[j]
        let anc: bool = j != ev && b.kind == "box" && b.node_id >= 0 && b.node_id != evn && is_in_subtree(cx, evn, b.node_id)
        if anc is
            out[j].h = b.h + delta
            if b.has_clip is out[j].ch = b.ch + delta end
        elsif j == ev && grow_ev is
            out[j].h = b.h + delta
            if b.has_clip is out[j].ch = b.ch + delta end
        elsif j == ev || b.y >= thr is
            out[j].y = b.y + delta
            if b.has_clip is out[j].cy = b.cy + delta end
        end
        j += 1
    end
    return out
end

fn lg_text_in(cx: LayoutCtx, boxes: [LayoutBox], root: int, last: bool) -> int is
    let mut best: int = -1
    let mut j: int = 0
    while j < array_len(boxes) is
        let b: LayoutBox = boxes[j]
        if b.kind == "text" && b.text != "" && b.node_id != root && is_in_subtree(cx, b.node_id, root) is
            if best < 0 || (last && b.y > boxes[best].y) || (!last && b.y < boxes[best].y) is best = j end
        end
        j += 1
    end
    return best
end

fn lg_grid(cx: LayoutCtx, boxes0: [LayoutBox], r: int) -> [LayoutBox] is
    let mut boxes: [LayoutBox] = boxes0
    let rb: LayoutBox = boxes[r]
    let pitch: int = line_h_of(rb.st)
    if pitch <= 0 is return boxes end
    let origin: int = rb.y + rb.st.bt + rb.st.pad_top
    let g0: int = origin + pitch / 2 + 3 * rb.st.font_size / 10
    let n: int = array_len(boxes)
    let mut done: [bool] = []
    let mut i: int = 0
    while i < n is
        done = array_push(done, false)
        i += 1
    end
    let mut guard: int = 0
    while guard < 20000 is
        guard += 1
        let mut best: int = -1
        let mut best_y: int = 0
        let mut j: int = 0
        while j < n is
            if !done[j] && j != r is
                let b: LayoutBox = boxes[j]
                if b.node_id != rb.node_id && is_in_subtree(cx, b.node_id, rb.node_id) is
                    let mut ey: int = -1000000000
                    let mut ok: bool = false
                    if b.kind == "text" && b.text != "" is
                        let ls: string = lg_kw(b.st, "line-snap")
                        if ls == "baseline" || ls == "contain" is
                            ey = b.y
                            ok = true
                        end
                    elsif b.kind == "box" is
                        let bs: string = lg_kw(b.st, "box-snap")
                        if bs == "block-start" || bs == "first-baseline" is
                            ey = b.y
                            ok = true
                        elsif bs == "block-end" || bs == "center" || bs == "last-baseline" is
                            ey = b.y + b.h
                            ok = true
                        end
                    end
                    if ok && (best < 0 || ey < best_y) is
                        best = j
                        best_y = ey
                    end
                end
            end
            j += 1
        end
        if best < 0 is return boxes end
        done[best] = true
        let b: LayoutBox = boxes[best]
        if b.kind == "text" is
            let old_y: int = b.y
            let d: int = lg_down(lg_text_baseline(b), g0, pitch)
            ;; wszystkie fragmenty tego samego wiersza (ten sam y) są obsłużone razem z nim
            let mut k: int = 0
            while k < n is
                if boxes[k].kind == "text" && boxes[k].y == old_y is done[k] = true end
                k += 1
            end
            boxes = lg_shift(cx, boxes, best, old_y, d, false)
        else is
            let bs: string = lg_kw(b.st, "box-snap")
            if bs == "block-start" is
                boxes = lg_shift(cx, boxes, best, b.y, lg_down(b.y, origin, pitch), false)
            elsif bs == "first-baseline" || bs == "last-baseline" is
                let t: int = lg_text_in(cx, boxes, b.node_id, bs == "last-baseline")
                if t >= 0 is boxes = lg_shift(cx, boxes, best, b.y, lg_down(lg_text_baseline(boxes[t]), g0, pitch), false) end
            elsif bs == "block-end" is
                boxes = lg_shift(cx, boxes, best, b.y + b.h, lg_down(b.y + b.h, origin, pitch), true)
            elsif bs == "center" is
                let d1: int = lg_down(b.y, origin, pitch)
                boxes = lg_shift(cx, boxes, best, b.y, d1, false)
                let nb: LayoutBox = boxes[best]
                let lines: int = (nb.h + pitch - 1) / pitch
                let e: int = (if lines < 1 then 1 else lines) * pitch - nb.h
                if e > 0 is
                    boxes = lg_shift(cx, boxes, best, nb.y + nb.h, e, true)
                    let half: int = e / 2
                    let mut m: int = 0
                    while m < n is
                        let c: LayoutBox = boxes[m]
                        if m != best && c.node_id != nb.node_id && is_in_subtree(cx, c.node_id, nb.node_id) is
                            boxes[m].y = c.y + half
                            if c.has_clip is boxes[m].cy = c.cy + half end
                        end
                        m += 1
                    end
                end
            end
        end
    end
    return boxes
end

pub fn apply_line_grids(cx: LayoutCtx, boxes0: [LayoutBox]) -> [LayoutBox] is
    let mut boxes: [LayoutBox] = boxes0
    let mut r: int = 0
    while r < array_len(boxes) is
        if lg_is_root(cx, boxes[r]) is boxes = lg_grid(cx, boxes, r) end
        r += 1
    end
    return boxes
end

fn layout_core(d0: dom::Dom, sheet: css::Stylesheet, viewport_w: int, viewport_h: int, win_handle: int,
               ix: css::InteractionState, scrolls: [int], act: anim::AnimCtx) -> LayoutResult is
    if array_len(d0.nodes) == 0 is return LayoutResult { boxes: [], height: 0 } end
    let d1: dom::Dom = gen_pseudo(ruby_pairs(d0, sheet, ix, act), sheet, ix)
    let styles1: [style::ComputedStyle] = used_font_fixups(d1, contents_fix_styles(d1, compute_styles_a(d1, sheet, ix, act)), win_handle)
    let d: dom::Dom = hoist_contents(d1, styles1)
    let styles: [style::ComputedStyle] = styles1
    let cx: LayoutCtx = LayoutCtx { dom: d, styles: styles, win: win_handle, vw: viewport_w, vh: viewport_h, scrolls: scrolls, floats: [], excl: ix.excl }
    let res: BlockRes = layout_block(cx, 0, 0, 0, viewport_w, viewport_h, viewport_w, false)
    let mut boxes: [LayoutBox] = apply_line_grids(cx, res.boxes)
    let mut doc_h: int = res.h
    ;; absolute / fixed w kolejności dokumentu
    let order: [int] = dom::document_order(d)
    let mut i: int = 0
    while i < array_len(order) is
        let id: int = order[i]
        i += 1
        if id == 0 || d.nodes[id].removed || d.nodes[id].tag == "text" is continue end
        let st: style::ComputedStyle = styles[id]
        if !is_out_of_flow(st) || st.display == "none" is continue end
        ;; pomiń, jeśli przodek ma display:none
        let mut hidden: bool = false
        let mut p: int = d.nodes[id].parent
        while p > 0 is
            if styles[p].display == "none" is hidden = true end
            p = d.nodes[p].parent
        end
        if hidden is continue end
        boxes = place_abs(cx, id, boxes, doc_h)
    end
    boxes = apply_effects(cx, boxes)
    boxes = mark_sticky(cx, boxes)
    boxes = z_sort(cx, boxes)
    boxes = remap_pseudo_ids(d1, boxes)
    i = 0
    while i < array_len(boxes) is
        if !boxes[i].fixed && boxes[i].y + boxes[i].h > doc_h && boxes[i].kind == "box" is doc_h = boxes[i].y + boxes[i].h end
        i += 1
    end
    return LayoutResult { boxes: boxes, height: doc_h }
end

;; Zgodność wsteczna.
pub fn layout_i(d: dom::Dom, sheet: css::Stylesheet, viewport_w: int, win_handle: int, ix: css::InteractionState) -> [LayoutBox] is
    return layout_full(d, sheet, viewport_w, 600, win_handle, ix, []).boxes
end

pub fn layout(d: dom::Dom, sheet: css::Stylesheet, viewport_w: int, win_handle: int) -> [LayoutBox] is
    return layout_i(d, sheet, viewport_w, win_handle, css::no_interaction())
end


;; ---------- scrollIntoView / skok do kotwicy: scroll-margin-top elementu + scroll-padding-top korzenia ----------
pub fn len_px_of(val: string, st: style::ComputedStyle) -> int is
    if val == "" || val == "auto" is return 0 end
    let l: cssval::Len = cssval::parse_len(val, cssval::LenEnv { em: st.font_size, rem: 16, vw: 0, vh: 0 })
    if !l.ok || l.auto is return 0 end
    return cssval::px_of(l, 0)
end

;; Docelowe przewinięcie strony (px od góry) tak, by element `id` zaczynał się pod marginesem/paddingiem; -1 gdy brak boxa.
pub fn scroll_into_y(boxes: [LayoutBox], id: int) -> int is
    let mut target: int = 0
    let mut found_t: bool = false
    let mut root_pad: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        if b.kind != "box" is continue end
        if b.node_id == 0 && root_pad == 0 is root_pad = len_px_of(props::xget(b.st.xp, "scroll-padding-top"), b.st) end
        if b.node_id == id && !found_t is
            target = b.y - len_px_of(props::xget(b.st.xp, "scroll-margin-top"), b.st)
            found_t = true
        end
    end
    if !found_t is
        if id == 0 is return 0 end
        return -1
    end
    let y: int = target - root_pad
    return if y < 0 then 0 else y
end


;; ---------- 0.4: scroll-snap-* (oś pionowa), overscroll-behavior-y ----------
;; Tryb przyciągania w osi Y: "mandatory" | "proximity" | "" (brak). Składnia: none | [x|y|block|inline|both] [mandatory|proximity]?
pub fn snap_mode_y(st: style::ComputedStyle) -> string is
    let v: string = string_lower(props::xget(st.xp, "scroll-snap-type"))
    if v == "" || v == "none" is return "" end
    let t: [string] = cssval::split_top(v)
    let axis: string = t[0]
    if axis != "y" && axis != "block" && axis != "both" is return "" end
    if array_len(t) >= 2 && t[1] == "mandatory" is return "mandatory" end
    return "proximity"
end

;; Pozycja przewinięcia (px), przy której element przyciąga się wg `scroll-snap-align`; -1 gdy brak punktu.
pub fn snap_point_y(b: LayoutBox, vp_h: int, pad_top: int, pad_bottom: int) -> int is
    let al: string = string_lower(props::xget(b.st.xp, "scroll-snap-align"))
    if al == "" || al == "none" is return -1 end
    let t: [string] = cssval::split_top(al)
    let blk: string = t[0]
    let mt: int = len_px_of(props::xget(b.st.xp, "scroll-margin-top"), b.st)
    let mb: int = len_px_of(props::xget(b.st.xp, "scroll-margin-bottom"), b.st)
    let mut p: int = -1
    if blk == "start" is p = b.y - mt - pad_top
    elsif blk == "end" is p = b.y + b.h + mb + pad_bottom - vp_h
    elsif blk == "center" is p = b.y + b.h / 2 - vp_h / 2
    end
    if p < 0 && blk != "none" is
        return 0
    end
    return p
end

fn nearest_snap(points: [int], stops: [int], from: int, want: int, mode: string, vp_h: int) -> int is
    ;; kandydaci tylko „przed” ruchem (w jego kierunku) — dzięki temu pojedynczy tik kółka zawsze posuwa do następnego punktu
    let mut best: int = -1
    let mut i: int = 0
    while i < array_len(points) is
        let p: int = points[i]
        i += 1
        let ahead: bool = (want > from && p > from) || (want < from && p < from) || want == from
        if !ahead is continue end
        if best < 0 is
            best = p
        else is
            let d_new: int = if p > want then p - want else want - p
            let d_old: int = if best > want then best - want else want - best
            if d_new < d_old is best = p end
        end
    end
    if best < 0 is return want end
    if mode == "proximity" is
        let dist: int = if best > want then best - want else want - best
        if dist > vp_h / 4 is return want end
    end
    ;; scroll-snap-stop: always — nie wolno „przeskoczyć” punktu leżącego między startem a celem
    let mut k: int = 0
    while k < array_len(stops) is
        let sp: int = stops[k]
        k += 1
        let between: bool = (best > from && sp > from && sp < best) || (best < from && sp < from && sp > best)
        if between is
            let dn: int = if sp > from then sp - from else from - sp
            let db: int = if best > from then best - from else from - best
            if dn < db is best = sp end
        end
    end
    return best
end

pub fn snap_stop_of(b: LayoutBox) -> bool is
    return string_lower(props::xget(b.st.xp, "scroll-snap-stop")) == "always"
end

;; Przyciąganie przewijania strony: korzeń (node_id 0) nadaje tryb, elementy z `scroll-snap-align` są punktami. Zwraca nową pozycję.
pub fn snap_page_y(boxes: [LayoutBox], d: dom::Dom, from: int, want: int, vp_h: int, max_pos: int) -> int is
    let mut mode: string = ""
    let mut pad_top: int = 0
    let mut pad_bottom: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        let root_like: bool = b.kind == "box" && (b.node_id == 0 || d.nodes[b.node_id].tag == "html" || d.nodes[b.node_id].tag == "body")
        if root_like && snap_mode_y(b.st) != "" is
            mode = snap_mode_y(b.st)
            pad_top = len_px_of(props::xget(b.st.xp, "scroll-padding-top"), b.st)
            pad_bottom = len_px_of(props::xget(b.st.xp, "scroll-padding-bottom"), b.st)
            break
        end
    end
    if mode == "" is return want end
    let mut pts: [int] = []
    let mut stops: [int] = []
    i = 0
    while i < array_len(boxes) is
        let b2: LayoutBox = boxes[i]
        i += 1
        if b2.kind != "box" || b2.node_id == 0 || d.nodes[b2.node_id].tag == "html" is continue end
        let p: int = snap_point_y(b2, vp_h, pad_top, pad_bottom)
        if p >= 0 is
            let pc: int = if p > max_pos then max_pos else p
            pts = array_push(pts, pc)
            if snap_stop_of(b2) is stops = array_push(stops, pc) end
        end
    end
    return nearest_snap(pts, stops, from, want, mode, vp_h)
end

fn is_desc_of(d: dom::Dom, node: int, anc: int) -> bool is
    let mut cur: int = d.nodes[node].parent
    let mut guard: int = 0
    while cur >= 0 && guard < 200 is
        if cur == anc is return true end
        cur = d.nodes[cur].parent
        guard += 1
    end
    return false
end

;; Przyciąganie wewnątrz przewijanego kontenera `cont`. `cur` = przewinięcie, z jakim policzono `boxes` (i od którego startuje ruch); `want` = żądana pozycja. Zwraca nową pozycję.
pub fn snap_container_y(boxes: [LayoutBox], d: dom::Dom, cont: int, cur: int, want: int, max_pos: int) -> int is
    let mut cb: LayoutBox = copy_box(boxes[0])
    let mut found: bool = false
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == cont && boxes[i].kind == "box" is
            cb = boxes[i]
            found = true
            break
        end
        i += 1
    end
    if !found is return want end
    let mode: string = snap_mode_y(cb.st)
    if mode == "" is return want end
    let vp_h: int = cb.h - cb.st.bt - cb.st.bb
    let pad_top: int = len_px_of(props::xget(cb.st.xp, "scroll-padding-top"), cb.st)
    let pad_bottom: int = len_px_of(props::xget(cb.st.xp, "scroll-padding-bottom"), cb.st)
    let mut pts: [int] = []
    let mut stops: [int] = []
    i = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        if b.kind != "box" || b.node_id == cont || b.node_id <= 0 is continue end
        if !is_desc_of(d, b.node_id, cont) is continue end
        let mut rb: LayoutBox = copy_box(b)
        rb.y = b.y - (cb.y + cb.st.bt) + cur
        let p: int = snap_point_y(rb, vp_h, pad_top, pad_bottom)
        if p >= 0 is
            let pc: int = if p > max_pos then max_pos else p
            pts = array_push(pts, pc)
            if snap_stop_of(b) is stops = array_push(stops, pc) end
        end
    end
    return nearest_snap(pts, stops, cur, want, mode, vp_h)
end

;; overscroll-behavior w osi Y: czy przewijanie NIE ma się łańcuchowo przenosić na rodzica (contain | none).
pub fn overscroll_y_contained(st: style::ComputedStyle) -> bool is
    let mut v: string = string_lower(props::xget(st.xp, "overscroll-behavior-y"))
    if v == "" is v = string_lower(props::xget(st.xp, "overscroll-behavior-block")) end
    if v == "" is
        let t: [string] = cssval::split_top(string_lower(props::xget(st.xp, "overscroll-behavior")))
        if array_len(t) >= 2 is v = t[1] elsif array_len(t) == 1 is v = t[0] end
    end
    return v == "contain" || v == "none"
end

pub fn overscroll_of_node(boxes: [LayoutBox], id: int) -> bool is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == "box" is return overscroll_y_contained(boxes[i].st) end
        i += 1
    end
    return false
end


;; ---------- 0.4: oś pozioma — scroll-snap (x/inline/both), overscroll-behavior-x, scroll-margin/padding left/right ----------
pub fn snap_mode_x(st: style::ComputedStyle) -> string is
    let v: string = string_lower(props::xget(st.xp, "scroll-snap-type"))
    if v == "" || v == "none" is return "" end
    let t: [string] = cssval::split_top(v)
    let axis: string = t[0]
    if axis != "x" && axis != "inline" && axis != "both" is return "" end
    if array_len(t) >= 2 && t[1] == "mandatory" is return "mandatory" end
    return "proximity"
end

;; Pozycja przewinięcia poziomego, przy której element przyciąga się wg `scroll-snap-align` (druga wartość = oś inline); -1 gdy brak.
pub fn snap_point_x(b: LayoutBox, vp_w: int, pad_left: int, pad_right: int) -> int is
    let al: string = string_lower(props::xget(b.st.xp, "scroll-snap-align"))
    if al == "" || al == "none" is return -1 end
    let t: [string] = cssval::split_top(al)
    let inl: string = if array_len(t) >= 2 then t[1] else t[0]
    let ml: int = len_px_of(props::xget(b.st.xp, "scroll-margin-left"), b.st)
    let mr: int = len_px_of(props::xget(b.st.xp, "scroll-margin-right"), b.st)
    let mut p: int = -1
    if inl == "start" is p = b.x - ml - pad_left
    elsif inl == "end" is p = b.x + b.w + mr + pad_right - vp_w
    elsif inl == "center" is p = b.x + b.w / 2 - vp_w / 2
    end
    if p < 0 && inl != "none" is return 0 end
    return p
end

pub fn snap_container_x(boxes: [LayoutBox], d: dom::Dom, cont: int, cur: int, want: int, max_pos: int) -> int is
    let mut cb: LayoutBox = copy_box(boxes[0])
    let mut found: bool = false
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == cont && boxes[i].kind == "box" is
