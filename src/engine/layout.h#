    pub text:    string   ;; niepuste = tekst do narysowania
    pub img_src: string   ;; niepuste = obrazek
    pub kind:    string   ;; "box" | "text" | "inlinebg" | "marker"
    pub has_clip: bool
    pub cx: int
    pub cy: int
    pub cw: int
    pub ch: int
    pub fixed:   bool     ;; position: fixed — nie przewija się z dokumentem
    pub content_h: int    ;; pełna wysokość treści (dla pasków przewijania)
    pub scroll_y:  int    ;; zastosowane przesunięcie przewijania kontenera
    pub svg:       string ;; 0.4: znacznik SVG do narysowania (element <svg>)
    pub fx:        string ;; 0.4: specyfikacja efektów warstwy (filter/mask/blend) dla grupy
    pub content_w: int    ;; 0.4: pełna szerokość treści (poziomy pasek przewijania)
    pub scroll_x:  int    ;; 0.4: zastosowane przesunięcie poziome kontenera
    pub sticky:    bool   ;; position: sticky — przesunięcie liczone przy rysowaniu
    pub stk_top:   int    ;; odstęp od góry okna, przy którym element „przykleja się"
    pub stk_y:     int    ;; naturalne y elementu
    pub stk_max:   int    ;; maksymalne dodatkowe przesunięcie (do końca rodzica)
    pub xf_id:     int    ;; 0.3: id elementu z transformacją macierzową (obrót/pochylenie), do której należy box; 0 = brak
    pub xf:        [int]  ;; [a,b,c,d,e,f, pivot_x,pivot_y, x,y,w,h warstwy] (a-d x1000, e/f px x1000)
    pub m3d:       string ;; 0.4: macierz 4×4 (16 liczb ×1e6, współrzędne dokumentu) + "|1" gdy backface-visibility: hidden; "" = brak 3D
end

