            break
        end
        i += 1
    end
    if !found is return want end
    let mode: string = snap_mode_x(cb.st)
    if mode == "" is return want end
    let vp_w: int = cb.w - cb.st.bl - cb.st.br
    let pad_l: int = len_px_of(props::xget(cb.st.xp, "scroll-padding-left"), cb.st)
    let pad_r: int = len_px_of(props::xget(cb.st.xp, "scroll-padding-right"), cb.st)
    let mut pts: [int] = []
    let mut stops: [int] = []
    i = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        if b.kind != "box" || b.node_id == cont || b.node_id <= 0 is continue end
        if !is_desc_of(d, b.node_id, cont) is continue end
        let mut rb: LayoutBox = copy_box(b)
        rb.x = b.x - (cb.x + cb.st.bl) + cur
        let p: int = snap_point_x(rb, vp_w, pad_l, pad_r)
        if p >= 0 is
            let pc: int = if p > max_pos then max_pos else p
            pts = array_push(pts, pc)
            if snap_stop_of(b) is stops = array_push(stops, pc) end
        end
    end
    return nearest_snap(pts, stops, cur, want, mode, vp_w)
end

pub fn overscroll_x_contained(st: style::ComputedStyle) -> bool is
    let mut v: string = string_lower(props::xget(st.xp, "overscroll-behavior-x"))
    if v == "" is v = string_lower(props::xget(st.xp, "overscroll-behavior-inline")) end
