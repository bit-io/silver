end

pub fn overscroll_x_of_node(boxes: [LayoutBox], id: int) -> bool is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == "box" is return overscroll_x_contained(boxes[i].st) end
        i += 1
    end
    return false
end

;; Docelowe przewinięcie poziome kontenera `cont`, by element `id` był widoczny pod scroll-margin-left + scroll-padding-left; -1 gdy brak.
pub fn scroll_into_x(boxes: [LayoutBox], d: dom::Dom, cont: int, id: int) -> int is
    let mut cb: LayoutBox = copy_box(boxes[0])
    let mut tb: LayoutBox = copy_box(boxes[0])
    let mut fc: bool = false
    let mut ft: bool = false
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        if b.kind != "box" is continue end
        if b.node_id == cont && !fc is
            cb = b
            fc = true
        end
        if b.node_id == id && !ft is
            tb = b
            ft = true
        end
    end
    if !fc || !ft is return -1 end
    let pad_l: int = len_px_of(props::xget(cb.st.xp, "scroll-padding-left"), cb.st)
    let ml: int = len_px_of(props::xget(tb.st.xp, "scroll-margin-left"), tb.st)
    let y: int = tb.x - ml - pad_l - (cb.x + cb.st.bl) + cb.scroll_x
    return if y < 0 then 0 else y
end


;; ====================================================================
;;  0.4: zaznaczanie tekstu dokumentu (user-select) — czyste funkcje
;;  „Strumień” = kolejne znaki wszystkich zaznaczalnych boxów tekstowych w kolejności dokumentu.
;;  Zaznaczenie to przedział [lo, hi) offsetów w strumieniu, odporny na przeładowanie układu.
;; ====================================================================
pub fn sel_items(boxes: [LayoutBox]) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        if b.kind == "text" && b.text != "" && b.st.user_select != "none" && b.st.visible && !b.fixed is out = array_push(out, i) end
        i += 1
    end
    return out
end

fn sel_nch(boxes: [LayoutBox], idx: int) -> int is
    return ffi_shim::silver_utf8_len(boxes[idx].text)
end

pub fn sel_total(boxes: [LayoutBox], items: [int]) -> int is
    let mut t: int = 0
    let mut i: int = 0
    while i < array_len(items) is
        t += sel_nch(boxes, items[i])
        i += 1
    end
    return t
end

;; Szerokość pierwszych `nchars` znaków tekstu boxa (win < 0 → oszacowanie jak w układzie).
pub fn sel_prefix_w(win: int, b: LayoutBox, nchars: int) -> int is
    if nchars <= 0 is return 0 end
    let off: int = ffi_shim::silver_utf8_offset(b.text, nchars)
    let pre: string = string_slice(b.text, 0, off)
    let mut w: int = 0
    if win < 0 is
        w = if b.st.bold then nchars * b.st.font_size * 62 / 100 else nchars * b.st.font_size * 58 / 100
    else is
        w = ffi_shim::silver_measure_text_ex(win, shape_prefix(b.st) + pre, b.st.font_size, style_flags(b.st))
    end
    return w + b.st.letter_spacing * nchars
end

;; Liczba znaków boxa, przy której kursor stoi najbliżej poziomej pozycji `dx` (względem lewej krawędzi boxa).
pub fn sel_char_in_box(win: int, b: LayoutBox, dx: int) -> int is
    let n: int = ffi_shim::silver_utf8_len(b.text)
    if dx <= 0 is return 0 end
    if sel_prefix_w(win, b, n) <= dx is return n end
    let mut lo: int = 0
    let mut hi: int = n
    while lo < hi is
        let mid: int = (lo + hi + 1) / 2
        if sel_prefix_w(win, b, mid) <= dx is lo = mid else is hi = mid - 1 end
    end
    if lo < n is
        let w1: int = sel_prefix_w(win, b, lo)
        let w2: int = sel_prefix_w(win, b, lo + 1)
        if dx - w1 > w2 - dx is return lo + 1 end
    end
    return lo
end

;; Offset w strumieniu pod punktem (x,y) w układzie dokumentu; -1 gdy brak zaznaczalnego tekstu.
pub fn sel_offset_at(boxes: [LayoutBox], items: [int], win: int, px: int, py: int) -> int is
    if array_len(items) == 0 is return -1 end
    let mut best: int = -1
    let mut best_d: int = 1000000000
    let mut base: int = 0
    let mut best_base: int = 0
    let mut i: int = 0
    while i < array_len(items) is
        let b: LayoutBox = boxes[items[i]]
        let vd: int = if py < b.y then b.y - py elsif py >= b.y + b.h then py - (b.y + b.h) + 1 else 0
        let hd: int = if px < b.x then b.x - px elsif px > b.x + b.w then px - (b.x + b.w) else 0
        let d: int = vd * 4096 + hd
        if d < best_d is
            best_d = d
            best = i
            best_base = base
        end
        base += sel_nch(boxes, items[i])
        i += 1
    end
    let bb: LayoutBox = boxes[items[best]]
    return best_base + sel_char_in_box(win, bb, px - bb.x)
end

;; Tekst zaznaczenia [lo, hi): wiersze (zmiana y) oddzielone znakiem nowej linii.
pub fn sel_text(boxes: [LayoutBox], items: [int], lo: int, hi: int) -> string is
    if hi <= lo is return "" end
    let mut out: string = ""
    let mut base: int = 0
    let mut last_y: int = -1000000
    let mut i: int = 0
    while i < array_len(items) is
        let b: LayoutBox = boxes[items[i]]
        let n: int = sel_nch(boxes, items[i])
        let s: int = if lo > base then lo else base
        let e: int = if hi < base + n then hi else base + n
        if e > s is
            let piece: string = string_slice(b.text, ffi_shim::silver_utf8_offset(b.text, s - base), ffi_shim::silver_utf8_offset(b.text, e - base))
            if out != "" && b.y != last_y is out = out + "\n" end
            out = out + piece
            last_y = b.y
        end
        base += n
        i += 1
    end
    return out
end

;; Prostokąty podświetlenia: płaska lista [x, y, w, h, …] (współrzędne dokumentu).
pub fn sel_rects(boxes: [LayoutBox], items: [int], win: int, lo: int, hi: int) -> [int] is
    let mut out: [int] = []
    if hi <= lo is return out end
    let mut base: int = 0
    let mut i: int = 0
    while i < array_len(items) is
        let b: LayoutBox = boxes[items[i]]
        let n: int = sel_nch(boxes, items[i])
        let s: int = if lo > base then lo else base
        let e: int = if hi < base + n then hi else base + n
        if e > s is
            let x0: int = b.x + sel_prefix_w(win, b, s - base)
            let x1: int = b.x + sel_prefix_w(win, b, e - base)
            out = array_push(out, x0)
            out = array_push(out, b.y)
            out = array_push(out, if x1 > x0 then x1 - x0 else 1)
            out = array_push(out, b.h)
        end
        base += n
        i += 1
    end
    return out
end

fn sel_is_word_ch(c: string) -> bool is
    return c != " " && c != "\t" && c != "\n" && string_find(".,;:!?()[]{}\"'«»„”“", c) < 0
end

;; Granice słowa wokół offsetu `off` → [lo, hi]; [off, off] gdy poza tekstem.
pub fn sel_word_at(boxes: [LayoutBox], items: [int], off: int) -> [int] is
    let mut base: int = 0
    let mut i: int = 0
    while i < array_len(items) is
        let b: LayoutBox = boxes[items[i]]
        let n: int = sel_nch(boxes, items[i])
        if off >= base && off <= base + n is
            let local: int = if off - base >= n then n - 1 else off - base
            if local < 0 is return [off, off] end
            let ch_at: string = string_slice(b.text, ffi_shim::silver_utf8_offset(b.text, local), ffi_shim::silver_utf8_offset(b.text, local + 1))
            let want_word: bool = sel_is_word_ch(ch_at)
            let mut a: int = local
            while a > 0 is
                let c: string = string_slice(b.text, ffi_shim::silver_utf8_offset(b.text, a - 1), ffi_shim::silver_utf8_offset(b.text, a))
                if sel_is_word_ch(c) != want_word is break end
                a -= 1
            end
            let mut z: int = local + 1
            while z < n is
                let c2: string = string_slice(b.text, ffi_shim::silver_utf8_offset(b.text, z), ffi_shim::silver_utf8_offset(b.text, z + 1))
                if sel_is_word_ch(c2) != want_word is break end
                z += 1
            end
            return [base + a, base + z]
        end
        base += n
        i += 1
    end
    return [off, off]
end

;; Cały wiersz (wszystkie boxy o tym samym y co box pod offsetem) → [lo, hi].
pub fn sel_line_at(boxes: [LayoutBox], items: [int], off: int) -> [int] is
    let mut base: int = 0
    let mut target_y: int = -1000000
    let mut i: int = 0
    while i < array_len(items) is
        let n: int = sel_nch(boxes, items[i])
        if off >= base && off <= base + n is
            target_y = boxes[items[i]].y
            break
        end
        base += n
        i += 1
    end
    if target_y == -1000000 is return [off, off] end
    let mut lo: int = -1
    let mut hi: int = 0
    base = 0
    i = 0
    while i < array_len(items) is
        let n2: int = sel_nch(boxes, items[i])
        if boxes[items[i]].y == target_y is
            if lo < 0 is lo = base end
            hi = base + n2
        end
        base += n2
        i += 1
    end
    return [if lo < 0 then off else lo, hi]
end

;; user-select: all — gdy box pod offsetem ma `all`, zaznaczany jest cały tekst jego przodka blokowego; inaczej [off, off].
pub fn sel_all_scope(boxes: [LayoutBox], items: [int], d: dom::Dom, off: int) -> [int] is
    let mut base: int = 0
    let mut hit_node: int = -1
    let mut i: int = 0
    while i < array_len(items) is
        let n: int = sel_nch(boxes, items[i])
        if off >= base && off <= base + n is
            if boxes[items[i]].st.user_select != "all" is return [off, off] end
            hit_node = boxes[items[i]].node_id
            break
        end
        base += n
        i += 1
    end
    if hit_node < 0 is return [off, off] end
    ;; najbliższy przodek, którego box nie jest inline
    let mut blk: int = hit_node
    let mut guard: int = 0
    while blk > 0 && guard < 64 is
        let mut disp: string = "inline"
        let mut k: int = 0
        while k < array_len(boxes) is
            if boxes[k].node_id == blk && boxes[k].kind == "box" is
                disp = boxes[k].st.display
                break
            end
            k += 1
        end
        if disp != "inline" is break end
        blk = d.nodes[blk].parent
        guard += 1
    end
    let mut lo: int = -1
    let mut hi: int = 0
    base = 0
    i = 0
    while i < array_len(items) is
        let n2: int = sel_nch(boxes, items[i])
        let nid: int = boxes[items[i]].node_id
        if nid == blk || is_desc_of(d, nid, blk) is
            if lo < 0 is lo = base end
            hi = base + n2
        end
        base += n2
        i += 1
    end
    return [if lo < 0 then off else lo, hi]
end


;; ====================================================================
;;  0.4: text-emphasis-* — znaczniki nad/pod znakami (kropki, kółka, trójkąty, własny napis)
;; ====================================================================
fn emph_kind(v: string) -> string is
    let t: [string] = cssval::split_top(v)
    let mut i: int = 0
    while i < array_len(t) is
        if t[i] == "dot" || t[i] == "circle" || t[i] == "double-circle" || t[i] == "triangle" || t[i] == "sesame" is return t[i] end
        i += 1
    end
    return ""
end

;; Znak znacznika z text-emphasis-style ("" gdy none). filled domyślnie; shape domyślnie dot.
pub fn emphasis_glyph(st: style::ComputedStyle) -> string is
    let raw: string = string_trim(props::xget(st.xp, "text-emphasis-style"))
    let v: string = string_lower(raw)
    if v == "" || v == "none" is return "" end
    if string_starts_with(raw, "\"") || string_starts_with(raw, "'") is
        let inner: string = string_slice(raw, 1, string_len(raw) - 1)
        if inner == "" is return "" end
        let n: int = ffi_shim::silver_utf8_next(inner, 0)
        return string_slice(inner, 0, n)
    end
    let open: bool = trim_token(v, "open")
    let mut kind: string = emph_kind(v)
    if kind == "" is kind = "dot" end
    if kind == "dot" is
        if open is return "◦" end
        return "•"
    end
    if kind == "circle" is
        if open is return "○" end
        return "●"
    end
    if kind == "double-circle" is
        if open is return "◎" end
        return "◉"
    end
    if kind == "triangle" is
        if open is return "△" end
        return "▲"
    end
    if open is return "﹆" end
    return "﹅"
end

;; Czy pod tym znakiem rysować znacznik (text-emphasis-skip: spaces | punctuation | symbols | narrow; domyślnie spaces punctuation)
fn emph_skip_char(c: string, skip: string) -> bool is
    if c == " " || c == "\t" || c == "\n" is return !trim_token(skip, "none") && (skip == "" || trim_token(skip, "spaces") || !(trim_token(skip, "punctuation") || trim_token(skip, "symbols") || trim_token(skip, "narrow"))) end
    if string_find(".,;:!?…()[]{}\"'«»„“”‘’-–—/\\", c) >= 0 is return (skip == "" || trim_token(skip, "punctuation")) && !trim_token(skip, "none") end
    return false
end

;; Pozycje znaczników: płaska lista [x_środka, y_góry, …] w układzie dokumentu. over = nad tekstem, under = pod.
pub fn emphasis_marks(b: LayoutBox, win: int) -> [int] is
    let mut out: [int] = []
    let g: string = emphasis_glyph(b.st)
    if g == "" || b.text == "" is return out end
    let skip: string = string_lower(props::xget(b.st.xp, "text-emphasis-skip"))
    let pos: string = string_lower(props::xget(b.st.xp, "text-emphasis-position"))
    let under: bool = trim_token(pos, "under")
    let mh: int = b.st.font_size / 2 * 12 / 10
    let y: int = if under then b.y + b.h else b.y - mh
    let n: int = ffi_shim::silver_utf8_len(b.text)
    let mut i: int = 0
    while i < n is
        let o0: int = ffi_shim::silver_utf8_offset(b.text, i)
        let o1: int = ffi_shim::silver_utf8_offset(b.text, i + 1)
        let ch: string = string_slice(b.text, o0, o1)
        if !emph_skip_char(ch, skip) is
            let x0: int = sel_prefix_w(win, b, i)
            let x1: int = sel_prefix_w(win, b, i + 1)
            out = array_push(out, b.x + (x0 + x1) / 2)
            out = array_push(out, y)
        end
        i += 1
    end
    return out
end


;; ====================================================================
;;  0.4: osie czasu animacji sterowane przewijaniem (animation-timeline, animation-range, scroll-timeline-*, view-timeline-*)
;; ====================================================================
;; animation-timeline → [rodzaj, źródło, oś, nazwa]; rodzaj: none | scroll | view | named
pub fn parse_timeline(v0: string) -> [string] is
    let v: string = string_lower(string_trim(v0))
    if v == "" || v == "auto" || v == "none" is return ["none", "", "", ""] end
    if string_starts_with(v, "--") is return ["named", "", "", v] end
    let open: int = string_find(v, "(")
    let close: int = string_find(v, ")")
    if open < 0 || close < open is return ["none", "", "", ""] end
    let fname: string = string_slice(v, 0, open)
    let args: [string] = cssval::split_top(string_slice(v, open + 1, close))
    let mut src: string = "nearest"
    let mut axis: string = "block"
    let mut i: int = 0
    while i < array_len(args) is
        let a: string = args[i]
        i += 1
        if a == "root" || a == "nearest" || a == "self" is src = a
        elsif a == "block" || a == "inline" || a == "x" || a == "y" is axis = a
        end
    end
    if fname == "scroll" is return ["scroll", src, axis, ""] end
    if fname == "view" is return ["view", "nearest", axis, ""] end
    return ["none", "", "", ""]
end

;; animation-range lub para longhandów animation-range-start / -end
fn range_value(st: style::ComputedStyle) -> string is
    let rs: string = string_trim(props::xget(st.xp, "animation-range-start"))
    let re: string = string_trim(props::xget(st.xp, "animation-range-end"))
    if rs != "" || re != "" is
        let a: string = if rs == "" then "normal" else rs
        let b: string = if re == "" then "normal" else re
        return a + " " + b
    end
    return props::xget(st.xp, "animation-range")
end

fn is_range_name(t: string) -> bool is
    return t == "cover" || t == "contain" || t == "entry" || t == "exit" || t == "entry-crossing" || t == "exit-crossing"
end

fn is_offset_tok(t: string) -> bool is
    if t == "" is return false end
    let c: string = string_at(t, 0)
    return (c >= "0" && c <= "9") || c == "-" || c == "+" || c == "."
end

;; animation-range ("<start> [<end>]") → [nazwa_start, offset_start, nazwa_koniec, offset_koniec]; puste nazwy = cały zakres osi
pub fn parse_range(v0: string) -> [string] is
    let v: string = string_lower(string_trim(v0))
    if v == "" || v == "normal" is return ["", "0%", "", "100%"] end
    let t: [string] = cssval::split_top(v)
    let mut names: [string] = []
    let mut offs: [string] = []
    let mut i: int = 0
    while i < array_len(t) is
        let tk: string = t[i]
        i += 1
        if tk == "normal" is
            names = array_push(names, "")
            offs = array_push(offs, "")
        elsif is_range_name(tk) is
            names = array_push(names, tk)
            offs = array_push(offs, "")
        elsif is_offset_tok(tk) is
            if array_len(names) > 0 && offs[array_len(offs) - 1] == "" && names[array_len(names) - 1] != "" is
                offs[array_len(offs) - 1] = tk
            else is
                names = array_push(names, "")
                offs = array_push(offs, tk)
            end
        end
    end
    if array_len(names) == 0 is return ["", "0%", "", "100%"] end
    if array_len(names) == 1 is
        if names[0] != "" && offs[0] == "" is return [names[0], "0%", names[0], "100%"] end
        return [names[0], if offs[0] == "" then "0%" else offs[0], "", "100%"]
    end
    let so: string = if offs[0] == "" then "0%" else offs[0]
    let eo: string = if offs[1] == "" then "100%" else offs[1]
    return [names[0], so, names[1], eo]
end

;; granice nazwanego zakresu widoku [start, koniec] w px wzdłuż „cover” (długość D = S + H)
pub fn view_range_bounds(name: string, port: int, subj: int) -> [int] is
    let d: int = port + subj
    if name == "entry" || name == "entry-crossing" is return [0, subj] end
    if name == "exit" || name == "exit-crossing" is return [port, d] end
    if name == "contain" is
        if subj <= port is return [subj, port] end
        return [port, subj]
    end
    return [0, d]
end

;; pozycja (px wzdłuż cover) z nazwy i przesunięcia: procent względem długości zakresu nazwanego, długość w px
pub fn range_point_px(name: string, off: string, port: int, subj: int, em: int) -> int is
    let b: [int] = view_range_bounds(name, port, subj)
    let len: int = b[1] - b[0]
    if string_ends_with(off, "%") is
        return b[0] + (gfx::parse_x1000(string_slice(off, 0, string_len(off) - 1)) * len + 50000) / 100000
    end
    return b[0] + gfx::len_px(off, 0, em)
end

;; odwzorowanie położenia na osi na czas animacji (ms): clamp((cur − start)/(end − start), 0, 1) · dur
pub fn range_to_elapsed(cur: int, rs: int, re: int, dur: int) -> int is
    if re <= rs is
        if cur >= re is return dur end
        return 0
    end
    if cur <= rs is return 0 end
    if cur >= re is return dur end
    return (cur - rs) * dur / (re - rs)
end

;; Najbliższy przodek będący kontenerem przewijanym (node_id) albo -1 (= okno/strona).
fn nearest_scroller(boxes: [LayoutBox], d: dom::Dom, nid: int, include_self: bool) -> int is
    let mut cur: int = if include_self then nid else d.nodes[nid].parent
    let mut guard: int = 0
    while cur > 0 && guard < 100 is
        let mut i: int = 0
        while i < array_len(boxes) is
            let b: LayoutBox = boxes[i]
            i += 1
            if b.node_id == cur && b.kind == "box" && style::is_scroll_container(b.st) && (b.content_h > b.h - b.st.bt - b.st.bb || b.content_w > b.w - b.st.bl - b.st.br) is return cur end
        end
        cur = d.nodes[cur].parent
        guard += 1
    end
    return -1
end

;; nazwany element osi czasu (scroll-timeline-name / view-timeline-name); -1 gdy brak
fn is_ancestor_or_self(d: dom::Dom, anc: int, id: int) -> bool is
    let mut cur: int = id
    let mut guard: int = 0
    while cur >= 0 && guard < 400 is
        if cur == anc is return true end
        cur = d.nodes[cur].parent
        guard += 1
    end
    return false
end

;; Czy nazwana oś czasu zadeklarowana na `tnode` jest widoczna dla elementu `nid`: widzi ją sam deklarujący i jego potomkowie;
;; `timeline-scope: --nazwa | all` na przodku (lub na samym `nid`) rozszerza zasięg na całe jego poddrzewo.
fn timeline_visible(boxes: [LayoutBox], d: dom::Dom, nid: int, tnode: int, name: string) -> bool is
    if is_ancestor_or_self(d, tnode, nid) is return true end
    let mut cur: int = nid
    let mut guard: int = 0
    while cur >= 0 && guard < 400 is
        if is_ancestor_or_self(d, cur, tnode) is
            let b: LayoutBox = box_of_node(boxes, cur)
            let sc: [string] = cssval::split_top(string_lower(props::xget(b.st.xp, "timeline-scope")))
            let mut k: int = 0
            while k < array_len(sc) is
                if sc[k] == name || sc[k] == "all" is return true end
                k += 1
            end
        end
        cur = d.nodes[cur].parent
        guard += 1
    end
    return false
end

fn find_named_timeline(boxes: [LayoutBox], d: dom::Dom, nid: int, name: string, key: string) -> int is
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: LayoutBox = boxes[i]
        i += 1
        if b.kind == "box" && b.node_id > 0 && string_lower(props::xget(b.st.xp, key)) == name && timeline_visible(boxes, d, nid, b.node_id, name) is return b.node_id end
    end
    return -1
end

fn axis_is_vertical(axis: string) -> bool is
    return axis == "block" || axis == "y" || axis == ""
end

;; Zakres animacji w ms dla elementu `nid` o stylu `st` na osi czasu sterowanej przewijaniem; -1 gdy brak osi (czas zegarowy).
;; scroll_y/page_max/vp_w/vp_h opisują stronę; dla kontenerów korzystamy z pól box.scroll_*.
pub fn timeline_elapsed(boxes: [LayoutBox], d: dom::Dom, nid: int, st: style::ComputedStyle, scroll_y: int, page_max: int, vp_w: int, vp_h: int) -> int is
    let tl: [string] = parse_timeline(props::xget(st.xp, "animation-timeline"))
    if tl[0] == "none" is return -1 end
    let dur: int = st.anim_ms
    if dur <= 0 is return -1 end
    let mut kind: string = tl[0]
    let mut src: string = tl[1]
    let mut axis: string = tl[2]
    let mut scroller_node: int = -2
    let mut subject: int = nid
    if kind == "named" is
        ;; oś nazwana: scroll-timeline-name na kontenerze albo view-timeline-name na obiekcie
        let sn: int = find_named_timeline(boxes, d, nid, tl[3], "scroll-timeline-name")
        let vn: int = find_named_timeline(boxes, d, nid, tl[3], "view-timeline-name")
        if vn >= 0 is
            kind = "view"
            subject = vn
            let vb: LayoutBox = box_of_node(boxes, vn)
            axis = string_lower(props::xget(vb.st.xp, "view-timeline-axis"))
            if axis == "" is axis = "block" end
        elsif sn >= 0 is
            kind = "scroll"
            scroller_node = sn
            let sb: LayoutBox = box_of_node(boxes, sn)
            axis = string_lower(props::xget(sb.st.xp, "scroll-timeline-axis"))
            if axis == "" is axis = "block" end
        else is
            return -1
        end
    end
    let vert: bool = axis_is_vertical(axis)
    if kind == "scroll" is
        let mut node: int = scroller_node
        if node == -2 is
            if src == "root" is node = -1
            elsif src == "self" is node = nearest_scroller(boxes, d, nid, true)
            else is node = nearest_scroller(boxes, d, nid, false)
            end
        end
        let mut off: int = 0
        let mut mx: int = 0
        if node < 0 is
            off = if vert then scroll_y else 0
            mx = if vert then page_max else 0
        else is
            let c: LayoutBox = box_of_node(boxes, node)
            if vert is
                off = c.scroll_y
                mx = c.content_h - (c.h - c.st.bt - c.st.bb)
            else is
                off = c.scroll_x
                mx = c.content_w - (c.w - c.st.bl - c.st.br)
            end
        end
        if mx < 1 is return 0 end
        let r: [string] = parse_range(range_value(st))
        let rs: int = range_point_px("", r[1], mx, 0, st.font_size)
        let re: int = range_point_px("", r[3], mx, 0, st.font_size)
        return range_to_elapsed(off, rs, re, dur)
    end
    ;; view(): obiekt względem kontenera przewijanego (najbliższego) albo okna
    let sc: int = nearest_scroller(boxes, d, subject, false)
    let sb2: LayoutBox = box_of_node(boxes, subject)
    let mut port: int = 0
    let mut subj_start: int = 0
    let mut subj: int = 0
    if sc < 0 is
        port = if vert then vp_h else vp_w
        subj_start = if vert then sb2.y - scroll_y else sb2.x
        subj = if vert then sb2.h else sb2.w
    else is
        let c2: LayoutBox = box_of_node(boxes, sc)
        port = if vert then c2.h - c2.st.bt - c2.st.bb else c2.w - c2.st.bl - c2.st.br
        subj_start = if vert then sb2.y - (c2.y + c2.st.bt) else sb2.x - (c2.x + c2.st.bl)
        subj = if vert then sb2.h else sb2.w
    end
    ;; view-timeline-inset: "<start> [<end>]" (auto = 0)
    let insv: [string] = cssval::split_top(string_lower(props::xget(sb2.st.xp, "view-timeline-inset")))
    let mut ins_s: int = 0
    let mut ins_e: int = 0
    if array_len(insv) >= 1 && insv[0] != "auto" is ins_s = gfx::len_px(insv[0], port, sb2.st.font_size) end
    ins_e = ins_s
    if array_len(insv) >= 2 && insv[1] != "auto" is ins_e = gfx::len_px(insv[1], port, sb2.st.font_size) end
    let eff: int = port - ins_s - ins_e
    if eff + subj < 1 is return 0 end
    ;; położenie wzdłuż cover (px): 0 gdy początek obiektu dotyka końca (przyciętego) okna widoku
    let cur: int = (port - ins_e) - subj_start
    let r2: [string] = parse_range(range_value(st))
    let rs2: int = range_point_px(r2[0], r2[1], eff, subj, st.font_size)
    let re2: int = range_point_px(r2[2], r2[3], eff, subj, st.font_size)
    return range_to_elapsed(cur, rs2, re2, dur)
end


;; 0.4: prawdziwa kopia pudełka (patrz style::copy_style) — styl też jest kopiowany.
pub fn copy_box(b: LayoutBox) -> LayoutBox is
    return LayoutBox {
        node_id: b.node_id,
        x: b.x,
        y: b.y,
        w: b.w,
        h: b.h,
        st: style::copy_style(b.st),
        text: b.text,
        img_src: b.img_src,
        kind: b.kind,
        has_clip: b.has_clip,
        cx: b.cx,
        cy: b.cy,
        cw: b.cw,
        ch: b.ch,
        fixed: b.fixed,
        content_h: b.content_h,
        scroll_y: b.scroll_y,
        svg: b.svg,
        fx: b.fx,
        content_w: b.content_w,
        scroll_x: b.scroll_x,
        sticky: b.sticky,
        stk_top: b.stk_top,
        stk_y: b.stk_y,
        stk_max: b.stk_max,
        xf_id: b.xf_id,
        xf: style::copy_ints(b.xf),
        m3d: b.m3d
    }
end
