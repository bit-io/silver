        st.tr_m = src.tr_m
        st.xp = copy_xkey(st.xp, src.xp, "x-m-transform")
        st.origin_x = src.origin_x
        st.origin_y = src.origin_y
    elsif prop == "filter" is
        st.has_filter = src.has_filter
        st.f_gray = src.f_gray
        st.f_bright = src.f_bright
        st.f_contrast = src.f_contrast
        st.f_invert = src.f_invert
        st.f_sepia = src.f_sepia
        st.f_opacity = src.f_opacity
    elsif prop == "clip-path" is st.clip_path = src.clip_path
    elsif prop == "pointer-events" is st.pointer_events = src.pointer_events
    elsif prop == "user-select" is st.user_select = src.user_select
    elsif prop == "resize" is st.resize = src.resize
    elsif prop == "accent-color" is
        st.accent = src.accent
        st.has_accent = src.has_accent
    elsif prop == "transition" || prop == "transition-duration" || prop == "transition-property" ||
          prop == "transition-delay" || prop == "transition-timing-function" is
        st.trans_ms = src.trans_ms
        st.trans_prop = src.trans_prop
        st.trans_delay = src.trans_delay
        st.trans_ease = src.trans_ease
    elsif string_starts_with(prop, "animation") is
        st.anim_name = src.anim_name
        st.anim_ms = src.anim_ms
        st.anim_delay = src.anim_delay
        st.anim_iter = src.anim_iter
        st.anim_dir = src.anim_dir
        st.anim_fill = src.anim_fill
        st.anim_ease = src.anim_ease
        st.anim_paused = src.anim_paused
    elsif prop == "content" is
        st.has_content = src.has_content
        st.content = src.content
    elsif props::known(prop) is
        st.xp = copy_xkey(st.xp, src.xp, prop)
        if prop == "rotate" || prop == "scale" || prop == "translate" is
            st.xp = copy_xkey(st.xp, src.xp, "x-m-" + prop)
        end
    end
    return st
end

fn copy_xkey(dst: string, src: string, key: string) -> string is
    if props::xhas(src, key) is return props::xset(dst, key, props::xget(src, key)) end
    return props::xdel(dst, key)
end

;; Słowa kluczowe całej kaskady: inherit / initial / unset / revert.
fn apply_css_wide(st0: ComputedStyle, prop: string, kw: string, parent: ComputedStyle) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    if prop == "all" is
        let keep: string = st.vars
        if kw == "inherit" is
            st = parent
        else is
            st = if kw == "initial" then root_style() else base_for(parent)
        end
        st.vars = keep
        return st
    end
    if kw == "inherit" is return copy_prop(st, parent, prop) end
    if kw == "initial" is return copy_prop(st, root_style(), prop) end
    ;; unset / revert
    if is_inherited_prop(prop) is return copy_prop(st, parent, prop) end
    return copy_prop(st, root_style(), prop)
end

fn apply_border_style(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let toks: [string] = cssval::split_top(string_lower(val))
    if array_len(toks) == 0 is return st end
    let a: string = toks[0]
    let b: string = if array_len(toks) >= 2 then toks[1] else a
    let c: string = if array_len(toks) >= 3 then toks[2] else a
    let d: string = if array_len(toks) >= 4 then toks[3] else b
    st.border_style = a
    st.bs_r = b
    st.bs_b = c
    st.bs_l = d
    if a == "none" || a == "hidden" is
        st.bt = 0
        st.border = 0
    end
    if b == "none" || b == "hidden" is st.br = 0 end
    if c == "none" || c == "hidden" is st.bb = 0 end
    if d == "none" || d == "hidden" is st.bl = 0 end
    return st
end

;; Właściwości spoza głównego łańcucha apply_decls.
fn apply_extra(st0: ComputedStyle, prop: string, val: string, lower: string, env: cssval::LenEnv, parent: ComputedStyle) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    if prop == "float" is
        st.float_side = if lower == "inline-start" then "left" elsif lower == "inline-end" then "right" else lower
    elsif prop == "clear" is st.clear_side = lower
    elsif prop == "align-content" is st.align_content = grid_align_kw(lower)
    elsif prop == "justify-items" is st.justify_items = grid_align_kw(lower)
    elsif prop == "justify-self" is st.justify_self = if lower == "auto" then "" else grid_align_kw(lower)
    elsif prop == "place-items" is
        let t: [string] = cssval::split_top(lower)
        st.align = grid_align_kw(t[0])
        st.justify_items = grid_align_kw(if array_len(t) >= 2 then t[1] else t[0])
    elsif prop == "place-content" is
        let t: [string] = cssval::split_top(lower)
        st.align_content = grid_align_kw(t[0])
        st.justify = grid_align_kw(if array_len(t) >= 2 then t[1] else t[0])
    elsif prop == "place-self" is
        let t: [string] = cssval::split_top(lower)
        st.align_self = grid_align_kw(t[0])
        st.justify_self = grid_align_kw(if array_len(t) >= 2 then t[1] else t[0])
    elsif prop == "grid-template-areas" is st.grid_areas = if lower == "none" then "" else parse_areas(val)
    elsif prop == "grid-template" is
        if string_find(val, "\"") >= 0 is st.grid_areas = parse_areas(val) end
    elsif prop == "grid-area" is
        if string_find(lower, "/") >= 0 is
            let parts: [string] = string_split(lower, "/")
            let rs: int = str_to_int(string_trim(parts[0]))
            let cs: int = if array_len(parts) >= 2 then str_to_int(string_trim(parts[1])) else 0
            let re: int = if array_len(parts) >= 3 then str_to_int(string_trim(parts[2])) else 0
            let ce: int = if array_len(parts) >= 4 then str_to_int(string_trim(parts[3])) else 0
            st.grid_row_start = rs
            st.grid_col_start = cs
            st.grid_row_span = if re > rs && rs > 0 then re - rs else 1
            st.grid_col_span = if ce > cs && cs > 0 then ce - cs else 1
            st.grid_area = ""
        else is
            st.grid_area = string_trim(lower)
        end
    elsif prop == "grid-row" || prop == "grid-row-start" is
        let ls: [int] = parse_line_span(lower)
        st.grid_row_start = ls[0]
        st.grid_row_span = ls[1]
    elsif prop == "grid-auto-flow" is st.grid_auto_flow = lower
    elsif prop == "grid-auto-rows" is st.grid_auto_rows = val
    elsif prop == "grid-auto-columns" is st.grid_auto_cols = val
    elsif prop == "aspect-ratio" is st.aspect_ratio = parse_aspect(lower)
    elsif prop == "transform" is
        st = apply_transform_fns(st, val, env)
        let tm: [int] = parse_transform_matrix(val, env)
        st.xp = if array_len(tm) == 6 then props::xset(st.xp, "x-m-transform", mat_str(tm)) else props::xdel(st.xp, "x-m-transform")
    elsif prop == "rotate" || prop == "scale" || prop == "translate" is
        st.xp = props::xapply(st.xp, prop, val)
        let toks: [string] = cssval::split_top(lower)
        let mut mm: [int] = []
        if lower != "none" && array_len(toks) > 0 is
            if prop == "rotate" is
                mm = mat_rotate(angle_deci(toks[array_len(toks) - 1]))
            elsif prop == "scale" is
                let sx: int = milli_of(num_f(toks[0]))
                mm = [sx, 0, 0, if array_len(toks) >= 2 then milli_of(num_f(toks[1])) else sx, 0, 0]
            else is
                mm = [1000, 0, 0, 1000, px_milli(toks[0], env), if array_len(toks) >= 2 then px_milli(toks[1], env) else 0]
            end
        end
        st.xp = if array_len(mm) == 6 then props::xset(st.xp, "x-m-" + prop, mat_str(mm)) else props::xdel(st.xp, "x-m-" + prop)
    elsif prop == "transform-origin" is
        let t: [string] = cssval::split_top(lower)
        if array_len(t) >= 1 is
            let first: string = t[0]
            let vertical_first: bool = (first == "top" || first == "bottom") && array_len(t) >= 2
            if vertical_first is
                st.origin_y = origin_tok(t[0])
                st.origin_x = origin_tok(t[1])
            else is
                st.origin_x = origin_tok(t[0])
                if array_len(t) >= 2 is st.origin_y = origin_tok(t[1]) end
            end
        end
    elsif prop == "filter" is st = apply_filter_fns(st, val)
    elsif prop == "clip-path" is st.clip_path = if lower == "none" then "" else lower
    elsif prop == "pointer-events" is st.pointer_events = lower != "none"
    elsif prop == "user-select" is st.user_select = lower
    elsif prop == "resize" is st.resize = lower
    elsif prop == "scroll-behavior" is st.scroll_behavior = lower
    elsif prop == "accent-color" is
        if lower == "auto" is
            st.has_accent = false
        else is
            st.accent = parse_color(val)
            st.has_accent = true
        end
    elsif prop == "letter-spacing" is
        st.letter_spacing = if lower == "normal" then 0 else len_px_or(val, env, 0, 0)
    elsif prop == "word-spacing" is
        st.word_spacing = if lower == "normal" then 0 else len_px_or(val, env, 0, 0)
    elsif prop == "text-indent" is st.text_indent = len_px_or(val, env, 0, 0)
    elsif prop == "text-shadow" is st = apply_text_shadow(st, val, env)
    elsif prop == "vertical-align" is st = apply_vertical_align(st, lower, env)
    elsif prop == "list-style" is
        if lower == "none" is st.list_style = "none" else is st = apply_list_style(st, val) end
    elsif prop == "list-style-type" is st.list_style = lower
    elsif prop == "list-style-position" is st.list_pos = lower
    elsif prop == "font-family" is
        st.font_family = string_trim(strip_quotes(string_trim(val)))
        st.font_key = family_key(val)
    elsif prop == "text-decoration-color" is
        st.deco_color = parse_color(val)
        st.has_deco_color = true
    elsif prop == "text-decoration-style" is st.deco_style = lower
    elsif prop == "text-decoration-thickness" is st.deco_thick = len_px_or(val, env, 0, 0)
    elsif prop == "direction" is st.direction = lower
    elsif prop == "hyphens" is st.hyphens = lower
    elsif prop == "border-spacing" is
        let t: [string] = cssval::split_top(lower)
        st.border_spacing = len_px_or(t[0], env, 0, 0)
    elsif prop == "border-collapse" is st.border_collapse = lower == "collapse"
    elsif prop == "table-layout" is st.table_fixed = lower == "fixed"
    elsif prop == "tab-size" is
        let n: int = str_to_int(lower)
        if n > 0 && props::is_int(lower) is
            st.tab_size = n
            st.xp = props::xdel(st.xp, "tab-size")
        else is
            st.xp = props::xapply(st.xp, "tab-size", val)
        end
    elsif prop == "border-top-style" is st.border_style = lower
    elsif prop == "border-right-style" is st.bs_r = lower
    elsif prop == "border-bottom-style" is st.bs_b = lower
    elsif prop == "border-left-style" is st.bs_l = lower
    elsif prop == "outline-style" is st.outline_style = lower
    elsif prop == "outline-offset" is st.outline_offset = len_px_or(val, env, 0, 0)
    elsif prop == "background-repeat" is st.bg_repeat = lower
    elsif prop == "background-position" is st.bg_pos = lower
    elsif prop == "animation" is st = apply_animation(st, val)
    elsif prop == "animation-name" is st.anim_name = if lower == "none" then "" else lower
    elsif prop == "animation-duration" is st.anim_ms = first_duration_ms(val)
    elsif prop == "animation-delay" is st.anim_delay = first_duration_ms(val)
    elsif prop == "animation-iteration-count" is
        st.anim_iter = if lower == "infinite" then -1 else parse_milli(lower)
    elsif prop == "animation-direction" is st.anim_dir = lower
    elsif prop == "animation-fill-mode" is st.anim_fill = lower
    elsif prop == "animation-timing-function" is st.anim_ease = lower
    elsif prop == "animation-play-state" is st.anim_paused = lower == "paused"
    elsif prop == "transition-property" is st.trans_prop = string_replace(lower, " ", "")
    elsif prop == "transition-delay" is st.trans_delay = first_duration_ms(val)
    elsif prop == "transition-timing-function" is st.trans_ease = lower
    elsif prop == "text-wrap" || prop == "text-wrap-mode" || prop == "text-wrap-style" is
        st.xp = props::xapply(st.xp, prop, val)
        if prop == "text-wrap" || prop == "text-wrap-mode" is
            if lower == "nowrap" && st.white_space == "normal" is st.white_space = "nowrap" end
            if lower == "wrap" && st.white_space == "nowrap" is st.white_space = "normal" end
        end
    elsif prop == "white-space-collapse" is
        st.xp = props::xapply(st.xp, prop, val)
        if lower == "preserve" || lower == "break-spaces" is st.white_space = "pre-wrap"
        elsif lower == "preserve-breaks" is st.white_space = "pre-line"
        elsif lower == "collapse" is st.white_space = if st.white_space == "pre" || st.white_space == "pre-wrap" || st.white_space == "pre-line" then "normal" else st.white_space end
        end
    elsif prop == "line-break" is
        st.xp = props::xapply(st.xp, prop, val)
        if lower == "anywhere" is st.break_words = true end
    elsif prop == "background-position-x" || prop == "background-position-y" is
        let toks: [string] = cssval::split_top(st.bg_pos)
        let mut bx: string = if array_len(toks) >= 1 then toks[0] else "0%"
        let mut by: string = if array_len(toks) >= 2 then toks[1] else "0%"
        let v: string = if lower == "left" || lower == "top" then "0%" elsif lower == "center" then "50%" elsif lower == "right" || lower == "bottom" then "100%" else lower
        if prop == "background-position-x" is bx = v else is by = v end
        st.bg_pos = bx + " " + by
        st.xp = props::xapply(st.xp, prop, val)
    elsif prop == "columns" is
        let t: [string] = cssval::split_top(lower)
        let mut k: int = 0
        while k < array_len(t) is
            if props::is_int(t[k]) is st.xp = props::xset(st.xp, "column-count", t[k])
            elsif t[k] == "auto" is st.xp = st.xp
            elsif props::is_len(t[k]) is st.xp = props::xset(st.xp, "column-width", t[k]) end
            k += 1
        end
    elsif prop == "column-rule" is
        let t: [string] = cssval::split_top(lower)
        let mut k: int = 0
        while k < array_len(t) is
            if is_line_style(t[k]) is st.xp = props::xset(st.xp, "column-rule-style", t[k])
            elsif t[k] == "thin" || t[k] == "medium" || t[k] == "thick" || (props::is_len(t[k]) && !cssval::is_color(t[k])) is st.xp = props::xset(st.xp, "column-rule-width", t[k])
            elsif cssval::is_color(t[k]) is st.xp = props::xset(st.xp, "column-rule-color", t[k]) end
            k += 1
        end
    elsif prop == "container" is
        let sl: int = string_find(val, "/")
        let nm: string = string_trim(if sl >= 0 then string_slice(val, 0, sl) else val)
        let ty: string = if sl >= 0 then string_trim(string_slice(val, sl + 1, string_len(val))) else "normal"
        if props::valid("container-type", ty) is
            st.xp = props::xset(st.xp, "container-type", string_lower(ty))
            st.xp = if nm == "" || nm == "none" then props::xdel(st.xp, "container-name") else props::xset(st.xp, "container-name", nm)
        end
    else is
        st.xp = props::xapply(st.xp, prop, val)
        if prop == "contain" && (string_find(lower, "paint") >= 0 || string_find(lower, "strict") >= 0 || string_find(lower, "content") >= 0) is
            if st.overflow_x == "visible" is st.overflow_x = "hidden" end
            if st.overflow_y == "visible" is st.overflow_y = "hidden" end
        end
    end
    return st
end

;; Klucz rodziny dla natywnego rejestru czcionek: hash pierwszej nazwy z listy font-family
;; (1..32750); 0 dla rodzin ogólnych (sans-serif, monospace, …) — używają czcionki domyślnej.
pub fn family_key(list: string) -> int is
    let parts: [string] = cssval::split_commas(list)
    if array_len(parts) == 0 is return 0 end
    let mut first: string = string_lower(string_trim(parts[0]))
    if string_len(first) >= 2 && (string_starts_with(first, "\"") || string_starts_with(first, "'")) is
        first = string_trim(string_slice(first, 1, string_len(first) - 1))
    end
    if first == "" || first == "serif" || first == "sans-serif" || first == "monospace" || first == "cursive" || first == "fantasy" ||
       first == "system-ui" || first == "ui-sans-serif" || first == "ui-serif" || first == "ui-monospace" || first == "ui-rounded" ||
       first == "-apple-system" || first == "blinkmacsystemfont" || first == "inherit" || first == "initial" || first == "unset" is
        return 0
    end
    let mut h: int = 5381
    let mut i: int = 0
    while i < string_len(first) is
        h = (h * 33 + conv::char_to_int(string_at(first, i))) % 32749
        i += 1
    end
    return h + 1
end

;; Zbiera zmienne --x z deklaracji (dziedziczone po potomkach).
fn collect_vars(inherited_vars: string, decls: [css::CssDecl]) -> string is
    let mut vars: string = inherited_vars
    let mut i: int = 0
    while i < array_len(decls) is
        if string_starts_with(decls[i].prop, "--") is
            vars = vars_set(vars, decls[i].prop, decls[i].val)
        end
        i += 1
    end
    return vars
end

pub fn apply_decls(base: ComputedStyle, decls0: [css::CssDecl], em_base: int, ix: css::InteractionState, parent: ComputedStyle) -> ComputedStyle is
    let decls: [css::CssDecl] = expand_logical(decls0, dir_is_rtl(decls0, parent.direction))
    let mut st: ComputedStyle = base
    st.vars = collect_vars(st.vars, decls)
    let basis: int = ix.viewport_w
    let mut i: int = 0
    while i < array_len(decls) is
        let d: css::CssDecl = decls[i]
        i += 1
        if string_starts_with(d.prop, "--") is continue end
        let val: string = string_trim(substitute_vars(d.val, st.vars))
        let prop: string = unprefix(d.prop)
        let lower: string = string_lower(val)
        if lower == "inherit" || lower == "initial" || lower == "unset" || lower == "revert" is
            st = apply_css_wide(st, prop, lower, parent)
            continue
        end
        let em: int = if prop == "font-size" then parent.font_size else st.font_size
        let env: cssval::LenEnv = env_for(if em > 0 then em else em_base, ix)

        if prop == "display" is
            st.display = lower
            if lower == "inline-flex" is st.display = "inline-flex" end
            if lower == "inline-table" is st.display = "table" end
            if lower == "table-caption" is st.display = "block" end
            if lower == "table-column" || lower == "table-column-group" is st.display = "none" end
            if lower == "inline-grid" is st.display = "grid" end
        elsif prop == "position" is st.position = lower
        elsif prop == "visibility" is st.visible = lower != "hidden" && lower != "collapse"
        elsif prop == "color" is
            if lower == "currentcolor" is st.color = st.color else is st.color = parse_color(val) end
        elsif prop == "background" is
            st = apply_background(st, val, em, env)
            st = apply_bg_extras(st, val)
        elsif prop == "background-color" is
            st.background = parse_color(val)
            st.has_bg = st.background.a > 0
        elsif prop == "background-image" is
            if string_find(lower, "linear-gradient") >= 0 is
                st = parse_gradient(st, string_slice(val, string_find(lower, "linear-gradient"), string_len(val)))
            elsif string_starts_with(lower, "url(") is
                st.bg_image = strip_quotes(string_slice(val, 4, string_len(val) - 1))
            else is
                st.bg_image = ""
                st.has_grad = false
            end
        elsif prop == "background-size" is st.bg_size = lower
        elsif prop == "width" is
            let s: SizeRes = parse_size(val, env)
            st.width = s.px
            st.width_pct = s.pct
            st.width_mode = s.mode
        elsif prop == "height" is
            let s: SizeRes = parse_size(val, env)
            st.height = s.px
            st.height_pct = s.pct
            st.height_mode = s.mode
        elsif prop == "min-width" is
            let s: SizeRes = parse_size(val, env)
            st.min_width = if s.px < 0 then 0 else s.px
            st.min_width_pct = s.pct
        elsif prop == "max-width" is
            let s: SizeRes = parse_size(val, env)
            st.max_width = s.px
            st.max_width_pct = s.pct
            st.max_width_mode = s.mode
        elsif prop == "min-height" is
            let s: SizeRes = parse_size(val, env)
            st.min_height = if s.px < 0 then 0 else s.px
        elsif prop == "max-height" is
            let s: SizeRes = parse_size(val, env)
            st.max_height = s.px
            st.max_height_mode = s.mode
        elsif prop == "box-sizing" is st.border_box = lower == "border-box"
        elsif prop == "padding" is
            let sides: BoxSides = parse_box_shorthand(val, env, basis)
            st.pad_top = sides.top
            st.pad_right = sides.right
            st.pad_bottom = sides.bottom
            st.pad_left = sides.left
            st.padding = sides.top
        elsif prop == "padding-top" is st.pad_top = box_px(val, env, basis)
        elsif prop == "padding-right" is st.pad_right = box_px(val, env, basis)
        elsif prop == "padding-bottom" is st.pad_bottom = box_px(val, env, basis)
        elsif prop == "padding-left" is st.pad_left = box_px(val, env, basis)
        elsif prop == "margin" is
            let sides: BoxSides = parse_margin_shorthand(val, env, basis)
            st.mar_top = sides.top
            st.mar_right = sides.right
            st.mar_bottom = sides.bottom
            st.mar_left = sides.left
            st.margin = sides.top
        elsif prop == "margin-top" is st.mar_top = margin_px(val, env, basis)
        elsif prop == "margin-right" is st.mar_right = margin_px(val, env, basis)
        elsif prop == "margin-bottom" is st.mar_bottom = margin_px(val, env, basis)
        elsif prop == "margin-left" is st.mar_left = margin_px(val, env, basis)
        elsif prop == "top" is st.top = pos_px(val, env, ix.viewport_h)
        elsif prop == "right" is st.right = pos_px(val, env, basis)
        elsif prop == "bottom" is st.bottom = pos_px(val, env, ix.viewport_h)
        elsif prop == "left" is st.left = pos_px(val, env, basis)
        elsif prop == "inset" is
            let sides: BoxSides = parse_margin_shorthand(val, env, basis)
            st.top = sides.top
            st.right = sides.right
            st.bottom = sides.bottom
            st.left = sides.left
        elsif prop == "z-index" is st.z_index = str_to_int(lower)
        elsif prop == "font-size" is
            let fs: int = if lower == "small" then 13 elsif lower == "medium" then 16 elsif lower == "large" then 18
                          elsif lower == "x-large" then 24 elsif lower == "xx-large" then 32
                          elsif lower == "smaller" then parent.font_size * 83 / 100
                          elsif lower == "larger" then parent.font_size * 120 / 100
                          else len_px_or(val, env, parent.font_size, st.font_size)
            st.font_size = if fs < 1 then 1 else fs
        elsif prop == "font-weight" is
            st.bold = parse_font_weight(val)
            st.font_weight = font_weight_num(lower, st.font_weight)
        elsif prop == "font-style" is st.italic = lower == "italic" || lower == "oblique"
        elsif prop == "font" is
            let toks: [string] = cssval::split_top(val)
            let mut k: int = 0
            while k < array_len(toks) is
                let t: string = string_lower(toks[k])
                k += 1
                if t == "bold" || t == "700" || t == "800" || t == "900" is st.bold = true end
                if t == "italic" is st.italic = true end
                let slash: int = string_find(t, "/")
                let head: string = if slash >= 0 then string_slice(t, 0, slash) else t
                if string_find(head, "px") >= 0 || string_find(head, "rem") >= 0 || (string_find(head, "em") >= 0 && head != "em") is
                    st.font_size = len_px_or(head, env, parent.font_size, st.font_size)
                    if slash >= 0 is st.line_height = parse_line_height(string_slice(t, slash + 1, string_len(t)), st.font_size, env) end
                end
            end
        elsif prop == "line-height" is st.line_height = parse_line_height(val, st.font_size, env)
        elsif prop == "text-align" is st.text_align = if lower == "justify-all" then "justify" elsif lower == "match-parent" then parent.text_align else lower
        elsif prop == "text-transform" is st.text_transform = lower
        elsif prop == "text-decoration" || prop == "text-decoration-line" is
            st = apply_text_decoration(st, val)
            if prop == "text-decoration" is st = apply_deco_extras(st, val) end
        elsif prop == "text-overflow" is st.ellipsis = lower == "ellipsis"
        elsif prop == "white-space" is st.white_space = lower
        elsif prop == "word-break" || prop == "overflow-wrap" || prop == "word-wrap" is
            st.break_words = lower == "break-all" || lower == "break-word" || lower == "anywhere"
        elsif prop == "cursor" is st.cursor = lower
        elsif prop == "overflow" is st = apply_overflow(st, val, "both")
        elsif prop == "overflow-x" is st = apply_overflow(st, val, "x")
        elsif prop == "overflow-y" is st = apply_overflow(st, val, "y")
        elsif prop == "border" is
            let b: BorderRes = parse_border_value(val, env, st.border_color)
            st = set_all_borders(st, b.w, b.color, true)
            let bs: string = if b.bstyle == "" then "solid" else b.bstyle
            st.border_style = bs
            st.bs_r = bs
            st.bs_b = bs
            st.bs_l = bs
        elsif prop == "border-width" is
            let sides: BoxSides = parse_box_shorthand(val, env, 0)
            st.bt = sides.top
            st.br = sides.right
            st.bb = sides.bottom
            st.bl = sides.left
            st.border = sides.top
        elsif prop == "border-color" is
            let toks: [string] = cssval::split_top(val)
            if array_len(toks) > 0 is
                let c1: Color = parse_color(toks[0])
                let c2: Color = if array_len(toks) >= 2 then parse_color(toks[1]) else c1
                let c3: Color = if array_len(toks) >= 3 then parse_color(toks[2]) else c1
                let c4: Color = if array_len(toks) >= 4 then parse_color(toks[3]) else c2
                st.bct = c1
                st.bcr = c2
                st.bcb = c3
                st.bcl = c4
                st.border_color = c1
            end
        elsif prop == "border-style" is
            st = apply_border_style(st, val)
        elsif prop == "border-top" is
            let b: BorderRes = parse_border_value(val, env, st.bct)
            st.border_style = if b.bstyle == "" then "solid" else b.bstyle
            st.bt = b.w
            st.border = b.w
            if b.has_color is
                st.bct = b.color
                st.border_color = b.color
            end
        elsif prop == "border-right" is
            let b: BorderRes = parse_border_value(val, env, st.bcr)
            st.bs_r = if b.bstyle == "" then "solid" else b.bstyle
            st.br = b.w
            if b.has_color is st.bcr = b.color end
        elsif prop == "border-bottom" is
            let b: BorderRes = parse_border_value(val, env, st.bcb)
            st.bs_b = if b.bstyle == "" then "solid" else b.bstyle
            st.bb = b.w
            if b.has_color is st.bcb = b.color end
        elsif prop == "border-left" is
            let b: BorderRes = parse_border_value(val, env, st.bcl)
            st.bs_l = if b.bstyle == "" then "solid" else b.bstyle
            st.bl = b.w
            if b.has_color is st.bcl = b.color end
        elsif prop == "border-top-width" is
            st.bt = box_px(val, env, 0)
            st.border = st.bt
        elsif prop == "border-right-width" is st.br = box_px(val, env, 0)
        elsif prop == "border-bottom-width" is st.bb = box_px(val, env, 0)
        elsif prop == "border-left-width" is st.bl = box_px(val, env, 0)
        elsif prop == "border-top-color" is
            st.bct = parse_color(val)
            st.border_color = st.bct
        elsif prop == "border-right-color" is st.bcr = parse_color(val)
        elsif prop == "border-bottom-color" is st.bcb = parse_color(val)
        elsif prop == "border-left-color" is st.bcl = parse_color(val)
        elsif prop == "border-radius" is
            let r: BoxSides = parse_radius_all(val, env, 0)
            st.rad_tl = r.top
            st.rad_tr = r.right
            st.rad_br = r.bottom
            st.rad_bl = r.left
        elsif prop == "border-top-left-radius" is st.rad_tl = box_px(val, env, 0)
        elsif prop == "border-top-right-radius" is st.rad_tr = box_px(val, env, 0)
        elsif prop == "border-bottom-right-radius" is st.rad_br = box_px(val, env, 0)
        elsif prop == "border-bottom-left-radius" is st.rad_bl = box_px(val, env, 0)
        elsif prop == "box-shadow" is st = apply_shadow(st, val, env)
        elsif prop == "outline" is
            let b: BorderRes = parse_border_value(val, env, st.outline_color)
            st.outline_w = b.w
            if b.has_color is st.outline_color = b.color end
        elsif prop == "outline-width" is st.outline_w = box_px(val, env, 0)
        elsif prop == "outline-color" is st.outline_color = parse_color(val)
        elsif prop == "gap" is
            let toks: [string] = cssval::split_top(val)
            st.row_gap = box_px(toks[0], env, 0)
            st.gap = if array_len(toks) >= 2 then box_px(toks[1], env, 0) else st.row_gap
            st.xp = props::xset(st.xp, "column-gap", "set")
        elsif prop == "column-gap" || prop == "grid-column-gap" is
            st.gap = box_px(val, env, 0)
            st.xp = if lower == "normal" then props::xdel(st.xp, "column-gap") else props::xset(st.xp, "column-gap", "set")
        elsif prop == "row-gap" || prop == "grid-row-gap" is st.row_gap = box_px(val, env, 0)
        elsif prop == "flex-direction" is st.flex_dir = lower
        elsif prop == "flex-wrap" is st.flex_wrap = lower == "wrap" || lower == "wrap-reverse"
        elsif prop == "flex-flow" is st = apply_flex_flow(st, val)
        elsif prop == "flex" is st = apply_flex_shorthand(st, val, env)
        elsif prop == "flex-grow" is st.flex_grow = parse_milli(val)
        elsif prop == "flex-shrink" is st.flex_shrink = parse_milli(val)
        elsif prop == "flex-basis" is st.flex_basis = len_px_or(val, env, 0, -1)
        elsif prop == "order" is st.order = str_to_int(lower)
        elsif prop == "justify-content" is st.justify = if lower == "start" then "flex-start" elsif lower == "end" then "flex-end" else lower
        elsif prop == "align-items" is st.align = if lower == "start" then "flex-start" elsif lower == "end" then "flex-end" elsif lower == "normal" then "stretch" else lower
        elsif prop == "align-self" is st.align_self = if lower == "auto" then "" elsif lower == "start" then "flex-start" elsif lower == "end" then "flex-end" else lower
        elsif prop == "grid-template-columns" is st.grid_cols = val
        elsif prop == "grid-template-rows" is st.grid_rows = val
        elsif prop == "grid-column" || prop == "grid-column-start" is
            let ls: [int] = parse_line_span(lower)
            st.grid_col_start = ls[0]
            st.grid_col_span = ls[1]
        elsif prop == "opacity" is st.opacity = parse_opacity(val)
        elsif prop == "object-fit" is st.object_fit = lower
        elsif prop == "transition" is st = apply_transition(st, val)
        elsif prop == "transition-duration" is st.trans_ms = first_duration_ms(val)
        elsif prop == "content" is
            st.has_content = lower != "none" && lower != "normal"
            st.content = strip_quotes(val)
        else is
            st = apply_extra(st, prop, val, lower, env, parent)
        end
    end
    return finalize_transform(st)
end

;; Główna funkcja: styl węzła z kaskady + dziedziczenie.
pub fn resolve_ctx(sheet: css::Stylesheet, d: dom::Dom, node_id: int, inherited: ComputedStyle, ix: css::InteractionState) -> ComputedStyle is
    let n: dom::DomNode = d.nodes[node_id]
    let st: ComputedStyle = default_style_for(n.tag, inherited)
    let decls: [css::CssDecl] = css::matching_decls_ctx(sheet, d, node_id, ix)
    return apply_decls(st, decls, inherited.font_size, ix, inherited)
end

;; Zgodność wsteczna (bez kontekstu drzewa).
pub fn resolve(sheet: css::Stylesheet, tag: string, id: string, classes: [string], inherited: ComputedStyle) -> ComputedStyle is
    let st: ComputedStyle = default_style_for(tag, inherited)
    let decls: [css::CssDecl] = css::matching_decls(sheet, tag, id, classes)
    return apply_decls(st, decls, inherited.font_size, css::no_interaction(), inherited)
end

pub fn split_classes(attr_class: string) -> [string] is
    if string_trim(attr_class) == "" is return [] end
    return string_split(string_trim(attr_class), " ")
end

;; Stały rozmiar z trybu: -1 gdy auto, inaczej px (+ procent z `basis`).
pub fn size_of(px: int, pct: int, mode: string, basis: int) -> int is
    if mode == "auto" is return -1 end
    if mode == "pct" is
        if basis < 0 is return -1 end
        return px + basis * pct / 10000
    end
    return px
end

;; Styl tekstu węzła tekstowego: dziedziczy po rodzicu, display inline.
pub fn text_style(parent: ComputedStyle) -> ComputedStyle is
    let mut st: ComputedStyle = base_for(parent)
    st.display = "inline"
    return st
end

pub fn is_scroll_container(st: ComputedStyle) -> bool is
    return st.overflow_x != "visible" || st.overflow_y != "visible"
end

pub fn line_height_of(st: ComputedStyle, font_h: int) -> int is
    if st.line_height > 0 is return st.line_height end
    return font_h
end
