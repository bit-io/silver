    elsif prop == "border-top-left-radius" is st.rad_tl = src.rad_tl
    elsif prop == "border-top-right-radius" is st.rad_tr = src.rad_tr
    elsif prop == "border-bottom-right-radius" is st.rad_br = src.rad_br
