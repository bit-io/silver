pub fn root_font_size() -> int is return 16 end

;; Styl startowy elementu: dziedziczone pola z rodzica, reszta domyślna.
fn base_for(inherited: ComputedStyle) -> ComputedStyle is
    let mut st: ComputedStyle = root_style()
    st.color = inherited.color
    st.font_size = inherited.font_size
    st.bold = inherited.bold
    st.italic = inherited.italic
    st.underline = inherited.underline
    st.strike = inherited.strike
    st.line_height = inherited.line_height
    st.text_align = inherited.text_align
    st.text_transform = inherited.text_transform
    st.white_space = inherited.white_space
    st.visible = inherited.visible
    st.cursor = inherited.cursor
    st.vars = inherited.vars
    st.xp = props::xinherit(inherited.xp)
    st.letter_spacing = inherited.letter_spacing
    st.word_spacing = inherited.word_spacing
    st.text_indent = inherited.text_indent
    st.has_tshadow = inherited.has_tshadow
    st.ts_x = inherited.ts_x
    st.ts_y = inherited.ts_y
    st.ts_blur = inherited.ts_blur
    st.ts_color = inherited.ts_color
    st.list_style = inherited.list_style
    st.list_pos = inherited.list_pos
    st.font_family = inherited.font_family
    st.font_key = inherited.font_key
    st.font_weight = inherited.font_weight
    st.direction = inherited.direction
    st.hyphens = inherited.hyphens
    st.tab_size = inherited.tab_size
    st.border_spacing = inherited.border_spacing
    st.border_collapse = inherited.border_collapse
    st.pointer_events = inherited.pointer_events
    st.has_accent = inherited.has_accent
    st.accent = inherited.accent
    st.scroll_behavior = inherited.scroll_behavior
    st.break_words = inherited.break_words
    st.align = "stretch"
    return st
end

;; Style agenta użytkownika (domyślny wygląd tagów HTML).
fn apply_ua(tag: string, st0: ComputedStyle, parent: ComputedStyle) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    if tag == "span" || tag == "a" || tag == "text" || tag == "b" || tag == "strong" || tag == "i" || tag == "em" ||
       tag == "u" || tag == "small" || tag == "code" || tag == "label" || tag == "sub" || tag == "sup" ||
       tag == "abbr" || tag == "mark" || tag == "kbd" || tag == "s" || tag == "del" || tag == "img" || tag == "cite" is
        st.display = "inline"
    end
    if tag == "head" || tag == "script" || tag == "style" || tag == "title" || tag == "meta" || tag == "link" || tag == "option" ||
       tag == "template" || tag == "#comment" || tag == "noscript" is
        st.display = "none"
    end
    if tag == "li" is st.display = "list-item" end
    if tag == "table" is st.display = "table" end
    if tag == "thead" is st.display = "table-header-group" end
    if tag == "tbody" is st.display = "table-row-group" end
    if tag == "tfoot" is st.display = "table-footer-group" end
    if tag == "colgroup" || tag == "col" is st.display = "none" end
    if tag == "caption" is
        st.display = "block"
        st.text_align = "center"
    end
    if tag == "tr" is st.display = "table-row" end
    if tag == "td" || tag == "th" is
        st.display = "table-cell"
        st.valign = "top"
        st.pad_top = 4
        st.pad_bottom = 4
        st.pad_left = 8
        st.pad_right = 8
    end
    if tag == "h1" is st.font_size = 32 end
    if tag == "h2" is st.font_size = 24 end
    if tag == "h3" is st.font_size = 19 end
    if tag == "h4" is st.font_size = 16 end
    if tag == "h5" is st.font_size = 13 end
    if tag == "h6" is st.font_size = 11 end
    if tag == "h1" || tag == "h2" || tag == "h3" || tag == "h4" || tag == "h5" || tag == "h6" is
        st.bold = true
        st.mar_top = st.font_size / 2
        st.mar_bottom = st.font_size / 2
    end
    if tag == "b" || tag == "strong" || tag == "th" is st.bold = true end
    if tag == "th" is st.text_align = "center" end
    if tag == "i" || tag == "em" || tag == "cite" is st.italic = true end
    if tag == "u" || tag == "ins" is st.underline = true end
    if tag == "s" || tag == "del" is st.strike = true end
    if tag == "small" is st.font_size = parent.font_size * 85 / 100 end
    if tag == "sub" || tag == "sup" is st.font_size = parent.font_size * 80 / 100 end
    if tag == "a" is
        st.color = Color { r: 6, g: 69, b: 173, a: 255 }
        st.underline = true
        st.cursor = "pointer"
    end
    if tag == "mark" is
        st.background = Color { r: 255, g: 235, b: 59, a: 255 }
        st.has_bg = true
    end
    if tag == "code" || tag == "kbd" is
        st.background = Color { r: 235, g: 235, b: 235, a: 255 }
        st.has_bg = true
        st.rad_tl = 3
        st.rad_tr = 3
        st.rad_br = 3
        st.rad_bl = 3
    end
    if tag == "pre" is
        st.white_space = "pre"
        st.background = Color { r: 240, g: 240, b: 240, a: 255 }
        st.has_bg = true
        st.pad_top = 8
        st.pad_bottom = 8
        st.pad_left = 10
        st.pad_right = 10
        st.mar_top = 8
        st.mar_bottom = 8
    end
    if tag == "p" is
        st.mar_top = 0
        st.mar_bottom = 8
    end
    if tag == "ul" || tag == "ol" is
        st.pad_left = 24
        st.mar_top = 4
        st.mar_bottom = 8
    end
    if tag == "blockquote" is
        st.pad_left = 12
        st.bl = 3
        st.bct = Color { r: 200, g: 200, b: 200, a: 255 }
        st.bcl = Color { r: 200, g: 200, b: 200, a: 255 }
        st.mar_top = 8
        st.mar_bottom = 8
    end
    if tag == "hr" is
        st.height = 1
        st.height_mode = "px"
        st.has_bg = true
        st.background = Color { r: 204, g: 204, b: 204, a: 255 }
        st.mar_top = 8
        st.mar_bottom = 8
    end
    if tag == "button" is
        st.display = "inline-block"
        st.pad_top = 6
        st.pad_bottom = 6
        st.pad_left = 14
        st.pad_right = 14
        st.bt = 1
        st.br = 1
        st.bb = 1
        st.bl = 1
        st.border = 1
        let bc: Color = Color { r: 150, g: 150, b: 150, a: 255 }
        st.bct = bc
        st.bcr = bc
        st.bcb = bc
        st.bcl = bc
        st.border_color = bc
        st.rad_tl = 5
        st.rad_tr = 5
        st.rad_br = 5
        st.rad_bl = 5
        st.background = Color { r: 239, g: 239, b: 239, a: 255 }
        st.has_bg = true
        st.text_align = "center"
        st.cursor = "pointer"
        st.color = Color { r: 20, g: 20, b: 20, a: 255 }
    end
    if tag == "input" || tag == "textarea" || tag == "select" is
        st.display = "inline-block"
        st.pad_top = 6
        st.pad_bottom = 6
        st.pad_left = 8
        st.pad_right = 8
        st.bt = 1
        st.br = 1
        st.bb = 1
        st.bl = 1
        st.border = 1
        let bc: Color = Color { r: 150, g: 150, b: 150, a: 255 }
        st.bct = bc
        st.bcr = bc
        st.bcb = bc
        st.bcl = bc
        st.border_color = bc
        st.rad_tl = 4
        st.rad_tr = 4
        st.rad_br = 4
        st.rad_bl = 4
        st.background = Color { r: 255, g: 255, b: 255, a: 255 }
        st.has_bg = true
        st.cursor = if tag == "select" then "pointer" else "text"
        st.color = Color { r: 20, g: 20, b: 20, a: 255 }
    end
    if tag == "label" is st.cursor = "pointer" end
    if tag == "img" is st.display = "inline-block" end
    return st
end

pub fn default_style_for(tag: string, inherited: ComputedStyle) -> ComputedStyle is
    return apply_ua(tag, base_for(inherited), inherited)
end

;; ---------- zmienne CSS ----------
fn vars_get(vars: string, name: string) -> string is
    let key: string = "\u0002" + name + "\u0001"
    let idx: int = string_find(vars, key)
    if idx < 0 is return "" end
    let start: int = idx + string_len(key)
    let e: int = dom::find_from(vars, "\u0002", start)
    return string_slice(vars, start, if e < 0 then string_len(vars) else e)
end

fn vars_set(vars: string, name: string, val: string) -> string is
    let key: string = "\u0002" + name + "\u0001"
    let idx: int = string_find(vars, key)
    if idx < 0 is return vars + key + val end
    let start: int = idx + string_len(key)
    let e: int = dom::find_from(vars, "\u0002", start)
    let tail: string = if e < 0 then "" else string_slice(vars, e, string_len(vars))
    return string_slice(vars, 0, idx) + key + val + tail
end

;; Podstawia var(--x, fallback) (także zagnieżdżone, do 8 przebiegów).
pub fn substitute_vars(val: string, vars: string) -> string is
    let mut cur: string = val
    let mut pass: int = 0
    while string_find(cur, "var(") >= 0 && pass < 8 is
        pass += 1
        let start: int = string_find(cur, "var(")
        let mut depth: int = 0
        let mut e: int = start + 3
        let n: int = string_len(cur)
        while e < n is
            let c: string = string_at(cur, e)
            if c == "(" is depth += 1 end
            if c == ")" is
                depth -= 1
                if depth == 0 is break end
            end
            e += 1
        end
        let inner: string = string_slice(cur, start + 4, e)
        let comma: int = string_find(inner, ",")
        let name: string = string_trim(if comma < 0 then inner else string_slice(inner, 0, comma))
        let fallback: string = if comma < 0 then "" else string_trim(string_slice(inner, comma + 1, string_len(inner)))
        let found: string = vars_get(vars, name)
        cur = string_slice(cur, 0, start) + (if found != "" then found else fallback) + string_slice(cur, if e + 1 > n then n else e + 1, n)
    end
    return cur
end

;; ---------- parsowanie wartości ----------
fn to_color(c: cssval::Color) -> Color is
    return Color { r: c.r, g: c.g, b: c.b, a: c.a }
end

pub fn parse_color(val: string) -> Color is
    return to_color(cssval::parse_color(val))
end

fn env_for(em: int, ix: css::InteractionState) -> cssval::LenEnv is
    return cssval::LenEnv { em: em, rem: root_font_size(), vw: ix.viewport_w, vh: ix.viewport_h }
end

;; Długość w px; `auto` -> -1 (pct ignorowane — używać `set_size` dla rozmiarów).
fn len_px_or(val: string, env: cssval::LenEnv, basis: int, dflt: int) -> int is
    let l: cssval::Len = cssval::parse_len(val, env)
    if !l.ok || l.auto is return dflt end
    return cssval::px_of(l, basis)
end

fn box_px(val: string, env: cssval::LenEnv, basis: int) -> int is
    let l: cssval::Len = cssval::parse_len(val, env)
    if !l.ok || l.auto is return 0 end
    let v: int = cssval::px_of(l, basis)
    return v
end

fn margin_px(val: string, env: cssval::LenEnv, basis: int) -> int is
    let l: cssval::Len = cssval::parse_len(val, env)
    if !l.ok is return 0 end
    if l.auto is return auto_val() end
    return cssval::px_of(l, basis)
end

fn pos_px(val: string, env: cssval::LenEnv, basis: int) -> int is
    let l: cssval::Len = cssval::parse_len(val, env)
    if !l.ok || l.auto is return auto_val() end
    return cssval::px_of(l, basis)
end

fn parse_box_shorthand(val: string, env: cssval::LenEnv, basis: int) -> BoxSides is
    let toks: [string] = cssval::split_top(val)
    let n: int = array_len(toks)
    if n == 0 is return BoxSides { top: 0, right: 0, bottom: 0, left: 0 } end
    let t: int = box_px(toks[0], env, basis)
    let r: int = if n >= 2 then box_px(toks[1], env, basis) else t
    let b: int = if n >= 3 then box_px(toks[2], env, basis) else t
    let l: int = if n >= 4 then box_px(toks[3], env, basis) else r
    return BoxSides { top: t, right: r, bottom: b, left: l }
end

fn parse_margin_shorthand(val: string, env: cssval::LenEnv, basis: int) -> BoxSides is
    let toks: [string] = cssval::split_top(val)
    let n: int = array_len(toks)
    if n == 0 is return BoxSides { top: 0, right: 0, bottom: 0, left: 0 } end
    let t: int = margin_px(toks[0], env, basis)
    let r: int = if n >= 2 then margin_px(toks[1], env, basis) else t
    let b: int = if n >= 3 then margin_px(toks[2], env, basis) else t
    let l: int = if n >= 4 then margin_px(toks[3], env, basis) else r
    return BoxSides { top: t, right: r, bottom: b, left: l }
end

pub fn parse_opacity(val: string) -> int is
    let v: string = string_trim(val)
    if string_ends_with(v, "%") is
        let n: int = str_to_int(string_trim(string_slice(v, 0, string_len(v) - 1)))
        if n < 0 is return 0 end
        if n > 100 is return 100 end
        return n
    end
    let f: f64 = conv::str_to_float(v)
    let pct: int = conv::float_to_int(f * 100.0 + 0.5)
    if pct < 0 is return 0 end
    if pct > 100 is return 100 end
    return pct
end

fn parse_milli(val: string) -> int is
    let f: f64 = conv::str_to_float(string_trim(val))
    return conv::float_to_int(f * 1000.0 + (if f < 0.0 then -0.5 else 0.5))
end

;; Rozmiar (width/height itp.): zwraca [px, pct, mode] zakodowane w BoxSides-podobnej parze.
struct SizeRes is
    pub px:   int
    pub pct:  int
    pub mode: string
end

fn parse_size(val: string, env: cssval::LenEnv) -> SizeRes is
    let l: cssval::Len = cssval::parse_len(val, env)
    let v: string = string_lower(string_trim(val))
    if !l.ok || l.auto || v == "none" || v == "max-content" || v == "fit-content" is
        return SizeRes { px: -1, pct: 0, mode: "auto" }
    end
    if l.pct != 0 is return SizeRes { px: l.px, pct: l.pct, mode: "pct" } end
    return SizeRes { px: l.px, pct: 0, mode: "px" }
end

fn strip_quotes(v: string) -> string is
    let t: string = string_trim(v)
    if string_len(t) >= 2 && (string_starts_with(t, "\"") && string_ends_with(t, "\"") || string_starts_with(t, "'") && string_ends_with(t, "'")) is
        return string_slice(t, 1, string_len(t) - 1)
    end
    return t
end

fn is_line_style(t: string) -> bool is
    return t == "solid" || t == "dashed" || t == "dotted" || t == "double" || t == "groove" || t == "ridge" || t == "inset" || t == "outset"
end

;; border / border-top… : [width] [style] [color] w dowolnej kolejności
struct BorderRes is
    pub w:     int
    pub color: Color
    pub has_color: bool
    pub bstyle: string
end

fn parse_border_value(val: string, env: cssval::LenEnv, cur_color: Color) -> BorderRes is
    let toks: [string] = cssval::split_top(val)
    let mut w: int = 3
    let mut none: bool = false
    let mut color: Color = cur_color
    let mut has_c: bool = false
    let mut bstyle: string = ""
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = string_lower(toks[i])
        i += 1
        if t == "none" || t == "hidden" is
            none = true
            bstyle = t
        elsif is_line_style(t) is
            bstyle = t
        elsif t == "thin" is
            w = 1
        elsif t == "medium" is
            w = 3
        elsif t == "thick" is
            w = 5
        elsif cssval::is_color(t) is
            color = parse_color(t)
            has_c = true
        else is
            let l: cssval::Len = cssval::parse_len(t, env)
            if l.ok && !l.auto is w = cssval::px_of(l, 0) end
        end
    end
    return BorderRes { w: if none then 0 else w, color: color, has_color: has_c, bstyle: bstyle }
end

fn parse_radius_all(val: string, env: cssval::LenEnv, w_hint: int) -> BoxSides is
    let main: [string] = string_split(val, "/")
    let toks: [string] = cssval::split_top(main[0])
    let n: int = array_len(toks)
    if n == 0 is return BoxSides { top: 0, right: 0, bottom: 0, left: 0 } end
    let tl: int = box_px(toks[0], env, w_hint)
    let tr: int = if n >= 2 then box_px(toks[1], env, w_hint) else tl
    let br: int = if n >= 3 then box_px(toks[2], env, w_hint) else tl
    let bl: int = if n >= 4 then box_px(toks[3], env, w_hint) else tr
    return BoxSides { top: tl, right: tr, bottom: br, left: bl }
end

fn parse_font_weight(val: string) -> bool is
    let v: string = string_lower(string_trim(val))
    if v == "bold" || v == "bolder" is return true end
    if v == "normal" || v == "lighter" is return false end
    return str_to_int(v) >= 600
end

fn parse_line_height(val: string, font_size: int, env: cssval::LenEnv) -> int is
    let v: string = string_lower(string_trim(val))
    if v == "normal" || v == "" is return 0 end
    let is_plain: bool = string_find(v, "px") < 0 && string_find(v, "em") < 0 && string_find(v, "%") < 0 &&
                         string_find(v, "pt") < 0 && string_find(v, "calc") < 0
    if is_plain is
        let f: f64 = conv::str_to_float(v)
        return conv::float_to_int(f * cssval::i2f(font_size) + 0.5)
    end
    if string_ends_with(v, "%") is
        let f: f64 = conv::str_to_float(string_slice(v, 0, string_len(v) - 1))
        return conv::float_to_int(f * cssval::i2f(font_size) / 100.0 + 0.5)
    end
    return len_px_or(v, env, font_size, 0)
end

;; box-shadow (pierwszy cień, bez inset): offset-x offset-y [blur [spread]] [color]
fn apply_shadow(st0: ComputedStyle, val: string, env: cssval::LenEnv) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let first: [string] = cssval::split_commas(val)
    if array_len(first) == 0 || string_lower(string_trim(first[0])) == "none" is
        st.has_shadow = false
        return st
    end
    let toks: [string] = cssval::split_top(first[0])
    let mut nums: [int] = []
    let mut col: Color = Color { r: 0, g: 0, b: 0, a: 64 }
    let mut inset: bool = false
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if string_lower(t) == "inset" is
            inset = true
        elsif cssval::is_color(t) is
            col = parse_color(t)
        else is
            nums = array_push(nums, len_px_or(t, env, 0, 0))
        end
    end
    if inset || array_len(nums) < 2 is
        st.has_shadow = false
        return st
    end
    st.has_shadow = true
    st.sh_x = nums[0]
    st.sh_y = nums[1]
    st.sh_blur = if array_len(nums) >= 3 then nums[2] else 0
    st.sh_spread = if array_len(nums) >= 4 then nums[3] else 0
    st.sh_color = col
    return st
end

;; background / background-image: obsługa color, url(...), linear-gradient(...)
fn parse_gradient(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let open: int = string_find(val, "(")
    let close: int = string_len(val) - 1
    let parts: [string] = cssval::split_commas(string_slice(val, open + 1, close))
    if array_len(parts) < 2 is return st end
    let mut vertical: bool = true
    let mut first_idx: int = 0
    let head: string = string_lower(string_trim(parts[0]))
    if string_starts_with(head, "to ") is
        vertical = string_find(head, "bottom") >= 0 || string_find(head, "top") >= 0
        first_idx = 1
    elsif string_ends_with(head, "deg") is
        let deg: int = str_to_int(string_slice(head, 0, string_len(head) - 3))
        let d: int = ((deg % 360) + 360) % 360
        vertical = d < 45 || (d >= 135 && d < 225) || d >= 315
        first_idx = 1
    end
    let flipped: bool = string_find(head, "to top") >= 0 || string_find(head, "to left") >= 0
    let c1_tok: string = cssval::split_top(parts[first_idx])[0]
    let c2_tok: string = cssval::split_top(parts[array_len(parts) - 1])[0]
    let mut a: Color = parse_color(c1_tok)
    let mut b: Color = parse_color(c2_tok)
    if flipped is
        let tmp: Color = a
        a = b
        b = tmp
    end
    st.has_grad = true
    st.grad_from = a
    st.grad_to = b
    st.grad_vertical = vertical
    return st
end

fn apply_background(st0: ComputedStyle, val: string, em: int, env: cssval::LenEnv) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let v: string = string_trim(val)
    if string_find(v, "linear-gradient") >= 0 is
        let s: int = string_find(v, "linear-gradient")
        st = parse_gradient(st, string_slice(v, s, string_len(v)))
        return st
    end
    let toks: [string] = cssval::split_top(v)
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if string_starts_with(string_lower(t), "url(") is
            st.bg_image = strip_quotes(string_slice(t, 4, string_len(t) - 1))
        elsif string_lower(t) == "none" is
            st.bg_image = ""
        elsif cssval::is_color(t) is
            st.background = parse_color(t)
            st.has_bg = st.background.a > 0
        end
    end
    return st
end

;; flex: none | auto | <grow> [<shrink>] [<basis>]
fn apply_flex_shorthand(st0: ComputedStyle, val: string, env: cssval::LenEnv) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let v: string = string_lower(string_trim(val))
    if v == "none" is
        st.flex_grow = 0
        st.flex_shrink = 0
        st.flex_basis = -1
        return st
    end
    if v == "auto" is
        st.flex_grow = 1000
        st.flex_shrink = 1000
        st.flex_basis = -1
        return st
    end
    let toks: [string] = cssval::split_top(v)
    let n: int = array_len(toks)
    if n == 0 is return st end
    let is_num0: bool = string_find(toks[0], "px") < 0 && string_find(toks[0], "%") < 0 && string_find(toks[0], "em") < 0
    if is_num0 is
        st.flex_grow = parse_milli(toks[0])
        st.flex_shrink = 1000
        st.flex_basis = 0
        if n >= 2 is
            let t1: string = toks[1]
            let is_num1: bool = string_find(t1, "px") < 0 && string_find(t1, "%") < 0 && string_find(t1, "em") < 0 && t1 != "auto"
            if is_num1 is
                st.flex_shrink = parse_milli(t1)
            else is
                st.flex_basis = len_px_or(t1, env, 0, -1)
            end
        end
        if n >= 3 is st.flex_basis = len_px_or(toks[2], env, 0, -1) end
    else is
        st.flex_grow = 1000
        st.flex_basis = len_px_or(toks[0], env, 0, -1)
    end
    return st
end

fn apply_flex_flow(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let toks: [string] = cssval::split_top(string_lower(val))
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if t == "row" || t == "column" || t == "row-reverse" || t == "column-reverse" is st.flex_dir = t end
        if t == "wrap" || t == "wrap-reverse" is st.flex_wrap = true end
        if t == "nowrap" is st.flex_wrap = false end
    end
    return st
end

fn apply_text_decoration(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let v: string = string_lower(val)
    st.underline = string_find(v, "underline") >= 0
    st.strike = string_find(v, "line-through") >= 0
    return st
end

fn apply_overflow(st0: ComputedStyle, val: string, axis: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let toks: [string] = cssval::split_top(string_lower(val))
    if array_len(toks) == 0 is return st end
    let x: string = toks[0]
    let y: string = if array_len(toks) >= 2 then toks[1] else toks[0]
    if axis == "both" is
        st.overflow_x = x
        st.overflow_y = y
    elsif axis == "x" is
        st.overflow_x = x
    else is
        st.overflow_y = x
    end
    return st
end

fn first_duration_ms(val: string) -> int is
    let toks: [string] = cssval::split_top(string_lower(val))
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if string_ends_with(t, "ms") is
            return str_to_int(string_slice(t, 0, string_len(t) - 2))
        end
        if string_ends_with(t, "s") && !string_ends_with(t, "ms") && string_len(t) > 1 is
            let c: string = string_slice(t, 0, 1)
            if (c >= "0" && c <= "9") || c == "." is
                return conv::float_to_int(conv::str_to_float(string_slice(t, 0, string_len(t) - 1)) * 1000.0)
            end
        end
    end
    return 0
end

pub fn is_trivial_value(v: string) -> bool is
    let l: string = string_lower(string_trim(v))
    return l == "initial" || l == "unset" || l == "inherit"
end

fn set_all_borders(st0: ComputedStyle, w: int, c: Color, set_color: bool) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    st.bt = w
    st.br = w
    st.bb = w
    st.bl = w
    st.border = w
    if set_color is
        st.bct = c
        st.bcr = c
        st.bcb = c
        st.bcl = c
        st.border_color = c
    end
    return st
end

;; =====================================================================
;; 0.3: dodatkowe właściwości CSS
;; =====================================================================
fn num_f(s: string) -> f64 is
    return conv::str_to_float(string_trim(s))
end

fn milli_of(f: f64) -> int is
    return conv::float_to_int(f * 1000.0 + (if f < 0.0 then -0.5 else 0.5))
end

;; Wartość procentowa bez przycinania: "150%" -> 150, "1.5" -> 150.
fn pct_unclamped(val: string) -> int is
    let v: string = string_trim(val)
    if v == "" is return 100 end
    if string_ends_with(v, "%") is
        return conv::float_to_int(num_f(string_slice(v, 0, string_len(v) - 1)))
    end
    return conv::float_to_int(num_f(v) * 100.0 + 0.5)
end

;; Kąt -> dziesiąte części stopnia (deg/turn/rad/grad).
fn clamp_pct(n: int) -> int is
    if n < 0 is return 0 end
    if n > 100 is return 100 end
    return n
end

fn angle_deci(val: string) -> int is
    let v: string = string_lower(string_trim(val))
    if string_ends_with(v, "deg") is return milli_of(num_f(string_slice(v, 0, string_len(v) - 3))) / 100 end
    if string_ends_with(v, "grad") is return milli_of(num_f(string_slice(v, 0, string_len(v) - 4)) * 0.9) / 100 end
    if string_ends_with(v, "turn") is return milli_of(num_f(string_slice(v, 0, string_len(v) - 4)) * 360.0) / 100 end
    if string_ends_with(v, "rad") is return milli_of(num_f(string_slice(v, 0, string_len(v) - 3)) * 57.29578) / 100 end
    return milli_of(num_f(v)) / 100
end

;; Wnętrze pierwszego wywołania funkcji `name(...)` w wartości; "" gdy brak.
fn fn_args(val: string, name: string, from: int) -> string is
    let lower: string = string_lower(val)
    let pat: string = name + "("
    let at: int = string_find(string_slice(lower, from, string_len(lower)), pat)
    if at < 0 is return "" end
    let open: int = from + at + string_len(pat)
    let mut depth: int = 1
    let mut q: int = open
    while q < string_len(val) && depth > 0 is
        let c: string = string_at(val, q)
        if c == "(" is depth += 1 end
        if c == ")" is depth -= 1 end
        q += 1
    end
    return string_slice(val, open, q - 1)
end

fn has_fn(val: string, name: string) -> bool is
    return string_find(string_lower(val), name + "(") >= 0
end

;; Długość lub procent: zwraca px (pct == false) albo procent x100 (pct == true).
struct PxPct is
    pub px:  int
    pub pct: int
end

fn parse_px_pct(tok: string, env: cssval::LenEnv) -> PxPct is
    let t: string = string_trim(tok)
    if string_ends_with(t, "%") is
        return PxPct { px: 0, pct: conv::float_to_int(num_f(string_slice(t, 0, string_len(t) - 1)) * 100.0) }
    end
    return PxPct { px: len_px_or(t, env, 0, 0), pct: 0 }
end

fn apply_transform_fns(st0: ComputedStyle, val: string, env: cssval::LenEnv) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let l: string = string_lower(string_trim(val))
    st.has_transform = false
    st.tr_tx = 0
    st.tr_ty = 0
    st.tr_tx_pct = 0
    st.tr_ty_pct = 0
    st.tr_sx = 1000
    st.tr_sy = 1000
    st.tr_rot = 0
    if l == "none" || l == "" is return st end
    let mut got: bool = false
    if has_fn(l, "translate") is
        let a: [string] = string_split(fn_args(l, "translate", 0), ",")
        let x: PxPct = parse_px_pct(a[0], env)
        st.tr_tx = x.px
        st.tr_tx_pct = x.pct
        if array_len(a) >= 2 is
            let y: PxPct = parse_px_pct(a[1], env)
            st.tr_ty = y.px
            st.tr_ty_pct = y.pct
        end
        got = true
    end
    if has_fn(l, "translatex") is
        let x: PxPct = parse_px_pct(fn_args(l, "translatex", 0), env)
        st.tr_tx = x.px
        st.tr_tx_pct = x.pct
        got = true
    end
    if has_fn(l, "translatey") is
        let y: PxPct = parse_px_pct(fn_args(l, "translatey", 0), env)
        st.tr_ty = y.px
        st.tr_ty_pct = y.pct
        got = true
    end
    if has_fn(l, "scale") is
        let a: [string] = string_split(fn_args(l, "scale", 0), ",")
        st.tr_sx = milli_of(num_f(a[0]))
        st.tr_sy = if array_len(a) >= 2 then milli_of(num_f(a[1])) else st.tr_sx
        got = true
    end
    if has_fn(l, "scalex") is
        st.tr_sx = milli_of(num_f(fn_args(l, "scalex", 0)))
        got = true
    end
    if has_fn(l, "scaley") is
        st.tr_sy = milli_of(num_f(fn_args(l, "scaley", 0)))
        got = true
    end
    if has_fn(l, "rotate") is
        st.tr_rot = angle_deci(fn_args(l, "rotate", 0))
        got = true
    end
    st.has_transform = got
    return st
end


;; ---------- macierze transformacji 2D (liczby całkowite: współczynniki x1000) ----------
fn sin_tab() -> [int] is
    return [0, 17, 35, 52, 70, 87, 105, 122, 139, 156, 174, 191, 208, 225, 242, 259, 276, 292, 309, 326, 342, 358, 375, 391, 407, 423, 438, 454, 469, 485, 500, 515, 530, 545, 559, 574, 588, 602, 616, 629, 643, 656, 669, 682, 695, 707, 719, 731, 743, 755, 766, 777, 788, 799, 809, 819, 829, 839, 848, 857, 866, 875, 883, 891, 899, 906, 914, 921, 927, 934, 940, 946, 951, 956, 961, 966, 970, 974, 978, 982, 985, 988, 990, 993, 995, 996, 998, 999, 999, 1000, 1000]
end

;; sin/cos w tysięcznych dla kąta w dziesiątych częściach stopnia.
fn sin_m(deci0: int) -> int is
    let mut d: int = deci0 % 3600
    if d < 0 is d += 3600 end
    let mut sign: int = 1
    if d >= 1800 is
        sign = -1
        d = d - 1800
    end
    if d > 900 is d = 1800 - d end
    let t: [int] = sin_tab()
    let whole: int = d / 10
    let frac: int = d % 10
    let lo: int = t[whole]
    let hi: int = if whole >= 90 then t[90] else t[whole + 1]
    return sign * (lo + (hi - lo) * frac / 10)
end

fn cos_m(deci: int) -> int is
    return sin_m(deci + 900)
end

fn tan_m(deci: int) -> int is
    let c: int = cos_m(deci)
    let s: int = sin_m(deci)
    if c > -20 && c < 20 is return (if s >= 0 then 50000 else -50000) end
    return s * 1000 / c
end

fn mat_id() -> [int] is
    return [1000, 0, 0, 1000, 0, 0]
end

;; m1 * m2 (m2 działa pierwszy na punkcie), e/f w tysięcznych px
fn mat_mul(m1: [int], m2: [int]) -> [int] is
    let a: int = (m1[0] * m2[0] + m1[2] * m2[1]) / 1000
    let b: int = (m1[1] * m2[0] + m1[3] * m2[1]) / 1000
    let c: int = (m1[0] * m2[2] + m1[2] * m2[3]) / 1000
    let d: int = (m1[1] * m2[2] + m1[3] * m2[3]) / 1000
    let e: int = (m1[0] * m2[4] + m1[2] * m2[5]) / 1000 + m1[4]
    let f: int = (m1[1] * m2[4] + m1[3] * m2[5]) / 1000 + m1[5]
    return [a, b, c, d, e, f]
end

fn mat_rotate(deci: int) -> [int] is
    let c: int = cos_m(deci)
    let s: int = sin_m(deci)
    return [c, s, 0 - s, c, 0, 0]
end

fn mat_str(m: [int]) -> string is
    return to_string(m[0]) + " " + to_string(m[1]) + " " + to_string(m[2]) + " " + to_string(m[3]) + " " + to_string(m[4]) + " " + to_string(m[5])
end

fn mat_parse(v: string) -> [int] is
    if v == "" is return [] end
    let t: [string] = string_split(v, " ")
    if array_len(t) < 6 is return [] end
    return [str_to_int(t[0]), str_to_int(t[1]), str_to_int(t[2]), str_to_int(t[3]), str_to_int(t[4]), str_to_int(t[5])]
end

fn px_milli(tok: string, env: cssval::LenEnv) -> int is
    let l: cssval::Len = cssval::parse_len(tok, env)
    if !l.ok is return 0 end
    return l.px * 1000
end

;; Lista funkcji transform → złożona macierz (kolejność jak w CSS: pierwsza funkcja jest zewnętrzna).
fn parse_transform_matrix(val: string, env: cssval::LenEnv) -> [int] is
    let l: string = string_lower(string_trim(val))
    if l == "none" || l == "" is return [] end
    let toks: [string] = cssval::split_top(l)
    let mut m: [int] = mat_id()
    let mut got: bool = false
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        let op: int = string_find(t, "(")
        if op <= 0 is continue end
        let name: string = string_slice(t, 0, op)
        let inner: string = string_slice(t, op + 1, if string_ends_with(t, ")") then string_len(t) - 1 else string_len(t))
        let a: [string] = cssval::split_commas(inner)
        let a0: string = if array_len(a) >= 1 then string_trim(a[0]) else "0"
        let a1: string = if array_len(a) >= 2 then string_trim(a[1]) else ""
        let mut f: [int] = []
        if name == "translate" || name == "translate3d" is
            f = [1000, 0, 0, 1000, px_milli(a0, env), if a1 == "" then 0 else px_milli(a1, env)]
        elsif name == "translatex" is
            f = [1000, 0, 0, 1000, px_milli(a0, env), 0]
        elsif name == "translatey" is
            f = [1000, 0, 0, 1000, 0, px_milli(a0, env)]
        elsif name == "scale" || name == "scale3d" is
            let sx: int = milli_of(num_f(a0))
            f = [sx, 0, 0, if a1 == "" then sx else milli_of(num_f(a1)), 0, 0]
        elsif name == "scalex" is
            f = [milli_of(num_f(a0)), 0, 0, 1000, 0, 0]
        elsif name == "scaley" is
            f = [1000, 0, 0, milli_of(num_f(a0)), 0, 0]
        elsif name == "rotate" || name == "rotatez" is
            f = mat_rotate(angle_deci(a0))
        elsif name == "rotate3d" is
            f = mat_rotate(angle_deci(if array_len(a) >= 4 then string_trim(a[3]) else "0"))
        elsif name == "skew" is
            f = [1000, if a1 == "" then 0 else tan_m(angle_deci(a1)), tan_m(angle_deci(a0)), 1000, 0, 0]
        elsif name == "skewx" is
            f = [1000, 0, tan_m(angle_deci(a0)), 1000, 0, 0]
        elsif name == "skewy" is
            f = [1000, tan_m(angle_deci(a0)), 0, 1000, 0, 0]
        elsif name == "matrix" && array_len(a) >= 6 is
            f = [milli_of(num_f(a[0])), milli_of(num_f(a[1])), milli_of(num_f(a[2])), milli_of(num_f(a[3])), px_milli(a[4], env), px_milli(a[5], env)]
        end
        if array_len(f) == 6 is
            m = mat_mul(m, f)
            got = true
        end
    end
    if !got is return [] end
    return m
end

;; Po wszystkich deklaracjach: translate · rotate · scale · transform. Obrót/pochylenie → st.tr_m.
fn finalize_transform(st0: ComputedStyle) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let mt: [int] = mat_parse(props::xget(st.xp, "x-m-transform"))
    let mtr: [int] = mat_parse(props::xget(st.xp, "x-m-translate"))
    let mr: [int] = mat_parse(props::xget(st.xp, "x-m-rotate"))
    let ms: [int] = mat_parse(props::xget(st.xp, "x-m-scale"))
    st.tr_m = []
    if array_len(mt) == 0 && array_len(mtr) == 0 && array_len(mr) == 0 && array_len(ms) == 0 is return st end
    let mut m: [int] = mat_id()
    if array_len(mtr) == 6 is m = mat_mul(m, mtr) end
    if array_len(mr) == 6 is m = mat_mul(m, mr) end
    if array_len(ms) == 6 is m = mat_mul(m, ms) end
    if array_len(mt) == 6 is m = mat_mul(m, mt) end
    if m[1] != 0 || m[2] != 0 is
        st.tr_m = m          ;; pola tr_* zostają (zgodność); układ/rysowanie używają tr_m, gdy niepuste
        st.has_transform = true
        return st
    end
    ;; osobne właściwości rotate/scale/translate (bez obrotu): wynik złożony w polach skali/przesunięcia
    if array_len(mtr) == 6 || array_len(mr) == 6 || array_len(ms) == 6 is
        st.has_transform = true
        st.tr_sx = m[0]
        st.tr_sy = m[3]
        st.tr_tx = m[4] / 1000
        st.tr_ty = m[5] / 1000
        st.tr_tx_pct = 0
        st.tr_ty_pct = 0
    end
    return st
end

fn origin_tok(t: string) -> int is
    let l: string = string_lower(string_trim(t))
    if l == "left" || l == "top" is return 0 end
    if l == "right" || l == "bottom" is return 10000 end
    if l == "center" is return 5000 end
    if string_ends_with(l, "%") is return conv::float_to_int(num_f(string_slice(l, 0, string_len(l) - 1)) * 100.0) end
    return 5000
end

fn apply_filter_fns(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let l: string = string_lower(string_trim(val))
    st.has_filter = false
    st.f_gray = 0
    st.f_bright = 100
    st.f_contrast = 100
    st.f_invert = 0
    st.f_sepia = 0
    st.f_opacity = 100
    if l == "none" || l == "" is return st end
    if has_fn(l, "grayscale") is
        st.f_gray = clamp_pct(pct_unclamped(fn_args(l, "grayscale", 0)))
        st.has_filter = true
    end
    if has_fn(l, "brightness") is
        st.f_bright = pct_unclamped(fn_args(l, "brightness", 0))
        st.has_filter = true
    end
    if has_fn(l, "contrast") is
        st.f_contrast = pct_unclamped(fn_args(l, "contrast", 0))
        st.has_filter = true
    end
    if has_fn(l, "invert") is
        st.f_invert = clamp_pct(pct_unclamped(fn_args(l, "invert", 0)))
        st.has_filter = true
    end
    if has_fn(l, "sepia") is
        st.f_sepia = clamp_pct(pct_unclamped(fn_args(l, "sepia", 0)))
        st.has_filter = true
    end
    if has_fn(l, "opacity") is
        st.f_opacity = clamp_pct(pct_unclamped(fn_args(l, "opacity", 0)))
        st.has_filter = true
    end
    return st
end

fn is_time_tok(t: string) -> bool is
    if string_ends_with(t, "ms") && string_len(t) > 2 is return true end
    if string_ends_with(t, "s") && string_len(t) > 1 is
        let c: string = string_slice(t, 0, 1)
        return (c >= "0" && c <= "9") || c == "." || c == "-"
    end
    return false
end

fn time_ms(t: string) -> int is
    if string_ends_with(t, "ms") is return conv::float_to_int(num_f(string_slice(t, 0, string_len(t) - 2))) end
    return conv::float_to_int(num_f(string_slice(t, 0, string_len(t) - 1)) * 1000.0)
end

fn is_timing_tok(t: string) -> bool is
    return t == "ease" || t == "linear" || t == "ease-in" || t == "ease-out" || t == "ease-in-out" ||
           t == "step-start" || t == "step-end" || string_starts_with(t, "cubic-bezier(") || string_starts_with(t, "steps(")
end

fn apply_animation(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let layers: [string] = cssval::split_commas(val)
    if array_len(layers) == 0 || string_lower(string_trim(layers[0])) == "none" is
        st.anim_name = ""
        st.anim_ms = 0
        return st
    end
    let toks: [string] = cssval::split_top(string_lower(layers[0]))
    let mut times: int = 0
    st.anim_name = ""
    st.anim_ms = 0
    st.anim_delay = 0
    st.anim_iter = 1000
    st.anim_dir = "normal"
    st.anim_fill = "none"
    st.anim_ease = "ease"
    st.anim_paused = false
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if is_time_tok(t) is
            if times == 0 is st.anim_ms = time_ms(t) else is st.anim_delay = time_ms(t) end
            times += 1
        elsif is_timing_tok(t) is
            st.anim_ease = t
        elsif t == "infinite" is
            st.anim_iter = -1
        elsif t == "normal" || t == "reverse" || t == "alternate" || t == "alternate-reverse" is
            st.anim_dir = t
        elsif t == "none" && st.anim_name != "" is
            st.anim_fill = "none"
        elsif t == "forwards" || t == "backwards" || t == "both" is
            st.anim_fill = t
        elsif t == "paused" is
            st.anim_paused = true
        elsif t == "running" is
            st.anim_paused = false
        else is
            let c: string = string_slice(t, 0, 1)
            if (c >= "0" && c <= "9") || c == "." is
                st.anim_iter = milli_of(num_f(t))
            else is
                st.anim_name = t
            end
        end
    end
    return st
end

fn apply_transition(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let layers: [string] = cssval::split_commas(val)
    if array_len(layers) == 0 || string_lower(string_trim(layers[0])) == "none" is
        st.trans_ms = 0
        st.trans_prop = "all"
        return st
    end
    let mut props: string = ""
    let mut li: int = 0
    while li < array_len(layers) is
        let toks: [string] = cssval::split_top(string_lower(layers[li]))
        let mut times: int = 0
        let mut name: string = "all"
        let mut ti: int = 0
        while ti < array_len(toks) is
            let t: string = toks[ti]
            ti += 1
            if is_time_tok(t) is
                if li == 0 is
                    if times == 0 is st.trans_ms = time_ms(t) else is st.trans_delay = time_ms(t) end
                end
                times += 1
            elsif is_timing_tok(t) is
                if li == 0 is st.trans_ease = t end
            else is
                name = t
            end
        end
        props = if li == 0 then name else props + "," + name
        li += 1
    end
    st.trans_prop = props
    return st
end

;; grid-template-areas: "a b" "c d"  ->  "a b\u0001c d"
fn parse_areas(val: string) -> string is
    let mut out: string = ""
    let mut p: int = 0
    let n: int = string_len(val)
    while p < n is
        let q: int = string_find(string_slice(val, p, n), "\"")
        if q < 0 is break end
        let start: int = p + q + 1
        let e: int = string_find(string_slice(val, start, n), "\"")
        if e < 0 is break end
        let row: string = string_trim(string_slice(val, start, start + e))
        out = if out == "" then row else out + "\u0001" + row
        p = start + e + 1
    end
    return out
end

;; "2", "span 3", "2 / span 3", "2 / 4" -> [start, span]
fn parse_line_span(val: string) -> [int] is
    let l: string = string_lower(string_trim(val))
    let parts: [string] = string_split(l, "/")
    let a: string = string_trim(parts[0])
    let mut start: int = 0
    let mut span: int = 1
    if string_starts_with(a, "span") is
        span = str_to_int(string_trim(string_slice(a, 4, string_len(a))))
    elsif a != "auto" && a != "" is
        start = str_to_int(a)
    end
    if array_len(parts) >= 2 is
        let b: string = string_trim(parts[1])
        if string_starts_with(b, "span") is
            span = str_to_int(string_trim(string_slice(b, 4, string_len(b))))
        elsif b != "auto" && b != "" && start > 0 is
            let e: int = str_to_int(b)
            if e > start is span = e - start end
        end
    end
    if span < 1 is span = 1 end
    return [start, span]
end

fn parse_aspect(val: string) -> int is
    let l: string = string_lower(string_trim(val))
    if l == "auto" || l == "" is return 0 end
    let parts: [string] = string_split(l, "/")
    let a: f64 = num_f(parts[0])
    let b: f64 = if array_len(parts) >= 2 then num_f(parts[1]) else 1.0
    if a <= 0.0 || b <= 0.0 is return 0 end
    return milli_of(a / b)
end

fn list_style_type(t: string) -> bool is
    return t == "none" || t == "disc" || t == "circle" || t == "square" || t == "decimal" || t == "decimal-leading-zero" ||
           t == "lower-alpha" || t == "upper-alpha" || t == "lower-latin" || t == "upper-latin" || t == "lower-roman" ||
           t == "upper-roman" || t == "lower-greek"
end

fn apply_list_style(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let toks: [string] = cssval::split_top(string_lower(val))
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if list_style_type(t) is st.list_style = t end
        if t == "inside" || t == "outside" is st.list_pos = t end
    end
    return st
end

fn apply_text_shadow(st0: ComputedStyle, val: string, env: cssval::LenEnv) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let layers: [string] = cssval::split_commas(val)
    if array_len(layers) == 0 || string_lower(string_trim(layers[0])) == "none" is
        st.has_tshadow = false
        return st
    end
    let toks: [string] = cssval::split_top(layers[0])
    let mut nums: [int] = []
    let mut col: Color = st.color
    let mut have_col: bool = false
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if cssval::is_color(t) is
            col = parse_color(t)
            have_col = true
        else is
            nums = array_push(nums, len_px_or(t, env, 0, 0))
        end
    end
    if array_len(nums) < 2 is
        st.has_tshadow = false
        return st
    end
    st.has_tshadow = true
    st.ts_x = nums[0]
    st.ts_y = nums[1]
    st.ts_blur = if array_len(nums) >= 3 then nums[2] else 0
    st.ts_color = col
    return st
end

fn apply_vertical_align(st0: ComputedStyle, lower: string, env: cssval::LenEnv) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    st.valign_px = 0
    if lower == "baseline" || lower == "top" || lower == "middle" || lower == "bottom" || lower == "sub" ||
       lower == "super" || lower == "text-top" || lower == "text-bottom" is
        st.valign = lower
    else is
        st.valign = "baseline"
        st.valign_px = len_px_or(lower, env, st.font_size, 0)
    end
    return st
end

fn font_weight_num(lower: string, cur: int) -> int is
    if lower == "normal" is return 400 end
    if lower == "bold" || lower == "bolder" is return 700 end
    if lower == "lighter" is return 300 end
    let n: int = str_to_int(lower)
    if n >= 1 && n <= 1000 is return n end
    return cur
end

fn apply_deco_extras(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let toks: [string] = cssval::split_top(string_lower(val))
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if t == "solid" || t == "double" || t == "dotted" || t == "dashed" || t == "wavy" is
            st.deco_style = t
        elsif cssval::is_color(t) is
            st.deco_color = parse_color(t)
            st.has_deco_color = true
        end
    end
    return st
end

fn apply_bg_extras(st0: ComputedStyle, val: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
    let toks: [string] = cssval::split_top(string_lower(val))
    let mut pos: string = ""
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        if t == "/" is break end
        if t == "repeat" || t == "no-repeat" || t == "repeat-x" || t == "repeat-y" || t == "space" || t == "round" is
            st.bg_repeat = t
        elsif t == "left" || t == "right" || t == "top" || t == "bottom" || t == "center" || (string_ends_with(t, "%") && !cssval::is_color(t)) is
            pos = if pos == "" then t else pos + " " + t
        end
    end
    if pos != "" is st.bg_pos = pos end
    return st
end

fn side_style_of(t: string) -> bool is
    return t == "none" || t == "hidden" || t == "solid" || t == "dashed" || t == "dotted" || t == "double" ||
           t == "groove" || t == "ridge" || t == "inset" || t == "outset"
end

fn grid_align_kw(lower: string) -> string is
    if lower == "start" || lower == "self-start" is return "flex-start" end
    if lower == "end" || lower == "self-end" is return "flex-end" end
    if lower == "normal" is return "stretch" end
    return lower
end

;; Rozwija właściwości logiczne do fizycznych (zakładamy LTR, tryb poziomy).
fn emit_decl(out: [css::CssDecl], prop: string, val: string, imp: bool) -> [css::CssDecl] is
    return array_push(out, css::CssDecl { prop: prop, val: val, important: imp })
end

;; Czy układ jest od prawej do lewej (ostatnia deklaracja `direction` w bloku albo dziedziczone).
fn dir_is_rtl(decls: [css::CssDecl], parent_dir: string) -> bool is
    let mut dir: string = parent_dir
    let mut i: int = 0
    while i < array_len(decls) is
        if decls[i].prop == "direction" is dir = string_lower(string_trim(decls[i].val)) end
        i += 1
    end
    return dir == "rtl"
end

;; Rodziny z sufiksami fizycznymi `<rodzina>-top|right|bottom|left`; `inset` ma gołe top/right/bottom/left.
fn phys_name(family: string, side: string) -> string is
    if family == "inset" is return side end
    return family + "-" + side
end

;; Zamienia właściwości logiczne na fizyczne (tryb poziomy; `rtl` zamienia start↔end w osi inline).
fn expand_logical(decls: [css::CssDecl], rtl: bool) -> [css::CssDecl] is
    let il: string = if rtl then "right" else "left"      ;; inline-start
    let ir: string = if rtl then "left" else "right"      ;; inline-end
    let mut out: [css::CssDecl] = []
    let mut i: int = 0
    while i < array_len(decls) is
        let d: css::CssDecl = decls[i]
        i += 1
        let p: string = d.prop
        let toks: [string] = cssval::split_top(d.val)
        let a: string = if array_len(toks) >= 1 then toks[0] else d.val
        let b: string = if array_len(toks) >= 2 then toks[1] else a
        let imp: bool = d.important
        let mut done: bool = false
        ;; skróty scroll-margin / scroll-padding (1–4 wartości, jak margin)
        if p == "scroll-margin" || p == "scroll-padding" is
            let t4: [string] = toks
            let n4: int = array_len(t4)
            if n4 >= 1 && n4 <= 4 is
                let vt: string = t4[0]
                let vr: string = if n4 >= 2 then t4[1] else vt
                let vb: string = if n4 >= 3 then t4[2] else vt
                let vl: string = if n4 >= 4 then t4[3] else vr
                out = emit_decl(out, p + "-top", vt, imp)
                out = emit_decl(out, p + "-right", vr, imp)
                out = emit_decl(out, p + "-bottom", vb, imp)
                out = emit_decl(out, p + "-left", vl, imp)
                continue
            end
        end
        ;; rodziny margin / padding / inset / scroll-margin / scroll-padding
        let fams: [string] = ["margin", "padding", "inset", "scroll-margin", "scroll-padding"]
        let mut f: int = 0
        while f < array_len(fams) && !done is
            let fam: string = fams[f]
            f += 1
            if p == fam + "-inline" || (fam == "inset" && p == "inset-inline") is
                out = emit_decl(out, phys_name(fam, il), a, imp)
                out = emit_decl(out, phys_name(fam, ir), b, imp)
                done = true
            elsif p == fam + "-block" || (fam == "inset" && p == "inset-block") is
                out = emit_decl(out, phys_name(fam, "top"), a, imp)
                out = emit_decl(out, phys_name(fam, "bottom"), b, imp)
                done = true
            elsif p == fam + "-inline-start" is
                out = emit_decl(out, phys_name(fam, il), d.val, imp)
                done = true
            elsif p == fam + "-inline-end" is
                out = emit_decl(out, phys_name(fam, ir), d.val, imp)
                done = true
            elsif p == fam + "-block-start" is
                out = emit_decl(out, phys_name(fam, "top"), d.val, imp)
                done = true
            elsif p == fam + "-block-end" is
                out = emit_decl(out, phys_name(fam, "bottom"), d.val, imp)
                done = true
            end
        end
        if done is continue end
        ;; rozmiary logiczne (tryb poziomy)
        if p == "overflow-inline" is
            out = emit_decl(out, "overflow-x", d.val, imp)
        elsif p == "overflow-block" is
            out = emit_decl(out, "overflow-y", d.val, imp)
        elsif p == "inline-size" is
            out = emit_decl(out, "width", d.val, imp)
        elsif p == "block-size" is
            out = emit_decl(out, "height", d.val, imp)
        elsif p == "min-inline-size" is
            out = emit_decl(out, "min-width", d.val, imp)
        elsif p == "max-inline-size" is
            out = emit_decl(out, "max-width", d.val, imp)
        elsif p == "min-block-size" is
            out = emit_decl(out, "min-height", d.val, imp)
        elsif p == "max-block-size" is
            out = emit_decl(out, "max-height", d.val, imp)
        ;; ramki skrótowe
        elsif p == "border-inline" is
            out = emit_decl(out, "border-left", d.val, imp)
            out = emit_decl(out, "border-right", d.val, imp)
        elsif p == "border-block" is
            out = emit_decl(out, "border-top", d.val, imp)
            out = emit_decl(out, "border-bottom", d.val, imp)
        elsif p == "border-inline-start" is
            out = emit_decl(out, "border-" + il, d.val, imp)
        elsif p == "border-inline-end" is
            out = emit_decl(out, "border-" + ir, d.val, imp)
        elsif p == "border-block-start" is
            out = emit_decl(out, "border-top", d.val, imp)
        elsif p == "border-block-end" is
            out = emit_decl(out, "border-bottom", d.val, imp)
        ;; promienie logiczne
        elsif p == "border-start-start-radius" is
            out = emit_decl(out, if rtl then "border-top-right-radius" else "border-top-left-radius", d.val, imp)
        elsif p == "border-start-end-radius" is
            out = emit_decl(out, if rtl then "border-top-left-radius" else "border-top-right-radius", d.val, imp)
        elsif p == "border-end-start-radius" is
            out = emit_decl(out, if rtl then "border-bottom-right-radius" else "border-bottom-left-radius", d.val, imp)
        elsif p == "border-end-end-radius" is
            out = emit_decl(out, if rtl then "border-bottom-left-radius" else "border-bottom-right-radius", d.val, imp)
        ;; border-{inline,block}[-start|-end]-{width,style,color}
        elsif string_starts_with(p, "border-inline-") || string_starts_with(p, "border-block-") is
            let axis_inline: bool = string_starts_with(p, "border-inline-")
            let rest: string = string_slice(p, if axis_inline then 14 else 13, string_len(p))
            let mut prop_kind: string = ""
            let mut which: string = ""
            if rest == "width" || rest == "style" || rest == "color" is
                prop_kind = rest
                which = "both"
            elsif string_starts_with(rest, "start-") is
                prop_kind = string_slice(rest, 6, string_len(rest))
                which = "start"
            elsif string_starts_with(rest, "end-") is
                prop_kind = string_slice(rest, 4, string_len(rest))
                which = "end"
            end
            if prop_kind == "" is
                out = emit_decl(out, p, d.val, imp)
            else is
                let s1: string = if axis_inline then il else "top"
                let s2: string = if axis_inline then ir else "bottom"
                if which == "both" is
                    out = emit_decl(out, "border-" + s1 + "-" + prop_kind, a, imp)
                    out = emit_decl(out, "border-" + s2 + "-" + prop_kind, b, imp)
                elsif which == "start" is
                    out = emit_decl(out, "border-" + s1 + "-" + prop_kind, d.val, imp)
                else is
                    out = emit_decl(out, "border-" + s2 + "-" + prop_kind, d.val, imp)
                end
            end
        else is
            out = array_push(out, d)
        end
    end
    return out
end

;; Zdejmuje prefiksy dostawców z nazwy właściwości.
fn unprefix(prop: string) -> string is
    if string_starts_with(prop, "-webkit-") is return string_slice(prop, 8, string_len(prop)) end
    if string_starts_with(prop, "-moz-") is return string_slice(prop, 5, string_len(prop)) end
    if string_starts_with(prop, "-ms-") is return string_slice(prop, 4, string_len(prop)) end
    if string_starts_with(prop, "-o-") is return string_slice(prop, 3, string_len(prop)) end
    return prop
end

;; Właściwości dziedziczone (do `unset`).
fn is_inherited_prop(prop: string) -> bool is
    return prop == "color" || prop == "font-size" || prop == "font-weight" || prop == "font-style" || prop == "font-family" ||
           prop == "font" || prop == "line-height" || prop == "text-align" || prop == "text-transform" || prop == "text-indent" ||
           prop == "letter-spacing" || prop == "word-spacing" || prop == "white-space" || prop == "cursor" || prop == "visibility" ||
           prop == "list-style" || prop == "list-style-type" || prop == "list-style-position" || prop == "text-shadow" ||
           prop == "direction" || prop == "border-spacing" || prop == "border-collapse" || prop == "pointer-events" || prop == "word-break" || prop == "overflow-wrap" ||
           prop == "word-wrap" || prop == "tab-size" || prop == "hyphens" || prop == "accent-color" || prop == "caret-color" ||
           prop == "scroll-behavior"
end

;; Kopiuje wartość właściwości `prop` (i jej skrótowych odpowiedników) z `src` do `st0`.
fn copy_prop(st0: ComputedStyle, src: ComputedStyle, prop: string) -> ComputedStyle is
    let mut st: ComputedStyle = st0
