    pub grad_from:  Color
    pub grad_to:    Color
    pub grad_vertical: bool

    ;; rozmiary: *_mode = auto | px | pct (pct: px = offset z calc(), pct = setne % -> 5000 = 50%)
    pub width:      int
    pub width_pct:  int
    pub width_mode: string
    pub height:     int
    pub height_pct: int
    pub height_mode: string
