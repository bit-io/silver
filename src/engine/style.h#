    elsif prop == "visibility" is st.visible = src.visible
    elsif prop == "overflow" || prop == "overflow-x" || prop == "overflow-y" is
        if prop != "overflow-y" is st.overflow_x = src.overflow_x end
        if prop != "overflow-x" is st.overflow_y = src.overflow_y end
    elsif prop == "width" is
        st.width = src.width
