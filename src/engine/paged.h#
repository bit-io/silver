;; 0.4: druk — strony (@page: size, margin, nazwane strony, :first/:left/:right), właściwość `page`, wymuszone podziały
;; (break-before/after: page|always|left|right|recto|verso), `break-inside: avoid`, podział tekstu na granicy strony,
;; oraz zapis PDF (strony jako obrazy RGB) przez shim. Układ liczony raz na szerokości treści pierwszej strony;
;; strony nazwane o innej szerokości zmieniają tylko arkusz (treść nie jest przekładana).
pub struct Page is
    pub y0:    int       ;; y początku w dokumencie (px)
    pub y1:    int       ;; y końca (wyłącznie)
    pub name:  string
    pub w:     int       ;; arkusz w px (96 dpi)
    pub h:     int
    pub mt:    int
    pub mr:    int
    pub mb:    int
    pub ml:    int
    pub rot:   int       ;; 0.4: page-orientation → /Rotate (0 | 90 | 270)
    pub bleed: int       ;; 0.4: spad w px
    pub marks: int       ;; 0.4: bit 1 = crop, bit 2 = cross
end

fn lenpx(tok: string) -> int is
    let l: cssval::Len = cssval::parse_len(string_trim(tok), cssval::LenEnv { em: 16, rem: 16, vw: 1000, vh: 1000 })
    if !l.ok || l.auto is return -1 end
    return cssval::px_of(l, 0)
end

fn paper(name: string) -> [int] is
    if name == "a5" is return [559, 794] end
    if name == "a4" is return [794, 1123] end
    if name == "a3" is return [1123, 1587] end
    if name == "b5" is return [665, 945] end
    if name == "b4" is return [945, 1334] end
    if name == "letter" is return [816, 1056] end
    if name == "legal" is return [816, 1344] end
    if name == "ledger" is return [1056, 1632] end
    return [0, 0]
end

fn apply_margin(b: [int], v: string) -> [int] is
    let toks: [string] = string_split(string_trim(v), " ")
    let mut vals: [int] = []
    let mut i: int = 0
    while i < array_len(toks) is
        if toks[i] != "" is vals = array_push(vals, lenpx(toks[i])) end
        i += 1
    end
    let n: int = array_len(vals)
    let mut o: [int] = [b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8]]
    if n == 0 is return o end
    let t: int = vals[0]
    let r: int = if n > 1 then vals[1] else vals[0]
    let bo: int = if n > 2 then vals[2] else vals[0]
    let l: int = if n > 3 then vals[3] elsif n > 1 then vals[1] else vals[0]
    if t >= 0 is o[2] = t end
    if r >= 0 is o[3] = r end
    if bo >= 0 is o[4] = bo end
    if l >= 0 is o[5] = l end
    return o
end

fn apply_page_decls(b: [int], body: string) -> [int] is
    let mut o: [int] = [b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8]]
    let size: string = string_lower(css::css_decl(body, "size"))
    if size != "" && size != "auto" is
        let toks: [string] = string_split(size, " ")
        let mut lens: [int] = []
        let mut landscape: bool = false
        let mut portrait: bool = false
        let mut pw: int = 0
        let mut ph: int = 0
        let mut i: int = 0
        while i < array_len(toks) is
            let t: string = toks[i]
            i += 1
            if t == "landscape" is landscape = true
            elsif t == "portrait" is portrait = true
            elsif paper(t)[0] > 0 is
                pw = paper(t)[0]
                ph = paper(t)[1]
            elsif t != "" && lenpx(t) > 0 is lens = array_push(lens, lenpx(t)) end
        end
        if array_len(lens) == 1 is
            pw = lens[0]
            ph = lens[0]
        elsif array_len(lens) >= 2 is
            pw = lens[0]
            ph = lens[1]
        end
        if pw > 0 is
            if landscape && pw < ph is
                let t2: int = pw
                pw = ph
                ph = t2
            end
            if portrait && pw > ph is
                let t3: int = pw
                pw = ph
                ph = t3
            end
            o[0] = pw
            o[1] = ph
        end
    end
    ;; 0.4: page-orientation (upright | rotate-left | rotate-right), marks (none | crop || cross), bleed (auto | <długość>)
    let po: string = string_lower(string_trim(css::css_decl(body, "page-orientation")))
    if po == "upright" is o[6] = 0 end
    if po == "rotate-left" is o[6] = 270 end
    if po == "rotate-right" is o[6] = 90 end
    let mk: string = string_lower(string_trim(css::css_decl(body, "marks")))
    if mk == "none" is o[8] = 0 end
    if mk != "" && mk != "none" is
        let mut bits: int = 0
        if string_find(mk, "crop") >= 0 is bits = bits + 1 end
        if string_find(mk, "cross") >= 0 is bits = bits + 2 end
        o[8] = bits
    end
    let bl: string = string_lower(string_trim(css::css_decl(body, "bleed")))
    if bl == "auto" is o[7] = if (o[8] % 2) == 1 then 8 else 0 end
    elsif bl != "" && lenpx(bl) >= 0 is o[7] = lenpx(bl) end
    let m: string = css::css_decl(body, "margin")
    if m != "" is o = apply_margin(o, m) end
    let mt: int = lenpx(css::css_decl(body, "margin-top"))
    let mr: int = lenpx(css::css_decl(body, "margin-right"))
    let mb: int = lenpx(css::css_decl(body, "margin-bottom"))
    let ml: int = lenpx(css::css_decl(body, "margin-left"))
    if mt >= 0 is o[2] = mt end
    if mr >= 0 is o[3] = mr end
    if mb >= 0 is o[4] = mb end
    if ml >= 0 is o[5] = ml end
    return o
end

;; [szerokość, wysokość, margines górny, prawy, dolny, lewy] w px dla strony `idx` (od 0) o nazwie `name`
pub fn page_box(sheet: css::Stylesheet, name: string, idx: int) -> [int] is
    let mut b: [int] = [794, 1123, 38, 38, 38, 38, 0, 0, 0]
    let lname: string = string_lower(name)
    let mut spec: int = 0
    while spec < 4 is
        let mut i: int = 0
        while i < array_len(sheet.pages) is
            let parts: [string] = string_split(sheet.pages[i], "\u0001")
            i += 1
            if array_len(parts) < 2 is continue end
            let sel: string = parts[0]
            let colon: int = string_find(sel, ":")
            let n: string = if colon >= 0 then string_slice(sel, 0, colon) else sel
            let ps: string = if colon >= 0 then string_slice(sel, colon + 1, string_len(sel)) else ""
            if n != "" && n != lname is continue end
            let ok: bool = ps == "" || (ps == "first" && idx == 0) || (ps == "left" && idx % 2 == 1) || (ps == "right" && idx % 2 == 0)
            if !ok is continue end
            let es: int = (if n != "" then 2 else 0) + (if ps != "" then 1 else 0)
            if es != spec is continue end
            b = apply_page_decls(b, parts[1])
        end
        spec += 1
    end
    return b
end

fn node_page(pg: [string], d: dom::Dom, id0: int) -> string is
    let mut id: int = id0
    let mut guard: int = 0
    while id >= 0 && guard < 256 is
        if pg[id] != "" is return pg[id] end
        id = d.nodes[id].parent
        guard += 1
    end
    return ""
end

fn is_forced(v: string) -> bool is
    return v == "page" || v == "always" || v == "left" || v == "right" || v == "recto" || v == "verso"
end

fn break_val(st: style::ComputedStyle, which: string) -> string is
    let a: string = string_lower(string_trim(props::xget(st.xp, "break-" + which)))
    if a != "" is return a end
    return string_lower(string_trim(props::xget(st.xp, "page-break-" + which)))
end

;; Najlepsze miejsce cięcia w (start, limit]: linie tekstu i bloki z break-inside: avoid nie są przecinane.
fn best_cut(boxes: [layout::LayoutBox], start: int, limit: int) -> int is
    let mut cut: int = limit
    let mut pass: int = 0
    while pass < 6 is
        let mut changed: bool = false
        let mut i: int = 0
        while i < array_len(boxes) is
            let b: layout::LayoutBox = boxes[i]
            i += 1
            if b.y > start && b.y < cut && b.y + b.h > cut is
                let avoid: bool = b.kind == "box" && string_lower(props::xget(b.st.xp, "break-inside")) == "avoid" && b.h <= limit - start
                let page_avoid: bool = b.kind == "box" && string_lower(props::xget(b.st.xp, "page-break-inside")) == "avoid" && b.h <= limit - start
                if b.kind == "text" || b.kind == "image" || avoid || page_avoid is
                    cut = b.y
                    changed = true
                end
            end
        end
        if !changed is break end
        pass += 1
    end
    return if cut <= start then limit else cut
end

;; 0.4: hyphenate-limit-last (always | page | column | spread) — ostatni wiersz przed końcem strony nie może kończyć się łącznikiem:
;; przenosimy go na następną stronę. Zwraca poprawione miejsce cięcia.
fn avoid_hyphen_at_cut(boxes: [layout::LayoutBox], start: int, cut: int) -> int is
    let mut best: int = -1
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        if b.kind == "text" && b.h > 0 && b.y >= start && b.y + b.h <= cut is
            if best < 0 || b.y > boxes[best].y is best = i end
        end
        i += 1
    end
    if best < 0 is return cut end
    let t: layout::LayoutBox = boxes[best]
    let v: string = string_lower(string_trim(props::xget(t.st.xp, "hyphenate-limit-last")))
    if v != "always" && v != "page" && v != "column" && v != "spread" is return cut end
    if !(string_ends_with(t.text, "-") || string_ends_with(t.text, "\u2010")) is return cut end
    if t.y > start is return t.y end
    return cut
end

pub fn paginate(boxes: [layout::LayoutBox], d: dom::Dom, sheet: css::Stylesheet, doc_h: int) -> [Page] is
    return paginate_r(boxes, d, sheet, doc_h, [])
end

;; `reserve[i]` = wysokość (px) zarezerwowana na dole i-tej strony (pole przypisów); strona ma wtedy tyle mniej miejsca na treść.
pub fn paginate_r(boxes: [layout::LayoutBox], d: dom::Dom, sheet: css::Stylesheet, doc_h: int, reserve: [int]) -> [Page] is
    let nn: int = array_len(d.nodes)
    let mut pg: [string] = []
    let mut ymap: [int] = []
    let mut k: int = 0
    while k < nn is
        pg = array_push(pg, "")
        ymap = array_push(ymap, -1)
        k += 1
    end
    let mut first_name_node: int = -1
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        i += 1
        if b.kind != "box" || b.node_id < 0 || b.node_id >= nn is continue end
        let v: string = string_lower(string_trim(props::xget(b.st.xp, "page")))
        if v != "" && v != "auto" is pg[b.node_id] = v end
        if ymap[b.node_id] < 0 is ymap[b.node_id] = b.y end
        let t: string = d.nodes[b.node_id].tag
        if first_name_node < 0 && b.h > 0 && t != "html" && t != "body" is first_name_node = b.node_id end
    end
    ;; wymuszone podziały: [y], nazwa strony po podziale ("*" = bez zmiany)
    let mut fy: [int] = []
    let mut fname: [string] = []
    let mut p: int = 0
    while p < nn is
        let node: dom::DomNode = d.nodes[p]
        p += 1
        if node.removed || array_len(node.children) == 0 is continue end
        let mut prev_used: string = ""
        let mut have_prev: bool = false
        let mut c: int = 0
        while c < array_len(node.children) is
            let cid: int = node.children[c]
            c += 1
            if d.nodes[cid].tag == "text" || ymap[cid] < 0 is continue end
            let u: string = node_page(pg, d, cid)
            if have_prev && u != prev_used && ymap[cid] > 0 is
                fy = array_push(fy, ymap[cid])
                fname = array_push(fname, if u == "" then "-" else u)
            end
            prev_used = u
            have_prev = true
        end
    end
    i = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        i += 1
        if b.kind != "box" || b.node_id < 0 is continue end
        if is_forced(break_val(b.st, "before")) && b.y > 0 is
            fy = array_push(fy, b.y)
            fname = array_push(fname, "*")
        end
        if is_forced(break_val(b.st, "after")) && b.y + b.h > 0 && b.y + b.h < doc_h - 1 is
            fy = array_push(fy, b.y + b.h)
            fname = array_push(fname, "*")
        end
    end
    let mut pages: [Page] = []
    let mut start: int = 0
    let mut idx: int = 0
    let mut name: string = if first_name_node >= 0 then node_page(pg, d, first_name_node) else ""
    while start < doc_h && idx < 1000 is
        let pb: [int] = page_box(sheet, name, idx)
        let ch0: int = pb[1] - pb[2] - pb[4]
        let rsv: int = if idx < array_len(reserve) then reserve[idx] else 0
        let ch1: int = ch0 - rsv
        let ch: int = if ch1 < 50 then 50 else ch1
        let limit: int = start + ch
        ;; najbliższy wymuszony podział po `start`
        let mut nf: int = -1
        let mut nfi: int = -1
        let mut q: int = 0
        while q < array_len(fy) is
            if fy[q] > start && (nf < 0 || fy[q] < nf) is
                nf = fy[q]
                nfi = q
            end
            q += 1
        end
        let mut cut: int = limit
        if nf >= 0 && nf <= limit is
            cut = nf
        elsif limit >= doc_h is
            cut = doc_h
        else is
            cut = avoid_hyphen_at_cut(boxes, start, best_cut(boxes, start, limit))
        end
        if cut <= start is cut = limit end
        pages = array_push(pages, Page { y0: start, y1: cut, name: name, w: pb[0], h: pb[1], mt: pb[2], mr: pb[3], mb: pb[4], ml: pb[5], rot: pb[6], bleed: pb[7], marks: pb[8] })
        if nfi >= 0 && cut == nf is
            let nm: string = fname[nfi]
            if nm == "-" is name = "" elsif nm != "*" is name = nm end
        end
        start = cut
        idx += 1
    end
    return pages
end

;; 0.4: bookmark-label — lista: "tekst" | content(text) | content() | attr(nazwa); domyślnie content(text)
fn bookmark_text(d: dom::Dom, id: int, label: string) -> string is
    let lv: string = string_trim(label)
    if lv == "" || string_lower(lv) == "none" is return "" end
    let toks: [string] = cssval::split_top(lv)
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = toks[i]
        i += 1
        let lt: string = string_lower(t)
        if string_len(t) >= 2 && (string_starts_with(t, "\"") || string_starts_with(t, "'")) is
            out = out + string_slice(t, 1, string_len(t) - 1)
        elsif string_starts_with(lt, "content(") || lt == "content" is
            out = out + string_trim(dom::text_content(d, id))
        elsif string_starts_with(lt, "attr(") is
            out = out + dom::get_attr(d.nodes[id], string_trim(string_slice(t, 5, string_len(t) - 1)))
        end
    end
    return string_trim(out)
end

fn page_of_y(pages: [Page], y: int) -> int is
    let mut i: int = 0
    while i < array_len(pages) is
        if y >= pages[i].y0 && y < pages[i].y1 is return i end
        i += 1
    end
    return array_len(pages) - 1
end

fn emit_bookmarks(res: layout::LayoutResult, d: dom::Dom, pages: [Page]) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(res.boxes) is
        let b: layout::LayoutBox = res.boxes[i]
        i += 1
        if b.kind != "box" || b.node_id < 0 || b.node_id >= array_len(d.nodes) is continue end
        let lvs: string = string_trim(props::xget(b.st.xp, "bookmark-level"))
        if lvs == "" || !props::is_int(lvs) is continue end
        let lv: int = str_to_int(lvs)
        if lv < 1 is continue end
        let lab0: string = props::xget(b.st.xp, "bookmark-label")
        let lab: string = bookmark_text(d, b.node_id, if lab0 == "" then "content(text)" else lab0)
        if lab == "" is continue end
        let pi: int = page_of_y(pages, b.y)
        let y100: int = (pages[pi].mt + b.y - pages[pi].y0) * 75
        let open: int = if string_lower(string_trim(props::xget(b.st.xp, "bookmark-state"))) == "closed" then 0 else 1
        if ffi_shim::silver_pdf_bookmark(lab, lv, pi, y100, open) == 1 is n += 1 end
    end
    return n
end

;; Drukuje dokument do PDF (strony jako obrazy). `win` — okno z zarejestrowanymi czcionkami (renderowanie idzie do tekstury).
;; Zwraca liczbę stron (0 = błąd). `backgrounds` — druk teł wg print-color-adjust (domyślnie economy gubi tła).
;; ---------- przypisy: float: footnote, footnote-display, footnote-policy ----------
pub struct FootnoteSet is
    pub d:     dom::Dom      ;; DOM, w którym przypisy zastąpiono odnośnikami (<sup class="footnote-call">N</sup>)
    pub ids:   [int]         ;; węzły-odnośniki w kolejności dokumentu
    pub texts: [string]      ;; treść przypisów (zwykły tekst)
    pub disp:  [string]      ;; footnote-display: block | inline | compact
    pub pol:   [string]      ;; footnote-policy: auto | line | block
end

fn is_inline_wrapper(t: string) -> bool is
    return t == "span" || t == "a" || t == "em" || t == "strong" || t == "b" || t == "i" || t == "sup" || t == "sub" || t == "code" || t == "small" || t == "u" || t == "mark"
end

fn mentions_footnote(d: dom::Dom, sheet: css::Stylesheet) -> bool is
    let mut i: int = 0
    while i < array_len(sheet.rules) is
        let mut j: int = 0
        while j < array_len(sheet.rules[i].decls) is
            if sheet.rules[i].decls[j].prop == "float" && string_lower(string_trim(sheet.rules[i].decls[j].val)) == "footnote" is return true end
            j += 1
        end
        i += 1
    end
    let mut k: int = 0
    while k < array_len(d.nodes) is
        if string_find(string_lower(d.nodes[k].attr_style), "footnote") >= 0 is return true end
        k += 1
    end
    return false
end

;; Elementy z `float: footnote` przestają być częścią przepływu: w tekście zostaje numerowany odnośnik, a treść trafia do pola
;; przypisów strony, na której wylądował odnośnik.
pub fn footnote_prepare(d0: dom::Dom, sheet: css::Stylesheet, ix: css::InteractionState) -> FootnoteSet is
    let none: FootnoteSet = FootnoteSet { d: d0, ids: [], texts: [], disp: [], pol: [] }
    if !mentions_footnote(d0, sheet) is return none end
    let mut d: dom::Dom = dom::deep_copy(d0)
    let mut ids: [int] = []
    let mut texts: [string] = []
    let mut disp: [string] = []
    let mut pol: [string] = []
    let mut e: int = 1
    while e < array_len(d0.nodes) is
        let node: dom::DomNode = d0.nodes[e]
        let cur: int = e
        e += 1
        if node.removed || node.tag == "text" is continue end
        let decls: [css::CssDecl] = css::matching_decls_ctx(sheet, d0, cur, ix)
        let mut is_fn: bool = false
        let mut dv: string = "block"
        let mut pv: string = "auto"
        let mut q: int = 0
        while q < array_len(decls) is
            let pr: string = decls[q].prop
            let vl: string = string_lower(string_trim(decls[q].val))
            if pr == "float" is is_fn = vl == "footnote" end
            if pr == "footnote-display" is dv = vl end
            if pr == "footnote-policy" is pv = vl end
            q += 1
        end
        if !is_fn is continue end
        let txt: string = string_trim(dom::collapse_ws(dom::text_content(d0, cur)))
        let num: int = array_len(ids) + 1
        d.nodes[cur].tag = "sup"
        d.nodes[cur].attr_class = "footnote-call"
        d.nodes[cur].attr_style = "display: inline; float: none; font-size: 0.75em; vertical-align: super; "
        d.nodes[cur].children = []
        d = dom::new_node(d, cur, "text")
        d.nodes[array_len(d.nodes) - 1].text = to_string(num)
        if pv == "block" is
            let mut par: int = d0.nodes[cur].parent
            while par > 0 && is_inline_wrapper(d0.nodes[par].tag) is par = d0.nodes[par].parent end
            if par > 0 is d.nodes[par].attr_style = d.nodes[par].attr_style + "; break-inside: avoid" end
        end
        ids = array_push(ids, cur)
        texts = array_push(texts, txt)
        disp = array_push(disp, dv)
        pol = array_push(pol, pv)
    end
    return FootnoteSet { d: d, ids: ids, texts: texts, disp: disp, pol: pol }
end

;; HTML pola przypisów dla wskazanych przypisów (numery globalne): block/compact — osobne akapity, inline — jeden ciągły akapit.
pub fn footnote_area_html(fs: FootnoteSet, idxs: [int]) -> string is
    let mut html: string = "<div class=\"footnotes\" style=\"border-top: 1px solid #000000; padding-top: 4px; margin: 0\">"
    let mut inl: string = ""
    let mut k: int = 0
    while k < array_len(idxs) is
        let n: int = idxs[k]
        k += 1
        let mark: string = "<span class=\"footnote-marker\" style=\"font-size: 0.75em; vertical-align: super\">" + to_string(n + 1) + "</span> "
        let body: string = mark + layout::html_esc_text(fs.texts[n])
        if fs.disp[n] == "inline" is
            inl = if inl == "" then body else inl + " &nbsp; " + body
        else is
            if inl != "" is
                html = html + "<p class=\"footnote\" style=\"margin: 0 0 3px\">" + inl + "</p>"
                inl = ""
            end
            html = html + "<p class=\"footnote\" style=\"margin: 0 0 3px\">" + body + "</p>"
        end
    end
    if inl != "" is html = html + "<p class=\"footnote\" style=\"margin: 0 0 3px\">" + inl + "</p>" end
    return html + "</div>"
end

fn call_y(boxes: [layout::LayoutBox], d: dom::Dom, id: int) -> int is
    let mut i: int = 0
    while i < array_len(boxes) is
        let b: layout::LayoutBox = boxes[i]
        i += 1
        if b.node_id < 0 || b.node_id >= array_len(d.nodes) is continue end
        ;; odnośnik jest podniesiony (vertical-align: super), więc o stronie decyduje jego dolna krawędź — wiersz, w którym stoi
        if b.node_id == id || d.nodes[b.node_id].parent == id is return b.y + b.h - 1 end
    end
    return -100000
end

;; Plan druku: układ całości + podział na strony z miejscem zarezerwowanym na przypisy.
pub struct PrintPlan is
    pub fs:      FootnoteSet
    pub res:     layout::LayoutResult
    pub pages:   [Page]
    pub reserve: [int]       ;; px zarezerwowane na dole każdej strony
    pub notes:   [int]       ;; numer strony dla każdego przypisu (-1 gdy nie znaleziono odnośnika)
    pub fn_h:    [int]       ;; wysokość pola przypisów każdej strony (bez odstępu)
end

fn note_pages(res: layout::LayoutResult, fs: FootnoteSet, pages: [Page]) -> [int] is
    let mut out: [int] = []
    let mut k: int = 0
    while k < array_len(fs.ids) is
        let y: int = call_y(res.boxes, fs.d, fs.ids[k])
        out = array_push(out, if y == -100000 then -1 else page_of_y(pages, if y < 0 then 0 else y))
        k += 1
    end
    return out
end

fn area_heights(win: int, fs: FootnoteSet, sheet: css::Stylesheet, notes: [int], npages: int, cw: int) -> [int] is
    let mut hs: [int] = []
    let mut p: int = 0
    while p < npages is
        let mut idxs: [int] = []
        let mut k: int = 0
        while k < array_len(notes) is
            if notes[k] == p is idxs = array_push(idxs, k) end
            k += 1
        end
        if array_len(idxs) == 0 is hs = array_push(hs, 0)
        else is
            let r: layout::LayoutResult = layout::layout_full_a(dom::parse(footnote_area_html(fs, idxs)), sheet, cw, 400, win, css::no_interaction(), [], anim::no_anim())
            hs = array_push(hs, r.height)
        end
        p += 1
    end
    return hs
end

pub fn plan_print(win: int, d: dom::Dom, sheet: css::Stylesheet, backgrounds: bool) -> PrintPlan is
    let first: [int] = page_box(sheet, "", 0)
    let cw0: int = first[0] - first[5] - first[3]
    let cw: int = if cw0 < 100 then 100 else cw0
    let chp: int = first[1] - first[2] - first[4]
    let mut ix: css::InteractionState = css::no_interaction()
    ix.print = true
    ix.print_bg = backgrounds
    let fs: FootnoteSet = footnote_prepare(d, sheet, ix)
    let res: layout::LayoutResult = layout::layout_full_a(fs.d, sheet, cw, chp, win, ix, [], anim::no_anim())
    let mut pages: [Page] = paginate_r(res.boxes, fs.d, sheet, res.height, [])
    let mut reserve: [int] = []
    let mut notes: [int] = []
    let mut hs: [int] = []
    if array_len(fs.ids) > 0 is
        let mut it: int = 0
        while it < 6 is
            it += 1
            notes = note_pages(res, fs, pages)
            hs = area_heights(win, fs, sheet, notes, array_len(pages), cw)
            let mut nr: [int] = []
            let mut p: int = 0
            while p < array_len(hs) is
                nr = array_push(nr, if hs[p] > 0 then hs[p] + 6 else 0)
                p += 1
            end
            let mut same: bool = array_len(nr) == array_len(reserve)
            let mut z: int = 0
            while same && z < array_len(nr) is
                if nr[z] != reserve[z] is same = false end
                z += 1
            end
            if same is break end
            reserve = nr
            pages = paginate_r(res.boxes, fs.d, sheet, res.height, reserve)
        end
        notes = note_pages(res, fs, pages)
        hs = area_heights(win, fs, sheet, notes, array_len(pages), cw)
    end
    return PrintPlan { fs: fs, res: res, pages: pages, reserve: reserve, notes: notes, fn_h: hs }
end

pub fn print_pdf(win: int, d: dom::Dom, sheet: css::Stylesheet, backgrounds: bool, path: string) -> int is
    let plan: PrintPlan = plan_print(win, d, sheet, backgrounds)
    let res: layout::LayoutResult = plan.res
    let pages: [Page] = plan.pages
    let dd: dom::Dom = plan.fs.d
    let first: [int] = page_box(sheet, "", 0)
    let cw0: int = first[0] - first[5] - first[3]
    let cw: int = if cw0 < 100 then 100 else cw0
    if array_len(pages) == 0 is return 0 end
    if ffi_shim::silver_pdf_begin() == 0 is return 0 end
    let white: style::Color = style::Color { r: 255, g: 255, b: 255, a: 255 }
    let mut i: int = 0
    while i < array_len(pages) is
        let pgi: Page = pages[i]
        let pidx: int = i
        i += 1
        let ch: int = pgi.h - pgi.mt - pgi.mb
        if ffi_shim::silver_target_begin(win, cw, ch) == 0 is return 0 end
        let mut rs: paint::RenderState = paint::plain_state(pgi.y0)
        rs.viewport_h = ch
        paint::render(win, res.boxes, dd, rs, white)
        ;; treść poniżej miejsca cięcia należy do następnej strony — zamalowujemy ją (okno strony jest wyższe niż jej zakres)
        let used: int = pgi.y1 - pgi.y0
        if used < ch is ffi_shim::silver_fill_rect(win, 0, used, cw, ch - used, 255, 255, 255, 255) end
        ;; pole przypisów u dołu strony
        if pidx < array_len(plan.fn_h) && plan.fn_h[pidx] > 0 is
            let mut idxs: [int] = []
            let mut k: int = 0
            while k < array_len(plan.notes) is
                if plan.notes[k] == pidx is idxs = array_push(idxs, k) end
                k += 1
            end
            let fd: dom::Dom = dom::parse(footnote_area_html(plan.fs, idxs))
            let fr: layout::LayoutResult = layout::layout_full_a(fd, sheet, cw, 400, win, css::no_interaction(), [], anim::no_anim())
            let rsf: paint::RenderState = paint::plain_state(0 - (ch - plan.fn_h[pidx]))
            paint::render_over(win, fr.boxes, fd, rsf)
        end
        let ok: int = ffi_shim::silver_pdf_page_ex(win, cw, ch, pgi.w * 75, pgi.h * 75, pgi.ml * 75, pgi.mt * 75, cw * 75, ch * 75, pgi.rot, pgi.bleed * 75, pgi.marks)
        ffi_shim::silver_target_end(win)
        if ok == 0 is return 0 end
    end
    emit_bookmarks(res, dd, pages)
    if ffi_shim::silver_pdf_end(path) == 0 is return 0 end
    return array_len(pages)
end
