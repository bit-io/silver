use "std -> conv" from "conv"

pub struct Color is
    pub r: int
    pub g: int
    pub b: int
    pub a: int
end

;; Długość po rozwiązaniu: `px` + `pct` (setne części procenta, 5000 = 50%).
;; `auto` = słowo kluczowe auto, `ok` = false gdy wartość nie dała się sparsować.
pub struct Len is
    pub px:   int
    pub pct:  int
    pub auto: bool
    pub ok:   bool
end

pub struct LenEnv is
    pub em:  int    ;; bieżący font-size (px)
    pub rem: int
    pub vw:  int    ;; szerokość viewportu (px)
    pub vh:  int
end

pub fn default_env() -> LenEnv is
    return LenEnv { em: 16, rem: 16, vw: 800, vh: 600 }
end

pub fn len_px(px: int) -> Len is
    return Len { px: px, pct: 0, auto: false, ok: true }
end

pub fn len_auto() -> Len is
    return Len { px: 0, pct: 0, auto: true, ok: true }
end

pub fn len_bad() -> Len is
    return Len { px: 0, pct: 0, auto: false, ok: false }
end

;; Rozwiązuje `Len` względem `basis` (np. szerokości bloku zawierającego).
pub fn px_of(l: Len, basis: int) -> int is
    return l.px + basis * l.pct / 10000
end

