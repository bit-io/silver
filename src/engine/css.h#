pub struct CssDecl is
    pub prop:      string
    pub val:       string
    pub important: bool
end

pub struct AttrSel is
    pub name: string
    pub op:   string    ;; "" (istnieje) | "=" | "~=" | "|=" | "^=" | "$=" | "*="
    pub val:  string
end

;; Pojedynczy selektor złożony (bez kombinatorów), np. `a.btn#x[href]:hover`
pub struct Compound is
    pub tag:     string      ;; "" = dowolny ("*")
    pub id:      string
    pub classes: [string]
    pub attrs:   [AttrSel]
    pub pseudos: [string]    ;; np. "hover", "nth-child(2n+1)"
    pub nots:    [string]    ;; wnętrza :not(...) — lista selektorów po przecinku
    pub iss:     [string]    ;; wnętrza :is()/:where()
end

pub struct CssRule is
    pub selector: string
    pub decls:    [CssDecl]
    pub media:    string       ;; "" = zawsze
    pub order:    int
    pub spec:     int
    pub comps:    [Compound]   ;; od lewej do prawej
    pub combs:    [string]     ;; combs[i] = kombinator między comps[i-1] a comps[i]
    pub pelem:    string       ;; "" | "before" | "after"
    pub layer:    int          ;; 0 = bez @layer; 1.. = kolejność warstwy (późniejsza wygrywa)
    pub cq:       string       ;; warunki @container (rozdzielone \u0002), "" = brak
end

;; @font-face
pub struct FontFace is
    pub family: string
    pub src:    string         ;; ścieżka/URL pliku czcionki
    pub bold:   bool
    pub italic: bool
end

;; Jeden przystanek @keyframes (`from` = 0, `to` = 100).
