fn combine_media(outer: string, inner: string) -> string is
    if outer == "" is return inner end
    if inner == "" is return outer end
    return outer + " and " + inner
end

fn is_quote_c(c: string) -> bool is
    return c == "\"" || c == "'"
end

;; Dzieli ciało reguły na tekst deklaracji ([0]) i zagnieżdżone bloki ("prelude\u0002treść"), CSS Nesting.
fn split_nested(block: string) -> [string] is
    let n: int = string_len(block)
    let mut decl_text: string = ""
    let mut nested: [string] = []
    let mut cur: string = ""
    let mut depth: int = 0
    let mut quote: string = ""
    let mut i: int = 0
    while i < n is
        let c: string = string_at(block, i)
        if quote != "" is
            if c == quote is quote = "" end
            cur = cur + c
        elsif is_quote_c(c) is
            quote = c
            cur = cur + c
        elsif c == "(" is
            depth += 1
            cur = cur + c
        elsif c == ")" is
            depth -= 1
            cur = cur + c
        elsif c == ";" && depth <= 0 is
            decl_text = decl_text + cur + ";"
            cur = ""
        elsif c == "{" && depth <= 0 && !string_starts_with(string_trim(cur), "--") is
            let close: int = matching_brace(block, i)
            if close < 0 is
                i = n
            else is
                nested = array_push(nested, string_trim(cur) + "\u0002" + string_slice(block, i + 1, close))
                cur = ""
                i = close
            end
        else is
            cur = cur + c
        end
        i += 1
    end
    let mut out: [string] = [decl_text + cur]
    let mut k: int = 0
    while k < array_len(nested) is
        out = array_push(out, nested[k])
        k += 1
    end
    return out
end

;; Selektor zagnieżdżony: `&` = selektor rodzica, bez `&` — potomek rodzica.
pub fn nest_selector(parent: string, child: string) -> string is
    let c: string = string_trim(child)
    if string_find(c, "&") >= 0 is return string_replace(c, "&", parent) end
    return parent + " " + c
end

fn join_list(items: [string], sep: string) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(items) is
        out = if i == 0 then items[i] else out + sep + items[i]
        i += 1
    end
    return out
end

fn combine_cq(outer: string, inner: string) -> string is
    if outer == "" is return inner end
    if inner == "" is return outer end
    return outer + "\u0002" + inner
end

fn parse_into(css: string, media: string, cq: string, layer: string, lorder: string, rules: [CssRule]) -> [CssRule] is
    let mut acc: [CssRule] = rules
    let n: int = string_len(css)
    let mut p: int = 0
    while p < n is
        while p < n && is_ws(string_at(css, p)) is p += 1 end
        if p >= n is break end
        if string_at(css, p) == "@" is
            let mut q: int = p + 1
            while q < n && is_ident_char(string_at(css, q)) is q += 1 end
            let name: string = string_lower(string_slice(css, p + 1, q))
            let brace: int = find_char(css, "{", q)
            let semi: int = find_char(css, ";", q)
            let block_first: bool = brace >= 0 && (semi < 0 || brace < semi)
            if !block_first is
                p = if semi < 0 then n else semi + 1
                continue
            end
            let close: int = matching_brace(css, brace)
            if close < 0 is
                p = n
                continue
            end
            let prelude: string = string_trim(string_slice(css, q, brace))
            let inner: string = string_slice(css, brace + 1, close)
            if name == "media" is
                acc = parse_into(inner, combine_media(media, string_lower(prelude)), cq, layer, lorder, acc)
            elsif name == "supports" is
                if supports_matches(prelude) is acc = parse_into(inner, media, cq, layer, lorder, acc) end
            elsif name == "layer" is
                let nm: string = string_trim(prelude)
                acc = parse_into(inner, media, cq, if nm == "" then layer else full_layer_name(layer, nm), lorder, acc)
            elsif name == "container" is
                acc = parse_into(inner, media, combine_cq(cq, string_lower(prelude)), layer, lorder, acc)
            elsif name == "scope" is
                acc = parse_into(inner, media, cq, layer, lorder, acc)
            end
            p = close + 1
            continue
        end
        let open: int = find_char(css, "{", p)
        if open < 0 is break end
        let close: int = matching_brace(css, open)
        if close < 0 is break end
        let selector_group: string = string_trim(string_slice(css, p, open))
        let body: string = string_slice(css, open + 1, close)
        let parts: [string] = if string_find(body, "{") >= 0 then split_nested(body) else [body]
        let decls: [CssDecl] = parse_decls(parts[0])
        let group: [string] = cssval::split_commas(selector_group)
        let rank: int = layer_rank(lorder, layer)
        let mut gi: int = 0
        while gi < array_len(group) is
            let sel: string = string_trim(group[gi])
            gi += 1
            if sel != "" is
                let mut r: CssRule = compile_rule(sel, decls, media, array_len(acc))
                r.layer = rank
                r.cq = cq
                acc = array_push(acc, r)
            end
        end
        ;; zagnieżdżone reguły i at-reguły warunkowe wewnątrz reguły
        let mut ni: int = 1
        while ni < array_len(parts) is
            let np: [string] = string_split(parts[ni], "\u0002")
            ni += 1
            let prelude: string = string_trim(np[0])
            let nbody: string = if array_len(np) >= 2 then np[1] else ""
            if prelude == "" is continue end
            if string_starts_with(prelude, "@") is
                let text: string = prelude + " " + "{" + selector_group + " " + "{" + nbody + "}" + "}"
                acc = parse_into(text, media, cq, layer, lorder, acc)
            else is
                let kids: [string] = cssval::split_commas(prelude)
                let mut resolved: [string] = []
                let mut pi: int = 0
                while pi < array_len(group) is
                    let mut ki: int = 0
                    while ki < array_len(kids) is
                        resolved = array_push(resolved, nest_selector(string_trim(group[pi]), kids[ki]))
                        ki += 1
                    end
                    pi += 1
                end
                let text: string = join_list(resolved, ", ") + " " + "{" + nbody + "}"
                acc = parse_into(text, media, cq, layer, lorder, acc)
            end
        end
        p = close + 1
    end
    return acc
end

;; Zbiera at-reguły `want` (na wszystkich poziomach zagnieżdżenia @media/@supports/@layer/@container).
;; Zwraca elementy "prelude\u0002treść" (dla reguł instrukcyjnych treść = "").
fn scan_at(css: string, want: string, acc0: [string]) -> [string] is
    let mut acc: [string] = acc0
    let n: int = string_len(css)
    let mut p: int = 0
    while p < n is
        while p < n && is_ws(string_at(css, p)) is p += 1 end
        if p >= n is break end
        if string_at(css, p) == "@" is
            let mut q: int = p + 1
            while q < n && is_ident_char(string_at(css, q)) is q += 1 end
            let name: string = string_lower(string_slice(css, p + 1, q))
            let brace: int = find_char(css, "{", q)
            let semi: int = find_char(css, ";", q)
            let block_first: bool = brace >= 0 && (semi < 0 || brace < semi)
            if !block_first is
                if name == want is
                    let end_at: int = if semi < 0 then n else semi
                    acc = array_push(acc, string_trim(string_slice(css, q, end_at)) + "\u0002")
                end
                p = if semi < 0 then n else semi + 1
                continue
            end
            let close: int = matching_brace(css, brace)
            if close < 0 is break end
            let prelude: string = string_trim(string_slice(css, q, brace))
            let inner: string = string_slice(css, brace + 1, close)
            if name == want is
                acc = array_push(acc, prelude + "\u0002" + inner)
            elsif name == "media" || name == "layer" || name == "container" is
                acc = scan_at(inner, want, acc)
            elsif name == "supports" is
                if supports_matches(prelude) is acc = scan_at(inner, want, acc) end
            end
            p = close + 1
            continue
        end
        let open: int = find_char(css, "{", p)
        if open < 0 is break end
        let close: int = matching_brace(css, open)
        if close < 0 is break end
        p = close + 1
    end
    return acc
end

;; "url(\"a.css\") screen" / "\"a.css\" (min-width: 600px)" -> "a.css\u0001screen"
fn import_entry(raw: string) -> string is
    let t: string = string_trim(raw)
    let mut url: string = ""
    let mut rest: string = ""
    if string_starts_with(string_lower(t), "url(") is
        let e: int = paren_end(t, 3)
        url = string_trim(string_slice(t, 4, e))
        rest = string_trim(string_slice(t, e + 1, string_len(t)))
    elsif string_starts_with(t, "\"") || string_starts_with(t, "'") is
        let q: string = string_slice(t, 0, 1)
        let e: int = find_char(t, q, 1)
        if e < 0 is return "" end
        url = string_slice(t, 1, e)
        rest = string_trim(string_slice(t, e + 1, string_len(t)))
    else is
        return ""
    end
    if string_starts_with(url, "\"") || string_starts_with(url, "'") is url = string_slice(url, 1, string_len(url) - 1) end
    ;; `layer(...)` / `supports(...)` po URL-u pomijamy
    if string_starts_with(string_lower(rest), "layer") || string_starts_with(string_lower(rest), "supports") is
        let po: int = string_find(rest, "(")
        if po >= 0 is rest = string_trim(string_slice(rest, paren_end(rest, po) + 1, string_len(rest))) end
    end
    return url + "\u0001" + rest
end

;; Preferencja formatu czcionki: TTF/OTF/TTC (3) > WOFF (2, dekodowany w warstwie natywnej) > reszta (WOFF2 — 0).
pub fn font_src_score(u: string) -> int is
    let mut lu: string = string_lower(u)
    let q: int = string_find(lu, "?")
    if q >= 0 is lu = string_slice(lu, 0, q) end
    let h: int = string_find(lu, "#")
    if h >= 0 is lu = string_slice(lu, 0, h) end
    if string_ends_with(lu, ".ttf") || string_ends_with(lu, ".otf") || string_ends_with(lu, ".ttc") is return 3 end
    if string_ends_with(lu, ".woff") is return 2 end
    return 0
end

fn parse_font_face(body: string) -> FontFace is
    let decls: [CssDecl] = parse_decls(body)
    let mut ff: FontFace = FontFace { family: "", src: "", bold: false, italic: false }
    let mut i: int = 0
    while i < array_len(decls) is
        let d: CssDecl = decls[i]
        i += 1
        let v: string = string_trim(d.val)
        let lv: string = string_lower(v)
        if d.prop == "font-family" is
            let mut f: string = v
            if string_starts_with(f, "\"") || string_starts_with(f, "'") is f = string_slice(f, 1, string_len(f) - 1) end
            ff.family = string_lower(string_trim(f))
        elsif d.prop == "font-weight" is
            ff.bold = lv == "bold" || lv == "bolder" || str_to_int(lv) >= 600
        elsif d.prop == "font-style" is
            ff.italic = lv == "italic" || lv == "oblique"
        elsif d.prop == "src" is
            let cands: [string] = cssval::split_commas(v)
            let mut k: int = 0
            let mut best: string = ""
            while k < array_len(cands) is
                let c: string = string_trim(cands[k])
                k += 1
                let at: int = string_find(string_lower(c), "url(")
                if at >= 0 is
                    let e: int = paren_end(c, at + 3)
                    let mut u: string = string_trim(string_slice(c, at + 4, e))
                    if string_starts_with(u, "\"") || string_starts_with(u, "'") is u = string_slice(u, 1, string_len(u) - 1) end
                    if best == "" || font_src_score(u) > font_src_score(best) is best = u end
                end
            end
            ff.src = best
        end
    end
    return ff
end

fn stop_pct(tok: string) -> int is
    let t: string = string_lower(string_trim(tok))
    if t == "from" is return 0 end
    if t == "to" is return 100 end
    if string_ends_with(t, "%") is return conv::float_to_int(conv::str_to_float(string_slice(t, 0, string_len(t) - 1))) end
    return -1
end

fn parse_keyframes_body(name: string, body: string) -> Keyframes is
    let mut stops: [KfStop] = []
    let n: int = string_len(body)
    let mut p: int = 0
    while p < n is
        let open: int = find_char(body, "{", p)
        if open < 0 is break end
        let close: int = matching_brace(body, open)
        if close < 0 is break end
        let sels: [string] = cssval::split_commas(string_trim(string_slice(body, p, open)))
        let decls: [CssDecl] = parse_decls(string_slice(body, open + 1, close))
        let mut k: int = 0
        while k < array_len(sels) is
            let pc: int = stop_pct(sels[k])
            k += 1
            if pc >= 0 is stops = array_push(stops, KfStop { pct: pc, decls: decls }) end
        end
        p = close + 1
    end
    ;; sortowanie przystanków rosnąco (stabilne, insertion sort)
    let mut sorted: [KfStop] = []
    let mut i: int = 0
    while i < array_len(stops) is
        let cur: KfStop = stops[i]
        i += 1
        let mut pos: int = array_len(sorted)
        let mut j: int = 0
        while j < array_len(sorted) is
            if sorted[j].pct > cur.pct && pos == array_len(sorted) is pos = j end
            j += 1
        end
        let mut out: [KfStop] = []
        let mut m: int = 0
        while m < array_len(sorted) is
            if m == pos is out = array_push(out, cur) end
            out = array_push(out, sorted[m])
            m += 1
        end
        if pos == array_len(sorted) is out = array_push(out, cur) end
        sorted = out
    end
    return Keyframes { name: string_lower(string_trim(name)), stops: sorted }
end

pub fn parse(css: string) -> Stylesheet is
    let clean: string = strip_comments(css)
    let lorder: string = scan_layers(clean, "", "")
    let rules: [CssRule] = parse_into(clean, "", "", "", lorder, [])
    let mut imports: [string] = []
    let imp: [string] = scan_at(clean, "import", [])
    let mut i: int = 0
    while i < array_len(imp) is
        let parts: [string] = string_split(imp[i], "\u0002")
        let e: string = import_entry(parts[0])
        i += 1
        if e != "" is imports = array_push(imports, e) end
    end
    let mut fonts: [FontFace] = []
    let faces: [string] = scan_at(clean, "font-face", [])
    i = 0
    while i < array_len(faces) is
        let parts: [string] = string_split(faces[i], "\u0002")
        i += 1
        let ff: FontFace = parse_font_face(if array_len(parts) >= 2 then parts[1] else "")
        if ff.family != "" && ff.src != "" is fonts = array_push(fonts, ff) end
    end
    let mut kfs: [Keyframes] = []
    let mut names: [string] = ["keyframes", "-webkit-keyframes"]
    let mut ni: int = 0
    while ni < array_len(names) is
        let blocks: [string] = scan_at(clean, names[ni], [])
        ni += 1
        let mut b: int = 0
        while b < array_len(blocks) is
            let parts: [string] = string_split(blocks[b], "\u0002")
            b += 1
            if array_len(parts) >= 2 && string_trim(parts[0]) != "" is
                kfs = array_push(kfs, parse_keyframes_body(strip_quotes_css(parts[0]), parts[1]))
            end
        end
    end
    return Stylesheet { rules: rules, imports: imports, fonts: fonts, keyframes: kfs }
end

fn strip_quotes_css(v: string) -> string is
    let t: string = string_trim(v)
    if string_len(t) >= 2 && (string_starts_with(t, "\"") || string_starts_with(t, "'")) is
        return string_slice(t, 1, string_len(t) - 1)
    end
    return t
end

pub fn find_keyframes(sheet: Stylesheet, name: string) -> int is
    let want: string = string_lower(string_trim(name))
    let mut found: int = -1
    let mut i: int = 0
    while i < array_len(sheet.keyframes) is
        if sheet.keyframes[i].name == want is found = i end
        i += 1
    end
    return found
end

;; Łączy dwa arkusze (b ma wyższy priorytet przy remisie); przenumerowuje kolejność.
pub fn concat(a: Stylesheet, b: Stylesheet) -> Stylesheet is
    let mut rules: [CssRule] = []
    let mut i: int = 0
    while i < array_len(a.rules) is
        let mut r: CssRule = a.rules[i]
        r.order = array_len(rules)
        rules = array_push(rules, r)
        i += 1
    end
    i = 0
    while i < array_len(b.rules) is
        let mut r: CssRule = b.rules[i]
        r.order = array_len(rules)
        rules = array_push(rules, r)
        i += 1
    end
    let mut imports: [string] = a.imports
    i = 0
    while i < array_len(b.imports) is
        imports = array_push(imports, b.imports[i])
        i += 1
    end
    let mut fonts: [FontFace] = a.fonts
    i = 0
    while i < array_len(b.fonts) is
        fonts = array_push(fonts, b.fonts[i])
        i += 1
    end
    let mut kfs: [Keyframes] = a.keyframes
    i = 0
    while i < array_len(b.keyframes) is
        kfs = array_push(kfs, b.keyframes[i])
        i += 1
    end
    return Stylesheet { rules: rules, imports: imports, fonts: fonts, keyframes: kfs }
end

;; ---------- @media ----------
fn media_len(val: string, ix: InteractionState) -> int is
    let env: cssval::LenEnv = cssval::LenEnv { em: 16, rem: 16, vw: ix.viewport_w, vh: ix.viewport_h }
    return cssval::parse_len(val, env).px
end

;; Wartość cechy (width/height/aspect-ratio/resolution) w tysięcznych lub px.
fn media_metric(name: string, ix: InteractionState) -> int is
    if name == "width" || name == "device-width" is return ix.viewport_w end
    if name == "height" || name == "device-height" is return ix.viewport_h end
    if name == "aspect-ratio" || name == "device-aspect-ratio" is
        if ix.viewport_h <= 0 is return 0 end
        return ix.viewport_w * 1000 / ix.viewport_h
    end
    if name == "resolution" is return 1000 end
    return -1
end

fn media_operand(name: string, tok: string, ix: InteractionState) -> int is
    let t: string = string_trim(tok)
    if name == "aspect-ratio" || name == "device-aspect-ratio" is
        let parts: [string] = string_split(t, "/")
        let a: f64 = conv::str_to_float(string_trim(parts[0]))
        let b: f64 = if array_len(parts) >= 2 then conv::str_to_float(string_trim(parts[1])) else 1.0
        if b <= 0.0 is return 0 end
        return conv::float_to_int(a / b * 1000.0)
    end
    if name == "resolution" is
        if string_ends_with(t, "dppx") || string_ends_with(t, "x") is
            let num: string = if string_ends_with(t, "dppx") then string_slice(t, 0, string_len(t) - 4) else string_slice(t, 0, string_len(t) - 1)
            return conv::float_to_int(conv::str_to_float(num) * 1000.0)
        end
        if string_ends_with(t, "dpi") is return conv::float_to_int(conv::str_to_float(string_slice(t, 0, string_len(t) - 3)) / 96.0 * 1000.0) end
        return 1000
    end
    return media_len(t, ix)
end

fn cmp_ok(a: int, op: string, b: int) -> bool is
    if op == ">=" is return a >= b end
    if op == "<=" is return a <= b end
    if op == ">" is return a > b end
    if op == "<" is return a < b end
    if op == "=" is return a == b end
    return false
end

fn flip_op(op: string) -> string is
    if op == ">=" is return "<=" end
    if op == "<=" is return ">=" end
    if op == ">" is return "<" end
    if op == "<" is return ">" end
    return op
end

fn is_cmp_tok(t: string) -> bool is
    return t == ">=" || t == "<=" || t == ">" || t == "<" || t == "="
end

;; Tokenizer zakresów: "width >= 600px" -> ["width", ">=", "600px"]
fn range_tokens(inner: string) -> [string] is
    let n: int = string_len(inner)
    let mut out: [string] = []
    let mut cur: string = ""
    let mut i: int = 0
    while i < n is
        let c: string = string_at(inner, i)
        if c == ">" || c == "<" is
            if cur != "" is out = array_push(out, cur) end
            cur = ""
            let two: bool = i + 1 < n && string_at(inner, i + 1) == "="
            out = array_push(out, if two then c + "=" else c)
            i += if two then 2 else 1
            continue
        end
        if c == "=" is
            if cur != "" is out = array_push(out, cur) end
            cur = ""
            out = array_push(out, "=")
        elsif is_ws(c) is
            if cur != "" is out = array_push(out, cur) end
            cur = ""
        else is
            cur = cur + c
        end
        i += 1
    end
    if cur != "" is out = array_push(out, cur) end
    return out
end

;; Składnia zakresów: (width >= 600px), (400px <= width <= 800px), (600px < width).
fn media_range(inner: string, ix: InteractionState) -> bool is
    let toks: [string] = range_tokens(inner)
    let n: int = array_len(toks)
    if n == 3 is
        if is_cmp_tok(toks[1]) is
            let a: string = toks[0]
            let b: string = toks[2]
            let a_is_name: bool = media_metric(a, ix) >= 0
            if a_is_name is
                return cmp_ok(media_metric(a, ix), toks[1], media_operand(a, b, ix))
            end
            return cmp_ok(media_metric(b, ix), flip_op(toks[1]), media_operand(b, a, ix))
        end
    end
    if n == 5 is
        let name: string = toks[2]
        let cur: int = media_metric(name, ix)
        if cur < 0 is return false end
        let left_ok: bool = cmp_ok(media_operand(name, toks[0], ix), toks[1], cur)
        let right_ok: bool = cmp_ok(cur, toks[3], media_operand(name, toks[4], ix))
        return left_ok && right_ok
    end
    return false
end

fn media_feature(feat: string, ix: InteractionState) -> bool is
    let inner: string = string_trim(string_replace(string_replace(feat, "(", ""), ")", ""))
    let colon: int = string_find(inner, ":")
    if colon < 0 is
        if string_find(inner, ">") >= 0 || string_find(inner, "<") >= 0 || string_find(inner, "=") >= 0 is
            return media_range(inner, ix)
        end
        return inner == "color" || inner == "hover" || inner == "any-hover" || inner == "pointer" || inner == "any-pointer" ||
               inner == "width" || inner == "height" || inner == "grid"
    end
    let name: string = string_trim(string_slice(inner, 0, colon))
    let val: string = string_trim(string_slice(inner, colon + 1, string_len(inner)))
    if name == "min-width" is return ix.viewport_w >= media_len(val, ix) end
    if name == "max-width" is return ix.viewport_w <= media_len(val, ix) end
    if name == "min-height" is return ix.viewport_h >= media_len(val, ix) end
    if name == "max-height" is return ix.viewport_h <= media_len(val, ix) end
    if name == "width" is return ix.viewport_w == media_len(val, ix) end
    if name == "height" is return ix.viewport_h == media_len(val, ix) end
    if name == "min-aspect-ratio" is return media_metric("aspect-ratio", ix) >= media_operand("aspect-ratio", val, ix) end
    if name == "max-aspect-ratio" is return media_metric("aspect-ratio", ix) <= media_operand("aspect-ratio", val, ix) end
    if name == "aspect-ratio" is return media_metric("aspect-ratio", ix) == media_operand("aspect-ratio", val, ix) end
    if name == "min-resolution" is return 1000 >= media_operand("resolution", val, ix) end
    if name == "max-resolution" is return 1000 <= media_operand("resolution", val, ix) end
    if name == "resolution" is return 1000 == media_operand("resolution", val, ix) end
    if name == "prefers-color-scheme" is
        return if ix.dark then val == "dark" else val == "light"
    end
    if name == "orientation" is
        return if ix.viewport_w >= ix.viewport_h then val == "landscape" else val == "portrait"
    end
    if name == "prefers-reduced-motion" is return val == "no-preference" end
    if name == "prefers-contrast" is return val == "no-preference" end
    if name == "prefers-reduced-transparency" is return val == "no-preference" end
    if name == "forced-colors" is return val == "none" end
    if name == "display-mode" is return val == "standalone" || val == "browser" end
    if name == "update" is return val == "fast" end
    if name == "hover" || name == "any-hover" is return val == "hover" end
    if name == "pointer" || name == "any-pointer" is return val == "fine" end
    if name == "color" || name == "min-color" is return true end
    if name == "scripting" is return val == "enabled" end
    return false
end

;; Wyrażenie: (a) and (b), (a) or (b), not (a), zagnieżdżone nawiasy.
fn media_expr(expr: string, ix: InteractionState) -> bool is
    let toks: [string] = cssval::split_top(string_trim(expr))
    let n: int = array_len(toks)
    if n == 0 is return true end
    ;; or: dowolny człon prawdziwy
    let mut has_or: bool = false
    let mut i: int = 0
    while i < n is
        if string_lower(toks[i]) == "or" is has_or = true end
        i += 1
    end
    if has_or is
        let mut cur: string = ""
        let mut result: bool = false
        i = 0
        while i < n is
            let t: string = toks[i]
            i += 1
            if string_lower(t) == "or" is
                if media_expr(cur, ix) is result = true end
                cur = ""
            else is
                cur = if cur == "" then t else cur + " " + t
            end
        end
        if cur != "" && media_expr(cur, ix) is result = true end
        return result
    end
    ;; and: wszystkie człony prawdziwe; `not` neguje następny człon
    let mut ok: bool = true
    let mut negate: bool = false
    i = 0
    while i < n is
        let t: string = toks[i]
        let tl: string = string_lower(t)
        i += 1
        if tl == "and" || tl == "only" is
            continue
        end
        if tl == "not" is
            negate = true
            continue
        end
        let mut v: bool = true
        if tl == "print" || tl == "speech" || tl == "tty" || tl == "projection" is
            v = false
        elsif string_starts_with(t, "(") is
            let inner: string = string_trim(string_slice(t, 1, string_len(t) - 1))
            if string_starts_with(inner, "(") || string_starts_with(string_lower(inner), "not ") is
                v = media_expr(inner, ix)
            else is
                v = media_feature(t, ix)
            end
        end
        if negate is
            v = !v
            negate = false
        end
        if !v is ok = false end
    end
    return ok
end

pub fn media_matches(cond: string, ix: InteractionState) -> bool is
    if string_trim(cond) == "" is return true end
    let alts: [string] = cssval::split_commas(string_lower(cond))
    let mut a: int = 0
    while a < array_len(alts) is
        if media_expr(alts[a], ix) is return true end
        a += 1
    end
    return false
end

;; ---------- nth ----------
pub struct NthExpr is
    pub a: int
    pub b: int
end

fn clean_int_part(s: string) -> string is
    let t: string = string_trim(s)
    if string_starts_with(t, "+") is return string_slice(t, 1, string_len(t)) end
    return t
end

pub fn parse_nth_expr(raw: string) -> NthExpr is
    let arg: string = string_lower(string_trim(raw))
    if arg == "odd" is return NthExpr { a: 2, b: 1 } end
    if arg == "even" is return NthExpr { a: 2, b: 0 } end
    let n_pos: int = string_find(arg, "n")
    if n_pos < 0 is
        return NthExpr { a: 0, b: str_to_int(clean_int_part(arg)) }
    end
    let a_part: string = string_trim(string_slice(arg, 0, n_pos))
    let mut a: int = 1
    if a_part == "-" is
        a = -1
    elsif a_part == "" || a_part == "+" is
        a = 1
    else is
        a = str_to_int(clean_int_part(a_part))
    end
    let b_part: string = string_replace(string_slice(arg, n_pos + 1, string_len(arg)), " ", "")
    let mut b: int = 0
    if b_part != "" is b = str_to_int(clean_int_part(b_part)) end
    return NthExpr { a: a, b: b }
end

pub fn nth_matches(expr: NthExpr, index: int) -> bool is
    if expr.a == 0 is return index == expr.b end
    let diff: int = index - expr.b
    if diff % expr.a != 0 is return false end
    return diff / expr.a >= 0
end

;; ---------- drzewo ----------
fn is_live_element(d: dom::Dom, id: int) -> bool is
    let n: dom::DomNode = d.nodes[id]
    return n.tag != "text" && !n.removed
end

;; numer (od 1) wśród rodzeństwa-elementów; `same_type` = liczy tylko ten sam tag
fn sibling_index(d: dom::Dom, node_id: int, same_type: bool) -> int is
    let parent: int = d.nodes[node_id].parent
    if parent < 0 is return 1 end
    let kids: [int] = d.nodes[parent].children
    let tag: string = d.nodes[node_id].tag
    let mut idx: int = 0
    let mut i: int = 0
    while i < array_len(kids) is
        if is_live_element(d, kids[i]) && (!same_type || d.nodes[kids[i]].tag == tag) is
            idx += 1
            if kids[i] == node_id is return idx end
        end
        i += 1
    end
    return -1
end

fn sibling_count(d: dom::Dom, node_id: int, same_type: bool) -> int is
    let parent: int = d.nodes[node_id].parent
    if parent < 0 is return 1 end
    let kids: [int] = d.nodes[parent].children
    let tag: string = d.nodes[node_id].tag
    let mut c: int = 0
    let mut i: int = 0
    while i < array_len(kids) is
        if is_live_element(d, kids[i]) && (!same_type || d.nodes[kids[i]].tag == tag) is c += 1 end
        i += 1
    end
    return c
end

fn is_self_or_ancestor(d: dom::Dom, target: int, node_id: int) -> bool is
    let mut cur: int = node_id
    while cur >= 0 is
        if cur == target is return true end
        cur = d.nodes[cur].parent
    end
    return false
end

fn prev_element_sibling(d: dom::Dom, node_id: int) -> int is
    let parent: int = d.nodes[node_id].parent
    if parent < 0 is return -1 end
    let kids: [int] = d.nodes[parent].children
    let mut prev: int = -1
    let mut i: int = 0
    while i < array_len(kids) is
        if kids[i] == node_id is return prev end
        if is_live_element(d, kids[i]) is prev = kids[i] end
        i += 1
    end
    return -1
end

fn attr_matches(d: dom::Dom, node_id: int, a: AttrSel) -> bool is
    let node: dom::DomNode = d.nodes[node_id]
    if !dom::has_attr(node, a.name) is return false end
    if a.op == "" is return true end
    let v: string = dom::get_attr(node, a.name)
    if a.op == "=" is return v == a.val end
    if a.op == "^=" is return a.val != "" && string_starts_with(v, a.val) end
    if a.op == "$=" is return a.val != "" && string_ends_with(v, a.val) end
    if a.op == "*=" is return a.val != "" && string_find(v, a.val) >= 0 end
    if a.op == "|=" is return v == a.val || string_starts_with(v, a.val + "-") end
    if a.op == "~=" is
        let words: [string] = string_split(v, " ")
        let mut i: int = 0
        while i < array_len(words) is
            if words[i] == a.val is return true end
            i += 1
        end
        return false
    end
    return false
end

fn pseudo_matches(d: dom::Dom, node_id: int, ps: string, ix: InteractionState) -> bool is
    let n: dom::DomNode = d.nodes[node_id]
    if ps == "hover" is return ix.hovered_id >= 0 && is_self_or_ancestor(d, node_id, ix.hovered_id) end
    if ps == "active" is return ix.active_id >= 0 && is_self_or_ancestor(d, node_id, ix.active_id) end
    if ps == "focus" is
        return (ix.focused_node >= 0 && ix.focused_node == node_id) || (n.attr_id != "" && n.attr_id == ix.focused_id)
    end
    if ps == "focus-within" is
        let mut f: int = ix.focused_node
        if f < 0 && ix.focused_id != "" is f = dom::find_by_id(d, ix.focused_id) end
        return f >= 0 && is_self_or_ancestor(d, node_id, f)
    end
    if ps == "first-child" is return sibling_index(d, node_id, false) == 1 end
    if ps == "last-child" is return sibling_index(d, node_id, false) == sibling_count(d, node_id, false) end
    if ps == "only-child" is return sibling_count(d, node_id, false) == 1 end
    if ps == "first-of-type" is return sibling_index(d, node_id, true) == 1 end
    if ps == "last-of-type" is return sibling_index(d, node_id, true) == sibling_count(d, node_id, true) end
    if ps == "empty" is return array_len(n.children) == 0 end
    if ps == "root" is return n.parent == 0 && n.tag == "html" || node_id == 0 end
    if ps == "disabled" is return n.disabled end
    if ps == "enabled" is return !n.disabled && (n.tag == "input" || n.tag == "button" || n.tag == "select" || n.tag == "textarea") end
    if ps == "checked" is return n.checked end
    if ps == "link" || ps == "any-link" is return n.tag == "a" && n.attr_href != "" end
    if ps == "read-only" is return n.readonly || n.tag != "input" && n.tag != "textarea" end
    if ps == "placeholder-shown" is return n.attr_placeholder != "" && n.attr_value == "" end
    if string_starts_with(ps, "nth-child(") is
        let parts: [string] = split_of(string_slice(ps, 10, string_len(ps) - 1))
        let expr: NthExpr = parse_nth_expr(parts[0])
        if parts[1] != "" is
            let idx2: int = sibling_index_of(d, node_id, parts[1], ix, false)
            return idx2 > 0 && nth_matches(expr, idx2)
        end
        let idx: int = sibling_index(d, node_id, false)
        return idx > 0 && nth_matches(expr, idx)
    end
    if string_starts_with(ps, "nth-last-child(") is
        let parts: [string] = split_of(string_slice(ps, 15, string_len(ps) - 1))
        let expr: NthExpr = parse_nth_expr(parts[0])
        if parts[1] != "" is
            let idx2: int = sibling_index_of(d, node_id, parts[1], ix, true)
            return idx2 > 0 && nth_matches(expr, idx2)
        end
        let idx: int = sibling_index(d, node_id, false)
        return idx > 0 && nth_matches(expr, sibling_count(d, node_id, false) - idx + 1)
    end
    if string_starts_with(ps, "nth-of-type(") is
        let expr: NthExpr = parse_nth_expr(string_slice(ps, 12, string_len(ps) - 1))
        let idx: int = sibling_index(d, node_id, true)
        return idx > 0 && nth_matches(expr, idx)
    end
    if string_starts_with(ps, "nth-last-of-type(") is
        let expr: NthExpr = parse_nth_expr(string_slice(ps, 17, string_len(ps) - 1))
        let idx: int = sibling_index(d, node_id, true)
        return idx > 0 && nth_matches(expr, sibling_count(d, node_id, true) - idx + 1)
    end
    if string_starts_with(ps, "has(") is return has_matches(d, node_id, string_slice(ps, 4, string_len(ps) - 1), ix) end
    if string_starts_with(ps, "lang(") is
        let want: string = string_lower(string_trim(string_slice(ps, 5, string_len(ps) - 1)))
        let have: string = lang_of(d, node_id)
        return have != "" && (have == want || string_starts_with(have, want + "-"))
    end
    if string_starts_with(ps, "dir(") is
        return string_trim(string_slice(ps, 4, string_len(ps) - 1)) == "ltr"
    end
    if ps == "only-of-type" is return sibling_count(d, node_id, true) == 1 end
    if ps == "focus-visible" is
        return (ix.focused_node >= 0 && ix.focused_node == node_id) || (n.attr_id != "" && n.attr_id == ix.focused_id)
    end
    if ps == "read-write" is
        return (n.tag == "input" || n.tag == "textarea") && !n.readonly && !n.disabled
    end
    if ps == "required" is return dom::has_attr(n, "required") end
    if ps == "optional" is
        return (n.tag == "input" || n.tag == "select" || n.tag == "textarea") && !dom::has_attr(n, "required")
    end
    if ps == "default" is return n.checked || (n.tag == "option" && dom::has_attr(n, "selected")) end
    if ps == "indeterminate" is return dom::has_attr(n, "indeterminate") end
    if ps == "valid" is return !(dom::has_attr(n, "required") && n.attr_value == "") end
    if ps == "invalid" is return dom::has_attr(n, "required") && n.attr_value == "" end
    if ps == "scope" is return node_id == 0 || (n.tag == "html" && n.parent == 0) end
    if ps == "defined" is return true end
    if ps == "any-link" is return n.tag == "a" && n.attr_href != "" end
    if ps == "visited" || ps == "target" || ps == "fullscreen" || ps == "paused" || ps == "playing" is return false end
    return false
end

fn list_matches(d: dom::Dom, node_id: int, list: string, ix: InteractionState) -> bool is
    let items: [string] = cssval::split_commas(list)
    let mut i: int = 0
    while i < array_len(items) is
        let sel: string = string_trim(items[i])
        i += 1
        if sel == "" is continue end
        let rule: CssRule = compile_rule(sel, [], "", 0)
        if array_len(rule.comps) > 0 && path_matches_from(d, node_id, rule.comps, rule.combs, array_len(rule.comps) - 1, ix) is
            return true
        end
    end
    return false
end

;; Czy element-potomek/rodzeństwo `cand` pasuje do selektora względnego z :has().
fn has_candidate_matches(d: dom::Dom, cand: int, sel: string, ix: InteractionState) -> bool is
    return is_live_element(d, cand) && list_matches(d, cand, sel, ix)
end

fn has_descendant_matching(d: dom::Dom, node_id: int, sel: string, ix: InteractionState, depth: int) -> bool is
    if depth > 60 is return false end
    let kids: [int] = d.nodes[node_id].children
    let mut i: int = 0
    while i < array_len(kids) is
        let k: int = kids[i]
        i += 1
        if is_live_element(d, k) is
            if has_candidate_matches(d, k, sel, ix) is return true end
            if has_descendant_matching(d, k, sel, ix, depth + 1) is return true end
        end
    end
    return false
end

;; :has(<selektor względny>) — `> a`, `+ a`, `~ a` albo potomek.
fn has_matches(d: dom::Dom, node_id: int, arg: string, ix: InteractionState) -> bool is
    let alts: [string] = cssval::split_commas(arg)
    let mut a: int = 0
    while a < array_len(alts) is
        let rel: string = string_trim(alts[a])
        a += 1
        if rel == "" is continue end
        let first: string = string_slice(rel, 0, 1)
        if first == ">" is
            let sel: string = string_trim(string_slice(rel, 1, string_len(rel)))
            let kids: [int] = d.nodes[node_id].children
            let mut i: int = 0
            while i < array_len(kids) is
                if has_candidate_matches(d, kids[i], sel, ix) is return true end
                i += 1
            end
        elsif first == "+" is
            let sel: string = string_trim(string_slice(rel, 1, string_len(rel)))
            let nx: int = next_element_sibling(d, node_id)
            if nx >= 0 && has_candidate_matches(d, nx, sel, ix) is return true end
        elsif first == "~" is
            let sel: string = string_trim(string_slice(rel, 1, string_len(rel)))
            let mut nx: int = next_element_sibling(d, node_id)
            while nx >= 0 is
                if has_candidate_matches(d, nx, sel, ix) is return true end
                nx = next_element_sibling(d, nx)
            end
        else is
            if has_descendant_matching(d, node_id, rel, ix, 0) is return true end
        end
    end
    return false
end

fn next_element_sibling(d: dom::Dom, node_id: int) -> int is
    let parent: int = d.nodes[node_id].parent
    if parent < 0 is return -1 end
    let kids: [int] = d.nodes[parent].children
    let mut seen: bool = false
    let mut i: int = 0
    while i < array_len(kids) is
        if seen && is_live_element(d, kids[i]) is return kids[i] end
        if kids[i] == node_id is seen = true end
        i += 1
    end
    return -1
end

;; Indeks wśród rodzeństwa pasującego do `of S` (od 1); -1 gdy sam węzeł nie pasuje.
fn sibling_index_of(d: dom::Dom, node_id: int, sel: string, ix: InteractionState, from_end: bool) -> int is
    let parent: int = d.nodes[node_id].parent
    if parent < 0 is return 1 end
    if !list_matches(d, node_id, sel, ix) is return -1 end
    let kids: [int] = d.nodes[parent].children
    let mut idx: int = 0
    let mut total: int = 0
    let mut mine: int = 0
    let mut i: int = 0
    while i < array_len(kids) is
        let k: int = kids[i]
        i += 1
        if is_live_element(d, k) && list_matches(d, k, sel, ix) is
            total += 1
            if k == node_id is mine = total end
        end
    end
    if from_end is return total - mine + 1 end
    return mine
end

;; "2n+1 of .a, .b" -> [wyrażenie, selektor]
fn split_of(arg: string) -> [string] is
    let low: string = string_lower(arg)
    let at: int = string_find(low, " of ")
    if at < 0 is return [arg, ""] end
    return [string_trim(string_slice(arg, 0, at)), string_trim(string_slice(arg, at + 4, string_len(arg)))]
end

fn lang_of(d: dom::Dom, node_id: int) -> string is
    let mut cur: int = node_id
    while cur >= 0 is
        let l: string = dom::get_attr(d.nodes[cur], "lang")
        if l != "" is return string_lower(l) end
        cur = d.nodes[cur].parent
    end
    return ""
end

pub fn compound_matches_node(d: dom::Dom, node_id: int, c: Compound, ix: InteractionState) -> bool is
    let n: dom::DomNode = d.nodes[node_id]
    if c.tag != "" && c.tag != n.tag is return false end
    if c.id != "" && c.id != n.attr_id is return false end
    let mut i: int = 0
    while i < array_len(c.classes) is
        if !dom::has_class(n, c.classes[i]) is return false end
        i += 1
    end
    i = 0
    while i < array_len(c.attrs) is
        if !attr_matches(d, node_id, c.attrs[i]) is return false end
        i += 1
    end
    i = 0
    while i < array_len(c.pseudos) is
        if !pseudo_matches(d, node_id, c.pseudos[i], ix) is return false end
        i += 1
    end
    i = 0
    while i < array_len(c.nots) is
        if list_matches(d, node_id, c.nots[i], ix) is return false end
        i += 1
    end
    i = 0
    while i < array_len(c.iss) is
        if !list_matches(d, node_id, c.iss[i], ix) is return false end
        i += 1
    end
    return true
end

;; Dopasowanie od prawej do lewej z nawracaniem (comps[idx] do node_id).
fn path_matches_from(d: dom::Dom, node_id: int, comps: [Compound], combs: [string], idx: int, ix: InteractionState) -> bool is
    if !compound_matches_node(d, node_id, comps[idx], ix) is return false end
    if idx == 0 is return true end
    let comb: string = combs[idx]
    if comb == "child" is
        let p: int = d.nodes[node_id].parent
        if p < 0 is return false end
        return path_matches_from(d, p, comps, combs, idx - 1, ix)
    end
    if comb == "adjacent" is
        let prev: int = prev_element_sibling(d, node_id)
        if prev < 0 is return false end
        return path_matches_from(d, prev, comps, combs, idx - 1, ix)
    end
    if comb == "general_sibling" is
        let mut prev: int = prev_element_sibling(d, node_id)
        while prev >= 0 is
            if path_matches_from(d, prev, comps, combs, idx - 1, ix) is return true end
            prev = prev_element_sibling(d, prev)
        end
        return false
    end
    let mut p: int = d.nodes[node_id].parent
    while p >= 0 is
        if path_matches_from(d, p, comps, combs, idx - 1, ix) is return true end
        p = d.nodes[p].parent
    end
    return false
end

pub fn rule_matches(d: dom::Dom, node_id: int, rule: CssRule, ix: InteractionState) -> bool is
    let n: int = array_len(rule.comps)
    if n == 0 is return false end
    return path_matches_from(d, node_id, rule.comps, rule.combs, n - 1, ix)
end

;; ---------- kaskada ----------
fn insert_sorted(decls: [CssDecl], keys: [int], d: CssDecl, key: int) -> [CssDecl] is
    ;; wstawia `d` po ostatnim elemencie o kluczu <= key (stabilnie)
    let mut out: [CssDecl] = []
    let mut placed: bool = false
    let mut i: int = 0
    while i < array_len(decls) is
        if !placed && keys[i] > key is
            out = array_push(out, d)
            placed = true
        end
        out = array_push(out, decls[i])
        i += 1
    end
    if !placed is out = array_push(out, d) end
    return out
end

fn insert_key(keys: [int], key: int) -> [int] is
    let mut out: [int] = []
    let mut placed: bool = false
    let mut i: int = 0
    while i < array_len(keys) is
        if !placed && keys[i] > key is
            out = array_push(out, key)
            placed = true
        end
        out = array_push(out, keys[i])
        i += 1
    end
    if !placed is out = array_push(out, key) end
    return out
end

;; Deklaracje pasujące do węzła, posortowane rosnąco wg (important, specyficzność,
;; kolejność) — kolejne nadpisują poprzednie. Węzły pseudo (before/after) dopasowują
;; reguły z ::before/::after do swojego rodzica. `inline_style` dodawany na końcu.

;; ---------- @container ----------
;; Warunek "[nazwa] (min-width: 400px)" → [nazwa, wyrażenie].
fn cq_split(cond: string) -> [string] is
    let c: string = string_trim(cond)
    if string_starts_with(c, "(") || string_starts_with(c, "not ") || string_starts_with(c, "style(") is return ["", c] end
    let sp: int = string_find(c, " ")
    if sp < 0 is return ["", c] end
    return [string_slice(c, 0, sp), string_trim(string_slice(c, sp + 1, string_len(c)))]
end

fn cq_find_container(d: dom::Dom, start: int, name: string, ix: InteractionState) -> int is
    let mut cur: int = start
    let mut guard: int = 0
    while cur > 0 && guard < 256 is
        guard += 1
        if cur < array_len(ix.cq_w) && ix.cq_w[cur] >= 0 is
            if name == "" is return cur end
            if string_find(" " + ix.cq_names[cur] + " ", " " + name + " ") >= 0 is return cur end
        end
        cur = d.nodes[cur].parent
    end
    return -1
end

;; Wszystkie warunki `cqs` (rozdzielone \u0002) muszą być prawdziwe względem najbliższego pasującego kontenera
;; przodka `start` (z samym `start` włącznie — pseudo-elementy pytają kontener swojego właściciela).
pub fn cq_matches(cqs: string, d: dom::Dom, start: int, ix: InteractionState) -> bool is
    let conds: [string] = string_split(cqs, "\u0002")
    let mut i: int = 0
    while i < array_len(conds) is
        let parts: [string] = cq_split(conds[i])
        i += 1
        if string_starts_with(parts[1], "style(") is return false end
        let c: int = cq_find_container(d, start, parts[0], ix)
        if c < 0 is return false end
        let mut ix2: InteractionState = ix
        ix2.viewport_w = ix.cq_w[c]
        ix2.viewport_h = if ix.cq_h[c] >= 0 then ix.cq_h[c] else 0
        if !media_matches(parts[1], ix2) is return false end
    end
    return true
end

pub fn sheet_has_cq(sheet: Stylesheet) -> bool is
    let mut i: int = 0
    while i < array_len(sheet.rules) is
        if sheet.rules[i].cq != "" is return true end
        i += 1
    end
    return false
end

pub fn matching_decls_ctx(sheet: Stylesheet, d: dom::Dom, node_id: int, ix: InteractionState) -> [CssDecl] is
    ;; Przepisane bez insert_sorted/insert_key i bez `break` w pętli: w programie skompilowanym
    ;; poprzednia wersja zwracała tylko deklaracje PIERWSZEJ pasującej reguły (reszta ginęła przy
    ;; wstawianiu), przez co żaden styl poza pierwszą regułą nie działał. Semantyka bez zmian:
    ;; zwykłe deklaracje wg (specyficzność, kolejność), potem inline, potem !important (reguły, inline).
    let node: dom::DomNode = d.nodes[node_id]
    let target: int = if node.pseudo != "" then node.parent else node_id
    let want_pelem: string = node.pseudo
    let mut decls: [CssDecl] = []
    if target < 0 is return decls end

    ;; 1) reguły pasujące do węzła: indeks reguły + klucze kaskady
    ;;    (zwykłe: bez warstwy > późniejsza warstwa; !important: odwrotnie)
    let count: int = array_len(sheet.rules)
    let mut midx: [int] = []
    let mut mkey: [int] = []
    let mut ikey: [int] = []
    let big: int = 10000000000000
    let mut i: int = 0
    while i < count is
        let rule: CssRule = sheet.rules[i]
        let this_i: int = i
        i += 1
        let mut ok: bool = rule.pelem == want_pelem
        if ok && rule.media != "" && !media_matches(rule.media, ix) is ok = false end
        if ok && rule.cq != "" && !cq_matches(rule.cq, d, if want_pelem != "" then target else d.nodes[target].parent, ix) is ok = false end
        if ok && !rule_matches(d, target, rule, ix) is ok = false end
        if ok is
            midx = array_push(midx, this_i)
            let base_key: int = rule.spec * 100000 + rule.order
            let ln: int = if rule.layer == 0 then 999 else rule.layer
            let li: int = if rule.layer == 0 then 0 else 1000 - rule.layer
            mkey = array_push(mkey, ln * big + base_key)
            ikey = array_push(ikey, li * big + base_key)
        end
    end

    ;; 2) pozycja reguły w kaskadzie = liczba reguł o mniejszym kluczu (remis: wcześniejsza pierwsza)
    let m: int = array_len(midx)
    let mut rank_n: [int] = []
    let mut rank_i: [int] = []
    let mut k: int = 0
    while k < m is
        let mut rk: int = 0
        let mut rki: int = 0
        let mut q: int = 0
        while q < m is
            if mkey[q] < mkey[k] || (mkey[q] == mkey[k] && q < k) is rk += 1 end
            if ikey[q] < ikey[k] || (ikey[q] == ikey[k] && q < k) is rki += 1 end
            q += 1
        end
        rank_n = array_push(rank_n, rk)
        rank_i = array_push(rank_i, rki)
        k += 1
    end

    ;; 3) składanie: przebieg 0 = zwykłe deklaracje, przebieg 1 = !important
    let mut pass: int = 0
    while pass < 2 is
        let want_imp: bool = pass == 1
        let rank: [int] = if want_imp then rank_i else rank_n
        let mut r: int = 0
        while r < m is
            let mut p: int = 0
            while p < m is
                if rank[p] == r is
                    let rule2: CssRule = sheet.rules[midx[p]]
                    let mut j: int = 0
                    while j < array_len(rule2.decls) is
                        let dc: CssDecl = rule2.decls[j]
                        if (dc.important && want_imp) || (!dc.important && !want_imp) is
                            decls = array_push(decls, dc)
                        end
                        j += 1
                    end
                end
                p += 1
            end
            r += 1
        end
        if node.attr_style != "" && node.pseudo == "" is
            let inline: [CssDecl] = parse_decls(node.attr_style)
            let mut jj: int = 0
            while jj < array_len(inline) is
                let dc2: CssDecl = inline[jj]
                if (dc2.important && want_imp) || (!dc2.important && !want_imp) is
                    decls = array_push(decls, dc2)
                end
                jj += 1
            end
        end
        pass += 1
    end
    return decls
end

;; Wersja bez kontekstu drzewa (testy, proste zastosowania): dopasowuje po
;; tagu/id/klasach pierwszy segment złożony reguły.
pub fn selector_matches(selector: string, tag: string, id: string, classes: [string]) -> bool is
    let pc: ParsedCompound = parse_compound(selector)
    let c: Compound = pc.comp
    if c.tag != "" && c.tag != tag is return false end
    if c.id != "" && c.id != id is return false end
    let mut i: int = 0
    while i < array_len(c.classes) is
        let mut found: bool = false
        let mut j: int = 0
        while j < array_len(classes) is
            if classes[j] == c.classes[i] is found = true end
            j += 1
        end
        if !found is return false end
        i += 1
    end
    return true
end

pub fn matching_decls(sheet: Stylesheet, tag: string, id: string, classes: [string]) -> [CssDecl] is
    let mut d: dom::Dom = dom::empty()
    d = dom::new_node(d, -1, "root")
    d = dom::new_node(d, 0, tag)
    d.nodes[1].attr_id = id
    let mut cls: string = ""
    let mut i: int = 0
    while i < array_len(classes) is
        cls = if cls == "" then classes[i] else cls + " " + classes[i]
        i += 1
    end
    d.nodes[1].attr_class = cls
    return matching_decls_ctx(sheet, d, 1, no_interaction())
end

;; ---------- zapytania po selektorze ----------
pub fn node_matches_selector(d: dom::Dom, node_id: int, selector: string, ix: InteractionState) -> bool is
    let group: [string] = cssval::split_commas(selector)
    let mut g: int = 0
    while g < array_len(group) is
        let rule: CssRule = compile_rule(string_trim(group[g]), [], "", 0)
        g += 1
        if rule_matches(d, node_id, rule, ix) is return true end
    end
    return false
end

;; Wszystkie żywe elementy pasujące do selektora, w kolejności dokumentu.
pub fn query_all(d: dom::Dom, selector: string) -> [int] is
    let mut out: [int] = []
    let order: [int] = dom::document_order(d)
    let ix: InteractionState = no_interaction()
    let mut i: int = 0
    while i < array_len(order) is
        let id: int = order[i]
        i += 1
        if id == 0 || !is_live_element(d, id) is continue end
        if node_matches_selector(d, id, selector, ix) is out = array_push(out, id) end
    end
    return out
end

pub fn query_first(d: dom::Dom, selector: string) -> int is
    let all: [int] = query_all(d, selector)
    if array_len(all) == 0 is return -1 end
    return all[0]
end

;; Czy arkusz ma reguły z ::before/::after (app.h# generuje wtedy węzły treści).
pub fn has_pseudo_elements(sheet: Stylesheet) -> bool is
    let mut i: int = 0
    while i < array_len(sheet.rules) is
        if sheet.rules[i].pelem != "" is return true end
        i += 1
    end
    return false
end
