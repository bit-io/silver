end

pub struct Stylesheet is
    pub rules:     [CssRule]
    pub imports:   [string]      ;; @import: "url\u0001warunek-media" (jeszcze nierozwiązane)
    pub fonts:     [FontFace]
    pub keyframes: [Keyframes]
end

pub struct SelectorPath is
    pub sels:  [string]
    pub combs: [string]
end

