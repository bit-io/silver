    if outer == "" is return inner end
    if inner == "" is return outer end
    return outer + " and " + inner
end

;; ---------- @supports ----------
;; Lista właściwości, które silnik rozumie (do ewaluacji @supports).
fn supports_term(t: string) -> bool is
    let inner: string = string_trim(string_slice(t, 1, string_len(t) - 1))
    if string_starts_with(inner, "selector(") is return true end
    let colon: int = string_find(inner, ":")
    if colon < 0 is return false end
    let name: string = string_lower(string_trim(string_slice(inner, 0, colon)))
    if string_starts_with(name, "--") is return true end
    let bare: string = if string_starts_with(name, "-webkit-") then string_slice(name, 8, string_len(name)) elsif string_starts_with(name, "-moz-") then string_slice(name, 5, string_len(name)) elsif string_starts_with(name, "-ms-") then string_slice(name, 4, string_len(name)) else name
    let val: string = string_trim(string_slice(inner, colon + 1, string_len(inner)))
    if string_ends_with(string_lower(val), "!important") is val = string_trim(string_slice(val, 0, string_len(val) - 10)) end
    return props::known(bare) && props::valid(bare, val)
end

pub fn supports_matches(cond: string) -> bool is
    let toks: [string] = cssval::split_top(string_trim(cond))
    let mut result: bool = true
    let mut have: bool = false
    let mut op: string = "and"
    let mut negate: bool = false
    let mut i: int = 0
    while i < array_len(toks) is
        let t: string = string_trim(toks[i])
        i += 1
        let tl: string = string_lower(t)
        if tl == "not" is
            negate = true
        elsif tl == "and" || tl == "or" is
            op = tl
        elsif string_starts_with(t, "(") is
            let inner: string = string_trim(string_slice(t, 1, string_len(t) - 1))
            let mut v: bool = if string_starts_with(inner, "(") || string_starts_with(string_lower(inner), "not ") then supports_matches(inner) else supports_term(t)
            if negate is v = !v end
            negate = false
            if !have is
                result = v
                have = true
            elsif op == "or" is
                result = result || v
            else is
                result = result && v
            end
        elsif string_starts_with(tl, "selector(") is
            let v: bool = if negate then false else true
            negate = false
            if !have is
                result = v
                have = true
            end
        end
    end
    return result
end

;; ---------- @layer ----------
fn list_has_name(lst: string, name: string) -> bool is
    return string_find(lst, "\u0001" + name + "\u0001") >= 0
end

fn full_layer_name(outer: string, name: string) -> string is
    if outer == "" is return name end
    return outer + "." + name
end

;; Kolejność warstw wg pierwszego wystąpienia: "\u0001a\u0001b\u0001".
fn scan_layers(css: string, outer: string, acc0: string) -> string is
    let mut acc: string = acc0
    let n: int = string_len(css)
    let mut p: int = 0
    while p < n is
        while p < n && is_ws(string_at(css, p)) is p += 1 end
        if p >= n is break end
        if string_at(css, p) == "@" is
            let mut q: int = p + 1
            while q < n && is_ident_char(string_at(css, q)) is q += 1 end
            let name: string = string_lower(string_slice(css, p + 1, q))
            let brace: int = find_char(css, "{", q)
            let semi: int = find_char(css, ";", q)
            let block_first: bool = brace >= 0 && (semi < 0 || brace < semi)
            if !block_first is
                if name == "layer" is
                    let end_at: int = if semi < 0 then n else semi
                    let names: [string] = cssval::split_commas(string_slice(css, q, end_at))
                    let mut k: int = 0
                    while k < array_len(names) is
                        let nm: string = string_trim(names[k])
                        k += 1
                        if nm != "" is
                            let full: string = full_layer_name(outer, nm)
                            if !list_has_name(acc, full) is
                                acc = if acc == "" then "\u0001" + full + "\u0001" else acc + full + "\u0001"
                            end
                        end
                    end
                end
                p = if semi < 0 then n else semi + 1
                continue
            end
            let close: int = matching_brace(css, brace)
            if close < 0 is break end
            let prelude: string = string_trim(string_slice(css, q, brace))
            let inner: string = string_slice(css, brace + 1, close)
            if name == "layer" is
                let nm: string = string_trim(prelude)
                let full: string = if nm == "" then outer else full_layer_name(outer, nm)
                if nm != "" && !list_has_name(acc, full) is
                    acc = if acc == "" then "\u0001" + full + "\u0001" else acc + full + "\u0001"
                end
                acc = scan_layers(inner, full, acc)
            elsif name == "media" || name == "supports" || name == "container" is
                acc = scan_layers(inner, outer, acc)
            end
            p = close + 1
            continue
        end
        let open: int = find_char(css, "{", p)
        if open < 0 is break end
        let close: int = matching_brace(css, open)
        if close < 0 is break end
        p = close + 1
    end
    return acc
end

;; Numer warstwy (1..) wg kolejności; 0 gdy poza warstwą / nieznana.
fn layer_rank(lorder: string, name: string) -> int is
    if name == "" is return 0 end
    let at: int = string_find(lorder, "\u0001" + name + "\u0001")
    if at < 0 is return 0 end
    let before: string = string_slice(lorder, 0, at + 1)
    let parts: [string] = string_split(before, "\u0001")
    return array_len(parts) - 1
end

