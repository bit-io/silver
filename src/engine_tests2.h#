#[test]
fn t16_animation_trigger_state_machine_actions() is
    let dur: int = 1000
    let s0: [int] = anim::trig_initial()
    assert_eq(anim::trig_pos(s0, 500, dur), 0)
    ;; play-forwards: od 100 ms biegnie do przodu, zatrzymuje się na końcu
    let p: [int] = anim::trig_apply(s0, "play-forwards", 100, dur)
    assert_eq(anim::trig_pos(p, 400, dur), 300)
    assert_eq(anim::trig_pos(p, 5000, dur), 1000)
    ;; pause zatrzymuje na bieżącej pozycji
    let ps: [int] = anim::trig_apply(p, "pause", 400, dur)
    assert_eq(anim::trig_pos(ps, 9000, dur), 300)
    ;; play wznawia w tym samym kierunku
    let pl: [int] = anim::trig_apply(ps, "play", 1000, dur)
    assert_eq(anim::trig_pos(pl, 1200, dur), 500)
    ;; play-backwards z pozycji 0 startuje od końca i cofa
    let pb: [int] = anim::trig_apply(s0, "play-backwards", 0, dur)
    assert_eq(anim::trig_pos(pb, 0, dur), 1000)
    assert_eq(anim::trig_pos(pb, 250, dur), 750)
    assert_eq(anim::trig_pos(pb, 5000, dur), 0)
    ;; reset zeruje i zatrzymuje, replay startuje od początku
    let rs: [int] = anim::trig_apply(p, "reset", 600, dur)
    assert_eq(anim::trig_pos(rs, 9000, dur), 0)
    let rp: [int] = anim::trig_apply(p, "replay", 700, dur)
    assert_eq(anim::trig_pos(rp, 800, dur), 100)
    ;; play-once: pierwszy raz gra, po resecie... drugi raz (bez resetu) nie startuje ponownie
    let o1: [int] = anim::trig_apply(s0, "play-once", 0, dur)
    let o1p: [int] = anim::trig_apply(o1, "pause", 300, dur)
    let o2: [int] = anim::trig_apply(o1p, "play-once", 500, dur)
    assert_eq(anim::trig_pos(o2, 900, dur), 300)
    ;; none i nieznana akcja nic nie zmieniają
    assert_eq(anim::trig_pos(anim::trig_apply(p, "none", 500, dur), 700, dur), 600)
end

