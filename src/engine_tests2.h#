fn gr_count(boxes: [layout::LayoutBox], w: int, h: int) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "box" && (w < 0 || boxes[i].w == w) && (h < 0 || boxes[i].h == h) is n += 1 end
        i += 1
    end
    return n
end

fn gr_first(boxes: [layout::LayoutBox], w: int, h: int) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "box" && (w < 0 || boxes[i].w == w) && (h < 0 || boxes[i].h == h) is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

fn gr_grid(extra: string) -> [layout::LayoutBox] is
    return lay("<div class=\"g\"><div class=\"c\"></div><div class=\"c\"></div><div class=\"c\"></div><div class=\"c\"></div></div>", ".g { display: grid; grid-template-columns: 50px 50px; gap: 20px; } .c { height: 30px; } " + extra, 400)
end

