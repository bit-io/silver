fn marker_nodes(d: dom::Dom) -> [int] is
    let mut out: [int] = []
    let mut i: int = 0
    while i < array_len(d.nodes) is
        if !d.nodes[i].removed && d.nodes[i].attr_class == "scroll-marker" is out = array_push(out, i) end
        i += 1
    end
    return out
end

#[test]
fn t15_scroll_marker_group_generates_markers_for_targets_with_scroll_marker_content() is
    let html: string = "<div id=\"s\"><section id=\"a\" class=\"i\">AA</section><section id=\"b\" class=\"i\">BB</section><section id=\"c\">CC</section></div>"
    let base: string = "#s { overflow: auto; width: 200px; height: 100px; } .i::scroll-marker { content: \"*\"; color: #ff0000; } "
    let d: dom::Dom = dom::parse(html)
    let aft: dom::Dom = layout::gen_pseudo(d, css::parse(base + "#s { scroll-marker-group: after; }"), css::no_interaction())
    let mk: [int] = marker_nodes(aft)
    ;; znaczniki tylko dla elementów z regułą ::scroll-marker (a i b), href wskazuje cel, title — id węzła celu
    assert_eq(array_len(mk), 2)
    assert_eq(aft.nodes[mk[0]].attr_href, "#a")
    assert_eq(aft.nodes[mk[1]].attr_href, "#b")
    assert_eq(aft.nodes[mk[0]].attr_title, to_string(dom::find_by_id(d, "a")))
    assert_true(string_find(aft.nodes[mk[0]].attr_style, "color: #ff0000") >= 0)
    ;; kolejność: after = po treści, before = przed treścią
    let ba: [layout::LayoutBox] = layout::layout(d, css::parse(base + "#s { scroll-marker-group: after; }"), 400, -1)
    let bb: [layout::LayoutBox] = layout::layout(d, css::parse(base + "#s { scroll-marker-group: before; }"), 400, -1)
    assert_true(box_starting(ba, "*").y > box_with_text(ba, "CC").y)
    assert_true(box_starting(bb, "*").y < box_with_text(bb, "AA").y)
    ;; none albo brak własności — bez grupy
    let no: dom::Dom = layout::gen_pseudo(d, css::parse(base + "#s { scroll-marker-group: none; }"), css::no_interaction())
    assert_eq(array_len(marker_nodes(no)), 0)
    let nop: dom::Dom = layout::gen_pseudo(d, css::parse(base), css::no_interaction())
    assert_eq(array_len(marker_nodes(nop)), 0)
    ;; stylowanie samej grupy: ::scroll-marker-group { display: flex } układa znaczniki w jednym wierszu
    let fl: [layout::LayoutBox] = layout::layout(d, css::parse(base + "#s { scroll-marker-group: after; } #s::scroll-marker-group { display: flex; gap: 20px; }"), 400, -1)
    let mut xs: [int] = []
    let mut i: int = 0
    while i < array_len(fl) is
        if fl[i].kind == "text" && fl[i].text == "*" is xs = array_push(xs, fl[i].x) end
        i += 1
    end
    assert_eq(array_len(xs), 2)
    assert_true(xs[1] - xs[0] >= 20)
end

