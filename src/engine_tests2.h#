#[test]
fn t09_interpolate_size_allow_keywords_animates_height_to_and_from_auto() is
    let html: string = "<div id=\"a\" class=\"a\"><div style=\"height: 100px\"></div></div>"
    let d: dom::Dom = dom::parse(html)
    let id: int = dom::find_by_id(d, "a")
    let on: css::Stylesheet = css::parse(".a { margin: 0; transition: height 1s linear; interpolate-size: allow-keywords; }")
    let off: css::Stylesheet = css::parse(".a { margin: 0; transition: height 1s linear; }")
    ;; styl początkowy: wysokość 20px, docelowy: auto (naturalnie 100px)
    let target: style::ComputedStyle = style::resolve_ctx(on, d, id, style::root_style(), css::no_interaction())
    let mut from: style::ComputedStyle = style::copy_style(target)
    from.height_mode = "px"
    from.height = 20
    let mut act: anim::AnimCtx = anim::no_anim()
    act.now = 500
    act.t_ids = [id]
    act.t_from = [from]
    act.t_start = [0]
    act.t_dur = [1000]
    act.t_delay = [0]
    act.t_ease = ["linear"]
    ;; w połowie: 20 + (100 - 20) / 2 = 60
    let mid: layout::LayoutResult = layout::layout_full_a(d, on, 800, 600, -1, css::no_interaction(), [], act)
    assert_eq(find_box(mid.boxes, id, "box").h, 60)
    act.now = 1500
    let done: layout::LayoutResult = layout::layout_full_a(d, on, 800, 600, -1, css::no_interaction(), [], act)
    assert_eq(find_box(done.boxes, id, "box").h, 100)
    ;; bez interpolate-size przejście do auto jest skokowe (od razu naturalna wysokość)
    act.now = 500
    let jump: layout::LayoutResult = layout::layout_full_a(d, off, 800, 600, -1, css::no_interaction(), [], act)
    assert_eq(find_box(jump.boxes, id, "box").h, 100)
    ;; w drugą stronę: z auto (naturalnie 100px) do 40px
    let on2: css::Stylesheet = css::parse(".a { margin: 0; height: 40px; transition: height 1s linear; interpolate-size: allow-keywords; }")
    let t2: style::ComputedStyle = style::resolve_ctx(on2, d, id, style::root_style(), css::no_interaction())
    let mut from2: style::ComputedStyle = style::copy_style(t2)
    from2.height_mode = "auto"
    act.t_from = [from2]
    act.now = 500
    let back: layout::LayoutResult = layout::layout_full_a(d, on2, 800, 600, -1, css::no_interaction(), [], act)
    assert_eq(find_box(back.boxes, id, "box").h, 70)
end

