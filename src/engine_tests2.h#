    assert_eq(find_box(tin, 1, "box").scroll_x, 150)
end


#[test]
fn t06_speech_pause_rest_and_cue_longhands_emit_markers_in_order() is
    let d: dom::Dom = dom::parse("<p id=\"p\">Hi</p>")
    let st: [style::ComputedStyle] = layout::compute_styles(d, css::parse("p { pause-before: 200ms; rest-before: 1s; cue-before: url(a.wav); cue-after: url(\"b.wav\"); rest-after: strong; pause-after: weak; }"), css::no_interaction())
    let s: string = speech::spoken_text(d, st, dom::find_by_id(d, "p"))
    ;; kolejność z przodu: pauza, sygnał, odpoczynek; z tyłu: odpoczynek, sygnał, pauza
    let ip: int = string_find(s, "\u0001P200\u0001")
    let ic: int = string_find(s, "\u0001Ca.wav\u0001")
    let ir: int = string_find(s, "\u0001P1000\u0001")
    assert_true(ip >= 0)
    assert_true(ip < ic)
    assert_true(ic < ir)
    let ih: int = string_find(s, "Hi")
    assert_true(ir < ih)
    let tail: string = string_slice(s, ih, string_len(s))
    let ra: int = string_find(tail, "\u0001P800\u0001")
    let cb: int = string_find(tail, "\u0001Cb.wav\u0001")
    let pa: int = string_find(tail, "\u0001P200\u0001")
    assert_true(ra >= 0)
    assert_true(ra < cb)
    assert_true(cb < pa)
end

#[test]
fn t06_speech_cue_and_pause_shorthands_split_before_after() is
    let d: dom::Dom = dom::parse("<p id=\"p\">Hi</p>")
    let st: [style::ComputedStyle] = layout::compute_styles(d, css::parse("p { cue: url(x.wav) url(y.wav); pause: 300ms 500ms; }"), css::no_interaction())
    let s: string = speech::spoken_text(d, st, dom::find_by_id(d, "p"))
    let ih: int = string_find(s, "Hi")
    assert_true(string_find(s, "\u0001Cx.wav\u0001") >= 0 && string_find(s, "\u0001Cx.wav\u0001") < ih)
    assert_true(string_find(s, "\u0001Cy.wav\u0001") > ih)
    assert_true(string_find(s, "\u0001P300\u0001") >= 0 && string_find(s, "\u0001P300\u0001") < ih)
    assert_true(string_find(s, "\u0001P500\u0001") > ih)
end


