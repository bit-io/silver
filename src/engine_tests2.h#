#[test]
fn t09_shape_inside_confines_lines_to_the_shape_and_shape_padding_insets_it() is
    let words: string = "aa bb cc dd ee ff gg hh ii jj kk ll mm nn oo pp qq rr ss tt uu vv ww xx yy zz aa bb cc dd ee ff gg hh ii jj kk ll mm nn oo pp"
    let base: string = "div { margin: 0; width: 200px; height: 200px; font-size: 16px; } "
    let plain: [layout::LayoutBox] = lay("<div>" + words + "</div>", base, 400)
    let circ: [layout::LayoutBox] = lay("<div>" + words + "</div>", base + "div { shape-inside: circle(50%); }", 400)
    let pad: [layout::LayoutBox] = lay("<div>" + words + "</div>", base + "div { shape-inside: circle(50%); shape-padding: 12px; }", 400)
    ;; w kole pierwszy wiersz nie zaczyna się na górze (tam kształt jest za wąski) ani przy lewej krawędzi
    assert_true(first_text_box(circ).y > first_text_box(plain).y)
    assert_true(first_text_box(circ).x > first_text_box(plain).x)
    ;; wszystkie wiersze mieszczą się w okręgu o promieniu 100 wokół (100, 100)
    let mut i: int = 0
    while i < array_len(circ) is
        if circ[i].kind == "text" && circ[i].y < 200 is
            let cy: int = circ[i].y + circ[i].h / 2
            let dy: int = cy - 100
            let dx_l: int = 100 - circ[i].x
            let dx_r: int = circ[i].x + circ[i].w - 100
            assert_true(dx_l * dx_l + dy * dy <= 100 * 100 + 400)
            assert_true(dx_r * dx_r + dy * dy <= 100 * 100 + 400)
        end
        i += 1
    end
    ;; shape-padding odsuwa tekst od krawędzi kształtu
    assert_true(first_text_box(pad).y >= first_text_box(circ).y)
    assert_true(first_text_box(pad).x > first_text_box(circ).x || first_text_box(pad).y > first_text_box(circ).y)
    ;; shape-inside: none/auto nie zmienia układu
    let none: [layout::LayoutBox] = lay("<div>" + words + "</div>", base + "div { shape-inside: none; }", 400)
    assert_eq(first_text_box(none).y, first_text_box(plain).y)
    ;; inset() i polygon() też działają: wąski prostokąt wewnątrz zawęża wiersze
    let ins: [layout::LayoutBox] = lay("<div>" + words + "</div>", base + "div { shape-inside: inset(0 80px 0 80px); }", 400)
    assert_eq(first_text_box(ins).x, 80)
    assert_true(max_right_above(ins, 200) <= 120)
end

