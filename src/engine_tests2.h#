;; ====================== sesja 3: wykluczenia (wrap-flow, wrap-through) ======================
fn excl_page(flow: string, p_extra: string) -> [layout::LayoutBox] is
    let words: string = "aa bb cc dd ee ff gg hh ii jj kk ll mm nn oo pp qq rr ss tt uu vv ww xx yy zz aa bb cc dd ee ff gg hh ii jj kk ll"
    let html: string = "<div id=\"c\"><div id=\"x\"></div><p id=\"p\">" + words + "</p></div>"
    let flow_decl: string = if flow == "" then "" else "wrap-flow: " + flow + ";"
    let css_t: string = "body { margin: 0; } #c { position: relative; width: 300px; font-size: 16px; } #x { position: absolute; left: 100px; top: 0; width: 60px; height: 60px; " + flow_decl + " } p { margin: 0; " + p_extra + " }"
    return lay(html, css_t, 400)
end

fn text_in_band(boxes: [layout::LayoutBox], y0: int, y1: int) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].y >= y0 && boxes[i].y < y1 is n += 1 end
        i += 1
    end
    return n
end

fn min_left_in_band(boxes: [layout::LayoutBox], y0: int, y1: int) -> int is
    let mut m: int = 100000
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].y >= y0 && boxes[i].y < y1 && boxes[i].x < m is m = boxes[i].x end
        i += 1
    end
    return m
end

#[test]
fn t14_wrap_flow_start_end_clear_maximum_minimum_and_wrap_through() is
    ;; bez wrap-flow tekst leci pod elementem absolutnym od x = 0 (wiersze na y < 60 przechodzą przez x = 100..160)
    let plain: [layout::LayoutBox] = excl_page("", "")
    assert_true(max_right_above(plain, 60) > 160)
    ;; start: tekst tylko po lewej stronie (do x = 100)
    let st: [layout::LayoutBox] = excl_page("start", "")
    assert_true(max_right_above(st, 60) <= 100)
    assert_true(text_in_band(st, 0, 60) > 0)
    ;; end: tekst tylko po prawej (od x = 160)
    let en: [layout::LayoutBox] = excl_page("end", "")
    assert_true(min_left_in_band(en, 0, 60) >= 160)
    assert_true(text_in_band(en, 0, 60) > 0)
    ;; clear: żadnego tekstu obok elementu
    let cl: [layout::LayoutBox] = excl_page("clear", "")
    assert_eq(text_in_band(cl, 0, 60), 0)
    assert_true(text_in_band(cl, 60, 400) > 0)
    ;; maximum: po stronie z większą przestrzenią (prawa: 140 > 100); minimum: po lewej
    let mx: [layout::LayoutBox] = excl_page("maximum", "")
    assert_true(min_left_in_band(mx, 0, 60) >= 160)
    let mn: [layout::LayoutBox] = excl_page("minimum", "")
    assert_true(max_right_above(mn, 60) <= 100)
    ;; both: przybliżenie — jedna strona (większa), tekst nie nachodzi na element
    let bo: [layout::LayoutBox] = excl_page("both", "")
    assert_true(min_left_in_band(bo, 0, 60) >= 160 || max_right_above(bo, 60) <= 100)
    ;; wrap-through: none — akapit ignoruje wykluczenia
    let wt: [layout::LayoutBox] = excl_page("clear", "wrap-through: none;")
    assert_true(text_in_band(wt, 0, 60) > 0)
    assert_eq(min_left_in_band(wt, 0, 60), 0)
    let wr: [layout::LayoutBox] = excl_page("clear", "wrap-through: wrap;")
    assert_eq(text_in_band(wr, 0, 60), 0)
end

