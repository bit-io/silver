struct FocusDoc is
    pub d:     dom::Dom
    pub boxes: [layout::LayoutBox]
end

fn open_app(html: string) -> FocusDoc is
    let d: dom::Dom = dom::parse(html)
    let boxes: [layout::LayoutBox] = layout::layout(d, css::parse(""), 500, -1)
    return FocusDoc { d: d, boxes: boxes }
end

fn tab_order(a: FocusDoc, n: int) -> [int] is
    let mut focused: int = -1
    let mut out: [int] = []
    let mut i: int = 0
    while i < n is
        let nx: int = focus::next_focus(a.d, a.boxes, focused, true)
        out = array_push(out, nx)
        focused = nx
        i += 1
    end
    return out
end

#[test]
fn t12_reading_order_sorts_focus_ascending_and_stable() is
