    assert_eq(box_with_text(plain, "b").y, box_with_text(plain, "a").y)
    ;; wrap-inside: avoid — cała grupa przechodzi do następnego wiersza zamiast dzielić się między wierszami
    let grp: string = "<p>aaaa aaaa <span STYLE>bbbb bbbb bbbb</span></p>"
    let css_t: string = "p { margin: 0; width: 160px; }"
    let split: [layout::LayoutBox] = lay(string_replace(grp, " STYLE", ""), css_t, 400)
    let kept: [layout::LayoutBox] = lay(string_replace(grp, "STYLE", "style=\"wrap-inside: avoid\""), css_t, 400)
    assert_eq(box_starting(split, "bbbb").y, 0)
    assert_true(box_starting(kept, "bbbb").y > 0)
end

