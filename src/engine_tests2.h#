#[test]
fn t10_named_view_timeline_axis_and_timeline_scope_visibility() is
    let html: string = "<div id=\"w\"><div style=\"height: 400px\"></div><div id=\"a\" style=\"height: 50px\">x</div><div id=\"b\">y</div></div>"
    let d: dom::Dom = dom::parse(html)
    let aid: int = dom::find_by_id(d, "a")
    let bid: int = dom::find_by_id(d, "b")
    let kf: string = "@keyframes k { from { opacity: 0; } to { opacity: 1; } } body { margin: 0; } #w { margin: 0; } #a { margin: 0; "
    let tail: string = " } #b { margin: 0; animation: k 1000ms linear both; animation-timeline: --v; }"
    ;; b nie jest potomkiem a: bez timeline-scope nazwa --v jest dla niego niewidoczna (czas zegarowy = -1)
    let hid: [layout::LayoutBox] = layout::layout(d, css::parse(kf + "view-timeline-name: --v;" + tail), 400, -1)
    assert_eq(layout::timeline_elapsed(hid, d, bid, find_box(hid, bid, "box").st, 275, 0, 400, 300), -1)
    ;; timeline-scope na wspólnym przodku udostępnia oś; postęp widoczności a: scroll 275 → 50 %
    let vis: [layout::LayoutBox] = layout::layout(d, css::parse(kf + "view-timeline-name: --v;" + tail + " #w { timeline-scope: --v; }"), 400, -1)
    assert_eq(layout::timeline_elapsed(vis, d, bid, find_box(vis, bid, "box").st, 275, 0, 400, 300), 500)
    let all: [layout::LayoutBox] = layout::layout(d, css::parse(kf + "view-timeline-name: --v;" + tail + " #w { timeline-scope: all; }"), 400, -1)
    assert_eq(layout::timeline_elapsed(all, d, bid, find_box(all, bid, "box").st, 275, 0, 400, 300), 500)
    ;; timeline-scope innej nazwy nie pomaga
    let oth: [layout::LayoutBox] = layout::layout(d, css::parse(kf + "view-timeline-name: --v;" + tail + " #w { timeline-scope: --other; }"), 400, -1)
    assert_eq(layout::timeline_elapsed(oth, d, bid, find_box(oth, bid, "box").st, 275, 0, 400, 300), -1)
    ;; view-timeline-axis: inline — postęp nie zależy od przewijania w pionie
    let inl: [layout::LayoutBox] = layout::layout(d, css::parse(kf + "view-timeline-name: --v; view-timeline-axis: inline;" + tail + " #w { timeline-scope: --v; }"), 400, -1)
    let i1: int = layout::timeline_elapsed(inl, d, bid, find_box(inl, bid, "box").st, 100, 0, 400, 300)
    let i2: int = layout::timeline_elapsed(inl, d, bid, find_box(inl, bid, "box").st, 275, 0, 400, 300)
    assert_eq(i1, i2)
    assert_true(i1 >= 0)
end

