fn box_with_text(boxes: [layout::LayoutBox], s: string) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].text == s is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

fn box_starting(boxes: [layout::LayoutBox], s: string) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && string_starts_with(boxes[i].text, s) is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

fn first_line_text_count(boxes: [layout::LayoutBox]) -> int is
    let mut y0: int = -1
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is
            if y0 < 0 is y0 = boxes[i].y end
            if boxes[i].y == y0 is n += 1 end
        end
        i += 1
    end
    return n
end

fn print_ix(bg: bool) -> css::InteractionState is
    let mut ix: css::InteractionState = css::no_interaction()
    ix.print = true
    ix.print_bg = bg
    return ix
end

fn page_list(html: string, css_text: string) -> [paged::Page] is
    let d: dom::Dom = dom::parse(html)
    let sheet: css::Stylesheet = css::parse(css_text)
    let first: [int] = paged::page_box(sheet, "", 0)
    let cw: int = first[0] - first[5] - first[3]
    let res: layout::LayoutResult = layout::layout_full_a(d, sheet, cw, first[1] - first[2] - first[4], -1, print_ix(true), [], anim::no_anim())
    return paged::paginate(res.boxes, d, sheet, res.height)
end

fn nth_box_of(boxes: [layout::LayoutBox], id: int, n: int) -> layout::LayoutBox is
    let mut seen: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == "box" is
            if seen == n is return boxes[i] end
            seen += 1
        end
        i += 1
    end
    return boxes[0]
end

fn max_right_above(boxes: [layout::LayoutBox], ylim: int) -> int is
    let mut m: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].y < ylim && boxes[i].x + boxes[i].w > m is m = boxes[i].x + boxes[i].w end
        i += 1
    end
    return m
end

fn first_text_box(boxes: [layout::LayoutBox]) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

fn max_text_right(boxes: [layout::LayoutBox]) -> int is
    let mut m: int = 0
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].x + boxes[i].w > m is m = boxes[i].x + boxes[i].w end
        i += 1
    end
    return m
end

