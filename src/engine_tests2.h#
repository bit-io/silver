fn t08_wrap_before_after_line_force_breaks_and_wrap_inside_avoid_keeps_group() is
    let aft: [layout::LayoutBox] = lay("<p><span style=\"wrap-after: line\">a</span><span>b</span></p>", "p { margin: 0; width: 300px; }", 400)
    assert_true(box_with_text(aft, "b").y > box_with_text(aft, "a").y)
