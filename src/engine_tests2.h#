#[test]
fn t16_trigger_activity_range_exit_range_and_trigger_scope() is
    let html: string = "<div id=\"w\"><div style=\"height: 400px\"></div><div id=\"a\" style=\"height: 50px\">x</div><div id=\"b\">y</div></div>"
    let d: dom::Dom = dom::parse(html)
    let aid: int = dom::find_by_id(d, "a")
    let bid: int = dom::find_by_id(d, "b")
    let base: string = "body { margin: 0; } #w { margin: 0; } #a { margin: 0; "
    let bx: [layout::LayoutBox] = layout::layout(d, css::parse(base + "timeline-trigger: --t view(); } #b { animation-trigger: --t play-forwards pause; }"), 400, -1)
    ;; widok 300 px: obiekt na y = 400..450 wchodzi przy scroll 100, wychodzi przy 450
    assert_true(!layout::trigger_active(bx, d, aid, false, 0, 500, 400, 300))
    assert_true(layout::trigger_active(bx, d, aid, false, 275, 500, 400, 300))
    assert_true(!layout::trigger_active(bx, d, aid, false, 450, 500, 400, 300))
    assert_true(!layout::trigger_active(bx, d, aid, false, 100, 500, 400, 300))
    ;; zakres wyjścia szerszy niż wejścia — histereza: aktywny dalej, jeśli już był
    let hx: [layout::LayoutBox] = layout::layout(d, css::parse(base + "timeline-trigger: --t view() / 0% 200%; }"), 400, -1)
    assert_true(!layout::trigger_active(hx, d, aid, false, 500, 600, 400, 300))
    assert_true(layout::trigger_active(hx, d, aid, true, 500, 600, 400, 300))
    assert_true(!layout::trigger_active(hx, d, aid, true, 900, 1000, 400, 300))
    ;; zakres wejścia: 50% 100% — w 25 % zakresu jeszcze nieaktywny
    let rx: [layout::LayoutBox] = layout::layout(d, css::parse(base + "timeline-trigger: --t view() 50% 100%; }"), 400, -1)
    assert_true(!layout::trigger_active(rx, d, aid, false, 190, 500, 400, 300))
    assert_true(layout::trigger_active(rx, d, aid, false, 300, 500, 400, 300))
    ;; trigger-scope: b nie jest potomkiem a — nazwa widoczna dopiero po trigger-scope na wspólnym przodku
    let nos: [layout::LayoutBox] = layout::layout(d, css::parse(base + "timeline-trigger: --t view(); }"), 400, -1)
    assert_eq(layout::find_trigger(nos, d, bid, "--t"), -1)
    assert_eq(layout::find_trigger(nos, d, aid, "--t"), aid)
    let sc: [layout::LayoutBox] = layout::layout(d, css::parse(base + "timeline-trigger: --t view(); } #w { trigger-scope: --t; }"), 400, -1)
    assert_eq(layout::find_trigger(sc, d, bid, "--t"), aid)
    let all: [layout::LayoutBox] = layout::layout(d, css::parse(base + "timeline-trigger: --t view(); } #w { trigger-scope: all; }"), 400, -1)
    assert_eq(layout::find_trigger(all, d, bid, "--t"), aid)
    let oth: [layout::LayoutBox] = layout::layout(d, css::parse(base + "timeline-trigger: --t view(); } #w { trigger-scope: --inna; }"), 400, -1)
    assert_eq(layout::find_trigger(oth, d, bid, "--t"), -1)
end

;; ====================== sesja 3: przypisy (float: footnote) ======================
#[test]
fn t17_footnotes_move_to_page_area_reserve_space_and_follow_their_call() is
    let base: string = "@page { size: 300px 400px; margin: 0; } body { margin: 0; } p { margin: 0; line-height: 22px; } .sp { height: 330px; } "
    let html: string = "<p id=\"p1\">First <span id=\"n1\" class=\"fn\">Note one text</span> end.</p><div class=\"sp\"></div><p id=\"p2\">Second <span id=\"n2\" class=\"fn\">Note two</span> end.</p>"
    let d: dom::Dom = dom::parse(html)
    let plan: paged::PrintPlan = paged::plan_print(-1, d, css::parse(base + ".fn { float: footnote; }"), false)
    assert_eq(array_len(plan.fs.ids), 2)
    assert_eq(plan.fs.texts[0], "Note one text")
    assert_eq(plan.fs.texts[1], "Note two")
    ;; w przepływie zostaje numerowany odnośnik
    assert_eq(plan.fs.d.nodes[plan.fs.ids[0]].tag, "sup")
    assert_eq(plan.fs.d.nodes[plan.fs.ids[0]].attr_class, "footnote-call")
    ;; pierwszy przypis na stronie 0, drugi akapit (y = 352) po rezerwacji miejsca na przypis nr 1 ląduje na stronie 1 wraz z przypisem 2
    assert_eq(plan.notes[0], 0)
    assert_eq(plan.notes[1], 1)
    assert_true(plan.reserve[0] > 20)
    assert_true(plan.pages[0].y1 <= 400 - plan.reserve[0])
    assert_true(plan.fn_h[0] > 0)
    assert_true(plan.fn_h[1] > 0)
    ;; bez footnote: ten sam dokument mieści się na jednej stronie, bez zarezerwowanego miejsca
    let plain: paged::PrintPlan = paged::plan_print(-1, dom::parse(html), css::parse(base), false)
    assert_eq(array_len(plain.pages), 1)
    assert_eq(array_len(plain.fs.ids), 0)
    ;; pole przypisów zawiera numer i treść
    let area: string = paged::footnote_area_html(plan.fs, [0])
    assert_true(string_find(area, "Note one text") >= 0)
    assert_true(string_find(area, ">1</span>") >= 0)
    assert_eq(string_find(area, "Note two"), -1)
end

#[test]
fn t17_footnote_display_inline_packs_notes_into_one_paragraph() is
    let base: string = "@page { size: 300px 400px; margin: 0; } body { margin: 0; } p { margin: 0; } "
    let html: string = "<p>A <span class=\"fn\">alpha note</span> B <span class=\"fn\">beta note</span> C <span class=\"fn\">gamma note</span></p>"
    let blk: paged::PrintPlan = paged::plan_print(-1, dom::parse(html), css::parse(base + ".fn { float: footnote; footnote-display: block; }"), false)
    let inl: paged::PrintPlan = paged::plan_print(-1, dom::parse(html), css::parse(base + ".fn { float: footnote; footnote-display: inline; }"), false)
    let cmp: paged::PrintPlan = paged::plan_print(-1, dom::parse(html), css::parse(base + ".fn { float: footnote; footnote-display: compact; }"), false)
    assert_eq(array_len(blk.fs.ids), 3)
    assert_eq(blk.fs.disp[0], "block")
    assert_eq(inl.fs.disp[0], "inline")
    assert_eq(cmp.fs.disp[0], "compact")
    ;; trzy krótkie przypisy: inline mieści się w jednym akapicie, block w trzech
    assert_true(inl.fn_h[0] < blk.fn_h[0])
    assert_eq(array_len(string_split(paged::footnote_area_html(blk.fs, [0, 1, 2]), "<p ")) - 1, 3)
    assert_eq(array_len(string_split(paged::footnote_area_html(inl.fs, [0, 1, 2]), "<p ")) - 1, 1)
end

#[test]
fn t17_footnote_policy_block_keeps_the_call_block_whole_on_one_page() is
    let base: string = "@page { size: 300px 400px; margin: 0; } body { margin: 0; } p { margin: 0; line-height: 22px; } .sp { height: 340px; } "
    let html: string = "<div class=\"sp\"></div><p id=\"p\">line one<br>line two<br>three <span class=\"fn\">the note</span></p>"
    let auto: paged::PrintPlan = paged::plan_print(-1, dom::parse(html), css::parse(base + ".fn { float: footnote; footnote-policy: auto; }"), false)
    let blk: paged::PrintPlan = paged::plan_print(-1, dom::parse(html), css::parse(base + ".fn { float: footnote; footnote-policy: block; }"), false)
    assert_eq(auto.fs.pol[0], "auto")
    assert_eq(blk.fs.pol[0], "block")
    ;; auto: akapit może się podzielić (pierwsze wiersze na stronie 0), przypis idzie ze stroną odnośnika
    assert_true(auto.pages[0].y1 > 340)
    assert_eq(auto.notes[0], 1)
    ;; block: cały akapit z odnośnikiem przechodzi na stronę z przypisem
    assert_true(blk.pages[0].y1 <= 340)
    assert_eq(blk.notes[0], 1)
end
