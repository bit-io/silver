fn st_for(html: string, css_text: string, idx: int) -> style::ComputedStyle is
    let d: dom::Dom = dom::parse(html)
    let sheet: css::Stylesheet = css::parse(css_text)
    return style::resolve_ctx(sheet, d, idx, style::root_style(), css::no_interaction())
end


fn lay(html: string, css_text: string, vw: int) -> [layout::LayoutBox] is
    return layout::layout(dom::parse(html), css::parse(css_text), vw, -1)
end


fn find_box(boxes: [layout::LayoutBox], id: int, kind: string) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == kind is return boxes[i] end
        i += 1
    end
    return boxes[0]
end


fn texts_of(boxes: [layout::LayoutBox], id: int) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == "text" is out = out + boxes[i].text end
        i += 1
    end
    return out
end


fn svg_of(html: string, css_text: string, w: int, h: int) -> string is
    let d: dom::Dom = dom::parse(html)
    let st: [style::ComputedStyle] = layout::compute_styles(d, css::parse(css_text), css::no_interaction())
    return svg::markup(d, st, 1, w, h)
end


