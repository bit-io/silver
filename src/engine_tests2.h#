#[test]
fn t06_gap_rule_insets_shorten_rule_ends() is
    let base: [layout::LayoutBox] = gr_grid(".g { column-rule: 2px solid red; column-rule-break: none; }")
    let full: int = gr_first(base, 2, -1).h
    let ins: [layout::LayoutBox] = gr_grid(".g { column-rule: 2px solid red; column-rule-break: none; column-rule-inset: 5px; }")
    assert_eq(full - gr_first(ins, 2, -1).h, 10)
    let edge: [layout::LayoutBox] = gr_grid(".g { column-rule: 2px solid red; column-rule-break: none; column-rule-edge-inset: 4px; }")
    assert_eq(full - gr_first(edge, 2, -1).h, 8)
    let rin: [layout::LayoutBox] = gr_grid(".g { column-rule: 2px solid red; column-rule-break: none; rule-inset: 3px; }")
    assert_eq(full - gr_first(rin, 2, -1).h, 6)
    let redge: [layout::LayoutBox] = gr_grid(".g { column-rule: 2px solid red; column-rule-break: none; rule-edge-inset: 2px; }")
    assert_eq(full - gr_first(redge, 2, -1).h, 4)
    ;; wiersze: te same zasady dla row-rule-*
    let rb: [layout::LayoutBox] = gr_grid(".g { row-rule: 2px solid red; row-rule-break: none; }")
    let rfull: int = gr_first(rb, -1, 2).w
    let rr: [layout::LayoutBox] = gr_grid(".g { row-rule: 2px solid red; row-rule-break: none; row-rule-inset: 5px; }")
    assert_eq(rfull - gr_first(rr, -1, 2).w, 10)
    let rre: [layout::LayoutBox] = gr_grid(".g { row-rule: 2px solid red; row-rule-break: none; row-rule-edge-inset: 4px; }")
    assert_eq(rfull - gr_first(rre, -1, 2).w, 8)
end

#[test]
fn t06_gap_rule_interior_inset_and_row_rule_break_split_at_intersections() is
    let cont: [layout::LayoutBox] = gr_grid(".g { row-rule: 2px solid red; row-rule-break: none; }")
    let split: [layout::LayoutBox] = gr_grid(".g { row-rule: 2px solid red; row-rule-break: intersection; }")
    assert_eq(gr_count(cont, -1, 2), 1)
    assert_eq(gr_count(split, -1, 2), 2)
    let a: [layout::LayoutBox] = gr_grid(".g { column-rule: 2px solid red; column-rule-break: intersection; }")
    let b: [layout::LayoutBox] = gr_grid(".g { column-rule: 2px solid red; column-rule-break: intersection; column-rule-interior-inset: 4px; }")
    assert_true(gr_first(b, 2, -1).h < gr_first(a, 2, -1).h)
    let c: [layout::LayoutBox] = gr_grid(".g { row-rule: 2px solid red; row-rule-break: intersection; row-rule-interior-inset: 4px; }")
    assert_true(gr_first(c, -1, 2).w < gr_first(split, -1, 2).w)
    let d: [layout::LayoutBox] = gr_grid(".g { row-rule: 2px solid red; row-rule-break: intersection; rule-interior-inset: 4px; }")
    assert_true(gr_first(d, -1, 2).w < gr_first(split, -1, 2).w)
    let e: [layout::LayoutBox] = gr_grid(".g { row-rule: 2px solid red; row-rule-break: intersection; row-rule-edge-inset: 4px; }")
    assert_true(gr_first(e, -1, 2).w < gr_first(split, -1, 2).w)
end


