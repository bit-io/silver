pub fn create(title: string, width: int, height: int) -> Window is
    let h: int = ffi_shim::silver_window_create(title, width, height)
    return Window { handle: h, title: title, width: width, height: height, open: h >= 0 }
end

;; path == "" -> font systemowy
pub fn load_font(win: Window, path: string, size: int) -> bool is
    return ffi_shim::silver_load_font(win.handle, path, size)
end

pub fn is_open(win: Window) -> bool is
    return win.open && ffi_shim::silver_is_open(win.handle)
end

;; Treść po drugim separatorze '|' (tekst może sam zawierać '|').
fn tail_after_bars(payload: string, bars: int) -> string is
    let mut p: int = 0
    let mut seen: int = 0
    let n: int = string_len(payload)
    while p < n && seen < bars is
        if string_slice(payload, p, p + 1) == "|" is seen += 1 end
        p += 1
    end
    return string_slice(payload, p, n)
end

fn ev(kind: string) -> InputEvent is
    return InputEvent { kind: kind, x: 0, y: 0, code: 0, text: "", mods: 0, clicks: 1, repeat: false, dx: 0 }
end

fn field(parts: [string], i: int) -> int is
    if i < array_len(parts) is return str_to_int(parts[i]) end
    return 0
end

;; Dekoduje payload zdarzenia o danym kodzie (wydzielone dla testów).
pub fn decode(code: int, payload: string) -> InputEvent is
    let parts: [string] = string_split(payload, "|")
    let mut e: InputEvent = ev("none")
    if code == 1 is
        e.kind = "quit"
    elsif code == 2 || code == 3 is
        e.kind = if code == 2 then "mouse_down" else "mouse_up"
        e.x = field(parts, 0)
        e.y = field(parts, 1)
        e.code = field(parts, 2)
        e.clicks = field(parts, 3)
        e.mods = field(parts, 4)
    elsif code == 4 is
        e.kind = "mouse_move"
        e.x = field(parts, 0)
        e.y = field(parts, 1)
        e.code = field(parts, 2)
        e.mods = field(parts, 3)
    elsif code == 5 || code == 11 is
        e.kind = if code == 5 then "key_down" else "key_up"
        e.mods = field(parts, 0)
        e.repeat = field(parts, 1) != 0
        e.code = field(parts, 2)
    elsif code == 6 is
        e.kind = "resize"
        e.x = field(parts, 0)
        e.y = field(parts, 1)
        e.code = field(parts, 2)
    elsif code == 7 is
        e.kind = "text"
        e.text = tail_after_bars(payload, 2)
    elsif code == 13 is
        e.kind = "text_edit"
        e.x = field(parts, 0)
        e.y = field(parts, 1)
        e.text = tail_after_bars(payload, 2)
    elsif code == 8 is
        e.kind = "scroll"
        e.dx = field(parts, 0)
        e.y = field(parts, 1)
        e.mods = field(parts, 2)
        e.x = field(parts, 3)
        e.code = field(parts, 4)
    elsif code == 9 is
        e.kind = "focus_gained"
    elsif code == 10 is
        e.kind = "focus_lost"
    elsif code == 12 is
        e.kind = "drop_file"
        e.text = tail_after_bars(payload, 2)
    elsif code == 14 is
        e.kind = "drop_text"
        e.text = tail_after_bars(payload, 2)
    elsif code == 15 is
        e.kind = "expose"
    elsif code == 16 is
        e.kind = "mouse_leave"
    end
    return e
end

pub fn poll(win: Window) -> InputEvent is
    let code: int = ffi_shim::silver_poll_event(win.handle)
    if code == 0 is return ev("none") end
    return decode(code, ffi_shim::silver_event_payload(win.handle))
end

