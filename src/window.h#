;; kursor: arrow | pointer | text | crosshair | wait | move | ns-resize | ew-resize | not-allowed
pub fn set_cursor(win: Window, css_cursor: string) -> bool is
    let kind: int = if css_cursor == "pointer" then 1 elsif css_cursor == "text" then 2
                    elsif css_cursor == "crosshair" then 3 elsif css_cursor == "wait" || css_cursor == "progress" then 4
                    elsif css_cursor == "move" || css_cursor == "grab" then 5
                    elsif css_cursor == "ns-resize" || css_cursor == "row-resize" then 6
                    elsif css_cursor == "ew-resize" || css_cursor == "col-resize" then 7
                    elsif css_cursor == "not-allowed" then 8 else 0
    return ffi_shim::silver_set_cursor(win.handle, kind)
end

