mod ffi_shim

pub struct Window is
    pub handle: int
    pub title:  string
    pub width:  int
    pub height: int
    pub open:   bool
end

;; Zdarzenie wejściowe po zdekodowaniu payloadu z shimu.
;;  kind: none | quit | mouse_down | mouse_up | mouse_move | key_down | key_up |
;;        resize | text | text_edit | scroll | focus_gained | focus_lost |
;;        drop_file | drop_text | expose | mouse_leave
pub struct InputEvent is
    pub kind:   string
    pub x:      int
    pub y:      int
    pub code:   int      ;; keycode (key_*), przycisk (mouse_*), skala % (resize)
    pub text:   string   ;; tekst (text/text_edit/drop_*)
    pub mods:   int      ;; 1 shift, 2 ctrl, 4 alt, 8 gui
    pub clicks: int      ;; 1 = klik, 2 = dwuklik…
    pub repeat: bool
    pub dx:     int      ;; scroll w poziomie (px)
end

;; Modyfikatory
pub fn mod_shift() -> int is return 1 end
pub fn mod_ctrl()  -> int is return 2 end
pub fn mod_alt()   -> int is return 4 end
pub fn mod_gui()   -> int is return 8 end

