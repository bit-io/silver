pub fn new(title: string, width: int, height: int) -> App is
    let win: window::Window = window::create(title, width, height)
    if win.open is
        window::load_font(win, "", 16)
    end
    return App {
        win: win, dom: dom::empty(), sheet: css::empty_sheet(), router: ipc::new_router(),
        font_path: "", font_size: 16, store: "{}", js_handle: -1, theme: "auto", dark: false,
        bg: style::Color { r: 255, g: 255, b: 255, a: 255 },
        html_src: "", html_path: "", css_files: [], css_texts: [], js_files: [], has_structural: false, state_css: false,
        scroll_y: 0, elem_scroll: [], doc_h: 0, viewport_w: width, viewport_h: height,
        boxes: [], dirty_layout: true, dirty_paint: true,
        hovered_node: -1, active_node: -1, focused_node: -1, focus_value: "", cursor_pos: 0, anchor_pos: 0,
        ime: "", caret_t0: 0, caret_phase: true, dragging: false, mouse_x: -1, mouse_y: -1,
        cur_cursor: "default", has_focus: true, text_input_on: false,
        prev_bg: [], prev_fg: [], prev_op: [], anims: [],
        dev_mode: false, mtimes: [], last_dev: 0, tick_ms: 100, last_tick: 0, last_theme: 0,
        running: false, title_set: false, js_map: [], js_loaded: 0, js_inline_done: false, js_pending: 0, tasks: [],
        on_tick: identity_tick, on_event: identity_event
    }
end

