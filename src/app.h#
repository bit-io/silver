end

pub fn set_min_size(app: App, w: int, h: int) -> App is
    window::set_min_size(app.win, w, h)
    return app
end

pub fn set_icon(app: App, path: string) -> App is
    window::set_icon(app.win, path)
    return app
end

pub fn clipboard_get() -> string is return window::clipboard_get() end
pub fn clipboard_set(text: string) -> bool is return window::clipboard_set(text) end
pub fn notify(title: string, body: string) -> bool is return window::notify(title, body) end

;; Przewija stronę do pozycji (z limitem).
pub fn scroll_to(app: App, y: int) -> App is
    return scroll_page_to(app, y)
end

pub fn is_dark(app: App) -> bool is return app.dark end
