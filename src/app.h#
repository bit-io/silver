fn field_edit(a: App) -> edit::Edit is
    if a.focused_node < 0 is return edit::make("", 0, 0) end
    return edit::make(a.dom.nodes[a.focused_node].attr_value, a.cursor_pos, a.anchor_pos)
end

fn maxlength_of(n: dom::DomNode) -> int is
    let v: string = dom::get_attr(n, "maxlength")
    if v == "" is return 0 end
    return str_to_int(v)
