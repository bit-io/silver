;; ---------- fokus ----------
fn is_text_field(n: dom::DomNode) -> bool is
    if n.tag == "textarea" is return true end
    if n.tag != "input" is return false end
    let t: string = string_lower(n.attr_type)
    return t != "checkbox" && t != "radio" && t != "button" && t != "submit" && t != "reset" && t != "hidden" && t != "file"
end

fn is_focusable(n: dom::DomNode) -> bool is
    if n.removed || n.disabled is return false end
    if n.tag == "input" is return string_lower(n.attr_type) != "hidden" end
    if n.tag == "textarea" || n.tag == "select" || n.tag == "button" is return true end
    if n.tag == "a" is return n.attr_href != "" || n.on_click != "" end
    return dom::has_attr(n, "tabindex") && dom::get_attr(n, "tabindex") != "-1"
end

fn set_text_input(a0: App, on: bool) -> App is
    let mut a: App = a0
    if on && !a.text_input_on is
        window::start_text_input(a.win)
        a.text_input_on = true
    end
    if !on && a.text_input_on is
        window::stop_text_input(a.win)
        a.text_input_on = false
    end
    return a
end

fn reset_caret(a0: App) -> App is
    let mut a: App = a0
    a.caret_t0 = ffi_shim::silver_ticks()
    a.caret_phase = true
    a.dirty_paint = true
    return a
end

;; Zdejmuje fokus (z on-change, jeśli wartość się zmieniła).
fn blur_current(a0: App) -> App is
    let mut a: App = a0
    let old: int = a.focused_node
    if old < 0 is return a end
    let n: dom::DomNode = a.dom.nodes[old]
    a.focused_node = -1
    a.ime = ""
    a = set_text_input(a, false)
    if is_text_field(n) && n.attr_value != a.focus_value is
        a = invoke_html(a, n.on_change, event_args(a, old, "", ""))
        dom_event(a, "change", old, "")
    end
    dom_event(a, "blur", old, "")
    a.dirty_layout = true
    return a
end

pub fn focus_node(a0: App, node: int) -> App is
    let mut a: App = a0
    if node == a.focused_node is return a end
    if node >= 0 && (node >= array_len(a.dom.nodes) || !is_focusable(a.dom.nodes[node])) is return a end
    a = blur_current(a)
    if node < 0 is return a end
    let n: dom::DomNode = a.dom.nodes[node]
    a.focused_node = node
    a.focus_value = n.attr_value
    a.cursor_pos = string_len(n.attr_value)
    a.anchor_pos = a.cursor_pos
    a.ime = ""
    a = set_text_input(a, is_text_field(n))
    a = reset_caret(a)
    a.dirty_layout = true
    dom_event(a, "focus", node, "")
    return a
end

pub fn focus(app: App, attr_id: string) -> App is
    return focus_node(app, node_by_id(app, attr_id))
end

pub fn blur(app: App) -> App is
    return focus_node(app, -1)
end

;; kolejny/poprzedni element do fokusu w kolejności dokumentu
fn next_focus(a: App, forward: bool) -> int is
    let order: [int] = dom::document_order(a.dom)
    let mut cands: [int] = []
    let mut i: int = 0
    while i < array_len(order) is
        let id: int = order[i]
        i += 1
        if id > 0 && is_focusable(a.dom.nodes[id]) && !hidden_by_style(a, id) is cands = array_push(cands, id) end
    end
    if array_len(cands) == 0 is return -1 end
    let mut pos: int = -1
    i = 0
    while i < array_len(cands) is
        if cands[i] == a.focused_node is pos = i end
        i += 1
    end
    if forward is
        return cands[(pos + 1) % array_len(cands)]
    end
    if pos <= 0 is return cands[array_len(cands) - 1] end
    return cands[pos - 1]
end

fn hidden_by_style(a: App, id: int) -> bool is
    ;; element bez boxa w układzie (display:none u siebie lub przodka) nie bierze udziału w Tab
    let mut i: int = 0
    while i < array_len(a.boxes) is
        if a.boxes[i].node_id == id && a.boxes[i].kind == "box" is return false end
        i += 1
    end
    return array_len(a.boxes) > 0
end

;; ---------- JS: start, snapshot DOM, polecenia ----------
fn attr_json_pair(name: string, val: string) -> string is
    return jsonlite::quote(name) + ":" + jsonlite::quote(val)
end

;; Atrybuty węzła jako obiekt JSON (wszystkie, także data-*).
fn attrs_json(n: dom::DomNode) -> string is
    let mut parts: [string] = []
    if n.attr_id != "" is parts = array_push(parts, attr_json_pair("id", n.attr_id)) end
    if n.attr_class != "" is parts = array_push(parts, attr_json_pair("class", n.attr_class)) end
    if n.attr_type != "" is parts = array_push(parts, attr_json_pair("type", n.attr_type)) end
    if n.attr_name != "" is parts = array_push(parts, attr_json_pair("name", n.attr_name)) end
    if n.attr_href != "" is parts = array_push(parts, attr_json_pair("href", n.attr_href)) end
    if n.attr_src != "" is parts = array_push(parts, attr_json_pair("src", n.attr_src)) end
    if n.attr_title != "" is parts = array_push(parts, attr_json_pair("title", n.attr_title)) end
    if n.attr_placeholder != "" is parts = array_push(parts, attr_json_pair("placeholder", n.attr_placeholder)) end
    if n.attr_style != "" is parts = array_push(parts, attr_json_pair("style", n.attr_style)) end
    if n.attr_value != "" is parts = array_push(parts, attr_json_pair("value", n.attr_value)) end
    if n.on_click != "" is parts = array_push(parts, attr_json_pair("on-click", n.on_click)) end
    if n.disabled is parts = array_push(parts, attr_json_pair("disabled", "")) end
    if n.checked is parts = array_push(parts, attr_json_pair("checked", "")) end
    if n.readonly is parts = array_push(parts, attr_json_pair("readonly", "")) end
    let names: [string] = dom::extra_attr_names(n)
    let mut i: int = 0
    while i < array_len(names) is
        parts = array_push(parts, attr_json_pair(names[i], dom::get_attr(n, names[i])))
        i += 1
    end
    let mut out: string = "{"
    i = 0
    while i < array_len(parts) is
        out = if i == 0 then out + parts[i] else out + "," + parts[i]
        i += 1
    end
    return out + "}"
end

fn node_json(d: dom::Dom, id: int) -> string is
    let n: dom::DomNode = d.nodes[id]
    let mut kids: string = "["
    let mut live: int = 0
    let mut i: int = 0
    while i < array_len(n.children) is
        let c: int = n.children[i]
        i += 1
        if d.nodes[c].removed is continue end
        kids = if live == 0 then kids + to_string(c) else kids + "," + to_string(c)
        live += 1
    end
    kids = kids + "]"
    let text_part: string = if n.tag == "text" then ",\"x\":" + jsonlite::quote(n.text) else ""
    return "{\"i\":" + to_string(id) + ",\"p\":" + to_string(n.parent) + ",\"t\":" + jsonlite::quote(n.tag) +
           text_part + ",\"k\":" + kids + ",\"a\":" + attrs_json(n) + "}"
end

fn snapshot_json(d: dom::Dom) -> string is
    let mut out: string = "["
    let mut first: bool = true
    let mut i: int = 0
    while i < array_len(d.nodes) is
        let id: int = i
        i += 1
        if d.nodes[id].removed is continue end
        out = if first then out + node_json(d, id) else out + "," + node_json(d, id)
        first = false
    end
    return out + "]"
end

;; Poddrzewo (węzeł + potomkowie) do __dom_subtree.
fn subtree_json(d: dom::Dom, root: int) -> string is
    let mut out: string = "["
    let mut stack: [int] = [root]
    let mut first: bool = true
    while array_len(stack) > 0 is
        let id: int = stack[array_len(stack) - 1]
        let mut rest: [int] = []
        let mut k: int = 0
        while k < array_len(stack) - 1 is
            rest = array_push(rest, stack[k])
            k += 1
        end
        stack = rest
        if d.nodes[id].removed is continue end
        out = if first then out + node_json(d, id) else out + "," + node_json(d, id)
        first = false
        let kids: [int] = d.nodes[id].children
        let mut c: int = 0
        while c < array_len(kids) is
            stack = array_push(stack, kids[c])
            c += 1
        end
    end
    return out + "]"
end

fn send_snapshot(a: App) -> bool is
    if a.js_handle < 0 is return false end
    return js::js_emit(a.js_handle, "__dom_snapshot", snapshot_json(a.dom))
end

fn script_path(a: App, src: string) -> string is
    let base: string = dir_of(a.html_path)
    if string_starts_with(src, "/") || base == "" is return src end
    return base + src
end

;; Tworzy kontekst JS (API jest wbudowane w shim), wysyła snapshot DOM i ładuje skrypty.
fn ensure_js(a0: App) -> App is
    let mut a: App = a0
    if a.js_handle < 0 is
        a.js_handle = js::js_init(a.win.handle)
        if a.js_handle < 0 is
            log::error("silver: nie można utworzyć kontekstu JS")
            return a
        end
        a.js_loaded = 0
        a.js_inline_done = false
        send_snapshot(a)
        let mut v: string = jsonlite::object()
        v = jsonlite::set_int(v, "w", a.viewport_w)
        v = jsonlite::set_int(v, "h", a.viewport_h)
        v = jsonlite::set_int(v, "scale", window::scale_percent(a.win))
        v = jsonlite::set_bool(v, "dark", a.dark)
        js::js_emit(a.js_handle, "__window_info", v)
    end
    let mut i: int = 0
    ;; <script src> z HTML, potem <script> inline, potem pliki z load_js
    if !a.js_inline_done is
        a.js_inline_done = true
        while i < array_len(a.dom.scripts) is
            let p: string = script_path(a, a.dom.scripts[i])
            if !js::js_load_file(a.js_handle, p) is
                log::error("silver: błąd JS w " + p + ": " + js::js_last_error(a.js_handle))
            end
            i += 1
        end
        if a.dom.inline_js != "" is
            if !js::js_eval(a.js_handle, a.dom.inline_js, "inline.js") is
                log::error("silver: błąd JS w <script>: " + js::js_last_error(a.js_handle))
            end
        end
    end
    while a.js_loaded < array_len(a.js_files) is
        let p: string = a.js_files[a.js_loaded]
        a.js_loaded += 1
        if !js::js_load_file(a.js_handle, p) is
            log::error("silver: błąd JS w " + p + ": " + js::js_last_error(a.js_handle))
        end
    end
    return a
end

;; Ładuje pliki JS (kolejność ma znaczenie). Wywołaj PO load_html.
pub fn load_js(app: App, files: [string]) -> App is
    let mut a: App = app
    let mut i: int = 0
    while i < array_len(files) is
        a.js_files = array_push(a.js_files, files[i])
        i += 1
    end
    a.mtimes = collect_mtimes(a)
    return ensure_js(a)
end

;; Uruchamia skrypty z HTML (<script>) nawet bez load_js.
fn start_js_if_needed(a0: App) -> App is
    let mut a: App = a0
    if a.js_handle >= 0 is return a end
    if array_len(a.dom.scripts) > 0 || a.dom.inline_js != "" || array_len(a.js_files) > 0 is
        a = ensure_js(a)
        if a.js_handle >= 0 is
            dom_event(a, "DOMContentLoaded", 0, "")
            dom_event(a, "load", 0, "")
        end
    end
    return a
end

fn restart_js(a0: App) -> App is
    let mut a: App = a0
    if a.js_handle >= 0 is
        js::js_shutdown(a.js_handle)
        a.js_handle = -1
    end
    a.js_map = []
    a = ensure_js(a)
    if a.js_handle >= 0 is
        dom_event(a, "DOMContentLoaded", 0, "")
        dom_event(a, "load", 0, "")
    end
    return a
end

;; ---------- operacje DOM z JS ----------
fn js_node(a: App, n: int) -> int is
    if n >= 1000000 is
        let idx: int = n - 1000000
        if idx < array_len(a.js_map) is return a.js_map[idx] end
        return -1
    end
    if n < 0 || n >= array_len(a.dom.nodes) is return -1 end
    return n
end

struct DomOpsRes is
    pub app:     App
    pub remap:   string      ;; "[[prov,real],…]" nowych węzłów
    pub subtrees: [int]      ;; węzły z nowym innerHTML
end

fn apply_dom_ops(a0: App, ops_raw: string) -> DomOpsRes is
    let mut a: App = a0
    let ops: [string] = jsonlite::array_items(ops_raw)
    let mut remap: string = ""
    let mut subtrees: [int] = []
    let mut i: int = 0
    while i < array_len(ops) is
        let op: string = ops[i]
        i += 1
        let kind: string = jsonlite::get_str(op, "o")
        let n: int = js_node(a, jsonlite::get_int(op, "n"))
        if kind == "create" is
            a.dom = dom::create_element(a.dom, jsonlite::get_str(op, "t"))
            let real: int = array_len(a.dom.nodes) - 1
            let prov: int = jsonlite::get_int(op, "p")
            if prov >= 1000000 is
                let idx: int = prov - 1000000
                while array_len(a.js_map) <= idx is a.js_map = array_push(a.js_map, -1) end
                a.js_map[idx] = real
                remap = if remap == "" then "[" + to_string(prov) + "," + to_string(real) + "]" else remap + ",[" + to_string(prov) + "," + to_string(real) + "]"
            end
            continue
        end
        if kind == "createtext" is
            a.dom = dom::create_text(a.dom, jsonlite::get_str(op, "v"))
            let real: int = array_len(a.dom.nodes) - 1
            let prov: int = jsonlite::get_int(op, "p")
            if prov >= 1000000 is
                let idx: int = prov - 1000000
                while array_len(a.js_map) <= idx is a.js_map = array_push(a.js_map, -1) end
                a.js_map[idx] = real
                remap = if remap == "" then "[" + to_string(prov) + "," + to_string(real) + "]" else remap + ",[" + to_string(prov) + "," + to_string(real) + "]"
            end
            continue
        end
        if kind == "append" is
            let parent: int = n
            let child: int = js_node(a, jsonlite::get_int(op, "c"))
            let before: int = js_node(a, jsonlite::get_int(op, "b"))
            if parent >= 0 && child >= 0 is a.dom = dom::append_child(a.dom, parent, child, before) end
            continue
        end
        if n < 0 is continue end
        if kind == "text" is
            a.dom = dom::set_text(a.dom, n, jsonlite::get_str(op, "v"))
        elsif kind == "html" is
            a.dom = dom::set_inner_html(a.dom, n, template::substitute(jsonlite::get_str(op, "v"), a.store))
            subtrees = array_push(subtrees, n)
        elsif kind == "attr" is
            let name: string = jsonlite::get_str(op, "k")
            a.dom = dom::set_attr(a.dom, n, name, jsonlite::get_str(op, "v"))
            if name == "disabled" || name == "checked" || name == "readonly" is
                let on: bool = jsonlite::get_str(op, "v") != "false"
                if !on is a.dom = dom::remove_attr(a.dom, n, name) end
            end
        elsif kind == "rattr" is
            a.dom = dom::remove_attr(a.dom, n, jsonlite::get_str(op, "k"))
        elsif kind == "value" is
            a.dom = dom::set_attr(a.dom, n, "value", jsonlite::get_str(op, "v"))
            if a.focused_node == n is
                a.cursor_pos = string_len(jsonlite::get_str(op, "v"))
                a.anchor_pos = a.cursor_pos
            end
        elsif kind == "remove" is
            if a.focused_node == n is a = blur_current(a) end
            a.dom = dom::remove_node(a.dom, n)
        elsif kind == "focus" is
            a = focus_node(a, n)
        elsif kind == "blur" is
            if a.focused_node == n is a = blur_current(a) end
        elsif kind == "click" is
            a = do_click(a, n, a.mouse_x, a.mouse_y)
        elsif kind == "scroll" is
            if n == 0 is
                a.scroll_y = jsonlite::get_int(op, "v")
            else is
                a.elem_scroll = set_pair(a.elem_scroll, n, jsonlite::get_int(op, "v"))
            end
        end
    end
    a.dirty_layout = true
    return DomOpsRes { app: a, remap: remap, subtrees: subtrees }
end

fn set_pair(pairs: [int], id: int, val: int) -> [int] is
    let mut out: [int] = []
    let mut found: bool = false
    let mut i: int = 0
    while i + 1 < array_len(pairs) is
        if pairs[i] == id is
            out = array_push(out, id)
            out = array_push(out, val)
            found = true
        else is
            out = array_push(out, pairs[i])
            out = array_push(out, pairs[i + 1])
        end
        i += 2
    end
    if !found is
        out = array_push(out, id)
        out = array_push(out, val)
    end
    return out
end

fn get_pair(pairs: [int], id: int) -> int is
    let mut i: int = 0
    while i + 1 < array_len(pairs) is
        if pairs[i] == id is return pairs[i + 1] end
        i += 2
    end
    return 0
end

;; ---------- wbudowane komendy dla JS ----------
fn builtin_fetch(args: string) -> string is
    let url: string = jsonlite::get_str(args, "url")
    let method: string = string_upper(jsonlite::get_str(args, "method"))
    let body: string = jsonlite::get_str(args, "body")
    let mut r: string = jsonlite::object()
    if url == "" is
        return ipc::error_json("invalid_args", "fetch: brak url")
    end
    if method == "" || method == "GET" is
        let resp = http::get_full(url)
        r = jsonlite::set_int(r, "status", resp.status)
        r = jsonlite::set_bool(r, "ok", resp.status >= 200 && resp.status < 300)
        r = jsonlite::set_str(r, "body", resp.body)
        return r
    end
    if method == "POST" is
        let resp = http::post_full(url, body)
        r = jsonlite::set_int(r, "status", resp.status)
        r = jsonlite::set_bool(r, "ok", resp.status >= 200 && resp.status < 300)
        r = jsonlite::set_str(r, "body", resp.body)
        return r
    end
    let text: string = if method == "PUT" then http::put(url, body) else http::delete(url)
    r = jsonlite::set_int(r, "status", 200)
    r = jsonlite::set_bool(r, "ok", true)
    r = jsonlite::set_str(r, "body", text)
    return r
end

fn builtin_window(a0: App, args: string) -> App is
    let mut a: App = a0
    let op: string = jsonlite::get_str(args, "op")
    if op == "title" is
        window::set_title(a.win, jsonlite::get_str(args, "title"))
    elsif op == "fullscreen" is
        window::set_fullscreen(a.win, jsonlite::get_bool(args, "on"))
    elsif op == "size" is
        window::set_size(a.win, jsonlite::get_int(args, "w"), jsonlite::get_int(args, "h"))
    elsif op == "min_size" is
        window::set_min_size(a.win, jsonlite::get_int(args, "w"), jsonlite::get_int(args, "h"))
    elsif op == "position" is
        window::set_position(a.win, jsonlite::get_int(args, "x"), jsonlite::get_int(args, "y"))
    elsif op == "maximize" is
        window::maximize(a.win)
    elsif op == "minimize" is
        window::minimize(a.win)
    elsif op == "restore" is
        window::restore(a.win)
    elsif op == "close" is
        a.running = false
    elsif op == "icon" is
        window::set_icon(a.win, jsonlite::get_str(args, "path"))
    elsif op == "opacity" is
        window::set_opacity(a.win, jsonlite::get_int(args, "pct"))
    elsif op == "always_on_top" is
        window::set_always_on_top(a.win, jsonlite::get_bool(args, "on"))
    elsif op == "decorations" is
        window::set_decorations(a.win, jsonlite::get_bool(args, "on"))
    elsif op == "notify" is
        window::notify(jsonlite::get_str(args, "title"), jsonlite::get_str(args, "body"))
    end
    return a
end

fn builtin_dialog(args: string) -> string is
    let kind: string = jsonlite::get_str(args, "kind")
    let title: string = jsonlite::get_str(args, "title")
    let mut r: string = jsonlite::object()
    if kind == "open" is
        return jsonlite::set_str(r, "path", ffi_dialogs::silver_dialog_open_file_ex(title, jsonlite::get_str(args, "desc"),
               jsonlite::get_str(args, "pattern"), jsonlite::get_str(args, "dir")))
    end
    if kind == "open_multi" is
        return jsonlite::set_str(r, "paths", ffi_dialogs::silver_dialog_open_files(title, jsonlite::get_str(args, "desc"),
               jsonlite::get_str(args, "pattern"), jsonlite::get_str(args, "dir")))
    end
    if kind == "save" is
        return jsonlite::set_str(r, "path", ffi_dialogs::silver_dialog_save_file_ex(title, jsonlite::get_str(args, "name"),
               jsonlite::get_str(args, "desc"), jsonlite::get_str(args, "pattern")))
    end
    if kind == "folder" is
        return jsonlite::set_str(r, "path", ffi_dialogs::silver_dialog_open_folder_ex(title, jsonlite::get_str(args, "dir")))
    end
    if kind == "message" || kind == "confirm" is
        let level: string = if kind == "confirm" then "question" else jsonlite::get_str(args, "level")
        let ok: bool = ffi_dialogs::silver_dialog_message(title, jsonlite::get_str(args, "text"), if level == "" then "info" else level)
        return jsonlite::set_bool(r, "ok", ok)
    end
    return ipc::error_json("invalid_args", "dialog: nieznany rodzaj " + kind)
end

;; Obsługa jednego wywołania silver.invoke() z JS.
fn handle_js_invoke(a0: App, raw: string) -> App is
    let parts: [string] = string_split(raw, "\u0001")
    if array_len(parts) < 3 is return a0 end
    let call_id: string = parts[0]
    let cmd: string = parts[1]
    let args: string = parts[2]
    let mut a: App = a0
    let h: int = a.js_handle
    if cmd == "__dom" is
        let res: DomOpsRes = apply_dom_ops(a, jsonlite::get_raw(args, "ops"))
        a = res.app
        if res.remap != "" is
            js::js_emit(h, "__dom_remap", "{\"map\":[" + res.remap + "]}")
        end
        let mut i: int = 0
        while i < array_len(res.subtrees) is
            js::js_emit(h, "__dom_subtree", "{\"n\":" + to_string(res.subtrees[i]) + ",\"nodes\":" + subtree_json(a.dom, res.subtrees[i]) + "}")
            i += 1
        end
        js::js_resolve(h, call_id, "{}")
        return a
    end
    if cmd == "__fetch" is
        js::js_resolve(h, call_id, builtin_fetch(args))
        return a
    end
    if cmd == "__window" is
        a = builtin_window(a, args)
        js::js_resolve(h, call_id, "{}")
        return a
    end
    if cmd == "__dialog" is
        js::js_resolve(h, call_id, builtin_dialog(args))
        return a
    end
    if cmd == "__clip" is
        if jsonlite::get_str(args, "op") == "set" is
            window::clipboard_set(jsonlite::get_str(args, "text"))
            js::js_resolve(h, call_id, "{}")
        else is
            js::js_resolve(h, call_id, jsonlite::set_str(jsonlite::object(), "text", window::clipboard_get()))
        end
        return a
    end
    let res: CmdRes = exec_command(a, cmd, args, "js")
    a = res.app
    if ipc::is_error(res.result) is
        js::js_reject(h, call_id, jsonlite::get_str(res.result, "error"))
    else is
        js::js_resolve(h, call_id, if res.result == "" then "null" else res.result)
    end
    return a
end

;; Jedna runda mostu JS: timery + Promise + wywołania z kolejki.
fn pump_js(a0: App) -> App is
    let mut a: App = a0
    if a.js_handle < 0 is return a end
    js::js_tick(a.js_handle)
    let mut guard: int = 0
    while guard < 128 is
        guard += 1
        let raw: string = js::js_poll_invoke(a.js_handle)
        if raw == "" is break end
        a = handle_js_invoke(a, raw)
        js::js_tick(a.js_handle)
    end
    return a
end

