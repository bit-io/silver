fn on_key_down(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    let node: int = a.focused_node
    let payload: string = key_payload(ev)
    dom_event(a, "keydown", if node >= 0 then node else 0, payload)
    a = fire_hook(a, "keydown", payload)
    ;; on-keydown na polu z fokusem lub jego przodkach
    let mut cur: int = node
    while cur >= 0 is
        if a.dom.nodes[cur].on_keydown != "" is
            a = invoke_html(a, a.dom.nodes[cur].on_keydown, event_args(a, cur, "key", key_name(ev.code)))
            break
        end
        cur = a.dom.nodes[cur].parent
    end
    let cmd: bool = (ev.mods / 2) % 2 == 1 || (ev.mods / 8) % 2 == 1
    let shift: bool = ev.mods % 2 == 1
    let code: int = ev.code
    if node >= 0 && is_text_field(a.dom.nodes[node]) is
        return field_key(a, node, code, cmd, shift, ev)
    end
    if code == 9 is
        return focus_node(a, next_focus(a, !shift))
    end
    if node >= 0 && (code == 13 || code == 32 || code == 1073741912) is
        let n: dom::DomNode = a.dom.nodes[node]
        if n.tag != "select" || code != 32 is return do_click(a, node, a.mouse_x, a.mouse_y) end
        return cycle_select(a, node, 1)
    end
    if node >= 0 && a.dom.nodes[node].tag == "select" && (code == 1073741905 || code == 1073741903) is return cycle_select(a, node, 1) end
    if node >= 0 && a.dom.nodes[node].tag == "select" && (code == 1073741906 || code == 1073741904) is return cycle_select(a, node, 0 - 1) end
    if code == 27 is return blur_current(a) end
    if code == 1073741906 is return scroll_page_to(a, a.scroll_y - 40) end
    if code == 1073741905 is return scroll_page_to(a, a.scroll_y + 40) end
    if code == 1073741899 is return scroll_page_to(a, a.scroll_y - a.viewport_h + 40) end
    if code == 1073741902 || (code == 32 && !shift) is return scroll_page_to(a, a.scroll_y + a.viewport_h - 40) end
    if code == 1073741898 && cmd is return scroll_page_to(a, 0) end
    if code == 1073741901 && cmd is return scroll_page_to(a, max_page_scroll(a)) end
    return a
end

fn apply_move(a0: App, e: edit::Edit) -> App is
    let mut a: App = a0
    a.cursor_pos = e.cursor
    a.anchor_pos = e.anchor
    return reset_caret(a)
end

fn field_key(a0: App, node: int, code: int, cmd: bool, shift: bool, ev: window::InputEvent) -> App is
    let mut a: App = a0
    let n: dom::DomNode = a.dom.nodes[node]
    let multiline: bool = n.tag == "textarea"
    let e: edit::Edit = field_edit(a)
    let editable: bool = !n.disabled && !n.readonly
    if code == 27 is return blur_current(a) end
    if code == 9 is return focus_node(a, next_focus(a, !shift)) end
    if cmd && code == 97 is return apply_move(a, edit::select_all(e)) end
    if cmd && code == 99 is
        if edit::has_selection(e) is window::clipboard_set(edit::selected_text(e)) end
        return a
    end
    if cmd && code == 120 is
        if edit::has_selection(e) && editable is
            window::clipboard_set(edit::selected_text(e))
            return commit_edit(a, edit::delete_selection(e))
        end
        return a
    end
    if cmd && code == 118 is
        if editable is return insert_text(a, window::clipboard_get()) end
        return a
    end
    if code == 8 && editable is return commit_edit(a, edit::backspace(e, cmd)) end
    if code == 127 && editable is return commit_edit(a, edit::delete_forward(e, cmd)) end
    if code == 1073741904 is return apply_move(a, edit::move_left(e, cmd, shift)) end
    if code == 1073741903 is return apply_move(a, edit::move_right(e, cmd, shift)) end
    if code == 1073741898 is return apply_move(a, edit::move_home(e, shift, multiline && !cmd)) end
    if code == 1073741901 is return apply_move(a, edit::move_end(e, shift, multiline && !cmd)) end
    if multiline && code == 1073741906 is return apply_move(a, edit::move_vertical(e, 0 - 1, shift)) end
    if multiline && code == 1073741905 is return apply_move(a, edit::move_vertical(e, 1, shift)) end
    if code == 13 || code == 1073741912 is
        if multiline && editable is return insert_text(a, "\n") end
        return submit_form(a, node)
    end
    return a
end

fn on_text(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    if a.focused_node < 0 is return a end
    return insert_text(a, ev.text)
end

fn on_text_edit(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    if a.focused_node < 0 is return a end
    a.ime = ev.text
    a.dirty_paint = true
    return a
end

fn on_drop(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    let mut j: string = jsonlite::set_str(jsonlite::object(), if ev.kind == "drop_file" then "path" else "text", ev.text)
    j = jsonlite::set_int(jsonlite::set_int(j, "x", a.mouse_x), "y", a.mouse_y)
    let hit: int = node_or_neg(a, paint::hit_test_at(a.boxes, a.mouse_x, a.mouse_y, a.scroll_y))
    dom_event(a, "drop", if hit >= 0 then hit else 0, j)
    emit(a, "silver://drop", j)
    return fire_hook(a, ev.kind, j)
end

fn on_resize(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    a.viewport_w = ev.x
    a.viewport_h = ev.y
    a.dirty_layout = true
    let mut j: string = jsonlite::set_int(jsonlite::object(), "w", ev.x)
    j = jsonlite::set_int(j, "h", ev.y)
    j = jsonlite::set_int(j, "scale", ev.code)
    dom_event(a, "resize", 0, j)
    return fire_hook(a, "resize", j)
end

fn handle_event(a0: App, ev: window::InputEvent) -> App is
    let k: string = ev.kind
    if k == "mouse_move" is return on_mouse_move(a0, ev) end
    if k == "mouse_down" is return on_mouse_down(a0, ev) end
    if k == "mouse_up" is return on_mouse_up(a0, ev) end
    if k == "key_down" is return on_key_down(a0, ev) end
    if k == "text" is return on_text(a0, ev) end
    if k == "text_edit" is return on_text_edit(a0, ev) end
    if k == "scroll" is return on_scroll(a0, ev) end
    if k == "resize" is return on_resize(a0, ev) end
    if k == "drop_file" || k == "drop_text" is return on_drop(a0, ev) end
    let mut a: App = a0
    if k == "quit" is
        a.running = false
    elsif k == "key_up" is
        dom_event(a, "keyup", if a.focused_node >= 0 then a.focused_node else 0, key_payload(ev))
    elsif k == "focus_gained" is
        a.has_focus = true
        a = reset_caret(a)
        a = fire_hook(a, "window_focus", "{}")
        emit(a, "silver://focus", "{}")
    elsif k == "focus_lost" is
        a.has_focus = false
        a.dirty_paint = true
        a = fire_hook(a, "window_blur", "{}")
        emit(a, "silver://blur", "{}")
    elsif k == "mouse_leave" is
        if a.hovered_node >= 0 is
            dom_event(a, "mouseleave", a.hovered_node, "")
            a.hovered_node = -1
            if a.state_css is a.dirty_layout = true end
            a.dirty_paint = true
        end
    elsif k == "expose" is
        a.dirty_paint = true
    end
    return a
end

;; ---------- układ, przejścia, render ----------
fn same_color(x: style::Color, y: style::Color) -> bool is
    return x.r == y.r && x.g == y.g && x.b == y.b && x.a == y.a
end

fn lerp_color(x: style::Color, y: style::Color, t: int) -> style::Color is
    return style::Color { r: x.r + (y.r - x.r) * t / 1000, g: x.g + (y.g - x.g) * t / 1000,
                          b: x.b + (y.b - x.b) * t / 1000, a: x.a + (y.a - x.a) * t / 1000 }
end

fn find_anim(anims: [Anim], node: int) -> int is
    let mut i: int = 0
    while i < array_len(anims) is
        if anims[i].node == node is return i end
        i += 1
    end
    return -1
end

;; wartości aktualnie WYŚWIETLANE dla węzła (z uwzględnieniem trwającej animacji)
fn displayed_bg(a: App, node: int, target: style::Color, now: int) -> style::Color is
    let k: int = find_anim(a.anims, node)
    if k < 0 is return target end
    let an: Anim = a.anims[k]
    let t: int = if an.dur > 0 then (now - an.start) * 1000 / an.dur else 1000
    if t >= 1000 is return target end
    return lerp_color(an.from_bg, target, t)
end

;; Wykrywa zmiany bg/color/opacity elementów z `transition` i uruchamia animacje.
fn detect_transitions(a0: App, now: int) -> App is
    let mut a: App = a0
    let n: int = array_len(a.dom.nodes)
    let had_prev: bool = array_len(a.prev_bg) == n
    let mut nbg: [style::Color] = []
    let mut nfg: [style::Color] = []
    let mut nop: [int] = []
    let mut i: int = 0
    while i < n is
        nbg = array_push(nbg, style::transparent())
        nfg = array_push(nfg, style::black())
        nop = array_push(nop, 100)
        i += 1
    end
    i = 0
    while i < array_len(a.boxes) is
        let b: layout::LayoutBox = a.boxes[i]
        i += 1
        if b.kind != "box" || b.node_id >= n is continue end
        let st: style::ComputedStyle = b.st
        let target_bg: style::Color = if st.has_bg then st.background else style::transparent()
        nbg[b.node_id] = target_bg
        nfg[b.node_id] = st.color
        nop[b.node_id] = st.opacity
        if had_prev && st.trans_ms > 0 is
            let changed: bool = !same_color(a.prev_bg[b.node_id], target_bg) || !same_color(a.prev_fg[b.node_id], st.color) ||
                                a.prev_op[b.node_id] != st.opacity
            if changed is
                let cur_bg: style::Color = displayed_bg(a, b.node_id, a.prev_bg[b.node_id], now)
                let k: int = find_anim(a.anims, b.node_id)
                let mut from_fg: style::Color = a.prev_fg[b.node_id]
                let mut from_op: int = a.prev_op[b.node_id]
                if k >= 0 is
                    from_fg = a.anims[k].from_fg
                    from_op = a.anims[k].from_op
                end
                let an: Anim = Anim { node: b.node_id, start: now, dur: st.trans_ms, from_bg: cur_bg, from_fg: from_fg, from_op: from_op }
                if k >= 0 is
                    a.anims[k] = an
                else is
                    a.anims = array_push(a.anims, an)
                end
            end
        end
    end
    a.prev_bg = nbg
    a.prev_fg = nfg
    a.prev_op = nop
    return a
end

;; Kopia boxów z nałożonymi trwającymi animacjami; usuwa zakończone.
fn animated_boxes(a0: App, now: int) -> [layout::LayoutBox] is
    let a: App = a0
    if array_len(a.anims) == 0 is return a.boxes end
    let mut out: [layout::LayoutBox] = a.boxes
    let mut i: int = 0
    while i < array_len(out) is
        let k: int = find_anim(a.anims, out[i].node_id)
        if k >= 0 is
            let an: Anim = a.anims[k]
            let t: int = if an.dur > 0 then (now - an.start) * 1000 / an.dur else 1000
            if t < 1000 is
                let st: style::ComputedStyle = out[i].st
                let target_bg: style::Color = if st.has_bg then st.background else style::transparent()
                out[i].st.background = lerp_color(an.from_bg, target_bg, t)
                out[i].st.has_bg = out[i].st.background.a > 0
                out[i].st.color = lerp_color(an.from_fg, st.color, t)
                out[i].st.opacity = an.from_op + (st.opacity - an.from_op) * t / 1000
            end
        end
        i += 1
    end
    return out
end

fn prune_anims(a0: App, now: int) -> App is
    let mut a: App = a0
    if array_len(a.anims) == 0 is return a end
    let mut keep: [Anim] = []
    let mut i: int = 0
    while i < array_len(a.anims) is
        let an: Anim = a.anims[i]
        if now - an.start < an.dur is keep = array_push(keep, an) end
        i += 1
    end
    a.anims = keep
    return a
end

fn interaction_state(a: App) -> css::InteractionState is
    let mut ix: css::InteractionState = css::interaction(a.hovered_node, a.focused_node, a.active_node)
    ix.viewport_w = a.viewport_w
    ix.viewport_h = a.viewport_h
    ix.dark = a.dark
    return ix
end

fn page_background(a: App) -> style::Color is
    let mut i: int = 0
    let mut found: bool = false
    let mut col: style::Color = if a.dark then style::Color { r: 32, g: 33, b: 36, a: 255 } else a.bg
    while i < array_len(a.boxes) is
        let b: layout::LayoutBox = a.boxes[i]
        i += 1
        if b.kind != "box" || !b.st.has_bg is continue end
        let tag: string = a.dom.nodes[b.node_id].tag
        if tag == "html" || tag == "body" is
            col = b.st.background
            found = true
        end
    end
    return col
end

fn relayout(a0: App, now: int) -> App is
    let mut a: App = a0
    a.viewport_w = window::ffi_width(a.win)
    a.viewport_h = window::ffi_height(a.win)
    let res: layout::LayoutResult = layout::layout_full(a.dom, a.sheet, a.viewport_w, a.viewport_h, a.win.handle,
                                                        interaction_state(a), a.elem_scroll)
    a.boxes = res.boxes
    a.doc_h = res.height
    let mx: int = max_page_scroll(a)
    if a.scroll_y > mx is a.scroll_y = mx end
    a.dirty_layout = false
    a.dirty_paint = true
    a = detect_transitions(a, now)
    ;; IME: podpowiedz pozycję pola
    if a.focused_node >= 0 && a.focused_node < array_len(a.dom.nodes) is
        let b: layout::LayoutBox = box_of(a, a.focused_node)
        window::set_ime_rect(a.win, b.x, b.y - a.scroll_y, b.w, b.h)
    end
    return a
end

fn render_frame(a0: App, now: int) -> App is
    let mut a: App = a0
    let phase: bool = ((now - a.caret_t0) / 530) % 2 == 0
    let rs: paint::RenderState = paint::RenderState {
        scroll_y: a.scroll_y, focused: a.focused_node, cursor: a.cursor_pos, anchor: a.anchor_pos,
        caret_on: phase && a.has_focus, ime: a.ime, hovered: a.hovered_node, viewport_h: a.viewport_h
    }
    a.caret_phase = phase
    let boxes: [layout::LayoutBox] = animated_boxes(a, now)
    paint::render(a.win.handle, boxes, a.dom, rs, page_background(a))
    window::present(a.win)
    a.dirty_paint = false
    return prune_anims(a, now)
end

;; ---------- motyw, hot reload, zadania ----------
fn update_theme(a0: App, now: int) -> App is
    let mut a: App = a0
    if now - a.last_theme < 1500 && a.last_theme != 0 is return a end
    a.last_theme = if now == 0 then 1 else now
    let sys: string = if a.theme == "auto" then window::system_theme() else a.theme
    let dark: bool = sys == "dark"
    if dark != a.dark is
        a.dark = dark
        a.dirty_layout = true
    end
    return a
end

fn dev_reload(a0: App, now: int) -> App is
    let mut a: App = a0
    if !a.dev_mode || now - a.last_dev < 400 is return a end
    a.last_dev = now
    let cur: [int] = collect_mtimes(a)
    if array_len(cur) != array_len(a.mtimes) is
        a.mtimes = cur
        return a
    end
    let mut html_changed: bool = false
    let mut css_changed: bool = false
    let mut js_changed: bool = false
    let mut i: int = 0
    while i < array_len(cur) is
        if cur[i] != a.mtimes[i] is
            if i == 0 is
                html_changed = true
            elsif i <= array_len(a.css_files) is
                css_changed = true
            else is
                js_changed = true
            end
        end
        i += 1
    end
    if !html_changed && !css_changed && !js_changed is return a end
    log::info("silver: hot reload")
    a.mtimes = cur
    let focus_id: string = node_attr_id_or_empty(a.dom, a.focused_node)
    if html_changed is
        let saved_scroll: int = a.scroll_y
        a = load_html(a, a.html_path)
        a.scroll_y = saved_scroll
    elsif css_changed is
        a = rebuild_sheet(a)
    end
    if html_changed || js_changed is
        if a.js_handle >= 0 || array_len(a.js_files) > 0 || array_len(a.dom.scripts) > 0 || a.dom.inline_js != "" is
            a.js_inline_done = false
            a = restart_js(a)
        end
    end
    if focus_id != "" is a = focus_node(a, dom::find_by_id(a.dom, focus_id)) end
    return a
end

;; Zadanie w tle: uruchamia polecenie powłoki; po zakończeniu emituje "silver://task"
;; i (opcjonalnie) wywołuje komendę routera z {"id","output"}.
pub fn spawn_task(app: App, id: string, shell_command: string, done_command: string) -> App is
    let mut a: App = app
    let handle: string = async_::spawn(shell_command)
    a.tasks = array_push(a.tasks, Task { id: id, handle: handle, command: done_command })
    return a
end

fn poll_tasks(a0: App) -> App is
    let mut a: App = a0
    if array_len(a.tasks) == 0 is return a end
    let mut remaining: [Task] = []
    let mut i: int = 0
    while i < array_len(a.tasks) is
        let t: Task = a.tasks[i]
        i += 1
        let r = async_::timeout(t.handle, 0)
        if !r.ready is
            remaining = array_push(remaining, t)
            continue
        end
        let mut j: string = jsonlite::set_str(jsonlite::object(), "id", t.id)
        j = jsonlite::set_str(j, "output", r.value)
        emit(a, "silver://task", j)
        a = fire_hook(a, "task", j)
        a.tasks = remaining
        if t.command != "" is a = invoke_html(a, t.command, j) end
        remaining = a.tasks
    end
    a.tasks = remaining
    return a
end

;; ---------- krok pętli ----------
fn run_tick(a0: App, now: int) -> App is
    let mut a: App = a0
    if a.tick_ms <= 0 is return a end
    if now - a.last_tick < a.tick_ms is return a end
    a.last_tick = now
    return a.on_tick(a)
end

;; Ile ms można maksymalnie czekać na zdarzenie.
pub fn next_wait_ms(a: App, now: int) -> int is
    let mut wait: int = 500
    if a.tick_ms > 0 && a.tick_ms < wait is wait = a.tick_ms end
    if array_len(a.anims) > 0 is wait = 8 end
    if a.focused_node >= 0 && a.has_focus && wait > 60 is wait = 60 end
    if a.dev_mode && wait > 200 is wait = 200 end
    if array_len(a.tasks) > 0 && wait > 30 is wait = 30 end
    if a.js_handle >= 0 is
        let t: int = js::js_next_timer_ms(a.js_handle)
        if t >= 0 && t < wait is
            wait = t
            if wait < 1 is wait = 1 end
        end
        if js::js_has_jobs(a.js_handle) is wait = 1 end
    end
    if a.dirty_layout || a.dirty_paint is wait = 1 end
    return wait
end

pub fn step(a0: App, wait_ms: int) -> App is
    let mut a: App = a0
    if wait_ms > 0 is window::wait(wait_ms) end
    let mut ev: window::InputEvent = window::poll(a.win)
    let mut guard: int = 0
    while ev.kind != "none" && guard < 400 is
        a = handle_event(a, ev)
        guard += 1
        ev = window::poll(a.win)
    end
    let now: int = ffi_shim::silver_ticks()
    a = pump_js(a)
    a = poll_tasks(a)
    a = run_tick(a, now)
    a = update_theme(a, now)
    a = dev_reload(a, now)
    a = pump_js(a)
    if a.dirty_layout is a = relayout(a, now) end
    let blink_changed: bool = a.focused_node >= 0 && a.has_focus && (((now - a.caret_t0) / 530) % 2 == 0) != a.caret_phase
    if a.dirty_paint || array_len(a.anims) > 0 || blink_changed is
        a = render_frame(a, now)
    end
    if !window::is_open(a.win) is a.running = false end
    return a
end

fn prepare(a0: App) -> App is
    let mut a: App = a0
    a.running = true
    a.viewport_w = window::ffi_width(a.win)
    a.viewport_h = window::ffi_height(a.win)
    a.last_tick = ffi_shim::silver_ticks()
    a.mtimes = collect_mtimes(a)
    a = update_theme(a, ffi_shim::silver_ticks())
    if array_len(a.boxes) == 0 is a = relayout(a, ffi_shim::silver_ticks()) end
    a = start_js_if_needed(a)
    a = fire_hook(a, "ready", "{}")
    return a
end

fn finish(a0: App) -> App is
    let mut a: App = a0
    if a.js_handle >= 0 is
        js::js_shutdown(a.js_handle)
        a.js_handle = -1
    end
    if a.win.open is window::close(a.win) end
    a.running = false
    return a
end

;; Główna pętla jednego okna.
pub fn run(app: App) -> App is
    let mut a: App = prepare(app)
    while a.running is
        a = step(a, next_wait_ms(a, ffi_shim::silver_ticks()))
    end
    return finish(a)
end

;; Wiele okien: każde to osobny App (własny DOM, komendy, JS). Pętla działa,
;; dopóki otwarte jest choć jedno okno.
pub fn run_all(apps: [App]) -> [App] is
    let mut list: [App] = []
    let mut i: int = 0
    while i < array_len(apps) is
        list = array_push(list, prepare(apps[i]))
        i += 1
    end
    let mut alive: bool = true
    while alive is
        alive = false
        let mut wait: int = 500
        i = 0
        while i < array_len(list) is
            if list[i].running is
                let w: int = next_wait_ms(list[i], ffi_shim::silver_ticks())
                if w < wait is wait = w end
            end
            i += 1
        end
        window::wait(wait)
        i = 0
        while i < array_len(list) is
            if list[i].running is
                list[i] = step(list[i], 0)
                if list[i].running is
                    alive = true
                else is
                    list[i] = finish(list[i])
                end
            end
            i += 1
        end
    end
    return list
end

