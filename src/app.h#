;; ---------- JSON zdarzeń ----------
fn node_attr_id_or_empty(d: dom::Dom, id: int) -> string is
    if id < 0 || id >= array_len(d.nodes) is return "" end
    return d.nodes[id].attr_id
end

;; Argumenty JSON dla komendy wywołanej ze zdarzenia węzła.
fn event_args(a: App, node: int, extra_key: string, extra_val: string) -> string is
    let mut j: string = jsonlite::object()
    if node >= 0 && node < array_len(a.dom.nodes) is
        let n: dom::DomNode = a.dom.nodes[node]
        j = jsonlite::set_str(j, "id", n.attr_id)
        j = jsonlite::set_int(j, "node", node)
        j = jsonlite::set_str(j, "tag", n.tag)
        j = jsonlite::set_str(j, "value", n.attr_value)
        j = jsonlite::set_bool(j, "checked", n.checked)
        j = jsonlite::set_str(j, "name", n.attr_name)
        j = jsonlite::set_raw(j, "data", dom::dataset_json(n))
    end
    if extra_key != "" is
        j = jsonlite::set_str(j, extra_key, extra_val)
    end
    return j
end

pub fn key_name(code: int) -> string is
    if code == 13 || code == 1073741912 is return "Enter" end
    if code == 27 is return "Escape" end
    if code == 8 is return "Backspace" end
    if code == 9 is return "Tab" end
    if code == 127 is return "Delete" end
    if code == 32 is return " " end
    if code == 1073741903 is return "ArrowRight" end
    if code == 1073741904 is return "ArrowLeft" end
    if code == 1073741905 is return "ArrowDown" end
    if code == 1073741906 is return "ArrowUp" end
    if code == 1073741898 is return "Home" end
    if code == 1073741901 is return "End" end
    if code == 1073741899 is return "PageUp" end
    if code == 1073741902 is return "PageDown" end
    if code >= 1073741882 && code <= 1073741893 is return "F" + to_string(code - 1073741881) end
    if code > 32 && code < 127 is return char_code_to_str(code) end
    return "Unidentified"
end

;; ---------- zdarzenia → JS (document.addEventListener) ----------
pub fn emit(app: App, event_name: string, payload_json: string) -> bool is
    if app.js_handle < 0 is return false end
    return js::js_emit(app.js_handle, event_name, payload_json)
end

fn dom_event(a: App, kind: string, node: int, extra: string) -> bool is
    if a.js_handle < 0 is return false end
    let mut j: string = if extra == "" then jsonlite::object() else extra
    j = jsonlite::set_str(j, "type", kind)
    j = jsonlite::set_int(j, "n", node)
    return js::js_emit(a.js_handle, "__dom_event", j)
end

fn mods_json(mods: int) -> string is
    let mut j: string = jsonlite::object()
    j = jsonlite::set_bool(j, "shift", mods % 2 == 1)
    j = jsonlite::set_bool(j, "ctrl", (mods / 2) % 2 == 1)
    j = jsonlite::set_bool(j, "alt", (mods / 4) % 2 == 1)
    j = jsonlite::set_bool(j, "meta", (mods / 8) % 2 == 1)
    return j
end

;; Zdarzenie do hooka H# (on_event) — zawsze po stronie H#.
fn fire_hook(app: App, name: string, payload: string) -> App is
    return app.on_event(app, name, payload)
end

;; ---------- fokus / pola (deklaracje wyprzedzające są niepotrzebne w H#) ----------
struct CmdRes is
    pub app:    App
    pub result: string
end

;; Wykonuje komendę i dyrektywy UI z jej wyniku.
fn exec_command(a0: App, cmd: string, args: string, caller: string) -> CmdRes is
    let raw: string = ipc::dispatch_from(a0.router, cmd, args, caller)
    let mut a: App = a0
    let dirs: [string] = ui::directives(raw)
    let mut i: int = 0
    while i < array_len(dirs) is
        a = apply_directive(a, dirs[i])
        i += 1
    end
    return CmdRes { app: a, result: ui::strip(raw) }
end

;; Komenda wywołana ze zdarzenia HTML (wynik ignorowany).
fn invoke_html(a0: App, cmd: string, args: string) -> App is
    if cmd == "" is return a0 end
    if !ipc::has(a0.router, cmd) is
        log::warn("silver: nieznana komenda '" + cmd + "' (on-* w HTML)")
        return a0
    end
    return exec_command(a0, cmd, args, "html").app
end

fn apply_directive(a0: App, dir: string) -> App is
    let op: string = jsonlite::get_str(dir, "op")
    let id: string = jsonlite::get_str(dir, "id")
    let mut a: App = a0
    if op == "set_text" is return set_text(a, id, jsonlite::get_str(dir, "text")) end
    if op == "set_value" is return set_input_value(a, id, jsonlite::get_str(dir, "value")) end
    if op == "set_html" is return set_html(a, id, jsonlite::get_str(dir, "html")) end
    if op == "set_attr" is return set_attr(a, id, jsonlite::get_str(dir, "name"), jsonlite::get_str(dir, "value")) end
    if op == "add_class" is return add_class(a, id, jsonlite::get_str(dir, "cls")) end
    if op == "remove_class" is return remove_class(a, id, jsonlite::get_str(dir, "cls")) end
    if op == "set_checked" is return set_checked(a, id, jsonlite::get_bool(dir, "checked")) end
    if op == "set_state" is return set_state(a, jsonlite::get_str(dir, "key"), jsonlite::get_str(dir, "value")) end
    if op == "title" is
        window::set_title(a.win, jsonlite::get_str(dir, "title"))
        return a
    end
    if op == "focus" is return focus_node(a, node_by_id(a, id)) end
    if op == "scroll" is
        a.scroll_y = jsonlite::get_int(dir, "y")
        a.dirty_paint = true
        return a
    end
    if op == "notify" is
        window::notify(jsonlite::get_str(dir, "title"), jsonlite::get_str(dir, "body"))
        return a
    end
    if op == "reload" is return rerender(a) end
    if op == "close" is
        a.running = false
        return a
    end
    return a
end

