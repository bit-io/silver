;; Zapisuje wynik edycji do węzła + wywołuje on-input / zdarzenie JS.
fn commit_edit(a0: App, e: edit::Edit) -> App is
    let mut a: App = a0
    let node: int = a.focused_node
    if node < 0 is return a end
    let changed: bool = a.dom.nodes[node].attr_value != e.value
    a.dom.nodes[node].attr_value = e.value
    a.cursor_pos = e.cursor
    a.anchor_pos = e.anchor
    a.ime = ""
    a = reset_caret(a)
    if changed is
        a.dirty_layout = a.dirty_layout || a.dom.nodes[node].tag == "textarea" || a.state_css
        a.dirty_paint = true
        a = invoke_html(a, a.dom.nodes[node].on_input, event_args(a, node, "", ""))
        dom_event(a, "input", node, jsonlite::set_str(jsonlite::object(), "value", e.value))
    end
    return a
end

fn allowed_char(n: dom::DomNode, text: string) -> bool is
    if string_lower(n.attr_type) != "number" is return true end
    let digits: string = "0123456789.-+eE"
    let mut i: int = 0
    while i < string_len(text) is
        if string_find(digits, string_slice(text, i, i + 1)) < 0 is return false end
        i += 1
    end
    return true
end

fn clean_text(text: string, multiline: bool) -> string is
    let mut t: string = string_replace(text, "\r\n", "\n")
    t = string_replace(t, "\r", "\n")
    if !multiline is t = string_replace(t, "\n", " ") end
    return string_replace(t, "\t", "    ")
end

fn insert_text(a0: App, text: string) -> App is
    let mut a: App = a0
    let node: int = a.focused_node
    if node < 0 is return a end
    let n: dom::DomNode = a.dom.nodes[node]
    if !is_text_field(n) || n.disabled || n.readonly is return a end
    let t: string = clean_text(text, n.tag == "textarea")
    if t == "" || !allowed_char(n, t) is return a end
    let e: edit::Edit = field_edit(a)
    let limited: string = edit::clamp_insert(e, t, maxlength_of(n))
    if limited == "" is return a end
    return commit_edit(a, edit::insert(e, limited))
end

;; ---------- układ pola → pozycja kursora ----------
fn box_of(a: App, node: int) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(a.boxes) is
        if a.boxes[i].node_id == node && a.boxes[i].kind == "box" is return a.boxes[i] end
        i += 1
    end
    return layout::no_clip_box(node, 0, 0, 0, 0, style::root_style(), "box")
end

fn font_flags(st: style::ComputedStyle) -> int is
    let mut f: int = 0
    if st.bold is f += 1 end
    if st.italic is f += 2 end
    return f
end

;; Najbliższa granica znaku w `text` dla współrzędnej `local_x`.
fn pos_in_text(a: App, text: string, st: style::ComputedStyle, local_x: int, password: bool) -> int is
    if text == "" || local_x <= 0 is return 0 end
    if password is
        let bw: int = ffi_shim::silver_measure_text_ex(a.win.handle, "•", st.font_size, 0)
        let chars: int = if bw > 0 then (local_x + bw / 2) / bw else 0
        return ffi_shim::silver_utf8_offset(text, chars)
    end
    let flags: int = font_flags(st)
    let cut: int = ffi_shim::silver_text_fit(a.win.handle, text, st.font_size, flags, local_x)
    if cut >= string_len(text) is return string_len(text) end
    let w0: int = ffi_shim::silver_measure_text_ex(a.win.handle, string_slice(text, 0, cut), st.font_size, flags)
    let nxt: int = ffi_shim::silver_utf8_next(text, cut)
    let w1: int = ffi_shim::silver_measure_text_ex(a.win.handle, string_slice(text, 0, nxt), st.font_size, flags)
    if local_x - w0 > (w1 - w0) / 2 is return nxt end
    return cut
end

fn caret_from_point(a: App, node: int, x: int, y: int) -> int is
    let b: layout::LayoutBox = box_of(a, node)
    let st: style::ComputedStyle = b.st
    let n: dom::DomNode = a.dom.nodes[node]
    let ix: int = b.x + st.bl + st.pad_left
    let iw: int = b.w - st.bl - st.br - st.pad_left - st.pad_right
    let doc_y: int = y + a.scroll_y
    if n.tag == "textarea" is
        let lh: int = layout::normal_line_height(st.font_size)
        let t: paint::TaLines = paint::ta_lines(a.win.handle, n.attr_value, st, iw)
        let mut li: int = (doc_y - (b.y + st.bt + st.pad_top)) / lh
        if li < 0 is li = 0 end
        if li >= array_len(t.lines) is li = array_len(t.lines) - 1 end
        let line: string = t.lines[li]
        let col: int = pos_in_text(a, line, st, x - ix, false)
        let mut pos: int = t.starts[li] + col
        if pos > string_len(n.attr_value) is pos = string_len(n.attr_value) end
        return pos
    end
    let password: bool = string_lower(n.attr_type) == "password"
    let mut scroll: int = 0
    if node == a.focused_node is
        let shown: string = string_slice(n.attr_value, 0, a.cursor_pos)
        let cw: int = if password then ffi_shim::silver_utf8_len(shown) * ffi_shim::silver_measure_text_ex(a.win.handle, "•", st.font_size, 0)
                      else ffi_shim::silver_measure_text_ex(a.win.handle, shown, st.font_size, font_flags(st))
        if cw > iw - 2 is scroll = cw - iw + 2 end
    end
    return pos_in_text(a, n.attr_value, st, x - ix + scroll, password)
end

;; ---------- kliknięcia ----------
fn form_of(a: App, node: int) -> int is
    let mut cur: int = node
    while cur >= 0 is
        if a.dom.nodes[cur].tag == "form" is return cur end
        cur = a.dom.nodes[cur].parent
    end
    return -1
end

fn submit_form(a0: App, node: int) -> App is
    let mut a: App = a0
    let form: int = form_of(a, node)
    let mut handler: string = ""
    if form >= 0 is handler = a.dom.nodes[form].on_submit end
    if handler == "" && node >= 0 is handler = a.dom.nodes[node].on_submit end
    a = invoke_html(a, handler, event_args(a, if form >= 0 then form else node, "", ""))
    dom_event(a, "submit", if form >= 0 then form else node, "")
    return a
end

fn uncheck_group(a0: App, node: int) -> App is
    let mut a: App = a0
    let name: string = a.dom.nodes[node].attr_name
    if name == "" is return a end
    let form: int = form_of(a, node)
    let mut i: int = 0
    while i < array_len(a.dom.nodes) is
        let n: dom::DomNode = a.dom.nodes[i]
        if i != node && !n.removed && n.tag == "input" && string_lower(n.attr_type) == "radio" && n.attr_name == name && form_of(a, i) == form is
            a.dom.nodes[i].checked = false
        end
        i += 1
    end
    return a
end

fn toggle_check(a0: App, node: int) -> App is
    let mut a: App = a0
    let n: dom::DomNode = a.dom.nodes[node]
    let radio: bool = string_lower(n.attr_type) == "radio"
    if radio && n.checked is return a end
    a.dom.nodes[node].checked = !n.checked
    if radio is a = uncheck_group(a, node) end
    a.dirty_layout = true
    a = invoke_html(a, n.on_change, event_args(a, node, "", ""))
    dom_event(a, "change", node, jsonlite::set_bool(jsonlite::object(), "checked", a.dom.nodes[node].checked))
    return a
end

;; Wartość opcji (value= albo tekst)
fn option_value(a: App, opt: int) -> string is
    let o: dom::DomNode = a.dom.nodes[opt]
    if o.attr_value != "" is return o.attr_value end
    return dom::text_content(a.dom, opt)
end

fn cycle_select(a0: App, node: int, step_dir: int) -> App is
    let mut a: App = a0
    let n: dom::DomNode = a.dom.nodes[node]
    let mut opts: [int] = []
    let mut i: int = 0
    while i < array_len(n.children) is
        let c: int = n.children[i]
        i += 1
        if a.dom.nodes[c].tag == "option" && !a.dom.nodes[c].removed && !a.dom.nodes[c].disabled is opts = array_push(opts, c) end
    end
    if array_len(opts) == 0 is return a end
    let cur_label: string = paint::select_label(a.dom, node)
    let mut idx: int = 0
    i = 0
    while i < array_len(opts) is
        if dom::text_content(a.dom, opts[i]) == cur_label is idx = i end
        i += 1
    end
    let next: int = (idx + step_dir + array_len(opts)) % array_len(opts)
    a.dom.nodes[node].attr_value = option_value(a, opts[next])
    a.dirty_paint = true
    a = invoke_html(a, n.on_change, event_args(a, node, "", ""))
    dom_event(a, "change", node, jsonlite::set_str(jsonlite::object(), "value", a.dom.nodes[node].attr_value))
    return a
end

fn label_target(a: App, label: int) -> int is
    let f: string = dom::get_attr(a.dom.nodes[label], "for")
    if f != "" is return dom::find_by_id(a.dom, f) end
    let mut stack: [int] = [label]
    while array_len(stack) > 0 is
        let id: int = stack[array_len(stack) - 1]
        let mut rest: [int] = []
        let mut k: int = 0
        while k < array_len(stack) - 1 is
            rest = array_push(rest, stack[k])
            k += 1
        end
        stack = rest
        if id != label && is_focusable(a.dom.nodes[id]) && a.dom.nodes[id].tag != "button" is return id end
        let kids: [int] = a.dom.nodes[id].children
        let mut c: int = array_len(kids) - 1
        while c >= 0 is
            stack = array_push(stack, kids[c])
            c -= 1
        end
    end
    return -1
end

;; Semantyka kliknięcia: widgety formularzy, etykiety, on-click, linki.
fn do_click(a0: App, hit: int, x: int, y: int) -> App is
    let mut a: App = a0
    if hit < 0 || hit >= array_len(a.dom.nodes) is return a end
    let mut pos: string = jsonlite::set_int(jsonlite::object(), "x", x)
    pos = jsonlite::set_int(pos, "y", y)
    dom_event(a, "click", hit, pos)
    a = fire_hook(a, "click", jsonlite::set_int(pos, "node", hit))
    let mut cur: int = hit
    while cur >= 0 is
        let n: dom::DomNode = a.dom.nodes[cur]
        if n.disabled is return a end
        let kind: string = string_lower(n.attr_type)
        if n.tag == "input" && (kind == "checkbox" || kind == "radio") is
            a = focus_node(a, cur)
            a = toggle_check(a, cur)
            return invoke_html(a, n.on_click, event_args(a, cur, "", ""))
        end
        if n.tag == "select" is
            a = focus_node(a, cur)
            return cycle_select(a, cur, 1)
        end
        if n.tag == "label" is
            let t: int = label_target(a, cur)
            if t >= 0 && t != hit is
                let tn: dom::DomNode = a.dom.nodes[t]
                if tn.tag == "input" && (string_lower(tn.attr_type) == "checkbox" || string_lower(tn.attr_type) == "radio") is
                    a = focus_node(a, t)
                    a = toggle_check(a, t)
                elsif is_text_field(tn) is
                    a = focus_node(a, t)
                else is
                    a = do_click(a, t, x, y)
                end
            end
            return invoke_html(a, n.on_click, event_args(a, cur, "", ""))
        end
        if n.tag == "button" || (n.tag == "input" && (kind == "submit" || kind == "button")) is
            a = focus_node(a, cur)
            a = invoke_html(a, n.on_click, event_args(a, cur, "", ""))
            if kind == "submit" || (n.tag == "button" && (dom::get_attr(n, "type") == "" || dom::get_attr(n, "type") == "submit")) is
                if form_of(a, cur) >= 0 is a = submit_form(a, cur) end
            end
            return a
        end
        if n.on_click != "" is
            return invoke_html(a, n.on_click, event_args(a, cur, "", ""))
        end
        if n.tag == "a" && n.attr_href != "" is
            a = fire_hook(a, "link", jsonlite::set_str(jsonlite::object(), "href", n.attr_href))
            emit(a, "silver://link", jsonlite::set_str(jsonlite::object(), "href", n.attr_href))
            return a
        end
        cur = n.parent
    end
    return a
end

;; ---------- mysz ----------
fn node_or_neg(a: App, id: int) -> int is
    if id < 0 || id >= array_len(a.dom.nodes) is return -1 end
    return id
end

fn on_mouse_down(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    a.mouse_x = ev.x
    a.mouse_y = ev.y
    let hit: int = node_or_neg(a, paint::hit_test_at(a.boxes, ev.x, ev.y, a.scroll_y))
    a.active_node = hit
    if ev.code == 1 is
        let target: int = paint::find_handler_node(a.dom, hit, "input")
        if target >= 0 && is_text_field(a.dom.nodes[target]) && !a.dom.nodes[target].disabled is
            a = focus_node(a, target)
            let pos: int = caret_from_point(a, target, ev.x, ev.y)
            let v: string = a.dom.nodes[target].attr_value
            let mut e: edit::Edit = edit::make(v, pos, pos)
            if ev.clicks >= 3 is
                e = edit::select_all(e)
            elsif ev.clicks == 2 is
                e = edit::select_word_at(e, pos)
            elsif ev.mods % 2 == 1 is
                e = edit::make(v, pos, a.anchor_pos)
            end
            a.cursor_pos = e.cursor
            a.anchor_pos = e.anchor
            a.dragging = true
            a = reset_caret(a)
        elsif target < 0 || !is_text_field(a.dom.nodes[target]) is
            let focusable: int = find_focusable_ancestor(a, hit)
            if focusable >= 0 is
                a = focus_node(a, focusable)
            else is
                a = blur_current(a)
            end
        end
    end
    dom_event(a, "mousedown", hit, jsonlite::set_int(jsonlite::set_int(jsonlite::object(), "x", ev.x), "y", ev.y))
    if a.state_css is a.dirty_layout = true end
    a.dirty_paint = true
    return a
end

fn find_focusable_ancestor(a: App, start: int) -> int is
    let mut cur: int = start
    while cur >= 0 is
        if is_focusable(a.dom.nodes[cur]) is return cur end
        cur = a.dom.nodes[cur].parent
    end
    return -1
end

fn on_mouse_up(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    a.mouse_x = ev.x
    a.mouse_y = ev.y
    a.dragging = false
    let hit: int = node_or_neg(a, paint::hit_test_at(a.boxes, ev.x, ev.y, a.scroll_y))
    let started: int = a.active_node
    a.active_node = -1
    dom_event(a, "mouseup", hit, "")
    if ev.code == 1 && hit >= 0 && started >= 0 is
        ;; kliknięcie = puszczenie nad tym samym „obszarem klikalnym” co wciśnięcie
        let h_click: int = paint::find_handler_node(a.dom, hit, "click")
        let s_click: int = paint::find_handler_node(a.dom, started, "click")
        let same_area: bool = hit == started || (h_click >= 0 && h_click == s_click)
        let text_field_press: bool = paint::find_handler_node(a.dom, started, "input") >= 0 && is_text_field(a.dom.nodes[paint::find_handler_node(a.dom, started, "input")])
        if same_area && !text_field_press is
            a = do_click(a, hit, ev.x, ev.y)
        elsif same_area is
            dom_event(a, "click", hit, "")
        end
        if ev.clicks == 2 is dom_event(a, "dblclick", hit, "") end
    end
    if ev.code == 3 is dom_event(a, "contextmenu", hit, "") end
    if a.state_css is a.dirty_layout = true end
    a.dirty_paint = true
    return a
end

fn on_mouse_move(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    a.mouse_x = ev.x
    a.mouse_y = ev.y
    let hit: int = node_or_neg(a, paint::hit_test_at(a.boxes, ev.x, ev.y, a.scroll_y))
    if a.dragging && a.focused_node >= 0 && ev.code % 2 == 1 is
        let pos: int = caret_from_point(a, a.focused_node, ev.x, ev.y)
        if pos != a.cursor_pos is
            a.cursor_pos = pos
            a.dirty_paint = true
            a = reset_caret(a)
        end
    end
    if hit != a.hovered_node is
        let old: int = a.hovered_node
        a.hovered_node = hit
        if old >= 0 is dom_event(a, "mouseleave", old, "") end
        if hit >= 0 is
            dom_event(a, "mouseenter", hit, "")
            let hn: int = paint::find_handler_node(a.dom, hit, "hover")
            if hn >= 0 is
                let prev_hn: int = if old >= 0 then paint::find_handler_node(a.dom, old, "hover") else -1
                if hn != prev_hn is a = invoke_html(a, a.dom.nodes[hn].on_hover, event_args(a, hn, "", "")) end
            end
        end
        if a.state_css is a.dirty_layout = true end
        a.dirty_paint = true
    end
    let mut want: string = paint::cursor_at(a.boxes, ev.x, ev.y, a.scroll_y)
    if hit >= 0 && paint::find_handler_node(a.dom, hit, "input") >= 0 && is_text_field(a.dom.nodes[paint::find_handler_node(a.dom, hit, "input")]) is want = "text" end
    if want != a.cur_cursor is
        a.cur_cursor = want
        window::set_cursor(a.win, want)
    end
    return a
end

fn max_page_scroll(a: App) -> int is
    let m: int = a.doc_h - a.viewport_h
    if m < 0 is return 0 end
    return m
end

fn scroll_page_to(a0: App, y: int) -> App is
    let mut a: App = a0
    let mut v: int = y
    if v > max_page_scroll(a) is v = max_page_scroll(a) end
    if v < 0 is v = 0 end
    if v != a.scroll_y is
        a.scroll_y = v
        a.dirty_paint = true
        dom_event(a, "scroll", 0, jsonlite::set_int(jsonlite::object(), "y", v))
    end
    return a
end

fn on_scroll(a0: App, ev: window::InputEvent) -> App is
    let mut a: App = a0
    let dy: int = 0 - ev.y
    if ev.mods % 2 == 1 && dy == 0 is return a end
    let cont: int = paint::scroll_container_at(a.boxes, a.dom, ev.x, ev.y, a.scroll_y)
    if cont >= 0 is
        let cur: int = get_pair(a.elem_scroll, cont)
        let mx: int = paint::max_scroll_of(a.boxes, cont)
        let target: int = cur + dy
        let clamped: int = if target < 0 then 0 elsif target > mx then mx else target
        if clamped != cur is
            a.elem_scroll = set_pair(a.elem_scroll, cont, clamped)
            a.dirty_layout = true
            dom_event(a, "scroll", cont, jsonlite::set_int(jsonlite::object(), "y", clamped))
            return a
        end
    end
    return scroll_page_to(a, a.scroll_y + dy)
end

;; ---------- klawiatura ----------
fn key_payload(ev: window::InputEvent) -> string is
    let mut j: string = mods_json(ev.mods)
    j = jsonlite::set_str(j, "key", key_name(ev.code))
    j = jsonlite::set_int(j, "code", ev.code)
    j = jsonlite::set_bool(j, "repeat", ev.repeat)
