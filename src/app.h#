;; ---------- stan szablonów ----------
fn sanitize_dom_after_load(app: App) -> App is
    let mut a: App = app
    a.dom = template::apply_state(a.dom, a.store)
    a.dirty_layout = true
    a.prev_bg = []
    a.prev_fg = []
    a.prev_op = []
    return a
end

fn input_values_snapshot(d: dom::Dom) -> [string] is
    ;; pary id,wartość pól z attr_id (zachowanie wartości przy odświeżeniu)
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(d.nodes) is
        let n: dom::DomNode = d.nodes[i]
        i += 1
        if n.removed || n.attr_id == "" is continue end
        if n.tag == "input" || n.tag == "textarea" || n.tag == "select" is
            out = array_push(out, n.attr_id)
            out = array_push(out, if n.checked then "\u0001c" + n.attr_value else n.attr_value)
        end
    end
    return out
end

fn restore_input_values(d0: dom::Dom, snap: [string]) -> dom::Dom is
    let mut d: dom::Dom = d0
    let mut i: int = 0
    while i + 1 < array_len(snap) is
        let id: int = dom::find_by_id(d, snap[i])
        if id >= 0 is
            let v: string = snap[i + 1]
            if string_starts_with(v, "\u0001c") is
                d.nodes[id].checked = true
                d.nodes[id].attr_value = string_slice(v, 2, string_len(v))
            else is
                d.nodes[id].attr_value = v
                if d.nodes[id].tag == "input" && string_lower(d.nodes[id].attr_type) == "checkbox" is d.nodes[id].checked = false end
            end
        end
        i += 2
    end
    return d
end

;; Ponownie buduje DOM z html_src (pętle/warunki wg aktualnego stanu), zachowując pola.
pub fn rerender(app: App) -> App is
    let mut a: App = app
    if a.html_src == "" is return a end
    let snap: [string] = input_values_snapshot(a.dom)
    let parsed: dom::Dom = dom::parse(a.html_src)
    a.dom = template::expand(parsed, a.store)
    a.dom = template::apply_state(a.dom, a.store)
    a.dom = restore_input_values(a.dom, snap)
    a.dirty_layout = true
    if a.focused_node >= array_len(a.dom.nodes) is a.focused_node = -1 end
    return a
end

fn structural_in(html: string) -> bool is
    return string_find(html, " each=") >= 0 || string_find(html, " if=") >= 0 || string_find(html, " if-not=") >= 0
end

pub fn set_state(app: App, key: string, val: string) -> App is
    let mut a: App = app
    if jsonlite::has_key(a.store, key) && jsonlite::get_str(a.store, key) == val is return a end
    a.store = jsonlite::set_str(a.store, key, val)
    if a.has_structural is
        return rerender(a)
    end
    a.dom = template::apply_state(a.dom, a.store)
    a.dirty_layout = true
    return a
end

;; Ustawia klucz na surowy JSON (tablice/obiekty dla each=).
pub fn set_state_json(app: App, key: string, raw_json: string) -> App is
    let mut a: App = app
    a.store = jsonlite::set_raw(a.store, key, raw_json)
    if a.has_structural is
        return rerender(a)
    end
    a.dom = template::apply_state(a.dom, a.store)
    a.dirty_layout = true
    return a
end

pub fn state(app: App, key: string) -> string is
    return jsonlite::get_str(app.store, key)
end

;; ---------- ładowanie HTML / CSS / JS ----------
fn dir_of(path: string) -> string is
    let n: int = string_len(path)
    let mut i: int = n - 1
    while i >= 0 is
        if string_slice(path, i, i + 1) == "/" is return string_slice(path, 0, i + 1) end
        i -= 1
    end
    return ""
end

fn read_file_or_empty(path: string) -> string is
    if !fs::exists(path) is
        log::warn("silver: brak pliku " + path)
        return ""
    end
    return fs::read(path)
end

fn mtime_or_zero(path: string) -> int is
    if path == "" || !fs::exists(path) is return 0 end
    return fs::modified_time(path)
end

;; Składa arkusz: <link rel=stylesheet>, <style> z HTML, potem pliki i teksty aplikacji.
fn rebuild_sheet(app: App) -> App is
    let mut a: App = app
    let mut sheet: css::Stylesheet = css::empty_sheet()
    let base: string = dir_of(a.html_path)
    let mut i: int = 0
    while i < array_len(a.dom.stylesheets) is
        let href: string = a.dom.stylesheets[i]
        let path: string = if string_starts_with(href, "/") || base == "" then href else base + href
        sheet = css::concat(sheet, css::parse(read_file_or_empty(path)))
        i += 1
    end
    if a.dom.inline_css != "" is sheet = css::concat(sheet, css::parse(a.dom.inline_css)) end
    i = 0
    while i < array_len(a.css_files) is
        sheet = css::concat(sheet, css::parse(read_file_or_empty(a.css_files[i])))
        i += 1
    end
    i = 0
    while i < array_len(a.css_texts) is
        sheet = css::concat(sheet, css::parse(a.css_texts[i]))
        i += 1
    end
    a.sheet = sheet
    a.state_css = sheet_uses_state(sheet)
    a.dirty_layout = true
    return a
end

fn sheet_uses_state(sheet: css::Stylesheet) -> bool is
    let mut i: int = 0
    while i < array_len(sheet.rules) is
        let sel: string = sheet.rules[i].selector
        if string_find(sel, ":hover") >= 0 || string_find(sel, ":active") >= 0 || string_find(sel, ":focus") >= 0 is return true end
        i += 1
    end
    return false
end

fn collect_mtimes(app: App) -> [int] is
    let mut out: [int] = [mtime_or_zero(app.html_path)]
    let mut i: int = 0
    while i < array_len(app.css_files) is
        out = array_push(out, mtime_or_zero(app.css_files[i]))
        i += 1
    end
    i = 0
    while i < array_len(app.js_files) is
        out = array_push(out, mtime_or_zero(app.js_files[i]))
        i += 1
    end
    return out
end

pub fn load_html_str(app: App, html: string) -> App is
    let mut a: App = app
    a.html_src = html
    a.has_structural = structural_in(html)
    let parsed: dom::Dom = dom::parse(html)
    a.dom = template::expand(parsed, a.store)
    a = rebuild_sheet(a)
    a = sanitize_dom_after_load(a)
    if a.dom.title != "" && a.win.open is
        window::set_title(a.win, a.dom.title)
    end
    a.focused_node = -1
    a.hovered_node = -1
    a.active_node = -1
    return a
end

pub fn load_html(app: App, path: string) -> App is
    let mut a: App = app
    a.html_path = path
    a = load_html_str(a, read_file_or_empty(path))
    a.mtimes = collect_mtimes(a)
    return a
end

pub fn load_css_str(app: App, css_text: string) -> App is
    let mut a: App = app
    a.css_texts = array_push(a.css_texts, css_text)
    return rebuild_sheet(a)
end

pub fn load_css(app: App, path: string) -> App is
    let mut a: App = app
    a.css_files = array_push(a.css_files, path)
    a.mtimes = collect_mtimes(a)
    return rebuild_sheet(a)
end

