mod ffi_dialogs

pub fn open_file(title: string, filter_desc: string, filter_pattern: string) -> string is
    return ffi_dialogs::silver_dialog_open_file(title, filter_desc, filter_pattern)
end

;; Jak open_file, ze startowym katalogiem/plikiem.
pub fn open_file_in(title: string, filter_desc: string, filter_pattern: string, default_path: string) -> string is
    return ffi_dialogs::silver_dialog_open_file_ex(title, filter_desc, filter_pattern, default_path)
end

;; Wiele plików — ścieżki rozdzielone znakiem nowej linii (użyj string_split(r, "\n")).
pub fn open_files(title: string, filter_desc: string, filter_pattern: string, default_path: string) -> string is
    return ffi_dialogs::silver_dialog_open_files(title, filter_desc, filter_pattern, default_path)
end

pub fn save_file(title: string, default_name: string) -> string is
    return ffi_dialogs::silver_dialog_save_file(title, default_name)
end

pub fn save_file_as(title: string, default_path: string, filter_desc: string, filter_pattern: string) -> string is
    return ffi_dialogs::silver_dialog_save_file_ex(title, default_path, filter_desc, filter_pattern)
end

pub fn open_folder(title: string) -> string is
    return ffi_dialogs::silver_dialog_open_folder(title)
end

pub fn open_folder_in(title: string, default_path: string) -> string is
    return ffi_dialogs::silver_dialog_open_folder_ex(title, default_path)
end

pub fn info(title: string, text: string) is
    ffi_dialogs::silver_dialog_message(title, text, "info")
end

pub fn warning(title: string, text: string) is
    ffi_dialogs::silver_dialog_message(title, text, "warning")
end

pub fn error(title: string, text: string) is
    ffi_dialogs::silver_dialog_message(title, text, "error")
end

pub fn confirm(title: string, text: string) -> bool is
    return ffi_dialogs::silver_dialog_message(title, text, "question")
end
