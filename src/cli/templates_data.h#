    f = array_push(f, "{{\n  \"name\": \"silver-ts-preact-frontend\",\n  \"private\": true,\n  \"version\": \"0.2.0\",\n  \"scripts\": {{\n    \"build\": \"node build.mjs\",\n    \"watch\": \"node build.mjs --watch\",\n    \"typecheck\": \"tsc --noEmit\"\n  }},\n  \"dependencies\": {{ \"preact\": \"^10.19.0\" }},\n  \"devDependencies\": {{ \"esbuild\": \"^0.21.0\", \"typescript\": \"^5.4.0\" }}\n}}\n")
    f = array_push(f, "frontend/style.css")
    f = array_push(f, "* {{ box-sizing: border-box; }}\nbody {{ background: #eef0f6; font-size: 15px; color: #222; }}\n.app {{ max-width: 520px; margin: 24px auto; background: white; border-radius: 14px; padding: 20px; box-shadow: 0 4px 16px rgba(30,40,90,0.15); }}\nheader {{ display: flex; justify-content: space-between; align-items: center; }}\nh1 {{ margin: 0; font-size: 26px; }}\n.clock {{ color: #7a8099; }}\n.search {{ width: 100%; margin: 12px 0 8px 0; }}\n.add {{ display: flex; gap: 8px; margin-bottom: 10px; }}\n.add input {{ flex: 1; }}\nbutton {{ background: #3a5edc; color: white; border-color: #3a5edc; transition: 140ms; }}\nbutton:hover {{ background: #2f4ec0; }}\nul {{ list-style: none; margin: 0; padding: 0; }}\n.note {{ display: flex; align-items: center; gap: 6px; padding: 9px 6px; border-bottom: 1px solid #eee; }}\n.note .text {{ flex: 1; }}\n.note.pinned {{ background: #fff8e0; }}\n.pin, .del {{ background: transparent; color: #666; border-color: transparent; padding: 2px 8px; }}\n.del:hover {{ background: #fde8e8; color: #c33; }}\nfooter {{ color: #888; font-size: 13px; margin-top: 10px; }}\n")
    f = array_push(f, "frontend/tsconfig.json")
    f = array_push(f, "{{\n  \"compilerOptions\": {{\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"lib\": [\"ES2020\", \"DOM\"],\n    \"jsx\": \"react\",\n    \"jsxFactory\": \"h\",\n    \"jsxFragmentFactory\": \"Fragment\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"skipLibCheck\": true,\n    \"types\": []\n  }},\n  \"include\": [\"src\"]\n}}\n")
    f = array_push(f, "frontend/src/api.ts")
    f = array_push(f, "// Typowany cienki wrapper na silver.invoke — jedno miejsce z kontraktem frontend ↔ H#.\nexport interface Note {{ id: number; text: string; pinned: boolean; created: number }}\n\ninterface Commands {{\n  list_notes: {{ args: undefined; result: {{ notes: Note[] }} }};\n  save_notes: {{ args: {{ notes: Note[] }}; result: {{ ok: boolean }} }};\n}}\n\nexport function call<K extends keyof Commands>(\n  cmd: K,\n  ...args: Commands[K]['args'] extends undefined ? [] : [Commands[K]['args']]\n): Promise<Commands[K]['result']> {{\n  return silver.invoke(cmd, args[0] as Record<string, unknown> | undefined);\n}}\n")
    f = array_push(f, "frontend/src/main.tsx")
    f = array_push(f, "import {{ h, render, Fragment }} from 'preact';\nimport {{ useEffect, useMemo, useRef, useState }} from 'preact/hooks';\nimport {{ call, Note }} from './api';\n\nfunction useClock(): string {{\n  const [now, setNow] = useState(new Date());\n  useEffect(() => {{\n    const id = setInterval(() => setNow(new Date()), 1000);\n    return () => clearInterval(id);\n  }}, []);\n  return now.toLocaleTimeString('pl-PL');\n}}\n\nfunction NoteRow(props: {{ note: Note; onToggle: () => void; onDelete: () => void }}) {{\n  const {{ note }} = props;\n  return (\n    <li class={{'note' + (note.pinned ? ' pinned' : '')}}>\n      <span class=\"text\">{{note.text}}</span>\n      <button class=\"pin\" onClick={{props.onToggle}}>{{note.pinned ? '★' : '☆'}}</button>\n      <button class=\"del\" onClick={{props.onDelete}}>✕</button>\n    </li>\n  );\n}}\n\nfunction App() {{\n  const [notes, setNotes] = useState<Note[]>([]);\n  const [draft, setDraft] = useState('');\n  const [query, setQuery] = useState('');\n  const loaded = useRef(false);\n  const clock = useClock();\n\n  useEffect(() => {{ call('list_notes').then(r => {{ setNotes(r.notes); loaded.current = true; }}); }}, []);\n  useEffect(() => {{ if (loaded.current) void call('save_notes', {{ notes }}); }}, [notes]);\n\n  const shown = useMemo(\n    () => notes\n      .filter(n => n.text.toLowerCase().includes(query.toLowerCase()))\n      .sort((a, b) => Number(b.pinned) - Number(a.pinned) || b.created - a.created),\n    [notes, query]);\n\n  function add(e: Event) {{\n    e.preventDefault();\n    const text = draft.trim();\n    if (!text) return;\n    setNotes([...notes, {{ id: Date.now(), text, pinned: false, created: Date.now() }}]);\n    setDraft('');\n  }}\n\n  return (\n    <div class=\"app\">\n      <header><h1>Notatki</h1><span class=\"clock\">{{clock}}</span></header>\n      <input class=\"search\" type=\"text\" placeholder=\"Szukaj…\" value={{query}}\n             onInput={{(e) => setQuery((e.target as HTMLInputElement).value)}} />\n      <form class=\"add\" onSubmit={{add}}>\n        <input type=\"text\" placeholder=\"Nowa notatka\" value={{draft}}\n               onInput={{(e) => setDraft((e.target as HTMLInputElement).value)}} />\n        <button type=\"submit\">Dodaj</button>\n      </form>\n      <ul>\n        {{shown.map(n => (\n          <NoteRow key={{n.id}} note={{n}}\n            onToggle={{() => setNotes(notes.map(x => x.id === n.id ? {{ ...x, pinned: !x.pinned }} : x))}}\n            onDelete={{() => setNotes(notes.filter(x => x.id !== n.id))}} />\n        ))}}\n      </ul>\n      <footer>{{notes.length}} notatek · {{notes.filter(n => n.pinned).length}} przypiętych</footer>\n    </div>\n  );\n}}\n\nrender(<App />, document.getElementById('root')!);\n")
    f = array_push(f, "frontend/src/silver.d.ts")
    f = array_push(f, "/**\n * silver.d.ts — typy globalnego obiektu `silver` (Silver 0.2).\n *\n * Użycie w projekcie TypeScript (frontend/tsconfig.json):\n *     \"lib\": [\"ES2020\", \"DOM\"],  \"types\": [],  \"include\": [\"src\", \"../../types/silver.d.ts\"]\n * albo skopiuj ten plik do frontend/src/. `document`, `window`, `fetch`,\n * `setTimeout` itd. typuje standardowa biblioteka \"DOM\" — Silver ją implementuje\n * w podzbiorze (patrz docs/javascript.md).\n */\n\ninterface SilverDialogFilter {{\n  title?: string;\n  /** opis filtru, np. \"Obrazy\" */\n  description?: string;\n  /** wzorce, np. \"*.png;*.jpg\" */\n  pattern?: string;\n  /** katalog / plik startowy */\n  dir?: string;\n}}\n\ninterface SilverSaveOptions {{\n  title?: string;\n  /** domyślna nazwa pliku */\n  name?: string;\n  description?: string;\n  pattern?: string;\n}}\n\ninterface SilverWindowApi {{\n  setTitle(title: string): Promise<void>;\n  setFullscreen(on: boolean): Promise<void>;\n  setSize(w: number, h: number): Promise<void>;\n  setMinSize(w: number, h: number): Promise<void>;\n  setPosition(x: number, y: number): Promise<void>;\n  maximize(): Promise<void>;\n  minimize(): Promise<void>;\n  restore(): Promise<void>;\n  close(): Promise<void>;\n  setIcon(path: string): Promise<void>;\n  setOpacity(percent: number): Promise<void>;\n  setAlwaysOnTop(on: boolean): Promise<void>;\n  setDecorations(on: boolean): Promise<void>;\n  notify(title: string, body?: string): Promise<void>;\n}}\n\ninterface SilverDialogApi {{\n  open(options?: SilverDialogFilter): Promise<string | null>;\n  openMultiple(options?: SilverDialogFilter): Promise<string[]>;\n  save(options?: SilverSaveOptions): Promise<string | null>;\n  folder(options?: {{ title?: string; dir?: string }}): Promise<string | null>;\n  message(text: string, options?: {{ title?: string; level?: \"info\" | \"warning\" | \"error\" }}): Promise<void>;\n  confirm(text: string, options?: {{ title?: string }}): Promise<boolean>;\n}}\n\ninterface SilverClipboardApi {{\n  readText(): Promise<string>;\n  writeText(text: string): Promise<void>;\n}}\n\ninterface SilverApi {{\n  readonly version: string;\n  /**\n   * Woła komendę zarejestrowaną w H# (`app::command`). Promise jest\n   * odrzucany błędem, gdy komenda nie istnieje, jest zabroniona dla JS\n   * (capabilities) albo brakuje wymaganych argumentów.\n   */\n  invoke<T = any>(command: string, args?: Record<string, unknown>): Promise<T>;\n  /** Zdarzenia z H# (`app::emit`) oraz systemowe: silver://task, silver://drop, silver://focus, silver://blur, silver://link. Zwraca funkcję anulującą. */\n  listen<T = any>(event: string, callback: (payload: T) => void): () => void;\n  once<T = any>(event: string, callback: (payload: T) => void): () => void;\n  readonly window: SilverWindowApi;\n  readonly dialog: SilverDialogApi;\n  readonly clipboard: SilverClipboardApi;\n}}\n\ndeclare const silver: SilverApi;\n\ninterface SilverDropPayload {{ path?: string; text?: string; x: number; y: number }}\ninterface SilverTaskPayload {{ id: string; output: string }}\n")
    f = array_push(f, "src/main.h#")
    f = array_push(f, "use \"bit -> silver\" from \"silver\"\nuse \"std -> fs\"      from \"fs\"\n\n;; Backend w H#: komendy wołane z TypeScriptu przez silver.invoke().\nfn notes_path() -> string is\n    return \"notes.json\"\nend\n\nfn list_notes(args: string) -> string is\n    if !fs::exists(notes_path()) is\n        return \"{{{{\\\"notes\\\": []}}}}\"\n    end\n    return \"{{{{\\\"notes\\\": \" + fs::read(notes_path()) + \"}}}}\"\nend\n\nfn save_notes(args: string) -> string is\n    fs::write(notes_path(), data::get_raw(args, \"notes\"))\n    return \"{{{{\\\"ok\\\": true}}}}\"\nend\n\nfn main() is\n    let mut a = app::new(\"Notatki (TypeScript + Preact)\", 760, 640)\n    a = app::load_html(a, \"frontend/index.html\")\n    a = app::load_css(a, \"frontend/style.css\")\n    a = app::command(a, \"list_notes\", list_notes)\n    a = app::command(a, \"save_notes\", save_notes)\n    ;; zbudowany bundle (esbuild) — patrz frontend/package.json\n    a = app::load_js(a, [\"frontend/dist/app.js\"])\n    a = app::enable_hot_reload(a)\n    app::run(a)\nend\n")
    return f
end

