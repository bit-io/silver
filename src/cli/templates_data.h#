fn files_counter() -> [string] is
    let mut f: [string] = []
    f = array_push(f, "Bit.hk")
    f = array_push(f, "! silver-counter — aplikacja Silver 0.2 (menedżer pakietów: bit)\n[package]\n-> name        => __NAME__\n-> version     => 0.2.0\n-> description => Przykład Silver — licznik (stan w H#, on_tick, JS)\n-> authors     => [\"You <you@example.com>\"]\n-> license     => MIT\n-> lang        => h#\n\n[layout]\n-> src => src\n\n[build]\n-> link => static\n\n[dependencies]\n-> silver => ^0.2\n\n! samo `bit` buduje wydanie i uruchamia aplikację\n[default-build]\n-> profile => release\n-> target  => h#\n-> emit    => bin\n-> run     => true\n\n[commands]\n-> dev\n--> run => bit run\n--> description => Uruchom aplikację\n")
    f = array_push(f, "frontend/app.js")
    f = array_push(f, "// JS w Silver: prawdziwy QuickJS + lustro DOM (document.querySelector…).\n// Komendy H# wołasz przez silver.invoke(), a await działa normalnie.\ndocument.getElementById('reset').addEventListener('click', async () => {{\n  const el = document.getElementById('count');\n  while (Number(el.textContent) !== 0) {{\n    await silver.invoke(Number(el.textContent) > 0 ? 'decrement' : 'increment');\n    await new Promise(r => setTimeout(r, 15));   // setTimeout/Promise działają\n  }}\n}});\n\ndocument.addEventListener('keydown', (e) => {{\n  if (e.key === 'ArrowUp' || e.key === ' ') silver.invoke('increment');\n  if (e.key === 'ArrowDown') silver.invoke('decrement');\n}});\n\nconsole.log('app.js załadowany, Silver', silver.version);\n")
    f = array_push(f, "frontend/index.html")
    f = array_push(f, "<div class=\"page\">\n    <div class=\"card\">\n        <h1>Licznik</h1>\n        <p class=\"count\" id=\"count\">{{{{count}}}}</p>\n        <div class=\"row\">\n            <button class=\"btn\" on-click=\"decrement\">−1</button>\n            <button class=\"btn primary\" on-click=\"increment\">+1</button>\n            <button class=\"btn ghost\" id=\"reset\">reset (JS)</button>\n        </div>\n        <p class=\"hint\" id=\"hint\">Skróty: strzałka ↑ / ↓, spacja = +1</p>\n    </div>\n</div>\n")
    f = array_push(f, "frontend/style.css")
    f = array_push(f, ".page {{ background: #f2f2f5; padding: 24px; min-height: 100vh; }}\n.card {{ background: white; padding: 20px; border: 1px solid #dddddd; border-radius: 12px;\n        box-shadow: 0 2px 8px rgba(0,0,0,0.12); max-width: 360px; margin: 0 auto; text-align: center; }}\nh1 {{ color: #202020; font-size: 24px; margin: 0 0 8px 0; }}\n.count {{ font-size: 56px; font-weight: bold; color: #3a5edc; margin: 8px 0 16px 0; }}\n.row {{ display: flex; gap: 8px; justify-content: center; }}\n.btn {{ padding: 8px 16px; transition: 150ms; }}\n.btn:hover {{ background: #e2e6f8; }}\n.btn.primary {{ background: #3a5edc; color: white; border-color: #3a5edc; }}\n.btn.primary:hover {{ background: #2f4ec0; }}\n.btn.ghost {{ background: transparent; }}\n.hint {{ color: #888888; font-size: 13px; margin-top: 16px; }}\n@media (prefers-color-scheme: dark) {{\n    .page {{ background: #1d1e22; }}\n    .card {{ background: #2a2c33; border-color: #444; }}\n    h1 {{ color: #f0f0f0; }}\n    .btn {{ background: #3a3d46; color: #eeeeee; border-color: #555; }}\n}}\n")
    f = array_push(f, "src/main.h#")
    f = array_push(f, "use \"bit -> silver\" from \"silver\"\nuse \"std -> sync\"    from \"sync\"\n\n;; Stan żyje w H# (atomowy licznik) — widok tylko go pokazuje.\nfn increment(args_json: string) -> string is\n    let n: int = sync::atomic_add(\"counter\", 1)\n    return \"{{{{\\\"count\\\": \\\"\" + to_string(n) + \"\\\"}}}}\"\nend\n\nfn decrement(args_json: string) -> string is\n    let n: int = sync::atomic_add(\"counter\", -1)\n    return \"{{{{\\\"count\\\": \\\"\" + to_string(n) + \"\\\"}}}}\"\nend\n\n;; on_tick jest wołany CYKLICZNIE (co 100 ms), więc zmiana licznika z innego\n;; wątku trafia na ekran bez żadnego kliknięcia.\nfn sync_state(a: app::App) -> app::App is\n    let n: int = sync::atomic_load(\"counter\")\n    return app::set_state(a, \"count\", to_string(n))\nend\n\nfn main() is\n    sync::atomic_new(\"counter\", 0)\n\n    let mut a = app::new(\"Licznik\", 420, 300)\n    a = app::load_html(a, \"frontend/index.html\")\n    a = app::load_css(a, \"frontend/style.css\")\n    a = app::command(a, \"increment\", increment)\n    a = app::command(a, \"decrement\", decrement)\n    a = app::on_tick(a, sync_state)\n    a = app::set_tick_interval(a, 100)\n    a = app::set_state(a, \"count\", \"0\")\n\n    ;; JS: przyciski „reset\" i skrót klawiszowy (patrz frontend/app.js)\n    a = app::load_js(a, [\"frontend/app.js\"])\n    a = app::enable_hot_reload(a)\n    app::run(a)\nend\n")
    return f
end

fn files_dashboard() -> [string] is
    let mut f: [string] = []
    f = array_push(f, "Bit.hk")
    f = array_push(f, "! silver-dashboard — aplikacja Silver 0.2 (menedżer pakietów: bit)\n[package]\n-> name        => __NAME__\n-> version     => 0.2.0\n-> description => Przykład Silver — pulpit: zadania w tle, on_tick, grid, przejścia CSS, wykresy z JS\n-> authors     => [\"You <you@example.com>\"]\n-> license     => MIT\n-> lang        => h#\n\n[layout]\n-> src => src\n\n[build]\n-> link => static\n\n[dependencies]\n-> silver => ^0.2\n\n! samo `bit` buduje wydanie i uruchamia aplikację\n[default-build]\n-> profile => release\n-> target  => h#\n-> emit    => bin\n-> run     => true\n\n[commands]\n-> dev\n--> run => bit run\n--> description => Uruchom aplikację\n")
    f = array_push(f, "frontend/app.js")
    f = array_push(f, "// Pulpit: nawigacja, wykres z <div>, fetch, zadania w tle.\nconst $  = (s) => document.querySelector(s);\nconst $$ = (s) => Array.from(document.querySelectorAll(s));\n\n// --- nawigacja ---\n$$('.nav').forEach(a => a.addEventListener('click', () => {{\n  $$('.nav').forEach(x => x.classList.toggle('active', x === a));\n  $$('.view').forEach(v => v.classList.toggle('hidden', v.id !== a.dataset.view));\n}}));\n\n// --- wykres słupkowy (wysokość = % wartości) ---\nlet data = Array.from({{ length: 12 }}, () => 20 + Math.floor(Math.random() * 80));\nfunction drawChart() {{\n  const chart = $('#chart');\n  chart.innerHTML = '';\n  const max = Math.max(...data);\n  for (const v of data) {{\n    const bar = document.createElement('div');\n    bar.className = 'bar';\n    bar.style.height = Math.round(v / max * 100) + '%';\n    bar.title = String(v);\n    chart.appendChild(bar);\n  }}\n  $('#range').textContent = `min ${{Math.min(...data)}} · max ${{max}}`;\n}}\n$('#shuffle').addEventListener('click', () => {{\n  data = data.map(() => 20 + Math.floor(Math.random() * 80));\n  drawChart();\n}});\n\n// --- animowane liczniki KPI (requestAnimationFrame) ---\nfunction countUp(el, to, ms = 800) {{\n  const t0 = performance.now();\n  (function step(now) {{\n    const k = Math.min(1, (now - t0) / ms);\n    el.textContent = Math.round(to * k).toLocaleString('pl-PL');\n    if (k < 1) requestAnimationFrame(step);\n  }})(t0);\n}}\ncountUp($('#kpi-a'), 12840);\ncountUp($('#kpi-b'), 342);\ncountUp($('#kpi-c'), 28190);\n\n// --- zadanie w tle: H# spawn_task → zdarzenie z wynikiem ---\n$('#run').addEventListener('click', () => {{\n  $('#task-out').textContent = 'Uruchomiono…';\n  silver.invoke('start_task');\n}});\nsilver.listen('silver://task', (p) => {{ $('#task-out').textContent = p.output || '(pusto)'; }});\n\n// --- fetch ---\n$('#fetch').addEventListener('click', async () => {{\n  const out = $('#fetch-out');\n  out.textContent = 'Pobieranie…';\n  try {{\n    const r = await fetch('https://example.com');\n    const text = await r.text();\n    out.textContent = `HTTP ${{r.status}}, ${{text.length}} znaków`;\n  }} catch (e) {{\n    out.textContent = 'Błąd: ' + e.message;\n  }}\n}});\n\ndrawChart();\n")
    f = array_push(f, "frontend/index.html")
    f = array_push(f, "<div class=\"shell\">\n  <aside class=\"side\">\n    <h2>Pulpit</h2>\n    <a class=\"nav active\" data-view=\"overview\">Przegląd</a>\n    <a class=\"nav\" data-view=\"tasks\">Zadania w tle</a>\n    <a class=\"nav\" data-view=\"about\">O programie</a>\n    <div class=\"clock\" id=\"clock\">--:--:--</div>\n  </aside>\n\n  <main class=\"main\">\n    <section id=\"overview\" class=\"view\">\n      <div class=\"cards\">\n        <div class=\"card\"><span class=\"label\">Odwiedziny</span><b id=\"kpi-a\">0</b></div>\n        <div class=\"card\"><span class=\"label\">Zamówienia</span><b id=\"kpi-b\">0</b></div>\n        <div class=\"card\"><span class=\"label\">Przychód</span><b id=\"kpi-c\">0</b></div>\n      </div>\n      <div class=\"panel\">\n        <h3>Ostatnie 12 odczytów <small id=\"range\"></small></h3>\n        <div id=\"chart\" class=\"chart\"></div>\n        <button id=\"shuffle\">Losuj dane</button>\n      </div>\n    </section>\n\n    <section id=\"tasks\" class=\"view hidden\">\n      <div class=\"panel\">\n        <h3>Zadanie w tle (H# spawn_task)</h3>\n        <p>UI nie zamarza — wynik wraca zdarzeniem.</p>\n        <button id=\"run\">Uruchom <code>uname -a</code></button>\n        <pre id=\"task-out\" class=\"out\">(brak wyniku)</pre>\n      </div>\n      <div class=\"panel\">\n        <h3>fetch() z JS</h3>\n        <button id=\"fetch\">Pobierz https://example.com</button>\n        <pre id=\"fetch-out\" class=\"out\"></pre>\n      </div>\n    </section>\n\n    <section id=\"about\" class=\"view hidden\">\n      <div class=\"panel\">\n        <h3>Silver 0.2</h3>\n        <p>Pulpit pokazuje: grid/flex, zmienne CSS, motyw ciemny przez <code>@media</code>,\n        przejścia, wykres zbudowany w JS z elementów <code>div</code>, zadania w tle i cykliczny <code>on_tick</code>.</p>\n      </div>\n    </section>\n  </main>\n</div>\n")
    f = array_push(f, "frontend/style.css")
    f = array_push(f, "* {{ box-sizing: border-box; }}\n:root {{ --bg: #f1f3f9; --panel: #ffffff; --side: #20233a; --text: #1e2130; --accent: #4f6bf0; --muted: #7a8099; }}\nbody {{ background: var(--bg); color: var(--text); font-size: 14px; }}\n.shell {{ display: flex; min-height: 100vh; }}\n.side {{ width: 190px; background: var(--side); color: #cfd3ee; padding: 18px 12px; }}\n.side h2 {{ color: white; margin: 0 0 16px 8px; font-size: 20px; }}\n.nav {{ display: block; padding: 9px 12px; border-radius: 8px; margin-bottom: 4px; cursor: pointer; transition: 150ms; color: #cfd3ee; }}\n.nav:hover {{ background: #2d3150; }}\n.nav.active {{ background: var(--accent); color: white; }}\n.clock {{ margin: 24px 8px 0 8px; font-size: 22px; color: white; }}\n.main {{ flex: 1; padding: 22px; }}\n.hidden {{ display: none; }}\n.cards {{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 16px; }}\n.card {{ background: var(--panel); border-radius: 12px; padding: 16px; box-shadow: 0 2px 8px rgba(20,30,70,0.1); }}\n.card .label {{ color: var(--muted); display: block; margin-bottom: 6px; }}\n.card b {{ font-size: 30px; }}\n.panel {{ background: var(--panel); border-radius: 12px; padding: 16px; margin-bottom: 16px; box-shadow: 0 2px 8px rgba(20,30,70,0.1); }}\n.panel h3 {{ margin: 0 0 10px 0; }}\n.panel small {{ color: var(--muted); font-weight: normal; margin-left: 8px; }}\n.chart {{ display: flex; align-items: flex-end; gap: 8px; height: 160px; border-bottom: 1px solid #dde; padding-bottom: 4px; margin-bottom: 12px; }}\n.bar {{ flex: 1; background: var(--accent); border-radius: 5px 5px 0 0; transition: 300ms; }}\n.bar:hover {{ background: #3550d8; }}\nbutton {{ background: var(--accent); color: white; border-color: var(--accent); transition: 140ms; }}\nbutton:hover {{ background: #3a54d6; }}\n.out {{ background: #f5f6fb; border-radius: 8px; padding: 10px; margin-top: 10px; color: #333; }}\n@media (prefers-color-scheme: dark) {{\n    :root {{ --bg: #14151c; --panel: #1f2130; --text: #e8eaf5; --muted: #8f95b2; }}\n    .out {{ background: #171824; color: #ddd; }}\n    .chart {{ border-bottom-color: #34374d; }}\n}}\n")
    f = array_push(f, "src/main.h#")
    f = array_push(f, "use \"bit -> silver\" from \"silver\"\nuse \"std -> time\"   from \"time\"\n\n;; Zadanie w tle: polecenie powłoki uruchomione asynchronicznie.\n;; Wynik wraca jako zdarzenie \"silver://task\" (JS) oraz do komendy `on_task_done`.\nfn on_task_done(args: string) -> string is\n    return ui::only(ui::set_text(\"task-out\", data::get_str(args, \"output\")))\nend\n\nfn start_task(args: string) -> string is\n    ;; spawn_task wymaga App — dlatego ustawiamy flagę w stanie i robimy to w on_tick\n    return ui::only(ui::set_state(\"run_task\", \"1\"))\nend\n\nfn on_tick(a: app::App) -> app::App is\n    let mut x: app::App = a\n    ;; zegar: odświeżany co sekundę\n    x = app::set_text(x, \"clock\", time::format(time::now_unix(), \"%H:%M:%S\"))\n    if app::state(x, \"run_task\") == \"1\" is\n        x = app::set_state(x, \"run_task\", \"0\")\n        x = app::spawn_task(x, \"uname\", \"uname -a\", \"on_task_done\")\n    end\n    return x\nend\n\nfn main() is\n    let mut a = app::new(\"Pulpit\", 960, 640)\n    a = app::load_html(a, \"frontend/index.html\")\n    a = app::load_css(a, \"frontend/style.css\")\n    a = app::command(a, \"start_task\", start_task)\n    a = app::command(a, \"on_task_done\", on_task_done)\n    a = app::on_tick(a, on_tick)\n    a = app::set_tick_interval(a, 1000)\n    a = app::set_state(a, \"run_task\", \"0\")\n    a = app::load_js(a, [\"frontend/app.js\"])\n    a = app::enable_hot_reload(a)\n    app::run(a)\nend\n")
    return f
end

