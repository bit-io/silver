mod engine

fn dir(op: string) -> string is
    return jsonlite::set_str(jsonlite::object(), "op", op)
end

pub fn set_text(attr_id: string, text: string) -> string is
    return jsonlite::set_str(jsonlite::set_str(dir("set_text"), "id", attr_id), "text", text)
end

pub fn set_value(attr_id: string, value: string) -> string is
    return jsonlite::set_str(jsonlite::set_str(dir("set_value"), "id", attr_id), "value", value)
end

pub fn set_html(attr_id: string, html: string) -> string is
