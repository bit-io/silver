pub fn reload() -> string is return dir("reload") end
pub fn close() -> string is return dir("close") end

;; Dokłada dyrektywę do wyniku handlera (tworzy/uzupełnia tablicę "__ui").
pub fn with(result_json: string, directive: string) -> string is
    let base: string = if string_trim(result_json) == "" then jsonlite::object() else result_json
    let cur: string = jsonlite::get_raw(base, "__ui")
    let list: string = if cur == "" then "[" + directive + "]" else string_slice(cur, 0, string_len(cur) - 1) + "," + directive + "]"
    return jsonlite::set_raw(base, "__ui", list)
end

;; Wynik zawierający tylko dyrektywy
pub fn only(directive: string) -> string is
    return with(jsonlite::object(), directive)
end

;; Lista dyrektyw z wyniku handlera ([] gdy brak)
pub fn directives(result_json: string) -> [string] is
    return jsonlite::array_items(jsonlite::get_raw(result_json, "__ui"))
end

pub fn strip(result_json: string) -> string is
    if !jsonlite::has_key(result_json, "__ui") is return result_json end
    return jsonlite::remove_key(result_json, "__ui")
end
