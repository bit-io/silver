#[test]
fn e2e_transform_3d_rotate_y_narrows_box_and_hides_backface() is
    let base: string = "body { margin: 0; background: #ffffff; } #p { perspective: 400px; width: 200px; height: 120px; } #c { margin-left: 50px; width: 100px; height: 100px; background: #000000; }"
    ;; kontrola: bez 3D lewa krawędź (x=55) jest czarna
    let flat: int = shot("<div id=\"p\"><div id=\"c\"></div></div>", base, 220, 130)
    assert_true(red_of(ffi_shim::silver_pixel(flat, 55, 50)) < 50)
    ffi_shim::silver_window_close(flat)
    ;; rotateY(60deg): szerokość ×0,5 wokół środka (x=100) → x=55 jest już tłem, środek nadal czarny
    let rot: int = shot("<div id=\"p\"><div id=\"c\" style=\"transform: rotateY(60deg)\"></div></div>", base, 220, 130)
    assert_true(red_of(ffi_shim::silver_pixel(rot, 100, 50)) < 50)
    assert_true(red_of(ffi_shim::silver_pixel(rot, 55, 50)) > 200)
    ffi_shim::silver_window_close(rot)
