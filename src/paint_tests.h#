fn e2e_mask_image_gradient_fades_element() is
    ;; maska: biały→przezroczysty w poziomie; element czerwony → po lewej czerwony, po prawej tło (białe)
    let css_text: string = "body { margin: 0; } #a { width: 100px; height: 40px; background: #ff0000; mask-image: linear-gradient(to right, #000000, transparent); }"
    let win: int = shot("<div id=\"a\"></div>", css_text, 200, 100)
    let l: int = ffi_shim::silver_pixel(win, 3, 20)
