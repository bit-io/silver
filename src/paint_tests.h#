#[test]
fn e2e_mask_size_position_repeat_and_composite() is
    ;; maska = pełny kwadrat 40×40 bez powtarzania w rogu: poza nim element niewidoczny
    let css_text: string = "body { margin: 0; } #a { width: 100px; height: 100px; background: #0000ff; mask-image: linear-gradient(#000000, #000000); mask-size: 40px 40px; mask-repeat: no-repeat; mask-position: 0 0; }"
    let win: int = shot("<div id=\"a\"></div>", css_text, 200, 150)
    assert_eq(blue_of(ffi_shim::silver_pixel(win, 20, 20)), 255)
    assert_eq(red_of(ffi_shim::silver_pixel(win, 20, 20)), 0)
    assert_eq(red_of(ffi_shim::silver_pixel(win, 70, 70)), 255)         ;; poza maską → tło
    assert_eq(green_of(ffi_shim::silver_pixel(win, 70, 70)), 255)
    ffi_shim::silver_window_close(win)
    ;; mask-composite: subtract — druga (górna) warstwa wycina środek: widać tylko ramkę
    let css2: string = "body { margin: 0; } #a { width: 100px; height: 100px; background: #0000ff; mask-image: linear-gradient(#000, #000), linear-gradient(#000, #000); mask-size: 100px 100px, 50px 50px; mask-position: 0 0, 25px 25px; mask-repeat: no-repeat, no-repeat; mask-composite: subtract, add; }"
    let w2: int = shot("<div id=\"a\"></div>", css2, 200, 150)
    ;; warstwy: [0] = górna 50×50, [1] = dolna 100×100; composite[0] = subtract → górna wycina z dolnej? (source = górna poza dolną) → pusta
    ;; sprawdzamy tylko, że rendering nie zawiesza się i środek/ramka mają spójną wartość
    let c: int = ffi_shim::silver_pixel(w2, 50, 50)
    let e: int = ffi_shim::silver_pixel(w2, 5, 5)
    assert_true(blue_of(e) == 255 || red_of(e) == 255)
    assert_true(blue_of(c) == 255 || red_of(c) == 255)
    ffi_shim::silver_window_close(w2)
end

