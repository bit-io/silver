    let hid: int = shot("<div id=\"p\"><div id=\"c\" style=\"transform: rotateY(180deg); backface-visibility: hidden\"></div></div>", base, 220, 130)
    assert_true(red_of(ffi_shim::silver_pixel(hid, 100, 50)) > 200)
    ffi_shim::silver_window_close(hid)
    ;; perspektywa: rotateX(50deg) — dolna część bliżej/dalej, górna krawędź przesunięta względem płaskiej
    let rx: int = shot("<div id=\"p\"><div id=\"c\" style=\"transform: rotateX(70deg)\"></div></div>", base, 220, 130)
