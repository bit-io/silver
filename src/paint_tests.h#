#[test]
fn e2e_shape_outside_image_alpha_and_threshold() is
    let words: string = "aaa bbb ccc ddd eee fff ggg hhh iii jjj kkk lll mmm nnn ooo ppp qqq rrr sss ttt uuu vvv www xxx yyy zzz aaa bbb ccc ddd eee fff ggg hhh iii jjj kkk lll mmm nnn ooo ppp qqq rrr sss ttt uuu vvv www"
    let d: dom::Dom = dom::parse("<div id=\"f\"></div><p>" + words + "</p>")
    let css_lo: string = "body { margin: 0; } p { margin: 0; } #f { float: left; width: 100px; height: 100px; shape-outside: url(/tmp/silver_testdata/disc.png); shape-image-threshold: 0.2; }"
    let css_hi: string = "body { margin: 0; } p { margin: 0; } #f { float: left; width: 100px; height: 100px; shape-outside: url(/tmp/silver_testdata/disc.png); shape-image-threshold: 0.7; }"
    let win: int = ffi_shim::silver_window_create("t", 300, 200)
    ffi_shim::silver_load_font(win, "", 16)
    let lo: [layout::LayoutBox] = layout::layout(d, css::parse(css_lo), 300, win)
    let hi: [layout::LayoutBox] = layout::layout(d, css::parse(css_hi), 300, win)
    ffi_shim::silver_window_close(win)
    ;; próg 0,2: widoczna cała tarcza (r=50) → w połowie wysokości tekst zaczyna się przy ~100
    let mid_lo: int = min_x_in_band(lo, 42, 58)
    ;; próg 0,7: tylko wewnętrzny dysk (r=30) → ~80
    let mid_hi: int = min_x_in_band(hi, 42, 58)
    assert_true(mid_lo >= 96)
    assert_true(mid_hi >= 76 && mid_hi <= 90)
    ;; góra bryły przy progu 0,2 jest węższa niż prostokąt (100)
    assert_true(min_x_in_band(lo, 0, 12) < 98)
end

fn min_x_in_band(boxes: [layout::LayoutBox], y0: int, y1: int) -> int is
    let mut best: int = 1000000
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" && boxes[i].y >= y0 && boxes[i].y < y1 && boxes[i].x < best is best = boxes[i].x end
        i += 1
    end
    return best
end

#[test]
fn e2e_text_spacing_trim_halves_adjacent_cjk_punctuation() is
    let css_n: string = "p { margin: 0; font-size: 20px; font-family: \"Noto Serif CJK SC\", serif; }"
    let css_s: string = "p { margin: 0; font-size: 20px; font-family: \"Noto Serif CJK SC\", serif; text-spacing-trim: space-all; }"
    let two_n: int = text_box_width("<p>\uff09\uff08</p>", css_n, "")
    let two_s: int = text_box_width("<p>\uff09\uff08</p>", css_s, "")
    ;; ）（ — przycięta prawa połowa pierwszego znaku: całość 1,5 szerokości zamiast 2
    assert_true(two_s > 20)
    assert_true(two_n < two_s)
    assert_true(near(two_s - two_n, two_s / 4, 2))
    ;; （（ — przycięta lewa połowa drugiego
    let oo_n: int = text_box_width("<p>\uff08\uff08</p>", css_n, "")
    assert_true(near(two_s - oo_n, two_s / 4, 2))
    ;; ）） i 、） też
    assert_true(text_box_width("<p>\u3001\uff09</p>", css_n, "") < text_box_width("<p>\u3001\uff09</p>", css_s, ""))
    ;; litera + nawias nie są przycinane; pojedynczy nawias także nie
    assert_eq(text_box_width("<p>a\uff08</p>", css_n, ""), text_box_width("<p>a\uff08</p>", css_s, ""))
    assert_eq(text_box_width("<p>\uff08</p>", css_n, ""), text_box_width("<p>\uff08</p>", css_s, ""))
    assert_eq(text_box_width("<p>ab</p>", css_n, ""), text_box_width("<p>ab</p>", css_s, ""))
end

#[test]
fn e2e_transform_style_preserve_3d_nested_face_faces_camera() is
    let d0: string = "<div id=\"s\"><div id=\"cube\"><div id=\"face\"></div></div></div>"
    let base: string = "body { margin: 0; background: #ffffff; } #s { perspective: 500px; width: 200px; height: 120px; } #cube { margin-left: 50px; width: 100px; height: 100px; transform: rotateY(90deg); } #face { width: 100px; height: 100px; background: #000000; transform: rotateY(-90deg) translateZ(50px); }"
    ;; preserve-3d: kostka obrócona o 90°, ściana obrócona z powrotem i wysunięta ku kamerze → widać ją (skala ≈ 1,11)
    let pres: int = shot(d0, base + " #cube { transform-style: preserve-3d; }", 220, 130)
    assert_true(red_of(ffi_shim::silver_pixel(pres, 100, 50)) < 50)
    assert_true(red_of(ffi_shim::silver_pixel(pres, 150, 50)) < 50)
    assert_true(red_of(ffi_shim::silver_pixel(pres, 170, 50)) > 200)
    ffi_shim::silver_window_close(pres)
    ;; bez preserve-3d (płasko) ta sama ściana jest widoczna tylko krawędzią
    let flat: int = shot(d0, base, 220, 130)
    assert_true(red_of(ffi_shim::silver_pixel(flat, 150, 50)) > 200)
    ffi_shim::silver_window_close(flat)
end
