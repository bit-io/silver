#[test]
fn e2e_filter_blur_softens_edges() is
    let css_text: string = "body { margin: 0; } #a { margin: 30px; width: 40px; height: 40px; background: #000000; filter: blur(4px); }"
    let win: int = shot("<div id=\"a\"></div>", css_text, 200, 150)
    let center: int = ffi_shim::silver_pixel(win, 50, 50)
    let edge: int = ffi_shim::silver_pixel(win, 30, 50)
