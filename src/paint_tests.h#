;; ====================== 0.4: typografia na prawdziwym shimie ======================
fn permille_str(n: int) -> string is
    let frac: int = n % 1000
    let mut fs: string = to_string(frac)
    if frac < 100 is fs = "0" + fs end
    if frac < 10 is fs = "0" + fs end
    return to_string(n / 1000) + "." + fs
end

fn dark_in(win: int, x0: int, y0: int, x1: int, y1: int) -> int is
    let mut n: int = 0
    let mut y: int = y0
    while y < y1 is
        let mut x: int = x0
        while x < x1 is
            if red_of(ffi_shim::silver_pixel(win, x, y)) < 128 is n += 1 end
            x += 1
        end
        y += 1
    end
    return n
end

