    ;; obrys: stroke-image zamiast koloru, stroke-align zmienia położenie względem konturu
    let st0: string = "-webkit-text-stroke: 4px #00ff00; "
    let sg: int = shot(html, base + st0 + "}", 260, 80)
    assert_true(cnt_px(sg, 0, 0, 260, 80, 1) > 100)
    ffi_shim::silver_window_close(sg)
    let si: int = shot(html, base + "stroke-width: 4px; stroke-image: linear-gradient(#0000ff, #0000ff); }", 260, 80)
    assert_true(cnt_px(si, 0, 0, 260, 80, 2) > 100)
    assert_true(cnt_px(si, 0, 0, 260, 80, 1) == 0)
    ffi_shim::silver_window_close(si)
    let ins: int = shot(html, base + st0 + "stroke-align: inside; }", 260, 80)
    let out: int = shot(html, base + st0 + "stroke-align: outside; }", 260, 80)
    assert_true(cnt_px(out, 0, 0, 260, 80, 3) > cnt_px(ins, 0, 0, 260, 80, 3))
    ffi_shim::silver_window_close(ins)
    ffi_shim::silver_window_close(out)
    ;; stroke-size / stroke-repeat / stroke-position / stroke-origin działają jak ich odpowiedniki fill-*
    let ss: string = "stroke-width: 4px; stroke-image: linear-gradient(#0000ff, #0000ff); stroke-size: 20px 100%; stroke-repeat: no-repeat; "
    let sl: int = shot(html, base + ss + "stroke-position: left; }", 260, 80)
    let sr: int = shot(html, base + ss + "stroke-position: right; }", 260, 80)
    assert_true(cnt_px(sl, 0, 0, 40, 80, 2) > 10)
    assert_true(cnt_px(sl, 100, 0, 260, 80, 2) == 0)
    assert_true(cnt_px(sr, 120, 0, 260, 80, 2) > 10)
    assert_true(cnt_px(sr, 0, 0, 60, 80, 2) == 0)
    ffi_shim::silver_window_close(sl)
    ffi_shim::silver_window_close(sr)
    let sp: string = "padding-left: 40px; " + ss + "stroke-position: left; "
    let sob: int = shot(html, base + sp + "stroke-origin: border-box; }", 300, 80)
    let soc: int = shot(html, base + sp + "stroke-origin: content-box; }", 300, 80)
    assert_true(cnt_px(sob, 38, 0, 62, 80, 2) > 8 && cnt_px(sob, 82, 0, 104, 80, 2) == 0 && cnt_px(soc, 82, 0, 104, 80, 2) > 8 && cnt_px(soc, 38, 0, 62, 80, 2) == 0)
    ffi_shim::silver_window_close(sob)
    ffi_shim::silver_window_close(soc)
end

#[test]
fn e2e_pdf_bookmarks_level_label_and_state() is
    let html: string = "<h1 id=\"a\" class=\"l1\">Intro</h1><h2 id=\"b\" class=\"l2\">Second</h2><p>plain</p>"
    let css_text: string = "body { margin: 0; } @page { size: 300px 400px; margin: 0; } .l1 { bookmark-level: 1; bookmark-state: closed; } .l2 { bookmark-level: 2; bookmark-label: \"Sub\"; }"
    let win: int = ffi_shim::silver_window_create("print-test", 300, 400)
    let path: string = "/tmp/silver-bookmarks-test.pdf"
    let pages: int = paged::print_pdf(win, dom::parse(html), css::parse(css_text), false, path)
    ffi_shim::silver_window_close(win)
    assert_true(pages >= 1)
    assert_eq(string_trim(process::run("grep -a -c '/Type /Outlines' " + path)), "1")
    ;; bookmark-label: własny tytuł w UTF-16 (Sub); h2 bez etykiety dostałby tekst elementu (Second)
    assert_eq(string_trim(process::run("grep -a -c '<FEFF005300750062>' " + path)), "1")
    assert_eq(string_trim(process::run("grep -a -c '<FEFF005300650063006F006E0064>' " + path)), "0")
    ;; bookmark-level: tylko nagłówki z poziomem trafiają do konspektu (Intro tak, akapit nie)
    assert_eq(string_trim(process::run("grep -a -c '<FEFF0049006E00740072006F>' " + path)), "1")
    assert_eq(string_trim(process::run("grep -a -c '<FEFF0070006C00610069006E>' " + path)), "0")
    ;; bookmark-state: closed → ujemny /Count przy elemencie z potomkiem
    assert_eq(string_trim(process::run("grep -a -c '/Count -1' " + path)), "1")
    ;; bez bookmark-level nie ma konspektu
    let w2: int = ffi_shim::silver_window_create("print-test", 300, 400)
    let p2: string = "/tmp/silver-bookmarks-none.pdf"
    let n2: int = paged::print_pdf(w2, dom::parse(html), css::parse("body { margin: 0; } @page { size: 300px 400px; margin: 0; }"), false, p2)
    ffi_shim::silver_window_close(w2)
    assert_true(n2 >= 1)
    assert_eq(string_trim(process::run("grep -a -c '/Type /Outlines' " + p2)), "0")
end

#[test]
fn e2e_fill_break_and_stroke_break_choose_reference_rectangle_of_wrapped_text() is
    let html: string = "<p>MMMM MM</p>"
    let base: string = "body { margin: 0; } p { margin: 0; width: 170px; font-size: 40px; color: #000000; } "
    let g: string = "fill-image: linear-gradient(to right, #ff0000, #0000ff); "
    let bb: int = shot(html, base + "p { " + g + "}", 200, 120)
    let cl: int = shot(html, base + "p { " + g + "fill-break: clone; }", 200, 120)
    let sl: int = shot(html, base + "p { " + g + "fill-break: slice; }", 200, 120)
    ;; drugi wiersz (krótki "MM"): przy clone gradient kończy się na jego prawym końcu (niebieski), przy bounding-box nie dochodzi do niebieskiego
    let b_bb: int = cnt_px(bb, 0, 50, 200, 120, 2)
    let b_cl: int = cnt_px(cl, 0, 50, 200, 120, 2)
    let b_sl: int = cnt_px(sl, 0, 50, 200, 120, 2)
    assert_true(b_cl > b_bb)
    assert_true(b_sl != b_cl)
    ffi_shim::silver_window_close(bb)
    ffi_shim::silver_window_close(cl)
    ffi_shim::silver_window_close(sl)
    ;; to samo dla obrysu
    let sg: string = "stroke-width: 3px; stroke-image: linear-gradient(to right, #ff0000, #0000ff); "
    let sbb: int = shot(html, base + "p { " + sg + "}", 200, 120)
    let scl: int = shot(html, base + "p { " + sg + "stroke-break: clone; }", 200, 120)
    assert_true(cnt_px(scl, 0, 50, 200, 120, 2) > cnt_px(sbb, 0, 50, 200, 120, 2))
    ffi_shim::silver_window_close(sbb)
    ffi_shim::silver_window_close(scl)
end

#[test]
fn e2e_pdf_with_footnotes_renders_area_and_paginates() is
    let css_text: string = "@page { size: 300px 400px; margin: 0; } body { margin: 0; } p { margin: 0; line-height: 22px; } .sp { height: 330px; } .fn { float: footnote; }"
    let html: string = "<p>First <span class=\"fn\">Note one text</span> end.</p><div class=\"sp\"></div><p>Second <span class=\"fn\">Note two</span> end.</p>"
    let win: int = ffi_shim::silver_window_create("print-test", 300, 400)
    let path: string = "/tmp/silver-footnotes-test.pdf"
    let pages: int = paged::print_pdf(win, dom::parse(html), css::parse(css_text), false, path)
    ffi_shim::silver_window_close(win)
    ;; przypis nr 1 zajmuje miejsce na stronie 0, więc drugi akapit i jego przypis lądują na stronie 1
    assert_eq(pages, 2)
    assert_true(str_to_int(string_trim(process::run("stat -c %s " + path))) > 500)
end
