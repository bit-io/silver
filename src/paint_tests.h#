;; Testy end-to-end rysowania: H# (layout + paint) → prawdziwy shim SDL (renderer programowy) → odczyt pikseli.
;; Uruchamianie: tools/run_paint_tests.sh (Xvfb + HRUN_SHIM=libsilvershim.so)

fn shot(html: string, css_text: string, w: int, h: int) -> int is
    let win: int = ffi_shim::silver_window_create("paint-test", w, h)
    ffi_shim::silver_load_font(win, "", 16)
    let d: dom::Dom = dom::parse(html)
    let boxes: [layout::LayoutBox] = layout::layout(d, css::parse(css_text), w, win)
    paint::render(win, boxes, d, paint::plain_state(0), style::Color { r: 255, g: 255, b: 255, a: 255 })
    return win
end

fn to_u32(p: int) -> int is
    if p < 0 is return p + 4294967296 end
    return p
end
fn red_of(p: int) -> int is return (to_u32(p) / 65536) % 256 end
fn green_of(p: int) -> int is return (to_u32(p) / 256) % 256 end
fn blue_of(p: int) -> int is return to_u32(p) % 256 end

fn pbox(boxes: [layout::LayoutBox], id: int) -> layout::LayoutBox is
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].node_id == id && boxes[i].kind == "box" is return boxes[i] end
        i += 1
    end
    return boxes[0]
end

fn near(a: int, b: int, t: int) -> bool is
    let d: int = if a > b then a - b else b - a
    return d <= t
end

#[test]
fn e2e_background_color_and_outside() is
    let win: int = shot("<div id=\"a\">x</div>", "body { margin: 0; } #a { width: 100px; height: 50px; background: #ff0000; font-size: 1px; color: #ff0000; }", 200, 100)
