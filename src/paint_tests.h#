    let r: int = ffi_shim::silver_pixel(win, 97, 20)
    assert_true(near(red_of(l), 255, 3))                                 ;; (renderer programowy SDL zaokrągla składanie o ≤2)
    assert_true(green_of(l) < 30)                                        ;; prawie czerwony
    assert_true(near(green_of(m), 127, 12))                              ;; w połowie przezroczysty nad białym
    assert_true(green_of(r) > 235)                                       ;; prawie tło
    ffi_shim::silver_window_close(win)
