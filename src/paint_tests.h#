#[test]
fn e2e_border_image_gradient_slices_and_fill() is
    ;; 100×100 z ramką 10px: źródło = gradient o rozmiarze obszaru; slice 10 → ramka z krawędzi gradientu (czarny→czerwony poziomo)
    let css_text: string = "body { margin: 0; } #a { width: 80px; height: 80px; border: 10px solid #00ff00; border-image: linear-gradient(to right, #000000, #ff0000) 10 / 10px stretch; }"
    let win: int = shot("<div id=\"a\"></div>", css_text, 200, 150)
    ;; lewa krawędź ramki (x≈5) → początek gradientu (ciemny), prawa (x≈95) → koniec (czerwony); wnętrze (50,50) białe tło
    assert_true(red_of(ffi_shim::silver_pixel(win, 5, 50)) < 40)
    assert_true(red_of(ffi_shim::silver_pixel(win, 95, 50)) > 215)
    assert_eq(green_of(ffi_shim::silver_pixel(win, 95, 50)), 0)           ;; nie zielony kolor border-color
    assert_eq(green_of(ffi_shim::silver_pixel(win, 50, 50)), 255)
    assert_eq(red_of(ffi_shim::silver_pixel(win, 50, 50)), 255)
    ffi_shim::silver_window_close(win)
end

