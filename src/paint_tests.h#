fn px_is_red(win: int, x: int, y: int) -> bool is
    let p: int = to_u32(ffi_shim::silver_pixel(win, x, y))
    return ((p / 65536) % 256) > 180 && ((p / 256) % 256) < 90
end

fn px_is_green(win: int, x: int, y: int) -> bool is
    let p: int = to_u32(ffi_shim::silver_pixel(win, x, y))
    return ((p / 256) % 256) > 120 && ((p / 65536) % 256) < 90
end

#[test]
fn e2e_exif_orientation_is_applied_by_default_and_overridable() is
    let css0: string = "body { margin: 0; background: #ffffff; } img { display: block; margin: 0; }"
    ;; surowy obraz 40×20: lewa połowa czerwona, prawa zielona
    let raw: int = shot("<img src=\"/tmp/silver_testdata/exif1.jpg\">", css0, 60, 60)
    assert_true(px_is_red(raw, 5, 10))
    assert_true(px_is_green(raw, 35, 10))
    ffi_shim::silver_window_close(raw)
    ;; EXIF 6 = obrót 90° cw → 20×40: góra czerwona, dół zielony
    let e6: int = shot("<img src=\"/tmp/silver_testdata/exif6.jpg\">", css0, 60, 60)
    assert_true(px_is_red(e6, 10, 5))
    assert_true(px_is_green(e6, 10, 35))
    ffi_shim::silver_window_close(e6)
    ;; EXIF 8 = obrót 90° ccw: góra zielona, dół czerwony
    let e8: int = shot("<img src=\"/tmp/silver_testdata/exif8.jpg\">", css0, 60, 60)
    assert_true(px_is_green(e8, 10, 5))
    assert_true(px_is_red(e8, 10, 35))
    ffi_shim::silver_window_close(e8)
    ;; EXIF 3 = 180°: lewa zielona, prawa czerwona
    let e3: int = shot("<img src=\"/tmp/silver_testdata/exif3.jpg\">", css0, 60, 60)
    assert_true(px_is_green(e3, 5, 10))
    assert_true(px_is_red(e3, 35, 10))
    ffi_shim::silver_window_close(e3)
    ;; image-orientation: none ignoruje EXIF (wymiary układu zostają jak dla from-image)
    let none: int = shot("<img src=\"/tmp/silver_testdata/exif3.jpg\" style=\"image-orientation: none; width: 40px; height: 20px\">", css0, 60, 60)
    assert_true(px_is_red(none, 5, 10))
    ffi_shim::silver_window_close(none)
    ;; flip: odbicie poziome surowego obrazu
    let flip: int = shot("<img src=\"/tmp/silver_testdata/exif1.jpg\" style=\"image-orientation: flip\">", css0, 60, 60)
    assert_true(px_is_green(flip, 5, 10))
    assert_true(px_is_red(flip, 35, 10))
    ffi_shim::silver_window_close(flip)
    ;; 90deg: obrót surowego obrazu o 90° cw (pudełko 40×20 skalowane)
    let rot: int = shot("<img src=\"/tmp/silver_testdata/exif1.jpg\" style=\"image-orientation: 90deg; width: 20px; height: 40px\">", css0, 60, 60)
    assert_true(px_is_red(rot, 10, 5))
    assert_true(px_is_green(rot, 10, 35))
    ffi_shim::silver_window_close(rot)
end

