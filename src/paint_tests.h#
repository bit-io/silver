fn e2e_svg_fill_rule_linecap_opacity_dashoffset() is
    ;; fill-rule: evenodd → dziura w środku gwiazdy pentagramu; nonzero → wypełniona
    let star: string = "<svg width=\"100\" height=\"100\" viewBox=\"0 0 100 100\"><path id=\"p\" d=\"M50 5 L80 95 L5 38 L95 38 L20 95 Z\"/></svg>"
