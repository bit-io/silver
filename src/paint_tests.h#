;; ====================== 0.4: font-variant-alternates / font-language-override / font-palette (HarfBuzz + FreeType) ======================
;; Czcionki testowe: native/tests/fonts (python3 native/tests/gen_test_fonts.py). Uruchamiać z katalogu głównego repozytorium.
fn shot_font(html: string, css_text: string, w: int, h: int, font_path: string) -> int is
    let win: int = ffi_shim::silver_window_create("paint-test", w, h)
    ffi_shim::silver_load_font(win, font_path, 100)
    let d: dom::Dom = dom::parse(html)
    let boxes: [layout::LayoutBox] = layout::layout(d, css::parse(css_text), w, win)
    paint::render(win, boxes, d, paint::plain_state(0), style::Color { r: 255, g: 255, b: 255, a: 255 })
    return win
end

fn text_w(css_text: string, text: string) -> int is
    return text_w_font("native/tests/fonts/silver-alt.ttf", css_text, text)
end

fn text_w_font(font_path: string, css_text: string, text: string) -> int is
    let html: string = "<div style=\"font-size:100px;line-height:100px\"><span id=\"s\" style=\"display:inline-block\">" + text + "</span></div>"
    let win: int = ffi_shim::silver_window_create("paint-test", 600, 200)
    ffi_shim::silver_load_font(win, font_path, 100)
    let d: dom::Dom = dom::parse(html)
    let boxes: [layout::LayoutBox] = layout::layout(d, css::parse(css_text), 600, win)
    let w: int = pbox(boxes, dom::find_by_id(d, "s")).w
    ffi_shim::silver_window_close(win)
    return w
end

