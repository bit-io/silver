fn count_red_in(win: int, x0: int, y0: int, x1: int, y1: int) -> int is
    let mut n: int = 0
    let mut y: int = y0
    while y < y1 is
        let mut x: int = x0
        while x < x1 is
            let p: int = ffi_shim::silver_pixel(win, x, y)
            if red_of(p) > 200 && green_of(p) < 80 && blue_of(p) < 80 is n += 1 end
            x += 1
        end
        y += 1
    end
    return n
end

