    assert_eq(green_of(ffi_shim::silver_pixel(w2, 50, 50)), 255)
    ffi_shim::silver_window_close(w2)
    ;; stroke-linecap: round wystaje poza koniec odcinka (x=20), butt nie
    let line: string = "<svg width=\"100\" height=\"40\" viewBox=\"0 0 100 40\"><line id=\"l\" x1=\"20\" y1=\"20\" x2=\"80\" y2=\"20\"/></svg>"
    let w3: int = shot(line, "#l { stroke: #000000; stroke-width: 16px; stroke-linecap: round; }", 150, 100)
    assert_true(red_of(ffi_shim::silver_pixel(w3, 14, 20)) < 40)
    ffi_shim::silver_window_close(w3)
    let w4: int = shot(line, "#l { stroke: #000000; stroke-width: 16px; stroke-linecap: butt; }", 150, 100)
    assert_true(red_of(ffi_shim::silver_pixel(w4, 14, 20)) > 215)
    ffi_shim::silver_window_close(w4)
    ;; stroke-opacity: połowa krycia nad białym
    let w5: int = shot(line, "#l { stroke: #000000; stroke-width: 10px; stroke-opacity: 0.5; }", 150, 100)
    assert_true(near(red_of(ffi_shim::silver_pixel(w5, 50, 20)), 127, 10))
    ffi_shim::silver_window_close(w5)
    ;; stroke-dashoffset przesuwa wzór: dasharray 20 20, offset 20 → x=10 puste, x=30 kreska (od x=20..40 wzór zaczyna od przerwy)
    let w6: int = shot("<svg width=\"100\" height=\"20\"><line id=\"l\" x1=\"0\" y1=\"10\" x2=\"100\" y2=\"10\"/></svg>", "#l { stroke: #000000; stroke-width: 8px; stroke-dasharray: 20 20; stroke-dashoffset: 20; }", 150, 100)
    assert_true(red_of(ffi_shim::silver_pixel(w6, 10, 10)) > 215)
    assert_true(red_of(ffi_shim::silver_pixel(w6, 30, 10)) < 40)
    ffi_shim::silver_window_close(w6)
end

fn text_box_width(html: string, css_text: string, font: string) -> int is
    let win: int = ffi_shim::silver_window_create("w", 400, 100)
    ffi_shim::silver_load_font(win, font, 16)
    let d: dom::Dom = dom::parse(html)
    let boxes: [layout::LayoutBox] = layout::layout(d, css::parse(css_text), 400, win)
    let mut w: int = -1
    let mut i: int = 0
    while i < array_len(boxes) is
        if boxes[i].kind == "text" is w = boxes[i].w end
        i += 1
    end
    ffi_shim::silver_window_close(win)
    return w
end

