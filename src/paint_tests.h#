    assert_true(cnt_px(rep, 0, 0, 260, 80, 0) > cnt_px(l, 0, 0, 260, 80, 0) * 3)
    ffi_shim::silver_window_close(l)
    ffi_shim::silver_window_close(r)
    ffi_shim::silver_window_close(rep)
    ;; fill-origin: border-box w obszarze dopełnienia (poza tekstem) vs content-box na tekście
    let pad: string = "padding-left: 40px; fill-image: linear-gradient(#ff0000, #ff0000); fill-size: 20px 100%; fill-repeat: no-repeat; fill-position: left; "
    let ob: int = shot(html, base + pad + "fill-origin: border-box; }", 300, 80)
