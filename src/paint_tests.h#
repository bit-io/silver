;; ====================== sesja 3: longhandy obrazów ramek/masek, tekst, kontrolki ======================
fn cnt_px(win: int, x0: int, y0: int, x1: int, y1: int, kind: int) -> int is
    let mut n: int = 0
    let mut y: int = y0
    while y < y1 is
        let mut x: int = x0
        while x < x1 is
            let p: int = ffi_shim::silver_pixel(win, x, y)
            let r: int = red_of(p)
            let g: int = green_of(p)
            let b: int = blue_of(p)
            if kind == 0 && r > 180 && g < 90 && b < 90 is n += 1 end
            if kind == 1 && g > 120 && r < 90 && b < 90 is n += 1 end
            if kind == 2 && b > 180 && r < 90 && g < 90 is n += 1 end
            if kind == 3 && (r < 200 || g < 200 || b < 200) is n += 1 end
            x += 1
        end
        y += 1
    end
    return n
end

fn rows_with_red(win: int, x0: int, x1: int, y0: int, y1: int, minpx: int) -> int is
    let mut y: int = y0
    while y < y1 is
        if cnt_px(win, x0, y, x1, y + 1, 0) >= minpx is return y end
        y += 1
    end
    return -1
end

